{
  "name": "capa-eleicoes-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Capa animada do painel Eleições 2026 · o que os números dizem (Vizu Dados), em Remotion.",
  "scripts": {
    "estudio": "remotion studio src/index.ts",
    "dados": "python -I -X utf8 scripts/preparar_dados.py && python -I -X utf8 scripts/preparar_arte.py",
    "quadros": "node scripts/quadros.mjs 0 120 240 330 420 539",
    "render": "remotion render src/index.ts Capa out/seq --sequence --image-format=png",
    "codificar": "pwsh -NoProfile -File scripts/codificar.ps1"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
