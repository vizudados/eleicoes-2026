{
  "name": "capa-eleicoes-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Capa animada do painel Eleições 2026 · o voto de perto (Vizu Dados), em Remotion.",
  "scripts": {
    "estudio": "remotion studio src/index.ts",
    "dados": "python -I -X utf8 scripts/preparar_dados.py",
    "quadros": "node scripts/quadros.mjs 0 120 240 372 396 436 449 501 540 629",
    "render": "remotion render src/index.ts Capa out/seq-2t --sequence --image-format=png",
    "codificar": "powershell -NoProfile -File scripts/codificar.ps1",
    "test": "node --test --test-isolation=none scripts/testar_animacao.cjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
