/// Segundo turno por município, 2022 e 2026, sem exterior. Município ausente em 2022 permanece ausente; não equivale a zero. Fonte: TSE, exportação validada por pipeline/exportar_2turno.py.
table 'Município segundo turno'
	isHidden
	lineageTag: b56aa50b-9304-51ce-adc7-bd877b1efe23

	/// Código IBGE, chave da dimensão Município.
	column CodIBGE
		dataType: string
		isHidden
		lineageTag: bede8a38-80bd-5447-810a-f2957ca7faa4
		summarizeBy: none
		sourceColumn: CodIBGE

		annotation SummarizationSetBy = Automatic

	/// Ano, somente segundo turno.
	column Ano
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0e163edc-6ad7-5e80-b731-be732e7db3a7
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

