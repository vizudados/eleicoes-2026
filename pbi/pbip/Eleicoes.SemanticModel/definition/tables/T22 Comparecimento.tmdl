				let
				    Valores = List.Numbers(-5, 11, 1),
				    Tabela = Table.FromList(Valores, Splitter.SplitByNothing(), {"Comparecimento"}),
				    Tipos = Table.TransformColumnTypes(Tabela, {{"Comparecimento", Int64.Type}})
				in
