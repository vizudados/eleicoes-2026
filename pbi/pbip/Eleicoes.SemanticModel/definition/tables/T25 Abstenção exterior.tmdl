		summarizeBy: none
		sourceColumn: Aptos

		annotation SummarizationSetBy = Automatic

	/// Eleitores da faixa que faltaram.
	column Abstencoes
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: ce8cf56c-c138-5496-be84-26c21c0ffa16
