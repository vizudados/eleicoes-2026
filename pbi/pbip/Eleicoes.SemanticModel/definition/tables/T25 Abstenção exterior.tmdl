/// Exterior (ZZ) × faixa de idade × eleição (1º turno, 2014–2026): aptos e abstenções, que só entram no total do Brasil (sem filtro de UF nem município).
table 'T25 Abstenção exterior'
	isHidden
	lineageTag: 3b59a319-9478-5066-b258-aa6cb0fc2df9

	/// Ano da eleição (2014, 2018, 2022, 2026).
	column Ano
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3205649d-eb33-51ea-a33b-b08eba6fd63b
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

	/// Sigla da UF do município (ZZ = exterior).
	column UF
		dataType: string
		isHidden
		lineageTag: 09643e66-7a4a-545d-a0fc-1e9ee422038f
		summarizeBy: none
		sourceColumn: UF

		annotation SummarizationSetBy = Automatic

	/// Código IBGE do município (vazio no exterior).
	column CodIBGE
		dataType: string
		isHidden
		lineageTag: 529b17fe-2a3a-5dbe-8035-b61e1e940b45
		summarizeBy: none
		sourceColumn: CodIBGE

		annotation SummarizationSetBy = Automatic

	/// Ordem da faixa de idade (1 = 16 e 17 anos … 7 = 70 anos ou mais); liga com T25 Faixa.
	column FaixaOrdem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 66a77d07-a7e8-55e5-9084-c76b02f714cf
		summarizeBy: none
		sourceColumn: FaixaOrdem

