/// A célula da matriz da tela 13 (porte × quinto de renda) de cada um dos 5.571 municípios. Só serve de grão à matriz (um ponto por célula: tooltip e filtro cruzado); as contas leem o Município.
table 'T13 Célula'
	lineageTag: a3daff8d-8f54-5efc-b97f-370a5e59a30a

	/// Código IBGE do município (chave; liga com Município).
	column CodIBGE
		dataType: string
		isHidden
		lineageTag: 9dc52f70-642e-548c-b769-495045c8d9de
		summarizeBy: none
		sourceColumn: CodIBGE

		annotation SummarizationSetBy = Automatic

	/// Faixa de população (até 10 mil … mais de 1 milhão).
	column Porte
		dataType: string
		isHidden
		lineageTag: 843cbf69-85c2-59c6-848b-97a2126b8b46
		summarizeBy: none
		sourceColumn: Porte

		annotation SummarizationSetBy = Automatic

	/// Ordem do porte.
	column PorteOrdem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9c8e5b0e-0fc6-516f-9944-dc2e4b90a2d2
		summarizeBy: none
		sourceColumn: PorteOrdem

		annotation SummarizationSetBy = Automatic

	/// Quinto dos municípios pela renda per capita.
	column 'Quinto de renda'
		dataType: string
		isHidden
		lineageTag: 5de3a0d7-3dfb-5b69-a9f7-993c94edf644
		summarizeBy: none
		sourceColumn: Quinto de renda

		annotation SummarizationSetBy = Automatic

	/// Ordem do quinto (1 = mais pobres).
	column QuintoOrdem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 349bce22-e6bc-59d4-ab86-ce45a0257fff
		summarizeBy: none
		sourceColumn: QuintoOrdem

		annotation SummarizationSetBy = Automatic

	/// A célula da matriz: porte × quinto de renda (25 combinações).
	column Célula
		dataType: string
		lineageTag: e16d8cd8-c53d-575b-a258-afe86c78a17d
		summarizeBy: none
		sourceColumn: Célula
		sortByColumn: CelulaOrdem

		annotation SummarizationSetBy = Automatic

	/// Ordem da célula: porte × 10 + quinto.
	column CelulaOrdem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2e3f8570-3879-5132-a080-c99b6b571334
		summarizeBy: none
		sourceColumn: CelulaOrdem

		annotation SummarizationSetBy = Automatic

	partition 'T13 Célula' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/municipio.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"cd_ibge", "porte", "porte_ordem", "quinto", "quinto_ordem"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"cd_ibge", type text}, {"porte", type text}, {"porte_ordem", Int64.Type}, {"quinto", type text}, {"quinto_ordem", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"cd_ibge", "CodIBGE"}, {"porte", "Porte"}, {"porte_ordem", "PorteOrdem"}, {"quinto", "Quinto de renda"}, {"quinto_ordem", "QuintoOrdem"}}),
				    Celula = Table.AddColumn(Nomes, "Célula", each [Porte] & " × " & [Quinto de renda], type text),
				    Final = Table.AddColumn(Celula, "CelulaOrdem", each [PorteOrdem] * 10 + [QuintoOrdem], Int64.Type)
				in
				    Final

	annotation PBI_ResultType = Table

