		summarizeBy: none
		sourceColumn: Degrau

		annotation SummarizationSetBy = Automatic

	partition 'Social município' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/municipio_social.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"cd_ibge", "lente", "lente_ordem", "valor", "degrau"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"cd_ibge", type text}, {"lente", type text}, {"lente_ordem", Int64.Type}, {"valor", type number}, {"degrau", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"cd_ibge", "CodIBGE"}, {"lente", "Lente"}, {"lente_ordem", "LenteOrdem"}, {"valor", "Valor"}, {"degrau", "Degrau"}})
				in
				    Nomes

	annotation PBI_ResultType = Table

