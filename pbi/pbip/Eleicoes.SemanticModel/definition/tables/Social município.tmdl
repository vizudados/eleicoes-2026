/// Município × lente (renda, escolaridade, Bolsa Família, IDH): o valor do indicador e o degrau, de 1 (menos) a 5 (mais), com os municípios em fila pelo indicador e a fila cortada em cinco partes com o mesmo número de eleitores de 2026.
table 'Social município'
	isHidden
	lineageTag: 19b8c893-2573-5b64-ad25-e4fe1b804f38

	/// Código IBGE do município.
	column CodIBGE
		dataType: string
		isHidden
		lineageTag: 75fa17fb-50df-5a6a-8ccc-5aae076b448d
		summarizeBy: none
		sourceColumn: CodIBGE

		annotation SummarizationSetBy = Automatic

	/// Renda, Escolaridade, Bolsa Família ou IDH.
	column Lente
		dataType: string
		lineageTag: 0b6d6421-0199-51ee-9675-bdb23e98091b
		summarizeBy: none
		sourceColumn: Lente

		annotation SummarizationSetBy = Automatic

	/// Ordem da lente.
	column LenteOrdem
