	partition 'T26 Debate Globo' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/debate_globo.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"chave", "grupo", "cartao", "ordem", "candidato", "rotulo", "medida", "situacao", "valor", "texto", "unidade", "esperado", "previsto_para", "fonte_esperada", "fonte", "fonte_url", "atualizado_em", "observacao"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"chave", type text}, {"grupo", type text}, {"cartao", type text}, {"ordem", Int64.Type}, {"candidato", type text}, {"rotulo", type text}, {"medida", type text}, {"situacao", type text}, {"valor", type number}, {"texto", type text}, {"unidade", type text}, {"esperado", type text}, {"previsto_para", type text}, {"fonte_esperada", type text}, {"fonte", type text}, {"fonte_url", type text}, {"atualizado_em", type text}, {"observacao", type text}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"chave", "Chave"}, {"grupo", "Grupo"}, {"cartao", "Cartão"}, {"ordem", "Ordem"}, {"candidato", "Candidato"}, {"rotulo", "Rótulo"}, {"medida", "Medida"}, {"situacao", "Situação"}, {"valor", "Valor"}, {"texto", "Texto"}, {"unidade", "Unidade"}, {"esperado", "Esperado"}, {"previsto_para", "PrevistoTexto"}, {"fonte_esperada", "Fonte esperada"}, {"fonte", "Fonte"}, {"fonte_url", "URL"}, {"atualizado_em", "Atualizado"}, {"observacao", "Observação"}}),
				    Final = Table.AddColumn(Nomes, "Previsto", each if [PrevistoTexto] = null or [PrevistoTexto] = "" then null else DateTime.FromText([PrevistoTexto], [Format = "yyyy-MM-dd HH:mm", Culture = "en-US"]), type nullable datetime)
				in
				    Final

	annotation PBI_ResultType = Table

