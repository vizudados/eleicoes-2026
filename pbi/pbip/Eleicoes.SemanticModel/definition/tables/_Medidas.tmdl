	/// Nome curto do candidato da linha (Monitoramento[Candidato]): Lula ou Flávio; vazio para os outros.
	measure 'T09 · candidato' =
			SWITCH (
			    SELECTEDVALUE ( Monitoramento[Candidato] ),
			    "Lula", "Lula",
