		formatString: 0.0
		displayFolder: T06 Ausência\Contas
		lineageTag: 67fe0caa-f7d0-5561-874f-bc21dd58e6ad

	/// Quantas vezes a diferença entre os dois primeiros cabe em quem faltou, no ano da linha e no recorte.
	measure 'T06 · vezes a diferença (ano)' =
			DIVIDE ( [T06 · abstenções (ano)], [T06 · diferença do ano] )
