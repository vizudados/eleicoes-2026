	/// Id da pesquisa anterior de 2º turno do MESMO instituto (pela divulgação e, no mesmo dia, pelo Id): o ponto de onde sai o traço da série do instituto; vazio na primeira dele.
	measure 'T17 · série · Id anterior' =
			VAR _inst = [T17 · pesquisa · instituto]
			VAR _dia = [T17 · pesquisa · divulgação]
			VAR _id = SELECTEDVALUE ( Pesquisa[Id] )
			RETURN
			    IF (
			        NOT ISBLANK ( _dia ),
			        VAR _serie =
			            CALCULATETABLE (
			                SELECTCOLUMNS ( Pesquisa, "@id", Pesquisa[Id], "@d", Pesquisa[Divulgação] ),
			                REMOVEFILTERS ( Pesquisa ),
			                Pesquisa[Cenário] = "2º turno",
			                Pesquisa[Tipo] = "totais",
			                NOT ISBLANK ( Pesquisa[Lula] ),
			                NOT ISBLANK ( Pesquisa[Flavio] ),
			                Pesquisa[Instituto] = _inst
			            )
			        VAR _antes = FILTER ( _serie, [@d] < _dia || ( [@d] = _dia && [@id] < _id ) )
			        RETURN
			            MAXX ( TOPN ( 1, _antes, [@d], DESC, [@id], DESC ), [@id] )
			    )
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: 7daf0840-66f7-54bd-9189-2ba53815e92f

	/// Número do instituto da pesquisa da linha entre os institutos com pesquisa de 2º turno (ordem alfabética, 1 = o primeiro): a classe que liga os pontos do mesmo instituto quando um deles é clicado.
	measure 'T17 · série · número do instituto' =
			VAR _inst = [T17 · pesquisa · instituto]
			RETURN
			    IF (
			        NOT ISBLANK ( _inst ),
			        VAR _todos =
			            CALCULATETABLE (
			                VALUES ( Pesquisa[Instituto] ),
			                REMOVEFILTERS ( Pesquisa ),
			                Pesquisa[Cenário] = "2º turno",
			                Pesquisa[Tipo] = "totais",
			                NOT ISBLANK ( Pesquisa[Lula] ),
			                NOT ISBLANK ( Pesquisa[Flavio] )
			            )
			        RETURN
			            COUNTROWS ( FILTER ( _todos, Pesquisa[Instituto] <= _inst ) )
			    )
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: 601385d0-3538-5a79-af7c-0f37dc62b16a

	/// Sim quando a pesquisa da linha é a mais recente de 2º turno do instituto (onde o nome dele aparece quando a série está em destaque); Não nas outras; vazio fora das pesquisas de 2º turno.
	measure 'T17 · série · última do instituto' =
			VAR _inst = [T17 · pesquisa · instituto]
			VAR _dia = [T17 · pesquisa · divulgação]
			VAR _id = SELECTEDVALUE ( Pesquisa[Id] )
			RETURN
			    IF (
			        NOT ISBLANK ( _dia ),
			        VAR _depois =
			            CALCULATE (
			                COUNTROWS ( Pesquisa ),
			                REMOVEFILTERS ( Pesquisa ),
			                Pesquisa[Cenário] = "2º turno",
			                Pesquisa[Tipo] = "totais",
			                NOT ISBLANK ( Pesquisa[Lula] ),
			                NOT ISBLANK ( Pesquisa[Flavio] ),
			                Pesquisa[Instituto] = _inst,
			                FILTER (
			                    ALL ( Pesquisa[Divulgação], Pesquisa[Id] ),
			                    Pesquisa[Divulgação] > _dia || ( Pesquisa[Divulgação] = _dia && Pesquisa[Id] > _id )
			                )
			            )
			        RETURN
			            IF ( ISBLANK ( _depois ), "Sim", "Não" )
			    )
		displayFolder: T17 2º turno\Contas
		lineageTag: fb896220-1324-5380-874b-691aee6cafbe

	/// Texto para leitor de tela da curva do 2º turno; com um período escolhido, o que fica em destaque.
	measure 'T17 · Curva · ALT' =
			VAR _per = [Período · escolhido]
			VAR _nP = [T17 · período · pesquisas]
			VAR _min = [T17 · período · diferença mínima]
			VAR _max = [T17 · período · diferença máxima]
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "Diferença entre Flávio e Lula em " & [T17 · pesquisas] & " pesquisas do 2º turno, de agosto a "
			            & FORMAT ( [T17 · média móvel · último dia], "dd/MM" ) & ". A média dos 10 dias virou para Flávio em "
			            & FORMAT ( [T17 · média móvel · virada], "dd/MM" ) & " e, até " & FORMAT ( [T17 · média móvel · último dia], "dd/MM" ) & ", estava em Flávio +" & FORMAT ( [T17 · média móvel · agora], "0.0" ) & ".",
			        "Diferença entre Flávio e Lula em " & [T17 · pesquisas] & " pesquisas do 2º turno. Em destaque, " & [Período · nome] & ": "
			            & SWITCH (
			                TRUE (),
			                [T17 · período · ainda sem dado] = 1, "as pesquisas ainda não chegaram.",
			                _nP = 0, "nenhuma pesquisa com o campo inteiro no período.",
			                _nP = 1, "1 pesquisa com o campo inteiro no período (" & [T17 · período · única · instituto] & "), "
			                    & IF ( _min > 0, "Flávio +" & FORMAT ( _min, "0.0" ), IF ( _min < 0, "Lula +" & FORMAT ( -_min, "0.0" ), "empate" ) ) & ".",
			                _nP & IF ( _nP = 1, " pesquisa", " pesquisas" ) & " com o campo inteiro no período, de "
			                    & IF ( _min > 0, "Flávio +" & FORMAT ( _min, "0.0" ), IF ( _min < 0, "Lula +" & FORMAT ( -_min, "0.0" ), "empate" ) ) & " a "
			                    & IF ( _max > 0, "Flávio +" & FORMAT ( _max, "0.0" ), IF ( _max < 0, "Lula +" & FORMAT ( -_max, "0.0" ), "empate" ) ) & "."
			            )
			    )
		displayFolder: T17 2º turno\Desenho
		lineageTag: 213b9254-11c5-582f-83b1-223b3614d6d4

	/// Fundo da curva do 2º turno: zonas 'Flávio à frente' (em cima) e 'Lula à frente' (embaixo), grade, datas, o 1º turno, os dois debates do 2º turno (Band, 18/10, e Globo, 23/10, cada um com a sua linha tracejada e o nome da emissora; a da Globo só quando a tabela Debate tem a linha) e o 2º turno (urna), a média móvel de 10 dias em dois trechos (antes e depois do 1º turno, traço que se desenha), o valor de hoje (contador) e a nota à mão na virada. Com um período escolhido no filtro Período: a faixa do campo do período, a manchete do período (de quanto a quanto foram as pesquisas com o campo inteiro nele, a única, nenhuma ou a espera depois da Globo), a legenda que explica o destaque, e a nota da virada sai (fica fora de qualquer período). Os pontos são outro visual (T17 · Pontos · HTML), na mesma caixa e escala.
	measure 'T17 · Curva · HTML' =
			-- 1 · Leituras
			VAR _n = [T17 · pesquisas]
			VAR _d1 = [T17 · 1º turno · data]
			VAR _d2 = [T17 · 2º turno · data]
			VAR _deb = [T17 · debate · data]
			VAR _debG = [T17 · debate da Globo · data]
			VAR _mmIni = [T17 · média móvel · no começo]
			VAR _mmFim = [T17 · média móvel · agora]
			VAR _diaFim = [T17 · média móvel · último dia]
			VAR _vir = [T17 · média móvel · virada]
			VAR _mmVir = [T17 · média móvel · na virada]
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pDe = [T17 · período · campo de]
			VAR _pAte = [T17 · período · campo até]
			VAR _nP = [T17 · período · pesquisas]
			VAR _pMin = [T17 · período · diferença mínima]
			VAR _pMax = [T17 · período · diferença máxima]
			VAR _pDif = [T17 · período · diferença]
			VAR _parte = [T17 · período · só em parte]
			VAR _espera = [T17 · período · ainda sem dado]
			VAR _unica = [T17 · período · única · instituto]
			VAR _pDebData = [Período · debate · data]
			VAR _dias =
			    ADDCOLUMNS (
			        VALUES ( Pesquisa[Divulgação] ),
			        "@mm", [T17 · média móvel],
			        "@mom", [T17 · dia · momento]
			    )
			-- 2 · Textos
			VAR _quemIni = IF ( _mmIni < 0, "Lula", "Flávio" )
			VAR _quemFim = IF ( _mmFim < 0, "Lula", "Flávio" )
			VAR _txtMan =
			    "Em agosto, a média dava " & _quemIni & " " & FORMAT ( ABS ( _mmIni ), "0.0" ) & " pontos à frente; virou em "
			        & FORMAT ( _vir, "dd/MM" ) & " e, desde então, " & _quemFim & " segue à frente na média."
			VAR _txtFim = _quemFim & " +" & FORMAT ( ABS ( _mmFim ), "0.0" )
			VAR _pJanela =
			    SWITCH (
			        DATEDIFF ( _pDe, _pAte, DAY ),
			        0, "em " & FORMAT ( _pDe, "dd/MM" ),
			        1, "em " & FORMAT ( _pDe, "dd" ) & " e " & FORMAT ( _pAte, "dd/MM" ),
			        "de " & FORMAT ( _pDe, "dd" ) & " a " & FORMAT ( _pAte, "dd/MM" )
			    )
			VAR _txtManP =
			    SWITCH (
			        TRUE (),
			        _espera = 1, _pNome & ", ainda não dá para dizer: as pesquisas com campo depois do debate de "
			            & FORMAT ( _pDebData, "dd/MM" ) & " ainda não chegaram",
			        _nP = 0, _pNome & ", nenhuma pesquisa teve o campo inteiro " & _pJanela
			            & IF ( _parte > 0, "; " & _parte & IF ( _parte = 1, " pegou", " pegaram" ) & " só parte do período" ),
			        _nP = 1, _pNome & ", só uma pesquisa teve o campo inteiro " & _pJanela & ": " & _unica & ", "
			            & IF ( _pDif > 0, "Flávio +" & FORMAT ( _pDif, "0.0" ), IF ( _pDif < 0, "Lula +" & FORMAT ( -_pDif, "0.0" ), "empate" ) ),
			        _pNome & ", as " & _nP & " pesquisas com o campo inteiro " & _pJanela & " foram de "
			            & IF ( _pMin > 0, "Flávio +" & FORMAT ( _pMin, "0.0" ), IF ( _pMin < 0, "Lula +" & FORMAT ( -_pMin, "0.0" ), "empate" ) ) & " a "
			            & IF ( _pMax > 0, "Flávio +" & FORMAT ( _pMax, "0.0" ), IF ( _pMax < 0, "Lula +" & FORMAT ( -_pMax, "0.0" ), "empate" ) )
			    ) & "."
			-- 3 · Geometria (x: 01/08 a 27/10 em x 70–1440; y: diferença −10 a +10 pontos em y 360–20, empate em 190)
			VAR _ini = DATE ( 2026, 8, 1 )
			VAR _f = "0.0"
			VAR _pts =
			    ADDCOLUMNS (
			        FILTER ( _dias, NOT ISBLANK ( [@mm] ) ), /* lista */
			        "@x", 70 + DATEDIFF ( _ini, Pesquisa[Divulgação], DAY ) / 87 * 1370,
			        "@y", 190 - MAX ( MIN ( [@mm], 10 ), -10 ) / 10 * 170
			    )
			VAR _linhaA =
			    CONCATENATEX (
			        FILTER ( _pts, [@mom] = "antes_1turno" ), /* lista */
			        FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@y], _f, "en-US" ),
			        " ",
			        Pesquisa[Divulgação], ASC
			    )
			VAR _linhaD =
			    CONCATENATEX (
			        FILTER ( _pts, [@mom] = "apos_1turno" ), /* lista */
			        FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@y], _f, "en-US" ),
			        " ",
			        Pesquisa[Divulgação], ASC
			    )
			VAR _x1 = 70 + DATEDIFF ( _ini, _d1, DAY ) / 87 * 1370 -- geometria
			VAR _xDeb = 70 + DATEDIFF ( _ini, _deb, DAY ) / 87 * 1370 -- geometria
			VAR _xDebG = 70 + DATEDIFF ( _ini, _debG, DAY ) / 87 * 1370 -- geometria
			VAR _x2 = 70 + DATEDIFF ( _ini, _d2, DAY ) / 87 * 1370 -- geometria
			VAR _xVir = 70 + DATEDIFF ( _ini, _vir, DAY ) / 87 * 1370 -- geometria
			VAR _yVir = 190 - _mmVir / 10 * 170 -- geometria
			VAR _xFim = 70 + DATEDIFF ( _ini, _diaFim, DAY ) / 87 * 1370 -- geometria
			VAR _yFim = 190 - _mmFim / 10 * 170 -- geometria
			VAR _grade =
			    CONCATENATEX (
			        { -8, -4, 4, 8 },
			        "<line x1='70' x2='1440' y1='" & FORMAT ( 190 - [Value] / 10 * 170, _f, "en-US" ) & "' y2='"
			            & FORMAT ( 190 - [Value] / 10 * 170, _f, "en-US" ) & "' class='g'/><text x='60' y='"
			            & FORMAT ( 195 - [Value] / 10 * 170, _f, "en-US" ) & "' class='ex' text-anchor='end'>" & ABS ( [Value] ) & "</text>",
			        ""
			    )
			VAR _datas =
			    CONCATENATEX (
			        { DATE ( 2026, 8, 1 ), DATE ( 2026, 8, 15 ), DATE ( 2026, 9, 1 ), DATE ( 2026, 9, 15 ) },
			        "<text x='" & FORMAT ( 70 + DATEDIFF ( _ini, [Value], DAY ) / 87 * 1370, _f, "en-US" )
			            & "' y='384' class='ex' text-anchor='middle'>" & FORMAT ( [Value], "dd/MM" ) & "</text>",
			        ""
			    )
			VAR _xP1 = 70 + DATEDIFF ( _ini, _pDe, DAY ) / 87 * 1370 -- geometria (faixa do campo do período: do 1º dia ao fim do último)
			VAR _xP2 = 70 + ( DATEDIFF ( _ini, _pAte, DAY ) + 1 ) / 87 * 1370 -- geometria
			VAR _faixa =
			    IF (
			        NOT ISBLANK ( _per ),
			        "<rect x='" & FORMAT ( _xP1, _f, "en-US" ) & "' y='20' width='" & FORMAT ( _xP2 - _xP1, _f, "en-US" )
			            & "' height='340' class='per esmaece d4'/>"
			    )
			-- 4 · Marcação
			VAR _svg =
			    "<svg class='pl' width='1620' height='395' viewBox='0 0 1620 395'>"
			        & "<rect x='70' y='20' width='1370' height='170' class='zf esmaece'/>"
			        & "<rect x='70' y='190' width='1370' height='170' class='zl esmaece'/>"
			        & _faixa
			        & _grade
			        & "<line x1='70' x2='1440' y1='190' y2='190' class='g0'/>"
			        & "<text x='60' y='195' class='ex' text-anchor='end'>0</text>"
			        & "<text x='80' y='40' class='zt f entra d3'>Flávio à frente ↑</text>"
			        & "<text x='80' y='350' class='zt l entra d3'>Lula à frente ↓</text>"
			        & _datas
			        & "<line x1='" & FORMAT ( _x1, _f, "en-US" ) & "' x2='" & FORMAT ( _x1, _f, "en-US" ) & "' y1='14' y2='366' class='mk'/>"
			        & "<text x='" & FORMAT ( _x1, _f, "en-US" ) & "' y='384' class='ex b' text-anchor='middle'>1º turno · "
			            & FORMAT ( _d1, "dd/MM" ) & "</text>"
			        & "<line x1='" & FORMAT ( _xDeb, _f, "en-US" ) & "' x2='" & FORMAT ( _xDeb, _f, "en-US" ) & "' y1='14' y2='366' class='mk s'/>"
			        -- os dois debates: o nome da Band termina na linha dela e o da Globo começa na dela (5 dias = 79 px; centrados,
			        -- os dois nomes se encostariam)
			        & "<text x='" & FORMAT ( _xDeb + 3, _f, "en-US" ) & "' y='10' class='ex' text-anchor='end'>debate na Band</text>"
			        & IF (
			            NOT ISBLANK ( _debG ),
			            "<line x1='" & FORMAT ( _xDebG, _f, "en-US" ) & "' x2='" & FORMAT ( _xDebG, _f, "en-US" ) & "' y1='14' y2='366' class='mk s'/>"
			                & "<text x='" & FORMAT ( _xDebG - 3, _f, "en-US" ) & "' y='10' class='ex' text-anchor='start'>debate na Globo</text>"
			        )
			        & "<line x1='" & FORMAT ( _x2, _f, "en-US" ) & "' x2='" & FORMAT ( _x2, _f, "en-US" ) & "' y1='70' y2='366' class='mk'/>"
			        & "<text x='" & FORMAT ( _x2, _f, "en-US" ) & "' y='384' class='ex b' text-anchor='middle'>2º turno · "
			            & FORMAT ( _d2, "dd/MM" ) & "</text>"
			        & "<polyline points='" & _linhaA & "' pathLength='1' class='mm traco' filter='url(#rbu)' style='animation-delay:.6s'/>"
			        & "<polyline points='" & _linhaD & "' pathLength='1' class='mm traco-rapido' filter='url(#rbu)' style='animation-delay:2.4s'/>"
			    & "</svg>"
			VAR _urna =
			    "<div class='urna entra d10' style='left:" & FORMAT ( _x2 - 24, _f, "en-US" ) & "px;top:" & FORMAT ( 72 + 20, _f, "en-US" )
			        & "px'></div>"
			VAR _fim =
			    "<div class='fim entra d16' style='left:1452px;top:" & FORMAT ( 72 + _yFim - 26, _f, "en-US" ) & "px'>"
			        & "<div class='rot'>média até " & FORMAT ( _diaFim, "dd/MM" ) & "</div><div class='num " & IF ( _quemFim = "Lula", "lula", "flavio" ) & "'>" & _txtFim
			        & "</div></div>"
			VAR _nota =
			    "<div class='seta entra d14' style='left:" & FORMAT ( _xVir + 2, _f, "en-US" ) & "px;top:" & FORMAT ( 72 + _yVir + 6, _f, "en-US" )
			        & "px;transform:scale(1,-1)'></div>"
			        & "<div class='mao entra d14' style='left:" & FORMAT ( _xVir + 58, _f, "en-US" ) & "px;top:"
			        & FORMAT ( 72 + _yVir + 52, _f, "en-US" ) & "px'>a média virou aqui</div>"
			RETURN
			    "<div class='tela t17g'>"
			        & "<div class='cab'><div class='sob sobe'>Lula × Flávio no 2º turno, pesquisa a pesquisa · " & _n
			        & " pesquisas · votos totais" & IF ( NOT ISBLANK ( _per ), " · em destaque, " & _pNome ) & "</div><div class='man sobe d2'>"
			        & IF ( ISBLANK ( _per ), _txtMan, _txtManP ) & "</div></div>"
			        & _svg & _urna & _fim & IF ( ISBLANK ( _per ), _nota )
			        & "<div class='leg entra d12'><b><i style='background:var(--azul)'></i>Flávio à frente</b>"
			        & "<b><i style='background:var(--vermelho)'></i>Lula à frente</b>"
			        & IF (
			            ISBLANK ( _per ),
			            "Cada ponto é uma pesquisa; a distância até o empate é a vantagem, em pontos · vazado: simulação antes do 1º turno"
			                & " · traço: média dos 10 dias anteriores, com 3 pesquisas ou mais",
			            "Em destaque, as pesquisas com o campo inteiro no período (a faixa é o campo; o ponto fica no dia da divulgação)"
			                & " · esmaecidas, as outras · traço: média dos 10 dias"
			        )
			        & "</div>"
			    & "</div>"
		displayFolder: T17 2º turno\Desenho
		lineageTag: 85492409-ae96-57bd-be53-16351a98e609

	/// Texto para leitor de tela dos quadrinhos da rejeição (um por instituto).
	measure 'T17 · Painéis · ALT' =
			"Um quadrinho por instituto (" & [T17 · rejeição · institutos comparáveis]
			    & "): rejeição de Lula e de Flávio na última medição antes e na última depois do 1º turno. Passe o mouse para ver a série; clique para acender as pesquisas do instituto na curva."
		displayFolder: T17 2º turno\Desenho
		lineageTag: e6da824f-3b66-50bf-bff6-5278590a2cfb

	/// Um quadrinho por instituto comparável (grão 'Rejeição'[Instituto]): a rejeição de Lula e de Flávio na última medição antes do 1º turno (ponto vazado e valor à esquerda) e na última depois (ponto cheio e valor à direita), na mesma escala (40% a 58%), e as datas. Valores afastados quando ficariam um sobre o outro. Cinco por linha, em ordem alfabética. Clique num ponto da curva: o quadrinho do instituto daquela pesquisa fica em destaque (fx) e os outros esmaecem (fora), se ele tiver quadrinho. Alvo do dossiê ttT17Rejeicao; vazio nos institutos sem as duas medições ou com pergunta trocada.
	measure 'T17 · Painéis · HTML' =
			-- 1 · Leituras
			VAR _ok = [T17 · rejeição · comparável]
			VAR _ord = [T17 · rejeição · ordem]
			VAR _inst = [T17 · rejeição · instituto]
			VAR _al = [T17 · rejeição · antes · Lula]
			VAR _af = [T17 · rejeição · antes · Flávio]
			VAR _dl = [T17 · rejeição · depois · Lula]
			VAR _df = [T17 · rejeição · depois · Flávio]
			VAR _da = [T17 · rejeição · antes · data]
			VAR _dd = [T17 · rejeição · depois · data]
			VAR _foco = [T17 · foco · instituto da pesquisa]
			VAR _temQ = [T17 · foco · pesquisa com quadrinho]
			-- 2 · Textos
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _clsFoco = IF ( _temQ = "Sim", IF ( _foco = _inst, " fx", " fora" ), "" )
			VAR _txtDatas = FORMAT ( _da, "dd/MM" ) & " → " & FORMAT ( _dd, "dd/MM" )
			VAR _tAl = IF ( INT ( _al ) = _al, FORMAT ( _al, "0" ), FORMAT ( _al, "0.0" ) )
			VAR _tAf = IF ( INT ( _af ) = _af, FORMAT ( _af, "0" ), FORMAT ( _af, "0.0" ) )
			VAR _tDl = IF ( INT ( _dl ) = _dl, FORMAT ( _dl, "0" ), FORMAT ( _dl, "0.0" ) )
			VAR _tDf = IF ( INT ( _df ) = _df, FORMAT ( _df, "0" ), FORMAT ( _df, "0.0" ) )
			-- 3 · Geometria (quadrinho 144 × 104, cinco por linha a cada 154 px, linhas a cada 114 px a partir de y 122;
			--   svg 144 × 62: linhas de x 36 a 104, escala 58% em y 6 e 40% em y 56; valores a 13 px de distância no mínimo)
			VAR _col = MOD ( _ord - 1, 5 ) -- geometria
			VAR _lin = INT ( ( _ord - 1 ) / 5 ) -- geometria
			VAR _yAl = 6 + ( 58 - MAX ( MIN ( _al, 58 ), 40 ) ) / 18 * 50 -- geometria
			VAR _yAf = 6 + ( 58 - MAX ( MIN ( _af, 58 ), 40 ) ) / 18 * 50 -- geometria
			VAR _yDl = 6 + ( 58 - MAX ( MIN ( _dl, 58 ), 40 ) ) / 18 * 50 -- geometria
			VAR _yDf = 6 + ( 58 - MAX ( MIN ( _df, 58 ), 40 ) ) / 18 * 50 -- geometria
			VAR _mA = ( _yAl + _yAf ) / 2 -- geometria
			VAR _mD = ( _yDl + _yDf ) / 2 -- geometria
			VAR _perto = 13 -- geometria
			VAR _tyAl = IF ( ABS ( _yAl - _yAf ) < _perto, _mA + IF ( _al >= _af, -_perto / 2, _perto / 2 ), _yAl ) + 4.5 -- geometria
			VAR _tyAf = IF ( ABS ( _yAl - _yAf ) < _perto, _mA + IF ( _al >= _af, _perto / 2, -_perto / 2 ), _yAf ) + 4.5 -- geometria
			VAR _tyDl = IF ( ABS ( _yDl - _yDf ) < _perto, _mD + IF ( _dl >= _df, -_perto / 2, _perto / 2 ), _yDl ) + 4.5 -- geometria
			VAR _tyDf = IF ( ABS ( _yDl - _yDf ) < _perto, _mD + IF ( _dl >= _df, _perto / 2, -_perto / 2 ), _yDf ) + 4.5 -- geometria
			VAR _f = "0.0"
			VAR _atraso = 600 + _ord * 120 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _ok = "Sim",
			        "<div class='tela t17q" & _clsFoco & "'><div class='pn entra' style='left:" & _col * 154 & "px;top:" & 122 + _lin * 114
			            & "px;animation-delay:" & _atraso & "ms'><b>" & _esc & "</b>"
			            & "<svg width='144' height='62' viewBox='0 0 144 62'>"
			                & "<line x1='36' x2='104' y1='" & FORMAT ( _yAl, _f, "en-US" ) & "' y2='" & FORMAT ( _yDl, _f, "en-US" )
			                & "' class='ll traco' pathLength='1' style='animation-delay:" & _atraso + 150 & "ms'/>"
			                & "<line x1='36' x2='104' y1='" & FORMAT ( _yAf, _f, "en-US" ) & "' y2='" & FORMAT ( _yDf, _f, "en-US" )
			                & "' class='lf traco' pathLength='1' style='animation-delay:" & _atraso + 250 & "ms'/>"
			                & "<circle cx='36' cy='" & FORMAT ( _yAl, _f, "en-US" ) & "' r='3.6' class='al'/>"
			                & "<circle cx='36' cy='" & FORMAT ( _yAf, _f, "en-US" ) & "' r='3.6' class='af'/>"
			                & "<circle cx='104' cy='" & FORMAT ( _yDl, _f, "en-US" ) & "' r='4.2' class='dl'/>"
			                & "<circle cx='104' cy='" & FORMAT ( _yDf, _f, "en-US" ) & "' r='4.2' class='df'/>"
			                & "<text x='30' y='" & FORMAT ( _tyAl, _f, "en-US" ) & "' text-anchor='end' class='vl va'>" & _tAl & "</text>"
			                & "<text x='30' y='" & FORMAT ( _tyAf, _f, "en-US" ) & "' text-anchor='end' class='vf va'>" & _tAf & "</text>"
			                & "<text x='110' y='" & FORMAT ( _tyDl, _f, "en-US" ) & "' class='vl'>" & _tDl & "</text>"
			                & "<text x='110' y='" & FORMAT ( _tyDf, _f, "en-US" ) & "' class='vf'>" & _tDf & "</text>"
			            & "</svg><span>" & _txtDatas & "</span></div></div>"
			    )
		displayFolder: T17 2º turno\Desenho
		lineageTag: 64e2f0ae-e654-53de-b70e-2aa54d7ec60d

	/// Texto para leitor de tela do placar das pesquisas do 2º turno (≤ 250 caracteres); com um período escolhido, o placar do período.
	measure 'T17 · Placar · ALT' =
			VAR _per = [Período · escolhido]
			VAR _nP = [T17 · período · pesquisas]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _per ),
			            "Depois do 1º turno, Flávio lidera " & [T17 · depois · Flávio à frente] & " de " & [T17 · depois · pesquisas]
			                & " pesquisas do 2º turno; Lula, " & [T17 · depois · Lula à frente] & ". Antes, nas " & [T17 · antes · pesquisas]
			                & " simulações: Lula " & [T17 · antes · Lula à frente] & ", Flávio " & [T17 · antes · Flávio à frente] & ", "
			                & [T17 · antes · empates] & " empates.",
			        [T17 · período · ainda sem dado] = 1,
			            [Período · nome] & ": as pesquisas com campo depois do debate ainda não chegaram.",
			        _nP = 0, [Período · nome] & ": nenhuma pesquisa com o campo inteiro no período.",
			        [Período · nome] & ": " & _nP & IF ( _nP = 1, " pesquisa", " pesquisas" ) & " com o campo inteiro no período; Flávio à frente em "
			            & [T17 · período · Flávio à frente] & ", Lula em " & [T17 · período · Lula à frente] & ", empate em "
			            & [T17 · período · empates] & ". Média: Flávio " & FORMAT ( [T17 · período · Flávio], "0.0" ) & "% e Lula "
			            & FORMAT ( [T17 · período · Lula], "0.0" ) & "% dos votos totais."
			    )
		displayFolder: T17 2º turno\Desenho
		lineageTag: b758beae-9769-570f-8d1e-690b10909949

	/// O placar das pesquisas do 2º turno: quantas das feitas depois do 1º turno dão Flávio à frente (contadores), as médias em votos totais e válidos, a manchete e dois quadriculados (um quadradinho por pesquisa na cor de quem liderava): as simulações antes do 1º turno e as pesquisas depois. Com um instituto em destaque (clique num quadrinho da rejeição ou num ponto da curva), os quadradinhos dele ganham contorno, os outros esmaecem e a contagem embaixo passa a ser a dele. Com um período escolhido no filtro Período (23/10/2026), o placar conta só as pesquisas com o campo inteiro dentro do período (a que atravessa o dia do debate fica fora, como na T07): quem liderou, as médias, a manchete do período e, nos quadriculados, as do período em destaque e o resto esmaecido; sem pesquisa, o estado honesto (nenhuma no período, ou ainda não chegaram depois da Globo). Só lê contas 'T17 · …' e 'Período · …'.
	measure 'T17 · Placar · HTML' =
			-- 1 · Leituras
			VAR _nD = [T17 · depois · pesquisas]
			VAR _fD = [T17 · depois · Flávio à frente]
			VAR _lD = [T17 · depois · Lula à frente]
			VAR _eD = [T17 · depois · empates]
			VAR _nA = [T17 · antes · pesquisas]
			VAR _fA = [T17 · antes · Flávio à frente]
			VAR _lA = [T17 · antes · Lula à frente]
			VAR _eA = [T17 · antes · empates]
			VAR _mL = [T17 · depois · Lula]
			VAR _mF = [T17 · depois · Flávio]
			VAR _vL = [T17 · depois · válidos · Lula]
			VAR _vF = [T17 · depois · válidos · Flávio]
			VAR _vN = [T17 · depois · válidos · pesquisas]
			VAR _foco = [T17 · foco · instituto]
			VAR _kLA = [T17 · foco · antes · Lula à frente]
			VAR _kEA = [T17 · foco · antes · empates]
			VAR _kFA = [T17 · foco · antes · Flávio à frente]
			VAR _kLD = [T17 · foco · depois · Lula à frente]
			VAR _kED = [T17 · foco · depois · empates]
			VAR _kFD = [T17 · foco · depois · Flávio à frente]
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pDe = [T17 · período · campo de]
			VAR _pAte = [T17 · período · campo até]
			VAR _nP = [T17 · período · pesquisas]
			VAR _lP = [T17 · período · Lula à frente]
			VAR _eP = [T17 · período · empates]
			VAR _fP = [T17 · período · Flávio à frente]
			VAR _mLP = [T17 · período · Lula]
			VAR _mFP = [T17 · período · Flávio]
			VAR _difP = [T17 · período · diferença]
			VAR _vLP = [T17 · período · válidos · Lula]
			VAR _vFP = [T17 · período · válidos · Flávio]
			VAR _vNP = [T17 · período · válidos · pesquisas]
			VAR _atr = [T17 · período · atravessam o debate]
			VAR _parte = [T17 · período · só em parte]
			VAR _espera = [T17 · período · ainda sem dado]
			VAR _unica = [T17 · período · única · instituto]
			VAR _pDeb = [Período · debate]
			VAR _pDebData = [Período · debate · data]
			VAR _qLP = [T17 · foco · período · Lula à frente]
			VAR _qEP = [T17 · foco · período · empates]
			VAR _qFP = [T17 · foco · período · Flávio à frente]
			-- 2 · Textos
			VAR _txtLado =
			    IF ( _nD = 1, "pesquisa feita", "pesquisas feitas" ) & " depois do 1º turno "
			        & IF ( _fD = 1, "dá", "dão" ) & " Flávio à frente de Lula"
			VAR _txtMedias =
			    "Média: Flávio " & FORMAT ( _mF, "0.0" ) & "% × Lula " & FORMAT ( _mL, "0.0" ) & "% dos votos totais ("
			        & FORMAT ( _vF, "0.0" ) & "% × " & FORMAT ( _vL, "0.0" ) & "% dos válidos, nas " & _vN
			        & IF ( _vN = 1, " que divulgou os válidos", " que divulgaram os válidos" ) & ")."
			VAR _txtCont = "<span><b class='lula-esc'>" & _lA & "</b> Lula</span><span><b>" & _eA & "</b> "
			    & IF ( _eA = 1, "empate", "empates" ) & "</span><span><b class='flavio-esc'>" & _fA & "</b> Flávio</span>"
			VAR _txtContD = "<span><b class='lula-esc'>" & _lD & "</b> Lula</span><span><b>" & _eD & "</b> "
			    & IF ( _eD = 1, "empate", "empates" ) & "</span><span><b class='flavio-esc'>" & _fD & "</b> Flávio</span>"
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _foco, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtFocoA =
			    IF (
			        _kLA + _kEA + _kFA = 0,
			        "<span class='fo'>" & _esc & ": nenhuma simulação</span>",
			        "<span><b class='lula-esc'>" & _kLA & "</b> Lula</span><span><b>" & _kEA & "</b> "
			            & IF ( _kEA = 1, "empate", "empates" ) & "</span><span><b class='flavio-esc'>" & _kFA
			            & "</b> Flávio</span><span class='fo'>" & _esc & "</span>"
			    )
			VAR _txtFocoD =
			    IF (
			        _kLD + _kED + _kFD = 0,
			        "<span class='fo'>" & _esc & ": nenhuma pesquisa</span>",
			        "<span><b class='lula-esc'>" & _kLD & "</b> Lula</span><span><b>" & _kED & "</b> "
			            & IF ( _kED = 1, "empate", "empates" ) & "</span><span><b class='flavio-esc'>" & _kFD
			            & "</b> Flávio</span><span class='fo'>" & _esc & "</span>"
			    )
			VAR _semFoco = ISBLANK ( _foco )
			-- 2b · Textos do período (só com um período escolhido)
			VAR _pJanela =
			    SWITCH (
			        DATEDIFF ( _pDe, _pAte, DAY ),
			        0, "em " & FORMAT ( _pDe, "dd/MM" ),
			        1, "em " & FORMAT ( _pDe, "dd" ) & " e " & FORMAT ( _pAte, "dd/MM" ),
			        "de " & FORMAT ( _pDe, "dd" ) & " a " & FORMAT ( _pAte, "dd/MM" )
			    )
			VAR _pQuem = SWITCH ( TRUE (), _fP > _lP, "Flávio", _lP > _fP, "Lula", "" )
			VAR _pOutro = IF ( _pQuem = "Flávio", "Lula", "Flávio" )
			VAR _pNum = MAX ( _fP, _lP )
			VAR _pQuemDif = SWITCH ( TRUE (), _difP > 0, "Flávio", _difP < 0, "Lula", "" )
			VAR _pPontos = FORMAT ( ABS ( _difP ), "0.0" ) & IF ( ROUND ( ABS ( _difP ), 1 ) = 1, " ponto", " pontos" )
			VAR _pFora =
			    IF ( _atr > 0, "; " & IF ( _atr = 1, "a que atravessa o debate fica fora", "as " & _atr & " que atravessam o debate ficam fora" ) )
			VAR _pSob =
			    _pNome & " · "
			        & IF ( _espera = 1, "pesquisas com campo depois do debate", "pesquisas com o campo inteiro " & _pJanela )
			VAR _pLado =
			    SWITCH (
			        TRUE (),
			        _espera = 1, "pesquisa com o campo depois do debate da " & _pDeb & " (" & FORMAT ( _pDebData, "dd/MM" ) & ")",
			        _nP = 0, "com o campo inteiro " & _pJanela,
			        _pQuem = "", IF ( _nP = 1, "pesquisa", "pesquisas" ) & " do período: Lula e Flávio na frente no mesmo número",
			        IF ( _nP = 1, "pesquisa com o campo inteiro no período", "pesquisas com o campo inteiro no período" )
			            & IF ( _pNum = 1, " dá ", " dão " ) & _pQuem & " à frente de " & _pOutro
			    )
			VAR _pMedias =
			    SWITCH (
			        TRUE (),
			        _espera = 1, "O levantamento é de 22/10: as pesquisas feitas depois do debate ainda vão ser registradas.",
			        _nP = 0,
			            IF (
			                _parte > 0,
			                _parte & IF ( _parte = 1, " pesquisa pega", " pesquisas pegam" )
			                    & " só parte do período e " & IF ( _parte = 1, "fica", "ficam" ) & " fora: só conta a de campo inteiro.",
			                "Só conta a pesquisa com o campo inteiro dentro do período."
			            ),
			        "Média: "
			            & IF (
			                _mFP > _mLP,
			                "Flávio " & FORMAT ( _mFP, "0.0" ) & "% × Lula " & FORMAT ( _mLP, "0.0" ) & "%",
			                "Lula " & FORMAT ( _mLP, "0.0" ) & "% × Flávio " & FORMAT ( _mFP, "0.0" ) & "%"
			            )
			            & " dos votos totais"
			            & IF (
			                _vNP > 0,
			                " ("
			                    & IF ( _mFP > _mLP, FORMAT ( _vFP, "0.0" ) & "% × " & FORMAT ( _vLP, "0.0" ), FORMAT ( _vLP, "0.0" ) & "% × " & FORMAT ( _vFP, "0.0" ) )
			                    & "% dos válidos, nas " & _vNP & IF ( _vNP = 1, " que divulgou os válidos)", " que divulgaram os válidos)" )
			            ) & "."
			    )
			VAR _pMan =
			    SWITCH (
			        TRUE (),
			        _espera = 1, _pNome & ", ainda não dá para dizer: as pesquisas com campo depois do debate de "
			            & FORMAT ( _pDebData, "dd/MM" ) & " ainda não chegaram",
			        _nP = 0, _pNome & ", nenhuma pesquisa teve o campo inteiro no período" & _pFora,
			        _nP = 1, _pNome & ", só uma pesquisa coube no período: " & _unica & ", com "
			            & IF ( _pQuemDif = "", "empate", _pQuemDif & " " & _pPontos & " à frente" ) & _pFora,
			        _pNome & ", a média das " & _nP & " pesquisas dava "
			            & IF ( _pQuemDif = "", "empate", _pQuemDif & " " & _pPontos & " à frente" ) & _pFora
			    ) & "."
			VAR _pEscFoco = IF ( _semFoco, "", _esc )
			VAR _pCont =
			    IF (
			        _semFoco,
			        IF (
			            _nP = 0,
			            "<span class='fo'>" & IF ( _espera = 1, "ainda sem pesquisa no período", "nenhuma no período" ) & "</span>",
			            "<span><b class='lula-esc'>" & _lP & "</b> Lula</span><span><b>" & _eP & "</b> "
			                & IF ( _eP = 1, "empate", "empates" ) & "</span><span><b class='flavio-esc'>" & _fP
			                & "</b> Flávio</span><span class='fo'>no período</span>"
			        ),
			        IF (
			            _qLP + _qEP + _qFP = 0,
			            "<span class='fo'>" & _pEscFoco & ": nenhuma no período</span>",
			            "<span><b class='lula-esc'>" & _qLP & "</b> Lula</span><span><b>" & _qEP & "</b> "
			                & IF ( _qEP = 1, "empate", "empates" ) & "</span><span><b class='flavio-esc'>" & _qFP
			                & "</b> Flávio</span><span class='fo'>" & _pEscFoco & " no período</span>"
			        )
			    )
			-- 3b · Geometria do período: as do período (ou as do instituto em destaque, no período) em destaque nos 39 de
			--   depois; as 79 simulações de antes do 1º turno nunca cabem num período e esmaecem todas
			VAR _hL = IF ( _semFoco, _lP, _qLP )
			VAR _hE = IF ( _semFoco, _eP, _qEP )
			VAR _hF = IF ( _semFoco, _fP, _qFP )
			VAR _gradeAP =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _nA, 1 ),
			        "<i class='" & IF ( [Value] <= _lA, "l", IF ( [Value] <= _lA + _eA, "e", "f" ) ) & " fora' style='animation-delay:"
			            & ( 400 + [Value] * 14 ) & "ms," & ( 400 + [Value] * 14 ) & "ms'></i>",
			        "",
			        [Value], ASC
			    )
			VAR _gradeDP =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _nD, 1 ),
			        "<i class='" & IF ( [Value] <= _lD, "l", IF ( [Value] <= _lD + _eD, "e", "f" ) )
			            & IF (
			                SWITCH (
			                    TRUE (),
			                    [Value] <= _lD, [Value] <= _hL,
			                    [Value] <= _lD + _eD, [Value] - _lD <= _hE,
			                    [Value] - _lD - _eD <= _hF
			                ),
			                IF ( _semFoco, "", " fx" ),
			                " fora"
			            ) & "' style='animation-delay:"
			            & ( 1200 + [Value] * 22 ) & "ms," & ( 1200 + [Value] * 22 ) & "ms'></i>",
			        "",
			        [Value], ASC
			    )
			VAR _pHero =
			    IF (
			        _nP = 0,
			        "<div class='vazio sobe d1'>" & IF ( _espera = 1, "ainda não chegou", "nenhuma pesquisa" ) & "</div>",
			        "<div class='hero sobe d1'><span class='num" & SWITCH ( _pQuem, "Flávio", " flavio", "Lula", " lula", "" ) & "'>"
			            & _pNum & "</span><span class='de'>de</span><span class='num'>" & _nP & "</span></div>"
			    )
			-- 3 · Geometria (um quadradinho por pesquisa: Lula, empates, Flávio; o atraso faz a cor esmaecer em onda)
			VAR _gradeA =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _nA, 1 ),
			        "<i class='" & IF ( [Value] <= _lA, "l", IF ( [Value] <= _lA + _eA, "e", "f" ) )
			            & IF (
			                _semFoco,
			                "",
			                IF (
			                    SWITCH (
			                        TRUE (),
			                        [Value] <= _lA, [Value] <= _kLA,
			                        [Value] <= _lA + _eA, [Value] - _lA <= _kEA,
			                        [Value] - _lA - _eA <= _kFA
			                    ),
			                    " fx",
			                    " fora"
			                )
			            ) & "' style='animation-delay:"
			            & ( 400 + [Value] * 14 ) & "ms," & ( 400 + [Value] * 14 ) & "ms'></i>",
			        "",
			        [Value], ASC
			    )
			VAR _gradeD =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _nD, 1 ),
			        "<i class='" & IF ( [Value] <= _lD, "l", IF ( [Value] <= _lD + _eD, "e", "f" ) )
			            & IF (
			                _semFoco,
			                "",
			                IF (
			                    SWITCH (
			                        TRUE (),
			                        [Value] <= _lD, [Value] <= _kLD,
			                        [Value] <= _lD + _eD, [Value] - _lD <= _kED,
			                        [Value] - _lD - _eD <= _kFD
			                    ),
			                    " fx",
			                    " fora"
			                )
			            ) & "' style='animation-delay:"
			            & ( 1200 + [Value] * 22 ) & "ms," & ( 1200 + [Value] * 22 ) & "ms'></i>",
			        "",
			        [Value], ASC
			    )
			-- 4 · Marcação
			VAR _brasil =
			    "<div class='tela t17a'>"
			        & "<div class='sob sobe'>Depois do 1º turno · pesquisas do 2º turno</div>"
			        & "<div class='linha'>"
			            & "<div class='hero sobe d1'><span class='num flavio'>" & _fD & "</span><span class='de'>de</span>"
			                & "<span class='num'>" & _nD & "</span></div>"
			            & "<div class='lado sobe d3'><div class='man'>" & _txtLado & "</div>"
			                & "<div class='txt'>" & _txtMedias & "</div></div>"
			        & "</div>"
			        & "<div class='man manchete sobe d5'>Antes do 1º turno, a disputa estava dividida; depois, Flávio passou a liderar quase todas</div>"
			        & "<div class='waf sobe d6' style='left:0'><div class='rot'>Antes do 1º turno · " & _nA & " simulações</div>"
			            & "<div class='grade'>" & _gradeA & "</div><div class='cont'>" & IF ( _semFoco, _txtCont, _txtFocoA ) & "</div></div>"
			        & "<div class='waf sobe d8' style='left:400px'><div class='rot'>Depois · " & _nD & " pesquisas</div>"
			            & "<div class='grade'>" & _gradeD & "</div><div class='cont'>" & IF ( _semFoco, _txtContD, _txtFocoD ) & "</div></div>"
			    & "</div>"
			VAR _periodo =
			    "<div class='tela t17a'>"
			        & "<div class='sob sobe'>" & _pSob & "</div>"
			        & "<div class='linha'>"
			            & _pHero
			            & "<div class='lado sobe d3'><div class='man'>" & _pLado & "</div>"
			                & "<div class='txt'>" & _pMedias & "</div></div>"
			        & "</div>"
			        & "<div class='man manchete sobe d5'>" & _pMan & "</div>"
			        & "<div class='waf sobe d6' style='left:0'><div class='rot'>Antes do 1º turno · " & _nA & " simulações</div>"
			            & "<div class='grade'>" & _gradeAP & "</div><div class='cont'><span class='fo'>fora do período</span></div></div>"
			        & "<div class='waf sobe d8' style='left:400px'><div class='rot'>Depois · " & _nD & " pesquisas</div>"
			            & "<div class='grade'>" & _gradeDP & "</div><div class='cont'>" & _pCont & "</div></div>"
			    & "</div>"
			RETURN
			    IF ( ISBLANK ( _per ), _brasil, _periodo )
		displayFolder: T17 2º turno\Desenho
		lineageTag: b41898f9-a22f-51c8-a069-0454539e6ce0

	/// Texto para leitor de tela dos pontos das pesquisas do 2º turno; com um período escolhido, quantas estão em destaque (ou que nenhuma, ou que ainda não chegaram).
	measure 'T17 · Pontos · ALT' =
			VAR _nP = [T17 · período · pesquisas]
			RETURN
			    IF (
			        ISBLANK ( [Período · escolhido] ),
			        "Um ponto por pesquisa do 2º turno (" & [T17 · pesquisas]
			            & "): acima da linha, Flávio à frente; abaixo, Lula. Vazado: simulação antes do 1º turno. Passe o mouse para ver o instituto; clique para acender a série dele.",
			        "Um ponto por pesquisa do 2º turno (" & [T17 · pesquisas] & "). " & [Período · nome] & ": "
			            & SWITCH (
			                TRUE (),
			                [T17 · período · ainda sem dado] = 1, "as pesquisas ainda não chegaram",
			                _nP = 0, "nenhuma com o campo inteiro no período",
			                _nP & " em destaque, com o campo inteiro no período; as outras esmaecem"
			            )
			            & ". Acima da linha, Flávio à frente; abaixo, Lula."
			    )
		displayFolder: T17 2º turno\Desenho
		lineageTag: d6332670-a092-586a-9959-4ce45589e908

	/// Um ponto por pesquisa de 2º turno (grão Pesquisa[Id]) na escala do fundo (T17 · Curva · HTML): x no dia de divulgação, y na diferença Flávio − Lula. Azul = Flávio à frente, vermelho = Lula, cinza = empate; vazado = simulação feita antes do 1º turno. Cada ponto leva o traço até a pesquisa anterior do MESMO instituto e, na última dele, o nome: escondidos, aparecem quando a série está em destaque (clique num quadrinho da rejeição = classe fx; clique num ponto = a folha liga os pontos com a mesma classe i<n>); os outros esmaecem. Com um período escolhido no filtro Período, a pesquisa sem o campo inteiro no período esmaece (classe fora; a do instituto clicado segue a regra do destaque). Alvo do dossiê ttT17Pesquisa; vazio fora do conjunto.
	measure 'T17 · Pontos · HTML' =
			-- 1 · Leituras
			VAR _mom = [T17 · pesquisa · momento]
			VAR _dif = [T17 · pesquisa · diferença]
			VAR _dia = [T17 · pesquisa · divulgação]
			VAR _ord = [T17 · pesquisa · ordem no dia]
			VAR _n = [T17 · pesquisa · no mesmo dia]
			VAR _inst = [T17 · pesquisa · instituto]
			VAR _num = [T17 · série · número do instituto]
			VAR _diaA = [T17 · série · anterior · divulgação]
			VAR _difA = [T17 · série · anterior · diferença]
			VAR _ordA = [T17 · série · anterior · ordem no dia]
			VAR _nA = [T17 · série · anterior · no mesmo dia]
			VAR _ult = [T17 · série · última do instituto]
			VAR _foco = [T17 · foco · instituto da rejeição]
			VAR _noPer = [T17 · pesquisa · no período]
			-- 2 · Textos
			VAR _cls =
			    SWITCH ( TRUE (), _dif > 0, "f", _dif < 0, "l", "e" ) & IF ( _mom = "antes_1turno", " sim", "" )
			VAR _clsFoco = IF ( ISBLANK ( _foco ), "", IF ( _foco = _inst, " fx", " fora" ) )
			VAR _clsPer = IF ( ISBLANK ( _noPer ) || _noPer = "dentro", "", " fora" ) -- período: fora do período esmaece
			VAR _clsTela = IF ( _clsFoco = "", _clsPer, _clsFoco )
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			-- 3 · Geometria (x: 01/08 a 27/10 em x 70–1440; y: −10 a +10 em y 360–20; o svg do fundo começa em y 72; ponto de 12 px;
			--   o traço vai do centro da pesquisa anterior do mesmo instituto ao centro desta)
			VAR _dias = DATEDIFF ( DATE ( 2026, 8, 1 ), _dia, DAY )
			VAR _x = 70 + _dias / 87 * 1370 + ( _ord - ( _n - 1 ) / 2 ) * 7 - 6 -- geometria
			VAR _y = 72 + 190 - MAX ( MIN ( _dif, 10 ), -10 ) / 10 * 170 - 6 -- geometria
			VAR _xA = 70 + DATEDIFF ( DATE ( 2026, 8, 1 ), _diaA, DAY ) / 87 * 1370 + ( _ordA - ( _nA - 1 ) / 2 ) * 7 -- geometria
			VAR _yA = 72 + 190 - MAX ( MIN ( _difA, 10 ), -10 ) / 10 * 170 -- geometria
			VAR _atraso = 500 + _dias * 22 + _ord * 25 -- geometria
			VAR _f = "0.0"
			VAR _traco =
			    IF (
			        NOT ISBLANK ( _diaA ),
			        "<svg class='sg' width='1620' height='495' viewBox='0 0 1620 495'><line x1='" & FORMAT ( _xA, _f, "en-US" )
			            & "' y1='" & FORMAT ( _yA, _f, "en-US" ) & "' x2='" & FORMAT ( _x + 6, _f, "en-US" ) & "' y2='"
			            & FORMAT ( _y + 6, _f, "en-US" ) & "'/></svg>"
			    )
			VAR _nome =
			    IF (
			        _ult = "Sim",
			        "<b class='nm' style='left:" & FORMAT ( _x + 6, _f, "en-US" ) & "px;top:" & FORMAT ( _y - 28, _f, "en-US" )
			            & "px'>" & _esc & "</b>"
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _mom ),
			        "<div class='tela t17p i" & _num & _clsTela & "'>" & _traco & "<i class='pt " & _cls & "' style='left:"
			            & FORMAT ( _x, _f, "en-US" ) & "px;top:" & FORMAT ( _y, _f, "en-US" ) & "px;animation-delay:" & _atraso
			            & "ms'></i>" & _nome & "</div>"
			    )
		displayFolder: T17 2º turno\Desenho
		lineageTag: 1b990d40-369d-512e-b3d7-79efd54a9763

	/// Texto para leitor de tela do cabeçalho da rejeição.
	measure 'T17 · Rejeição · ALT' =
			"Rejeição por instituto: depois do 1º turno, a de Flávio ficou igual ou abaixo da de Lula em "
			    & [T17 · rejeição · Flávio igual ou abaixo] & " de " & [T17 · rejeição · institutos comparáveis]
			    & " institutos. Cada instituto pergunta de um jeito."
		displayFolder: T17 2º turno\Desenho
		lineageTag: ed09e8be-b14b-5236-8713-7143ee5e1515

	/// Cabeçalho da rejeição: em quantos institutos a rejeição de Flávio ficou igual ou abaixo da de Lula depois do 1º turno e como ler os quadrinhos (um por instituto, outro visual: T17 · Painéis · HTML). Com um ponto da curva clicado, a nota diz se o instituto daquela pesquisa tem quadrinho. Só lê contas 'T17 · rejeição · …' e 'T17 · foco · …'.
	measure 'T17 · Rejeição · HTML' =
			-- 1 · Leituras
			VAR _n = [T17 · rejeição · institutos comparáveis]
			VAR _abaixo = [T17 · rejeição · Flávio igual ou abaixo]
			VAR _caiu = [T17 · rejeição · Flávio caiu]
			VAR _foco = [T17 · foco · instituto da pesquisa]
			VAR _temQ = [T17 · foco · pesquisa com quadrinho]
			-- 2 · Textos
			VAR _txtMan =
			    "Depois do 1º turno, a rejeição de Flávio ficou igual ou abaixo da de Lula em " & _abaixo & " de " & _n
			        & IF ( _n = 1, " instituto", " institutos" )
			VAR _txtNota =
			    "Cada instituto pergunta de um jeito: compare só dentro do quadrinho. À esquerda, a última medição antes do 1º turno; "
			        & "à direita, a última depois. A de Flávio caiu em " & _caiu & " deles."
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _foco, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtFoco =
			    SWITCH (
			        _temQ,
			        "Sim", "Em destaque: <b>" & _esc & "</b>, o instituto da pesquisa clicada na curva. Clique de novo no ponto para ver todos.",
			        "Não", "<b>" & _esc & "</b>, o instituto da pesquisa clicada, não tem quadrinho: não mediu a rejeição antes e depois do 1º turno com a mesma pergunta.",
			        _txtNota
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t17r'>"
			        & "<div class='sob sobe'>Rejeição: quem não votaria de jeito nenhum</div>"
			        & "<div class='man sobe d2'>" & _txtMan & "</div>"
			        & "<div class='nota sobe d3'><i style='background:var(--vermelho)'></i>Lula <i style='background:var(--azul);margin-left:12px'></i>Flávio · "
			        & _txtFoco & "</div>"
			    & "</div>"
		displayFolder: T17 2º turno\Desenho
		lineageTag: cc089cfc-f0f0-577f-9da2-3bf85684d852

	/// Texto para leitor de tela do dossiê de uma pesquisa (grão Pesquisa[Id]).
	measure 'T17 · Tooltip pesquisa · ALT' =
			IF (
			    NOT ISBLANK ( [T17 · pesquisa · momento] ),
			    [T17 · pesquisa · instituto] & ", divulgada em " & FORMAT ( [T17 · pesquisa · divulgação], "dd/MM" ) & ": Lula "
			        & FORMAT ( [T17 · pesquisa · Lula], "0.0" ) & "% e Flávio " & FORMAT ( [T17 · pesquisa · Flávio], "0.0" )
			        & "%, margem de erro de " & FORMAT ( [T17 · pesquisa · margem de erro], "0.0" ) & " pontos."
			)
		displayFolder: T17 2º turno\Desenho
		lineageTag: d23d4084-850a-51ef-883e-0b046c870854

	/// Dossiê de uma pesquisa da curva do 2º turno (ttT17Pesquisa, grão Pesquisa[Id]): instituto e divulgação, Lula × Flávio, quem estava à frente e por quanto, a pesquisa anterior do MESMO instituto, a média dos 10 dias até aquele dia, campo, entrevistas, margem e registro, e a nota à mão (simulação antes do 1º turno ou pesquisa depois; com um período escolhido, se a pesquisa está no período, atravessa o debate ou fica fora).
	measure 'T17 · Tooltip pesquisa · HTML' =
			-- 1 · Leituras
			VAR _mom = [T17 · pesquisa · momento]
			VAR _inst = [T17 · pesquisa · instituto]
			VAR _dia = [T17 · pesquisa · divulgação]
			VAR _ini = [T17 · pesquisa · campo início]
			VAR _fim = [T17 · pesquisa · campo fim]
			VAR _l = [T17 · pesquisa · Lula]
			VAR _f = [T17 · pesquisa · Flávio]
			VAR _dif = [T17 · pesquisa · diferença]
			VAR _difAnt = [T17 · pesquisa · diferença anterior]
			VAR _diaAnt = [T17 · pesquisa · divulgação anterior]
			VAR _mm = [T17 · média móvel]
			VAR _n = [T17 · pesquisa · entrevistas]
			VAR _m = [T17 · pesquisa · margem de erro]
			VAR _reg = [T17 · pesquisa · registro]
			VAR _noPer = [T17 · pesquisa · no período]
			-- 2 · Textos
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escReg = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			VAR _txtDif =
			    SWITCH (
			        TRUE (),
			        _dif > 0, "Flávio " & FORMAT ( _dif, "0.0" ) & IF ( ROUND ( _dif, 1 ) = 1, " ponto", " pontos" ) & " à frente",
			        _dif < 0, "Lula " & FORMAT ( -_dif, "0.0" ) & IF ( ROUND ( -_dif, 1 ) = 1, " ponto", " pontos" ) & " à frente",
			        "Empate"
			    )
			VAR _txtAnt =
			    IF (
			        ISBLANK ( _difAnt ),
			        " É a primeira simulação de 2º turno deste instituto na base.",
			        " Na anterior do mesmo instituto (" & FORMAT ( _diaAnt, "dd/MM" ) & "): "
			            & SWITCH (
			                TRUE (),
			                _difAnt > 0, "Flávio " & FORMAT ( _difAnt, "0.0" ) & " à frente",
			                _difAnt < 0, "Lula " & FORMAT ( -_difAnt, "0.0" ) & " à frente",
			                "empate"
			            ) & "."
			    )
			VAR _txtMM =
			    IF (
			        ISBLANK ( _mm ),
			        "",
			        " A média dos 10 dias até aqui: "
			            & SWITCH ( TRUE (), _mm > 0, "Flávio +" & FORMAT ( _mm, "0.0" ), _mm < 0, "Lula +" & FORMAT ( -_mm, "0.0" ), "empate" ) & "."
			    )
			VAR _txtMao =
			    IF (
			        ISBLANK ( _noPer ),
			        IF ( _mom = "antes_1turno", "simulação, antes do 1º turno", "depois do 1º turno" ),
			        SWITCH ( _noPer, "dentro", "no período", "atravessa", "atravessa o debate", "em parte", "só parte no período", "fora do período" )
			    )
			VAR _txtReg = IF ( ISBLANK ( _reg ), "", " · <span style='white-space:nowrap'>" & _escReg & "</span>" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _mom ),
			        "<div class='tt17p'>"
			            & "<div class='sob sobe'>" & _esc & " · divulgada em " & FORMAT ( _dia, "dd/MM" ) & "</div>"
			            & "<div class='par sobe d2'>"
			                & "<div class='lula'><small>Lula</small><span class='num'>" & FORMAT ( _l, "0.0" ) & "%</span></div>"
			                & "<div class='flavio'><small>Flávio</small><span class='num'>" & FORMAT ( _f, "0.0" ) & "%</span></div>"
			            & "</div>"
			            & "<div class='txt sobe d3'><b>" & _txtDif & ".</b>" & _txtAnt & _txtMM & "</div>"
			            & "<div class='nota sobe d4'>Campo de " & FORMAT ( _ini, "dd/MM" ) & " a " & FORMAT ( _fim, "dd/MM" ) & " · "
			            & FORMAT ( _n, "#,0" ) & " entrevistas · margem de erro de " & FORMAT ( _m, "0.0" ) & " pontos" & _txtReg & "</div>"
			            & "<div class='mao" & IF ( _mom = "antes_1turno" || NOT ISBLANK ( _noPer ), " ti", "" ) & " entra d6'>" & _txtMao & "</div>"
			        & "</div>"
			    )
		displayFolder: T17 2º turno\Desenho
		lineageTag: 8262f3c6-e794-5064-87b1-202c0ebe9b06

	/// Texto para leitor de tela do dossiê de um instituto na rejeição (grão 'Rejeição'[Instituto]).
	measure 'T17 · Tooltip rejeição · ALT' =
			IF (
			    [T17 · rejeição · comparável] = "Sim",
			    [T17 · rejeição · instituto] & ": rejeição de Lula " & FORMAT ( [T17 · rejeição · depois · Lula], "0.0" )
			        & "% e de Flávio " & FORMAT ( [T17 · rejeição · depois · Flávio], "0.0" ) & "% em "
			        & FORMAT ( [T17 · rejeição · depois · data], "dd/MM" ) & "; antes do 1º turno, " & FORMAT ( [T17 · rejeição · antes · Lula], "0.0" )
			        & "% e " & FORMAT ( [T17 · rejeição · antes · Flávio], "0.0" ) & "%."
			)
		displayFolder: T17 2º turno\Desenho
		lineageTag: 607d8a25-2567-5632-8ce6-7ed51ebd94b3

	/// Dossiê de um instituto na rejeição (ttT17Rejeicao, grão 'Rejeição'[Instituto]): a última medição depois do 1º turno (Lula × Flávio), a última antes, a série inteira do instituto desde agosto (duas linhas, corte no 1º turno) e a nota à mão (quem tem a rejeição menor agora). Só lê contas 'T17 · rejeição · …'.
	measure 'T17 · Tooltip rejeição · HTML' =
			-- 1 · Leituras
			VAR _ok = [T17 · rejeição · comparável]
			VAR _inst = [T17 · rejeição · instituto]
			VAR _al = [T17 · rejeição · antes · Lula]
			VAR _af = [T17 · rejeição · antes · Flávio]
			VAR _dl = [T17 · rejeição · depois · Lula]
			VAR _df = [T17 · rejeição · depois · Flávio]
			VAR _da = [T17 · rejeição · antes · data]
			VAR _dd = [T17 · rejeição · depois · data]
			VAR _d1 = [T17 · 1º turno · data]
			VAR _serie =
			    ADDCOLUMNS (
			        VALUES ( 'Rejeição'[Divulgação] ),
			        "@l", [T17 · rejeição · no dia · Lula],
			        "@f", [T17 · rejeição · no dia · Flávio]
			    )
			-- 2 · Textos
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtAntes =
			    "Na última antes do 1º turno (" & FORMAT ( _da, "dd/MM" ) & "): Lula " & FORMAT ( _al, "0.0" ) & "% e Flávio "
			        & FORMAT ( _af, "0.0" ) & "%."
			VAR _txtMao = SWITCH ( TRUE (), _df < _dl, "Flávio abaixo de Lula", _df > _dl, "Flávio acima de Lula", "empatados" )
			-- 3 · Geometria (série: 01/08 a 25/10 em x 30–410; 40% a 58% em y 70–6)
			VAR _ini = DATE ( 2026, 8, 1 )
			VAR _f = "0.0"
			VAR _pts =
			    ADDCOLUMNS (
			        FILTER ( _serie, NOT ISBLANK ( [@l] ) && NOT ISBLANK ( [@f] ) ), /* lista */
			        "@x", 30 + DATEDIFF ( _ini, 'Rejeição'[Divulgação], DAY ) / 85 * 380,
			        "@yl", 70 - ( MAX ( MIN ( [@l], 58 ), 40 ) - 40 ) / 18 * 64,
			        "@yf", 70 - ( MAX ( MIN ( [@f], 58 ), 40 ) - 40 ) / 18 * 64
			    )
			VAR _linhaL = CONCATENATEX ( _pts, FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@yl], _f, "en-US" ), " ", 'Rejeição'[Divulgação], ASC )
			VAR _linhaF = CONCATENATEX ( _pts, FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@yf], _f, "en-US" ), " ", 'Rejeição'[Divulgação], ASC )
			VAR _bolas =
			    CONCATENATEX (
			        _pts,
			        "<circle cx='" & FORMAT ( [@x], _f, "en-US" ) & "' cy='" & FORMAT ( [@yl], _f, "en-US" ) & "' r='3' class='pl'/>"
			            & "<circle cx='" & FORMAT ( [@x], _f, "en-US" ) & "' cy='" & FORMAT ( [@yf], _f, "en-US" ) & "' r='3' class='pf'/>",
			        ""
			    )
			VAR _x1 = 30 + DATEDIFF ( _ini, _d1, DAY ) / 85 * 380 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _ok = "Sim",
			        "<div class='tt17r'>"
			            & "<div class='sob sobe'>" & _esc & " · rejeição no eleitorado todo</div>"
			            & "<div class='par sobe d2'>"
			                & "<div class='lula'><small>Lula · " & FORMAT ( _dd, "dd/MM" ) & "</small><span class='num'>" & FORMAT ( _dl, "0.0" )
			                & "%</span></div>"
			                & "<div class='flavio'><small>Flávio · " & FORMAT ( _dd, "dd/MM" ) & "</small><span class='num'>" & FORMAT ( _df, "0.0" )
			                & "%</span></div>"
			            & "</div>"
			            & "<div class='txt sobe d3'>" & _txtAntes & "</div>"
			            & "<div class='nota sobe d3'>A pergunta muda de um instituto para outro: compare só dentro deste.</div>"
			            & "<svg width='420' height='92' viewBox='0 0 420 92' class='entra d4'>"
			                & "<line x1='30' x2='410' y1='70' y2='70' class='g'/><line x1='30' x2='410' y1='34.4' y2='34.4' class='g'/>"
			                & "<text x='24' y='74' class='ex' text-anchor='end'>40</text><text x='24' y='38' class='ex' text-anchor='end'>50</text>"
			                & "<line x1='" & FORMAT ( _x1, _f, "en-US" ) & "' x2='" & FORMAT ( _x1, _f, "en-US" ) & "' y1='2' y2='76' class='mk'/>"
			                & "<text x='" & FORMAT ( _x1, _f, "en-US" ) & "' y='90' class='ex' text-anchor='middle'>1º turno</text>"
			                & "<text x='30' y='90' class='ex'>ago</text>"
			                & "<polyline points='" & _linhaL & "' class='ll'/><polyline points='" & _linhaF & "' class='lf'/>" & _bolas
			            & "</svg>"
			            & "<div class='mao" & IF ( _df < _dl, " az", IF ( _df > _dl, "", " ti" ) ) & " entra d6'>" & _txtMao & "</div>"
			        & "</div>"
			    )
		displayFolder: T17 2º turno\Desenho
		lineageTag: be8af674-53d6-52db-9ab9-6b153edcac4a

	/// Eleitores que faltaram nas seções totalizadas do escopo.
	measure 'Apuração · abstenção' =
			IF (
			    ISFILTERED ( 'UF' ),
			    SUM ( 'Apuração UF'[Abstencao] ),
			    SUM ( 'Apuração Brasil'[Abstencao] )
			)
		formatString: #,0
		displayFolder: T18 Apuração\Contas
		lineageTag: b505ecf9-62e5-5b29-aa32-7b3937caad07

	/// Abstenção sobre os eleitores das seções instaladas (comparecimento + abstenção), como o pa do TSE; no exterior há seções não instaladas e o eleitorado total não serve de base.
	measure 'Apuração · abstenção %' =
			DIVIDE ( [Apuração · abstenção], [Apuração · comparecimento] + [Apuração · abstenção] )
		formatString: 0.00%
		displayFolder: T18 Apuração\Contas
		lineageTag: 9fec5a1d-7d24-55c3-a880-2d491ae858ed

	/// Hora de totalização do TSE no escopo (com várias UFs, a mais recente); vazio antes da primeira divulgação.
	measure 'Apuração · atualizado no TSE' =
			IF (
			    ISFILTERED ( 'UF' ),
			    MAX ( 'Apuração UF'[AtualizadoTSE] ),
			    MAX ( 'Apuração Brasil'[AtualizadoTSE] )
			)
		formatString: dd/MM/yyyy HH:mm
		displayFolder: T18 Apuração\Contas
		lineageTag: 7d542d62-d20d-554d-9dbd-0ceb2af4cc19

	/// Votos em branco no escopo.
	measure 'Apuração · brancos' =
