	/// Alto nas 5 UFs de maior interesse médio pelos dois no 2º turno (média dos índices 0–100 de Lula e de Flávio), baixo nas 5 de menor, médio nas outras; vazio fora de uma UF.
	measure 'T08 · UF · nível de interesse' =
			VAR _uf = SELECTEDVALUE ( UF[UF] )
			VAR _t =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( UF[UF] ), REMOVEFILTERS ( UF ), UF[Tipo] = "UF" ),
			        "@m", ( [T08 · UF · interesse Lula] + [T08 · UF · interesse Flávio] ) / 2
			    )
			VAR _m = MAXX ( FILTER ( _t, UF[UF] = _uf ), [@m] )
			VAR _acima = COUNTROWS ( FILTER ( _t, [@m] > _m ) )
			VAR _abaixo = COUNTROWS ( FILTER ( _t, [@m] < _m ) )
			RETURN
			    IF (
			        HASONEVALUE ( UF[UF] ) && NOT ISBLANK ( _m ),
			        SWITCH ( TRUE (), _acima < 5, "alto", _abaixo < 5, "baixo", "médio" )
			    )
		displayFolder: T08 Buscas\Contas
		lineageTag: d889658b-2910-5aab-af64-fd30fe4c9a10

	/// Parte de Flávio nas buscas pelos dois na UF, no 2º turno (05 a 22/10), como fração (o Trends dá o % inteiro de cada um).
	measure 'T08 · UF · parte Flávio' =
			VAR _l = [T08 · UF · Lula]
			VAR _f = [T08 · UF · Flávio]
			RETURN
			    IF ( NOT ISBLANK ( _l ) && NOT ISBLANK ( _f ), DIVIDE ( _f, _l + _f ) )
		formatString: 0%
		displayFolder: T08 Buscas\Contas
		lineageTag: abcc163e-abbc-5548-839b-e5269d552f53

	/// Parte de Lula nas buscas pelos dois na UF, no 2º turno (05 a 22/10), como fração (o Trends dá o % inteiro de cada um).
	measure 'T08 · UF · parte Lula' =
			VAR _l = [T08 · UF · Lula]
			VAR _f = [T08 · UF · Flávio]
			RETURN
			    IF ( NOT ISBLANK ( _l ) && NOT ISBLANK ( _f ), DIVIDE ( _l, _l + _f ) )
		formatString: 0%
		displayFolder: T08 Buscas\Contas
		lineageTag: 532a6c1c-9e6c-5083-844b-336050b3d7df

	/// Soma dos índices diários de Flávio na consulta U2 da UF da linha (ou da clicada), nos dias do período escolhido que a curva tem (até 22/10: o 23/10 da coleta é parcial e anterior ao debate da Globo); vazio sem período, fora de uma UF ou sem dia no período.
	measure 'T08 · UF · período · soma Flávio' =
			VAR _uf = SELECTEDVALUE ( UF[UF] )
			VAR _ini = [T08 · período · início no Google]
			VAR _fim = MIN ( [T08 · período · fim no Google], [T08 · curva · último dia] )
			RETURN
			    IF (
			        HASONEVALUE ( UF[UF] ) && NOT ISBLANK ( _ini ) && _ini <= _fim,
			        CALCULATE (
			            SUM ( 'Trends UF tempo'[Índice] ),
			            'Trends UF tempo'[UF] = _uf,
			            'Trends UF tempo'[Série] = "Flávio Bolsonaro [tópico | U2]",
			            'Trends UF tempo'[Data] >= _ini,
			            'Trends UF tempo'[Data] <= _fim
			        )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: d3227f46-0672-57f7-82cd-3240cff2bd03

	/// Soma dos índices diários de Lula na consulta U2 da UF da linha (ou da clicada), nos dias do período escolhido que a curva tem (até 22/10: o 23/10 da coleta é parcial e anterior ao debate da Globo); vazio sem período, fora de uma UF ou sem dia no período.
	measure 'T08 · UF · período · soma Lula' =
			VAR _uf = SELECTEDVALUE ( UF[UF] )
			VAR _ini = [T08 · período · início no Google]
			VAR _fim = MIN ( [T08 · período · fim no Google], [T08 · curva · último dia] )
			RETURN
			    IF (
			        HASONEVALUE ( UF[UF] ) && NOT ISBLANK ( _ini ) && _ini <= _fim,
			        CALCULATE (
			            SUM ( 'Trends UF tempo'[Índice] ),
			            'Trends UF tempo'[UF] = _uf,
			            'Trends UF tempo'[Série] = "Lula [tópico | U2]",
			            'Trends UF tempo'[Data] >= _ini,
			            'Trends UF tempo'[Data] <= _fim
			        )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 6167f9d5-1fcb-58b2-a895-2fccb5de8265

