	/// Maior parte (%) de Flávio nas buscas entre os dois, entre as UFs, no 2º turno.
	measure 'T08 · UF · maior parte · Flávio' =
			MAXX ( FILTER ( ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( UF[UF] ), REMOVEFILTERS ( UF ), UF[Tipo] = "UF" ),
			        "@l", [T08 · UF · Lula],
			        "@f", [T08 · UF · Flávio]
			    ), NOT ISBLANK ( [@f] ) ), [@f] )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: d038bc7b-747a-5824-8c00-6ee29357d25f

	/// Siglas das UFs onde Flávio teve a maior parte das buscas no 2º turno (em ordem alfabética, 'e' antes da última).
	measure 'T08 · UF · maior parte · Flávio · onde' =
			VAR _v = [T08 · UF · maior parte · Flávio]
			VAR _ufs = FILTER ( ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( UF[UF] ), REMOVEFILTERS ( UF ), UF[Tipo] = "UF" ),
			        "@l", [T08 · UF · Lula],
			        "@f", [T08 · UF · Flávio]
			    ), [@f] = _v )
			VAR _n = COUNTROWS ( _ufs )
			VAR _lista = CONCATENATEX ( _ufs, UF[UF], ", ", UF[UF], ASC )
			VAR _ultima = MAXX ( _ufs, UF[UF] )
			RETURN
			    IF ( _n <= 1, _lista, LEFT ( _lista, LEN ( _lista ) - 4 ) & " e " & _ultima )
		displayFolder: T08 Buscas\Contas
		lineageTag: 2deb0618-2796-5157-8d0d-b2d8d6cf3252

