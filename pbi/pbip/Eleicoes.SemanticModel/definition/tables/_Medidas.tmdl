	/// Margem do PT no ano do contexto, somando os municípios do contexto (série 2006–2026).
	measure 'T11 · margem no ano' =
			DIVIDE (
			    SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ),
			    SUM ( 'Município ano'[Validos] )
