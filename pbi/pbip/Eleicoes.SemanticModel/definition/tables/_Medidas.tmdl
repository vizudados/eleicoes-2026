	/// Interações nos perfis oficiais na janela da Bites do período escolhido, no contexto do candidato (Monitoramento[Candidato]); vazio sem período ou sem janela que caiba nele.
	measure 'T09 · período · interações' =
			VAR _m = [T09 · período · interações · métrica]
			VAR _i = [T09 · período · interações · início]
			VAR _f = [T09 · período · interações · fim]
			RETURN
			    IF (
			        NOT ISBLANK ( _i ),
			        CALCULATE (
			            SUM ( Monitoramento[Valor] ),
			            Monitoramento[Métrica] = _m,
			            Monitoramento[Início] = _i,
			            Monitoramento[Fim] = _f
			        )
			    )
		formatString: #,0
		displayFolder: T09 Redes\Contas
		lineageTag: b1f5a7b9-901c-5634-af55-b92d6cf35eec

	/// Média de interações por dia na janela do período (total ÷ dias), no contexto do candidato: o tamanho do balão da direita com período.
	measure 'T09 · período · interações por dia' =
			DIVIDE ( [T09 · período · interações], [T09 · período · interações · dias] )
		formatString: #,0
		displayFolder: T09 Redes\Contas
		lineageTag: 72c01929-4605-5f78-b06c-3827626d1b98

	/// A escala dos balões com período: a maior média por dia entre a de sempre (campanha do 1º turno e 2º turno, T09 · interações por dia · maior) e a da janela do período (Lula e Flávio). Sem janela no período, fica a de sempre e o balão da campanha não muda de tamanho.
	measure 'T09 · período · interações por dia · maior' =
			VAR _sempre = [T09 · interações por dia · maior]
			VAR _l2 = CALCULATE ( [T09 · período · interações por dia], REMOVEFILTERS ( Monitoramento ), Monitoramento[Candidato] = "Lula" )
			VAR _f2 = CALCULATE ( [T09 · período · interações por dia], REMOVEFILTERS ( Monitoramento ), Monitoramento[Candidato] = "Flávio Bolsonaro" )
			RETURN
			    IF ( NOT ISBLANK ( [Período · escolhido] ), MAX ( _sempre, MAX ( _l2, _f2 ) ) )
		formatString: #,0
		displayFolder: T09 Redes\Contas
		lineageTag: 67de9394-8966-5615-8ac0-49c9da7a30af

	/// Dias da janela de interações do período (a de 24 h depois do debate conta 1 dia, não os dois dias do calendário que ela toca).
	measure 'T09 · período · interações · dias' =
			VAR _m = [T09 · período · interações · métrica]
			VAR _i = [T09 · período · interações · início]
			VAR _f = [T09 · período · interações · fim]
			RETURN
			    IF ( NOT ISBLANK ( _i ), IF ( CONTAINSSTRING ( _m, "24h" ), 1, DATEDIFF ( _i, _f, DAY ) + 1 ) )
		formatString: 0
		displayFolder: T09 Redes\Contas
		lineageTag: 56969ba0-ba3f-55e2-8224-b4d104aa022d

	/// Último dia da janela de interações da Bites usada no período escolhido. Só entra a janela que cabe inteira dentro do período escolhido (o dia do debate conta como depois); entre as que cabem, a mais longa (no empate, a mais recente). Vazio sem período ou sem janela que caiba.
	measure 'T09 · período · interações · fim' =
			VAR _ini = [Período · início]
			VAR _fim = [Período · fim]
			VAR _jan =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( Monitoramento, Monitoramento[Métrica], Monitoramento[Início], Monitoramento[Fim] ),
			                REMOVEFILTERS ( Monitoramento ),
			                CONTAINSSTRING ( Monitoramento[Estudo], "Bites" ),
			                CONTAINSSTRING ( Monitoramento[Métrica], "interações" ),
			                Monitoramento[Início] >= _ini,
			                Monitoramento[Fim] <= _fim
			            ),
			            "@dois",
			                CALCULATE (
			                    DISTINCTCOUNT ( Monitoramento[Candidato] ),
			                    REMOVEFILTERS ( Monitoramento[Candidato] ),
			                    Monitoramento[Candidato] IN { "Lula", "Flávio Bolsonaro" },
			                    CONTAINSSTRING ( Monitoramento[Estudo], "Bites" ),
			                    NOT ISBLANK ( Monitoramento[Valor] )
			                ),
			            "@dur", DATEDIFF ( Monitoramento[Início], Monitoramento[Fim], DAY )
			        ),
			        [@dois] = 2
			    )
			VAR _top = TOPN ( 1, _jan, [@dur], DESC, Monitoramento[Início], DESC )
			RETURN
			    IF ( NOT ISBLANK ( _ini ), MAXX ( _top, Monitoramento[Fim] ) )
		formatString: dd/MM
		displayFolder: T09 Redes\Contas
		lineageTag: 5539da21-d0bb-56bd-a793-ea015b4ebdc3

