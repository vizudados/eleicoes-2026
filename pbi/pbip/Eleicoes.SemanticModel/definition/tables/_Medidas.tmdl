			            & FORMAT ( _l, "0.0%" ) & "</b><b class='flavio-esc'>Flávio " & FORMAT ( _f, "0.0%" ) & "</b></div>"
			            & "<div class='rot topo-rot'>"
			    )
		displayFolder: _Exterior\Desenho
		lineageTag: 0bdc2472-ce19-5296-ba2e-4963677da3ff

	/// O debate de referência do período escolhido: Band ou Globo.
	measure 'Período · debate' =
			IF (
			    ISFILTERED ( 'Período' ) && HASONEVALUE ( 'Período'[Ordem] ),
			    SELECTEDVALUE ( 'Período'[Debate] )
			)
		displayFolder: _Período
