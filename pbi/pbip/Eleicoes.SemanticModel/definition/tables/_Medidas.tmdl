	/// Dia do debate (sem a hora): a fronteira das pesquisas antes e depois.
	measure 'T26 · debate · dia' =
			VAR _i = [T26 · debate · início]
			RETURN
			    IF ( NOT ISBLANK ( _i ), DATE ( YEAR ( _i ), MONTH ( _i ), DAY ( _i ) ) )
		formatString: dd/MM/yyyy
