	/// Primeiro ponto da série diária do Google no período escolhido: o início do período mais um dia (o dia do Google fecha às 21h de Brasília, e a noite que abre o período, a do debate, cai no ponto seguinte); vazio sem período.
	measure 'T08 · período · início no Google' =
			VAR _i = [Período · início]
			RETURN
			    IF ( NOT ISBLANK ( _i ), _i + 1 )
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: 0bb1f86b-de97-5939-9484-17d1d06ea5c8

	/// O dia de mais buscas do período: o de maior índice entre os dois, nos dias da curva dentro do período escolhido no filtro Período (o dia do debate conta como depois), na série que a curva mostra (Brasil, T2, ou o estado clicado, U2); vazio sem período; o primeiro, se empatar.
	measure 'T08 · período · maior · data' =
			VAR _ini = [T08 · período · início no Google]
			VAR _fim = [T08 · período · fim no Google]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@m", MAX ( [T08 · dia · Lula], [T08 · dia · Flávio] )
			    )
			VAR _no = FILTER ( _dias, [@d] >= _ini && [@d] <= _fim )
			VAR _max = MAXX ( _no, [@m] )
			RETURN
			    IF ( NOT ISBLANK ( _ini ), MINX ( FILTER ( _no, [@m] = _max ), [@d] ) )
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: 00b5144d-7490-591e-a07c-de57f8c84a13

	/// Índice de Flávio no dia de mais buscas do período.
	measure 'T08 · período · maior · Flávio' =
			VAR _d = [T08 · período · maior · data]
			RETURN
			    CALCULATE (
			        [T08 · dia · Flávio],
			        REMOVEFILTERS ( 'Trends tempo' ),
			        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
