	/// Quem está à frente no escopo: Lula, Flávio ou — (empate ou nenhum voto apurado).
	measure 'Apuração · líder' =
			VAR _lula = [Apuração · Lula votos]
			VAR _flavio = [Apuração · Flávio votos]
			RETURN
			    SWITCH ( TRUE (), _lula > _flavio, "Lula", _flavio > _lula, "Flávio", "—" )
		displayFolder: T18 Apuração\Contas
		lineageTag: da969171-45cf-5ba2-bf46-8ecd4394ad41

	/// Quem está à frente no Brasil (a linha BR do TSE), qualquer que seja o recorte: o eleito quando a fase é 'definido'. Com um estado, uma região ou vários estados no filtro, a frase do placar separa o eleito no Brasil de quem lidera no recorte.
	measure 'Apuração · líder no Brasil' =
			CALCULATE ( [Apuração · líder], REMOVEFILTERS ( 'UF' ) )
		displayFolder: T18 Apuração\Contas
		lineageTag: 5f807958-61ff-56c7-a7ed-d8b9a71bcd65

