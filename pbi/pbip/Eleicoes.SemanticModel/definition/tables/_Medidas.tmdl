			)
		formatString: #,0
		displayFolder: T19 Explorador\Contas
		lineageTag: e6d97851-a96f-5cc3-b9a5-a18e89b28be6

	/// Quantos municípios a lista mostra: os 16 com mais votos válidos do recorte (ou todos, quando o recorte tem menos).
	measure 'T19 · municípios na lista' =
			MIN ( 16, [T19 · municípios no recorte] )
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: b8d8e605-d21a-5715-9b79-7cade493b626

	/// Municípios no recorte da tela: os que passam no filtro do recorte ([T19 · no recorte] = 1: E entre os grupos, OU dentro do mesmo grupo) e na seleção da dispersão. Sem filtro, os 5.571.
	measure 'T19 · municípios no recorte' =
			COALESCE (
			    COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T19 · no recorte] = 1 ) ),
			    0
			)
		formatString: #,0
		displayFolder: T19 Explorador\Contas
		lineageTag: 0354022b-3c84-5b10-993a-8159e279a49d

	/// Municípios do recorte (filtro da tela e seleção na dispersão) que trocaram Lula (2022) por Flávio (2026).
	measure 'T19 · municípios que viraram' =
			COALESCE (
			    COUNTROWS (
			        FILTER (
			            VALUES ( 'Município'[CodIBGE] ),
			            [T19 · no recorte] = 1 && [T19 · virou] = 1
			        )
			    ),
			    0
			)
		formatString: #,0
		displayFolder: T19 Explorador\Contas
		lineageTag: 9c259df3-26ef-5258-a915-4998bb57d152

	/// 1 quando o município está no recorte do filtro da tela, 0 quando não está; vazio fora de um município. Regra: E entre os grupos, OU dentro do mesmo grupo (Nordeste + até 10 mil = cidades do Nordeste com até 10 mil; Nordeste + Norte = cidades de uma ou da outra). A relação T19 Filtro → Município é inativa e só vale aqui (USERELATIONSHIP): o município da linha filtra as linhas dele na T19 Filtro, e as escolhidas precisam cobrir todos os grupos com escolha. A lista e a dispersão filtram por = 1.
	measure 'T19 · no recorte' =
			VAR _raizes = [T19 · raízes escolhidas]
			RETURN
			    IF (
			        HASONEVALUE ( 'Município'[CodIBGE] ),
			        IF (
			            _raizes = 0,
			            1,
			            VAR _cobertas =
			                CALCULATE (
			                    DISTINCTCOUNT ( 'T19 Filtro'[RaizOrdem] ),
			                    USERELATIONSHIP ( 'T19 Filtro'[CodIBGE], 'Município'[CodIBGE] )
			                )
			            RETURN
			                IF ( _cobertas = _raizes, 1, 0 )
			        )
			    )
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: 541f1427-8a60-50a2-ad3a-86b8430db93a

	/// População residente (Censo 2022) no contexto.
	measure 'T19 · população' =
			SUM ( 'Município'[População] )
		formatString: #,0
		displayFolder: T19 Explorador\Contas
		lineageTag: b796f16a-d70c-5425-8601-31174f7be1ce

	/// Faixa de população do município (até 10 mil … mais de 1 milhão).
	measure 'T19 · porte do município' =
			SELECTEDVALUE ( 'Município'[Porte] )
		displayFolder: T19 Explorador\Contas
		lineageTag: 49697d70-9b7e-5847-a0fa-c7eb8cad3834

	/// Posição do município na lista: 1 = mais votos válidos em 2026 entre os municípios que a lista mostra (o filtro de 14 do visual).
	measure 'T19 · posição na lista' =
			IF (
			    HASONEVALUE ( 'Município'[Rótulo] ),
			    RANKX ( ALLSELECTED ( 'Município'[Rótulo] ), [T19 · válidos 2026], , DESC, SKIP )
			)
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: 7c809162-d548-595a-956e-a411a8d0155b

	/// Quinto de renda do município (mais pobres … mais ricas).
	measure 'T19 · quinto do município' =
			SELECTEDVALUE ( 'Município'[Quinto de renda] )
		displayFolder: T19 Explorador\Contas
		lineageTag: 46c4f418-1ee9-502f-a66f-e44ffcb50ae8

	/// Quantos grupos do filtro do recorte (o lugar, Região › Estado › Cidade; Tamanho da cidade; Renda; Virou?) têm alguma escolha no VizuFilter da tela (T19 Filtro[Caminho]); 0 sem filtro. É o número de condições E de [T19 · no recorte].
	measure 'T19 · raízes escolhidas' =
			IF (
			    ISFILTERED ( 'T19 Filtro'[Caminho] ),
			    DISTINCTCOUNT ( 'T19 Filtro'[RaizOrdem] ),
			    0
			)
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: 21e522c6-54c0-5ae9-9724-834d2902b7d3

	/// O recorte em palavras, para a faixa do resumo e os textos alternativos: um pedaço por grupo do filtro com escolha, na ordem da árvore ('Sudeste · 10 a 50 mil hab. · seleção na dispersão'; 'MG, SP · renda: mais pobres'); o lugar vem resumido de cima para baixo ([T19 · filtro · lugar]), os outros grupos com a contagem quando são vários itens; 'Todo o Brasil' sem filtro.
	measure 'T19 · recorte em uso' =
			-- 1 · Escolhas por grupo (RaizOrdem: 1 o lugar, 2 Tamanho da cidade, 3 Renda, 4 Virou?)
			VAR _f = ISFILTERED ( 'T19 Filtro'[Caminho] )
			VAR _t2 =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
			        'T19 Filtro'[RaizOrdem] = 2
			    )
			VAR _t3 =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
			        'T19 Filtro'[RaizOrdem] = 3
			    )
			VAR _t4 =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
			        'T19 Filtro'[RaizOrdem] = 4
			    )
			VAR _n2 = IF ( _f, COUNTROWS ( _t2 ), 0 )
			VAR _n3 = IF ( _f, COUNTROWS ( _t3 ), 0 )
			VAR _n4 = IF ( _f, COUNTROWS ( _t4 ), 0 )
			-- 2 · Um pedaço por grupo: os itens (poucos) ou a contagem (muitos)
			VAR _lugar = [T19 · filtro · lugar]
			VAR _porte =
			    IF (
			        _n2 > 0,
			        IF (
			            _n2 <= 2,
			            CONCATENATEX ( _t2, 'T19 Filtro'[Curto], ", ", 'T19 Filtro'[Ordem], ASC ) & " hab.",
			            _n2 & " tamanhos de cidade"
			        )
			    )
			VAR _quinto =
			    IF (
			        _n3 > 0,
			        IF (
			            _n3 <= 2,
			            "renda: " & CONCATENATEX ( _t3, 'T19 Filtro'[Curto], ", ", 'T19 Filtro'[Ordem], ASC ),
			            _n3 & " faixas de renda"
			        )
			    )
			VAR _lado =
			    IF (
			        _n4 > 0,
			        IF (
			            _n4 <= 2,
			            CONCATENATEX ( _t4, 'T19 Filtro'[Curto], ", ", 'T19 Filtro'[Ordem], ASC ),
			            _n4 & " situações"
			        )
			    )
			-- 3 · A seleção por retângulo na dispersão (filtro cruzado no código do município)
			VAR _laco =
			    IF ( ISFILTERED ( 'Município'[CodIBGE] ), "seleção na dispersão" )
			VAR _partes =
			    {
			        ( 1, _lugar ), ( 2, _porte ), ( 3, _quinto ), ( 4, _lado ), ( 5, _laco )
			    }
			VAR _texto =
			    CONCATENATEX ( FILTER ( _partes, NOT ISBLANK ( [Value2] ) ), [Value2], " · ", [Value1], ASC )
			RETURN
			    IF ( _texto = "", "Todo o Brasil", _texto )
		displayFolder: T19 Explorador\Contas
		lineageTag: 8bcddf53-dbaf-58e1-a898-3b3592c21de1

	/// Região do município (Norte … Sul).
	measure 'T19 · região do município' =
			SELECTEDVALUE ( 'Município'[Região] )
		displayFolder: T19 Explorador\Contas
		lineageTag: 5c525042-4255-5d84-aa49-b6cd800aa117

	/// Rendimento domiciliar per capita médio do município (R$/mês, Censo 2022); vazio no recorte de mais de um município.
	measure 'T19 · renda' =
			SELECTEDVALUE ( 'Município'[Renda per capita] )
		formatString: #,0
		displayFolder: T19 Explorador\Contas
		lineageTag: 5696e3f8-46ab-518a-9812-d6c5bedfb5ad

	/// Quanto a margem do PT mudou de 2022 para 2026 (margem 2026 − margem 2022, em pontos); vazio quando falta um dos anos (município novo).
	measure 'T19 · variação da margem' =
			VAR _m22 = [T19 · margem 2022]
			VAR _m26 = [T19 · margem 2026]
			RETURN
			    IF ( NOT ISBLANK ( _m22 ) && NOT ISBLANK ( _m26 ), _m26 - _m22 )
		formatString: 0.0%
		displayFolder: T19 Explorador\Contas
		lineageTag: 21145c85-a396-55b7-b4c2-a16b30537b77

	/// 1 quando o município trocou Lula por Flávio (PT à frente em 2022 e atrás em 2026); 0 nos outros. Conta de um município (linha da lista, ponto, dossiê).
	measure 'T19 · virou' =
			VAR _m22 = [T19 · margem 2022]
			VAR _m26 = [T19 · margem 2026]
			RETURN
			    IF ( _m22 > 0 && _m26 < 0, 1, 0 )
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: 4495d909-ded6-5e4a-aba0-bd4ba02ae7f2

	/// Votos válidos no 1º turno de 2026 no contexto (ordena a lista e dá o tamanho do ponto na dispersão).
	measure 'T19 · válidos 2026' =
			CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T19 Explorador\Contas
		lineageTag: 36e954a4-c2d3-5396-860d-aba8b6d71395

	/// Votos válidos de 2026 do município quando ele está no recorte do filtro; vazio fora dele. É a medida do Top N da lista (os 16 maiores DO recorte: o Top N do visual não enxerga o filtro de medida do mesmo visual).
	measure 'T19 · válidos no recorte' =
			IF ( [T19 · no recorte] = 1, [T19 · válidos 2026] )
		formatString: #,0
		displayFolder: T19 Explorador\Contas
		lineageTag: 2b1efe86-0a9e-592a-aa5c-a4a405a5c7c1

	/// Texto alternativo da dispersão (renda × mudança da margem).
	measure 'T19 · Dispersão · ALT' =
			-- 1 · Leituras
			VAR _perdeu = [T19 · municípios em que Lula perdeu margem]
			VAR _com = [T19 · municípios com as duas eleições]
			VAR _recorte = [T19 · recorte em uso]
			-- 2 · Textos
			RETURN
			    "Dispersão: um ponto por município, renda por pessoa no eixo horizontal e quanto a margem de Lula mudou de 2022 "
			        & "para 2026 no vertical. Recorte " & _recorte & ": Lula perdeu margem em " & FORMAT ( _perdeu, "#,0" )
			        & " de " & FORMAT ( _com, "#,0" ) & ". Arraste um retângulo para filtrar a lista."
		displayFolder: T19 Explorador\Desenho
		lineageTag: a1040ef3-0377-58ce-8635-d27b0b73c2f3

	/// Manchete da dispersão, no fundo HTML atrás dos pontos: em quantos municípios do recorte Lula perdeu margem de 2022 para 2026.
	measure 'T19 · Dispersão · HTML' =
			-- 1 · Leituras
			VAR _n = [T19 · municípios no recorte]
			VAR _perdeu = [T19 · municípios em que Lula perdeu margem]
			VAR _com = [T19 · municípios com as duas eleições]
			-- 2 · Textos
			VAR _txtPerdeu = FORMAT ( _perdeu, "#,0" )
			VAR _txtCom = FORMAT ( _com, "#,0" )
			VAR _frase =
			    SWITCH (
			        TRUE (),
			        _n = 0, "Nenhum município neste recorte: mude o filtro no canto de cima",
			        _com = 0, "Sem 2022 para comparar neste recorte",
			        _com = 1,
			            IF ( _perdeu = 1, "Neste município, Lula perdeu margem", "Neste município, Lula não perdeu margem" ),
			        "Lula perdeu margem em <b class='num'>" & _txtPerdeu & "</b> dos <b class='num'>" & _txtCom
			            & "</b> municípios do recorte"
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t19m'><div class='man sobe d2'>" & _frase & "</div></div>"
		displayFolder: T19 Explorador\Desenho
		lineageTag: 387adbee-c196-51af-afab-ca137d3fe69a

	/// Texto alternativo do dossiê do município.
	measure 'T19 · Dossiê · ALT' =
			-- 1 · Leituras
			VAR _nome = [T19 · município]
			VAR _m06 = [T19 · margem 2006]
			VAR _m26 = [T19 · margem 2026]
			VAR _frente = [T19 · eleições com o PT à frente]
			VAR _com = [T19 · eleições com voto]
			-- 2 · Textos
			VAR _ini = IF ( ISBLANK ( _m06 ), "", " de " & FORMAT ( _m06 * 100, "+0.0;−0.0;0.0" ) & " p.p. em 2006" )
			RETURN
			    IF (
			        NOT ISBLANK ( _nome ),
			        _nome & ": margem do PT" & _ini & " a " & FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" ) & " p.p. em 2026; PT à "
			            & "frente em " & _frente & " de " & _com & IF ( _com = 1, " eleição.", " eleições." )
			    )
		displayFolder: T19 Explorador\Desenho
		lineageTag: bb4084a6-998c-535b-a3b4-beb5a760dcd1

	/// Dossiê do município (página de tooltip ttT19Municipio, da lista, da dispersão e do mapa da tela 21): região, população e renda, a margem do PT nas seis eleições num gráfico de linha, em quantas o PT ficou à frente, a abstenção de 2026 e o selo de quem virou.
	measure 'T19 · Dossiê · HTML' =
			-- 1 · Leituras
			VAR _regiao = [T19 · região do município]
			VAR _pop = [T19 · população]
			VAR _renda = [T19 · renda]
			VAR _abst = [T19 · abstenção 2026]
			VAR _frente = [T19 · eleições com o PT à frente]
			VAR _com = [T19 · eleições com voto]
			VAR _virou = [T19 · virou]
			VAR _m06 = [T19 · margem 2006]
			VAR _m10 = [T19 · margem 2010]
			VAR _m14 = [T19 · margem 2014]
			VAR _m18 = [T19 · margem 2018]
			VAR _m22 = [T19 · margem 2022]
			VAR _m26 = [T19 · margem 2026]
			-- 2 · Textos
			VAR _nome0 = [T19 · município]
			VAR _nome1 = SUBSTITUTE ( _nome0, "&", "&amp;" )
			VAR _nome2 = SUBSTITUTE ( SUBSTITUTE ( _nome1, "<", "&lt;" ), ">", "&gt;" )
			VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome2, """", "&quot;" ), "'", "&#39;" )
			VAR _txtPop = FORMAT ( _pop, "#,0" ) & " habitantes"
			VAR _txtRenda = IF ( ISBLANK ( _renda ), "", " · renda de R$ " & FORMAT ( _renda, "#,0" ) & " por pessoa" )
			VAR _txtAbst = FORMAT ( _abst, "0.0%" )
			VAR _txtFrente =
			    SWITCH (
			        TRUE (),
			        _frente = _com, "PT à frente em todas as " & _com & " eleições",
			        _frente = 0, "PT atrás em todas as " & _com & " eleições",
			        "PT à frente em " & _frente & " de " & _com & IF ( _com = 1, " eleição", " eleições" )
			    )
			VAR _nota =
			    SWITCH (
			        TRUE (),
			        _virou = 1, "virou em 2026",
			        _m26 > 0 && _m22 > 0, "segue com Lula",
			        _m26 < 0 && _m22 < 0, "segue com o PL",
			        "lado incerto"
			    )
			VAR _selo = IF ( _virou = 1, "<div class='selo'>virou</div>", "" )
			-- 3 · Geometria
			VAR _base = { ( 0, 26, 2006, _m06 ), ( 1, 98, 2010, _m10 ), ( 2, 170, 2014, _m14 ), ( 3, 242, 2018, _m18 ), ( 4, 314, 2022, _m22 ), ( 5, 386, 2026, _m26 ) } /* lista */
			VAR _serie =
			    FILTER ( /* lista */
			        SELECTCOLUMNS ( _base, "i", [Value1], "x", [Value2], "ano", [Value3], "m", [Value4] ),
			        NOT ISBLANK ( [m] )
			    ) -- geometria
			VAR _maior = MAXX ( _serie, ABS ( [m] ) ) /* geometria */
			VAR _escala = MAX ( 0.2, CEILING ( _maior * 10, 1 ) / 10 ) -- geometria
			VAR _pts =
			    ADDCOLUMNS ( _serie, "y", 70 - [m] / _escala * 52 ) -- geometria
			VAR _primeiro = MINX ( _pts, [i] ) /* lista */
			VAR _d =
			    CONCATENATEX (
			        _pts,
			        IF ( [i] = _primeiro, "M", "L" ) & [x] & "," & FORMAT ( [y], "0.0##", "en-US" ),
			        " ",
			        [i], ASC
			    ) /* lista */
			VAR _marcas =
			    CONCATENATEX (
			        _pts,
			        "<circle class='" & IF ( [m] > 0, "l", "f" ) & "' cx='" & [x] & "' cy='" & FORMAT ( [y], "0.0##", "en-US" )
			            & "' r='4.6'/>"
			            & "<text class='v " & IF ( [m] > 0, "l", "f" ) & "' x='" & [x] & "' y='"
			            & FORMAT ( IF ( [m] > 0, [y] - 10, [y] + 19 ), "0.0##", "en-US" ) & "'>"
			            & FORMAT ( [m] * 100, "+0.0;−0.0;0.0" ) & "</text>",
			        "",
			        [i], ASC
			    ) /* lista */
			VAR _anos =
			    CONCATENATEX ( _serie, "<text class='a' x='" & [x] & "' y='150'>" & [ano] & "</text>", "", [i], ASC ) /* lista */
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _nome0 ),
			        "<div class='tela tt19'>"
			            & "<div class='nm'>" & _nome & "</div>"
			            & "<div class='sub'>" & _regiao & " · " & _txtPop & _txtRenda & "</div>"
			            & "<div class='rot cap'>Margem do PT, em pontos · 2006 → 2026</div>"
			            & "<svg class='serie' width='410' height='158' viewBox='0 0 410 158'>"
			                & "<line class='zero' x1='6' x2='404' y1='70' y2='70'/>"
			                & "<text class='ze' x='404' y='66'>empate</text>"
			                & "<path class='traco-rapido' pathLength='1' d='" & _d & "'/>"
			                & _marcas & _anos
			            & "</svg>"
			            & "<div class='pe'><span>" & _txtFrente & "</span><span class='ab'>" & _txtAbst
			            & " faltaram em 2026</span></div>"
			            & _selo
			            & "<div class='mao'>" & _nota & "</div>"
			        & "</div>"
			    )
		displayFolder: T19 Explorador\Desenho
		lineageTag: 288bf525-b442-511b-9590-827b4de48f3a

	/// Texto alternativo do filtro do recorte (o VizuFilter em árvore, com o gatilho dele; sem pílula desde 24/10/2026): o recorte em uso e o que o filtro oferece.
	measure 'T19 · Filtro · ALT' =
			-- 1 · Leituras
			VAR _n = [T19 · filtro · escolhas]
			VAR _uso = [T19 · filtro em uso]
			-- 2 · Textos
			RETURN
			    "Filtro do recorte: " & IF ( _n = 0, "todos os municípios", LEFT ( _uso, 150 ) )
			        & ". Abre a árvore de região, estado e cidade, tamanho, renda e virada."
		displayFolder: T19 Explorador\Desenho
		lineageTag: ecad9809-72a1-5da2-a558-ed54ed0283ab

	/// Texto alternativo da lista do Explorador.
	measure 'T19 · Lista · ALT' =
			-- 1 · Leituras
			VAR _recorte = [T19 · recorte em uso]
			VAR _n = [T19 · municípios na lista]
			-- 2 · Textos
			RETURN
			    IF ( _n = 1, "Lista com o município do recorte (", "Lista dos " & _n & " municípios com mais votos válidos em "
			        & "2026 no recorte (" ) & _recorte & "): Lula e Flávio em 2026, a margem do PT de 2006 a 2026 e a mudança de "
			        & "2022 para 2026. "
			        & "Passe o mouse numa linha para o dossiê; clique para destacar o ponto na dispersão."
		displayFolder: T19 Explorador\Desenho
		lineageTag: 69c036fa-e590-5e67-8a4c-64e287e9d63b

	/// Uma linha da lista do Explorador (granularidade: Município[Rótulo]; o visual mostra os 16 com mais votos válidos do recorte): nome, Lula e Flávio em 2026, a minilinha da margem 2006–2026, a mudança 2022 → 2026 e o selo de quem virou. Posição pela conta da posição na lista.
	measure 'T19 · Lista · HTML' =
			-- 1 · Leituras
			VAR _pos = [T19 · posição na lista]
			VAR _lula = [T19 · Lula % 2026]
			VAR _flavio = [T19 · Flávio % 2026]
			VAR _var = [T19 · variação da margem]
			VAR _virou = [T19 · virou]
			VAR _m06 = [T19 · margem 2006]
			VAR _m10 = [T19 · margem 2010]
			VAR _m14 = [T19 · margem 2014]
			VAR _m18 = [T19 · margem 2018]
			VAR _m22 = [T19 · margem 2022]
			VAR _m26 = [T19 · margem 2026]
			-- 2 · Textos
			VAR _nome0 = [T19 · município]
			VAR _nome1 = SUBSTITUTE ( _nome0, "&", "&amp;" )
			VAR _nome2 = SUBSTITUTE ( SUBSTITUTE ( _nome1, "<", "&lt;" ), ">", "&gt;" )
			VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome2, """", "&quot;" ), "'", "&#39;" )
			VAR _txtLula = FORMAT ( _lula, "0.0%" )
			VAR _txtFlavio = FORMAT ( _flavio, "0.0%" )
			VAR _txtVar = IF ( ISBLANK ( _var ), "—", FORMAT ( _var * 100, "+0.0;−0.0;0.0" ) )
			VAR _clsVar = IF ( _var < 0, "flavio", IF ( _var > 0, "lula", "" ) )
			VAR _clsFim = IF ( _m26 < 0, "f", "l" )
			VAR _selo = IF ( _virou = 1, "<span class='selo'>virou</span>", "" )
			VAR _atraso = "d" & MIN ( _pos, 16 )
			-- 3 · Geometria
			VAR _y = 36 + ( _pos - 1 ) * 44 -- geometria
			VAR _base = { ( 0, 4.0, _m06 ), ( 1, 29.6, _m10 ), ( 2, 55.2, _m14 ), ( 3, 80.8, _m18 ), ( 4, 106.4, _m22 ), ( 5, 132.0, _m26 ) } /* lista */
			VAR _pts =
			    FILTER ( /* lista */
			        SELECTCOLUMNS (
			            _base,
			            "i", [Value1],
			            "x", [Value2],
			            "y", IF ( ISBLANK ( [Value3] ), BLANK (), 15.0 - MAX ( -0.6, MIN ( 0.6, [Value3] ) ) / 0.6 * 13.0 )
			        ),
			        NOT ISBLANK ( [y] )
			    ) -- geometria
			VAR _primeiro = MINX ( _pts, [i] ) /* lista */
			VAR _d =
			    CONCATENATEX (
			        _pts,
			        IF ( [i] = _primeiro, "M", "L" ) & FORMAT ( [x], "0.0##", "en-US" ) & "," & FORMAT ( [y], "0.0##", "en-US" ),
			        " ",
			        [i], ASC
			    ) /* lista */
			VAR _yFim = MAXX ( FILTER ( _pts, [i] = 5 ), [y] ) /* lista */
			VAR _ponto =
			    IF (
			        NOT ISBLANK ( _yFim ),
			        "<circle class='" & _clsFim & "' cx='132.0' cy='" & FORMAT ( _yFim, "0.0##", "en-US" ) & "' r='3.6'/>"
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _pos ),
			        "<div class='tela t19l'><div class='ln sobe " & _atraso & "' style='top:" & _y & "px'>"
			            & "<span class='c-nome' title='" & _nome & "'>" & _nome & "</span>"
			            & "<span class='c-l lula tnum'>" & _txtLula & "</span>"
			            & "<span class='c-f flavio tnum'>" & _txtFlavio & "</span>"
			            & "<svg class='c-s' width='136' height='30' viewBox='0 0 136 30'>"
			                & "<line class='zero' x1='0' x2='136' y1='15.0' y2='15.0'/>"
			                & "<path class='traco-rapido' pathLength='1' d='" & _d & "'/>" & _ponto
			            & "</svg>"
			            & "<span class='c-v tnum " & _clsVar & "'>" & _txtVar & "</span>"
			            & "<span class='c-x'>" & _selo & "</span>"
			        & "</div></div>"
			    )
		displayFolder: T19 Explorador\Desenho
		lineageTag: 269b51e8-9a13-5a7b-a624-aafb95301441

	/// Texto alternativo da faixa do recorte.
	measure 'T19 · Resumo · ALT' =
			-- 1 · Leituras
			VAR _recorte = [T19 · recorte em uso]
			VAR _n = [T19 · municípios no recorte]
			VAR _lula = [T19 · municípios com Lula à frente]
			VAR _flavio = [T19 · municípios com Flávio à frente]
			VAR _viraram = [T19 · municípios que viraram]
			-- 2 · Textos
			RETURN
			    "Recorte: " & _recorte & ". " & FORMAT ( _n, "#,0" ) & IF ( _n = 1, " município", " municípios" )
			        & "; Lula à frente em " & FORMAT ( _lula, "#,0" ) & ", Flávio em " & FORMAT ( _flavio, "#,0" ) & "; "
			        & IF ( _viraram = 0, "nenhum virou", FORMAT ( _viraram, "#,0" ) & IF ( _viraram = 1, " virou", " viraram" ) )
			        & " de Lula para Flávio."
		displayFolder: T19 Explorador\Desenho
		lineageTag: 23181e62-9eb1-5476-9f84-66b2fa9baab5

	/// Faixa do recorte acima da lista: os filtros em uso e quantos municípios, com Lula à frente, com Flávio à frente e que viraram, com a barra da proporção. Só lê as contas de T19.
	measure 'T19 · Resumo · HTML' =
			-- 1 · Leituras
			VAR _recorte = [T19 · recorte em uso]
			VAR _n = [T19 · municípios no recorte]
			VAR _lula = [T19 · municípios com Lula à frente]
			VAR _flavio = [T19 · municípios com Flávio à frente]
			VAR _viraram = [T19 · municípios que viraram]
			-- 2 · Textos
			VAR _rec0 = SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" )
			VAR _txtN = FORMAT ( _n, "#,0" )
			VAR _txtLula = FORMAT ( _lula, "#,0" )
			VAR _txtFlavio = FORMAT ( _flavio, "#,0" )
			VAR _txtViraram = FORMAT ( _viraram, "#,0" )
			VAR _rotN = IF ( _n = 1, "município no recorte", "municípios no recorte" )
			VAR _rotViraram = IF ( _viraram = 1, "virou de Lula para Flávio", "viraram de Lula para Flávio" )
			-- 3 · Geometria
			VAR _total = _lula + _flavio
			VAR _largLula = IF ( _total > 0, DIVIDE ( _lula, _total ) * 100, 0 ) -- geometria
			VAR _largFlavio = IF ( _total > 0, DIVIDE ( _flavio, _total ) * 100, 0 ) -- geometria
			-- 4 · Marcação
			RETURN
			    "<div class='tela t19r'>"
			        & "<div class='sob sobe'>Recorte · " & _rec0 & "</div>"
			        & "<div class='st sobe d1'><span class='num'>" & _txtN & "</span><span class='r'>" & _rotN & "</span></div>"
			        & "<div class='st sobe d2 lula'><span class='num'>" & _txtLula & "</span><span class='r'>com Lula à frente</span></div>"
			        & "<div class='st sobe d3 flavio'><span class='num'>" & _txtFlavio & "</span><span class='r'>com Flávio à frente</span></div>"
			        & "<div class='st sobe d4'><span class='num'>" & _txtViraram & "</span><span class='r'>" & _rotViraram & "</span></div>"
			        & "<div class='br'><i class='l barra-x' style='width:" & FORMAT ( _largLula, "0.0##", "en-US" ) & "%'></i>"
			        & "<i class='f barra-x-dir' style='width:" & FORMAT ( _largFlavio, "0.0##", "en-US" ) & "%'></i></div>"
			    & "</div>"
		displayFolder: T19 Explorador\Desenho
		lineageTag: e130413b-f76e-556f-be61-c73b56117fa4

