		lineageTag: a52cc05d-9a34-5360-afb0-ac82ed824db6

	/// Votos nulos no ano do contexto: Brasil oficial ('Comparecimento ano') sem filtro; soma dos municípios com o filtro de UF.
	measure 'T06 · nulos (ano)' =
