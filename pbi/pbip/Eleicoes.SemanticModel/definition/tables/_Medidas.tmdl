	/// Brancos + nulos no 1º turno de 2026, no recorte.
	measure 'T06 · brancos e nulos · 2026' =
			CALCULATE ( [T06 · brancos (ano)] + [T06 · nulos (ano)], 'Ano'[Ano] = 2026 )
		formatString: #,0
