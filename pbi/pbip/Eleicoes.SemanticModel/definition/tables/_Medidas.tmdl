	/// Instituto da pesquisa mostrada na lente: Datafolha, Quaest, AtlasIntel ou Ipec, o primeiro que publicou o cruzamento; vazio no IDH (nenhuma pesquisa pergunta).
	measure 'T24 · instituto' =
			VAR _l = [T24 · lente]
			VAR _tem =
			    CALCULATETABLE ( VALUES ( 'Perfil pesquisa'[Instituto] ), 'Perfil pesquisa'[Lente] = _l )
			RETURN
			    SWITCH (
