	/// Texto para leitor de tela do título da composição.
	measure 'T06 · Composição topo · ALT' =
			LEFT (
			    "Quem não escolheu ninguém, " & [T06 · recorte] & ": em 2006, "
			        & [T06 · faltaram entre quem não escolheu · em cada 10 · 2006] & " em cada 10 nem foram votar; em 2026, "
			        & [T06 · faltaram entre quem não escolheu · em cada 10 · 2026] & ". Brancos e nulos: "
			        & SWITCH ( TRUE (), ABS ( [T06 · brancos e nulos · 2006] ) >= 1000000, FORMAT ( [T06 · brancos e nulos · 2006] / 1000000, "0.0" ) & " mi", ABS ( [T06 · brancos e nulos · 2006] ) >= 1000, FORMAT ( [T06 · brancos e nulos · 2006] / 1000, "0.0" ) & " mil", FORMAT ( [T06 · brancos e nulos · 2006], "#,0" ) ) & " em 2006 e " & SWITCH ( TRUE (), ABS ( [T06 · brancos e nulos · 2026] ) >= 1000000, FORMAT ( [T06 · brancos e nulos · 2026] / 1000000, "0.0" ) & " mi", ABS ( [T06 · brancos e nulos · 2026] ) >= 1000, FORMAT ( [T06 · brancos e nulos · 2026] / 1000, "0.0" ) & " mil", FORMAT ( [T06 · brancos e nulos · 2026], "#,0" ) ) & " em 2026.",
			    250
			)
		displayFolder: T06 Ausência\Desenho
		lineageTag: 505abfcd-b7fc-59ce-8038-cb2472a185bd

	/// Título da composição: em cada 10 que não escolheram ninguém, quantos nem foram votar em 2026 e em 2006, a legenda das três partes e a nota à mão sobre brancos e nulos. Só lê contas.
	measure 'T06 · Composição topo · HTML' =
			-- 1 · Leituras
			VAR _recorte = [T06 · recorte]
			VAR _d26 = [T06 · faltaram entre quem não escolheu · em cada 10 · 2026]
			VAR _d06 = [T06 · faltaram entre quem não escolheu · em cada 10 · 2006]
			VAR _bn26 = [T06 · brancos e nulos · 2026]
			VAR _bn06 = [T06 · brancos e nulos · 2006]
			-- 2 · Textos
			VAR _man =
			    IF (
			        _d26 = _d06,
			        "Desde 2006, " & _d26 & " em cada 10 que não escolhem ninguém nem vão votar",
			        "Hoje, " & _d26 & " em cada 10 que não escolhem ninguém nem vão votar; em 2006, eram " & _d06
			    )
			VAR _nota = IF ( _bn26 < _bn06, "brancos e nulos encolheram", "brancos e nulos cresceram" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela ct'>"
			        & "<div class='sob sobe'>Quem não escolheu ninguém · eleição a eleição · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='man sobe d1'>" & _man & "</div>"
			        & "<div class='leg entra d3'><span><i class='f'></i>não foram votar</span>"
			        & "<span><i class='n'></i>anularam</span><span><i class='b'></i>votaram em branco</span>"
			        & "<span class='mao'>" & _nota & "</span></div>"
			    & "</div>"
		displayFolder: T06 Ausência\Desenho
		lineageTag: d9855f16-a6a1-50b6-ab85-f276b7e7b139

	/// Texto para leitor de tela das colunas da composição.
	measure 'T06 · Composição · ALT' =
			LEFT (
			    "Colunas de 2006 a 2026 com quem não escolheu ninguém " & [Recorte · em]
			        & ": quem faltou, quem anulou e quem votou em branco. Passe o mouse num ano para ver a disputa e quantas "
			        & "vezes a diferença entre os dois primeiros cabia em quem faltou.",
			    250
			)
		displayFolder: T06 Ausência\Desenho
		lineageTag: 3b15d3d0-ce0c-5f1c-a53f-cbec68af2e78

	/// Uma coluna por 1º turno (granularidade Ano[Ano]): quem não escolheu ninguém empilhado em quem faltou (grafite), quem anulou (marrom) e quem votou em branco (areia); o total em cima e, na parte de quem faltou, a parcela que ela é do total. O alvo transparente abre o dossiê do ano. Só lê contas; a escala é geometria.
	measure 'T06 · Composição · HTML' =
			-- 1 · Leituras
			VAR _ano = [T06 · ano]
			VAR _abst = [T06 · abstenções (ano)]
			VAR _nul = [T06 · nulos (ano)]
			VAR _bra = [T06 · brancos (ano)]
			VAR _tot = [T06 · não escolheram (ano)]
			VAR _parte = [T06 · faltaram entre quem não escolheu (ano)]
			VAR _teto = [T06 · maior não escolheram da série]
			-- 2 · Textos
			VAR _txtTot = SWITCH ( TRUE (), ABS ( _tot ) >= 1000000, FORMAT ( _tot / 1000000, "0.0" ) & " mi", ABS ( _tot ) >= 1000, FORMAT ( _tot / 1000, "0.0" ) & " mil", FORMAT ( _tot, "#,0" ) )
			-- 3 · Geometria (6 colunas em 130 px cada; de 0 ao teto em 560 px sobre a base a 44 px do pé)
			VAR _i = ( _ano - 2006 ) / 4 -- geometria
			VAR _x = _i * 130 -- geometria
			VAR _k = DIVIDE ( 560, _teto ) -- geometria
			VAR _ha = _abst * _k -- geometria
			VAR _hn = _nul * _k -- geometria
			VAR _hb = _bra * _k -- geometria
			VAR _rotParte = IF ( _ha >= 30, "<span class='pt'>" & FORMAT ( _parte, "0%" ) & "</span>" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _tot ),
			        "<div class='tela cp'><div class='col' style='left:" & FORMAT ( _x, "0.0##", "en-US" ) & "px'>"
			            & "<div class='tot sobe d" & ( _i + 6 ) & "' style='bottom:" & FORMAT ( _ha + _hn + _hb + 52, "0.0##", "en-US" ) & "px'>"
			            & _txtTot & "</div>"
			            & "<div class='pilha barra-y d" & ( _i + 2 ) & "' style='height:" & FORMAT ( _ha + _hn + _hb, "0.0##", "en-US" ) & "px'>"
			            & "<i class='b' style='height:" & FORMAT ( _hb, "0.0##", "en-US" ) & "px'></i>"
			            & "<i class='n' style='height:" & FORMAT ( _hn, "0.0##", "en-US" ) & "px'></i>"
			            & "<i class='f' style='height:" & FORMAT ( _ha, "0.0##", "en-US" ) & "px'>" & _rotParte & "</i></div>"
			            & "<div class='ano'>" & _ano & "</div><div class='alvo'></div></div></div>"
			    )
		displayFolder: T06 Ausência\Desenho
		lineageTag: 1843455f-7d31-5834-946e-507ca741c12b

	/// Texto para leitor de tela do bloco da resposta.
	measure 'T06 · Resposta · ALT' =
			LEFT (
			    [T06 · recorte] & ": " & SWITCH ( TRUE (), ABS ( [T06 · abstenções] ) >= 1000000, FORMAT ( [T06 · abstenções] / 1000000, "0.00" ) & " mi", ABS ( [T06 · abstenções] ) >= 1000, FORMAT ( [T06 · abstenções] / 1000, "0.0" ) & " mil", FORMAT ( [T06 · abstenções], "#,0" ) ) & " não foram votar em 2026 (" & FORMAT ( [T06 · abstenção %], "0.0%" )
			        & " dos aptos), " & FORMAT ( [T06 · vezes a diferença], "0.0" ) & " vezes a diferença entre Flávio e "
			        & "Lula. Com brancos e nulos, " & SWITCH ( TRUE (), ABS ( [T06 · não escolheram] ) >= 1000000, FORMAT ( [T06 · não escolheram] / 1000000, "0.00" ) & " mi", ABS ( [T06 · não escolheram] ) >= 1000, FORMAT ( [T06 · não escolheram] / 1000, "0.0" ) & " mil", FORMAT ( [T06 · não escolheram], "#,0" ) ) & " não escolheram ninguém.",
			    250
			)
		displayFolder: T06 Ausência\Desenho
		lineageTag: e131d4e7-4190-5d42-8c2a-e5ee92d66322

	/// Bloco da resposta da tela 06: quantos não foram votar, a régua de quantas vezes a diferença entre os dois primeiros cabe nesse número e quem não escolheu ninguém. Só lê contas.
	measure 'T06 · Resposta · HTML' =
			-- 1 · Leituras
			VAR _comUF = [T06 · com UF]
			VAR _recorte = [T06 · recorte]
			VAR _abst = [T06 · abstenções]
			VAR _pct = [T06 · abstenção %]
			VAR _aptos = [T06 · aptos]
			VAR _dif = [T06 · diferença Flávio Lula]
			VAR _vezes = [T06 · vezes a diferença]
			VAR _venc = [T06 · vencedor]
			VAR _nao = [T06 · não escolheram]
			VAR _naoP = [T06 · não escolheram %]
			-- 2 · Textos
			VAR _txtAbst = SWITCH ( TRUE (), ABS ( _abst ) >= 1000000, FORMAT ( _abst / 1000000, "0.0" ) & " mi", ABS ( _abst ) >= 1000, FORMAT ( _abst / 1000, "0.0" ) & " mil", FORMAT ( _abst, "#,0" ) )
			VAR _txtAptos = SWITCH ( TRUE (), ABS ( _aptos ) >= 1000000, FORMAT ( _aptos / 1000000, "0.0" ) & " mi", ABS ( _aptos ) >= 1000, FORMAT ( _aptos / 1000, "0.0" ) & " mil", FORMAT ( _aptos, "#,0" ) )
			VAR _txtDif = SWITCH ( TRUE (), ABS ( _dif ) >= 1000000, FORMAT ( _dif / 1000000, "0.00" ) & " mi", ABS ( _dif ) >= 1000, FORMAT ( _dif / 1000, "0.0" ) & " mil", FORMAT ( _dif, "#,0" ) )
			VAR _par = IF ( _venc = "Lula", "Lula e Flávio", "Flávio e Lula" )
			VAR _n = INT ( _vezes )
			VAR _txtVezes = IF ( _vezes >= 10, FORMAT ( _n, "0" ), FORMAT ( _vezes, "0.0" ) )
			VAR _manchete =
			    IF (
			        _vezes >= 1,
			        "É " & _txtVezes & " vezes a diferença entre " & _par,
			        "A diferença entre " & _par & " foi maior que o número de quem faltou"
			    )
			VAR _txtNota = IF ( _vezes >= 1, "cabe " & _txtVezes & " vezes", "não cabe nem uma vez" )
			VAR _rodape =
			    "Somando brancos e nulos, " & SWITCH ( TRUE (), ABS ( _nao ) >= 1000000, FORMAT ( _nao / 1000000, "0.0" ) & " mi", ABS ( _nao ) >= 1000, FORMAT ( _nao / 1000, "0.0" ) & " mil", FORMAT ( _nao, "#,0" ) ) & " (" & FORMAT ( _naoP, "0.0%" ) & " dos aptos) não escolheram ninguém."
			-- 3 · Geometria (régua de 760 px = quem faltou; a diferença é um pedaço dela)
			VAR _wDif = IF ( _vezes >= 1, MAX ( 3, DIVIDE ( 760, _vezes ) ), 760 ) -- geometria
			VAR _wAbst = IF ( _vezes >= 1, 760, MAX ( 3, 760 * _vezes ) ) -- geometria
			VAR _passo = SWITCH ( TRUE (), _n <= 40, 1, _n <= 200, 5, _n <= 1000, 25, 100 ) -- geometria
			VAR _cortes = GENERATESERIES ( _passo, MAX ( _n, _passo ), _passo ) /* lista */
			VAR _marcas =
			    CONCATENATEX (
			        FILTER ( _cortes, [Value] * _wDif < 758 && _vezes >= 1 ), /* lista */
			        VAR _x = FORMAT ( [Value] * _wDif, "0.0##", "en-US" ) -- geometria
			        RETURN
			            "<line x1='" & _x & "' y1='4' x2='" & _x & "' y2='40'/>",
			        "",
			        [Value], ASC
			    )
			VAR _txtW = FORMAT ( _wDif, "0.0##", "en-US" ) -- geometria
			VAR _txtWA = FORMAT ( _wAbst, "0.0##", "en-US" ) -- geometria
			VAR _clsNota = IF ( _vezes >= 1, "mao nota1", "mao nota1 baixa" )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela rp'>"
			        & "<div class='sob sobe'>Quem não foi votar · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='topo'><div class='big sobe d1'>" & _txtAbst & "</div>"
			        & "<div class='lado sobe d2'><div class='nfv'>não foram votar</div>" & [T06 · sublinhado · SVG]
			        & "<div class='txt'>" & FORMAT ( _pct, "0.0%" ) & " dos " & _txtAptos & " de eleitores aptos em 2026</div></div></div>"
			        & "<div class='man mc sobe d3'>" & _manchete & "</div>"
			        & "<div class='regua'>"
			        & "<div class='rot rt1 sobe d4'>Quem faltou · " & _txtAbst & "</div>"
			        & "<svg class='r1' width='760' height='44' viewBox='0 0 760 44'><rect class='cheia barra-x d5' x='0' y='4' width='" & _txtWA & "' height='36'/>"
			        & "<g class='cortes entra d9'>" & _marcas & "</g></svg>"
			        & "<div class='dif' style='width:" & _txtW & "px'><div class='barra-x d8'></div></div>"
			        & "<div class='rot rt2 sobe d8'>A diferença entre " & _par & " · " & _txtDif & "</div>"
			        & "<div class='" & _clsNota & " entra d12'>" & _txtNota & "</div>"
			        & "</div>"
			        & "<div class='txt pe sobe d10'>" & _rodape & "</div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T06 Ausência\Desenho
		lineageTag: a518d86f-08d5-5fd0-babb-a00d53a01c41

	/// Sublinhado à mão sob 'não foram votar' (traço que se desenha). Desenho fixo.
	measure 'T06 · sublinhado · SVG' =
			"<svg class='subl' viewBox='0 0 300 16' preserveAspectRatio='none' aria-hidden='true'><path pathLength='1' class='traco' style='animation-delay:1.1s' d='M3,10 C60,4 140,13 205,7 C240,4 270,6 297,9' fill='none' stroke='#1C1915' stroke-width='3' stroke-linecap='round'/></svg>"
		displayFolder: T06 Ausência\Desenho
		lineageTag: 52c2bf9d-e134-56c2-a8cc-79e20a67a39e

	/// Texto para leitor de tela dos alvos da série.
	measure 'T06 · Série alvos · ALT' =
			"Passe o mouse num ano da linha para ver a disputa daquele 1º turno e quantas vezes a diferença entre os dois "
			    & "primeiros cabia em quem faltou."
		displayFolder: T06 Ausência\Desenho
		lineageTag: 34b5b21d-cfd1-5556-8aca-5a760ba1a497

	/// Alvo transparente de cada ano sobre a linha da série (granularidade Ano[Ano]): só recebe o mouse para abrir o dossiê do ano; não desenha nada.
	measure 'T06 · Série alvos · HTML' =
			-- 1 · Leituras
			VAR _ano = [T06 · ano]
			VAR _abst = [T06 · abstenções (ano)]
			-- 3 · Geometria (o x do ano na série: 60 + (ano − 2006) × 32; alvo de 128 px centrado nele)
			VAR _x = 60 + ( _ano - 2006 ) * 32 - 64 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _abst ),
			        "<div class='tela sa'><div class='alvo' style='left:" & FORMAT ( _x, "0.0##", "en-US" ) & "px'></div></div>"
			    )
		displayFolder: T06 Ausência\Desenho
		lineageTag: c19fbfe2-5385-5acf-933e-b5f88e3341b8

	/// Texto para leitor de tela da série da abstenção.
	measure 'T06 · Série · ALT' =
			LEFT (
			    "Abstenção no 1º turno, " & [T06 · recorte] & ": " & FORMAT ( [T06 · abstenção % 2006], "0.0%" ) & " em 2006 e "
			        & FORMAT ( [T06 · abstenção %], "0.0%" ) & " em 2026.",
			    250
			)
		displayFolder: T06 Ausência\Desenho
		lineageTag: eec17ca7-6f68-5bea-a77b-16aed43590f7

	/// A abstenção em cada 1º turno de 2006 a 2026, no recorte: uma linha que se desenha com o % em cada eleição. Só lê contas; a escala é geometria.
	measure 'T06 · Série · HTML' =
			-- 1 · Leituras
			VAR _p06 = [T06 · abstenção % 2006]
			VAR _p26 = [T06 · abstenção %]
			VAR _dpp = [T06 · variação da abstenção em p.p.]
			VAR _anos =
			    ADDCOLUMNS ( VALUES ( 'Ano'[Ano] ), "@p", [T06 · abstenção % (ano)], "@n", [T06 · abstenções (ano)] )
			-- 2 · Textos
			VAR _verbo = IF ( _dpp >= 0, "subiu", "caiu" )
			VAR _txt06 = FORMAT ( _p06, "0.0%" )
			VAR _txt26 = FORMAT ( _p26, "0.0%" )
			VAR _manchete =
			    IF (
			        _txt06 = _txt26,
			        "Em 20 anos, a abstenção ficou em " & _txt26,
			        "Em 20 anos, a abstenção " & _verbo & " de " & _txt06 & " para " & _txt26
			    )
			-- 3 · Geometria (anos em x 60–700; % de cima para baixo em y 30–220, de 10% a 26% — ou o que couber)
			VAR _min = MIN ( 0.10, MINX ( _anos, [@p] ) - 0.01 ) -- geometria
			VAR _max = MAX ( 0.26, MAXX ( _anos, [@p] ) + 0.01 ) -- geometria
			VAR _pts =
			    ADDCOLUMNS (
			        _anos,
			        "@x", 60 + ( 'Ano'[Ano] - 2006 ) / 20 * 640, -- geometria
			        "@y", 220 - ( [@p] - _min ) / ( _max - _min ) * 190 -- geometria
			    )
			VAR _caminho =
			    CONCATENATEX ( _pts, FORMAT ( [@x], "0.0##", "en-US" ) & "," & FORMAT ( [@y], "0.0##", "en-US" ), " L", 'Ano'[Ano], ASC ) -- geometria
			VAR _area =
			    "M60,250 L" & _caminho & " L700,250 Z" -- geometria
			VAR _rotulos =
			    CONCATENATEX (
			        _pts,
			        "<div class='pt sobe d" & ( ( 'Ano'[Ano] - 2006 ) / 4 + 6 ) & "' style='left:" & FORMAT ( [@x] - 50, "0.0##", "en-US" )
			            & "px;top:" & FORMAT ( [@y] - 40, "0.0##", "en-US" ) & "px'>" & FORMAT ( [@p], "0.0%" ) & "</div>"
			            & "<div class='an' style='left:" & FORMAT ( [@x] - 50, "0.0##", "en-US" ) & "px'>" & 'Ano'[Ano] & "</div>",
			        "",
			        'Ano'[Ano], ASC
			    )
			VAR _pontos =
			    CONCATENATEX (
			        _pts,
			        "<circle class='brota d" & ( ( 'Ano'[Ano] - 2006 ) / 4 + 5 ) & "' cx='" & FORMAT ( [@x], "0.0##", "en-US" ) & "' cy='"
			            & FORMAT ( [@y], "0.0##", "en-US" ) & "' r='6'/>",
			        "",
			        'Ano'[Ano], ASC
			    )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela se'>"
			        & "<div class='sob sobe'>A ausência em duas décadas · 1º turno</div>"
			        & "<div class='man sobe d1'>" & _manchete & "</div>"
			        & "<div class='gr'><svg width='760' height='270' viewBox='0 0 760 270'>"
			        & "<path class='area esmaece' d='" & _area & "'/>"
			        & "<path class='linha traco d3' pathLength='1' d='M" & _caminho & "'/>"
			        & "<line class='base' x1='40' y1='250' x2='720' y2='250'/>" & _pontos & "</svg>" & _rotulos
			        & "<div class='mao dpp entra d14'>" & FORMAT ( _dpp, "+0.0;−0.0;0.0" ) & IF ( ABS ( _dpp ) < 2, " ponto", " pontos" ) & " em 20 anos</div></div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T06 Ausência\Desenho
		lineageTag: b35fd414-8628-51a5-9e72-2393a82639fd

	/// Texto para leitor de tela do dossiê do ano.
	measure 'T06 · Tooltip ano · ALT' =
			LEFT (
			    "1º turno de " & [T06 · ano] & " (" & [T06 · disputa do ano] & "), " & [T06 · recorte] & ": faltaram "
			        & SWITCH ( TRUE (), ABS ( [T06 · abstenções (ano)] ) >= 1000000, FORMAT ( [T06 · abstenções (ano)] / 1000000, "0.0" ) & " mi", ABS ( [T06 · abstenções (ano)] ) >= 1000, FORMAT ( [T06 · abstenções (ano)] / 1000, "0.0" ) & " mil", FORMAT ( [T06 · abstenções (ano)], "#,0" ) ) & ", " & FORMAT ( [T06 · vezes a diferença (ano)], "0.0" )
			        & " vezes a diferença entre os dois primeiros; anularam " & SWITCH ( TRUE (), ABS ( [T06 · nulos (ano)] ) >= 1000000, FORMAT ( [T06 · nulos (ano)] / 1000000, "0.0" ) & " mi", ABS ( [T06 · nulos (ano)] ) >= 1000, FORMAT ( [T06 · nulos (ano)] / 1000, "0.0" ) & " mil", FORMAT ( [T06 · nulos (ano)], "#,0" ) )
			        & " e votaram em branco " & SWITCH ( TRUE (), ABS ( [T06 · brancos (ano)] ) >= 1000000, FORMAT ( [T06 · brancos (ano)] / 1000000, "0.0" ) & " mi", ABS ( [T06 · brancos (ano)] ) >= 1000, FORMAT ( [T06 · brancos (ano)] / 1000, "0.0" ) & " mil", FORMAT ( [T06 · brancos (ano)], "#,0" ) ) & ".",
			    250
			)
		displayFolder: T06 Ausência\Desenho
		lineageTag: a3055e95-a747-59e5-8261-c4831ab576c2

	/// Dossiê do ano (ficha presa com fita): quem disputou, quantas vezes a diferença entre os dois primeiros cabia em quem faltou, os números de quem faltou e da diferença, quantos anularam ou votaram em branco e, à mão, a comparação com 2026. Só lê contas.
	measure 'T06 · Tooltip ano · HTML' =
			-- 1 · Leituras
			VAR _ano = [T06 · ano]
			VAR _recorte = [T06 · recorte]
			VAR _disputa = [T06 · disputa do ano]
			VAR _vezes = [T06 · vezes a diferença (ano)]
			VAR _vezes26 = [T06 · vezes a diferença em 2026]
			VAR _abst = [T06 · abstenções (ano)]
			VAR _dif = [T06 · diferença do ano]
			VAR _nul = [T06 · nulos (ano)]
			VAR _bra = [T06 · brancos (ano)]
			-- 2 · Textos
			VAR _txtVezes = IF ( _vezes >= 10, FORMAT ( _vezes, "0" ), FORMAT ( _vezes, "0.0" ) )
			VAR _txt26 = IF ( _vezes26 >= 10, FORMAT ( _vezes26, "0" ), FORMAT ( _vezes26, "0.0" ) )
			VAR _cabe =
			    IF (
			        _vezes >= 1,
			        "é quantas vezes a diferença entre os dois primeiros cabia em quem faltou",
			        "a diferença entre " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _disputa, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " foi maior que o número de quem faltou"
			    )
			VAR _nota = IF ( _ano <> 2026 && NOT ISBLANK ( _vezes26 ), "em 2026: " & _txt26 & " vezes" )
			-- 4 · Marcação
			VAR _css =
			    "<style>"
			        & ".tt6{position:fixed;inset:0;background:var(--papel)}"
			        & ".tt6 .ficha{position:absolute;left:14px;top:22px;right:14px;bottom:14px;background:var(--branco);"
			        & "border:1.5px solid var(--areia);box-shadow:3px 4px 0 rgba(28,25,21,.07)}"
			        & ".tt6 .fita{position:absolute;left:150px;top:-16px;width:96px;transform:rotate(3deg);opacity:.9}"
			        & ".tt6 .ic{position:absolute;right:16px;top:14px;width:34px}"
			        & ".tt6 .cab{position:absolute;left:18px;top:14px;right:60px}"
			        & ".tt6 .nm{font-size:22px;font-weight:700;line-height:1.15}"
			        & ".tt6 .big{position:absolute;left:18px;top:80px;font-size:44px;font-weight:700;letter-spacing:-.03em;"
			        & "white-space:nowrap}"
			        & ".tt6 .bs{position:absolute;left:178px;top:82px;right:18px;font-size:15px;color:var(--grafite);"
			        & "line-height:1.35}"
			        & ".tt6 .lin{position:absolute;left:18px;right:18px;border-top:1px dashed var(--areia);"
			        & "padding-top:8px;font-size:15px;color:var(--grafite)}.tt6 .lin b{color:var(--tinta)}"
			        & ".tt6 .mao{position:absolute;right:18px;bottom:8px;font-size:28px;color:var(--tinta)}"
			    & "</style>"
			VAR _html =
			    _css
			        & "<div class='tt6'><div class='ficha'>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/>"
			        & "<img class='ic' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/urna-tinta.png'/>"
			        & "<div class='cab sobe'><div class='nm'>1º turno de " & _ano & "</div>"
			        & "<div class='rot'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _disputa, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div>"
			        & "<div class='big sobe d1'>" & _txtVezes & "×</div>"
			        & "<div class='bs sobe d2'>" & _cabe & "</div>"
			        & "<div class='lin sobe d3' style='top:160px'>Faltaram <b>" & SWITCH ( TRUE (), ABS ( _abst ) >= 1000000, FORMAT ( _abst / 1000000, "0.0" ) & " mi", ABS ( _abst ) >= 1000, FORMAT ( _abst / 1000, "0.0" ) & " mil", FORMAT ( _abst, "#,0" ) ) & "</b>; a diferença entre "
			        & "os dois foi de <b>" & SWITCH ( TRUE (), ABS ( _dif ) >= 1000000, FORMAT ( _dif / 1000000, "0.00" ) & " mi", ABS ( _dif ) >= 1000, FORMAT ( _dif / 1000, "0.0" ) & " mil", FORMAT ( _dif, "#,0" ) ) & "</b></div>"
			        & "<div class='lin sobe d4' style='top:204px'>Anularam <b>" & SWITCH ( TRUE (), ABS ( _nul ) >= 1000000, FORMAT ( _nul / 1000000, "0.0" ) & " mi", ABS ( _nul ) >= 1000, FORMAT ( _nul / 1000, "0.0" ) & " mil", FORMAT ( _nul, "#,0" ) ) & "</b> · votaram em branco <b>"
			        & SWITCH ( TRUE (), ABS ( _bra ) >= 1000000, FORMAT ( _bra / 1000000, "0.0" ) & " mi", ABS ( _bra ) >= 1000, FORMAT ( _bra / 1000, "0.0" ) & " mil", FORMAT ( _bra, "#,0" ) ) & "</b></div>"
			        & "<div class='mao entra d6'>" & _nota & "</div>"
			        & "</div></div>"
			RETURN
			    IF ( NOT ISBLANK ( _abst ) && NOT ISBLANK ( _dif ), _html )
		displayFolder: T06 Ausência\Desenho
		lineageTag: 04af6ffd-8b5a-50a5-9a3f-8e2db6898fff

	/// Debates do 1º turno cancelados ou não realizados.
	measure 'T07 · 1º turno · cancelados' =
			CALCULATE (
			    COUNTROWS ( Debate ),
			    REMOVEFILTERS ( Debate ),
			    Debate[Turno] = 1,
			    LEFT ( UPPER ( Debate[Observação] ), 9 ) <> "REALIZADO"
			) + 0
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: 638397a0-42f9-5dfd-8ba6-22dedc478775

	/// Debates do 1º turno que aconteceram sem Lula e sem Flávio.
	measure 'T07 · 1º turno · sem os dois' =
			CALCULATE (
			    COUNTROWS ( Debate ),
			    REMOVEFILTERS ( Debate ),
			    Debate[Turno] = 1,
			    LEFT ( UPPER ( Debate[Observação] ), 9 ) = "REALIZADO",
			    NOT CONTAINSSTRING ( Debate[Participantes], "Lula" ),
			    NOT CONTAINSSTRING ( Debate[Participantes], "Flávio" )
			) + 0
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: ab8a2978-9978-5997-8f02-8dae8725c9e8

	/// Debates do 2º turno que não aconteceram (cancelados ou não realizados); os dois do 2º turno que aconteceram, Band e Globo, tiveram Lula e Flávio.
	measure 'T07 · 2º turno · desmarcados' =
			CALCULATE (
			    COUNTROWS ( Debate ),
			    REMOVEFILTERS ( Debate ),
			    Debate[Turno] = 2,
			    LEFT ( UPPER ( Debate[Observação] ), 9 ) <> "REALIZADO"
			) + 0
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: e4891253-db51-5447-a0c1-3d0b07e5b8d4

	/// As emissoras dos debates do 2º turno em que Lula e Flávio estiveram, na ordem das datas, em lista ("Band e Globo").
	measure 'T07 · 2º turno · frente a frente · emissoras' =
			VAR _t =
			    CALCULATETABLE (
			        SUMMARIZE ( Debate, Debate[Data], Debate[Emissora] ),
			        REMOVEFILTERS ( Debate ),
			        Debate[Turno] = 2,
			        CONTAINSSTRING ( Debate[Participantes], "Lula" ),
			        CONTAINSSTRING ( Debate[Participantes], "Flávio" )
			    )
			VAR _ult = MAXX ( _t, Debate[Data] )
			VAR _antes = CONCATENATEX ( FILTER ( _t, Debate[Data] < _ult ), Debate[Emissora], ", ", Debate[Data], ASC )
			VAR _fim = MAXX ( FILTER ( _t, Debate[Data] = _ult ), Debate[Emissora] )
			RETURN
			    IF ( _antes = "", _fim, _antes & " e " & _fim )
		displayFolder: T07 Debate\Contas
		lineageTag: 47efa87b-4e03-542c-998d-499af65938eb

	/// Flávio − Lula, em pontos, na média das pesquisas com campo terminado antes do dia do debate.
	measure 'T07 · antes · diferença' =
			[T07 · antes · Flávio] - [T07 · antes · Lula]
		formatString: 0.0
		displayFolder: T07 Debate\Contas
		lineageTag: c827b3b2-9b2b-5956-a314-f6fdbc2c1e56

	/// Média simples de Flávio (votos totais, %) nas pesquisas do 2º turno feitas depois do 1º turno com campo terminado antes do dia do debate (18/10).
	measure 'T07 · antes · Flávio' =
			VAR _d = [T07 · debate · data]
			RETURN
			    CALCULATE (
			        AVERAGE ( Pesquisa[Flavio] ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        Pesquisa[Momento] = "apos_1turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo fim] < _d
			    )
		formatString: 0.0
		displayFolder: T07 Debate\Contas
		lineageTag: 11a5ebab-84ec-5b0b-a18b-59f7a5bad1ad

	/// Média simples de Lula (votos totais, %) nas pesquisas do 2º turno feitas depois do 1º turno com campo terminado antes do dia do debate (18/10).
	measure 'T07 · antes · Lula' =
			VAR _d = [T07 · debate · data]
			RETURN
			    CALCULATE (
			        AVERAGE ( Pesquisa[Lula] ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        Pesquisa[Momento] = "apos_1turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo fim] < _d
			    )
		formatString: 0.0
		displayFolder: T07 Debate\Contas
		lineageTag: 73505f21-ba56-5be3-91a7-6a8b6d51faa4

	/// Quantas pesquisas do 2º turno (votos totais, depois do 1º turno) tiveram campo terminado antes do dia do debate.
	measure 'T07 · antes · pesquisas' =
			VAR _d = [T07 · debate · data]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Pesquisa ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        Pesquisa[Momento] = "apos_1turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo fim] < _d
			    ) + 0
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: b01dc5af-22b4-552a-9177-e090c1000c5d

	/// Primeiro último-dia-de-campo entre as pesquisas da janela 'antes' (a extensão da linha da média no gráfico).
	measure 'T07 · antes · primeiro campo' =
			VAR _d = [T07 · debate · data]
			RETURN
			    CALCULATE (
			        MIN ( Pesquisa[Campo fim] ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        Pesquisa[Momento] = "apos_1turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo fim] < _d
			    )
		formatString: dd/MM
		displayFolder: T07 Debate\Contas
		lineageTag: dce91232-4d41-58c0-9f69-c538ebf72f54

	/// Último último-dia-de-campo entre as pesquisas da janela 'antes' (a extensão da linha da média no gráfico).
	measure 'T07 · antes · último campo' =
			VAR _d = [T07 · debate · data]
			RETURN
			    CALCULATE (
			        MAX ( Pesquisa[Campo fim] ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        Pesquisa[Momento] = "apos_1turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo fim] < _d
			    )
		formatString: dd/MM
		displayFolder: T07 Debate\Contas
		lineageTag: a1713f16-a904-5a97-808b-2bceadee8fa0

	/// Quantas pesquisas do 2º turno (votos totais, depois do 1º turno) tiveram o campo atravessando o dia do debate (fora das médias), entre as que terminaram antes do debate seguinte (Globo, 23/10).
	measure 'T07 · atravessa · pesquisas' =
			VAR _d = [T07 · debate · data]
			VAR _g = [T07 · debate seguinte · data]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Pesquisa ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        Pesquisa[Momento] = "apos_1turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo fim] >= _d,
			        Pesquisa[Campo início] <= _d,
			        Pesquisa[Campo fim] < _g || ISBLANK ( _g )
			    ) + 0
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: 533409d3-b365-551e-9377-b6cd041a601a

