	/// Nome do recorte, da medida comum [Recorte · nome]: 'Brasil', o estado ('Bahia'), a região inteira ('Nordeste') ou vários estados ('MG e SP', '3 estados').
	measure 'T06 · recorte' =
			[Recorte · nome]
		displayFolder: T06 Ausência\Contas
		lineageTag: 498eceff-2ea9-55c3-9e44-b29cb78d93d8

	/// Variação da abstenção de 2006 para 2026, em pontos percentuais.
	measure 'T06 · variação da abstenção em p.p.' =
			( [T06 · abstenção %] - [T06 · abstenção % 2006] ) * 100
		formatString: 0.0
		displayFolder: T06 Ausência\Contas
		lineageTag: 0ae0f95f-fb94-5384-bbb0-02fb5fb18f4d

	/// Quem teve mais votos no recorte em 2026: Flávio ou Lula.
	measure 'T06 · vencedor' =
			IF (
			    CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 13 )
			        > CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 22 ),
			    "Lula",
			    "Flávio"
			)
		displayFolder: T06 Ausência\Contas
		lineageTag: 15cb2a7e-1cb3-53d4-bebd-f8f301b1e1e5

	/// Quantas vezes a diferença entre Flávio e Lula cabe nas abstenções de 2026, no recorte.
	measure 'T06 · vezes a diferença' =
