	/// Nomes das UFs em que a margem de Lula subiu, em ordem alfabética.
	measure 'T12 · onde a margem subiu' =
			CALCULATE (
			    CONCATENATEX (
			        FILTER ( VALUES ( 'UF'[Nome] ), [T12 · variação] > 0 ),
			        'UF'[Nome],
			        ", ",
			        'UF'[Nome], ASC
			    ),
			    REMOVEFILTERS ( 'UF' ),
			    'UF'[Tipo] = "UF"
			)
		displayFolder: T12 Estados\Contas
		lineageTag: f226e7f7-8c8d-5691-ba35-45470736a48f

	/// Posição da UF entre as 27 pela queda da margem (1 = a que mais caiu). Exterior fica vazio.
	measure 'T12 · ordem da queda' =
			VAR _v = [T12 · variação]
			RETURN
			    IF (
			        NOT ISBLANK ( _v ) && SELECTEDVALUE ( 'UF'[Tipo] ) = "UF",
			        COUNTROWS ( FILTER ( ALL ( 'UF' ), 'UF'[Tipo] = "UF" && [T12 · variação] < _v ) ) + 1
			    )
		formatString: 0
		displayFolder: T12 Estados\Contas
		lineageTag: 4ce8b622-dc07-5b70-8181-55b01e6cc9ac

	/// Posição da região da linha entre as cinco pela variação da margem (1 = a maior queda); posiciona a linha. Percorre Região e RegiaoOrdem juntas: o Power BI põe a coluna de ordenação no grão do visual, e ALL só da Região deixava todas as regiões em 1º (as cinco linhas uma sobre a outra no Desktop).
	measure 'T12 · ordem da região' =
			VAR _r = [T12 · região da unidade]
			RETURN
			    IF (
			        NOT ISBLANK ( _r ) && _r <> "Exterior",
			        RANKX (
			            FILTER ( ALL ( 'UF'[Região], 'UF'[RegiaoOrdem] ), 'UF'[Região] <> "Exterior" ),
			            [T12 · variação],
			            ,
			            ASC,
			            DENSE
			        )
			    )
		formatString: 0
		displayFolder: T12 Estados\Contas
		lineageTag: 4460913f-c09f-566a-8c7a-462adf791228

