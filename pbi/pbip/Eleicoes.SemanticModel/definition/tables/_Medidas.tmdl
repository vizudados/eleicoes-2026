	/// Posição do município na lista das maiores que viraram (1 = a mais populosa entre as que a lista mostra: o Top 6 do visual, dentro do recorte e da seleção do mapa).
	measure 'T11 · posição entre as maiores que viraram' =
			IF (
			    HASONEVALUE ( 'Município'[CodIBGE] ) && NOT ISBLANK ( [T11 · população das que viraram] ),
			    RANKX ( ALLSELECTED ( 'Município'[CodIBGE] ), [T11 · população das que viraram], , DESC, SKIP )
			)
		formatString: 0
		displayFolder: T11 Virada\Contas
