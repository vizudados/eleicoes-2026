	/// Média simples de Flávio (votos totais, %) nas pesquisas do 2º turno feitas depois do 1º turno com campo começado depois do dia do debate (18/10) e terminado antes do debate seguinte (Globo, 23/10): a que chega ao dia da Globo já pegou os dois debates e fica fora.
	measure 'T07 · depois · Flávio' =
			VAR _d = [T07 · debate · data]
			VAR _g = [T07 · debate seguinte · data]
			RETURN
			    CALCULATE (
			        AVERAGE ( Pesquisa[Flavio] ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        Pesquisa[Momento] = "apos_1turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo início] > _d,
			        Pesquisa[Campo fim] < _g || ISBLANK ( _g )
			    )
		formatString: 0.0
		displayFolder: T07 Debate\Contas
		lineageTag: 0294f4ef-ef4d-5074-b140-2ba7103cc5a8

	/// Média simples de Lula (votos totais, %) nas pesquisas do 2º turno feitas depois do 1º turno com campo começado depois do dia do debate (18/10) e terminado antes do debate seguinte (Globo, 23/10): a que chega ao dia da Globo já pegou os dois debates e fica fora.
