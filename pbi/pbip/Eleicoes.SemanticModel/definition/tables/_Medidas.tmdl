	/// Hora prevista para o fim (o Jornal da Globo, 23h30; a Globo não informou o fim).
	measure 'T26 · debate · fim previsto' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Previsto] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "fim" )
		formatString: dd/MM/yyyy HH:mm
