	/// Margem do PT em 2006: (votos do PT − votos do adversário principal) ÷ votos válidos, no contexto (um município na linha da lista e no ponto da dispersão; o recorte inteiro no resumo). Vazio sem votos no ano.
	measure 'T19 · margem 2006' =
			VAR _pt =
			    CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2006 )
			VAR _adv =
			    CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2006 )
			VAR _val =
			    CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2006 )
			RETURN
			    DIVIDE ( _pt - _adv, _val )
		formatString: 0.0%
		displayFolder: T19 Explorador\Contas
		lineageTag: fd0ce77a-9f23-5918-8c7f-53d2dde1a6e6

