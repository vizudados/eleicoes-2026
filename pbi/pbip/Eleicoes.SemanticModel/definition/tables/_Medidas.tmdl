	/// Maior afastamento do zero (margem de 2022 ou 2026) entre as cidades da lista; escala comum dos mini gráficos.
	measure 'T11 · escala das maiores' =
			MAXX (
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( 'Município'[CodIBGE] ),
			            "@p", [T11 · população das que viraram],
			            "@a", MAX ( ABS ( [T11 · margem 2022] ), ABS ( [T11 · margem 2026] ) )
			        ),
			        NOT ISBLANK ( [@p] )
			    ),
			    [@a]
			)
		formatString: 0.0%
		displayFolder: T11 Virada\Contas
		lineageTag: 232485d1-f7a3-5e71-8cdf-5b49a4698198

	/// Municípios com Flávio à frente em 2026. Conta município a município no recorte.
	measure 'T11 · Flávio à frente em 2026' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			        VAR _d26 = [T11 · saldo 2026]
			        RETURN
			            IF ( _d26 < 0, 1 )
