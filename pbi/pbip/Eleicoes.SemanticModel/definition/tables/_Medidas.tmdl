	/// 1 quando o filtro da tela tem uma escolha (cidade ou escola): o ponto vermelho da pílula.
	measure 'T20 · filtro em uso' =
			IF ( ISFILTERED ( 'T20 Filtro' ), 1, 0 )
		formatString: 0
		displayFolder: T20 Escola\Contas
