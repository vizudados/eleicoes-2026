	/// Data do frente a frente seguinte ao da Band: a menor data da tabela Debate com Lula e Flávio entre os participantes, depois do debate da Band (a Globo, 23/10). Fecha a janela 'depois' das pesquisas da tela: a pesquisa que termina nesse dia ou depois já pegou o debate seguinte e fica fora (é da tela do debate da Globo). Vazio enquanto a tabela não tiver esse debate, e aí não há limite.
	measure 'T07 · debate seguinte · data' =
			VAR _band = [T07 · debate · data]
			RETURN
			    CALCULATE (
			        MIN ( Debate[Data] ),
			        REMOVEFILTERS ( Debate ),
			        Debate[Data] > _band,
			        CONTAINSSTRING ( Debate[Participantes], "Lula" ),
			        CONTAINSSTRING ( Debate[Participantes], "Flávio" )
			    )
		formatString: dd/MM
		displayFolder: T07 Debate\Contas
		lineageTag: efb175e6-7b69-572e-9751-c9c479e1637e

	/// Emissora do frente a frente seguinte ao da Band (T07 · debate seguinte · data): a Globo. Vazio enquanto a tabela Debate não tiver esse debate.
	measure 'T07 · debate seguinte · emissora' =
			VAR _g = [T07 · debate seguinte · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _g ),
			        CALCULATE ( MAX ( Debate[Emissora] ), REMOVEFILTERS ( Debate ), Debate[Data] = _g )
			    )
		displayFolder: T07 Debate\Contas
		lineageTag: 35d6b42c-5755-50a2-a0ab-fdd1549668d3

	/// Quem faltou ao debate da linha.
	measure 'T07 · debate · ausentes' =
			IF ( HASONEVALUE ( Debate[Data] ), SELECTEDVALUE ( Debate[Ausentes] ) )
		displayFolder: T07 Debate\Contas
		lineageTag: acf9f1b9-8c3e-5649-ba75-3a15d44db1c4

	/// Data do debate da Band no 2º turno, o primeiro frente a frente de Lula e Flávio, de que a tela fala. Regra explícita e neutra (24/10/2026): a linha da tabela Debate com Emissora = "Band" e Turno = 2. Não usa o MAX(Data) das linhas com os dois nos participantes: com o debate da Globo (23/10) na tabela, esse máximo passaria a ser a Globo.
	measure 'T07 · debate · data' =
			CALCULATE (
			    MAX ( Debate[Data] ),
			    REMOVEFILTERS ( Debate ),
			    Debate[Emissora] = "Band",
			    Debate[Turno] = 2
			)
		formatString: dd/MM
		displayFolder: T07 Debate\Contas
		lineageTag: 72b6bf18-736e-564c-9282-6c4e3e3f9ed8

	/// Data do debate da linha.
	measure 'T07 · debate · dia' =
			IF ( HASONEVALUE ( Debate[Data] ), SELECTEDVALUE ( Debate[Data] ) )
		formatString: dd/MM
		displayFolder: T07 Debate\Contas
		lineageTag: e83d1c82-5caa-5d66-a921-3451ab8de5ce

	/// Emissora ou pool do debate da linha.
	measure 'T07 · debate · emissora' =
			IF ( HASONEVALUE ( Debate[Data] ), SELECTEDVALUE ( Debate[Emissora] ) )
		displayFolder: T07 Debate\Contas
		lineageTag: 080586fe-d4c3-5cd2-a10a-35d4a67adc68

	/// Sim quando Lula e Flávio participaram do debate da linha; Não nos outros.
	measure 'T07 · debate · frente a frente' =
			VAR _p = SELECTEDVALUE ( Debate[Participantes] )
			RETURN
			    IF (
			        HASONEVALUE ( Debate[Data] ),
			        IF ( CONTAINSSTRING ( _p, "Lula" ) && CONTAINSSTRING ( _p, "Flávio" ), "Sim", "Não" )
			    )
		displayFolder: T07 Debate\Contas
		lineageTag: d2211283-bad9-5d46-bf0c-45aefa9d52cf

	/// Quem mediou o debate da linha.
	measure 'T07 · debate · mediação' =
			IF ( HASONEVALUE ( Debate[Data] ), SELECTEDVALUE ( Debate[Mediação] ) )
		displayFolder: T07 Debate\Contas
		lineageTag: 81506e4f-f1e8-567a-a87a-a826ac143cee

	/// Por que o debate da linha não aconteceu: primeira nota da Observação do levantamento; vazio quando aconteceu.
	measure 'T07 · debate · motivo' =
			VAR _obs = SELECTEDVALUE ( Debate[Observação] )
			VAR _cab = TRIM ( IF ( CONTAINSSTRING ( _obs, "|" ), LEFT ( _obs, SEARCH ( "|", _obs ) - 1 ), _obs ) )
			RETURN
			    IF ( [T07 · debate · situação] <> "realizado", _cab )
		displayFolder: T07 Debate\Contas
		lineageTag: 5d9ba7aa-710d-527f-8367-4efe086a2574

	/// Sim quando a linha do contexto (grão Debate[Data]) é o debate da Band no 2º turno, o da tela (T07 · debate · data); Não nas outras. O palco e o dossiê do palco só desenham essa linha: com a Globo, a tabela tem dois frente a frente.
	measure 'T07 · debate · o da Band' =
			IF (
			    HASONEVALUE ( Debate[Data] ),
			    IF ( SELECTEDVALUE ( Debate[Data] ) = [T07 · debate · data], "Sim", "Não" )
			)
		displayFolder: T07 Debate\Contas
		lineageTag: 805afa81-28b8-5e15-a1d0-67eb2c462729

	/// Posição do debate da linha na ordem das datas (1 = o primeiro marcado, 23/08).
	measure 'T07 · debate · ordem' =
			VAR _dia = SELECTEDVALUE ( Debate[Data] )
			RETURN
			    IF (
			        HASONEVALUE ( Debate[Data] ),
			        CALCULATE ( COUNTROWS ( Debate ), REMOVEFILTERS ( Debate ), Debate[Data] <= _dia )
			    )
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: 65a4bf0b-2d57-5a9a-af93-819197f3d17a

	/// Quem participou do debate da linha.
	measure 'T07 · debate · participantes' =
			IF ( HASONEVALUE ( Debate[Data] ), SELECTEDVALUE ( Debate[Participantes] ) )
		displayFolder: T07 Debate\Contas
		lineageTag: d5290b49-c8a8-5b5d-b67e-8a751a8fd133

	/// Situação do debate da linha: realizado, cancelado ou não realizado (começo da Observação do levantamento).
	measure 'T07 · debate · situação' =
			VAR _obs = UPPER ( SELECTEDVALUE ( Debate[Observação] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( Debate[Data] ), BLANK (),
			        LEFT ( _obs, 9 ) = "CANCELADO", "cancelado",
			        LEFT ( _obs, 13 ) = "NÃO REALIZADO", "não realizado",
			        "realizado"
			    )
		displayFolder: T07 Debate\Contas
		lineageTag: d004f794-5c76-5ccf-9f78-139dc807ecfa

	/// Turno do debate da linha.
	measure 'T07 · debate · turno' =
