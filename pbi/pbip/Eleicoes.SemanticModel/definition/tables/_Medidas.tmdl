		formatString: 0.0%
		displayFolder: T06 Ausência\Contas
		lineageTag: f9fb94ba-30ad-53ff-b78a-877db1d83600

	/// Abstenções + brancos + nulos no ano do contexto (Brasil oficial ou soma dos municípios da UF): quem não escolheu nenhum candidato.
	measure 'T06 · não escolheram (ano)' =
			[T06 · abstenções (ano)] + [T06 · brancos (ano)] + [T06 · nulos (ano)]
		formatString: #,0
		displayFolder: T06 Ausência\Contas
