	/// Margem do PT no ano do contexto: (votos do PT − votos do adversário principal) ÷ válidos, somados no contexto (um município no ponto do mapa).
	measure 'T21 · margem' =
			DIVIDE (
			    SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ),
			    SUM ( 'Município ano'[Validos] )
			)
		formatString: 0.0%
		displayFolder: T21 20 anos\Contas
		lineageTag: 260ba9a5-b9cf-5e5e-b3ff-b6be01a64121

