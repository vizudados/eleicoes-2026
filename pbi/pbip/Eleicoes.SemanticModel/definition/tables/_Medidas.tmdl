	/// Sim quando o instituto da pesquisa clicada na curva tem quadrinho de rejeição (mediu Lula e Flávio antes e depois do 1º turno com pergunta comparável), Não quando não tem; vazio sem clique num ponto.
	measure 'T17 · foco · pesquisa com quadrinho' =
			VAR _inst = [T17 · foco · instituto da pesquisa]
			RETURN
			    IF (
			        NOT ISBLANK ( _inst ),
			        VAR _ok =
			            CALCULATE (
			                [T17 · rejeição · comparável],
			                REMOVEFILTERS ( 'Rejeição' ),
			                'Rejeição'[Instituto] = _inst
			            )
			        RETURN
			            IF ( _ok = "Sim", "Sim", "Não" )
			    )
		displayFolder: T17 2º turno\Contas
		lineageTag: 8970604f-1512-5b47-aec9-bc592a8fcc6d

	/// Média de Flávio − Lula (pontos, votos totais) nas pesquisas de 2º turno divulgadas nos 10 dias até o dia do contexto (d−10, d], só do mesmo momento (não atravessa o 1º turno) e só com 3 pesquisas ou mais na janela.
	measure 'T17 · média móvel' =
			VAR _d = MAX ( Pesquisa[Divulgação] )
			VAR _m = [T17 · dia · momento]
			VAR _t =
			    CALCULATETABLE (
			        Pesquisa,
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Momento] = _m,
			        Pesquisa[Divulgação] > _d - 10,
			        Pesquisa[Divulgação] <= _d
			    )
			RETURN
			    IF ( NOT ISBLANK ( _m ) && COUNTROWS ( _t ) >= 3, AVERAGEX ( _t, Pesquisa[Flavio] - Pesquisa[Lula] ) )
		formatString: +0.0;-0.0;0.0
		displayFolder: T17 2º turno\Contas
		lineageTag: e4f93a4c-f1d5-5bdd-b50b-3b0e1b572a2a

	/// Média móvel no último dia com pesquisa (Flávio − Lula; positivo = Flávio à frente).
	measure 'T17 · média móvel · agora' =
			VAR _d = [T17 · média móvel · último dia]
			RETURN
			    CALCULATE ( [T17 · média móvel], REMOVEFILTERS ( Pesquisa ), Pesquisa[Divulgação] = _d )
		formatString: +0.0;-0.0;0.0
		displayFolder: T17 2º turno\Contas
		lineageTag: 2be7e577-3288-50f6-a5ae-94b59e4bd8af

	/// Média móvel no dia da virada.
	measure 'T17 · média móvel · na virada' =
			VAR _d = [T17 · média móvel · virada]
			RETURN
			    CALCULATE ( [T17 · média móvel], REMOVEFILTERS ( Pesquisa ), Pesquisa[Divulgação] = _d )
		formatString: +0.0;-0.0;0.0
		displayFolder: T17 2º turno\Contas
		lineageTag: 55817551-153a-5d8d-a414-2f323f8896e6

	/// Média móvel no primeiro dia em que ela existe (Flávio − Lula; negativo = Lula à frente).
	measure 'T17 · média móvel · no começo' =
			VAR _d = [T17 · média móvel · primeiro dia]
			RETURN
			    CALCULATE ( [T17 · média móvel], REMOVEFILTERS ( Pesquisa ), Pesquisa[Divulgação] = _d )
		formatString: +0.0;-0.0;0.0
		displayFolder: T17 2º turno\Contas
		lineageTag: af18bc34-8af9-57d8-9adb-262fde630060

	/// Primeiro dia de divulgação em que a média móvel existe (3 pesquisas na janela).
	measure 'T17 · média móvel · primeiro dia' =
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Divulgação] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@mm", [T17 · média móvel]
			    )
			RETURN
			    MINX ( FILTER ( _dias, NOT ISBLANK ( [@mm] ) ), Pesquisa[Divulgação] )
		formatString: dd/MM
		displayFolder: T17 2º turno\Contas
		lineageTag: 2862d147-1647-57fa-8cf6-8009164fc1d9

	/// Primeiro dia em que a média móvel passou a dar Flávio à frente (> 0) e não voltou mais para Lula até o último dia.
	measure 'T17 · média móvel · virada' =
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Divulgação] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@mm", [T17 · média móvel]
			    )
			VAR _comMM = FILTER ( _dias, NOT ISBLANK ( [@mm] ) )
			VAR _ultimoLula = MAXX ( FILTER ( _comMM, [@mm] <= 0 ), Pesquisa[Divulgação] )
			RETURN
			    MINX ( FILTER ( _comMM, [@mm] > 0 && Pesquisa[Divulgação] > _ultimoLula ), Pesquisa[Divulgação] )
		formatString: dd/MM
		displayFolder: T17 2º turno\Contas
		lineageTag: 77972503-e2ec-52cb-b272-8681c71243d9

	/// Último dia de divulgação com média móvel.
	measure 'T17 · média móvel · último dia' =
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Divulgação] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@mm", [T17 · média móvel]
			    )
			RETURN
			    MAXX ( FILTER ( _dias, NOT ISBLANK ( [@mm] ) ), Pesquisa[Divulgação] )
		formatString: dd/MM
		displayFolder: T17 2º turno\Contas
		lineageTag: e8bc71eb-a346-51e7-9661-e430fe8a3349

	/// 1 quando o período escolhido começa depois da última divulgação do levantamento (22/10) e não tem pesquisa: os números ainda não chegaram (Depois da Globo); 0 nos outros; vazio sem período.
	measure 'T17 · período · ainda sem dado' =
			VAR _de = [T17 · período · campo de]
			VAR _ult = [T17 · média móvel · último dia]
			RETURN
			    IF (
			        NOT ISBLANK ( _de ),
			        IF ( _de > _ult && [T17 · período · pesquisas] = 0, 1, 0 )
			    )
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: 798b0f80-8438-5e04-b167-ec4f81c24029

	/// Pesquisas de 2º turno (votos totais) com o campo atravessando o dia do debate de referência do período escolhido (começou nele ou antes e terminou nele ou depois): ficam fora de qualquer período, como na T07. Vazio sem período.
	measure 'T17 · período · atravessam o debate' =
			VAR _deb = [Período · debate · data]
			RETURN
			    IF (
			        NOT ISBLANK ( [Período · escolhido] ),
			        CALCULATE (
			            COUNTROWS ( Pesquisa ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Campo início] <= _deb,
			            Pesquisa[Campo fim] >= _deb
			        ) + 0
			    )
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: 10ec314b-d958-5437-a9d3-73863f120ed5

	/// Último dia em que o campo de uma pesquisa pode terminar para entrar no período escolhido (o fim do período). Vazio sem período.
	measure 'T17 · período · campo até' =
			IF ( NOT ISBLANK ( [Período · escolhido] ), [Período · fim] )
		formatString: dd/MM
		displayFolder: T17 2º turno\Contas
		lineageTag: c6c60754-7329-58eb-84be-41d673532bb7

	/// Primeiro dia em que o campo de uma pesquisa pode começar para entrar no período escolhido: o início do período; no período 'depois', o dia seguinte ao debate (a pesquisa com campo no dia do debate atravessa o debate e fica fora, a regra da T07). Vazio sem período.
	measure 'T17 · período · campo de' =
			VAR _ini = [Período · início]
			VAR _deb = [Período · debate · data]
			RETURN
			    IF (
			        NOT ISBLANK ( [Período · escolhido] ),
			        IF ( [Período · lado] = "depois", MAX ( _ini, _deb + 1 ), _ini )
			    )
		formatString: dd/MM
		displayFolder: T17 2º turno\Contas
		lineageTag: 5e18f744-0952-5f3c-b4e9-b355b293e3e8

