	/// Lula sobre os válidos no Brasil em 2026, com o exterior.
	measure 'T12 · Lula % do Brasil 2026' =
			CALCULATE ( [T12 · Lula % 2026], REMOVEFILTERS ( 'UF' ) )
		formatString: 0.0%
