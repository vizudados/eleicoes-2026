	/// Reais gastos em anúncios pela página de Flávio na Meta (Facebook e Instagram), 2026-10-13 a 2026-10-19 (7 dias), segundo o Relatório da Biblioteca de Anúncios. Não se soma aos pagamentos declarados ao TSE (outra base).
	measure 'T09 · Meta · 7 dias · Flávio' =
			CALCULATE (
			    SUM ( 'Anúncios'[Valor] ),
			    REMOVEFILTERS ( 'Anúncios' ),
			    'Anúncios'[Anunciante] = "Flávio Bolsonaro (página 'Flavio Bolsonaro', rótulo da campanha)",
			    'Anúncios'[Plataforma] = "Meta (Facebook/Instagram)",
			    'Anúncios'[Período] = "2026-10-13 a 2026-10-19 (7 dias)"
			)
		formatString: #,0
