	/// Último dia de campo da última pesquisa do instituto clicado que terminou antes do debate (janela 'antes'); vazio se ele não fez nenhuma.
	measure 'T07 · escolha · antes · data' =
			VAR _inst = [T07 · escolha · instituto]
			VAR _d = [T07 · debate · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _inst ),
			        CALCULATE (
			            MAX ( Pesquisa[Campo fim] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
