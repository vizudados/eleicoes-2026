	/// Parte (%) das buscas de Flávio entre os dois na UF da linha. Sem período: o 2º turno inteiro (05 a 22/10, consulta G2, tópicos), como sempre. Com um período escolhido: a soma dos índices diários da consulta U2 do estado nos dias do período, em % arredondado (cada um arredonda o seu); vazio no período sem dado (Depois da Globo).
	measure 'T08 · UF · Flávio' =
			VAR _per = [Período · escolhido]
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        -- 2º turno inteiro: consulta G2
			        IF (
			            HASONEVALUE ( UF[UF] ),
			            CALCULATE (
			                MAX ( 'Trends UF'[Índice] ),
			                'Trends UF'[Série] = "Flávio Bolsonaro [tópico] % das buscas entre os 2 comparados"
			            )
			        ),
			        -- período escolhido: consulta U2 do estado, dia a dia
			        VAR _a = [T08 · UF · período · soma Flávio]
			        VAR _b = [T08 · UF · período · soma Lula]
			        RETURN
			            IF ( NOT ISBLANK ( _a ) && _a + _b > 0, ROUND ( 100 * _a / ( _a + _b ), 0 ) )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 396bcd8f-8315-5d82-8ba4-ec70a31e97ad

	/// Parte (%) das buscas de Flávio entre os 5 candidatos na UF da linha, no período todo (01/08 a 22/10, consulta T2).
