	/// Em cada 10 que não escolheram ninguém em 2026, quantos nem foram votar (arredondado), no recorte.
	measure 'T06 · faltaram entre quem não escolheu · em cada 10 · 2026' =
			CALCULATE ( ROUND ( [T06 · faltaram entre quem não escolheu (ano)] * 10, 0 ), 'Ano'[Ano] = 2026 )
		formatString: 0
		displayFolder: T06 Ausência\Contas
		lineageTag: 72083551-91a7-5171-892f-97152c23c022

	/// A maior soma de quem não escolheu ninguém entre os seis anos, no recorte: a escala das colunas da composição.
	measure 'T06 · maior não escolheram da série' =
			MAXX (
			    CALCULATETABLE ( VALUES ( 'Ano'[Ano] ), REMOVEFILTERS ( 'Ano' ) ),
			    VAR _a = 'Ano'[Ano]
			    RETURN
			        CALCULATE ( [T06 · não escolheram (ano)], 'Ano'[Ano] = _a )
			)
		formatString: #,0
		displayFolder: T06 Ausência\Contas
