	/// Texto para leitor de tela da camada de alvos do quadro 'onde foi o erro'.
	measure 'T10 · Erro alvos · ALT' =
			"Passe o mouse na linha de Lula ou na de Flávio para ver quanto cada instituto com votos válidos deu a ele na véspera."
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 97497d76-f481-5688-b069-c6946e4c88d6

	/// Camada de alvos do quadro 'onde foi o erro' (grão 'Candidato ano'[Partido]: PT = Lula, PL = Flávio): uma faixa transparente sobre a linha de cada um, que abre o dossiê ttT10Erro com os institutos um a um. Vazia nos outros partidos e quando o instituto clicado divulgou votos totais (o quadro mostra só a diferença).
	measure 'T10 · Erro alvos · HTML' =
			-- 1 · Leituras
			VAR _c = [T10 · erro · candidato]
			VAR _inst = [T10 · escolha · instituto]
			VAR _base = [T10 · instituto · base]
			-- 2 · Textos
			VAR _ok = NOT ISBLANK ( _c ) && ( ISBLANK ( _inst ) || _base = "validos" )
			-- 3 · Geometria (o svg do quadro começa em y 96; linha de Lula em 34, de Flávio em 132; a faixa pega o rótulo de baixo)
			VAR _top = IF ( _c = "Lula", 96 + 34 - 30, 96 + 132 - 30 ) -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _ok,
			        "<div class='tela t10a'><div class='alvo' style='top:" & _top & "px'></div></div>"
			    )
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: c6b7f113-89d0-5572-8a98-ba8eb3b19d94

	/// Texto para leitor de tela do quadro 'onde foi o erro' (a média ou o instituto clicado na régua).
	measure 'T10 · Erro · ALT' =
			VAR _inst = [T10 · escolha · instituto]
			VAR _base = [T10 · instituto · base]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _inst ),
			            "Média de " & [T10 · institutos · com válidos] & " institutos com votos válidos contra a urna: Lula "
			                & FORMAT ( [T10 · válidos · média Lula], "0.0" ) & "% nas pesquisas e " & FORMAT ( [T10 · urna · Lula], "0.0" )
			                & "% na urna; Flávio " & FORMAT ( [T10 · válidos · média Flávio], "0.0" ) & "% e " & FORMAT ( [T10 · urna · Flávio], "0.0" )
			                & "%. Erro médio de " & FORMAT ( ABS ( [T10 · válidos · erro médio] ), "0.0" ) & " pontos a favor de Lula.",
			        _base = "validos",
			            _inst & " contra a urna, votos válidos: Lula " & FORMAT ( [T10 · instituto · Lula], "0.0" ) & "% na pesquisa e "
			                & FORMAT ( [T10 · urna · Lula], "0.0" ) & "% na urna; Flávio " & FORMAT ( [T10 · instituto · Flávio], "0.0" )
			                & "% e " & FORMAT ( [T10 · urna · Flávio], "0.0" ) & "%.",
			        _inst & " divulgou votos totais: diferença de " & FORMAT ( [T10 · instituto · diferença], "0.0" )
			            & " pontos (Flávio − Lula) na pesquisa e " & FORMAT ( [T10 · urna · diferença], "0.0" ) & " na urna."
			    )
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 727c584d-5b8b-5aca-b350-261b522ee584

	/// Onde foi o erro. Sem clique: a média de Lula e de Flávio nas últimas pesquisas com votos válidos contra a urna, numa régua de 38% a 50% (círculo vazio = pesquisas, cheio = urna; a seta se desenha quando erraram), o erro médio da diferença e a explicação de válidos × totais. Com um instituto clicado na régua (filtro cruzado de Pesquisa[Instituto]): a última pesquisa dele contra a urna — nos válidos, Lula e Flávio um a um; nos totais, só a diferença entre os dois, na régua de −8 a +4. Só lê as contas 'T10 · …'.
	measure 'T10 · Erro · HTML' =
			-- 1 · Leituras
			VAR _inst = [T10 · escolha · instituto]
			VAR _base = [T10 · instituto · base]
			VAR _uL = [T10 · urna · Lula]
			VAR _uF = [T10 · urna · Flávio]
			VAR _uDif = [T10 · urna · diferença]
			VAR _nV = [T10 · institutos · com válidos]
			VAR _data = [T10 · instituto · última divulgação]
			VAR _iDif = [T10 · instituto · diferença]
			VAR _iDist = [T10 · instituto · distância da urna]
			VAR _modo = IF ( ISBLANK ( _inst ), "media", IF ( _base = "validos", "valido", "total" ) )
			VAR _pL = IF ( _modo = "media", [T10 · válidos · média Lula], [T10 · instituto · Lula] )
			VAR _pF = IF ( _modo = "media", [T10 · válidos · média Flávio], [T10 · instituto · Flávio] )
			VAR _eL = IF ( _modo = "media", [T10 · válidos · erro Lula], [T10 · instituto · erro Lula] )
			VAR _eF = IF ( _modo = "media", [T10 · válidos · erro Flávio], [T10 · instituto · erro Flávio] )
			VAR _eM = IF ( _modo = "media", [T10 · válidos · erro médio], [T10 · instituto · erro vs urna] )
			-- 2 · Textos
			VAR _escInst = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _plural = _modo = "media"
			VAR _quemPesq = IF ( _plural, "pesquisas", "pesquisa" )
			VAR _okL = ABS ( _eL ) < 0.5
			VAR _okF = ABS ( _eF ) < 0.5
			VAR _acertou = IF ( _plural, "acertaram", "acertou" )
			VAR _errou = IF ( _plural, "erraram", "errou" )
			VAR _sujeito = IF ( _plural, "As pesquisas", _escInst )
			VAR _txtSob =
			    "Onde foi o erro · " & IF ( _plural, "média de " & _nV & " institutos", _escInst ) & " × urna"
			VAR _txtMan =
			    SWITCH (
			        TRUE (),
			        _modo = "total", _escInst & " divulgou votos totais: a comparação justa é a diferença",
			        _okL && NOT _okF, _sujeito & " " & _acertou & " o número de Lula e " & _errou & " o de Flávio",
			        _okF && NOT _okL, _sujeito & " " & _acertou & " o número de Flávio e " & _errou & " o de Lula",
			        _okL && _okF, _sujeito & " " & _acertou & " os dois números",
			        _sujeito & " " & _errou & " os dois números"
			    )
			VAR _pts = IF ( ROUND ( ABS ( _eM ), 1 ) < 2, " ponto", " pontos" )
			VAR _txtEM =
			    IF (
			        ABS ( _eM ) < 0.5,
			        "ficou a " & FORMAT ( ABS ( _eM ), "0.0" ) & " ponto do resultado",
			        FORMAT ( ABS ( _eM ), "0.0" ) & _pts & " a favor de " & IF ( _eM < 0, "Lula", "Flávio" )
			    )
			VAR _quemDif = IF ( _iDif > 0, "Flávio", IF ( _iDif < 0, "Lula", "" ) )
			VAR _txtLead =
			    IF ( _quemDif = "", "Dava empate", "Dava " & _quemDif & " " & FORMAT ( ABS ( _iDif ), "0.0" ) & " à frente" )
			VAR _quemUrna = IF ( _uDif >= 0, "Flávio", "Lula" )
			VAR _txt =
			    SWITCH (
			        _modo,
			        "media", "Erro médio na diferença: " & _txtEM & ".",
			        "valido", "Na diferença entre os dois, " & IF ( ABS ( _eM ) < 0.5, _txtEM, "errou " & _txtEM ) & ".",
			        _txtLead & "; a urna deu " & _quemUrna & " " & FORMAT ( ABS ( _uDif ), "0.0" ) & "."
			    )
			VAR _expl =
			    SWITCH (
			        _modo,
			        "media", "Só entram os institutos que divulgaram votos válidos: sem brancos, nulos e indecisos, como a urna conta.",
			        "valido", "Última pesquisa do instituto antes da urna, divulgada em " & FORMAT ( _data, "dd/MM" )
			            & ", em votos válidos. Clique de novo no nome para voltar à média.",
			        "Votos totais contam brancos, nulos e indecisos: só a diferença se compara com a urna. Clique de novo no "
			            & "nome para voltar à média."
			    )
			-- 3 · Geometria (régua de 38% a 50% em x 90–520, 35,83 px por ponto; Lula em y 34, Flávio em y 132; na base de
			--     votos totais, a régua da diferença de −8 a +4 com a mesma escala, linha em y 84; o svg começa em y 96)
			VAR _k = 430 / 12 -- geometria
			VAR _f = "0.0"
			VAR _xpL = 90 + ( _pL - 38 ) * _k -- geometria
			VAR _xuL = 90 + ( _uL - 38 ) * _k -- geometria
			VAR _xpF = 90 + ( _pF - 38 ) * _k -- geometria
			VAR _xuF = 90 + ( _uF - 38 ) * _k -- geometria
			VAR _xd = 90 + ( _iDif + 8 ) * _k -- geometria
			VAR _xu = 90 + ( _uDif + 8 ) * _k -- geometria
			VAR _ticks =
			    CONCATENATEX (
			        { 40, 45, 50 },
			        "<text x='" & FORMAT ( 90 + ( [Value] - 38 ) * _k, _f, "en-US" ) & "' y='188' class='ex' text-anchor='middle'>"
			            & [Value] & "%</text>",
			        ""
			    )
			-- uma linha da régua de válidos: rótulo, trilho, urna (cheio), pesquisa (vazio), seta e rótulos dos números
			VAR _linhaL =
			    VAR _xa = _xpL
			    VAR _xb = _xuL
			    VAR _s = IF ( _xb >= _xa, 1, -1 )
			    VAR _perto = ABS ( _xb - _xa ) < 125
			    RETURN
			        "<circle cx='" & FORMAT ( _xb, _f, "en-US" ) & "' cy='34' r='10' style='fill:var(--vermelho)' class='brota d6'/>"
			            & "<circle cx='" & FORMAT ( _xa, _f, "en-US" ) & "' cy='34' r='" & IF ( _okL, "16", "10" )
			            & "' style='fill:" & IF ( _okL, "none", "var(--papel)" ) & ";stroke:var(--vermelho);stroke-width:2.6' class='brota d4'/>"
			            & IF (
			                NOT _okL,
			                "<path d='M" & FORMAT ( _xa + 13 * _s, _f, "en-US" ) & " 34 L" & FORMAT ( _xb - 14 * _s, _f, "en-US" )
			                    & " 34 M" & FORMAT ( _xb - 22 * _s, _f, "en-US" ) & " 26 L" & FORMAT ( _xb - 14 * _s, _f, "en-US" )
			                    & " 34 L" & FORMAT ( _xb - 22 * _s, _f, "en-US" ) & " 42' pathLength='1' class='seta traco' "
			                    & "style='stroke:var(--vermelho);animation-delay:1.4s' filter='url(#rbu10)'/>"
			            )
			            & IF (
			                _okL || _perto,
			                "<text x='" & FORMAT ( ( _xa + _xb ) / 2, _f, "en-US" ) & "' y='68' class='vl' text-anchor='middle'>"
			                    & IF (
			                        FORMAT ( _pL, "0.0" ) = FORMAT ( _uL, "0.0" ),
			                        _quemPesq & " e urna, <tspan font-weight='700'>" & FORMAT ( _pL, "0.0" ) & "%</tspan>",
			                        _quemPesq & " <tspan font-weight='700'>" & FORMAT ( _pL, "0.0" ) & "%</tspan> · urna <tspan font-weight='700'>"
			                            & FORMAT ( _uL, "0.0" ) & "%</tspan>"
			                    ) & "</text>",
			                "<text x='" & FORMAT ( _xa, _f, "en-US" ) & "' y='68' class='vl' text-anchor='middle'>" & _quemPesq
			                    & " <tspan font-weight='700'>" & FORMAT ( _pL, "0.0" ) & "%</tspan></text>"
			                    & "<text x='" & FORMAT ( _xb, _f, "en-US" ) & "' y='68' class='vl' text-anchor='middle'>urna <tspan font-weight='700'>"
			                    & FORMAT ( _uL, "0.0" ) & "%</tspan></text>"
			            )
			VAR _linhaF =
			    VAR _xa = _xpF
			    VAR _xb = _xuF
			    VAR _s = IF ( _xb >= _xa, 1, -1 )
			    VAR _perto = ABS ( _xb - _xa ) < 125
			    RETURN
			        "<circle cx='" & FORMAT ( _xb, _f, "en-US" ) & "' cy='132' r='10' style='fill:var(--azul)' class='brota d10'/>"
			            & "<circle cx='" & FORMAT ( _xa, _f, "en-US" ) & "' cy='132' r='" & IF ( _okF, "16", "10" )
			            & "' style='fill:" & IF ( _okF, "none", "var(--papel)" ) & ";stroke:var(--azul);stroke-width:2.6' class='brota d4'/>"
			            & IF (
			                NOT _okF,
			                "<path d='M" & FORMAT ( _xa + 13 * _s, _f, "en-US" ) & " 132 L" & FORMAT ( _xb - 14 * _s, _f, "en-US" )
			                    & " 132 M" & FORMAT ( _xb - 22 * _s, _f, "en-US" ) & " 124 L" & FORMAT ( _xb - 14 * _s, _f, "en-US" )
			                    & " 132 L" & FORMAT ( _xb - 22 * _s, _f, "en-US" ) & " 140' pathLength='1' class='seta traco' "
			                    & "style='animation-delay:1.4s' filter='url(#rbu10)'/>"
			            )
			            & IF (
			                _okF || _perto,
			                "<text x='" & FORMAT ( ( _xa + _xb ) / 2, _f, "en-US" ) & "' y='166' class='vl' text-anchor='middle'>"
			                    & IF (
			                        FORMAT ( _pF, "0.0" ) = FORMAT ( _uF, "0.0" ),
			                        _quemPesq & " e urna, <tspan font-weight='700'>" & FORMAT ( _pF, "0.0" ) & "%</tspan>",
			                        _quemPesq & " <tspan font-weight='700'>" & FORMAT ( _pF, "0.0" ) & "%</tspan> · urna <tspan font-weight='700'>"
			                            & FORMAT ( _uF, "0.0" ) & "%</tspan>"
			                    ) & "</text>",
			                "<text x='" & FORMAT ( _xa, _f, "en-US" ) & "' y='166' class='vl' text-anchor='middle'>" & _quemPesq
			                    & " <tspan font-weight='700'>" & FORMAT ( _pF, "0.0" ) & "%</tspan></text>"
			                    & "<text x='" & FORMAT ( _xb, _f, "en-US" ) & "' y='166' class='vl' text-anchor='middle'>urna <tspan font-weight='700'>"
			                    & FORMAT ( _uF, "0.0" ) & "%</tspan></text>"
			            )
			-- a nota à mão de cada linha fica à direita do marcador mais à direita (nunca por cima de número)
			VAR _xnL = MAX ( _xpL, _xuL ) + IF ( _okL, 30, 24 ) -- geometria
			VAR _xnF = MAX ( _xpF, _xuF ) + IF ( _okF, 30, 24 ) -- geometria
			VAR _notaL =
			    "<div class='" & IF ( _okL, "ok", "mao" ) & " lula-esc entra d12' style='left:" & FORMAT ( _xnL, _f, "en-US" )
			        & "px;top:" & IF ( _okL, "108", "106" ) & "px'>"
			        & IF ( _okL, _acertou, IF ( _eL >= 0, "+", "−" ) & FORMAT ( ABS ( _eL ), "0.0" ) ) & "</div>"
			VAR _notaF =
			    "<div class='" & IF ( _okF, "ok", "mao" ) & " flavio-esc entra d12' style='left:" & FORMAT ( _xnF, _f, "en-US" )
			        & "px;top:" & IF ( _okF, "206", "204" ) & "px'>"
			        & IF ( _okF, _acertou, IF ( _eF >= 0, "+", "−" ) & FORMAT ( ABS ( _eF ), "0.0" ) ) & "</div>"
			-- régua da diferença (votos totais)
			VAR _sd = IF ( _xu >= _xd, 1, -1 )
			VAR _ticksDif =
			    CONCATENATEX (
			        { -8, -4, 0, 4 },
			        "<line x1='" & FORMAT ( 90 + ( [Value] + 8 ) * _k, _f, "en-US" ) & "' x2='" & FORMAT ( 90 + ( [Value] + 8 ) * _k, _f, "en-US" )
			            & "' y1='74' y2='94' class='trilho'/><text x='" & FORMAT ( 90 + ( [Value] + 8 ) * _k, _f, "en-US" )
			            & "' y='114' class='ex' text-anchor='middle'" & IF ( [Value] = 0, " font-weight='700'", "" ) & ">"
			            & IF ( [Value] = 0, "empate", ABS ( [Value] ) ) & "</text>",
			        ""
			    )
			VAR _rDif =
			    "<text x='0' y='90' class='nm'>Diferença</text>"
			        & "<line x1='90' x2='520' y1='84' y2='84' class='trilho'/>"
			        & _ticksDif
			        & "<rect x='" & FORMAT ( _xd - 9, _f, "en-US" ) & "' y='75' width='18' height='18' style='fill:var(--papel);stroke:"
			            & IF ( _iDif < 0, "var(--vermelho)", "var(--azul)" ) & ";stroke-width:2.6' class='brota d4'/>"
			        & "<path d='M" & FORMAT ( _xd + 14 * _sd, _f, "en-US" ) & " 84 L" & FORMAT ( _xu - 14 * _sd, _f, "en-US" ) & " 84 M"
			            & FORMAT ( _xu - 22 * _sd, _f, "en-US" ) & " 76 L" & FORMAT ( _xu - 14 * _sd, _f, "en-US" ) & " 84 L"
			            & FORMAT ( _xu - 22 * _sd, _f, "en-US" ) & " 92' pathLength='1' class='seta traco' style='stroke:var(--tinta);animation-delay:1.4s' "
			            & "filter='url(#rbu10)'/>"
			        & "<circle cx='" & FORMAT ( _xu, _f, "en-US" ) & "' cy='84' r='10' style='fill:var(--tinta)' class='brota d10'/>"
			        & "<text x='" & FORMAT ( _xd, _f, "en-US" ) & "' y='150' class='vl' text-anchor='middle'>pesquisa <tspan font-weight='700'>"
			            & IF ( _quemDif = "", "empate", _quemDif & " +" & FORMAT ( ABS ( _iDif ), "0.0" ) ) & "</tspan></text>"
			        & "<text x='" & FORMAT ( _xu, _f, "en-US" ) & "' y='" & IF ( ABS ( _xu - _xd ) < 150, "174", "150" )
			            & "' class='vl' text-anchor='middle'>urna <tspan font-weight='700'>" & _quemUrna & " +" & FORMAT ( ABS ( _uDif ), "0.0" )
			            & "</tspan></text>"
			VAR _notaDif =
			    "<div class='mao entra d12' style='left:" & FORMAT ( ( _xd + _xu ) / 2 - 40, _f, "en-US" ) & "px;top:130px'>"
			        & FORMAT ( _iDist, "0.0" ) & IF ( ROUND ( _iDist, 1 ) < 2, " ponto", " pontos" ) & "</div>"
			-- 4 · Marcação
			VAR _svg =
			    "<svg width='560' height='196' viewBox='0 0 560 196'>"
			        & IF (
			            _modo = "total",
			            _rDif,
			            "<text x='0' y='40' class='nm l'>Lula</text>"
			                & "<text x='0' y='138' class='nm f'>Flávio</text>"
			                & "<line x1='90' x2='520' y1='34' y2='34' class='trilho'/>"
			                & "<line x1='90' x2='520' y1='132' y2='132' class='trilho'/>"
			                & _ticks & _linhaL & _linhaF
			        )
			    & "</svg>"
			RETURN
			    "<div class='tela t10e'>"
			        & "<div class='sob sobe'>" & _txtSob & "</div>"
			        & "<div class='man sobe d2'>" & _txtMan & "</div>"
			        & _svg
			        & IF ( _modo = "total", _notaDif, _notaL & _notaF )
			        & "<div class='txt sobe d8' style='top:302px'>" & _txt & "</div>"
			        & "<div class='expl sobe d9' style='top:340px'>" & _expl & "</div>"
			    & "</div>"
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: c3d9e534-13b4-5f82-a0c5-be381ecd1762

	/// Texto para leitor de tela das linhas dos institutos (uma por instituto).
	measure 'T10 · Institutos · ALT' =
			"Uma linha por instituto (" & [T10 · institutos]
			    & "), do que dava mais vantagem a Lula ao que dava mais a Flávio. Círculo: votos válidos; quadrado: votos totais. Passe o mouse para ver a trajetória."
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 5347c69e-80e9-5618-b2e4-7cf0d933a6ff

	/// Uma linha por instituto na régua da véspera (grão Pesquisa[Instituto]): nome, haste que cresce a partir do empate, marca (círculo = votos válidos, quadrado = totais) na cor de quem estava à frente e a vantagem em pontos. A linha inteira é o alvo do dossiê ttT10Instituto. Vazio para institutos sem pesquisa de 1º turno.
	measure 'T10 · Institutos · HTML' =
			-- 1 · Leituras
			VAR _nome = [T10 · instituto · nome]
			VAR _o = [T10 · instituto · ordem]
			VAR _dif = [T10 · instituto · diferença]
			VAR _b = [T10 · instituto · base]
			-- 2 · Textos
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _lado = IF ( _dif < 0, "l", "f" )
			VAR _forma = IF ( _b = "validos", "v", "t" )
			VAR _txtV = FORMAT ( ABS ( _dif ), "0.0" )
			-- 3 · Geometria (mesma escala do fundo: x = 240 + (diferença + 8) × 56; empate em 688; linha de 38 px a partir de y 112)
			VAR _f = "0.0"
			VAR _y = 112 + ( _o - 1 ) * 38 -- geometria
			VAR _xm = 240 + ( _dif + 8 ) * 56 -- geometria
			VAR _meia = IF ( _forma = "v", 8.5, 7.5 ) -- geometria
			VAR _hasteX = MIN ( _xm, 688 ) -- geometria
			VAR _hasteW = ABS ( _xm - 688 ) -- geometria
			VAR _atraso = 500 + _o * 70 -- geometria
			VAR _valor =
			    IF (
			        _dif < 0,
			        "right:" & FORMAT ( 1030 - _xm + 16, _f, "en-US" ) & "px",
			        "left:" & FORMAT ( _xm + 16, _f, "en-US" ) & "px"
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _o ),
			        "<div class='tela t10i'><div class='ln' style='top:" & FORMAT ( _y, _f, "en-US" ) & "px'>"
			            & "<div class='nome entra' style='animation-delay:" & _atraso - 200 & "ms'>" & _esc & "</div>"
			            & "<div class='haste " & _lado & IF ( _dif < 0, " barra-x-dir", " barra-x" ) & "' style='left:"
			                & FORMAT ( _hasteX, _f, "en-US" ) & "px;width:" & FORMAT ( _hasteW, _f, "en-US" ) & "px;animation-delay:"
			                & _atraso & "ms'></div>"
			            & "<div class='mk " & _forma & " " & _lado & "' style='left:" & FORMAT ( _xm - _meia, _f, "en-US" )
			                & "px;animation-delay:" & _atraso + 450 & "ms'></div>"
			            & "<div class='vl " & _lado & " entra' style='" & _valor & ";animation-delay:" & _atraso + 550 & "ms'>"
			                & _txtV & "</div>"
			        & "</div></div>"
			    )
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: b2b8a1ee-b9a5-5084-8534-cb8766678426

	/// Texto para leitor de tela da resposta da tela (≤ 250 caracteres).
	measure 'T10 · Resposta · ALT' =
			"Na véspera do 1º turno, " & [T10 · institutos · Lula à frente] & " de " & [T10 · institutos]
			    & " institutos davam Lula à frente. A urna deu " & IF ( [T10 · urna · diferença] >= 0, "Flávio", "Lula" ) & " por "
			    & FORMAT ( ABS ( [T10 · urna · diferença] ), "0.0" ) & " ponto dos votos válidos."
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 83e7072e-e824-5444-b485-33418c932f90

	/// A resposta da tela: quantos institutos davam Lula à frente na véspera (contadores), a manchete com o resultado da urna e o como ler da régua. Só lê as contas 'T10 · …'.
	measure 'T10 · Resposta · HTML' =
			-- 1 · Leituras
			VAR _nL = [T10 · institutos · Lula à frente]
			VAR _nF = [T10 · institutos · Flávio à frente]
			VAR _n = [T10 · institutos]
			VAR _urna = [T10 · urna · diferença]
			VAR _vesp = [T10 · véspera]
			-- 2 · Textos
			VAR _quemUrna = IF ( _urna >= 0, "Flávio", "Lula" )
			VAR _clsUrna = IF ( _urna >= 0, "flavio", "lula" )
			VAR _txtUrna = FORMAT ( ABS ( _urna ), "0.0" )
			VAR _txtPonto = IF ( ROUND ( ABS ( _urna ), 1 ) < 2, " ponto", " pontos" )
			VAR _txtOutros =
			    IF ( _nF = 1, "Só 1 já dava Flávio.", "Outros " & _nF & " já davam Flávio." )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t10r'>"
			        & "<div class='sob sobe'>Na véspera do 1º turno · até " & FORMAT ( _vesp, "dd/MM" ) & "</div>"
			        & "<div class='hero sobe d1'><span class='num lula'>" & _nL & "</span><span class='de'>de</span><span class='num'>"
			            & _n & "</span></div>"
			        & "<div class='sub sobe d3'>" & IF ( _n = 1, "instituto dava", "institutos davam" ) & " Lula à frente</div>"
			        & "<div class='tit sobe d5'>A urna deu <span class='" & _clsUrna & "'>" & _quemUrna & "</span> por "
			            & _txtUrna & _txtPonto & ".</div>"
			        & "<div class='txt sobe d7'>" & _txtOutros
			            & " Na régua ao lado, cada linha é a última pesquisa de um instituto antes da eleição, e a linha preta é o resultado da urna.</div>"
			    & "</div>"
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: e53ffe9a-9319-5151-bcc6-e89df84f270a

	/// Texto para leitor de tela da régua da véspera.
	measure 'T10 · Régua · ALT' =
			"Régua da diferença entre Flávio e Lula na última pesquisa de cada instituto, de Lula à frente a Flávio à frente, com o empate e a urna (Flávio "
			    & FORMAT ( [T10 · urna · diferença], "0.0" ) & ") marcados."
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 56e6452c-1316-5d3c-807d-386076ab521b

	/// Fundo da régua da véspera: título, as duas metades (Lula à frente, Flávio à frente) que esmaecem, o empate, a urna como traço à mão com o rótulo sublinhado à mão (nada de laço por cima do número), os números do eixo, a legenda e a chave à mão nas linhas que chegaram perto da urna. As linhas dos institutos são outro visual (T10 · Institutos · HTML), na mesma caixa e escala.
	measure 'T10 · Régua · HTML' =
			-- 1 · Leituras
			VAR _urna = [T10 · urna · diferença]
			VAR _n = [T10 · institutos]
			VAR _perto = [T10 · institutos · perto da urna]
			VAR _p0 = [T10 · perto da urna · primeira linha]
			VAR _p1 = [T10 · perto da urna · última linha]
			-- 2 · Textos
			VAR _quem = IF ( _urna >= 0, "Flávio", "Lula" )
			VAR _txtUrna = "+" & FORMAT ( ABS ( _urna ), "0.0" )
			VAR _txtPerto = IF ( _perto = 1, "1 chegou<br>perto", _perto & " chegaram<br>perto" )
			-- 3 · Geometria (x = 240 + (diferença + 8) × 56: empate em 688; linhas de 38 px a partir de y 112)
			VAR _f = "0.0"
			VAR _x0 = 688
			VAR _xu = 240 + ( _urna + 8 ) * 56 -- geometria
			VAR _yFim = 112 + _n * 38 -- geometria
			VAR _ticks =
			    CONCATENATEX (
			        { -8, -6, -4, -2, 2, 4 },
			        "<line x1='" & FORMAT ( 240 + ( [Value] + 8 ) * 56, _f, "en-US" ) & "' x2='" & FORMAT ( 240 + ( [Value] + 8 ) * 56, _f, "en-US" )
			            & "' y1='104' y2='" & FORMAT ( _yFim + 4, _f, "en-US" ) & "' class='tk'/>"
			            & "<text x='" & FORMAT ( 240 + ( [Value] + 8 ) * 56, _f, "en-US" ) & "' y='" & FORMAT ( _yFim + 24, _f, "en-US" )
			            & "' class='ex' text-anchor='middle'>" & ABS ( [Value] ) & "</text>",
			        ""
			    )
			VAR _yChave = 112 + ( _p0 - 1 ) * 38 + 4 -- geometria
			VAR _hChave = ( _p1 - _p0 + 1 ) * 38 - 8 -- geometria
			-- 4 · Marcação
			VAR _svg =
			    "<svg width='1030' height='860' viewBox='0 0 1030 860'>"
			        & _ticks
			        & "<line x1='" & _x0 & "' x2='" & _x0 & "' y1='100' y2='" & FORMAT ( _yFim + 8, _f, "en-US" ) & "' class='emp'/>"
			        & "<text x='" & _x0 & "' y='" & FORMAT ( _yFim + 24, _f, "en-US" ) & "' class='ex' text-anchor='middle' font-weight='700'>empate</text>"
			        & "<path d='M" & FORMAT ( _xu, _f, "en-US" ) & " 100 L" & FORMAT ( _xu, _f, "en-US" ) & " " & FORMAT ( _yFim + 8, _f, "en-US" )
			            & "' pathLength='1' class='urna traco' filter='url(#rbu10g)' style='animation-delay:.6s'/>"
			    & "</svg>"
			VAR _rotUrna =
			    "<div class='uro entra d6' style='left:" & FORMAT ( _xu, _f, "en-US" ) & "px;top:50px;width:220px'>urna: "
			        & _quem & "<span class='num'>" & _txtUrna & "</span>"
			        & "<svg width='220' height='50' viewBox='0 0 220 50' style='position:absolute;inset:0;pointer-events:none'>"
			        & "<path d='M8,40 C52,45 118,44 168,41 C186,40 200,38 212,36' pathLength='1' class='traco' "
			        & "style='fill:none;stroke:var(--tinta);stroke-width:3;stroke-linecap:round;animation-delay:1600ms' filter='url(#rbu10g)'/></svg>"
			    & "</div>"
			VAR _chave =
			    IF (
			        _perto > 0,
			        "<div class='chave entra d16' style='left:" & FORMAT ( _xu + 80, _f, "en-US" ) & "px;top:" & FORMAT ( _yChave, _f, "en-US" )
			            & "px;width:22px;height:" & FORMAT ( _hChave, _f, "en-US" ) & "px'></div>"
			            & "<div class='mao entra d16' style='left:" & FORMAT ( _xu + 108, _f, "en-US" ) & "px;top:"
			            & FORMAT ( _yChave + _hChave / 2 - 27, _f, "en-US" ) & "px;line-height:.95'>" & _txtPerto & "</div>"
			    )
			RETURN
			    "<div class='tela t10g'>"
			        & _svg
			        & "<div class='cab'><div class='sob sobe'>A última pesquisa de cada instituto antes do 1º turno</div>"
			            & "<div class='txt sobe d2'>Diferença entre os dois, em pontos.</div></div>"
			        & _rotUrna
			        & "<div class='lado lula-esc entra d8' style='left:240px;top:" & FORMAT ( _yFim + 40, _f, "en-US" ) & "px'>← Lula à frente</div>"
			        & "<div class='lado flavio-esc entra d8' style='right:90px;top:" & FORMAT ( _yFim + 40, _f, "en-US" ) & "px'>Flávio à frente →</div>"
			        & "<div class='leg entra d10' style='top:" & FORMAT ( _yFim + 42, _f, "en-US" ) & "px'><span><i class='c'></i>votos válidos</span>"
			            & "<span><i class='q'></i>votos totais</span></div>"
			        & _chave
			    & "</div>"
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 6fd90ba7-6880-557d-b71b-cd3c3078ddb3

	/// Texto para leitor de tela do dossiê de uma linha do quadro 'onde foi o erro'.
	measure 'T10 · Tooltip erro · ALT' =
			IF (
			    NOT ISBLANK ( [T10 · erro · candidato] ),
			    [T10 · erro · candidato] & " nas " & [T10 · institutos · com válidos] & " pesquisas com votos válidos: de "
			        & FORMAT ( [T10 · erro · menor], "0.0" ) & "% a " & FORMAT ( [T10 · erro · maior], "0.0" ) & "%; na urna, "
			        & FORMAT ( [T10 · erro · urna], "0.0" ) & "%."
			)
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 68c13e4f-c5b8-5e01-b4c1-4676d96a832a

	/// Dossiê de uma linha do quadro 'onde foi o erro' (ttT10Erro, grão 'Candidato ano'[Partido]): o que cada instituto com votos válidos deu ao candidato na véspera, um por linha (ponto na régua de 38% a 50%), contra a linha da urna; a manchete diz se a média escondia o espalhamento ou se todos erraram para o mesmo lado. O instituto clicado na régua fica em destaque. Só lê contas 'T10 · …'.
	measure 'T10 · Tooltip erro · HTML' =
			-- 1 · Leituras
			VAR _c = [T10 · erro · candidato]
			VAR _u = [T10 · erro · urna]
			VAR _m = [T10 · erro · média]
			VAR _n = [T10 · institutos · com válidos]
			VAR _ab = [T10 · erro · abaixo da urna]
			VAR _ac = [T10 · erro · acima da urna]
			VAR _min = [T10 · erro · menor]
			VAR _max = [T10 · erro · maior]
			VAR _esc = [T10 · escolha · instituto]
			VAR _lista =
			    FILTER (
			        ADDCOLUMNS ( ALLNOBLANKROW ( Pesquisa[Instituto] ), "@v", [T10 · instituto · valor válido] ),
			        NOT ISBLANK ( [@v] )
			    ) /* lista */
			-- 2 · Textos
			VAR _cls = IF ( _c = "Lula", "lula", "flavio" )
			VAR _okM = ABS ( _m - _u ) < 0.5
			VAR _txtTt =
			    SWITCH (
			        TRUE (),
			        _ab = _n, "Os " & _n & " deram a " & _c & " menos do que a urna: de " & FORMAT ( _min, "0.0" ) & "% a "
			            & FORMAT ( _max, "0.0" ) & "%",
			        _ac = _n, "Os " & _n & " deram a " & _c & " mais do que a urna: de " & FORMAT ( _min, "0.0" ) & "% a "
			            & FORMAT ( _max, "0.0" ) & "%",
			        "Na média, " & IF ( _okM, "acertaram", "erraram" ) & "; um a um, foram de " & FORMAT ( _min, "0.0" ) & "% a "
			            & FORMAT ( _max, "0.0" ) & "%"
			    )
			VAR _mao =
			    SWITCH ( TRUE (), _ab = _n, "todos abaixo da urna", _ac = _n, "todos acima da urna", "a média esconde" )
			-- 3 · Geometria (régua de 38% a 50% em 220 px; linhas de 22 px)
			VAR _k = 220 / 12 -- geometria
			VAR _f = "0.0"
			VAR _xu = ( _u - 38 ) * _k -- geometria
			VAR _altura = COUNTROWS ( _lista ) * 22 -- geometria
			VAR _linhas =
			    CONCATENATEX (
			        _lista,
			        VAR _nome = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( Pesquisa[Instituto], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			        VAR _x = ( [@v] - 38 ) * _k
			        VAR _dest = Pesquisa[Instituto] = _esc
			        RETURN
			            "<div class='li" & IF ( _dest, " on", "" ) & "'><span class='in'>" & _nome & "</span><span class='tr'><i class='pt "
			                & _cls & "' style='left:" & FORMAT ( _x - 6, _f, "en-US" ) & "px'></i></span><span class='vv'>"
			                & FORMAT ( [@v], "0.0" ) & "</span></div>",
			        "",
			        [@v], DESC,
			        Pesquisa[Instituto], ASC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _c ),
			        "<div class='tt10e'>"
			            & "<div class='sob sobe'>" & _c & " · os " & _n & " com votos válidos</div>"
			            & "<div class='tt sobe d2'>" & _txtTt & "</div>"
			            & "<div class='lista sobe d3'>"
			                & "<div class='urna' style='left:" & FORMAT ( 150 + _xu, _f, "en-US" ) & "px;height:" & _altura + 10
			                & "px'><b>urna " & FORMAT ( _u, "0.0" ) & "%</b></div>"
			                & _linhas
			            & "</div>"
			            & "<div class='nota sobe d4'>Última pesquisa de cada um antes do 1º turno. Urna: TSE.</div>"
			            & "<div class='mao" & IF ( _c = "Flávio", " az", "" ) & " entra d7'>" & _mao & "</div>"
			        & "</div>"
			    )
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 043fb3e6-0336-5ddc-8172-eb800fde1502

	/// Texto para leitor de tela do dossiê de um instituto (grão Pesquisa[Instituto]).
	measure 'T10 · Tooltip instituto · ALT' =
			IF (
			    NOT ISBLANK ( [T10 · instituto · nome] ),
			    [T10 · instituto · nome] & ", última pesquisa antes da urna em " & FORMAT ( [T10 · instituto · última divulgação], "dd/MM" )
			        & ": Lula " & FORMAT ( [T10 · instituto · Lula], "0.0" ) & "% e Flávio " & FORMAT ( [T10 · instituto · Flávio], "0.0" )
			        & "% (" & IF ( [T10 · instituto · base] = "validos", "votos válidos", "votos totais" ) & ")."
			)
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: c0af4a71-4ccd-599f-8d49-9ff5d916cc81

	/// Dossiê de um instituto na régua da véspera (ttT10Instituto, grão Pesquisa[Instituto]): a última pesquisa antes da urna (Lula × Flávio, base), quem ela dava à frente e o erro contra a urna (só em válidos), a trajetória de todas as pesquisas do instituto no 1º turno em votos totais (as linhas se desenham) e entrevistas, margem e registro. Só lê contas 'T10 · …'.
	measure 'T10 · Tooltip instituto · HTML' =
			-- 1 · Leituras
			VAR _nome = [T10 · instituto · nome]
			VAR _d = [T10 · instituto · última divulgação]
			VAR _b = [T10 · instituto · base]
			VAR _l = [T10 · instituto · Lula]
			VAR _f = [T10 · instituto · Flávio]
			VAR _dif = [T10 · instituto · diferença]
			VAR _e = [T10 · instituto · erro vs urna]
			VAR _urna = [T10 · urna · diferença]
			VAR _n = [T10 · instituto · entrevistas]
			VAR _m = [T10 · instituto · margem de erro]
			VAR _reg = [T10 · instituto · registro]
			VAR _np = [T10 · instituto · pesquisas no 1º turno]
			VAR _serie =
			    ADDCOLUMNS (
			        VALUES ( Pesquisa[Id] ),
			        "@d", [T10 · série · divulgação],
			        "@l", [T10 · série · Lula],
			        "@f", [T10 · série · Flávio]
			    )
			-- 2 · Textos
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escReg = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			VAR _quem = IF ( _dif > 0, "Flávio", IF ( _dif < 0, "Lula", "" ) )
			VAR _pts = IF ( ROUND ( ABS ( _dif ), 1 ) < 2, " ponto", " pontos" )
			VAR _txtDif =
			    IF ( _quem = "", "Dava empate.", "Dava " & _quem & " " & FORMAT ( ABS ( _dif ), "0.0" ) & _pts & " à frente." )
			VAR _txtUrna = "A urna deu " & IF ( _urna >= 0, "Flávio", "Lula" ) & " " & FORMAT ( ABS ( _urna ), "0.0" ) & " à frente"
			VAR _txtErro =
			    SWITCH (
			        TRUE (),
			        _b <> "validos", " Era em votos totais (com brancos, nulos e indecisos): não se compara direto com a urna.",
			        ABS ( _e ) < 0.5, " " & _txtUrna & ": ficou a " & FORMAT ( ABS ( _e ), "0.0" ) & " ponto do resultado.",
			        " " & _txtUrna & ": errou " & FORMAT ( ABS ( _e ), "0.0" ) & IF ( ROUND ( ABS ( _e ), 1 ) < 2, " ponto", " pontos" )
			            & " a favor de " & IF ( _e < 0, "Lula", "Flávio" ) & "."
			    )
			VAR _txtBase = IF ( _b = "validos", "votos válidos", "votos totais" )
			VAR _txtNp = IF ( _np = 1, "1 pesquisa", _np & " pesquisas" )
			VAR _txtReg = IF ( LEN ( _reg ) = 0, "", " · <span style='white-space:nowrap'>" & _escReg & "</span>" )
			VAR _mao = IF ( _quem = "", "empate", _quem & " à frente" )
			VAR _clsMao = IF ( _quem = "Flávio", " az", "" )
			-- 3 · Geometria (01/08 a 03/10 em x 34–404; 25% a 50% em y 96–10)
			VAR _pontos = FILTER ( _serie, NOT ISBLANK ( [@l] ) && NOT ISBLANK ( [@f] ) ) /* lista */
			VAR _xy =
			    ADDCOLUMNS (
			        _pontos,
			        "@x", 34 + DATEDIFF ( DATE ( 2026, 8, 1 ), [@d], DAY ) / 63 * 370,
			        "@yl", 96 - ( [@l] - 25 ) / 25 * 86,
			        "@yf", 96 - ( [@f] - 25 ) / 25 * 86
			    ) /* geometria */
			VAR _fm = "0.0"
			VAR _linL = CONCATENATEX ( _xy, FORMAT ( [@x], _fm, "en-US" ) & "," & FORMAT ( [@yl], _fm, "en-US" ), " ", [@d], ASC )
			VAR _linF = CONCATENATEX ( _xy, FORMAT ( [@x], _fm, "en-US" ) & "," & FORMAT ( [@yf], _fm, "en-US" ), " ", [@d], ASC )
			VAR _bolas =
			    CONCATENATEX (
			        _xy,
			        "<circle cx='" & FORMAT ( [@x], _fm, "en-US" ) & "' cy='" & FORMAT ( [@yl], _fm, "en-US" ) & "' r='3.5' class='pl'/>"
			            & "<circle cx='" & FORMAT ( [@x], _fm, "en-US" ) & "' cy='" & FORMAT ( [@yf], _fm, "en-US" ) & "' r='3.5' class='pf'/>",
			        ""
			    )
			VAR _y40 = FORMAT ( 96 - 15 / 25 * 86, _fm, "en-US" )
			-- 4 · Marcação
			VAR _svg =
			    "<svg width='420' height='116' viewBox='0 0 420 116'>"
			        & "<line x1='34' x2='404' y1='" & _y40 & "' y2='" & _y40 & "' class='g'/>"
			        & "<text x='0' y='" & FORMAT ( 96 - 15 / 25 * 86 + 4, _fm, "en-US" ) & "' class='ex'>40%</text>"
			        & "<line x1='34' x2='404' y1='96' y2='96' class='g'/>"
			        & "<text x='34' y='112' class='ex'>01/08</text><text x='210' y='112' class='ex' text-anchor='middle'>01/09</text>"
			        & "<text x='404' y='112' class='ex' text-anchor='end'>03/10</text>"
			        & IF ( COUNTROWS ( _xy ) > 1 /* lista */, "<polyline points='" & _linL & "' class='ll traco' pathLength='1'/>"
			            & "<polyline points='" & _linF & "' class='lf traco' pathLength='1'/>" )
			        & _bolas
			    & "</svg>"
			RETURN
			    IF (
			        NOT ISBLANK ( _nome ),
			        "<div class='tt10'>"
			            & "<div class='sob sobe'>" & _esc & " · " & FORMAT ( _d, "dd/MM" ) & " · " & _txtBase & "</div>"
			            & "<div class='par sobe d2'>"
			                & "<div class='lula'><small>Lula</small><span class='num'>" & FORMAT ( _l, "0.0" ) & "%</span></div>"
			                & "<div class='flavio'><small>Flávio</small><span class='num'>" & FORMAT ( _f, "0.0" ) & "%</span></div>"
			                & "<div class='mao" & _clsMao & " entra d7'>" & _mao & "</div>"
			                & "</div>"
			            & "<div class='txt sobe d3'><b>" & _txtDif & "</b>" & _txtErro & "</div>"
			            & "<div class='tj sobe d4'>Trajetória · votos totais · " & _txtNp & "</div>"
			            & "<div class='sobe d4'>" & _svg & "</div>"
			            & "<div class='nota sobe d5'>Última pesquisa: " & FORMAT ( _n, "#,0" ) & " entrevistas"
			                & IF ( ISBLANK ( _m ), "", " · margem de erro de " & FORMAT ( _m, "0.0" ) & " pontos" ) & _txtReg & "</div>"
			        & "</div>"
			    )
		displayFolder: T10 Pesquisas\Desenho
		lineageTag: 60f9ea98-c38a-5d0f-b2fc-24f75a050772

	/// Municípios com Jair Bolsonaro à frente em 2022. Conta município a município no recorte.
	measure 'T11 · adversário à frente em 2022' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			        VAR _d22 = [T11 · saldo 2022]
			        RETURN
			            IF ( _d22 < 0, 1 )
			) + 0
		formatString: #,0
		displayFolder: T11 Virada\Contas
		lineageTag: a54e8b16-1d7e-534a-a847-de556f1bd252

	/// A eleição mais recente antes de 2026 em que o adversário do PT ficou à frente no contexto (vazio se nenhuma).
	measure 'T11 · antes de 2026, a última com o adversário à frente' =
			MAXX (
			    FILTER ( ALL ( 'Ano'[Ano] ), 'Ano'[Ano] < 2026 && [T11 · margem no ano] < 0 ),
			    'Ano'[Ano]
			)
		formatString: 0
		displayFolder: T11 Virada\Contas
		lineageTag: 9562a515-fbf3-5b29-92bf-e96225f2a893

	/// Candidato do PT no ano do contexto.
	measure 'T11 · candidato do PT no ano' =
