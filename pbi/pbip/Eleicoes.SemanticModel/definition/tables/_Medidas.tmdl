	/// Interações de Flávio nos perfis oficiais na 2º turno, 05 a 17/10 (Bites).
	measure 'T09 · interações · 2º turno · Flávio' =
			CALCULATE ( [T09 · interações · 2º turno], REMOVEFILTERS ( Monitoramento ), Monitoramento[Candidato] = "Flávio Bolsonaro" )
		formatString: #,0
