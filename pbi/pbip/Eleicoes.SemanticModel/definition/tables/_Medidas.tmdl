	/// Municípios em que o adversário estava à frente em 2022 e Lula ficou à frente em 2026. Conta município a município no recorte.
	measure 'T11 · voltaram' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			        VAR _d22 = [T11 · saldo 2022]
			        VAR _d26 = [T11 · saldo 2026]
			        RETURN
			            IF ( _d22 < 0 && _d26 > 0, 1 )
			) + 0
		formatString: #,0
