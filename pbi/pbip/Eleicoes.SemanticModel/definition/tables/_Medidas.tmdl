	/// Código IBGE da cidade da tela: a cidade das escolas marcadas no filtro (uma cidade por vez, pelo exclusiveRoots do VizuFilter; marcar a cidade marca todas as escolas dela); sem escolha, o Rio de Janeiro (3304557), onde a tela abre.
	measure 'T20 · cidade (código)' =
			VAR _codigos = VALUES ( 'T20 Filtro'[CodIBGE] )
			RETURN
			    IF (
			        ISFILTERED ( 'T20 Filtro' ) && COUNTROWS ( _codigos ) = 1,
			        MAXX ( _codigos, 'T20 Filtro'[CodIBGE] ),
			        "3304557"
			    )
		displayFolder: T20 Escola\Contas
		lineageTag: d5d0ef2a-b7b1-5b8e-9514-8d3371d8e08c

