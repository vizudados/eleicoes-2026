	/// Texto para leitor de tela do número da noite do debate (≤ 250 caracteres).
	measure 'T07 · Audiência · ALT' =
			"Debate de " & FORMAT ( [T07 · debate · data], "dd/MM" ) & " na Band: " & FORMAT ( [T07 · audiência], "0" )
			    & " pontos de audiência na Grande SP, " & FORMAT ( [T07 · audiência · pico], "0.0" ) & " no pico e "
			    & FORMAT ( [T07 · audiência · share], "0%" ) & " das TVs ligadas. O debate parou a TV, mas não mexeu nas pesquisas."
		displayFolder: T07 Debate\Desenho
		lineageTag: a5b821b4-0186-5a01-80b1-3fe0550c56cd

	/// O número da noite do debate de 18/10: a audiência na Grande SP (contador), o pico, o share e os aparelhos no YouTube, e a manchete da tela. Só lê as contas 'T07 · audiência…', 'T07 · YouTube · aparelhos' e 'T07 · debate · data'.
	measure 'T07 · Audiência · HTML' =
			-- 1 · Leituras
			VAR _aud = [T07 · audiência]
			VAR _pico = [T07 · audiência · pico]
			VAR _share = [T07 · audiência · share]
			VAR _pessoas = [T07 · audiência · pessoas]
			VAR _yt = [T07 · YouTube · aparelhos]
			VAR _dia = [T07 · debate · data]
			-- 2 · Textos
			VAR _txtAud = FORMAT ( _aud, "0" )
			VAR _txtPico = FORMAT ( _pico, "0.0" )
			VAR _txtShare = FORMAT ( _share, "0%" )
			VAR _txtYt = FORMAT ( _yt / 1000000, "0.00" ) & " mi"
			VAR _txtPessoas = FORMAT ( _pessoas / 1000000, "0.0" ) & " milhões de pessoas"
			VAR _txtDia = FORMAT ( _dia, "dd/MM" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t07a'>"
			        & "<div class='sob sobe'>" & _txtDia & " · Band · o primeiro frente a frente</div>"
			        & "<div class='linha'>"
			            & "<div class='hero sobe d1'><span class='num'>" & _txtAud & "</span><span class='u'>pontos</span></div>"
			            & "<div class='tri'>"
			                & "<div class='sobe d3'><div class='num'>" & _txtPico & "</div><div class='rot'>pontos<br>no pico</div></div>"
			                & "<div class='sobe d4'><div class='num'>" & _txtShare & "</div><div class='rot'>das TVs ligadas<br>estavam no debate</div></div>"
			                & "<div class='sobe d5'><div class='num'>" & _txtYt & "</div><div class='rot'>de aparelhos ao mesmo<br>tempo no YouTube</div></div>"
			            & "</div>"
			        & "</div>"
			        & "<div class='man sobe d6'>O debate parou a TV, mas não mexeu nas pesquisas</div>"
			        & "<div class='txt sobe d7'>Audiência na Grande SP: cerca de " & _txtPessoas
			            & " assistiram. Segundo a Band, foi o debate mais visto em 20 anos até então.</div>"
			    & "</div>"
		displayFolder: T07 Debate\Desenho
		lineageTag: 7a168888-839c-5eb1-9cdd-51c6ce623cae

	/// Texto para leitor de tela da linha dos debates da campanha.
	measure 'T07 · Debates · ALT' =
			VAR _um = [T07 · debates frente a frente]
			RETURN
			    [T07 · debates marcados] & " debates marcados na campanha; " & _um & IF ( _um = 1, " reuniu", " reuniram" )
			        & " Lula e Flávio (" & [T07 · 2º turno · frente a frente · emissoras] & "). No 1º turno, "
			        & [T07 · 1º turno · sem os dois] & " aconteceram sem os dois e " & [T07 · 1º turno · cancelados]
			        & " foram cancelados; no 2º turno, " & [T07 · 2º turno · desmarcados] & " caíram."
		displayFolder: T07 Debate\Desenho
		lineageTag: 4b022f86-99c0-5ba4-9c27-7b3dfc632d19

	/// Os debates marcados na campanha: '2 de 12' (contadores), o resumo do 1º e do 2º turno (no 2º, os que caíram e as emissoras dos frente a frente, Band e Globo), o eixo do primeiro ao último debate da tabela (23/08 a 23/10) com o corte do 1º turno e a legenda. As marcas de cada debate são outro visual (T07 · Marcas · HTML), na mesma caixa e na mesma escala.
	measure 'T07 · Debates · HTML' =
			-- 1 · Leituras
			VAR _n = [T07 · debates marcados]
			VAR _um = [T07 · debates frente a frente]
			VAR _sem = [T07 · 1º turno · sem os dois]
			VAR _can = [T07 · 1º turno · cancelados]
			VAR _des = [T07 · 2º turno · desmarcados]
			VAR _emis = [T07 · 2º turno · frente a frente · emissoras]
			VAR _dia0 = [T07 · debates · primeiro dia]
			VAR _dia1 = [T07 · debates · último dia]
			-- 2 · Textos
			-- "Band e Globo" → "à Band e à Globo"
			VAR _txtEmis = "à " & SUBSTITUTE ( SUBSTITUTE ( _emis, ", ", ", à " ), " e ", " e à " )
			VAR _txtResumo =
			    "No 1º turno, Lula e Flávio faltaram a todos: " & _sem & IF ( _sem = 1, " aconteceu", " aconteceram" )
			        & " sem eles e " & _can & IF ( _can = 1, " foi cancelado", " foram cancelados" ) & ". No 2º turno, "
			        & _des & IF ( _des = 1, " caiu", " caíram" ) & " e os dois foram " & _txtEmis & "."
			-- 3 · Geometria (eixo: da véspera do primeiro debate ao dia seguinte ao último, em x 600–1600)
			VAR _ini = _dia0 - 1
			VAR _span = DATEDIFF ( _ini, _dia1 + 1, DAY ) -- geometria
			VAR _xCorte = 600 + DATEDIFF ( _ini, DATE ( 2026, 10, 4 ), DAY ) / _span * 1000 -- geometria
			VAR _fC = FORMAT ( _xCorte, "0.0", "en-US" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t07d'>"
			        & "<div class='esq'>"
			            & "<div class='sob sobe'>Os debates da campanha</div>"
			            & "<div class='linha sobe d2'><span class='num'>" & _um & "</span><span class='man'>de</span><span class='num'>" & _n
			            & "</span><span class='man'>marcados " & IF ( _um = 1, "reuniu", "reuniram" ) & " os dois</span></div>"
			            & "<div class='txt sobe d3'>" & _txtResumo & "</div>"
			        & "</div>"
			        & "<svg width='1620' height='132' viewBox='0 0 1620 132'>"
			            & "<text x='600' y='13' class='ex'>1º TURNO</text>"
			            & "<text x='" & FORMAT ( _xCorte + 12, "0.0", "en-US" ) & "' y='13' class='ex'>2º TURNO</text>"
			            & "<path d='M600 58 H1600' pathLength='1' class='eixo traco'/>"
			            & "<line x1='" & _fC & "' x2='" & _fC & "' y1='2' y2='104' class='corte'/>"
			        & "</svg>"
			        & "<div class='leg entra d10'><span><i class='o'></i>aconteceu sem os dois</span>"
			            & "<span><svg width='13' height='13' viewBox='0 0 18 18'><path d='M3.5 3 L15 15.5 M15 3.5 L3 15' fill='none' "
			            & "stroke='var(--grafite)' stroke-width='2.8' stroke-linecap='round'/></svg>cancelado ou não realizado</span>"
			            & "<span><i class='ff'></i>Lula e Flávio frente a frente</span></div>"
			    & "</div>"
		displayFolder: T07 Debate\Desenho
		lineageTag: a7bb39d0-e8c3-5b11-8234-ae146d65f4cd

	/// Texto para leitor de tela das marcas dos debates (uma por debate marcado).
	measure 'T07 · Marcas · ALT' =
			"Uma marca por debate marcado (" & [T07 · debates marcados] & "), de " & FORMAT ( [T07 · debates · primeiro dia], "dd/MM" )
			    & " a " & FORMAT ( [T07 · debates · último dia], "dd/MM" )
			    & ": círculo vazio quando aconteceu sem os dois, × quando caiu, vermelho e azul quando Lula e Flávio estiveram. Passe o mouse para ver quem foi."
		displayFolder: T07 Debate\Desenho
		lineageTag: a6ff88d9-e98b-5f08-833f-486e5062a058

	/// Uma marca por debate marcado (grão Debate[Data]) no eixo de T07 · Debates · HTML (do primeiro ao último debate da tabela, 23/08 a 23/10): círculo vazio = aconteceu sem Lula e Flávio; × = cancelado ou não realizado; círculo vermelho e azul = frente a frente (Band, 18/10, e Globo, 23/10). Data acima ou abaixo, alternando para não encostar. Alvo do dossiê ttT07Debate.
	measure 'T07 · Marcas · HTML' =
			-- 1 · Leituras
			VAR _sit = [T07 · debate · situação]
			VAR _ff = [T07 · debate · frente a frente]
			VAR _dia = [T07 · debate · dia]
			VAR _ord = [T07 · debate · ordem]
			VAR _dia0 = [T07 · debates · primeiro dia]
			VAR _dia1 = [T07 · debates · último dia]
			-- 2 · Textos
			VAR _cls = SWITCH ( TRUE (), _ff = "Sim", "ff", _sit = "realizado", "re", "ca" )
			VAR _marca =
			    IF (
			        _cls = "ca",
			        "<svg width='18' height='18' viewBox='0 0 18 18'><path d='M3.5 3 L15 15.5 M15 3.5 L3 15' fill='none' "
			            & "stroke='var(--grafite)' stroke-width='2.6' stroke-linecap='round'/></svg>",
			        ""
			    )
			VAR _txtDia = FORMAT ( _dia, "dd/MM" )
			-- 3 · Geometria (o eixo de T07 · Debates · HTML: da véspera do primeiro debate ao dia seguinte ao último, em x
			-- 600–1600, linha em y 58)
			VAR _ini = _dia0 - 1
			VAR _span = DATEDIFF ( _ini, _dia1 + 1, DAY ) -- geometria
			VAR _x = 600 + DATEDIFF ( _ini, _dia, DAY ) / _span * 1000 -- geometria
			VAR _tam = SWITCH ( _cls, "ff", 24, "ca", 18, 16 ) -- geometria
			VAR _yDia = IF ( _cls = "ff" || MOD ( _ord, 2 ) = 1, 76, 26 ) -- geometria
			VAR _atraso = 900 + _ord * 120 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _sit ),
			        "<div class='tela t07m'>"
			            & "<div class='mc " & _cls & "' style='left:" & FORMAT ( _x - _tam / 2, "0.0", "en-US" ) & "px;top:"
			            & FORMAT ( 58 - _tam / 2, "0.0", "en-US" ) & "px;animation-delay:" & _atraso & "ms'>" & _marca & "</div>"
			            & "<div class='dt" & IF ( _cls = "ff", " b", "" ) & " entra' style='left:" & FORMAT ( _x, "0.0", "en-US" )
			            & "px;top:" & FORMAT ( _yDia + IF ( _cls = "ff", 4, 0 ), "0.0", "en-US" ) & "px;animation-delay:" & _atraso + 200 & "ms'>"
			            & _txtDia & "</div>"
			        & "</div>"
			    )
		displayFolder: T07 Debate\Desenho
		lineageTag: cac24240-13a8-5367-bf0a-e05557bad5dc

	/// Texto para leitor de tela do palco em traço.
	measure 'T07 · Palco · ALT' =
			"Desenho do palco do debate da Band de " & FORMAT ( [T07 · debate · data], "dd/MM" )
			    & ", com Lula e Flávio nos púlpitos. Passe o mouse para ver uma frase de cada um, a nota da Quaest e a audiência de outros debates."
		displayFolder: T07 Debate\Desenho
		lineageTag: c6c29c42-176f-5292-9747-3b4aeaed537a

	/// Legenda do palco em traço (a arte fica no bodyTemplate) e o alvo do mouse que abre o dossiê ttT07Palco. Uma entrada só: a linha do debate da Band no 2º turno (grão Debate[Data], T07 · debate · o da Band), o primeiro frente a frente; a legenda diz onde os dois voltaram a se encontrar (a Globo, 23/10), quando a tabela tem esse debate.
	measure 'T07 · Palco · HTML' =
			-- 1 · Leituras
			VAR _band = [T07 · debate · o da Band]
			VAR _dia = [T07 · debate · dia]
			VAR _emi = [T07 · debate · emissora]
			VAR _med = [T07 · debate · mediação]
			VAR _prox = [T07 · debate seguinte · data]
			VAR _proxEmi = [T07 · debate seguinte · emissora]
			-- 2 · Textos
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _emi, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escMed = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _med, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escProx = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _proxEmi, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtDia = FORMAT ( _dia, "dd/MM" )
			VAR _txtProx =
			    IF ( NOT ISBLANK ( _prox ), " Voltaram a se encontrar na " & _escProx & ", em " & FORMAT ( _prox, "dd/MM" ) & "." )
			-- 4 · Marcação
			RETURN
			    IF (
			        _band = "Sim",
			        "<div class='tela t07s'>"
			            & "<div class='leg'>"
			                & "<div class='sob sobe d2'>" & _txtDia & " · " & _esc & "</div>"
			                & "<div class='txt sobe d3'>Pela primeira vez na campanha, Lula e Flávio no mesmo palco." & _txtProx & "</div>"
			                & "<div class='nota sobe d4'>Mediação de " & _escMed & "</div>"
			            & "</div>"
			            & "<div class='dica entra d10'>passe o mouse no palco</div>"
			            & "<div class='alvo' title=''></div>"
			        & "</div>"
			    )
		displayFolder: T07 Debate\Desenho
		lineageTag: a343dab1-067d-5ec5-8062-bb57b0ab7522

	/// Texto para leitor de tela do gráfico das pesquisas em volta do debate: as médias de todos ou, com uma pesquisa clicada, o instituto dela antes e depois.
	measure 'T07 · Pesquisas · ALT' =
			VAR _inst = [T07 · escolha · instituto]
			VAR _a = [T07 · escolha · antes · diferença]
			VAR _d = [T07 · escolha · depois · diferença]
			RETURN
			    IF (
			        ISBLANK ( _inst ),
			        "Pesquisas do 2º turno em volta do debate, votos totais. Média antes: Lula " & FORMAT ( [T07 · antes · Lula], "0.0" )
			            & "% e Flávio " & FORMAT ( [T07 · antes · Flávio], "0.0" ) & "% (" & [T07 · antes · pesquisas]
			            & " pesquisas). Depois: " & FORMAT ( [T07 · depois · Lula], "0.0" ) & "% e " & FORMAT ( [T07 · depois · Flávio], "0.0" )
			            & "% (" & [T07 · depois · pesquisas] & ").",
			        _inst & ", " & [T07 · escolha · pesquisas] & IF ( [T07 · escolha · pesquisas] = 1, " pesquisa", " pesquisas" )
			            & " do 2º turno. Flávio − Lula antes do debate: " & IF ( ISBLANK ( _a ), "sem pesquisa", FORMAT ( _a, "0.0" ) & " pontos" )
			            & "; depois: " & IF ( ISBLANK ( _d ), "sem pesquisa", FORMAT ( _d, "0.0" ) & " pontos" ) & "."
			    )
		displayFolder: T07 Debate\Desenho
		lineageTag: b7465725-544a-51ca-b35c-54a6a3748365

	/// Fundo do gráfico das pesquisas em volta do debate: título, grade, datas, a linha do debate, as médias antes e depois (traço que se desenha, rótulos com contador), a média de antes prolongada em tracejado e a nota à mão. Com uma pesquisa clicada (filtro cruzado de Pesquisa[Id] vindo de T07 · Pontos · HTML), vira a lente do instituto dela: as médias de todos esmaecem, as pesquisas do instituto ganham anel e uma linha que as liga no tempo, e a manchete compara o mesmo instituto antes e depois do debate (a comparação justa: médias de institutos diferentes misturam métodos). Os pontos são outro visual (T07 · Pontos · HTML), na mesma caixa e na mesma escala.
	measure 'T07 · Pesquisas · HTML' =
			-- 1 · Leituras
			VAR _d = [T07 · debate · data]
			VAR _aL = [T07 · antes · Lula]
			VAR _aF = [T07 · antes · Flávio]
			VAR _dL = [T07 · depois · Lula]
			VAR _dF = [T07 · depois · Flávio]
			VAR _aDif = [T07 · antes · diferença]
			VAR _dDif = [T07 · depois · diferença]
			VAR _nX = [T07 · atravessa · pesquisas]
			VAR _nT = [T07 · pesquisas do 2º turno]
			VAR _a0 = [T07 · antes · primeiro campo]
			VAR _a1 = [T07 · antes · último campo]
			VAR _d0 = [T07 · depois · primeiro campo]
			VAR _d1 = [T07 · depois · último campo]
			VAR _inst = [T07 · escolha · instituto]
			VAR _iN = [T07 · escolha · pesquisas]
			VAR _iAd = [T07 · escolha · antes · data]
			VAR _iAdif = [T07 · escolha · antes · diferença]
			VAR _iDd = [T07 · escolha · depois · data]
			VAR _iDdif = [T07 · escolha · depois · diferença]
			VAR _iX = [T07 · escolha · atravessa]
			VAR _trilha =
			    FILTER (
			        ADDCOLUMNS (
			            ALLNOBLANKROW ( Pesquisa[Id] ),
			            "@i", [T07 · pesquisa · instituto],
			            "@fim", [T07 · pesquisa · campo fim],
			            "@l", [T07 · pesquisa · Lula],
			            "@f", [T07 · pesquisa · Flávio],
			            "@o", [T07 · pesquisa · ordem no dia],
			            "@n", [T07 · pesquisa · no mesmo dia]
			        ),
			        NOT ISBLANK ( _inst ) && [@i] = _inst
			    ) /* lista */
			-- 2 · Textos
			VAR _lente = NOT ISBLANK ( _inst )
			VAR _escInst = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _quemA = IF ( _aDif >= 0, "Flávio", "Lula" )
			VAR _quemD = IF ( _dDif >= 0, "Flávio", "Lula" )
			VAR _txtManTodos =
			    "Antes do debate, " & _quemA & " tinha " & FORMAT ( ABS ( _aDif ), "0.0" ) & " pontos de vantagem na média; depois, "
			        & IF ( _quemD = _quemA, "", _quemD & " passou a ter " ) & FORMAT ( ABS ( _dDif ), "0.0" ) & "."
			-- a vantagem de um lado em texto curto: "Flávio 2,0 à frente", "Lula 1,5 à frente", "empate"
			VAR _vant =
			    "#Q #V à frente"
			VAR _txtVA =
			    IF (
			        ROUND ( _iAdif, 1 ) = 0,
			        "empate",
			        SUBSTITUTE ( SUBSTITUTE ( _vant, "#Q", IF ( _iAdif > 0, "Flávio", "Lula" ) ), "#V", FORMAT ( ABS ( _iAdif ), "0.0" ) )
			    )
			VAR _txtVD =
			    IF (
			        ROUND ( _iDdif, 1 ) = 0,
			        "empate",
			        SUBSTITUTE ( SUBSTITUTE ( _vant, "#Q", IF ( _iDdif > 0, "Flávio", "Lula" ) ), "#V", FORMAT ( ABS ( _iDdif ), "0.0" ) )
			    )
			VAR _txtManInst =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _iAd ) && NOT ISBLANK ( _iDd ),
			            _escInst & ": " & _txtVA & " antes do debate (" & FORMAT ( _iAd, "dd/MM" ) & "); "
			                & IF (
			                    ROUND ( _iAdif, 1 ) <> 0 && ROUND ( _iDdif, 1 ) <> 0 && SIGN ( _iAdif ) = SIGN ( _iDdif ),
			                    FORMAT ( ABS ( _iDdif ), "0.0" ),
			                    _txtVD
			                ) & " depois (" & FORMAT ( _iDd, "dd/MM" ) & ").",
			        NOT ISBLANK ( _iAd ) && _iN = 1,
			            _escInst & " fez uma pesquisa só, antes do debate (" & FORMAT ( _iAd, "dd/MM" ) & "): " & _txtVA & ".",
			        NOT ISBLANK ( _iAd ),
			            _escInst & " não voltou a campo depois do debate: a última pesquisa antes dele, de " & FORMAT ( _iAd, "dd/MM" )
			                & ", dava " & _txtVA & ".",
			        NOT ISBLANK ( _iDd ),
			            _escInst & " só fez pesquisa depois do debate: " & _txtVD & " em " & FORMAT ( _iDd, "dd/MM" ) & ".",
			        _escInst & " só fez pesquisa com campo no dia do debate: fica fora do antes e depois."
			    )
			VAR _txtMan = IF ( _lente, _txtManInst, _txtManTodos )
			VAR _txtSob =
			    IF (
			        _lente,
			        _escInst & " · " & _iN & IF ( _iN = 1, " pesquisa", " pesquisas" ) & " do 2º turno · votos totais",
			        "As " & _nT & " pesquisas do 2º turno em volta do debate · votos totais"
			    )
			VAR _txtAL = "Lula " & FORMAT ( _aL, "0.0" ) & "%"
			VAR _txtAF = "Flávio " & FORMAT ( _aF, "0.0" ) & "%"
			VAR _txtDL = "Lula " & FORMAT ( _dL, "0.0" ) & "%"
			VAR _txtDF = "Flávio " & FORMAT ( _dF, "0.0" ) & "%"
			VAR _txtLeg =
			    IF (
			        _lente,
			        IF (
			            _iN = 1,
			            "O anel marca a única pesquisa de " & _escInst,
			            "Os anéis marcam as " & _iN & " pesquisas de " & _escInst & " e a linha liga uma à outra no tempo"
			        )
			            & IF ( _iX > 0, " (" & _iX & IF ( _iX = 1, " pegou", " pegaram" ) & " o dia do debate)", "" )
			            & " · clique de novo no ponto para voltar a todas",
			        "Cada par de pontos é uma pesquisa, no último dia de entrevistas · claros: o campo pegou o dia do debate ("
			            & _nX & ", fora das médias) · traço: a média de cada lado · clique num ponto: o mesmo instituto antes e depois"
			    )
			-- 3 · Geometria (eixo x: 06/10 a 22/10 em x 210–1400; eixo y: 38% a 54% em y 250–20; o svg começa em y 76)
			VAR _ini = DATE ( 2026, 10, 6 )
			VAR _xD = 210 + DATEDIFF ( _ini, _d, DAY ) / 16 * 1190 -- geometria
			VAR _xA0 = 210 + DATEDIFF ( _ini, _a0, DAY ) / 16 * 1190 -- geometria
			VAR _xA1 = 210 + DATEDIFF ( _ini, _a1, DAY ) / 16 * 1190 -- geometria
			VAR _xD0 = 210 + DATEDIFF ( _ini, _d0, DAY ) / 16 * 1190 - 14 -- geometria
			VAR _xD1 = 210 + DATEDIFF ( _ini, _d1, DAY ) / 16 * 1190 + 14 -- geometria
			VAR _yAL = 250 - ( _aL - 38 ) / 16 * 230 -- geometria
			VAR _yAF = 250 - ( _aF - 38 ) / 16 * 230 -- geometria
			VAR _yDL = 250 - ( _dL - 38 ) / 16 * 230 -- geometria
			VAR _yDF = 250 - ( _dF - 38 ) / 16 * 230 -- geometria
			VAR _f = "0.0"
			VAR _apaga = IF ( _lente, " apaga", "" )
			VAR _grade =
			    CONCATENATEX (
			        { 40, 45, 50 },
			        "<line x1='50' x2='1400' y1='" & FORMAT ( 250 - ( [Value] - 38 ) / 16 * 230, _f, "en-US" ) & "' y2='"
			            & FORMAT ( 250 - ( [Value] - 38 ) / 16 * 230, _f, "en-US" ) & "' class='g'/><text x='36' y='"
			            & FORMAT ( 255 - ( [Value] - 38 ) / 16 * 230, _f, "en-US" ) & "' class='ex' text-anchor='end'>" & [Value] & "%</text>",
			        ""
			    )
			VAR _datas =
			    CONCATENATEX (
			        { DATE ( 2026, 10, 7 ), DATE ( 2026, 10, 10 ), DATE ( 2026, 10, 13 ), DATE ( 2026, 10, 16 ), DATE ( 2026, 10, 22 ) },
			        "<text x='" & FORMAT ( 210 + DATEDIFF ( _ini, [Value], DAY ) / 16 * 1190, _f, "en-US" )
			            & "' y='276' class='ex' text-anchor='middle'>" & FORMAT ( [Value], "dd/MM" ) & "</text>",
			        ""
			    )
			-- a trajetória do instituto clicado: a mesma posição dos pontos (último dia de campo, com o desvio de quem terminou
			-- no mesmo dia), em coordenadas do svg
			VAR _xy =
			    ADDCOLUMNS (
			        _trilha,
			        "@x", 210 + DATEDIFF ( _ini, [@fim], DAY ) / 16 * 1190 + ( [@o] - ( [@n] - 1 ) / 2 ) * 16,
			        "@yl", 250 - ( [@l] - 38 ) / 16 * 230,
			        "@yf", 250 - ( [@f] - 38 ) / 16 * 230
			    ) /* geometria */
			VAR _linL = CONCATENATEX ( _xy, FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@yl], _f, "en-US" ), " ", [@fim], ASC, [@o], ASC )
			VAR _linF = CONCATENATEX ( _xy, FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@yf], _f, "en-US" ), " ", [@fim], ASC, [@o], ASC )
			VAR _aneis =
			    CONCATENATEX (
			        _xy,
			        "<circle cx='" & FORMAT ( [@x], _f, "en-US" ) & "' cy='" & FORMAT ( [@yl], _f, "en-US" ) & "' r='12' class='an l brota'/>"
			            & "<circle cx='" & FORMAT ( [@x], _f, "en-US" ) & "' cy='" & FORMAT ( [@yf], _f, "en-US" ) & "' r='12' class='an f brota'/>",
			        ""
			    )
			VAR _lenteSvg =
			    IF (
			        _lente,
			        IF ( COUNTROWS ( _xy ) > 1, "<polyline points='" & _linL & "' pathLength='1' class='il traco' filter='url(#rbu)'/>"
			            & "<polyline points='" & _linF & "' pathLength='1' class='if traco' filter='url(#rbu)'/>" )
			            & _aneis
			    )
			-- 4 · Marcação
			VAR _svg =
			    "<svg width='1620' height='290' viewBox='0 0 1620 290'>"
			        & _grade
			        & _datas
			        & "<line x1='" & FORMAT ( _xD, _f, "en-US" ) & "' x2='" & FORMAT ( _xD, _f, "en-US" )
			            & "' y1='58' y2='256' class='deb'/>"
			        & "<text x='" & FORMAT ( _xD, _f, "en-US" ) & "' y='276' class='ex b' text-anchor='middle'>debate · "
			            & FORMAT ( _d, "dd/MM" ) & "</text>"
			        & "<g class='medias" & _apaga & "'>"
			        & "<path d='M" & FORMAT ( _xA1, _f, "en-US" ) & " " & FORMAT ( _yAL, _f, "en-US" ) & " H1400' class='fl esmaece'/>"
			        & "<path d='M" & FORMAT ( _xA1, _f, "en-US" ) & " " & FORMAT ( _yAF, _f, "en-US" ) & " H1400' class='ff esmaece'/>"
			        & "<path d='M" & FORMAT ( _xA0, _f, "en-US" ) & " " & FORMAT ( _yAL, _f, "en-US" ) & " H" & FORMAT ( _xA1, _f, "en-US" )
			            & "' pathLength='1' class='ml traco' filter='url(#rbu)' style='animation-delay:.5s'/>"
			        & "<path d='M" & FORMAT ( _xA0, _f, "en-US" ) & " " & FORMAT ( _yAF, _f, "en-US" ) & " H" & FORMAT ( _xA1, _f, "en-US" )
			            & "' pathLength='1' class='mf traco' filter='url(#rbu)' style='animation-delay:.5s'/>"
			        & "<path d='M" & FORMAT ( _xD0, _f, "en-US" ) & " " & FORMAT ( _yDL, _f, "en-US" ) & " H" & FORMAT ( _xD1, _f, "en-US" )
			            & "' pathLength='1' class='ml traco-rapido' filter='url(#rbu)' style='animation-delay:2.2s'/>"
			        & "<path d='M" & FORMAT ( _xD0, _f, "en-US" ) & " " & FORMAT ( _yDF, _f, "en-US" ) & " H" & FORMAT ( _xD1, _f, "en-US" )
			            & "' pathLength='1' class='mf traco-rapido' filter='url(#rbu)' style='animation-delay:2.2s'/>"
			        & "</g>"
			        & _lenteSvg
			    & "</svg>"
			VAR _afasta = IF ( _yAL - _yAF < 30, 10, 0 ) -- geometria
			VAR _afastaD = IF ( _yDL - _yDF < 30, 10, 0 ) -- geometria
			VAR _rotulos =
			    "<div class='rotulo e flavio-esc entra d8" & _apaga & "' style='right:" & FORMAT ( 1620 - _xA0 + 30, _f, "en-US" ) & "px;top:"
			        & FORMAT ( 76 + _yAF - 14 - _afasta, _f, "en-US" ) & "px'>" & _txtAF & "</div>"
			        & "<div class='rotulo e lula-esc entra d8" & _apaga & "' style='right:" & FORMAT ( 1620 - _xA0 + 30, _f, "en-US" ) & "px;top:"
			        & FORMAT ( 76 + _yAL - 14 + _afasta, _f, "en-US" ) & "px'>" & _txtAL & "</div>"
			        & "<div class='rotulo flavio-esc entra d16" & _apaga & "' style='left:" & FORMAT ( _xD1 + 14, _f, "en-US" ) & "px;top:"
			        & FORMAT ( 76 + _yDF - 14 - _afastaD, _f, "en-US" ) & "px'>" & _txtDF & "</div>"
			        & "<div class='rotulo lula-esc entra d16" & _apaga & "' style='left:" & FORMAT ( _xD1 + 14, _f, "en-US" ) & "px;top:"
			        & FORMAT ( 76 + _yDL - 14 + _afastaD, _f, "en-US" ) & "px'>" & _txtDL & "</div>"
			VAR _tv =
			    "<div class='tv entra d4' style='left:" & FORMAT ( _xD - 29, _f, "en-US" ) & "px;top:84px;width:58px'></div>"
			VAR _nota =
			    IF (
			        NOT _lente,
			        "<div class='mao entra d16' style='left:" & FORMAT ( _xD1 - 6, _f, "en-US" ) & "px;top:"
			            & FORMAT ( 76 + _yDF - 88, _f, "en-US" ) & "px'>quase nada mudou</div>"
			            & "<div class='seta entra d16' style='left:" & FORMAT ( _xD1 - 84, _f, "en-US" ) & "px;top:"
			            & FORMAT ( 76 + _yDF - 66, _f, "en-US" ) & "px;width:74px'></div>"
			    )
			RETURN
			    "<div class='tela t07g'>"
			        & "<div class='cab'><div class='sob sobe'>" & _txtSob & "</div>"
			        & "<div class='man sobe d2'>" & _txtMan & "</div></div>"
			        & _svg & _tv & _rotulos & _nota
			        & "<div class='leg entra d12'><b><i style='background:var(--vermelho)'></i>Lula</b>"
			        & "<b><i style='background:var(--azul)'></i>Flávio</b>" & _txtLeg & "</div>"
			    & "</div>"
		displayFolder: T07 Debate\Desenho
		lineageTag: 0c6bf6a6-094c-50a6-aabf-525965cc82ed

	/// Texto para leitor de tela dos pontos das pesquisas (um par por pesquisa).
	measure 'T07 · Pontos · ALT' =
			"Um par de pontos por pesquisa do 2º turno (" & [T07 · pesquisas do 2º turno]
			    & "): Lula em vermelho e Flávio em azul, no último dia de entrevistas. Passe o mouse para ver o instituto."
		displayFolder: T07 Debate\Desenho
		lineageTag: 7a0aeb55-0439-599c-b7d2-80ec18decea2

	/// Um par de pontos por pesquisa do 2º turno feita depois do 1º turno (grão Pesquisa[Id]): Lula e Flávio no último dia de entrevistas, na escala do fundo (T07 · Pesquisas · HTML). Claros quando o campo pegou o dia do debate. Cada ponto é alvo do dossiê ttT07Pesquisa; vazio fora do conjunto.
	measure 'T07 · Pontos · HTML' =
			-- 1 · Leituras
			VAR _jan = [T07 · pesquisa · janela]
			VAR _l = [T07 · pesquisa · Lula]
			VAR _f = [T07 · pesquisa · Flávio]
			VAR _fim = [T07 · pesquisa · campo fim]
			VAR _ord = [T07 · pesquisa · ordem no dia]
			VAR _n = [T07 · pesquisa · no mesmo dia]
			-- 2 · Textos
			VAR _cls = IF ( _jan = "atravessa", " atr", "" )
			-- 3 · Geometria (mesma escala do fundo; o svg do fundo começa em y 76; ponto de 15 px)
			VAR _dias = DATEDIFF ( DATE ( 2026, 10, 6 ), _fim, DAY )
			VAR _x = 210 + _dias / 16 * 1190 + ( _ord - ( _n - 1 ) / 2 ) * 16 - 7.5 -- geometria
			VAR _yl = 76 + 250 - ( _l - 38 ) / 16 * 230 - 7.5 -- geometria
			VAR _yf = 76 + 250 - ( _f - 38 ) / 16 * 230 - 7.5 -- geometria
			VAR _atraso = 700 + _dias * 70 + _ord * 40 -- geometria
			VAR _fx = FORMAT ( _x, "0.0", "en-US" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _jan ),
			        "<div class='tela t07p'>"
			            & "<i class='pt l" & _cls & "' style='left:" & _fx & "px;top:" & FORMAT ( _yl, "0.0", "en-US" )
			            & "px;animation-delay:" & _atraso & "ms'></i>"
			            & "<i class='pt f" & _cls & "' style='left:" & _fx & "px;top:" & FORMAT ( _yf, "0.0", "en-US" )
			            & "px;animation-delay:" & _atraso + 60 & "ms'></i>"
			        & "</div>"
			    )
		displayFolder: T07 Debate\Desenho
		lineageTag: 2aacf51f-4f1f-5b26-917b-75e3c7c6f41e

	/// Texto para leitor de tela do dossiê de um debate (grão Debate[Data]).
	measure 'T07 · Tooltip debate · ALT' =
			IF (
			    NOT ISBLANK ( [T07 · debate · situação] ),
			    LEFT (
			        FORMAT ( [T07 · debate · dia], "dd/MM" ) & ", " & [T07 · debate · emissora] & ": " & [T07 · debate · situação]
			            & IF ( [T07 · debate · frente a frente] = "Sim", ", com Lula e Flávio frente a frente", ", sem Lula e Flávio" ) & ".",
			        250
			    )
			)
		displayFolder: T07 Debate\Desenho
		lineageTag: cb76bb6b-1477-58fa-bf27-56a47dbe479a

	/// Dossiê de um debate marcado na campanha (ttT07Debate, grão Debate[Data]): data, turno e situação, a emissora, quem foi (ou por que caiu) e a nota à mão. Foco em Lula e Flávio: nos debates sem os dois, só a lista de quem foi; no frente a frente seguinte ao da Band (a Globo, 23/10), o aviso de que os números da noite estão na tela dele.
	measure 'T07 · Tooltip debate · HTML' =
			-- 1 · Leituras
			VAR _sit = [T07 · debate · situação]
			VAR _ff = [T07 · debate · frente a frente]
			VAR _dia = [T07 · debate · dia]
			VAR _turno = [T07 · debate · turno]
			VAR _emi = [T07 · debate · emissora]
			VAR _part = [T07 · debate · participantes]
			VAR _med = [T07 · debate · mediação]
			VAR _motivo = [T07 · debate · motivo]
			VAR _seg = [T07 · debate seguinte · data]
			-- 2 · Textos
			VAR _escEmi = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _emi, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escPart = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _part, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escMed = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _med, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _mot1 = SUBSTITUTE ( SUBSTITUTE ( _motivo, "NÃO REALIZADO:", "Não realizado:" ), "CANCELADO", "Cancelado" )
			VAR _escMot = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mot1, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txt =
			    SWITCH (
			        TRUE (),
			        _ff = "Sim",
			            "Lula e Flávio frente a frente, com mediação de " & _escMed & "."
			                & IF ( NOT ISBLANK ( _seg ) && _dia = _seg, " Os números da noite estão na tela própria deste debate." ),
			        _sit = "realizado", "Aconteceu sem Lula e sem Flávio. Foram: " & _escPart & ".",
			        _escMot & "."
			    )
			VAR _mao = SWITCH ( TRUE (), _ff = "Sim", "frente a frente", _sit = "realizado", "os dois faltaram", "não aconteceu" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _sit ),
			        "<div>"
			            & "<div class='sob sobe'>" & FORMAT ( _dia, "dd/MM" ) & " · " & _turno & "º turno · " & _sit & "</div>"
			            & "<div class='tt sobe d2'>" & _escEmi & "</div>"
			            & "<div class='txt sobe d3'>" & _txt & "</div>"
			            & "<div class='mao" & IF ( _ff = "Sim", "", " ti" ) & " entra d6'>" & _mao & "</div>"
			        & "</div>"
			    )
		displayFolder: T07 Debate\Desenho
		lineageTag: 07f423dc-4477-5d91-9def-818c4ebda790

	/// Texto para leitor de tela do dossiê do palco.
	measure 'T07 · Tooltip palco · ALT' =
			IF (
			    [T07 · debate · o da Band] = "Sim",
			    "Lula: Eu desafio você, amanhã abrimos a nossa conta bancária. Flávio: Aqui é o Flávio, não é o Jair. Quaest: nota "
			        & [T07 · Quaest · nota Flávio] & " para Flávio e " & [T07 · Quaest · nota Lula] & " para Lula."
			)
		displayFolder: T07 Debate\Desenho
		lineageTag: 351c4279-5f75-5f04-942d-b74ddb0f899f

	/// Dossiê do palco (ttT07Palco, linha do debate da Band de 18/10, T07 · debate · o da Band): uma frase de cada um (Aos Fatos, Congresso em Foco, Agência Brasil), a nota dos grupos da Quaest e a audiência dos debates da Band em 2022 e 2026 (barras que crescem). Só lê contas 'T07 · …'.
	measure 'T07 · Tooltip palco · HTML' =
			-- 1 · Leituras
			VAR _band = [T07 · debate · o da Band]
			VAR _dia = [T07 · debate · dia]
			VAR _qF = [T07 · Quaest · nota Flávio]
			VAR _qL = [T07 · Quaest · nota Lula]
			VAR _b22a = [T07 · audiência · Band 2022 1º turno]
			VAR _b22b = [T07 · audiência · Band 2022 2º turno]
			VAR _b26a = [T07 · audiência · Band 1º turno 2026]
			VAR _b26b = [T07 · audiência]
			-- 2 · Textos
			VAR _txtQ =
			    "Nos 30 grupos de eleitores que a Quaest reuniu para assistir, a nota média foi " & _qF & " para Flávio e "
			        & _qL & " para Lula. O instituto não viu virada."
			-- 3 · Geometria (barras deitadas de até 240 px)
			VAR _max = MAX ( MAX ( _b22a, _b22b ), MAX ( _b26a, _b26b ) ) -- geometria
			VAR _lista =
			    DATATABLE (
			        "Ordem", INTEGER, "Rotulo", STRING,
			        { { 1, "2022 · 1º turno" }, { 2, "2022 · 2º turno" }, { 3, "2026 · 1º turno, sem os dois" }, { 4, "2026 · 2º turno, os dois" } }
			    )
			VAR _barras =
			    CONCATENATEX (
			        ADDCOLUMNS ( _lista, "@v", SWITCH ( [Ordem], 1, _b22a, 2, _b22b, 3, _b26a, _b26b ) ),
			        "<div class='bar" & IF ( [Ordem] = 4, " n", "" ) & " entra d" & ( 5 + [Ordem] ) & "'><span>" & [Rotulo]
			            & "</span><div><i style='width:" & FORMAT ( [@v] / _max * 240, "0.0", "en-US" ) & "px;animation-delay:"
			            & ( 300 + [Ordem] * 120 ) & "ms'></i><b>" & IF ( INT ( [@v] ) = [@v], FORMAT ( [@v], "0" ), FORMAT ( [@v], "0.0" ) )
			            & "</b></div></div>",
			        "",
			        [Ordem], ASC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        _band = "Sim",
			        "<div class='tt7s'>"
			            & "<div class='sob sobe'>" & FORMAT ( _dia, "dd/MM" ) & " · uma frase de cada um</div>"
			            & "<div class='cit l sobe d2'>“Eu desafio você. Amanhã abrimos a nossa conta bancária.”"
			                & "<small>Lula, ao propor que os dois abrissem os sigilos bancários</small></div>"
			            & "<div class='cit f sobe d3'>“Aqui é o Flávio, não é o Jair.”"
			                & "<small>Flávio, ao falar de armas</small></div>"
			            & "<div class='txt sobe d4'>" & _txtQ & "</div>"
			            & "<hr class='entra d5'/>"
			            & "<div class='sob sobe d5'>Audiência na Band · pontos na Grande SP</div>"
			            & _barras
			        & "</div>"
			    )
		displayFolder: T07 Debate\Desenho
		lineageTag: 5eea45f5-c8b3-5326-9519-2a873971df98

	/// Texto para leitor de tela do dossiê de uma pesquisa (grão Pesquisa[Id]).
	measure 'T07 · Tooltip pesquisa · ALT' =
			IF (
			    NOT ISBLANK ( [T07 · pesquisa · janela] ),
			    [T07 · pesquisa · instituto] & ", campo até " & FORMAT ( [T07 · pesquisa · campo fim], "dd/MM" ) & ": Lula "
			        & FORMAT ( [T07 · pesquisa · Lula], "0.0" ) & "% e Flávio " & FORMAT ( [T07 · pesquisa · Flávio], "0.0" )
			        & "%, margem de erro de " & FORMAT ( [T07 · pesquisa · margem de erro], "0.0" ) & " pontos."
			)
		displayFolder: T07 Debate\Desenho
		lineageTag: cfda87b2-3edb-561b-a2c0-9bfd682566cc

	/// Dossiê de uma pesquisa do gráfico do debate (ttT07Pesquisa, grão Pesquisa[Id]): instituto e campo, Lula × Flávio, quem estava à frente e por quanto, a pesquisa anterior do MESMO instituto (a comparação mais limpa), entrevistas, margem e registro, e a nota à mão com a janela (antes, depois, pegou o dia do debate).
	measure 'T07 · Tooltip pesquisa · HTML' =
			-- 1 · Leituras
			VAR _jan = [T07 · pesquisa · janela]
			VAR _inst = [T07 · pesquisa · instituto]
			VAR _ini = [T07 · pesquisa · campo início]
			VAR _fim = [T07 · pesquisa · campo fim]
			VAR _l = [T07 · pesquisa · Lula]
			VAR _f = [T07 · pesquisa · Flávio]
			VAR _dif = [T07 · pesquisa · diferença]
			VAR _difAnt = [T07 · pesquisa · diferença anterior]
			VAR _campoAnt = [T07 · pesquisa · campo anterior]
			VAR _n = [T07 · pesquisa · entrevistas]
			VAR _m = [T07 · pesquisa · margem de erro]
			VAR _reg = [T07 · pesquisa · registro]
			-- 2 · Textos
			VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escReg = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			VAR _txtDif =
			    SWITCH (
			        TRUE (),
			        _dif > 0, "Flávio " & FORMAT ( _dif, "0.0" ) & IF ( ROUND ( _dif, 1 ) = 1, " ponto", " pontos" ) & " à frente",
			        _dif < 0, "Lula " & FORMAT ( -_dif, "0.0" ) & IF ( ROUND ( -_dif, 1 ) = 1, " ponto", " pontos" ) & " à frente",
			        "Empate"
			    )
			VAR _txtAnt =
			    IF (
			        ISBLANK ( _difAnt ),
			        "É a primeira pesquisa deste instituto depois do 1º turno.",
			        "Na anterior do mesmo instituto (campo até " & FORMAT ( _campoAnt, "dd/MM" ) & "): "
			            & SWITCH (
			                TRUE (),
			                _difAnt > 0, "Flávio " & FORMAT ( _difAnt, "0.0" ) & " à frente",
			                _difAnt < 0, "Lula " & FORMAT ( -_difAnt, "0.0" ) & " à frente",
			                "empate"
			            ) & "."
			    )
			VAR _txtJan =
			    SWITCH (
			        _jan,
			        "antes", "antes do debate",
			        "depois", "depois do debate",
			        "pegou o dia do debate"
			    )
			VAR _txtFora = IF ( _jan = "atravessa", " O campo pegou o dia do debate: fica fora das médias.", "" )
			VAR _txtReg = IF ( ISBLANK ( _reg ), "", " · <span style='white-space:nowrap'>" & _escReg & "</span>" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _jan ),
			        "<div class='tt7p'>"
			            & "<div class='sob sobe'>" & _esc & " · campo de " & FORMAT ( _ini, "dd/MM" ) & " a " & FORMAT ( _fim, "dd/MM" ) & "</div>"
			            & "<div class='par sobe d2'>"
			                & "<div class='lula'><small>Lula</small><span class='num'>" & FORMAT ( _l, "0.0" ) & "%</span></div>"
			                & "<div class='flavio'><small>Flávio</small><span class='num'>" & FORMAT ( _f, "0.0" ) & "%</span></div>"
			            & "</div>"
			            & "<div class='txt sobe d3'><b>" & _txtDif & ".</b> " & _txtAnt & _txtFora & "</div>"
			            & "<div class='nota sobe d4'>" & FORMAT ( _n, "#,0" ) & " entrevistas · margem de erro de " & FORMAT ( _m, "0.0" )
			            & " pontos" & _txtReg & "</div>"
			            & "<div class='mao" & IF ( _jan = "atravessa", " ti", "" ) & " entra d6'>" & _txtJan & "</div>"
			        & "</div>"
			    )
		displayFolder: T07 Debate\Desenho
		lineageTag: eab504a0-80ae-5cd8-a1db-8e79a4ccccc1

	/// Início oficial da campanha de 2026: 16/08, o primeiro dia de propaganda eleitoral (Lei 9.504/97, art. 36: só depois de 15 de agosto do ano da eleição). É a marca '16/08 · campanha' da curva e o começo da conta dos dias da campanha; a curva começa antes, em 01/08, no começo da consulta T2 do Google Trends.
	measure 'T08 · campanha · início' =
			DATE ( 2026, 8, 16 )
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: 48be3999-7e75-5766-a44c-daa640df8b8e

	/// Parte do interesse de busca de Flávio entre os dois nos últimos 30 dias (22/09 a 22/10), no resumo da Central Google Trends Eleições 2026. Constante: dados/bruto/digital/FONTES.md e a Observação das linhas C1.
	measure 'T08 · Central · Flávio' =
			0.44
		formatString: 0%
		displayFolder: T08 Buscas\Contas
		lineageTag: 58de968e-afd1-5777-b45e-a4a2d0073d08

	/// Parte do interesse de busca de Lula entre os dois nos últimos 30 dias (22/09 a 22/10), no resumo da Central Google Trends Eleições 2026. Constante: dados/bruto/digital/FONTES.md e a Observação das linhas C1 ('Lula 56% x Flávio 44% do interesse').
	measure 'T08 · Central · Lula' =
			0.56
		formatString: 0%
		displayFolder: T08 Buscas\Contas
		lineageTag: 9a7260cc-a1b4-5654-ba03-9c2830fcfe5b

	/// Dias da curva diária (série T2, 01/08 a 22/10; a curva do estado usa os mesmos dias): uma faixa por dia.
	measure 'T08 · curva · dias' =
			CALCULATE (
			    COUNTROWS ( VALUES ( 'Trends tempo'[DataTexto] ) ),
			    REMOVEFILTERS ( 'Trends tempo' ),
			    'Trends tempo'[Série] = "Lula [tópico | T2]"
			) + 0
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 64011c68-aeb2-5622-be33-d55577ee3b0e

	/// Último dia da curva (o fim da série T2, 22/10): a curva do estado usa os mesmos dias.
	measure 'T08 · curva · último dia' =
			CALCULATE (
			    MAX ( 'Trends tempo'[Momento] ),
			    REMOVEFILTERS ( 'Trends tempo' ),
			    'Trends tempo'[Série] = "Lula [tópico | T2]"
			)
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: ecce4fc8-1dd3-582b-8735-99d5eb359cc9

	/// Ponto da série diária do Google Trends que tem a noite do debate da Globo: o dia seguinte (o Google fecha o dia às 21h de Brasília; o debate foi das 21h20 às 23h50 de 23/10). Regra explícita: Debate com Emissora = Globo e Turno = 2.
	measure 'T08 · debate Globo · dia no Google' =
			CALCULATE (
			    MAX ( Debate[Data] ),
			    REMOVEFILTERS ( Debate ),
			    Debate[Emissora] = "Globo",
			    Debate[Turno] = 2
			) + 1
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: 9e6e45d6-3e43-5f81-9374-d507c1e477d9

	/// Data do debate da Band no 2º turno, o primeiro frente a frente de Lula e Flávio (a marca 'debate' da curva das buscas, que vai até 22/10). Regra explícita e neutra (24/10/2026): a linha da tabela Debate com Emissora = "Band" e Turno = 2. Não usa o MAX(Data) das linhas com os dois nos participantes: com o debate da Globo (23/10) na tabela, esse máximo passaria a ser a Globo.
	measure 'T08 · debate · data' =
			CALCULATE (
			    MAX ( Debate[Data] ),
			    REMOVEFILTERS ( Debate ),
			    Debate[Emissora] = "Band",
			    Debate[Turno] = 2
			)
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: fd962ad8-46ea-5866-8ebf-f8ef55e8f37f

	/// Ponto da série diária do Google Trends que tem a noite do debate da Band: o dia seguinte (o Google fecha o dia às 21h de Brasília, em UTC; o debate foi das 20h20 às 22h04 de 18/10). As contas da curva comparam com ele.
	measure 'T08 · debate · dia no Google' =
			[T08 · debate · data] + 1
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: d6f20086-8cf9-5aa0-ada5-634a016d786a

	/// Índice de Flávio no dia do debate da Band, na série que a curva mostra (Brasil, T2, ou o estado clicado, U2).
	measure 'T08 · debate · Flávio' =
			VAR _d = [T08 · debate · dia no Google]
			RETURN
			    CALCULATE (
			        [T08 · dia · Flávio],
			        REMOVEFILTERS ( 'Trends tempo' ),
			        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: aed6c9cd-bd71-5f44-9905-81ae021922e7

	/// Índice de Lula no dia do debate da Band, na série que a curva mostra (Brasil, T2, ou o estado clicado, U2).
	measure 'T08 · debate · Lula' =
			VAR _d = [T08 · debate · dia no Google]
			RETURN
			    CALCULATE (
			        [T08 · dia · Lula],
			        REMOVEFILTERS ( 'Trends tempo' ),
			        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 896ea727-d069-56e2-aedb-dd7e24f4f49f

	/// Dias da curva depois do debate (19 a 22/10).
	measure 'T08 · depois do debate · dias' =
			VAR _deb = [T08 · debate · dia no Google]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _dias, [@d] > _deb ) ) + 0
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: bd12b64d-b360-5e14-8e14-73375ec21848

	/// Dias da curva depois do debate em que quem liderava no dia do debate seguiu na frente, na série que a curva mostra (igual a T08 · depois do debate · dias = ficou na frente em todos).
	measure 'T08 · depois do debate · dias com o líder à frente' =
			VAR _deb = [T08 · debate · dia no Google]
			VAR _quem = [T08 · virada · quem passa]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@l", [T08 · dia · Lula],
			        "@f", [T08 · dia · Flávio]
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _quem ),
			        COUNTROWS ( FILTER ( _dias, [@d] > _deb && IF ( _quem = "Flávio", [@l] > [@f], [@f] > [@l] ) ) ) + 0
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: e033a6be-60d3-5906-abaa-04b20f4552c3

	/// Maior índice dos dois na curva do segundo dia depois do pico até o fim (06 a 22/10): diz se a nota da virada cabe acima das linhas.
	measure 'T08 · depois do pico · maior índice' =
			VAR _p = [T08 · pico · data]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@m", MAX ( [T08 · dia · Lula], [T08 · dia · Flávio] )
			    )
			RETURN
			    MAXX ( FILTER ( _dias, [@d] > _p + 1 ), [@m] )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 3672a369-79e8-5ab1-9c86-c9836b9f5bdf

	/// Data do dia da linha na série diária T2 (vazio nas linhas por hora e fora da série).
	measure 'T08 · dia · data' =
			IF (
			    HASONEVALUE ( 'Trends tempo'[DataTexto] ),
			    CALCULATE ( MAX ( 'Trends tempo'[Momento] ), 'Trends tempo'[Série] = "Lula [tópico | T2]" )
			)
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: 3d5d88fb-61d4-5745-82c7-e7371140be75

	/// Lula − Flávio no índice T2 do dia da linha (positivo: Lula mais buscado).
	measure 'T08 · dia · diferença' =
			[T08 · dia · Lula] - [T08 · dia · Flávio]
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: be9ed705-3c9b-5f1f-b3a5-96cc8522de52

	/// Índice do Google Trends (0–100) de Flávio no dia da linha (grão 'Trends tempo'[DataTexto]), na série que a curva mostra: sem estado clicado, a consulta T2 do Brasil (os 5 candidatos como tópico); com um estado clicado nos cartões (T08 · escolha · UF), a consulta U2 daquele estado ('Trends UF tempo', Lula × Flávio, 100 = o pico dentro do estado), nos mesmos dias da curva (01/08 a 22/10). Vazio nas linhas por hora.
	measure 'T08 · dia · Flávio' =
			VAR _uf = [T08 · escolha · UF]
			RETURN
			    IF (
			        ISBLANK ( _uf ),
			        -- Brasil: consulta T2
			        IF (
			            HASONEVALUE ( 'Trends tempo'[DataTexto] ),
			            CALCULATE ( MAX ( 'Trends tempo'[Índice] ), 'Trends tempo'[Série] = "Flávio Bolsonaro [tópico | T2]" )
			        ),
			        -- estado clicado: consulta U2 do estado, no dia da curva
			        VAR _d = [T08 · dia · data]
			        RETURN
			            IF (
			                NOT ISBLANK ( _d ),
			                CALCULATE (
			                    MAX ( 'Trends UF tempo'[Índice] ),
			                    'Trends UF tempo'[UF] = _uf,
			                    'Trends UF tempo'[Data] = _d,
			                    'Trends UF tempo'[Série] = "Flávio Bolsonaro [tópico | U2]"
			                )
			            )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 06d79771-ce8d-5277-82b0-551205f483ce

	/// Hora (0–23) em que Flávio teve o maior índice por hora no dia da linha (a primeira, se empatar).
	measure 'T08 · dia · hora do pico · Flávio' =
			VAR _dia = SELECTEDVALUE ( 'Trends tempo'[DataTexto] )
			VAR _pico = [T08 · dia · pico na hora · Flávio]
			RETURN
			    IF (
			        NOT ISBLANK ( _pico ),
			        CALCULATE (
			            MINX ( 'Trends tempo', VALUE ( MID ( 'Trends tempo'[DataTexto], 12, 2 ) ) ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            LEFT ( 'Trends tempo'[DataTexto], 10 ) = _dia,
			            'Trends tempo'[Série] IN { "Flávio Bolsonaro [tópico | H1]", "Flávio Bolsonaro [tópico | H2]" },
			            'Trends tempo'[Índice] = _pico
			        )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: f4da5d25-dd5a-5a5b-a07c-487a11975299

	/// Hora (0–23) em que Lula teve o maior índice por hora no dia da linha (a primeira, se empatar).
	measure 'T08 · dia · hora do pico · Lula' =
			VAR _dia = SELECTEDVALUE ( 'Trends tempo'[DataTexto] )
			VAR _pico = [T08 · dia · pico na hora · Lula]
			RETURN
			    IF (
			        NOT ISBLANK ( _pico ),
			        CALCULATE (
			            MINX ( 'Trends tempo', VALUE ( MID ( 'Trends tempo'[DataTexto], 12, 2 ) ) ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            LEFT ( 'Trends tempo'[DataTexto], 10 ) = _dia,
			            'Trends tempo'[Série] IN { "Lula [tópico | H1]", "Lula [tópico | H2]" },
			            'Trends tempo'[Índice] = _pico
			        )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: b4a8ad07-c4cc-56db-8619-4d0db5ca6217

	/// Quantas horas do dia da linha têm índice por hora (consultas H1, 01 a 07/10, e H2, 15 a 21/10); 0 nos outros dias.
	measure 'T08 · dia · horas' =
			VAR _dia = SELECTEDVALUE ( 'Trends tempo'[DataTexto] )
			RETURN
			    IF (
			        HASONEVALUE ( 'Trends tempo'[DataTexto] ),
			        CALCULATE (
			            COUNTROWS ( 'Trends tempo' ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            LEFT ( 'Trends tempo'[DataTexto], 10 ) = _dia,
			            LEN ( 'Trends tempo'[DataTexto] ) > 10,
			            CONTAINSSTRING ( 'Trends tempo'[Série], "Lula [tópico | H" )
			        ) + 0
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 33580e7a-e48f-5e63-b619-49d43f79ef79

	/// Índice do Google Trends (0–100) de Lula no dia da linha (grão 'Trends tempo'[DataTexto]), na série que a curva mostra: sem estado clicado, a consulta T2 do Brasil (os 5 candidatos como tópico); com um estado clicado nos cartões (T08 · escolha · UF), a consulta U2 daquele estado ('Trends UF tempo', Lula × Flávio, 100 = o pico dentro do estado), nos mesmos dias da curva (01/08 a 22/10). Vazio nas linhas por hora.
	measure 'T08 · dia · Lula' =
			VAR _uf = [T08 · escolha · UF]
			RETURN
			    IF (
			        ISBLANK ( _uf ),
			        -- Brasil: consulta T2
			        IF (
			            HASONEVALUE ( 'Trends tempo'[DataTexto] ),
			            CALCULATE ( MAX ( 'Trends tempo'[Índice] ), 'Trends tempo'[Série] = "Lula [tópico | T2]" )
			        ),
			        -- estado clicado: consulta U2 do estado, no dia da curva
			        VAR _d = [T08 · dia · data]
			        RETURN
			            IF (
			                NOT ISBLANK ( _d ),
			                CALCULATE (
			                    MAX ( 'Trends UF tempo'[Índice] ),
			                    'Trends UF tempo'[UF] = _uf,
			                    'Trends UF tempo'[Data] = _d,
			                    'Trends UF tempo'[Série] = "Lula [tópico | U2]"
			                )
			            )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 79a19ed7-ddd2-5345-85d6-be69b3c77941

	/// O que foi o dia, para o leitor: dia do 1º turno, véspera, noite do debate da Band ou da Globo (o dia do Google), um dia depois do debate ou o dia da semana.
	measure 'T08 · dia · marco' =
			VAR _d = [T08 · dia · data]
			VAR _deb = [T08 · debate · dia no Google]
			VAR _glo = [T08 · debate Globo · dia no Google]
			VAR _t1 = DATE ( 2026, 10, 4 )
			RETURN
			    IF (
			        NOT ISBLANK ( _d ),
			        SWITCH (
			            TRUE (),
			            _d = _t1, "dia do 1º turno",
			            _d = _t1 - 1, "véspera do 1º turno",
			            _d = _deb, "noite do debate da Band",
			            _d = _deb + 1, "um dia depois do debate da Band",
			            _d = _glo, "noite do debate da Globo",
			            FORMAT ( _d, "dddd" )
			        )
			    )
		displayFolder: T08 Buscas\Contas
		lineageTag: 9cce4c94-7714-5127-937e-810f6503b924

	/// Por que o índice do dia é 0 no estado clicado (lido da Observação da consulta U2): busca abaixo do mínimo que o Google mede, provável falha de coleta (19 a 21/09) ou as duas coisas sem dar para separar; vazio sem zero e no Brasil.
	measure 'T08 · dia · nota do zero' =
			VAR _uf = [T08 · escolha · UF]
			VAR _d = [T08 · dia · data]
			VAR _obs =
			    IF (
			        NOT ISBLANK ( _uf ) && NOT ISBLANK ( _d ),
			        CALCULATE (
			            CONCATENATEX ( 'Trends UF tempo', 'Trends UF tempo'[Observação], " | " ),
			            'Trends UF tempo'[UF] = _uf,
			            'Trends UF tempo'[Data] = _d,
			            'Trends UF tempo'[Índice] = 0
			        )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _obs ) || _obs = "", BLANK (),
			        CONTAINSSTRING ( _obs, "não dá para separar" ), "pouca busca no estado ou falha de coleta do Google",
			        CONTAINSSTRING ( _obs, "lacuna" ), "provável falha de coleta do Google",
			        "busca abaixo do mínimo que o Google mede"
			    )
		displayFolder: T08 Buscas\Contas
		lineageTag: b7c94b44-c055-5239-a5f6-ca2febb00965

	/// Parte de Flávio na soma dos dois índices do dia (candidatos como tópico, consulta T2).
	measure 'T08 · dia · parte Flávio' =
			VAR _l = [T08 · dia · Lula]
			VAR _f = [T08 · dia · Flávio]
			RETURN
			    IF ( NOT ISBLANK ( _l ) && NOT ISBLANK ( _f ), DIVIDE ( _f, _l + _f ) )
		formatString: 0%
		displayFolder: T08 Buscas\Contas
		lineageTag: 3f488258-e203-52d7-9a1f-7f41a1cc0453

	/// Parte de Lula na soma dos dois índices do dia (candidatos como tópico, consulta T2).
	measure 'T08 · dia · parte Lula' =
			VAR _l = [T08 · dia · Lula]
			VAR _f = [T08 · dia · Flávio]
			RETURN
			    IF ( NOT ISBLANK ( _l ) && NOT ISBLANK ( _f ), DIVIDE ( _l, _l + _f ) )
		formatString: 0%
		displayFolder: T08 Buscas\Contas
		lineageTag: ded84514-76d1-549b-a847-2ccd4ebc13e2

	/// Maior índice por hora de Flávio no dia da linha (consultas H1/H2); vazio quando o dia não tem série por hora.
	measure 'T08 · dia · pico na hora · Flávio' =
			VAR _dia = SELECTEDVALUE ( 'Trends tempo'[DataTexto] )
			RETURN
			    CALCULATE (
			        MAX ( 'Trends tempo'[Índice] ),
			        REMOVEFILTERS ( 'Trends tempo' ),
			        LEFT ( 'Trends tempo'[DataTexto], 10 ) = _dia,
			        'Trends tempo'[Série] IN { "Flávio Bolsonaro [tópico | H1]", "Flávio Bolsonaro [tópico | H2]" }
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: e1fb8cd5-aec0-5c80-9a57-d3ffeaeda065

	/// Maior índice por hora de Lula no dia da linha (consultas H1/H2); vazio quando o dia não tem série por hora.
	measure 'T08 · dia · pico na hora · Lula' =
			VAR _dia = SELECTEDVALUE ( 'Trends tempo'[DataTexto] )
			RETURN
			    CALCULATE (
			        MAX ( 'Trends tempo'[Índice] ),
			        REMOVEFILTERS ( 'Trends tempo' ),
			        LEFT ( 'Trends tempo'[DataTexto], 10 ) = _dia,
			        'Trends tempo'[Série] IN { "Lula [tópico | H1]", "Lula [tópico | H2]" }
