/// Medidas do painel: contas (todo número que o leitor vê) e desenho (HTML, ALT, specs). Gerada a partir de pbi/dax/**/*.dax por pbi/scripts/gerar_modelo.py; não edite à mão.
table _Medidas
	lineageTag: a6088f3f-0f2d-54d6-94ab-8b4718ad59d0

	/// Texto alternativo do filtro de estado (árvore Região › Estado): o recorte em uso, lido de cima para baixo pela medida comum [Recorte · nome] ('Filtro de estado: Nordeste', 'Filtro de estado: MG e SP'); sem escolha, todo o Brasil.
	measure 'Casca · filtro · ALT' =
			IF (
			    [Recorte · com escolha] = 1,
			    "Filtro de estado: " & [Recorte · nome],
			    "Filtro de estado: todo o Brasil"
			)
		displayFolder: _Casca
		lineageTag: 0bc48597-3d09-5b03-ba8b-ce9a0a502288

	/// Ordem do estado na árvore do filtro de estado (papel itemSort): a região do Norte ao Sul, depois o nome ('UF'[Ordem]). A árvore Região › Estado é montada nessa ordem.
	measure 'Casca · filtro · ordem' =
			MIN ( 'UF'[Ordem] )
		formatString: 0
		displayFolder: _Casca
		lineageTag: 2bc9315f-abc1-537f-9135-52d3909a6d02

	/// Texto alternativo do filtro de período: o recorte em uso.
	measure 'Casca · período · ALT' =
			VAR _p = [Período · rótulo]
			RETURN
			    IF ( ISBLANK ( _p ), "Filtro de período: o 2º turno inteiro", "Filtro de período: " & _p )
		displayFolder: _Casca
		lineageTag: 104522f4-86f5-5b52-8599-7c3280609315

	/// Ordem do período na lista do filtro Período (papel itemSort).
	measure 'Casca · período · ordem' =
			MIN ( 'Período'[Ordem] )
		formatString: 0
		displayFolder: _Casca
		lineageTag: 971ecba8-31de-5ae2-b373-a34dd5bea359

	/// Conteúdo vazio para os HTML Content cujo desenho é todo fixo (o bodyTemplate traz a casca da página).
	measure 'Casca · vazio' =
			" "
		displayFolder: _Estilo
		lineageTag: 41f61fe2-8a6e-56ac-b215-1f813c9c0f86

	/// Folha de estilo comum de todos os HTML Content: Sora e Caveat embutidas (woff2 base64), cores, tipografia e o kit de movimento. Gerada por pbi/scripts/estilo.py.
	measure 'Estilo · CSS' =
			"@font-face{font-family:'Sora Eleicoes';font-style:normal;font-weight:300 800;font-display:block;src:url(data:font/woff2;base64,"
			    & ""
			    & ""
			    & ""
			    & ""
			    & ""
			    & ") format('woff2')}@font-face{font-family:'Caveat Eleicoes';font-style:normal;font-weight:400 700;font-display:block;src:url(data:font/woff2;base64,"
			    & ""
			    & ""
			    & ""
			    & ""
			    & ""
			    & ") format('woff2')}@font-face{font-family:'Sora Setas';font-style:normal;font-weight:300 550;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}@font-face{font-family:'Sora Setas';font-style:normal;font-weight:551 800;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}:root{--papel:#F1EBDF;--creme:#E5DBC8;--areia:#CBBDA2;--tinta:#1C1915;--grafite:#48423A;--cinza:#6B6357;--vermelho:#B8322A;--vermelho-escuro:#8E2620;--rosa:#D9877B;--azul:#2B5797;--azul-escuro:#1D3C6E;--azul-claro:#8FA8CF;--marrom:#7A5A43;--branco:#FBF8F2;--fonte:'Sora Eleicoes','Sora Setas','Segoe UI',sans-serif;--mao:'Caveat Eleicoes','Sora Setas','Segoe Print',cursive}html,body{margin:0;padding:0;background:transparent;overflow:hidden}body,#htmlViewer,#htmlContent{font-family:var(--fonte);color:var(--tinta);-webkit-font-smoothing:antialiased;font-feature-settings:'kern' 1,'lnum' 1;text-rendering:geometricPrecision}.tela{position:fixed;inset:0;will-change:transform}*{box-sizing:border-box}svg{overflow:visible}.tnum{font-variant-numeric:tabular-nums lining-nums}.sob{font-size:15px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--grafite)}.tit{font-size:30px;font-weight:600;letter-spacing:-.012em;line-height:1.18}.man{font-size:24px;font-weight:600;letter-spacing:-.01em;line-height:1.25}.txt{font-size:17px;font-weight:400;line-height:1.45;color:var(--grafite)}.rot{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--cinza)}.nota{font-size:13px;font-weight:400;color:var(--cinza);line-height:1.4}.num{font-weight:700;letter-spacing:-.025em;line-height:1;font-variant-numeric:tabular-nums lining-nums}.mao{font-family:var(--mao);font-size:26px;font-weight:600;line-height:1.05}.lula{color:var(--vermelho)}.flavio{color:var(--azul)}.lula-esc{color:var(--vermelho-escuro)}.flavio-esc{color:var(--azul-escuro)}.escuro{color:var(--creme)}.escuro .sob,.escuro .rot,.escuro .nota{color:var(--areia)}.escuro .txt{color:var(--creme)}@keyfr"
			    & "ames uSobe{from{opacity:0;transform:translateY(14px)}}@keyframes uEntra{from{opacity:0}}@keyframes uCresceX{from{transform:scaleX(0)}}@keyframes uCresceY{from{transform:scaleY(0)}}@keyframes eTraco{from{stroke-dashoffset:1}}@keyframes eCor{from{fill:var(--creme);fill-opacity:.35}}@keyframes eCorEsc{from{fill:var(--tinta);fill-opacity:.2}}@keyframes eEscala{from{opacity:0;transform:scale(.4)}}.sobe{animation:uSobe .7s cubic-bezier(.2,.7,.2,1) both}.entra{animation:uEntra .8s ease-out both}.barra-x{transform-origin:left center;animation:uCresceX 1s cubic-bezier(.2,.7,.2,1) .3s both}.barra-x-dir{transform-origin:right center;animation:uCresceX 1s cubic-bezier(.2,.7,.2,1) .3s both}.barra-y{transform-origin:center bottom;animation:uCresceY 1s cubic-bezier(.2,.7,.2,1) .3s both}.traco{stroke-dasharray:1;stroke-dashoffset:0;animation:eTraco 1.8s cubic-bezier(.45,.05,.3,1) both}.traco-rapido{stroke-dasharray:1;stroke-dashoffset:0;animation:eTraco .9s cubic-bezier(.45,.05,.3,1) both}.cor{animation:eCor 1.4s ease-out 1.2s both}.cor-esc{animation:eCorEsc 1.4s ease-out 1.2s both}.esmaece{animation:uEntra 1.2s ease-out .9s both}.brota{transform-box:fill-box;transform-origin:center;animation:eEscala .6s cubic-bezier(.2,.9,.3,1.3) both}.d1{animation-delay:80ms!important}.d2{animation-delay:160ms!important}.d3{animation-delay:240ms!important}.d4{animation-delay:320ms!important}.d5{animation-delay:400ms!important}.d6{animation-delay:480ms!important}.d7{animation-delay:560ms!important}.d8{animation-delay:640ms!important}.d9{animation-delay:720ms!important}.d10{animation-delay:800ms!important}.d11{animation-delay:880ms!important}.d12{animation-delay:960ms!important}.d13{animation-delay:1040ms!important}.d14{animation-delay:1120ms!important}.d15{animation-delay:1200ms!important}.d16{animation-delay:1280ms!important}.realce>*{transition:opacity .18s ease}.realce:has(>:hover)>:not(:hover){opacity:.42}@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}"
		displayFolder: _Estilo
		lineageTag: c39ff336-6310-50ae-828f-8469d205e251

	/// Flávio sobre os válidos apurados no exterior (no contexto: o país).
	measure 'Apuração exterior · Flávio %' =
			DIVIDE ( SUM ( 'Apuração exterior'[FlavioVotos] ), [Apuração exterior · válidos] )
		formatString: 0.0%
		displayFolder: _Exterior\Contas
		lineageTag: 9818fc41-2841-52d9-8682-f66ecf4d1944

	/// Lula sobre os válidos apurados no exterior (no contexto: o país).
	measure 'Apuração exterior · Lula %' =
			DIVIDE ( SUM ( 'Apuração exterior'[LulaVotos] ), [Apuração exterior · válidos] )
		formatString: 0.0%
		displayFolder: _Exterior\Contas
		lineageTag: a0c5420e-0dc1-57e0-bc3d-938be17c4dfc

	/// Países com seção no exterior na apuração.
	measure 'Apuração exterior · países' =
			DISTINCTCOUNT ( 'Apuração exterior'[País] )
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: f5a502c3-76cf-5f58-8698-bf1a0128e976

	/// Países em que Flávio tem mais votos apurados.
	measure 'Apuração exterior · países com Flávio à frente' =
			COUNTROWS (
			    FILTER (
			        VALUES ( 'Apuração exterior'[País] ),
			        [Apuração exterior · Lula %] < [Apuração exterior · Flávio %]
			    )
			) + 0
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: 0becdf38-d523-54df-aaf1-6474aa85d565

	/// Países em que Lula tem mais votos apurados.
	measure 'Apuração exterior · países com Lula à frente' =
			COUNTROWS (
			    FILTER (
			        VALUES ( 'Apuração exterior'[País] ),
			        [Apuração exterior · Lula %] > [Apuração exterior · Flávio %]
			    )
			) + 0
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: 41cc4308-11f7-569c-b116-b9a502c79927

	/// Países do exterior ainda sem vencedor na apuração: nenhum voto apurado para os dois ou empate.
	measure 'Apuração exterior · países sem vencedor' =
			[Apuração exterior · países] - [Apuração exterior · países com Lula à frente] - [Apuração exterior · países com Flávio à frente]
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: 8fc31eac-f091-579f-9114-66a2360bc84c

	/// Seções do exterior já totalizadas (no contexto: o país).
	measure 'Apuração exterior · seções %' =
			DIVIDE ( SUM ( 'Apuração exterior'[SecoesTotalizadas] ), SUM ( 'Apuração exterior'[SecoesTotal] ) )
		formatString: 0.0%
		displayFolder: _Exterior\Contas
		lineageTag: 0c079f33-2768-5f5e-86c0-bdab4473dc72

	/// Votos válidos apurados no exterior na última coleta (no contexto: o país).
	measure 'Apuração exterior · válidos' =
			SUM ( 'Apuração exterior'[Validos] )
		formatString: #,0
		displayFolder: _Exterior\Contas
		lineageTag: a53a5e8c-e0be-5294-8dc9-65c4930801f9

	/// Cidades com seção no exterior em 2026.
	measure 'Exterior · cidades' =
			CALCULATE ( SUM ( 'Exterior país'[Cidades] ), 'Exterior país'[Ano] = 2026 )
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: 15a63d85-6e3b-5d23-a07d-a8c9ae7d0668

	/// Flávio sobre os válidos do exterior no 1º turno de 2026 (no contexto: o país).
	measure 'Exterior · Flávio %' =
			DIVIDE ( CALCULATE ( SUM ( 'Exterior país'[VotosAdversario] ), 'Exterior país'[Ano] = 2026 ), [Exterior · válidos] )
		formatString: 0.0%
		displayFolder: _Exterior\Contas
		lineageTag: 5a247cb0-b590-5980-bc89-61342fd9769f

	/// Lula sobre os válidos do exterior no 1º turno de 2026 (no contexto: o país).
	measure 'Exterior · Lula %' =
			DIVIDE ( CALCULATE ( SUM ( 'Exterior país'[VotosPT] ), 'Exterior país'[Ano] = 2026 ), [Exterior · válidos] )
		formatString: 0.0%
		displayFolder: _Exterior\Contas
		lineageTag: fbf9aebb-3f61-5f1a-b322-6b02b787aceb

	/// Margem do PT no exterior no 1º turno de 2022: (Lula − adversário) ÷ válidos.
	measure 'Exterior · margem 2022' =
			DIVIDE ( CALCULATE ( SUM ( 'Exterior país'[VotosPT] ) - SUM ( 'Exterior país'[VotosAdversario] ), 'Exterior país'[Ano] = 2022 ), CALCULATE ( SUM ( 'Exterior país'[Validos] ), 'Exterior país'[Ano] = 2022 ) )
		formatString: 0.0%
		displayFolder: _Exterior\Contas
		lineageTag: 60e9ac08-3a06-5d1a-87ae-d59ed838a591

	/// Margem do PT no exterior no 1º turno de 2026: (Lula − adversário) ÷ válidos.
	measure 'Exterior · margem 2026' =
			DIVIDE ( CALCULATE ( SUM ( 'Exterior país'[VotosPT] ) - SUM ( 'Exterior país'[VotosAdversario] ), 'Exterior país'[Ano] = 2026 ), CALCULATE ( SUM ( 'Exterior país'[Validos] ), 'Exterior país'[Ano] = 2026 ) )
		formatString: 0.0%
		displayFolder: _Exterior\Contas
		lineageTag: cf9ce7ed-a7c1-57de-a157-f48df2aa2439

	/// Países com seção no exterior em 2026.
	measure 'Exterior · países' =
			CALCULATE ( DISTINCTCOUNT ( 'Exterior país'[País] ), 'Exterior país'[Ano] = 2026 )
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: 8fe3505c-cdee-5f46-99d2-50a169a9a818

	/// Países em que Flávio teve mais votos no 1º turno de 2026.
	measure 'Exterior · países com Flávio à frente' =
			COUNTROWS (
			    FILTER (
			        CALCULATETABLE ( VALUES ( 'Exterior país'[País] ), 'Exterior país'[Ano] = 2026 ),
			        [Exterior · Lula %] < [Exterior · Flávio %]
			    )
			) + 0
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: 3c4aa534-f558-568a-93ef-7ab90f0d0c72

	/// Países em que Lula teve mais votos no 1º turno de 2026.
	measure 'Exterior · países com Lula à frente' =
			COUNTROWS (
			    FILTER (
			        CALCULATETABLE ( VALUES ( 'Exterior país'[País] ), 'Exterior país'[Ano] = 2026 ),
			        [Exterior · Lula %] > [Exterior · Flávio %]
			    )
			) + 0
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: f04e8992-fbc4-5b2e-ba97-5a7855a600e3

	/// Países do exterior sem vencedor no 1º turno de 2026: nenhum voto válido para os dois ou empate.
	measure 'Exterior · países sem vencedor' =
			[Exterior · países] - [Exterior · países com Lula à frente] - [Exterior · países com Flávio à frente]
		formatString: 0
		displayFolder: _Exterior\Contas
		lineageTag: f423d79e-b3e0-5d54-9c23-ad9ed663b4bb

	/// Variação da margem do PT de 2022 para 2026, em pontos (negativa: na direção do adversário); vazia onde não houve seção em 2022.
	measure 'Exterior · variação da margem' =
			VAR _a = [Exterior · margem 2022]
			VAR _b = [Exterior · margem 2026]
			RETURN
			    IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), ( _b - _a ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: _Exterior\Contas
		lineageTag: 9b2e0f46-26f4-5108-9aeb-4524e65891db

	/// Votos válidos no exterior no 1º turno de 2026 (no contexto: o país).
	measure 'Exterior · válidos' =
			CALCULATE ( SUM ( 'Exterior país'[Validos] ), 'Exterior país'[Ano] = 2026 )
		formatString: #,0
		displayFolder: _Exterior\Contas
		lineageTag: f7f3b331-c124-5438-9f13-3f2037c4f27b

	/// Texto alternativo do tooltip do exterior no 1º turno.
	measure 'Exterior · 1º turno · ALT' =
			"Exterior, 1º turno de 2026: Lula " & FORMAT ( [Exterior · Lula %], "0.0%" ) & ", Flávio " & FORMAT ( [Exterior · Flávio %], "0.0%" )
			    & ", em " & [Exterior · países] & " países; Lula à frente em " & [Exterior · países com Lula à frente] & "."
		displayFolder: _Exterior\Desenho
		lineageTag: 98dc6c97-6176-5018-bb58-e6b2670a035a

	/// Tooltip rico do exterior no 1º turno de 2026: Lula × Flávio no exterior, os 12 países com mais votos (barra dos dois e variação da margem desde 2022) e o resto somado.
	measure 'Exterior · 1º turno · HTML' =
			-- 1 · Leituras: os países com mais votos válidos (os 12 maiores) e o resto somado
			VAR _paises = CALCULATETABLE ( VALUES ( 'Exterior país'[País] ), 'Exterior país'[Ano] = 2026 )
			VAR _t =
			    ADDCOLUMNS ( _paises, "@v", [Exterior · válidos], "@l", [Exterior · Lula %], "@f", [Exterior · Flávio %], "@d", [Exterior · variação da margem] )
			VAR _top = TOPN ( 12, FILTER ( _t, [@v] > 0 ), [@v], DESC, 'Exterior país'[País], ASC )
			VAR _topR = ADDCOLUMNS ( _top, "@i", RANKX ( _top, [@v],, DESC, DENSE ) )
			VAR _resto = EXCEPT ( _paises, SELECTCOLUMNS ( _top, "País", 'Exterior país'[País] ) )
			VAR _nResto = COUNTROWS ( _resto ) + 0
			VAR _rv = CALCULATE ( SUM ( 'Exterior país'[Validos] ), 'Exterior país'[Ano] = 2026, TREATAS ( _resto, 'Exterior país'[País] ) )
			VAR _rl = DIVIDE ( CALCULATE ( SUM ( 'Exterior país'[VotosPT] ), 'Exterior país'[Ano] = 2026, TREATAS ( _resto, 'Exterior país'[País] ) ), _rv )
			VAR _rf = DIVIDE ( CALCULATE ( SUM ( 'Exterior país'[VotosAdversario] ), 'Exterior país'[Ano] = 2026, TREATAS ( _resto, 'Exterior país'[País] ) ), _rv )
			VAR _tl = [Exterior · Lula %]
			VAR _tf = [Exterior · Flávio %]
			-- 2 · Desenho
			VAR _linhas =
			    CONCATENATEX (
			        _topR,
			        "<div class='lp sobe d" & MIN ( 16, [@i] + 3 ) & "'><span class='pn'><b>" & 'Exterior país'[País] & "</b><i>"
			            & FORMAT ( [@v], "#,0" ) & IF ( [@v] = 1, " voto", " votos" ) & "</i></span>"
			            & "<span class='vl'>" & FORMAT ( [@l] * 100, "0" ) & "%</span>"
			            & "<span class='br'><i class='bl barra-x' style='width:" & FORMAT ( [@l] * 100, "0.0##", "en-US" )
			            & "%'></i><i class='bf barra-x-dir' style='width:" & FORMAT ( [@f] * 100, "0.0##", "en-US" ) & "%'></i></span>"
			            & "<span class='vf'>" & FORMAT ( [@f] * 100, "0" ) & "%</span>"
			            & "<span class='dv " & IF ( [@d] < 0, "neg", "pos" ) & "'>" & IF ( ISBLANK ( [@d] ), "novo", FORMAT ( [@d], "+0.0;−0.0;0.0" ) ) & "</span>" & "</div>",
			        "", [@v], DESC
			    )
			VAR _outros =
			    IF (
			        _nResto > 0,
			        "<div class='outros sobe d16'>Outros " & _nResto & IF ( _nResto = 1, " país", " países" ) & " · "
			            & FORMAT ( _rv, "#,0" ) & " votos · Lula " & FORMAT ( _rl * 100, "0" ) & "% × Flávio "
			            & FORMAT ( _rf * 100, "0" ) & "%</div>"
			    )
			VAR _nl = [Exterior · países com Lula à frente]
			VAR _nf = [Exterior · países com Flávio à frente]
			VAR _ns = [Exterior · países sem vencedor]
			RETURN
			    "<div class='tela tx'><div class='fita'></div>"
			        & "<div class='rot topo-rot'>" & "EXTERIOR · 1º TURNO DE 2026 · " & [Exterior · cidades] & " CIDADES EM " & [Exterior · países] & " PAÍSES" & "</div>"
			        & "<div class='topo'><div class='c'><span class='num lula'>" & FORMAT ( _tl * 100, "0.0" ) & "%</span>"
			        & "<span class='rot lula-esc'>LULA</span></div><div class='c'><span class='num flavio'>"
			        & FORMAT ( _tf * 100, "0.0" ) & "%</span><span class='rot flavio-esc'>FLÁVIO</span></div>"
			        & "<div class='c tot'><span class='num'>" & FORMAT ( [Exterior · válidos], "#,0" ) & "</span>"
			        & "<span class='rot'>VOTOS VÁLIDOS</span></div></div>"
			        & "<div class='mao'>Lula na frente em " & _nl & IF ( _nl = 1, " país", " países" ) & ", Flávio em " & _nf
			        & "</div>"
			        & "<div class='cab rot'><span>PAÍS</span><span>LULA</span><span></span><span>FLÁVIO</span><span>2022→26</span></div>"
			        & "<div class='lista'>" & _linhas & "</div>" & _outros
			        & "<div class='pe nota'>" & IF ( _ns > 0, "Nos outros " & _ns & IF ( _ns = 1, " país, ", " países, " )
			        & "empate ou nenhum voto válido" & ". " ) & "2022→26: variação da margem do PT de 2022 (Lula × Bolsonaro) para 2026 (Lula × Flávio), em pontos; negativa, na direção do adversário." & "</div></div>"
		displayFolder: _Exterior\Desenho
		lineageTag: bceb6f8c-d80c-5f61-9ccb-675d6803e67d

	/// Texto alternativo do alvo do exterior.
	measure 'Exterior · alvo · ALT' =
			"Exterior: passe o mouse para ver o voto país a país."
		displayFolder: _Exterior\Desenho
		lineageTag: 7a9e9722-e49d-5de8-af18-d2fc0fe8e464

	/// Alvo transparente sobre a linha ou o quadrado do exterior: abre o tooltip rico do exterior (o desenho de baixo continua o do visual da tela).
	measure 'Exterior · alvo · HTML' =
			IF ( SELECTEDVALUE ( 'UF'[UF] ) = "ZZ", "<div class='tela ax'></div>" )
		displayFolder: _Exterior\Desenho
		lineageTag: 8dca297a-0214-5c15-a40d-1bc7d6b0104c

	/// Texto alternativo do tooltip do exterior na apuração.
	measure 'Exterior · ao vivo · ALT' =
			IF (
			    [Apuração exterior · válidos] = 0,
			    "Exterior: a apuração começa às 17h de 25/10; no 1º turno, Lula " & FORMAT ( [Exterior · Lula %], "0.0%" ) & " e Flávio " & FORMAT ( [Exterior · Flávio %], "0.0%" ) & ".",
			    "Exterior, apuração do 2º turno: Lula " & FORMAT ( [Apuração exterior · Lula %], "0.0%" ) & ", Flávio " & FORMAT ( [Apuração exterior · Flávio %], "0.0%" ) & "."
			)
		displayFolder: _Exterior\Desenho
		lineageTag: 3d2acd51-0825-57f8-9b30-547ea1c0ff3c

	/// Tooltip rico do exterior na apuração do 2º turno: Lula × Flávio por país, com a % de seções; antes dos primeiros votos, o 1º turno com o aviso de que a apuração ainda não começou.
	measure 'Exterior · ao vivo · HTML' =
			IF (
			    [Apuração exterior · válidos] = 0,
			    SUBSTITUTE (
			        [Exterior · 1º turno · HTML],
			        "<div class='rot topo-rot'>EXTERIOR · 1º TURNO DE 2026",
			        "<div class='aviso'>a apuração começa às 17h de 25/10; até lá, o voto do 1º turno</div><div class='rot topo-rot'>EXTERIOR · 1º TURNO DE 2026"
			    ),
			-- 1 · Leituras: os países com mais votos válidos (os 12 maiores) e o resto somado
			VAR _paises = VALUES ( 'Apuração exterior'[País] )
			VAR _t =
			    ADDCOLUMNS ( _paises, "@v", [Apuração exterior · válidos], "@l", [Apuração exterior · Lula %], "@f", [Apuração exterior · Flávio %], "@s", [Apuração exterior · seções %] )
			VAR _top = TOPN ( 12, FILTER ( _t, [@v] > 0 ), [@v], DESC, 'Apuração exterior'[País], ASC )
			VAR _topR = ADDCOLUMNS ( _top, "@i", RANKX ( _top, [@v],, DESC, DENSE ) )
			VAR _resto = EXCEPT ( _paises, SELECTCOLUMNS ( _top, "País", 'Apuração exterior'[País] ) )
			VAR _nResto = COUNTROWS ( _resto ) + 0
			VAR _rv = CALCULATE ( SUM ( 'Apuração exterior'[Validos] ), TREATAS ( _resto, 'Apuração exterior'[País] ) )
			VAR _rl = DIVIDE ( CALCULATE ( SUM ( 'Apuração exterior'[LulaVotos] ), TREATAS ( _resto, 'Apuração exterior'[País] ) ), _rv )
			VAR _rf = DIVIDE ( CALCULATE ( SUM ( 'Apuração exterior'[FlavioVotos] ), TREATAS ( _resto, 'Apuração exterior'[País] ) ), _rv )
			VAR _tl = [Apuração exterior · Lula %]
			VAR _tf = [Apuração exterior · Flávio %]
			-- 2 · Desenho
			VAR _linhas =
			    CONCATENATEX (
			        _topR,
			        "<div class='lp sobe d" & MIN ( 16, [@i] + 3 ) & "'><span class='pn'><b>" & 'Apuração exterior'[País] & "</b><i>"
			            & FORMAT ( [@v], "#,0" ) & IF ( [@v] = 1, " voto", " votos" ) & "</i></span>"
			            & "<span class='vl'>" & FORMAT ( [@l] * 100, "0" ) & "%</span>"
			            & "<span class='br'><i class='bl barra-x' style='width:" & FORMAT ( [@l] * 100, "0.0##", "en-US" )
			            & "%'></i><i class='bf barra-x-dir' style='width:" & FORMAT ( [@f] * 100, "0.0##", "en-US" ) & "%'></i></span>"
			            & "<span class='vf'>" & FORMAT ( [@f] * 100, "0" ) & "%</span>"
			            & "<span class='dv'>" & FORMAT ( [@s] * 100, "0" ) & "%</span>" & "</div>",
			        "", [@v], DESC
			    )
			VAR _outros =
			    IF (
			        _nResto > 0,
			        "<div class='outros sobe d16'>Outros " & _nResto & IF ( _nResto = 1, " país", " países" ) & " · "
			            & FORMAT ( _rv, "#,0" ) & " votos · Lula " & FORMAT ( _rl * 100, "0" ) & "% × Flávio "
			            & FORMAT ( _rf * 100, "0" ) & "%</div>"
			    )
			VAR _nl = [Apuração exterior · países com Lula à frente]
			VAR _nf = [Apuração exterior · países com Flávio à frente]
			VAR _ns = [Apuração exterior · países sem vencedor]
			RETURN
			    "<div class='tela tx'><div class='fita'></div>"
			        & "<div class='rot topo-rot'>" & "EXTERIOR AO VIVO · " & [Apuração · turno] & "º TURNO · " & FORMAT ( [Apuração exterior · seções %] * 100, "0" ) & "% DAS SEÇÕES · " & [Apuração exterior · países] & " PAÍSES" & "</div>"
			        & "<div class='topo'><div class='c'><span class='num lula'>" & FORMAT ( _tl * 100, "0.0" ) & "%</span>"
			        & "<span class='rot lula-esc'>LULA</span></div><div class='c'><span class='num flavio'>"
			        & FORMAT ( _tf * 100, "0.0" ) & "%</span><span class='rot flavio-esc'>FLÁVIO</span></div>"
			        & "<div class='c tot'><span class='num'>" & FORMAT ( [Apuração exterior · válidos], "#,0" ) & "</span>"
			        & "<span class='rot'>VOTOS VÁLIDOS</span></div></div>"
			        & "<div class='mao'>Lula na frente em " & _nl & IF ( _nl = 1, " país", " países" ) & ", Flávio em " & _nf
			        & "</div>"
			        & "<div class='cab rot'><span>PAÍS</span><span>LULA</span><span></span><span>FLÁVIO</span><span>SEÇÕES</span></div>"
			        & "<div class='lista'>" & _linhas & "</div>" & _outros
			        & "<div class='pe nota'>" & IF ( _ns > 0, "Nos outros " & _ns & IF ( _ns = 1, " país, ", " países, " )
			        & IF ( [Apuração exterior · seções %] >= 1, "empate ou nenhum voto válido", "empate ou nenhum voto apurado ainda" ) & ". " ) & "Países pelos votos válidos já apurados" & IF ( [Apuração · turno] = 2, "; no 2º turno, Lula e Flávio somam 100%.", "; no 1º turno, o resto é dos outros candidatos." ) & "</div></div>"
			)
		displayFolder: _Exterior\Desenho
		lineageTag: 5f290751-0b8c-57be-95c6-1cfaa39e3b3b

	/// Texto alternativo do tooltip do exterior no simulador.
	measure 'Exterior · simulador · ALT' =
			"Exterior no cenário: Lula " & FORMAT ( [T22 · cenário · Lula %], "0.0%" ) & ", Flávio " & FORMAT ( [T22 · cenário · Flávio %], "0.0%" )
			    & "; no 1º turno, Lula " & FORMAT ( [Exterior · Lula %], "0.0%" ) & " e Flávio " & FORMAT ( [Exterior · Flávio %], "0.0%" ) & "."
