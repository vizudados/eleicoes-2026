	/// Quantos institutos publicaram, depois do 1º turno, o cruzamento do grupo do filtro (Transferência[Segmento]).
	measure 'T16 · transferência · institutos' =
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Transferência'[Instituto] ),
			        REMOVEFILTERS ( 'Transferência' ),
			        'Transferência'[Segmento] = _seg,
			        LEFT ( 'Transferência'[Observação], 19 ) = "momento=apos_1turno"
			    ) + 0
		formatString: 0
		displayFolder: T16 Os outros\Contas
		lineageTag: 3920f163-3355-5d38-8766-89283b63cfd0

