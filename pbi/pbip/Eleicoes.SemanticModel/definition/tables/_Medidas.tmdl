	/// Situação da presença de Flávio: confirmada, a_confirmar ou ausente (vazio ou outro texto = a_confirmar).
	measure 'T26 · presença · Flávio' =
			VAR _s = LOWER ( TRIM ( CALCULATE ( MAX ( 'T26 Debate Globo'[Situação] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "presenca_flavio" ) ) )
			RETURN
			    SWITCH ( TRUE (), _s = "confirmada", "confirmada", _s IN { "ausente", "não vai", "nao_vai" }, "ausente", "a_confirmar" )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 34965024-f396-5cf9-b963-86e5898af28a

	/// Situação da presença de Lula: confirmada, a_confirmar ou ausente (vazio ou outro texto = a_confirmar).
	measure 'T26 · presença · Lula' =
			VAR _s = LOWER ( TRIM ( CALCULATE ( MAX ( 'T26 Debate Globo'[Situação] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "presenca_lula" ) ) )
			RETURN
