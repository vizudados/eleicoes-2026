			    CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
			)
		formatString: 0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 36af1341-54cb-58b7-9000-a69cbc5aa6e1

	/// Primeiro ano com dado no lugar e na faixa do contexto (2006, ou 2014 com faixa).
	measure 'T25 · primeiro ano da série' =
			MINX (
			    FILTER (
			        CALCULATETABLE ( VALUES ( 'Ano'[Ano] ), REMOVEFILTERS ( 'Ano' ) ),
			        VAR _a = 'Ano'[Ano]
			        RETURN
			            NOT ISBLANK ( CALCULATE ( [T25 · aptos (cru)], 'Ano'[Ano] = _a ) )
			    ),
			    'Ano'[Ano]
			)
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 4b6d8dec-26cd-5775-ad39-c76e6259c855

	/// A área das médias (ignora o município marcado), da medida comum [Recorte · nome]: 'Brasil', o estado ('Bahia'), a região inteira ('Nordeste') ou vários estados ('MG e SP', '3 estados').
	measure 'T25 · recorte' =
			[Recorte · nome]
		displayFolder: T25 Quem falta\Contas
		lineageTag: 1611d20a-228e-5822-a8dc-003b6819d934

	/// Linha tracejada do bloco de anos (0–1): com município marcado, a média do recorte (as UFs escolhidas ou o Brasil) no mesmo ano e faixa; só com faixa marcada, todas as idades do lugar; sem marca, vazio.
	measure 'T25 · referência da série' =
			SWITCH (
			    TRUE (),
			    [T25 · com município] = 1, [T25 · abstenção % do recorte],
			    [T25 · com faixa] = 1, CALCULATE ( [T25 · abstenção %], REMOVEFILTERS ( 'T25 Faixa' ) ),
			    BLANK ()
			)
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 1d965de4-bf92-5628-a6f2-c101cd725fe9

	/// Nome da linha de referência do bloco de anos.
	measure 'T25 · referência da série (nome)' =
			SWITCH (
			    TRUE (),
			    [T25 · com município] = 1, [T25 · média (nome)],
			    [T25 · com faixa] = 1, "todas as idades",
			    ""
			)
		displayFolder: T25 Quem falta\Contas
		lineageTag: 419c19d4-0d64-55da-9ec3-1a166219ba79

	/// Região do município da linha.
	measure 'T25 · região do município' =
			SELECTEDVALUE ( 'Município'[Região] )
		displayFolder: T25 Quem falta\Contas
		lineageTag: 6b6f5d1d-c967-5bd2-870f-10d830d50bf8

	/// 1 quando o recorte é de municípios (filtro de UF ou município marcado): as contas somam os municípios; 0 no Brasil inteiro, que usa o total oficial, com o exterior (como a tela 06).
	measure 'T25 · sem exterior' =
			INT ( ISCROSSFILTERED ( 'Município' ) )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 438a43a4-8410-50d0-b1c4-ab08a8215955

	/// 1 quando o ano do recorte tem perfil por idade (o TSE publica desde 2014).
	measure 'T25 · tem idade no ano' =
			IF ( [T25 · ano] >= 2014, 1, 0 )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: a787d907-3390-5449-9f8b-7228593fec57

	/// Maior valor entre os seis anos (a abstenção e a referência) no lugar e na faixa do contexto (0–1): a escala das colunas do bloco de anos.
	measure 'T25 · teto da série' =
			MAXX (
			    CALCULATETABLE ( VALUES ( 'Ano'[Ano] ), REMOVEFILTERS ( 'Ano' ) ),
			    VAR _a = 'Ano'[Ano]
			    RETURN
			        MAX (
			            CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = _a ),
			            CALCULATE ( [T25 · referência da série], 'Ano'[Ano] = _a )
			        )
			)
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 7cd01270-638f-5a9f-afdb-9b1e0f81cc1d

	/// Maior abstenção entre as sete faixas no lugar e no ano do recorte (0–1): a escala das barras do bloco de idade.
	measure 'T25 · teto por idade' =
			MAXX (
			    CALCULATETABLE ( VALUES ( 'T25 Faixa'[Ordem] ), REMOVEFILTERS ( 'T25 Faixa' ) ),
			    VAR _k = 'T25 Faixa'[Ordem]
			    RETURN
			        CALCULATE ( [T25 · abstenção %], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Ordem] = _k )
			)
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 8be31dd5-45e6-5f15-8d2e-18bb7f2a5797

	/// De quantos em quantos eleitores do recorte um faltou (1 em cada N), arredondado.
	measure 'T25 · um em cada' =
			IF ( [T25 · abstenção %] > 0, ROUND ( DIVIDE ( 1, [T25 · abstenção %] ), 0 ) )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 01b52776-3b0a-55ce-afa0-5c778745e843

	/// Abstenção de 2026 menos a do primeiro ano com dado, em pontos percentuais.
	measure 'T25 · variação da série em p.p.' =
			IF ( [T25 · primeiro ano da série] < 2026, ( [T25 · abstenção % em 2026] - [T25 · abstenção % no primeiro ano] ) * 100 )
		formatString: 0.0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 1f2b3ff9-621b-51e4-bfbc-0798598c9b3b

	/// Abstenção da faixa da linha dividida pela de todas as idades, no lugar e no ano.
	measure 'T25 · vezes a média (faixa)' =
			DIVIDE ( [T25 · abstenção %], [T25 · abstenção % todas as idades] )
		formatString: 0.0
		displayFolder: T25 Quem falta\Contas
		lineageTag: edd5c717-41db-5352-ad41-340464a9f7c0

	/// Quantas vezes a faixa que mais falta falta mais que a que menos falta.
	measure 'T25 · vezes entre as faixas' =
			DIVIDE ( [T25 · faixa que mais falta %], [T25 · faixa que menos falta %] )
		formatString: 0.0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 45f46685-6821-54e5-978a-a17b8dd61841

	/// obrigatório ou facultativo, na faixa da linha.
	measure 'T25 · voto da faixa' =
			SELECTEDVALUE ( 'T25 Faixa'[Voto] )
		displayFolder: T25 Quem falta\Contas
		lineageTag: 0dd76115-caf6-58f9-8a22-9789017daf57

	/// Texto para leitor de tela do título do bloco de anos.
	measure 'T25 · Anos topo · ALT' =
			LEFT (
			    "A ausência ano a ano, " & [T25 · lugar] & IF ( [T25 · com faixa] = 1, ", " & [T25 · faixa] ) & ": "
			        & IF ( ISBLANK ( [T25 · variação da série em p.p.] ), "sem série.",
			            FORMAT ( [T25 · variação da série em p.p.], "+0.0;−0.0;0.0" ) & " pontos desde " & [T25 · primeiro ano da série] & "." ),
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: efb4f340-c469-552f-9046-15013589c991

	/// Título do bloco de anos: o lugar (e a faixa), quanto a abstenção mudou desde o primeiro ano com dado e a legenda da linha de referência. Ignora o clique no próprio bloco.
	measure 'T25 · Anos topo · HTML' =
			-- 1 · Leituras
			VAR _lugar = [T25 · lugar]
			VAR _faixa = [T25 · faixa]
			VAR _comFaixa = [T25 · com faixa]
			VAR _a0 = [T25 · primeiro ano da série]
			VAR _dpp = [T25 · variação da série em p.p.]
			VAR _nomeRef = [T25 · referência da série (nome)]
			-- 2 · Textos
			VAR _rot = "A ausência ano a ano · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _lugar, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & IF ( _comFaixa = 1, " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _faixa, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) )
			VAR _man =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _dpp ), "Sem série neste cruzamento",
			        ABS ( _dpp ) < 0.05, "Igual desde " & _a0,
			        IF ( _dpp > 0, "Subiu ", "Caiu " ) & FORMAT ( ABS ( _dpp ), "0.0" )
			            & IF ( ABS ( _dpp ) < 2, " ponto", " pontos" ) & " desde " & _a0
			    )
			VAR _lado =
			    IF ( _nomeRef <> "", "<span class='lg'><i></i>" & _nomeRef & "</span>" )
			        & IF ( _comFaixa = 1, "<span class='so'>idade só desde 2014</span>" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela at'><div class='l1'><div class='rot sobe'>" & _rot & "</div>"
			        & "<div class='lado entra d3'>" & _lado & "</div></div><div class='man sobe d1'>" & _man & "</div></div>"
		displayFolder: T25 Quem falta\Desenho
		lineageTag: e1f17862-6931-5fee-b613-9e35c344e0d5

	/// Texto para leitor de tela do bloco de anos.
	measure 'T25 · Anos · ALT' =
			LEFT (
			    "Abstenção no 1º turno, " & [T25 · lugar] & IF ( [T25 · com faixa] = 1, ", " & [T25 · faixa] ) & ": "
			        & "2006 " & IF ( ISBLANK ( [T25 · abstenção % em 2006] ), "sem dado", FORMAT ( [T25 · abstenção % em 2006], "0.0%" ) ) & ", " & "2010 " & IF ( ISBLANK ( [T25 · abstenção % em 2010] ), "sem dado", FORMAT ( [T25 · abstenção % em 2010], "0.0%" ) ) & ", " & "2014 " & IF ( ISBLANK ( [T25 · abstenção % em 2014] ), "sem dado", FORMAT ( [T25 · abstenção % em 2014], "0.0%" ) ) & ", " & "2018 " & IF ( ISBLANK ( [T25 · abstenção % em 2018] ), "sem dado", FORMAT ( [T25 · abstenção % em 2018], "0.0%" ) ) & ", " & "2022 " & IF ( ISBLANK ( [T25 · abstenção % em 2022] ), "sem dado", FORMAT ( [T25 · abstenção % em 2022], "0.0%" ) ) & ", " & "2026 " & IF ( ISBLANK ( [T25 · abstenção % em 2026] ), "sem dado", FORMAT ( [T25 · abstenção % em 2026], "0.0%" ) ) & ". Clique num ano para cruzar.",
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 84498b3b-2b01-53ce-a816-6473bfe6e57a

	/// Uma coluna por 1º turno (granularidade Ano[Ano]): a abstenção do ano no lugar e na faixa do contexto, a linha tracejada da referência e o ano; com faixa marcada, 2006 e 2010 ficam vazios (sem idade). O alvo transparente recebe o clique e a dica. Só lê contas; a escala é geometria.
	measure 'T25 · Anos · HTML' =
			-- 1 · Leituras
			VAR _ano = [T25 · ano]
			VAR _pct = [T25 · abstenção %]
			VAR _teto = [T25 · teto da série]
			VAR _ref = [T25 · referência da série]
			VAR _comFaixa = [T25 · com faixa]
			VAR _temIdade = [T25 · tem idade no ano]
			-- 2 · Textos
			VAR _sem = IF ( _comFaixa = 1 && _temIdade = 0, "sem idade", "sem dado" )
			-- 3 · Geometria (6 anos em 760 px; coluna de 0 ao teto em 150 px sobre a base a 30 px do pé)
			VAR _i = ( _ano - 2006 ) / 4 -- geometria
			VAR _x = _i * 126.6667 -- geometria
			VAR _h = IF ( _teto > 0, DIVIDE ( _pct, _teto ) * 150 ) -- geometria
			VAR _hr = IF ( _teto > 0, DIVIDE ( _ref, _teto ) * 150, 0 ) -- geometria
			VAR _coluna =
			    IF (
			        ISBLANK ( _pct ),
			        "<div class='fant entra d" & ( _i + 2 ) & "'></div><div class='sem entra d" & ( _i + 3 ) & "'>" & _sem & "</div>",
			        "<div class='pc sobe d" & ( _i + 4 ) & "' style='bottom:" & FORMAT ( MAX ( _h, _hr ) + 36, "0.0##", "en-US" ) & "px'>" & FORMAT ( _pct, "0.0%" ) & "</div>"
			            & "<div class='bar barra-y d" & ( _i + 2 ) & "' style='height:" & FORMAT ( MAX ( _h, 2 ), "0.0##", "en-US" ) & "px'></div>"
			    )
			VAR _linhaRef =
			    IF (
			        NOT ISBLANK ( _ref ) && NOT ISBLANK ( _pct ),
			        "<div class='ref entra d10' style='bottom:" & FORMAT ( _hr + 30, "0.0##", "en-US" ) & "px'></div>"
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela an'><div class='col' style='left:" & FORMAT ( _x, "0.0##", "en-US" ) & "px'>" & _coluna & _linhaRef
			        & "<div class='ano'>" & _ano & "</div><div class='alvo'></div></div></div>"
		displayFolder: T25 Quem falta\Desenho
		lineageTag: e79107e8-5e31-5bde-9148-44967fd352fa

	/// Texto para leitor de tela do título do bloco de idade.
	measure 'T25 · Idade topo · ALT' =
			LEFT (
			    "Quem falta mais, por idade, " & [T25 · lugar] & ", " & [T25 · ano] & ": "
			        & IF ( [T25 · tem idade no ano] = 0, "o TSE só publica a idade desde 2014.",
			            [T25 · faixa que mais falta] & " " & FORMAT ( [T25 · faixa que mais falta %], "0.0%" ) & "; "
			                & [T25 · faixa que menos falta] & " " & FORMAT ( [T25 · faixa que menos falta %], "0.0%" ) & "." ),
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 825223c7-e26e-51e7-b15b-eb31f74f74e7

	/// Título do bloco de idade: o ano e o lugar, quantas vezes a faixa que mais falta falta mais que a que menos falta, a legenda de todas as idades e do voto facultativo. Ignora o clique no próprio bloco.
	measure 'T25 · Idade topo · HTML' =
			-- 1 · Leituras
			VAR _ano = [T25 · ano]
			VAR _lugar = [T25 · lugar]
			VAR _temIdade = [T25 · tem idade no ano]
			VAR _mais = [T25 · faixa que mais falta]
			VAR _menos = [T25 · faixa que menos falta]
			VAR _vezes = [T25 · vezes entre as faixas]
			VAR _todas = [T25 · abstenção % todas as idades]
			-- 2 · Textos
			VAR _rot = "Quem falta mais · por idade · " & _ano
			VAR _man =
			    SWITCH (
			        TRUE (),
			        _temIdade = 0, "Por idade, o TSE só publica desde 2014",
			        ISBLANK ( _mais ), "Sem dado por idade neste recorte",
			        "Os de " & SUBSTITUTE ( _mais, "16 e 17", "16 ou 17" ) & " faltam " & FORMAT ( _vezes, "0.0" )
			            & " vezes mais que os de " & SUBSTITUTE ( _menos, "16 e 17", "16 ou 17" )
			    )
			VAR _lado =
			    IF ( NOT ISBLANK ( _todas ) && _temIdade = 1,
			        "<span class='lg'><i></i>todas as idades · " & FORMAT ( _todas, "0.0%" ) & "</span>" )
			        & "<span class='so'>* voto facultativo</span>"
			-- 4 · Marcação
			RETURN
			    "<div class='tela it'><div class='l1'><div class='rot sobe'>" & _rot & "</div>"
			        & "<div class='lado entra d3'>" & _lado & "</div></div><div class='man sobe d1'>" & _man & "</div></div>"
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 308c17a1-c91c-5f1d-bb15-321b2ae64665

	/// Texto para leitor de tela do bloco de idade.
	measure 'T25 · Idade · ALT' =
			LEFT (
			    "Abstenção por faixa de idade, " & [T25 · lugar] & ", " & [T25 · ano] & ": "
			        & IF ( [T25 · tem idade no ano] = 0, "o TSE só publica a idade desde 2014.",
			            "a que mais falta é " & [T25 · faixa que mais falta] & " ("
			                & FORMAT ( [T25 · faixa que mais falta %], "0.0%" ) & "), a que menos falta é "
			                & [T25 · faixa que menos falta] & " (" & FORMAT ( [T25 · faixa que menos falta %], "0.0%" ) & ")." )
			        & " Clique numa faixa para cruzar.",
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 7ada0899-2878-5015-9065-865bb33a236a

	/// Uma linha por faixa de idade (granularidade T25 Faixa[Faixa]): a barra da abstenção da faixa no ano e no lugar do recorte, o valor e a linha tracejada de todas as idades; * = voto facultativo. Sem dado (antes de 2014), a linha fica vazia. Só lê contas; posições são geometria.
	measure 'T25 · Idade · HTML' =
			-- 1 · Leituras
			VAR _k = [T25 · ordem da faixa]
			VAR _nome = [T25 · faixa da linha]
			VAR _voto = [T25 · voto da faixa]
			VAR _pct = [T25 · abstenção %]
			VAR _teto = [T25 · teto por idade]
			VAR _ref = [T25 · abstenção % todas as idades]
			-- 2 · Textos
			VAR _ast = IF ( _voto = "facultativo", "<sup>*</sup>" )
			-- 3 · Geometria (linhas a cada 35 px; barra de 0 ao teto em 450 px a partir de x 196)
			VAR _top = ( _k - 1 ) * 35 -- geometria
			VAR _w = IF ( _teto > 0, DIVIDE ( _pct, _teto ) * 450 ) -- geometria
			VAR _xr = 196 + IF ( _teto > 0, DIVIDE ( _ref, _teto ) * 450 ) -- geometria
			VAR _barra =
			    IF (
			        ISBLANK ( _pct ),
			        "<span class='vl sem'>—</span>",
			        "<i class='br barra-x d" & ( _k + 2 ) & "' style='width:" & FORMAT ( MAX ( _w, 2 ), "0.0##", "en-US" ) & "px'></i>"
			            & "<span class='vl sobe d" & ( _k + 4 ) & "'>" & FORMAT ( _pct, "0.0%" ) & "</span>"
			    )
			VAR _linhaRef =
			    IF ( NOT ISBLANK ( _ref ) && NOT ISBLANK ( _pct ), "<i class='rf entra d11' style='left:" & FORMAT ( _xr, "0.0##", "en-US" ) & "px'></i>" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _k ),
			        "<div class='tela fx'><div class='ln' style='top:" & _top & "px'>"
			            & "<span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & _ast & "</span><i class='tr'></i>" & _barra & _linhaRef
			            & "<div class='alvo'></div></div></div>"
			    )
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 4ba2f6bc-9d3a-521e-8e95-83a577f40cc8

	/// Texto para leitor de tela da legenda do mapa.
	measure 'T25 · Legenda · ALT' =
			"Legenda: cada ponto é um município, o tamanho segue quantos faltaram; a cor vai do claro (abaixo da média do "
			    & "recorte) ao escuro (metade acima da média ou mais)."
		displayFolder: T25 Quem falta\Desenho
		lineageTag: c56ff649-271d-53b5-88e4-5ec10dfd67fd

	/// Legenda do mapa: o ponto e a cor (abaixo e acima da média do recorte).
	measure 'T25 · Legenda · HTML' =
			-- 1 · Leituras
			VAR _ref = [T25 · abstenção % do recorte]
			-- 2 · Textos
			VAR _media = [T25 · média (nome)]
			-- 4 · Marcação
			RETURN
			    "<div class='tela lgm entra d6'>"
			        & "<span class='it'><i class='bol'></i>cada ponto é um município; o tamanho segue quantos faltaram</span>"
			        & "<span class='it'><span>abaixo</span><i class='esc'></i><span>acima da " & _media
			        & IF ( NOT ISBLANK ( _ref ), " (" & FORMAT ( _ref, "0.0%" ) & ")" ) & "</span></span>"
			    & "</div>"
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 4ac428c7-6916-56a4-84a3-3c677e24ac1b

	/// Texto para leitor de tela da manchete.
	measure 'T25 · Manchete · ALT' =
			LEFT (
			    [T25 · lugar] & ", 1º turno de " & [T25 · ano]
			        & IF ( [T25 · com faixa] = 1, ", " & [T25 · faixa] ) & ": "
			        & IF ( ISBLANK ( [T25 · abstenção %] ), "sem dado neste cruzamento.",
			            FORMAT ( [T25 · abstenção %], "0.0%" ) & " dos eleitores não foram votar." )
			        & " Clique num ano, numa idade ou num ponto do mapa para cruzar.",
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 8a5e1e81-28e8-54a7-a353-c3bc61722e76

	/// A resposta da tela 07 que muda com o que está marcado: o % de quem faltou (número grande), a frase "1 em cada N eleitores faltou", a comparação com a média do recorte e as etiquetas do que está marcado (ano · idade · lugar) ou a dica de como cruzar. Só lê contas.
	measure 'T25 · Manchete · HTML' =
			-- 1 · Leituras
			VAR _pct = [T25 · abstenção %]
			VAR _ano = [T25 · ano]
			VAR _comAno = [T25 · com ano]
			VAR _comFaixa = [T25 · com faixa]
			VAR _nFaixas = [T25 · faixas marcadas]
			VAR _faixa = [T25 · faixa]
			VAR _nMun = [T25 · municípios marcados]
			VAR _lugar = [T25 · lugar]
			VAR _temIdade = [T25 · tem idade no ano]
			VAR _um = [T25 · um em cada]
			VAR _dez = [T25 · em cada 10]
			VAR _ref = [T25 · abstenção % do recorte]
			VAR _dif = [T25 · diferença para o recorte]
			VAR _todas = [T25 · abstenção % todas as idades]
			-- 2 · Textos
			VAR _semDado = ISBLANK ( _pct )
			VAR _semIdade = _comFaixa = 1 && _temIdade = 0
			VAR _txtPct = IF ( _semDado, "<span class='vz'>sem dado</span>", FORMAT ( _pct, "0.0%" ) )
			VAR _media = [T25 · média (nome)]
			VAR _quantos =
			    IF ( _pct >= 0.35, FORMAT ( _dez, "0" ) & " em cada 10", "1 em cada " & FORMAT ( _um, "0" ) )
			VAR _verbo = IF ( _pct >= 0.35, "faltaram", "faltou" )
			VAR _quem =
			    "eleitores"
			        & SWITCH (
			            TRUE (),
			            _nFaixas = 1, " de " & SUBSTITUTE ( _faixa, "16 e 17", "16 ou 17" ),
			            _nFaixas > 1, " das faixas de idade marcadas",
			            ""
			        )
			VAR _compara =
			    SWITCH (
			        TRUE (),
			        _nMun > 0 && NOT ISBLANK ( _ref ),
			            IF (
			                ABS ( _dif ) < 0.05,
			                ", bem na " & _media & " (" & FORMAT ( _ref, "0.0%" ) & ")",
			                ", " & FORMAT ( ABS ( _dif ), "0.0" ) & IF ( ABS ( _dif ) < 2, " ponto ", " pontos " )
			                    & IF ( _dif > 0, "acima", "abaixo" ) & " da " & _media & " (" & FORMAT ( _ref, "0.0%" ) & ")"
			            ),
			        _comFaixa = 1 && NOT ISBLANK ( _todas ), "; com todas as idades, " & FORMAT ( _todas, "0.0%" ),
			        ""
			    )
			VAR _frase =
			    SWITCH (
			        TRUE (),
			        _semIdade, "Em " & _ano & ", o TSE ainda não publicava a idade de quem faltou.",
			        _semDado, "Sem dado neste cruzamento.",
			        _quantos & " " & _quem & " " & _verbo & _compara & "."
			    )
			VAR _chips =
			    IF ( _comAno = 1, "<span class='chip'><b>ano</b>" & _ano & "</span>" )
			        & IF ( _comFaixa = 1, "<span class='chip'><b>idade</b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _faixa, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>" )
			        & IF ( _nMun > 0, "<span class='chip'><b>lugar</b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _lugar, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>" )
			VAR _linha =
			    SWITCH (
			        TRUE (),
			        _semIdade,
			            "<div class='aviso'><span class='ast'>*</span>Escolha 2014, 2018, 2022 ou 2026 para ver por idade.</div>",
			        _chips = "",
			            "<div class='dica'>Clique num ano, numa idade ou num ponto do mapa: as três peças se cruzam.</div>"
			                & "<div class='cruza' aria-hidden='true'><div class='mao entra d10' style='font-size:26px;color:var(--tinta);transform:rotate(-3deg)'>clique para cruzar</div><svg width='150' height='40' viewBox='0 0 150 40' style='position:absolute;left:10px;top:30px'><path class='traco' pathLength='1' style='animation-delay:1.6s' d='M6,6 C50,30 96,34 140,22 M128,14 L141,22 L127,30' fill='none' stroke='#1C1915' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'/></svg></div>",
			        "<div class='marc'>" & _chips & "<span class='dica'>clique de novo para desmarcar</span></div>"
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela mq'>"
			        & "<div class='sob sobe'>Quem falta · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _lugar, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · 1º turno de " & _ano & "</div>"
			        & "<div class='topo'><div class='big sobe d1'>" & _txtPct & "</div>"
			        & "<div class='lado sobe d2'><div class='nfv'>não foram votar</div>" & "<svg class='subl' viewBox='0 0 300 16' preserveAspectRatio='none' aria-hidden='true' style='width:236px'><path pathLength='1' class='traco' style='animation-delay:1.1s' d='M3,10 C60,4 140,13 205,7 C240,4 270,6 297,9' fill='none' stroke='#1C1915' stroke-width='3' stroke-linecap='round'/></svg>"
			        & "<div class='txt fr'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _frase, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div></div>"
			        & "<div class='linha sobe d4'>" & _linha & "</div>"
			    & "</div>"
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 5cb60200-8258-5fd7-bf02-53f028704233

	/// Texto para leitor de tela do mapa.
	measure 'T25 · Mapa · ALT' =
			LEFT (
			    "Mapa " & [Recorte · de] & ", " & [T25 · ano]
			        & IF ( [T25 · com faixa] = 1, ", " & [T25 · faixa] )
			        & ": um ponto por município, mais escuro onde se faltou mais que a " & [T25 · média (nome)] & " ("
			        & FORMAT ( [T25 · abstenção % do recorte], "0.0%" ) & "). Clique num ponto para ver o município nas outras peças.",
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 0ba0a1f3-718f-5c39-8aa1-fe607dc54723

	/// Texto para leitor de tela do dossiê do ano.
	measure 'T25 · Tooltip ano · ALT' =
			LEFT (
			    "1º turno de " & [T25 · ano] & " (" & [T25 · disputa do ano] & "), " & [T25 · lugar] & ": "
			        & FORMAT ( [T25 · abstenção %], "0.0%" ) & " faltaram"
			        & IF ( [T25 · tem idade no ano] = 1, "; a idade que mais passa do seu peso entre os que faltaram é "
			            & [T25 · faixa mais acima do seu peso] & ".", "." ),
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 51fe9cfa-ae68-5582-b998-be73b2a7c775

	/// Dossiê do ano da coluna: quem disputou, quantos faltaram no lugar (e na faixa) e, de 2014 em diante, quem eram os que faltaram — o peso de cada idade entre os faltosos ao lado do peso entre os eleitores, com a nota à mão da idade que mais passa do seu peso. Antes de 2014, o aviso de que o TSE não publicava a idade. Só lê contas.
	measure 'T25 · Tooltip ano · HTML' =
			-- 1 · Leituras
			VAR _ano = [T25 · ano]
			VAR _disputa = [T25 · disputa do ano]
			VAR _lugar = [T25 · lugar]
			VAR _comFaixa = [T25 · com faixa]
			VAR _faixa = [T25 · faixa]
			VAR _pct = [T25 · abstenção %]
			VAR _n = [T25 · abstenções]
			VAR _aptos = [T25 · aptos]
			VAR _temIdade = [T25 · tem idade no ano]
			VAR _k = IF ( _comFaixa = 1, [T25 · ordem da faixa] )
			VAR _acima = [T25 · faixa mais acima do seu peso]
			VAR _acimaX = [T25 · faixa mais acima do seu peso (vezes)]
			VAR _todas = [T25 · abstenção % todas as idades]
			VAR _f1 = [T25 · parte dos que faltaram · 16 e 17 anos]
			VAR _e1 = [T25 · parte dos aptos · 16 e 17 anos]
			VAR _f2 = [T25 · parte dos que faltaram · 18 a 24 anos]
			VAR _e2 = [T25 · parte dos aptos · 18 a 24 anos]
			VAR _f3 = [T25 · parte dos que faltaram · 25 a 34 anos]
			VAR _e3 = [T25 · parte dos aptos · 25 a 34 anos]
			VAR _f4 = [T25 · parte dos que faltaram · 35 a 44 anos]
			VAR _e4 = [T25 · parte dos aptos · 35 a 44 anos]
			VAR _f5 = [T25 · parte dos que faltaram · 45 a 59 anos]
			VAR _e5 = [T25 · parte dos aptos · 45 a 59 anos]
			VAR _f6 = [T25 · parte dos que faltaram · 60 a 69 anos]
			VAR _e6 = [T25 · parte dos aptos · 60 a 69 anos]
			VAR _f7 = [T25 · parte dos que faltaram · 70 anos ou mais]
			VAR _e7 = [T25 · parte dos aptos · 70 anos ou mais]
			-- 2 · Textos
			VAR _quem = IF ( _comFaixa = 1, " de " & _faixa, "" )
			VAR _nota = IF ( NOT ISBLANK ( _acimaX ), _acima & " pesam " & FORMAT ( _acimaX, "0.0" ) & " vezes mais" )
			-- 3 · Geometria (barras de 0 ao maior peso em 210 px)
			VAR _pesos = { ( 1, _f1, _e1 ), ( 2, _f2, _e2 ), ( 3, _f3, _e3 ), ( 4, _f4, _e4 ), ( 5, _f5, _e5 ), ( 6, _f6, _e6 ), ( 7, _f7, _e7 ) } /* lista */
			VAR _teto = MAX ( MAXX ( _pesos, [Value2] ), MAXX ( _pesos, [Value3] ) ) -- geometria
			VAR _linhas =
			    CONCATENATEX (
			        _pesos,
			        VAR _rot =
			            SWITCH (
			                [Value1],
			                1, "16–17",
			                2, "18–24",
			                3, "25–34",
			                4, "35–44",
			                5, "45–59",
			                6, "60–69",
			                7, "70+",
			                ""
			            )
			        RETURN
			            "<div class='cp" & IF ( [Value1] = _k, " on" ) & "' style='top:" & ( 44 + ( [Value1] - 1 ) * 24 ) & "px'>"
			                & "<span class='nf'>" & _rot & "</span>"
			                & "<i class='bf barra-x' style='width:" & FORMAT ( DIVIDE ( [Value2], _teto ) * 210, "0.0##", "en-US" ) & "px'></i>" -- geometria
			                & "<i class='be' style='width:" & FORMAT ( DIVIDE ( [Value3], _teto ) * 210, "0.0##", "en-US" ) & "px'></i>" -- geometria
			                & "<span class='vf'>" & FORMAT ( [Value2], "0%" ) & "</span><span class='ve'>" & FORMAT ( [Value3], "0%" )
			                & "</span></div>",
			        "",
			        [Value1], ASC
			    )
			VAR _css =
			    "<style>"
			        & ".ta .dp{margin-top:3px;font-size:15px;color:var(--grafite);white-space:nowrap;overflow:hidden;"
			        & "text-overflow:ellipsis}"
			        & ".ta .cps{position:absolute;left:18px;right:18px;top:150px;height:220px;border-top:1px dashed var(--areia);"
			        & "padding-top:8px}"
			        & ".ta .cps .tl{position:absolute;left:0;top:10px;font-size:15px;font-weight:600;color:var(--tinta)}"
			        & ".ta .cps .lg2{position:absolute;left:0;top:30px;font-size:13px;color:var(--cinza)}"
			        & ".ta .cps .lg2 i{display:inline-block;width:12px;height:8px;margin:0 5px 0 0}"
			        & ".ta .cps .lg2 i+i,.ta .cps .lg2 span+i{margin-left:14px}"
			        & ".ta .cp{position:absolute;left:0;right:0;height:22px;font-size:13px;color:var(--grafite)}"
			        & ".ta .cp>*{position:absolute}.ta .cp .nf{left:0;top:3px;width:48px;font-weight:600}"
			        & ".ta .cp.on .nf{color:var(--tinta);font-weight:800}"
			        & ".ta .cp .bf{left:52px;top:3px;height:9px;background:var(--tinta)}"
			        & ".ta .cp .be{left:52px;top:14px;height:4px;background:var(--areia)}"
			        & ".ta .cp .vf{left:276px;top:2px;width:44px;text-align:right;font-weight:700;color:var(--tinta)}"
			        & ".ta .cp .ve{left:328px;top:2px;width:56px;text-align:right;color:var(--cinza)}"
			        & ".ta .si{position:absolute;left:18px;right:18px;top:160px;font-size:17px;line-height:1.4;color:var(--grafite);"
			        & "border-top:1px dashed var(--areia);padding-top:12px}"
			    & "</style>"
			-- 4 · Marcação
			VAR _corpo =
			    IF (
			        _temIdade = 1 && NOT ISBLANK ( _teto ),
			        "<div class='cps sobe d3'><div class='tl'>Quem eram os que faltaram, por idade</div>"
			            & "<div class='lg2'><i style='background:var(--tinta)'></i>entre os que faltaram"
			            & "<span></span><i style='background:var(--areia);height:4px;margin-left:14px'></i>entre os eleitores</div>"
			            & _linhas & "</div>"
			            & "<div class='mao entra d8'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nota, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
			        "<div class='si sobe d3'>Em " & _ano & ", o TSE ainda não publicava a idade de quem faltou. O perfil por "
			            & "idade começa em 2014.</div>"
			    )
			VAR _html =
			    "<style>.tt{position:fixed;inset:0;background:var(--papel)}.tt .ficha{position:absolute;left:14px;top:22px;right:14px;bottom:14px;background:var(--branco);border:1.5px solid var(--areia);box-shadow:3px 4px 0 rgba(28,25,21,.07)}.tt .fita{position:absolute;left:150px;top:-16px;width:96px;transform:rotate(3deg);opacity:.9}.tt .ic{position:absolute;right:16px;top:14px;width:34px}.tt .cab{position:absolute;left:18px;top:14px;right:60px}.tt .nm{font-size:22px;font-weight:700;line-height:1.15;letter-spacing:-.01em}.tt .big{position:absolute;left:18px;font-size:44px;font-weight:700;letter-spacing:-.03em;line-height:1}.tt .bs{position:absolute;left:176px;right:18px;font-size:15px;color:var(--grafite);line-height:1.35}.tt .bs b,.tt .lin b{color:var(--tinta);font-weight:700}.tt .lin{position:absolute;left:18px;right:18px;border-top:1px dashed var(--areia);padding-top:8px;font-size:15px;color:var(--grafite);line-height:1.35}.tt .mao{position:absolute;right:18px;bottom:8px;font-size:28px;color:var(--tinta)}.tt .sp{position:absolute;left:18px}.tt .sp svg{overflow:visible}.tt .sp path{fill:none;stroke:var(--tinta);stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round}.tt .sp circle{fill:var(--tinta);stroke:var(--branco);stroke-width:2}.tt .sp .sr{position:absolute;width:80px;text-align:center;font-size:13px;font-weight:700}.tt .sp .sa{position:absolute;bottom:-20px;width:80px;text-align:center;font-size:13px;color:var(--cinza)}</style>" & _css
			        & "<div class='tt ta'><div class='ficha'>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/>"
			        & "<img class='ic' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/urna-tinta.png'/>"
			        & "<div class='cab sobe'><div class='nm'>1º turno de " & _ano & "</div>"
			        & "<div class='dp'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _disputa, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div>"
			        & IF (
			            ISBLANK ( _pct ),
			            "<div class='big sobe d1' style='top:78px'>" & FORMAT ( _todas, "0.0%" ) & "</div>"
			                & "<div class='bs sobe d2' style='top:82px'>faltaram, com todas as idades · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _lugar, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
			            "<div class='big sobe d1' style='top:78px'>" & SWITCH ( TRUE (), ABS ( _n ) >= 1000000, FORMAT ( _n / 1000000, "0.0" ) & " mi", ABS ( _n ) >= 1000, FORMAT ( _n / 1000, "0.0" ) & " mil", FORMAT ( _n, "#,0" ) ) & "</div>"
			                & "<div class='bs sobe d2' style='top:82px'>de " & SWITCH ( TRUE (), ABS ( _aptos ) >= 1000000, FORMAT ( _aptos / 1000000, "0.0" ) & " mi", ABS ( _aptos ) >= 1000, FORMAT ( _aptos / 1000, "0.0" ) & " mil", FORMAT ( _aptos, "#,0" ) ) & " eleitores" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _quem, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			                & " faltaram · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _lugar, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        )
			        & _corpo
			        & "</div></div>"
			RETURN
			    IF ( NOT ISBLANK ( _aptos ) || NOT ISBLANK ( _disputa ), _html )
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 17aba5d4-cfa6-54d5-bcc4-703c175a9a26

	/// Texto para leitor de tela do dossiê da faixa.
	measure 'T25 · Tooltip idade · ALT' =
			LEFT (
			    [T25 · faixa da linha] & ", " & [T25 · lugar] & ", " & [T25 · ano] & ": "
			        & IF ( ISBLANK ( [T25 · abstenção %] ), "o TSE só publica a idade desde 2014.",
			            FORMAT ( [T25 · abstenção %], "0.0%" ) & " faltaram; são " & FORMAT ( [T25 · parte dos aptos (faixa)], "0%" )
			                & " dos eleitores e " & FORMAT ( [T25 · parte dos que faltaram (faixa)], "0%" ) & " de quem faltou." ),
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 3ed353ca-b890-5b3b-89ff-34d3b1b4e640

	/// Dossiê da faixa de idade da barra: quantas pessoas faltaram (o % já está na barra), o peso da faixa entre os eleitores e entre os que faltaram, a minilinha de 2014 a 2026 e a nota à mão de quantas vezes a média de todas as idades. Só lê contas.
	measure 'T25 · Tooltip idade · HTML' =
			-- 1 · Leituras
			VAR _nome = [T25 · faixa da linha]
			VAR _voto = [T25 · voto da faixa]
			VAR _ano = [T25 · ano]
			VAR _lugar = [T25 · lugar]
			VAR _pct = [T25 · abstenção %]
			VAR _n = [T25 · abstenções]
			VAR _aptos = [T25 · aptos]
			VAR _pa = [T25 · parte dos aptos (faixa)]
			VAR _pf = [T25 · parte dos que faltaram (faixa)]
			VAR _vezes = [T25 · vezes a média (faixa)]
			VAR _p14 = [T25 · abstenção % em 2014]
			VAR _p18 = [T25 · abstenção % em 2018]
			VAR _p22 = [T25 · abstenção % em 2022]
			VAR _p26 = [T25 · abstenção % em 2026]
			-- 2 · Textos
			VAR _cab = _nome
			VAR _sub = _lugar & " · " & _ano & IF ( _voto = "facultativo", " · voto facultativo" )
			VAR _nota =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _vezes ), "",
			        _vezes >= 1.05, FORMAT ( _vezes, "0.0" ) & " vezes a média",
			        _vezes <= 0.95, "abaixo da média",
			        "bem na média"
			    )
			-- 3 · Geometria (minilinha de 200 × 60)
			VAR _serie = { ( 2014, _p14 ), ( 2018, _p18 ), ( 2022, _p22 ), ( 2026, _p26 ) } /* lista */
			VAR _pts = FILTER ( _serie, NOT ISBLANK ( [Value2] ) ) /* lista */
			VAR _min = MINX ( _pts, [Value2] ) -- geometria
			VAR _max = MAXX ( _pts, [Value2] ) -- geometria
			VAR _xy =
			    ADDCOLUMNS (
			        _pts, /* lista */
			        "@x", 8 + ( [Value1] - 2014 ) / 12 * 184, -- geometria
			        "@y", IF ( _max > _min, 42 - ( [Value2] - _min ) / ( _max - _min ) * 30, 30 ) -- geometria
			    )
			VAR _primeiro = MINX ( _xy, [Value1] ) -- geometria
			VAR _ultimo = MAXX ( _xy, [Value1] ) -- geometria
			VAR _linha = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0##", "en-US" ) & "," & FORMAT ( [@y], "0.0##", "en-US" ), " L", [Value1], ASC ) -- geometria
			VAR _bolas =
			    CONCATENATEX (
			        _xy,
			        "<circle cx='" & FORMAT ( [@x], "0.0##", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0##", "en-US" ) & "' r='" & IF ( [Value1] = _ultimo, "4.5", "3" ) & "'/>",
			        "",
			        [Value1], ASC
			    )
			VAR _rots =
			    CONCATENATEX (
			        FILTER ( _xy, [Value1] = _primeiro || [Value1] = _ultimo ), /* lista */
			        "<span class='sr' style='left:" & FORMAT ( [@x] - 40, "0.0##", "en-US" ) & "px;top:" & FORMAT ( [@y] - 24, "0.0##", "en-US" ) & "px'>"
			            & FORMAT ( [Value2], "0.0%" ) & "</span><span class='sa' style='left:" & FORMAT ( [@x] - 40, "0.0##", "en-US" ) & "px'>"
			            & [Value1] & "</span>",
			        "",
			        [Value1], ASC
			    )
			-- 4 · Marcação
			VAR _corpo =
			    IF (
			        ISBLANK ( _pct ),
			        "<div class='lin sobe d1' style='top:84px'>Em " & _ano & ", o TSE ainda não publicava a idade de quem "
			            & "faltou. O perfil por idade começa em 2014.</div>",
			        "<div class='big sobe d1' style='top:80px'>" & SWITCH ( TRUE (), ABS ( _n ) >= 1000000, FORMAT ( _n / 1000000, "0.0" ) & " mi", ABS ( _n ) >= 1000, FORMAT ( _n / 1000, "0.0" ) & " mil", FORMAT ( _n, "#,0" ) ) & "</div>"
			            & "<div class='bs sobe d2' style='top:84px'>de " & SWITCH ( TRUE (), ABS ( _aptos ) >= 1000000, FORMAT ( _aptos / 1000000, "0.0" ) & " mi", ABS ( _aptos ) >= 1000, FORMAT ( _aptos / 1000, "0.0" ) & " mil", FORMAT ( _aptos, "#,0" ) ) & " eleitores dessa idade "
			            & "faltaram</div>"
			            & "<div class='lin sobe d3' style='top:146px'>São <b>" & FORMAT ( _pa, "0%" ) & "</b> dos eleitores e <b>"
			            & FORMAT ( _pf, "0%" ) & "</b> de quem faltou</div>"
			            & "<div style='position:absolute;left:0;top:200px'>" & "<div class='sp'><svg width='200' height='60' viewBox='0 0 200 60'><path class='traco' pathLength='1' d='M" & _linha & "'/>" & _bolas & "</svg>" & _rots & "</div>" & "</div>"
			            & "<div class='mao entra d6'>" & _nota & "</div>"
			    )
			VAR _html =
			    "<style>.tt{position:fixed;inset:0;background:var(--papel)}.tt .ficha{position:absolute;left:14px;top:22px;right:14px;bottom:14px;background:var(--branco);border:1.5px solid var(--areia);box-shadow:3px 4px 0 rgba(28,25,21,.07)}.tt .fita{position:absolute;left:150px;top:-16px;width:96px;transform:rotate(3deg);opacity:.9}.tt .ic{position:absolute;right:16px;top:14px;width:34px}.tt .cab{position:absolute;left:18px;top:14px;right:60px}.tt .nm{font-size:22px;font-weight:700;line-height:1.15;letter-spacing:-.01em}.tt .big{position:absolute;left:18px;font-size:44px;font-weight:700;letter-spacing:-.03em;line-height:1}.tt .bs{position:absolute;left:176px;right:18px;font-size:15px;color:var(--grafite);line-height:1.35}.tt .bs b,.tt .lin b{color:var(--tinta);font-weight:700}.tt .lin{position:absolute;left:18px;right:18px;border-top:1px dashed var(--areia);padding-top:8px;font-size:15px;color:var(--grafite);line-height:1.35}.tt .mao{position:absolute;right:18px;bottom:8px;font-size:28px;color:var(--tinta)}.tt .sp{position:absolute;left:18px}.tt .sp svg{overflow:visible}.tt .sp path{fill:none;stroke:var(--tinta);stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round}.tt .sp circle{fill:var(--tinta);stroke:var(--branco);stroke-width:2}.tt .sp .sr{position:absolute;width:80px;text-align:center;font-size:13px;font-weight:700}.tt .sp .sa{position:absolute;bottom:-20px;width:80px;text-align:center;font-size:13px;color:var(--cinza)}</style>"
			        & "<div class='tt ti'><div class='ficha'>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/>"
			        & "<img class='ic' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/urna-tinta.png'/>"
			        & "<div class='cab sobe'><div class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _cab, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='rot'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _sub, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div>"
			        & _corpo
			        & "</div></div>"
			RETURN
			    IF ( NOT ISBLANK ( _nome ), _html )
		displayFolder: T25 Quem falta\Desenho
		lineageTag: 49919560-d01e-5118-99ae-18cc1d335bb5

	/// Texto para leitor de tela do dossiê do município.
	measure 'T25 · Tooltip município · ALT' =
			LEFT (
			    [T25 · município] & ", " & [T25 · ano] & IF ( [T25 · com faixa] = 1, ", " & [T25 · faixa] ) & ": "
			        & FORMAT ( [T25 · abstenção %], "0.0%" ) & " não foram votar (" & FORMAT ( [T25 · abstenções], "#,0" ) & " pessoas); média do "
			        & "recorte, " & FORMAT ( [T25 · abstenção % do recorte], "0.0%" ) & ".",
			    250
			)
		displayFolder: T25 Quem falta\Desenho
		lineageTag: ccd5e8f2-7087-562d-847d-01b0ed337e2b

	/// Dossiê do município do ponto (ficha presa com fita): o % de quem faltou no ano e na faixa do recorte, quantas pessoas, a comparação com a média do recorte, a minilinha de 2006 (ou 2014) a 2026 e, sem faixa marcada, a idade que mais e menos falta ali. Só lê contas.
	measure 'T25 · Tooltip município · HTML' =
			-- 1 · Leituras
			VAR _mun = [T25 · município]
			VAR _reg = [T25 · região do município]
			VAR _ano = [T25 · ano]
			VAR _comFaixa = [T25 · com faixa]
			VAR _faixa = [T25 · faixa]
			VAR _pct = [T25 · abstenção %]
			VAR _n = [T25 · abstenções]
			VAR _aptos = [T25 · aptos]
			VAR _um = [T25 · um em cada]
			VAR _ref = [T25 · abstenção % do recorte]
			VAR _dif = [T25 · diferença para o recorte]
			VAR _mais = [T25 · faixa que mais falta]
			VAR _maisP = [T25 · faixa que mais falta %]
			VAR _menos = [T25 · faixa que menos falta]
			VAR _menosP = [T25 · faixa que menos falta %]
			VAR _p06 = [T25 · abstenção % em 2006]
			VAR _p10 = [T25 · abstenção % em 2010]
			VAR _p14 = [T25 · abstenção % em 2014]
			VAR _p18 = [T25 · abstenção % em 2018]
			VAR _p22 = [T25 · abstenção % em 2022]
			VAR _p26 = [T25 · abstenção % em 2026]
			-- 2 · Textos
			VAR _media = [T25 · média (nome)]
			VAR _quem = IF ( _comFaixa = 1, " de " & _faixa, "" )
			VAR _compara =
			    IF (
			        NOT ISBLANK ( _ref ),
			        IF (
			            ABS ( _dif ) < 0.05,
			            "Bem na " & _media,
			            FORMAT ( ABS ( _dif ), "0.0" ) & IF ( ABS ( _dif ) < 2, " ponto ", " pontos " )
			                & IF ( _dif > 0, "acima", "abaixo" ) & " da " & _media
			        ) & " (<b>" & FORMAT ( _ref, "0.0%" ) & "</b>)"
			    )
			VAR _idade =
			    IF (
			        _comFaixa = 0 && NOT ISBLANK ( _mais ),
			        "Quem mais falta aqui: <b>" & _mais & "</b> (" & FORMAT ( _maisP, "0.0%" ) & "); quem menos: <b>" & _menos
			            & "</b> (" & FORMAT ( _menosP, "0.0%" ) & ")",
			        "A série" & _quem & " no município, ano a ano"
			    )
			VAR _nota = IF ( _um > 0, "1 em cada " & _um & " faltou" )
			-- 3 · Geometria (minilinha de 230 × 64)
			VAR _serie = { ( 2006, _p06 ), ( 2010, _p10 ), ( 2014, _p14 ), ( 2018, _p18 ), ( 2022, _p22 ), ( 2026, _p26 ) } /* lista */
			VAR _pts = FILTER ( _serie, NOT ISBLANK ( [Value2] ) ) /* lista */
			VAR _min = MINX ( _pts, [Value2] ) -- geometria
			VAR _max = MAXX ( _pts, [Value2] ) -- geometria
			VAR _xy =
			    ADDCOLUMNS (
			        _pts, /* lista */
			        "@x", 8 + ( [Value1] - 2006 ) / 20 * 214, -- geometria
			        "@y", IF ( _max > _min, 46 - ( [Value2] - _min ) / ( _max - _min ) * 34, 32 ) -- geometria
			    )
			VAR _primeiro = MINX ( _xy, [Value1] ) -- geometria
			VAR _ultimo = MAXX ( _xy, [Value1] ) -- geometria
			VAR _linha = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0##", "en-US" ) & "," & FORMAT ( [@y], "0.0##", "en-US" ), " L", [Value1], ASC ) -- geometria
			VAR _bolas =
			    CONCATENATEX (
			        _xy,
			        "<circle cx='" & FORMAT ( [@x], "0.0##", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0##", "en-US" ) & "' r='" & IF ( [Value1] = _ultimo, "4.5", "3" ) & "'/>",
			        "",
			        [Value1], ASC
			    )
			VAR _rots =
			    CONCATENATEX (
			        FILTER ( _xy, [Value1] = _primeiro || [Value1] = _ultimo ), /* lista */
			        "<span class='sr' style='left:" & FORMAT ( [@x] - 40, "0.0##", "en-US" ) & "px;top:" & FORMAT ( [@y] - 24, "0.0##", "en-US" ) & "px'>"
			            & FORMAT ( [Value2], "0.0%" ) & "</span><span class='sa' style='left:" & FORMAT ( [@x] - 40, "0.0##", "en-US" ) & "px'>"
			            & [Value1] & "</span>",
			        "",
			        [Value1], ASC
			    )
			-- 4 · Marcação
			VAR _html =
			    "<style>.tt{position:fixed;inset:0;background:var(--papel)}.tt .ficha{position:absolute;left:14px;top:22px;right:14px;bottom:14px;background:var(--branco);border:1.5px solid var(--areia);box-shadow:3px 4px 0 rgba(28,25,21,.07)}.tt .fita{position:absolute;left:150px;top:-16px;width:96px;transform:rotate(3deg);opacity:.9}.tt .ic{position:absolute;right:16px;top:14px;width:34px}.tt .cab{position:absolute;left:18px;top:14px;right:60px}.tt .nm{font-size:22px;font-weight:700;line-height:1.15;letter-spacing:-.01em}.tt .big{position:absolute;left:18px;font-size:44px;font-weight:700;letter-spacing:-.03em;line-height:1}.tt .bs{position:absolute;left:176px;right:18px;font-size:15px;color:var(--grafite);line-height:1.35}.tt .bs b,.tt .lin b{color:var(--tinta);font-weight:700}.tt .lin{position:absolute;left:18px;right:18px;border-top:1px dashed var(--areia);padding-top:8px;font-size:15px;color:var(--grafite);line-height:1.35}.tt .mao{position:absolute;right:18px;bottom:8px;font-size:28px;color:var(--tinta)}.tt .sp{position:absolute;left:18px}.tt .sp svg{overflow:visible}.tt .sp path{fill:none;stroke:var(--tinta);stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round}.tt .sp circle{fill:var(--tinta);stroke:var(--branco);stroke-width:2}.tt .sp .sr{position:absolute;width:80px;text-align:center;font-size:13px;font-weight:700}.tt .sp .sa{position:absolute;bottom:-20px;width:80px;text-align:center;font-size:13px;color:var(--cinza)}</style>"
			        & "<div class='tt tm'><div class='ficha'>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/>"
			        & "<img class='ic' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/urna-tinta.png'/>"
			        & "<div class='cab sobe'><div class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mun, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='rot'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & FORMAT ( _aptos, "#,0" ) & " eleitores" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _quem, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div>"
			        & "<div class='big sobe d1' style='top:84px'>" & FORMAT ( _pct, "0.0%" ) & "</div>"
			        & "<div class='bs sobe d2' style='top:88px'>não foram votar em " & _ano & ": <b>" & FORMAT ( _n, "#,0" ) & "</b> "
			        & IF ( _n = 1, "pessoa", "pessoas" ) & ". " & _compara & ".</div>"
			        & "<div class='lin sobe d3' style='top:150px'>" & _idade & "</div>"
			        & "<div style='position:absolute;left:0;top:206px'>" & "<div class='sp'><svg width='230' height='64' viewBox='0 0 230 64'><path class='traco' pathLength='1' d='M" & _linha & "'/>" & _bolas & "</svg>" & _rots & "</div>" & "</div>"
			        & "<div class='mao entra d6'>" & _nota & "</div>"
			        & "</div></div>"
			RETURN
			    IF ( NOT ISBLANK ( _mun ) && NOT ISBLANK ( _aptos ), _html )
		displayFolder: T25 Quem falta\Desenho
		lineageTag: d9545b12-68ed-50c7-b674-c6ef799d8813

	/// Os debates marcados no 2º turno ANTES deste (tabela Debate, data anterior ao dia do debate da Globo), um por linha, com o que houve para o candidato da linha do contexto: esteve, não esteve, cancelado ou não aconteceu. Separados por |. Desde 24/10/2026 a própria Globo (23/10) é linha da tabela Debate: o filtro de data a deixa fora da lista do 'antes deste'.
	measure 'T26 · 2º turno · debates' =
			VAR _cand = [T26 · linha · candidato]
			VAR _globo = [T26 · debate · dia]
			RETURN
			    CONCATENATEX (
			        CALCULATETABLE (
			            VALUES ( Debate[Data] ),
			            REMOVEFILTERS ( Debate ),
			            Debate[Turno] = 2,
			            Debate[Data] < _globo || ISBLANK ( _globo )
			        ),
			        VAR _d = Debate[Data]
			        VAR _emi = CALCULATE ( MAX ( Debate[Emissora] ), REMOVEFILTERS ( Debate ), Debate[Data] = _d )
			        VAR _obs = UPPER ( CALCULATE ( MAX ( Debate[Observação] ), REMOVEFILTERS ( Debate ), Debate[Data] = _d ) )
			        VAR _part = CALCULATE ( MAX ( Debate[Participantes] ), REMOVEFILTERS ( Debate ), Debate[Data] = _d )
			        VAR _curta = IF ( CONTAINSSTRING ( _emi, "," ), LEFT ( _emi, SEARCH ( ",", _emi ) - 1 ) & " e consórcio", _emi )
			        VAR _st =
			            SWITCH (
			                TRUE (),
			                LEFT ( _obs, 9 ) = "REALIZADO", IF ( _cand <> "" && CONTAINSSTRING ( _part, _cand ), "esteve", "não esteve" ),
			                LEFT ( _obs, 9 ) = "CANCELADO", "cancelado",
			                "não aconteceu"
			            )
			        RETURN FORMAT ( _d, "dd/MM" ) & " · " & _curta & ": " & _st,
			        "|",
			        Debate[Data], ASC
			    )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 9ecaeb43-b54b-535d-baa6-5eafc9c88d90

	/// Quantos debates do 2º turno aconteceram antes deste (tabela Debate, data anterior ao dia do debate da Globo; a própria Globo, linha da tabela desde 24/10/2026, fica fora).
	measure 'T26 · 2º turno · realizados' =
			VAR _globo = [T26 · debate · dia]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Debate ),
			        REMOVEFILTERS ( Debate ),
			        Debate[Turno] = 2,
			        LEFT ( Debate[Observação], 9 ) = "REALIZADO",
			        Debate[Data] < _globo || ISBLANK ( _globo )
			    ) + 0
		formatString: 0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 7de1b19e-7a34-52d1-a5f4-1182327e4010

	/// Quantas linhas o arquivo do debate trouxe (dados/pbi/debate_globo.csv). Zero = a tabela existe, mas o arquivo ainda não foi lido: a tela diz isso em vez de mostrar campos vazios.
	measure 'T26 · arquivo · linhas' =
			COUNTROWS ( ALL ( 'T26 Debate Globo' ) ) + 0
		formatString: 0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 5f069262-1b9b-52f8-8fd1-fb1b678ab899

	/// Audiência do debate na Grande SP, consolidado (pontos). Vazio enquanto não chega (linha 'audiencia_consolidado' do arquivo).
	measure 'T26 · audiência · consolidado' =
