	/// Fontes da data, da hora e do formato do debate.
	measure 'T26 · debate · fonte' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Fonte] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "debate" )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: b4d5c312-7d43-5584-b304-e7d50c9c3604

	/// Data e hora marcadas para o debate (Brasília).
	measure 'T26 · debate · início' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Previsto] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "debate" )
		formatString: dd/MM/yyyy HH:mm
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: cc4fce8f-eeb4-529f-8c4f-39593d4d82c0

	/// Motivo de um cancelamento ou adiamento (texto da linha 'debate'); vazio se não houver.
	measure 'T26 · debate · motivo' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Texto] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "debate" )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: e0f22945-941b-547c-b5ac-91e02976bf5d

	/// Situação do debate na linha 'debate' do arquivo: marcado, no_ar, realizado, adiado ou cancelado (outro texto ou vazio conta como marcado).
	measure 'T26 · debate · situação' =
			VAR _s = LOWER ( TRIM ( CALCULATE ( MAX ( 'T26 Debate Globo'[Situação] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "debate" ) ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        _s IN { "no_ar", "no ar", "ao vivo", "ao_vivo" }, "no_ar",
			        _s IN { "realizado", "adiado", "cancelado" }, _s,
			        "marcado"
			    )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: eb8f3c85-5a43-5b46-ad68-dda595cf0364

	/// Coluna Atualizado da linha do contexto ('T26 Debate Globo'); com mais de uma linha (um cartão), a de menor Ordem. Vazio sem linha.
	measure 'T26 · linha · atualizado' =
			VAR _o = MIN ( 'T26 Debate Globo'[Ordem] )
			RETURN
			    CALCULATE ( MAX ( 'T26 Debate Globo'[Atualizado] ), 'T26 Debate Globo'[Ordem] = _o )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: e2bd1216-1383-5c29-b7e3-8d46a71a62d1

	/// Coluna Candidato da linha do contexto ('T26 Debate Globo'); com mais de uma linha (um cartão), a de menor Ordem. Vazio sem linha.
	measure 'T26 · linha · candidato' =
			VAR _o = MIN ( 'T26 Debate Globo'[Ordem] )
			RETURN
			    CALCULATE ( MAX ( 'T26 Debate Globo'[Candidato] ), 'T26 Debate Globo'[Ordem] = _o )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: b51677a7-6a04-5217-b452-5705ed8fd1e9

	/// Coluna Chave da linha do contexto ('T26 Debate Globo'); com mais de uma linha (um cartão), a de menor Ordem. Vazio sem linha.
	measure 'T26 · linha · chave' =
			VAR _o = MIN ( 'T26 Debate Globo'[Ordem] )
			RETURN
			    CALCULATE ( MAX ( 'T26 Debate Globo'[Chave] ), 'T26 Debate Globo'[Ordem] = _o )
