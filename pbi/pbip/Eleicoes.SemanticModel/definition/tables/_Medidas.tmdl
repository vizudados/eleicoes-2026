	/// Último dia de campo da pesquisa anterior do mesmo instituto (2º turno, votos totais, depois do 1º turno); vazio quando é a primeira dele.
	measure 'T07 · pesquisa · campo anterior' =
			VAR _inst = [T07 · pesquisa · instituto]
