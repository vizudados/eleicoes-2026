	/// Entre as simulações de 2º turno feitas antes do 1º turno, quantas deram empate.
	measure 'T17 · antes · empates' =
			CALCULATE (
			    COUNTROWS ( Pesquisa ),
			    REMOVEFILTERS ( Pesquisa ),
			    Pesquisa[Cenário] = "2º turno",
			    Pesquisa[Tipo] = "totais",
			    NOT ISBLANK ( Pesquisa[Lula] ),
			    NOT ISBLANK ( Pesquisa[Flavio] ),
			    Pesquisa[Momento] = "antes_1turno",
			    FILTER ( ALL ( Pesquisa[Lula], Pesquisa[Flavio] ), Pesquisa[Flavio] = Pesquisa[Lula] )
			) + 0
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: aed30fe9-54f1-579f-afc8-4199655467d1

	/// Entre as simulações de 2º turno feitas antes do 1º turno, quantas deram Flávio à frente.
	measure 'T17 · antes · Flávio à frente' =
			CALCULATE (
			    COUNTROWS ( Pesquisa ),
			    REMOVEFILTERS ( Pesquisa ),
			    Pesquisa[Cenário] = "2º turno",
			    Pesquisa[Tipo] = "totais",
			    NOT ISBLANK ( Pesquisa[Lula] ),
			    NOT ISBLANK ( Pesquisa[Flavio] ),
			    Pesquisa[Momento] = "antes_1turno",
			    FILTER ( ALL ( Pesquisa[Lula], Pesquisa[Flavio] ), Pesquisa[Flavio] > Pesquisa[Lula] )
			) + 0
