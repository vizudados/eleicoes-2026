		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 0e8b29ff-5b0d-5800-a190-2468dca2d114

	/// Interações com Lula nas 24 horas depois do debate. Vazio enquanto não chega (linha 'redes_lula' do arquivo).
	measure 'T26 · redes · Lula' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Valor] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "redes_lula" )
		formatString: #,0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: c8444daf-7999-5b65-b20e-e3db042b8c71

	/// Quantos blocos com tempo marcado o arquivo traz (grupo regra, com valor).
	measure 'T26 · regras · blocos' =
			CALCULATE ( COUNTROWS ( 'T26 Debate Globo' ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "regra", NOT ISBLANK ( 'T26 Debate Globo'[Valor] ) ) + 0
		formatString: 0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: b9f8033b-642f-5cb4-83ee-3ef0b424118f

	/// Pico de aparelhos assistindo ao mesmo tempo na internet. Vazio enquanto não chega (linha 'streaming_pico' do arquivo).
	measure 'T26 · streaming · pico' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Valor] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "streaming_pico" )
		formatString: #,0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: d98a11dc-28d1-570d-b1ca-ab7854ca3d63

	/// Texto da linha 'transmissao' do arquivo do debate.
	measure 'T26 · transmissão' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Texto] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "transmissao" )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 2109cb3c-fd31-535f-828d-7f53fa9eaa93

	/// Texto puro dos cartões.
	measure 'T26 · Cartões · ALT' =
			"Os " & FORMAT ( [T26 · cartões · total], "0" ) & " números da noite (buscas, audiência, transmissão na internet, redes e pesquisas), cada um com a hora e a fonte esperadas e a régua do debate da Band; "
			    & FORMAT ( [T26 · cartões · chegaram], "0" ) & IF ( [T26 · cartões · chegaram] = 1, " já chegou", " já chegaram" )
			    & ". Passe o mouse num cartão para o detalhe."
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: e208e505-353b-53ff-96b1-a2996693f009

	/// Um cartão por métrica da noite (grão 'T26 Debate Globo'[Cartão]): quando chega, o título, o que mede, o número (contador) ou o lugar dele tracejado com 'aguardando', a fonte (ou a esperada) e a régua do debate da Band na mesma medida; nas pesquisas, o antes. Alvo do dossiê ttT26Cartao.
	measure 'T26 · Cartões · HTML' =
			-- 1 · Leituras (contas de T26 Debate na Globo\Contas)
			VAR _c = SELECTEDVALUE ( 'T26 Debate Globo'[Cartão] )
			VAR _est = [T26 · cartão · estado]
			VAR _pos = [T26 · cartão · posição]
			VAR _rot = [T26 · linha · rótulo]
			VAR _med = [T26 · linha · medida]
			VAR _sit = [T26 · debate · situação]
			VAR _bLula = [T26 · buscas · Lula]
			VAR _bFlavio = [T26 · buscas · Flávio]
			VAR _audP = [T26 · audiência · prévia]
			VAR _audC = [T26 · audiência · consolidado]
			VAR _str = [T26 · streaming · pico]
			VAR _rLula = [T26 · redes · Lula]
			VAR _rFlavio = [T26 · redes · Flávio]
			VAR _pN = [T26 · pesquisas · depois · n]
			VAR _pL = [T26 · pesquisas · depois · Lula]
			VAR _pF = [T26 · pesquisas · depois · Flávio]
			VAR _pIni = [T26 · pesquisas · depois · primeiro campo]
			VAR _pFim = [T26 · pesquisas · depois · último campo]
			VAR _pInst = [T26 · pesquisas · depois · institutos]
			VAR _aN = [T26 · pesquisas · antes · n]
			VAR _aL = [T26 · pesquisas · antes · Lula]
			VAR _aF = [T26 · pesquisas · antes · Flávio]
			VAR _aIni = [T26 · pesquisas · antes · primeiro campo]
			VAR _aFim = [T26 · pesquisas · antes · último campo]
			VAR _xN = [T26 · pesquisas · atravessam · n]
			VAR _bandC = [T26 · Band · audiência]
			VAR _bandP = [T26 · Band · audiência prévia]
			VAR _bandS = [T26 · Band · pico streaming]
			VAR _bandBL = [T26 · Band · buscas · Lula]
			VAR _bandBF = [T26 · Band · buscas · Flávio]
			VAR _bandRL = [T26 · Band · redes · Lula]
			VAR _bandRF = [T26 · Band · redes · Flávio]
			VAR _band = [T26 · Band · data]
			-- a linha que fala por este cartão: o que falta chegar (a prévia antes do consolidado) ou o que chegou por último
			VAR _chaveTxt =
			    SWITCH (
			        _c,
			        "audiencia", IF ( _est IN { "previa", "consolidado" }, "audiencia_consolidado", "audiencia_previa" ),
			        "buscas", IF ( ISBLANK ( _bLula ) && NOT ISBLANK ( _bFlavio ), "buscas_flavio", "buscas_lula" ),
			        "redes", IF ( ISBLANK ( _rLula ) && NOT ISBLANK ( _rFlavio ), "redes_flavio", "redes_lula" ),
			        "streaming", "streaming_pico",
			        "pesquisas", "pesquisas_depois"
			    )
			VAR _esp = CALCULATE ( [T26 · linha · esperado], 'T26 Debate Globo'[Chave] = _chaveTxt )
			VAR _chaveFonte = IF ( _c = "audiencia", IF ( _est = "consolidado", "audiencia_consolidado", "audiencia_previa" ), _chaveTxt )
			VAR _fonte = CALCULATE ( [T26 · linha · fonte], 'T26 Debate Globo'[Chave] = _chaveFonte )
			VAR _atu = CALCULATE ( [T26 · linha · atualizado], 'T26 Debate Globo'[Chave] = _chaveFonte )
			VAR _un = CALCULATE ( [T26 · linha · unidade], 'T26 Debate Globo'[Chave] = _chaveFonte )
			-- 2 · Textos
			VAR _chegou = _est IN { "publicado", "previa", "consolidado" }
			VAR _parado = _est IN { "cancelado", "adiado" }
			VAR _quando =
			    SWITCH (
			        TRUE (),
			        _parado, "<div class='rot'>" & IF ( _est = "cancelado", "DEBATE CANCELADO", "DEBATE ADIADO" ) & "</div>",
			        _est = "consolidado", "<div class='rot'>CHEGOU · CONSOLIDADO</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _atu, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
			        _est = "previa", "<div class='rot'>FALTA O CONSOLIDADO</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _esp, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
			        _est = "publicado" && _c = "pesquisas",
			            "<div class='rot'>" & IF ( _pN = 1, "CHEGOU", "CHEGARAM" ) & "</div><div class='qt'>" & FORMAT ( _pN, "0" )
			                & IF ( _pN = 1, " pesquisa, campo até ", " pesquisas, campo até " ) & FORMAT ( _pFim, "dd/MM" ) & "</div>",
			        _est = "publicado", "<div class='rot'>CHEGOU</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _atu, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
			        -- pesquisas: saíram, mas nenhuma com o campo inteiro depois do debate (24/10/2026, véspera da eleição)
			        _est = "nao_divulgado" && _c = "pesquisas",
			            "<div class='rot'>NENHUMA DEPOIS</div><div class='qt'>campo no dia do debate</div>",
			        _est = "nao_divulgado", "<div class='rot'>NÃO DIVULGADO</div><div class='qt'>esperado: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _esp, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
			        "<div class='rot'>" & IF ( _est = "parcial", "FALTA UM DOS DOIS", "ESPERADO" ) & "</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _esp, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			    )
			VAR _humBandS = SWITCH ( TRUE (), ABS ( _bandS ) >= 10000000, FORMAT ( _bandS / 1000000, "0.0" ) & " mi", ABS ( _bandS ) >= 1000000, FORMAT ( _bandS / 1000000, "0.00" ) & " mi", ABS ( _bandS ) >= 1000, FORMAT ( _bandS / 1000, "#,0" ) & " mil", FORMAT ( _bandS, "#,0" ) )
			VAR _humBandRL = SWITCH ( TRUE (), ABS ( _bandRL ) >= 10000000, FORMAT ( _bandRL / 1000000, "0.0" ), ABS ( _bandRL ) >= 1000000, FORMAT ( _bandRL / 1000000, "0.0" ), ABS ( _bandRL ) >= 1000, FORMAT ( _bandRL / 1000, "#,0" ), FORMAT ( _bandRL, "#,0" ) ) & SWITCH ( TRUE (), ABS ( _bandRL ) >= 1000000, " mi", ABS ( _bandRL ) >= 1000, " mil", "" )
			VAR _humBandRF = SWITCH ( TRUE (), ABS ( _bandRF ) >= 10000000, FORMAT ( _bandRF / 1000000, "0.0" ), ABS ( _bandRF ) >= 1000000, FORMAT ( _bandRF / 1000000, "0.0" ), ABS ( _bandRF ) >= 1000, FORMAT ( _bandRF / 1000, "#,0" ), FORMAT ( _bandRF, "#,0" ) ) & SWITCH ( TRUE (), ABS ( _bandRF ) >= 1000000, " mi", ABS ( _bandRF ) >= 1000, " mil", "" )
			VAR _vazioUm =
			    SWITCH (
			        TRUE (),
			        _parado, "<div class='vz pa'><svg class='mold' width='268' height='100' viewBox='0 0 268 100'><path d='M4 5 C 80 2, 188 4, 264 5 C 266 40, 263 70, 264 96 C 174 99, 80 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>sem número</div></div>",
			        _est = "nao_divulgado", "<div class='vz nd'><div class='ndt'>não divulgado</div></div>",
			        "<div class='vz ag'><svg class='mold' width='268' height='100' viewBox='0 0 268 100'><path d='M4 5 C 80 2, 188 4, 264 5 C 266 40, 263 70, 264 96 C 174 99, 80 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>aguardando</div></div>"
			    )
			-- o par (Lula e Flávio, o mesmo tratamento): o número de cada um, ou o lugar dele tracejado
			VAR _parLula =
			    SWITCH (
			        _c,
			        "buscas", IF ( ISBLANK ( _bLula ), BLANK (), FORMAT ( _bLula, "0" ) ),
			        "redes", IF ( ISBLANK ( _rLula ), BLANK (), SWITCH ( TRUE (), ABS ( _rLula ) >= 10000000, FORMAT ( _rLula / 1000000, "0.0" ), ABS ( _rLula ) >= 1000000, FORMAT ( _rLula / 1000000, "0.0" ), ABS ( _rLula ) >= 1000, FORMAT ( _rLula / 1000, "#,0" ), FORMAT ( _rLula, "#,0" ) ) ),
			        "pesquisas", IF ( _pN > 0, FORMAT ( _pL, "0.0" ), BLANK () )
			    )
			VAR _parFlavio =
			    SWITCH (
			        _c,
			        "buscas", IF ( ISBLANK ( _bFlavio ), BLANK (), FORMAT ( _bFlavio, "0" ) ),
			        "redes", IF ( ISBLANK ( _rFlavio ), BLANK (), SWITCH ( TRUE (), ABS ( _rFlavio ) >= 10000000, FORMAT ( _rFlavio / 1000000, "0.0" ), ABS ( _rFlavio ) >= 1000000, FORMAT ( _rFlavio / 1000000, "0.0" ), ABS ( _rFlavio ) >= 1000, FORMAT ( _rFlavio / 1000, "#,0" ), FORMAT ( _rFlavio, "#,0" ) ) ),
			        "pesquisas", IF ( _pN > 0, FORMAT ( _pF, "0.0" ), BLANK () )
			    )
			-- a unidade fica fora do número (menor), para o par caber na metade do cartão
			VAR _sufLula = SWITCH ( _c, "redes", SWITCH ( TRUE (), ABS ( _rLula ) >= 1000000, " mi", ABS ( _rLula ) >= 1000, " mil", "" ), "pesquisas", "%", "" )
			VAR _sufFlavio = SWITCH ( _c, "redes", SWITCH ( TRUE (), ABS ( _rFlavio ) >= 1000000, " mi", ABS ( _rFlavio ) >= 1000, " mil", "" ), "pesquisas", "%", "" )
			VAR _vazioMeio =
			    SWITCH (
			        TRUE (),
			        _parado, "<svg class='mold' width='128' height='100' viewBox='0 0 128 100'><path d='M4 5 C 38 2, 90 4, 124 5 C 126 40, 123 70, 124 96 C 83 99, 38 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>sem número</div>",
			        _est = "nao_divulgado", "<div class='ndt'>" & IF ( _c = "pesquisas", "nenhuma", "não saiu" ) & "</div>",
			        "<svg class='mold' width='128' height='100' viewBox='0 0 128 100'><path d='M4 5 C 38 2, 90 4, 124 5 C 126 40, 123 70, 124 96 C 83 99, 38 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>aguardando</div>"
			    )
			VAR _par =
			    "<div class='vz par'>"
			        & "<div class='lado" & IF ( ISBLANK ( _parLula ), " vazio", "" ) & "'><div class='rot lula-esc'>LULA</div>"
			            & IF ( ISBLANK ( _parLula ), _vazioMeio, "<div class='nl'><span class='num lula'>" & _parLula & "</span><small>" & _sufLula & "</small></div>" ) & "</div>"
			        & "<div class='lado" & IF ( ISBLANK ( _parFlavio ), " vazio", "" ) & "'><div class='rot flavio-esc'>FLÁVIO</div>"
			            & IF ( ISBLANK ( _parFlavio ), _vazioMeio, "<div class='nl'><span class='num flavio'>" & _parFlavio & "</span><small>" & _sufFlavio & "</small></div>" ) & "</div>"
			    & "</div>"
			VAR _um =
			    SWITCH (
			        _c,
			        "audiencia",
			            IF (
			                _est IN { "previa", "consolidado" },
			                "<div class='vz um'><span class='num'>" & FORMAT ( IF ( _est = "consolidado", _audC, _audP ), "0.0" ) & "</span><span class='un'>"
			                    & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _un, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span><span class='tag'>" & IF ( _est = "consolidado", "CONSOLIDADO", "PRÉVIA" ) & "</span></div>",
			                _vazioUm
			            ),
			        "streaming",
			            IF (
			                _est = "publicado",
			                "<div class='vz um'><span class='num'>" & SWITCH ( TRUE (), ABS ( _str ) >= 10000000, FORMAT ( _str / 1000000, "0.0" ), ABS ( _str ) >= 1000000, FORMAT ( _str / 1000000, "0.00" ), ABS ( _str ) >= 1000, FORMAT ( _str / 1000, "#,0" ), FORMAT ( _str, "#,0" ) ) & "</span><span class='un'>" & TRIM ( SWITCH ( TRUE (), ABS ( _str ) >= 1000000, " mi", ABS ( _str ) >= 1000, " mil", "" ) )
			                    & IF ( _str >= 1000, " de ", "" ) & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _un, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span></div>",
			                _vazioUm
			            )
			    )
			VAR _valor = IF ( _c IN { "audiencia", "streaming" }, _um, _par )
			VAR _fonteTxt =
			    SWITCH (
			        TRUE (),
			        _c = "pesquisas" && _pN > 0,
			            "Fonte: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _pInst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · campo de " & FORMAT ( _pIni, "dd/MM" ) & " a " & FORMAT ( _pFim, "dd/MM" ) & ", registro no TSE",
			        _chegou || _est = "parcial", "Fonte: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fonte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ),
			        "" -- sem número, a fonte esperada fica só no dossiê do cartão (tela mais limpa, 23/10/2026)
			    )
			-- a régua da Band (a mesma medida) ou, nas pesquisas, o antes
			VAR _refAud = IF ( _est = "previa", _bandP, _bandC )
			VAR _vAud = IF ( _est = "consolidado", _audC, IF ( _est = "previa", _audP, BLANK () ) )
			VAR _escS = MAX ( _bandS, IF ( _est = "publicado", _str, 0 ) ) -- geometria
			VAR _barras =
			    SWITCH (
			        _c,
			        "audiencia",
			            VAR _esc = MAX ( _refAud, COALESCE ( _vAud, 0 ) ) -- geometria
			            RETURN
			                "<div class='br'><span class='bn'>Globo</span>"
			                    & IF ( ISBLANK ( _vAud ), "<i class='g oca'></i>", "<i class='g barra-x' style='width:" & FORMAT ( _vAud / _esc * 140, "0.0##", "en-US" ) & "px'></i>" ) & "</div>"
			                    & "<div class='br'><span class='bn'>Band</span><i class='b barra-x' style='width:" & FORMAT ( _refAud / _esc * 140, "0.0##", "en-US" ) & "px'></i><b class='num'>"
			                    & IF ( _refAud = INT ( _refAud ), FORMAT ( _refAud, "0" ), FORMAT ( _refAud, "0.0" ) ) & "</b></div>",
			        "streaming",
			            "<div class='br'><span class='bn'>Globo</span>"
			                & IF ( _est = "publicado", "<i class='g barra-x' style='width:" & FORMAT ( _str / _escS * 140, "0.0##", "en-US" ) & "px'></i>", "<i class='g oca'></i>" ) & "</div>"
			                & "<div class='br'><span class='bn'>Band</span><i class='b barra-x' style='width:" & FORMAT ( _bandS / _escS * 140, "0.0##", "en-US" ) & "px'></i><b class='num'>"
			                & _humBandS & "</b></div>"
			    )
			VAR _naBand = "<div class='rot'>NA BAND, " & FORMAT ( _band, "dd/MM" ) & " <span class='rq'>· "
			VAR _ref =
			    SWITCH (
			        _c,
			        "buscas",
			            _naBand & "pico da noite</span></div><div class='rv'><span class='lula-esc'>Lula <b class='num'>"
			                & FORMAT ( _bandBL, "0" ) & "</b></span><span class='flavio-esc'>Flávio <b class='num'>" & FORMAT ( _bandBF, "0" ) & "</b></span></div>",
			        "redes",
			            _naBand & "Bites, 24 horas</span></div><div class='rv'><span class='lula-esc'>Lula <b class='num'>"
			                & _humBandRL & "</b></span><span class='flavio-esc'>Flávio <b class='num'>" & _humBandRF & "</b></span></div>",
			        "pesquisas",
			            IF (
			                _aN = 0,
			                "<div class='rot'>ANTES <span class='rq'>· nenhuma pesquisa entre os debates</span></div>",
			                "<div class='rot'>ANTES <span class='rq'>· " & FORMAT ( _aN, "0" ) & IF ( _aN = 1, " pesquisa, de ", " pesquisas, de " ) & FORMAT ( _aIni, "dd" ) & " a "
			                    & FORMAT ( _aFim, "dd/MM" ) & "</span></div><div class='rv'><span class='lula-esc'>Lula <b class='num'>" & FORMAT ( _aL, "0.0" )
			                    & "%</b></span><span class='flavio-esc'>Flávio <b class='num'>" & FORMAT ( _aF, "0.0" ) & "%</b></span></div>"
			            ),
			        "audiencia", _naBand & IF ( _est = "previa", "prévia", "consolidado" ) & "</span></div>" & _barras,
			        "streaming", _naBand & "YouTube da Band</span></div>" & _barras
			    )
			VAR _notaP =
			    IF (
			        _c = "pesquisas" && NOT _chegou && NOT _parado,
			        -- com o cartão em "nenhuma" (as de sábado já saíram), a nota diz o fato; antes, o que se esperava
			        "<div class='np'>"
			            & IF (
			                _est = "nao_divulgado",
			                "Nenhuma pesquisa nacional teve o campo inteiro depois do debate.",
			                "Provavelmente só as últimas de sábado, véspera da eleição, e talvez nenhuma."
			            )
			            & IF ( _xN > 0, " " & FORMAT ( _xN, "0" ) & IF ( _xN = 1, " atravessa", " atravessam" ) & " o dia do debate e fica" & IF ( _xN = 1, "", "m" ) & " fora.", "" ) & "</div>",
			        ""
			    )
			-- 3 · Geometria (cartões de 300 px com 30 de vão, pendurados na fita em y 72; o topo do cartão em y 88, no CSS)
			VAR _x = ( _pos - 1 ) * 330 -- geometria
			VAR _atraso = 400 + _pos * 140 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _est ),
			        "<div class='tela t26c'>"
			            & "<div class='cx " & _est & "' style='left:" & _x & "px;animation-delay:" & _atraso & "ms'>"
			                & "<i class='tk'></i><i class='ic ic-" & _c & "'></i>"
			                & "<div class='qd'>" & _quando & "</div>"
			                & "<div class='ti'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rot, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			                & "<div class='me'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _med, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			                & _valor & _notaP
			                & IF ( _fonteTxt = "", "", "<div class='fo'>" & _fonteTxt & "</div>" )
			                & "<div class='ref'>" & _ref & "</div>"
			            & "</div>"
			        & "</div>"
			    )
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: aaec9949-0138-5436-861a-273880994b84

	/// Texto puro da ficha para leitor de tela.
	measure 'T26 · Ficha · ALT' =
			VAR _sit = [T26 · debate · situação]
			VAR _ini = [T26 · debate · início]
			VAR _aus = [T26 · ausentes]
			VAR _n = [T26 · cartões · chegaram]
			VAR _tot = [T26 · cartões · total]
			RETURN
			    "Debate da Globo, 2º turno: " & SWITCH ( _sit, "cancelado", "cancelado", "adiado", "adiado", "no_ar", "no ar", "realizado", "realizado", "marcado" )
			        & IF ( ISBLANK ( _ini ), "", " para " & FORMAT ( _ini, "dd/MM" ) & ", " & FORMAT ( _ini, "HH" ) & "h" & FORMAT ( _ini, "nn" ) )
			        & ", com mediação de " & [T26 · mediação] & ". "
			        & IF ( _aus <> "", "Ausente: " & _aus & ". ", "" )
			        & "Números da noite: " & FORMAT ( _n, "0" ) & " de " & FORMAT ( _tot, "0" ) & "."
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 8cb5959b-b8f7-5cb4-af83-9b8cad2e8130

	/// A ficha da noite: selo da situação, a hora, onde passa, mediação, local e checagem, a manchete (responde à pergunta com o que já se sabe: ausência, pesquisas depois do debate, audiência contra a Band ou a espera), a linha dos números que chegaram (as regras em blocos e a checagem saíram em 23/10/2026).
	measure 'T26 · Ficha · HTML' =
			-- 1 · Leituras (contas de T26 Debate na Globo\Contas)
			VAR _sit = [T26 · debate · situação]
			VAR _ini = [T26 · debate · início]
			VAR _atu = [T26 · debate · atualizado]
			VAR _motivo = [T26 · debate · motivo]
			VAR _trans = [T26 · transmissão]
			VAR _med = [T26 · mediação]
			VAR _local = [T26 · local]
			VAR _aus = [T26 · ausentes]
			VAR _n = [T26 · cartões · chegaram]
			VAR _tot = [T26 · cartões · total]
			VAR _nd = [T26 · cartões · não divulgados]
			VAR _audC = [T26 · audiência · consolidado]
			VAR _audP = [T26 · audiência · prévia]
			VAR _bandC = [T26 · Band · audiência]
			VAR _bandP = [T26 · Band · audiência prévia]
			VAR _pN = [T26 · pesquisas · depois · n]
			VAR _pL = [T26 · pesquisas · depois · Lula]
			VAR _pF = [T26 · pesquisas · depois · Flávio]
			VAR _aL = [T26 · pesquisas · antes · Lula]
			VAR _aF = [T26 · pesquisas · antes · Flávio]
			VAR _aN = [T26 · pesquisas · antes · n]
			-- 2 · Textos
			VAR _sitEf = IF ( _sit IN { "marcado", "no_ar" } && _n > 0, "realizado", _sit )
			VAR _selo =
			    SWITCH ( _sit, "no_ar", "NO AR", "realizado", "REALIZADO", "adiado", "ADIADO", "cancelado", "CANCELADO", "MARCADO" )
			VAR _hora = IF ( ISBLANK ( _ini ), "—", FORMAT ( _ini, "HH" ) & "h" & FORMAT ( _ini, "nn" ) )
			VAR _dia = IF ( ISBLANK ( _ini ), "", UPPER ( FORMAT ( _ini, "dddd" ) ) & ", " & FORMAT ( _ini, "dd/MM" ) & " · " )
			VAR _aud = IF ( NOT ISBLANK ( _audC ), _audC, _audP )
			VAR _ref = IF ( NOT ISBLANK ( _audC ), _bandC, _bandP )
			VAR _cmp = SWITCH ( TRUE (), _aud > _ref, "mais que", _aud < _ref, "menos que", "o mesmo que" )
			VAR _frAus =
			    SWITCH (
			        TRUE (),
			        _aus = "", "",
			        _aus = "Lula e Flávio", IF ( _sitEf = "realizado", "Nem Lula nem Flávio foram ao debate. ", "Nem Lula nem Flávio vão ao debate. " ),
			        _aus & IF ( _sitEf = "realizado", " não foi ao debate. ", " não vai ao debate. " )
			    )
			VAR _man =
			    SWITCH (
			        TRUE (),
			        _sit = "cancelado", "Não houve debate: a Globo cancelou.",
			        _sit = "adiado", "O debate foi adiado.",
			        _aus = "Lula e Flávio", _frAus,
			        _sitEf = "marcado",
			            IF (
			                _aus = "",
			                "Ainda não dá para dizer. Os números chegam entre a noite de sexta e o sábado, véspera da eleição.",
			                _frAus & "Os números da noite chegam entre sexta e sábado, véspera da eleição."
			            ),
			        _sitEf = "no_ar", _frAus & "O debate está no ar; os primeiros números chegam quando ele acabar.",
			        _pN > 0,
			            _frAus & "Nas " & IF ( _pN = 1, "pesquisa feita inteira", FORMAT ( _pN, "0" ) & " pesquisas feitas inteiras" )
			                & " depois do debate, Lula tem " & FORMAT ( _pL, "0.0" ) & "% e Flávio, " & FORMAT ( _pF, "0.0" ) & "%"
			                & IF ( _aN > 0, "; antes, " & FORMAT ( _aL, "0.0" ) & "% e " & FORMAT ( _aF, "0.0" ) & "%", "" ) & ".",
			        NOT ISBLANK ( _aud ),
			            _frAus & "Na Grande SP, a Globo marcou " & FORMAT ( _aud, "0.0" ) & " pontos"
			                & IF ( ISBLANK ( _audC ), " na prévia", "" ) & ", " & _cmp & " os " & IF ( _ref = INT ( _ref ), FORMAT ( _ref, "0" ), FORMAT ( _ref, "0.0" ) )
			                & IF ( ISBLANK ( _audC ), " da prévia da Band.", " da Band." ),
			        _frAus & "O debate acabou, e os números ainda não chegaram."
			    )
			VAR _sub =
			    IF (
			        _sit IN { "cancelado", "adiado" },
			        IF ( LEN ( _motivo ) > 0, _motivo & " · ", "" ) & "situação em " & _atu,
			        "Números da noite: " & FORMAT ( _n, "0" ) & " de " & FORMAT ( _tot, "0" )
			            & IF ( _nd > 0, " · " & FORMAT ( _nd, "0" ) & IF ( _nd = 1, " não divulgado", " não divulgados" ), "" )
			            & " · situação em " & _atu
			    )
			-- 4 · Marcação (as regras em blocos e a checagem saíram da tela em 23/10/2026, pedido do dono: "achei um pouco
			-- poluída… essa questão dos blocos não precisa"; seguem em dados/pbi/debate_globo.csv)
			RETURN
			    IF (
			        [T26 · arquivo · linhas] = 0,
			        "<div class='tela t26f'><div class='selo entra'><span>SEM DADOS</span></div>"
			            & "<div class='dia rot entra d1'>O ÚLTIMO DEBATE ANTES DO 2º TURNO</div>"
			            & "<div class='man sobe d2' style='top:72px'>O arquivo do debate ainda não chegou ao painel. A ficha, os púlpitos "
			            & "e os números da noite aparecem quando ele for lido.</div></div>",
			    "<div class='tela t26f s-" & _sit & "'>"
			        & "<div class='selo entra'><span>" & _selo & "</span></div>"
			        & "<div class='dia rot entra d1'>" & _dia & "O ÚLTIMO DEBATE ANTES DO 2º TURNO</div>"
			        & "<div class='hora sobe d2'><span class='num" & IF ( _sit IN { "cancelado", "adiado" }, " riscado", "" ) & "'>" & _hora & "</span></div>"
			        & "<div class='onde sobe d3'><div class='txt'><b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _trans, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</b></div>"
			            & "<div class='txt'>mediação de " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _med, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _local, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div>"
			        & "<div class='man sobe d4'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _man, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='situ nota entra d2'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _sub, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			    & "</div>"
			    )
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 462b0d5d-2643-53c9-b059-d7211bf29b32

	/// Texto puro da fita da noite.
	measure 'T26 · Noite · ALT' =
			"Fita do tempo da noite do debate até a eleição, domingo, 25/10: " & FORMAT ( [T26 · cartões · total], "0" )
			    & " números esperados; " & FORMAT ( [T26 · cartões · chegaram], "0" )
			    & IF ( [T26 · cartões · chegaram] = 1, " já chegou.", " já chegaram." )
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 91d3d652-43b8-568d-b868-32f97b856cdd

	/// Fundo da faixa da noite: título, a fita do tempo do início do debate à eleição de domingo.
	measure 'T26 · Noite · HTML' =
			-- 1 · Leituras (contas de T26 Debate na Globo\Contas)
			VAR _sit = [T26 · debate · situação]
			VAR _ini = [T26 · debate · início]
			VAR _tot = [T26 · cartões · total]
			-- 2 · Textos
			VAR _txt =
			    SWITCH (
			        TRUE (),
			        [T26 · arquivo · linhas] = 0, "Os números da noite aparecem aqui quando o arquivo do debate for lido.",
			        _sit IN { "cancelado", "adiado" },
			        "Sem debate, sem números da noite: os espaços ficam marcados como estavam.",
			        FORMAT ( _tot, "0" ) & IF ( _tot = 1, " número conta", " números contam" )
			            & " como foi o debate. Cada um chega numa hora; até lá, o lugar dele fica marcado, com a fonte esperada."
			    )
			VAR _iniTxt = IF ( ISBLANK ( _ini ), "", UPPER ( FORMAT ( _ini, "ddd dd/MM" ) ) & " · " & FORMAT ( _ini, "HH" ) & "H" & FORMAT ( _ini, "nn" ) & " · COMEÇA O DEBATE" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t26n'>"
			        & "<div class='cab'><div class='sob sobe'>A NOITE EM NÚMEROS · E A RÉGUA DA BAND, 18/10</div>"
			        & IF ( [T26 · arquivo · linhas] = 0 || _sit IN { "cancelado", "adiado" }, "<div class='txt sobe d1'>" & _txt & "</div>", "" ) & "</div>"
			        & "<div class='ini rot entra d3'>" & _iniTxt & "</div>"
			        & "<div class='fimr rot entra d6'>DOM 25/10 · A ELEIÇÃO</div>"
			        & "<svg class='fita' width='1620' height='24' viewBox='0 0 1620 24'><path class='traco' pathLength='1' "
			        & "d='M8 12 C 300 10, 700 14, 1000 11 S 1450 13, 1560 12'/>"
			        & "<circle class='brota' cx='8' cy='12' r='6'/></svg>"
			        & "<div class='urna entra d8'></div>"
			    & "</div>"
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 58c93bc5-39ca-52d5-939d-e491923593e4

	/// Texto puro do palco.
	measure 'T26 · Palco · ALT' =
			"No palco, os púlpitos: Lula " & SWITCH ( [T26 · presença · Lula], "confirmada", "com presença confirmada", "ausente", "ausente", "com presença a confirmar" )
			    & "; Flávio " & SWITCH ( [T26 · presença · Flávio], "confirmada", "com presença confirmada", "ausente", "ausente", "com presença a confirmar" )
			    & ". Passe o mouse em cada um para o histórico e a fonte."
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 6246875d-43f7-5904-abf2-6ca2dbd74cf8

	/// Um púlpito por candidato (grão 'T26 Debate Globo'[Chave]; só as linhas de presença): o nome na cor dele, o púlpito em traço (vazio e tracejado se faltar ou se o debate cair) e a situação. Alvo do dossiê ttT26Presenca.
	measure 'T26 · Palco · HTML' =
			-- 1 · Leituras (contas de T26 Debate na Globo\Contas)
			VAR _grupo = [T26 · linha · grupo]
			VAR _cand = [T26 · linha · candidato]
			VAR _rot = [T26 · linha · rótulo]
			VAR _pres = [T26 · presença · situação]
			VAR _sit = [T26 · debate · situação]
			-- 2 · Textos
			VAR _l = _cand = "Lula"
			VAR _p = SEARCH ( " · ", _rot, 1, 0 )
			VAR _nome = IF ( _p > 0, LEFT ( _rot, _p - 1 ), _rot )
			VAR _resto = IF ( _p > 0, MID ( _rot, _p + 3, 40 ), "" )
			VAR _fora = _sit IN { "cancelado", "adiado" }
			VAR _cls =
			    SWITCH ( TRUE (), _fora || _pres = "ausente", "vazio", _pres = "a_confirmar", "duvida", "ok" )
			VAR _status =
			    SWITCH (
			        TRUE (),
			        _sit = "cancelado", "debate cancelado",
			        _sit = "adiado", "debate adiado",
			        _pres = "ausente", IF ( _sit = "realizado", "não foi ao debate", "não vai ao debate" ),
			        _pres = "a_confirmar", "presença a confirmar",
			        _sit = "realizado", "esteve no debate",
			        "presença confirmada"
			    )
			VAR _icone =
			    SWITCH (
			        _cls,
			        "ok", "<i class='ok'></i>",
			        "duvida", "<i class='qq'>?</i>",
			        "<svg class='xx' width='18' height='18' viewBox='0 0 18 18'><path d='M3.5 3 L15 15.5 M15 3.5 L3 15'/></svg>"
			    )
			-- 3 · Geometria
			VAR _x = IF ( _l, 20, 430 ) -- geometria
			VAR _atraso = IF ( _l, 200, 450 ) -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _grupo = "presenca",
			        "<div class='tela t26p'>"
			            & "<div class='pu " & _cls & IF ( _l, " l", " f" ) & "' style='left:" & _x & "px'>"
			                & "<div class='nm sobe' style='animation-delay:" & _atraso & "ms'><span class='" & IF ( _l, "lula-esc", "flavio-esc" ) & "'>"
			                    & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span><small class='rot'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _resto, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</small></div>"
			                & "<svg class='pul' width='150' height='150' viewBox='0 0 150 150'>" & "<g filter='url(#rbu)'><path class='tampo' pathLength='1' d='M18 44 L132 44 L124 62 L26 62 Z'/><path class='corpo' pathLength='1' d='M34 62 L116 62 L110 134 L40 134 Z'/><path class='base' pathLength='1' d='M26 134 L124 134 L124 144 L26 144 Z'/><path class='filete' pathLength='1' d='M50 82 L100 82 M52 92 L98 92'/><path class='mic' pathLength='1' d='M75 44 L75 24 C 75 16, 82 12, 90 12'/></g>" & "</svg>"
			                & "<div class='st sobe' style='animation-delay:" & _atraso + 500 & "ms'>" & _icone & "<span>" & _status & "</span></div>"
			            & "</div>"
			        & "</div>"
			    )
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 5d494b1b-d559-5ebf-8ffe-316edcc3e116

	/// Texto puro do dossiê do cartão.
	measure 'T26 · Tooltip cartão · ALT' =
			VAR _rot = [T26 · linha · rótulo]
			RETURN
			    "Dossiê do cartão " & _rot & ": o que mede, quando e de onde o número chega, e a mesma medida no debate da Band."
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 8a0fb502-b4aa-5a5e-bf33-855a12a5d60e

	/// Dossiê do cartão: o que mede, a ressalva, quando e de onde chega cada número e a mesma medida no debate da Band (nas pesquisas, a lista do antes e do depois).
	measure 'T26 · Tooltip cartão · HTML' =
			-- 1 · Leituras (contas de T26 Debate na Globo\Contas)
			VAR _c = SELECTEDVALUE ( 'T26 Debate Globo'[Cartão] )
			VAR _est = [T26 · cartão · estado]
			VAR _rot = [T26 · linha · rótulo]
			VAR _med = [T26 · linha · medida]
			VAR _obs = [T26 · linha · observação]
			VAR _band = [T26 · Band · data]
			VAR _bandC = [T26 · Band · audiência]
			VAR _bandP = [T26 · Band · audiência prévia]
			VAR _bandFonte = [T26 · Band · audiência · fonte]
			VAR _bandS = [T26 · Band · pico streaming]
			VAR _bandBL = [T26 · Band · buscas · Lula]
			VAR _bandBF = [T26 · Band · buscas · Flávio]
			VAR _bandRL = [T26 · Band · redes · Lula]
			VAR _bandRF = [T26 · Band · redes · Flávio]
			VAR _aN = [T26 · pesquisas · antes · n]
			VAR _pN = [T26 · pesquisas · depois · n]
			VAR _xN = [T26 · pesquisas · atravessam · n]
			-- as linhas do cartão: o que se espera de cada uma (a audiência tem duas: prévia e consolidado)
			VAR _linhas =
			    CONCATENATEX (
			        FILTER ( VALUES ( 'T26 Debate Globo'[Chave] ), [T26 · linha · grupo] = "metrica" && [T26 · linha · candidato] <> "Flávio" ),
			        VAR _v = [T26 · linha · valor]
			        VAR _ch = [T26 · linha · chave]
			        VAR _nome = SWITCH ( _ch, "audiencia_previa", "Prévia", "audiencia_consolidado", "Consolidado", "" )
			        RETURN
			            "<div class='li'>" & IF ( _nome <> "", "<b>" & _nome & "</b> · ", "" )
			                & SWITCH (
			                    TRUE (),
			                    _ch = "pesquisas_depois" && _pN > 0,
			                        "chegaram " & FORMAT ( _pN, "0" ) & IF ( _pN = 1, " pesquisa", " pesquisas" ) & " com o campo inteiro depois do debate.",
			                    _ch = "pesquisas_depois",
			                        "esperadas " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T26 · linha · esperado], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ", de " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T26 · linha · fonte esperada], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ".",
			                    ISBLANK ( _v ),
			                        "esperado " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T26 · linha · esperado], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ", de " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T26 · linha · fonte esperada], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ".",
			                    "chegou: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T26 · linha · fonte], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			                        & IF ( LEN ( [T26 · linha · atualizado] ) > 0, " (" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T26 · linha · atualizado], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ")", "" ) & "."
			                ) & "</div>",
			        "",
			        [T26 · linha · ordem], ASC
			    )
			VAR _lista =
			    CONCATENATEX (
			        FILTER ( ALL ( Pesquisa[Id] ), [T26 · pesquisa · janela] IN { "antes", "depois" } ),
			        "<div class='ps" & IF ( [T26 · pesquisa · janela] = "depois", " dep", "" ) & "'><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T26 · pesquisa · instituto], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · "
			            & FORMAT ( [T26 · pesquisa · campo início], "dd" ) & "–" & FORMAT ( [T26 · pesquisa · campo fim], "dd/MM" )
			            & IF ( [T26 · pesquisa · janela] = "depois", " · depois", "" ) & "</span><b class='lula-esc'>" & FORMAT ( [T26 · pesquisa · Lula], "0.0" )
			            & "</b><b class='flavio-esc'>" & FORMAT ( [T26 · pesquisa · Flávio], "0.0" ) & "</b></div>",
			        "",
			        [T26 · pesquisa · campo fim], ASC
			    )
			-- 2 · Textos
			VAR _bandTxt =
			    SWITCH (
			        _c,
			        "buscas", "Na noite de " & FORMAT ( _band, "dd/MM" ) & ", das 20h à meia-noite, o pico foi " & FORMAT ( _bandBL, "0" ) & " para Lula e "
			            & FORMAT ( _bandBF, "0" ) & " para Flávio (Google Trends, tópicos, hora a hora). É a mesma consulta que mede a noite da Globo, então as duas noites se comparam: 100 é a hora mais buscada da semana.",
			        "audiencia", "Consolidado: " & IF ( _bandC = INT ( _bandC ), FORMAT ( _bandC, "0" ), FORMAT ( _bandC, "0.0" ) ) & " pontos; prévia: " & IF ( _bandP = INT ( _bandP ), FORMAT ( _bandP, "0" ), FORMAT ( _bandP, "0.0" ) ) & ". Fonte: " & _bandFonte & ".",
			        "streaming", FORMAT ( _bandS, "#,0" ) & " aparelhos ao mesmo tempo, só no canal da Band no YouTube (Poder360).",
			        "redes", "Lula " & FORMAT ( _bandRL, "#,0" ) & " e Flávio " & FORMAT ( _bandRF, "#,0" ) & " interações nas 24 horas depois do debate (Bites, via Poder360).",
			        ""
			    )
			VAR _rotRef = IF ( _c = "pesquisas", "AS PESQUISAS · LULA × FLÁVIO, VOTOS TOTAIS (%)", "NA BAND, " & FORMAT ( _band, "dd/MM" ) & " · A MESMA MEDIDA" )
			VAR _mao =
			    SWITCH (
			        _est,
			        "publicado", "chegou",
			        "consolidado", "chegou o consolidado",
			        "previa", "falta o consolidado",
			        "parcial", "falta um dos dois",
			        "nao_divulgado", IF ( _c = "pesquisas", "nenhuma com o campo todo depois", "não saiu" ),
			        "cancelado", "sem debate",
			        "adiado", "debate adiado",
			        "ainda não chegou"
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _est ),
			        "<div class='sob sobe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _rot ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			            & "<div class='tt sobe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _med, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			            & IF ( LEN ( _obs ) > 0, "<div class='txt sobe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _obs, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ".</div>", "" )
			            & "<hr/><div class='rot sobe'>QUANDO E DE ONDE</div><div class='txt lis sobe'>" & _linhas & "</div>"
			            & "<hr/><div class='rot sobe'>" & _rotRef & "</div>"
			            & IF (
			                _c = "pesquisas",
			                "<div class='lst sobe'>" & _lista & "</div><div class='nota sobe'>Antes: " & FORMAT ( _aN, "0" ) & " com o campo inteiro entre os dois debates"
			                    & IF ( _xN > 0, "; " & FORMAT ( _xN, "0" ) & " atravessa" & IF ( _xN = 1, "", "m" ) & " o dia do debate e fica" & IF ( _xN = 1, "", "m" ) & " fora", "" )
			                    & ". Cada instituto mede do seu jeito: compare cada um com ele mesmo.</div>",
			                "<div class='txt sobe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _bandTxt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			            )
			            & "<div class='mao ti'>" & _mao & "</div>"
			    )
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: aab0f4a3-0944-5505-a518-cc05768792d1

	/// Texto puro do dossiê da presença.
	measure 'T26 · Tooltip presença · ALT' =
			"Dossiê da presença de " & [T26 · linha · rótulo] & ": a situação, o histórico com a fonte e os debates do 2º turno antes deste."
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: 9997860e-d6ec-5970-9f1a-2c96b0cc5e26

	/// Dossiê da presença: a situação, o histórico com fonte e os debates do 2º turno antes deste, com o que houve para o candidato.
	measure 'T26 · Tooltip presença · HTML' =
			-- 1 · Leituras (contas de T26 Debate na Globo\Contas)
			VAR _grupo = [T26 · linha · grupo]
			VAR _rot = [T26 · linha · rótulo]
			VAR _txt = [T26 · linha · texto]
			VAR _fonte = [T26 · linha · fonte]
			VAR _atu = [T26 · linha · atualizado]
			VAR _pres = [T26 · presença · situação]
			VAR _sit = [T26 · debate · situação]
			VAR _hist = [T26 · 2º turno · debates]
			VAR _real = [T26 · 2º turno · realizados]
			VAR _cand = [T26 · linha · candidato]
			-- 2 · Textos
			VAR _tit =
			    SWITCH (
			        TRUE (),
			        _sit = "cancelado", "O debate foi cancelado",
			        _pres = "ausente", IF ( _sit = "realizado", "Não foi ao debate", "Não vai ao debate" ),
			        _pres = "a_confirmar", "Presença a confirmar",
			        _sit = "realizado", "Esteve no debate",
			        "Presença confirmada"
			    )
			VAR _linhas = "<div class='li'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _hist, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ), "|", "</div><div class='li'>" ) & "</div>"
			VAR _mao = IF ( _real = 1, "antes, só um debate", FORMAT ( _real, "0" ) & " debates antes" )
			-- 4 · Marcação
			RETURN
			    IF (
			        _grupo = "presenca",
			        "<div class='sob sobe" & IF ( _cand = "Lula", " lula-esc", " flavio-esc" ) & "'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( UPPER ( _rot ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			            & "<div class='tt sobe'>" & _tit & "</div>"
			            & "<div class='txt sobe'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			            & "<div class='nota sobe'>Fontes: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fonte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · atualizado em " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _atu, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			            & "<hr/><div class='rot sobe'>DEBATES DO 2º TURNO, ANTES DESTE</div><div class='txt lis sobe'>" & _linhas & "</div>"
			            & "<div class='mao ti'>" & _mao & "</div>"
			    )
		displayFolder: T26 Debate na Globo\Desenho
		lineageTag: cb98ef40-2911-5ab4-982b-2f2663557abc

	column Value
		dataType: int64
		isHidden
		lineageTag: e56fa3e3-60b6-5d13-88eb-4f56ab0af0e2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Medidas = calculated
		mode: import
		source = {BLANK()}

