	/// Quantas pesquisas do instituto clicado tiveram campo no dia do debate (fora da comparação antes × depois), entre as que terminaram antes do debate seguinte (Globo, 23/10).
	measure 'T07 · escolha · atravessa' =
			VAR _inst = [T07 · escolha · instituto]
			VAR _d = [T07 · debate · data]
			VAR _g = [T07 · debate seguinte · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _inst ),
			        CALCULATE (
			            COUNTROWS ( Pesquisa ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            Pesquisa[Momento] = "apos_1turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Instituto] = _inst,
			            Pesquisa[Campo fim] >= _d,
			            Pesquisa[Campo início] <= _d,
			            Pesquisa[Campo fim] < _g || ISBLANK ( _g )
			        ) + 0
			    )
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: f3c2e153-a3d5-5e8e-9925-bfb46ee7338e

	/// Último dia de campo da primeira pesquisa do instituto clicado que começou depois do debate (janela 'depois', até a véspera do debate seguinte); vazio se ele não voltou a campo.
	measure 'T07 · escolha · depois · data' =
			VAR _inst = [T07 · escolha · instituto]
			VAR _d = [T07 · debate · data]
			VAR _g = [T07 · debate seguinte · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _inst ),
			        CALCULATE (
			            MIN ( Pesquisa[Campo fim] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            Pesquisa[Momento] = "apos_1turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Instituto] = _inst,
			            Pesquisa[Campo início] > _d,
			            Pesquisa[Campo fim] < _g || ISBLANK ( _g )
			        )
			    )
		formatString: dd/MM
		displayFolder: T07 Debate\Contas
		lineageTag: 421ce146-1d69-53ab-99b5-32c1d777c5eb

	/// Flávio − Lula, em pontos, na primeira pesquisa do instituto clicado depois do debate (média, se houver duas no mesmo dia).
	measure 'T07 · escolha · depois · diferença' =
			VAR _inst = [T07 · escolha · instituto]
			VAR _dt = [T07 · escolha · depois · data]
			VAR _d = [T07 · debate · data]
			VAR _g = [T07 · debate seguinte · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _dt ),
			        CALCULATE (
			            AVERAGEX ( Pesquisa, Pesquisa[Flavio] - Pesquisa[Lula] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            Pesquisa[Momento] = "apos_1turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Instituto] = _inst,
			            Pesquisa[Campo início] > _d,
			            Pesquisa[Campo fim] = _dt,
			            Pesquisa[Campo fim] < _g || ISBLANK ( _g )
			        )
			    )
		formatString: 0.0
		displayFolder: T07 Debate\Contas
		lineageTag: 5e94acfd-71cb-5bf2-b1b5-4e80fbed2f5a

	/// O instituto da pesquisa clicada no gráfico; vazio sem clique.
	measure 'T07 · escolha · instituto' =
			IF ( NOT ISBLANK ( [T07 · escolha · pesquisa] ), [T07 · pesquisa · instituto] )
		displayFolder: T07 Debate\Contas
		lineageTag: fcd639d0-8301-5048-9c37-92736e34b61b

	/// A pesquisa clicada no gráfico (filtro cruzado de T07_Pesquisas_Pontos, grão Pesquisa[Id]); vazia sem clique, dentro da própria camada de pontos (o Id está no grão) e fora das pesquisas do 2º turno depois do 1º turno.
	measure 'T07 · escolha · pesquisa' =
			VAR _id = SELECTEDVALUE ( Pesquisa[Id] )
			RETURN
			    IF (
			        ISFILTERED ( Pesquisa[Id] ) && NOT ISINSCOPE ( Pesquisa[Id] ) && NOT ISBLANK ( _id ),
			        IF ( NOT ISBLANK ( [T07 · pesquisa · janela] ), _id )
			    )
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: 34960be5-ebe1-5f20-adfc-5b5137e14d3d

	/// Quantas pesquisas do 2º turno (votos totais, depois do 1º turno) o instituto clicado fez, em qualquer janela do gráfico (campo terminado antes do debate seguinte, Globo, 23/10).
	measure 'T07 · escolha · pesquisas' =
			VAR _inst = [T07 · escolha · instituto]
			VAR _g = [T07 · debate seguinte · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _inst ),
			        CALCULATE (
			            COUNTROWS ( Pesquisa ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            Pesquisa[Momento] = "apos_1turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Instituto] = _inst,
			            Pesquisa[Campo fim] < _g || ISBLANK ( _g )
			        ) + 0
			    )
		formatString: 0
		displayFolder: T07 Debate\Contas
		lineageTag: e150af50-2784-5c70-86f6-a1382bda9da9

	/// Margem de erro máxima (pontos) entre as pesquisas do 2º turno feitas depois do 1º turno (votos totais).
	measure 'T07 · margem de erro máxima' =
