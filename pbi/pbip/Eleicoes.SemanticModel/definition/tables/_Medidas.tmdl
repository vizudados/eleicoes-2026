	/// Eleição que a ficha e as parecidas contam: a barra clicada na série (filtro cruzado no Ano) ou, sem clique, 2026.
	measure 'T15 · ano escolhido' =
			IF ( ISFILTERED ( 'Ano'[Ano] ) && HASONEVALUE ( 'Ano'[Ano] ), VALUES ( 'Ano'[Ano] ), 2026 )
