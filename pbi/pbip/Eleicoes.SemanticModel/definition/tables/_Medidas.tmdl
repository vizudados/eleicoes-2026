	/// Texto para leitor de tela do quadro de apoios.
	measure 'T16 · Apoios · ALT' =
			"Apoios no 2º turno: Cury (com condições), Caiado e Zema com Flávio; Renan liberou o eleitor; PSTU, PCB e UP com Lula; PCO pede voto nulo. Governadores eleitos no 1º turno: "
			    & [T16 · governadores · com Flávio] & " com Flávio, " & [T16 · governadores · com Lula] & " com Lula e "
			    & [T16 · governadores · neutros] & " neutros."
		displayFolder: T16 Os outros\Desenho
		lineageTag: e25cb64c-1e51-5507-9b7e-47c7a81a4270

	/// Moldura do quadro 'quem apoia quem': título, o rótulo das etiquetas dos candidatos menores e os governadores eleitos no 1º turno (quadradinhos que brotam e contadores). As linhas e etiquetas de cada pessoa são o T16 · Itens · HTML.
	measure 'T16 · Apoios · HTML' =
			-- 1 · Leituras
			VAR _gF = [T16 · governadores · com Flávio]
			VAR _gL = [T16 · governadores · com Lula]
			VAR _gN = [T16 · governadores · neutros]
			-- 2 · Textos
			VAR _tot = _gF + _gL + _gN
			-- 3 · Geometria (um quadradinho por governador: Flávio, depois Lula, depois neutros)
			VAR _quad =
			    CONCATENATEX (
			        GENERATESERIES ( 1, _tot, 1 ),
			        "<i class='" & SWITCH ( TRUE (), [Value] <= _gF, "f", [Value] <= _gF + _gL, "l", "n" ) & "' style='animation-delay:"
			            & ( 900 + [Value] * 45 ) & "ms'></i>",
			        "",
			        [Value], ASC
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t16a'>"
			        & "<div class='sob sobe'>Quem apoia quem no 2º turno</div>"
			        & "<div class='naneq rot entra d6'>Os candidatos menores · * apoio com condições</div>"
			        & "<div class='gov'>"
			            & "<div class='rot sobe d8'>Governadores eleitos no 1º turno</div>"
			            & "<div class='waf' style='grid-template-columns:repeat(" & _tot & ",20px)'>" & _quad & "</div>"
			            & "<div class='cont sobe d10'>"
			                & "<div><span class='num flavio'>" & _gF & "</span>com Flávio</div>"
			                & "<div><span class='num lula'>" & _gL & "</span>com Lula</div>"
			                & "<div><span class='num'>" & _gN & "</span>" & IF ( _gN = 1, "neutro", "neutros" ) & "</div>"
			            & "</div>"
			            & "<div class='nota entra d12'>Levantamento do jornal O Povo, 16/10</div>"
			        & "</div>"
			    & "</div>"
		displayFolder: T16 Os outros\Desenho
		lineageTag: cd91de29-641d-51d5-81a5-ff1d9a7d0a9b

	/// Texto para leitor de tela do diagrama de fluxo (≤ 250 caracteres).
	measure 'T16 · Fluxo · ALT' =
			VAR _t = "Para onde vão, no 2º turno: eleitor de Cury, Lula " & FORMAT ( CALCULATE ( [T16 · transferência · Lula], 'Transferência'[Segmento] = "Cury" ), "0" )
			    & "% e Flávio " & FORMAT ( CALCULATE ( [T16 · transferência · Flávio], 'Transferência'[Segmento] = "Cury" ), "0" )
			    & "%; de Renan, " & FORMAT ( CALCULATE ( [T16 · transferência · Lula], 'Transferência'[Segmento] = "Renan" ), "0" ) & "% e "
			    & FORMAT ( CALCULATE ( [T16 · transferência · Flávio], 'Transferência'[Segmento] = "Renan" ), "0" )
			    & "%; de Caiado, " & FORMAT ( CALCULATE ( [T16 · transferência · Lula], 'Transferência'[Segmento] = "Caiado" ), "0" ) & "% e "
			    & FORMAT ( CALCULATE ( [T16 · transferência · Flávio], 'Transferência'[Segmento] = "Caiado" ), "0" )
			    & "%; quem não votou, " & FORMAT ( CALCULATE ( [T16 · transferência · Lula], 'Transferência'[Segmento] = "nao_votou" ), "0" ) & "% e "
			    & FORMAT ( CALCULATE ( [T16 · transferência · Flávio], 'Transferência'[Segmento] = "nao_votou" ), "0" ) & "%. Amostras pequenas."
			RETURN
			    LEFT ( _t, 250 )
		displayFolder: T16 Os outros\Desenho
		lineageTag: 723a6197-3ff4-5675-9061-4a2c737661a4

	/// A manchete (montada com 'T16 · transferência · tendência' de cada grupo), a ressalva das amostras pequenas e o diagrama de fluxo: à esquerda os grupos (Cury, Renan, Caiado, quem não votou, com o tamanho de cada um no 1º turno), à direita Lula, Flávio e branco/nulo; cada faixa tem a espessura da parte do grupo (1,2 px por ponto percentual) e corre da esquerda para a direita. Com um grupo em destaque (clique num grupo ou num candidato da lista dos apoios), as faixas dos outros esmaecem e a manchete passa a ser a do grupo, com o apoio do candidato. Só lê contas 'T16 · …'.
	measure 'T16 · Fluxo · HTML' =
			-- 1 · Leituras
			VAR _grupos =
			    DATATABLE (
			        "Ordem", INTEGER, "Seg", STRING, "Nome", STRING, "Cand", STRING,
			        {
			            { 1, "Cury", "Augusto Cury", "Augusto Cury" },
			            { 2, "Renan", "Renan Santos", "Renan Santos" },
			            { 3, "Caiado", "Ronaldo Caiado", "Ronaldo Caiado" },
			            { 4, "nao_votou", "Quem não votou", "" }
			        }
			    )
			VAR _lido =
			    ADDCOLUMNS (
			        _grupos,
			        "@l", VAR _s = [Seg] RETURN CALCULATE ( [T16 · transferência · Lula], 'Transferência'[Segmento] = _s ),
			        "@f", VAR _s = [Seg] RETURN CALCULATE ( [T16 · transferência · Flávio], 'Transferência'[Segmento] = _s ),
			        "@b", VAR _s = [Seg] RETURN CALCULATE ( [T16 · transferência · branco ou nulo], 'Transferência'[Segmento] = _s ),
			        "@n", VAR _s = [Seg] RETURN CALCULATE ( [T16 · transferência · institutos], 'Transferência'[Segmento] = _s ),
			        "@t", VAR _s = [Seg] RETURN CALCULATE ( [T16 · transferência · tendência], 'Transferência'[Segmento] = _s ),
			        "@votos",
			            VAR _c = [Cand]
			            RETURN
			                IF ( _c = "", [T16 · 1º turno · abstenções], CALCULATE ( [T16 · 1º turno · votos do candidato], 'Candidato ano'[Candidato] = _c ) ),
			        "@pct",
			            VAR _c = [Cand]
			            RETURN
			                IF ( _c = "", [T16 · 1º turno · % de abstenção], CALCULATE ( [T16 · 1º turno · % do candidato], 'Candidato ano'[Candidato] = _c ) )
			    )
			VAR _mMin = [T16 · margem nos grupos · mínima]
			VAR _foco = [T16 · foco · grupo]
			VAR _focoApoio = [T16 · foco · apoio]
			VAR _focoData = [T16 · foco · apoio · data]
			VAR _focoCond = [T16 · foco · apoio · condicionado]
			VAR _mMax = [T16 · margem nos grupos · máxima]
			-- 2 · Textos
			VAR _cand = FILTER ( _lido, [Cand] <> "" ) /* lista */
			VAR _nF = COUNTROWS ( FILTER ( _cand, [@t] = "Flávio" ) ) + 0 /* lista */
			VAR _nL = COUNTROWS ( FILTER ( _cand, [@t] = "Lula" ) ) + 0 /* lista */
			VAR _nD = COUNTROWS ( FILTER ( _cand, [@t] = "divide" ) ) + 0 /* lista */
			VAR _listaF = CONCATENATEX ( FILTER ( _cand, [@t] = "Flávio" ), [Seg], " e o de ", [@f] - [@l], DESC ) /* lista */
			VAR _listaL = CONCATENATEX ( FILTER ( _cand, [@t] = "Lula" ), [Seg], " e o de ", [@l] - [@f], DESC ) /* lista */
			VAR _listaD = CONCATENATEX ( FILTER ( _cand, [@t] = "divide" ), [Seg], " e o de ", [Ordem], ASC ) /* lista */
			VAR _tNV = MAXX ( FILTER ( _lido, [Cand] = "" ), [@t] ) /* lista */
			VAR _c1 = IF ( _nF > 0, "o eleitor de " & _listaF & IF ( _nF > 1, " pendem", " pende" ) & " para Flávio" )
			VAR _c2 =
			    IF ( _nL > 0, IF ( _nF > 0, "o de ", "o eleitor de " ) & _listaL & IF ( _nL > 1, " pendem", " pende" ) & " para Lula" )
			VAR _c3 =
			    IF ( _nD > 0, IF ( _nF + _nL > 0, "o de ", "o eleitor de " ) & _listaD & IF ( _nD > 1, " se dividem", " se divide" ) )
			VAR _c4 = "quem não votou " & SWITCH ( _tNV, "Lula", "pende para Lula", "Flávio", "pende para Flávio", "se divide" )
			VAR _oracoes = { ( 1, _c1 ), ( 2, _c2 ), ( 3, _c3 ), ( 4, _c4 ) }
			VAR _frase =
			    CONCATENATEX (
			        FILTER ( _oracoes, NOT ISBLANK ( [Value2] ) && [Value2] <> "" ), /* lista */
			        [Value2], "; ", [Value1], ASC
			    )
			VAR _txtMan = UPPER ( LEFT ( _frase, 1 ) ) & MID ( _frase, 2, 400 ) & "."
			VAR _tFoco = MAXX ( FILTER ( _lido, [Seg] = _foco ), [@t] ) /* lista */
			VAR _txtTend = SWITCH ( _tFoco, "Lula", "pende para Lula", "Flávio", "pende para Flávio", "se divide" )
			VAR _txtApoio =
			    SWITCH (
			        _focoApoio,
			        "Lula", "; " & _foco & " declarou apoio a Lula",
			        "Flávio", "; " & _foco & " declarou apoio a Flávio",
			        "liberou", "; " & _foco & " liberou o eleitor",
			        "neutro", "; " & _foco & " ficou neutro",
			        ""
			    )
			        & IF ( _focoApoio IN { "Lula", "Flávio", "liberou", "neutro" } && NOT ISBLANK ( _focoData ), " em " & FORMAT ( _focoData, "dd/MM" ) )
			        & IF ( _focoCond = "Sim", ", com condições" )
			VAR _txtFoco =
			    IF ( _foco = "nao_votou", "Quem não votou no 1º turno " & _txtTend, "O eleitor de " & _foco & " " & _txtTend & _txtApoio ) & "."
			VAR _tit = IF ( ISBLANK ( _foco ), _txtMan, _txtFoco )
			VAR _nCandMin = MINX ( _cand, [@n] ) /* lista */
			VAR _nCandMax = MAXX ( _cand, [@n] ) /* lista */
			VAR _nNV = MAXX ( FILTER ( _lido, [Cand] = "" ), [@n] ) /* lista */
			VAR _txtN = IF ( _nCandMin = _nCandMax, FORMAT ( _nCandMax, "0" ), FORMAT ( _nCandMin, "0" ) & " a " & FORMAT ( _nCandMax, "0" ) )
			VAR _txtNota =
			    "Média da última pesquisa de cada instituto depois do 1º turno: " & _txtN & IF ( _nCandMax = 1, " instituto", " institutos" )
			        & " para os eleitores dos três candidatos, "
			        & _nNV & " para quem não votou. São grupos pequenos, com menos de 100 entrevistados por pesquisa e margem de erro de "
			        & _mMin & " a " & _mMax & " pontos: é sinal, não medida."
			-- 3 · Geometria (svg 1040 × 680 a partir de y 180; grupos centrados em 115 + 160 × (ordem − 1); 1,2 px por ponto)
			VAR _esc = 1.2
			VAR _v =
			    ADDCOLUMNS (
			        CROSSJOIN ( _lido, DATATABLE ( "D", INTEGER, { { 1 }, { 2 }, { 3 } } ) ),
			        "@v", SWITCH ( [D], 1, [@l], 2, [@f], [@b] ) + 0
			    )
			VAR _g =
			    ADDCOLUMNS (
			        _v,
			        "@esq", VAR _o = [Ordem] VAR _d = [D] RETURN SUMX ( FILTER ( _v, [Ordem] = _o && [D] < _d ), [@v] ) + 0, /* lista */
			        "@alt", VAR _o = [Ordem] RETURN SUMX ( FILTER ( _v, [Ordem] = _o ), [@v] ), /* lista */
			        "@dir", VAR _o = [Ordem] VAR _d = [D] RETURN SUMX ( FILTER ( _v, [D] = _d && [Ordem] < _o ), [@v] ) + 0, /* lista */
			        "@antes", VAR _d = [D] RETURN SUMX ( FILTER ( _v, [D] < _d ), [@v] ) + 0 /* lista */
			    )
			VAR _geo =
			    ADDCOLUMNS (
			        _g,
			        "@y0", 115 + ( [Ordem] - 1 ) * 160 - [@alt] * _esc / 2 + [@esq] * _esc, -- geometria
			        "@r0", 50 + [@antes] * _esc + ( [D] - 1 ) * 70 + [@dir] * _esc -- geometria
			    )
			VAR _fx = "0.0"
			VAR _faixas =
			    CONCATENATEX (
			        _geo,
			        VAR _y0 = FORMAT ( [@y0], _fx, "en-US" )
			        VAR _y1 = FORMAT ( [@y0] + [@v] * _esc, _fx, "en-US" )
			        VAR _r0 = FORMAT ( [@r0], _fx, "en-US" )
			        VAR _r1 = FORMAT ( [@r0] + [@v] * _esc, _fx, "en-US" )
			        RETURN
			            "<path class='fx " & SWITCH ( [D], 1, "l", 2, "f", "b" ) & IF ( NOT ISBLANK ( _foco ) && [Seg] <> _foco, " fora" )
			                & "' filter='url(#rbu)' style='animation-delay:"
			                & ( 500 + ( [Ordem] - 1 ) * 320 + [D] * 90 ) & "ms' d='M250 " & _y0 & " C520 " & _y0 & " 520 " & _r0
			                & " 790 " & _r0 & " L790 " & _r1 & " C520 " & _r1 & " 520 " & _y1 & " 250 " & _y1 & " Z'/>",
			        "",
			        [Ordem], ASC, [D], ASC
			    )
			VAR _valores =
			    CONCATENATEX (
			        _geo,
			        "<text x='262' y='" & FORMAT ( [@y0] + [@v] * _esc / 2 + 7, _fx, "en-US" ) & "' class='"
			            & SWITCH ( [D], 1, "vl", 2, "vf", "vb" ) & IF ( NOT ISBLANK ( _foco ) && [Seg] <> _foco, " fora" )
			            & " entra' style='animation-delay:" & ( 700 + ( [Ordem] - 1 ) * 320 ) & "ms'>"
			            & FORMAT ( [@v], "0" ) & "%</text>",
			        "",
			        [Ordem], ASC, [D], ASC
			    )
			VAR _nosEsq =
			    CONCATENATEX (
			        _lido,
			        VAR _alt = ( [@l] + [@f] + [@b] ) * _esc
			        RETURN
			            "<rect x='236' width='12' class='no entra" & IF ( NOT ISBLANK ( _foco ) && [Seg] <> _foco, " fora" )
			                & "' style='animation-delay:" & ( 300 + ( [Ordem] - 1 ) * 320 ) & "ms' y='"
			                & FORMAT ( 115 + ( [Ordem] - 1 ) * 160 - _alt / 2, _fx, "en-US" ) & "' height='" & FORMAT ( _alt, _fx, "en-US" ) & "'/>",
			        ""
			    )
			VAR _dest =
			    ADDCOLUMNS (
			        DATATABLE ( "D", INTEGER, "Rot", STRING, { { 1, "Lula" }, { 2, "Flávio" }, { 3, "Branco, nulo ou não vota" } } ),
			        "@tot", VAR _d = [D] RETURN SUMX ( FILTER ( _v, [D] = _d ), [@v] ), /* lista */
			        "@ant", VAR _d = [D] RETURN SUMX ( FILTER ( _v, [D] < _d ), [@v] ) + 0 /* lista */
			    )
			VAR _nosDir =
			    CONCATENATEX (
			        _dest,
			        "<rect x='790' width='12' class='no entra d12' y='" & FORMAT ( 50 + [@ant] * _esc + ( [D] - 1 ) * 70, _fx, "en-US" )
			            & "' height='" & FORMAT ( [@tot] * _esc, _fx, "en-US" ) & "'/>",
			        ""
			    )
			VAR _rotDir =
			    CONCATENATEX (
			        _dest,
			        VAR _cls = SWITCH ( [D], 1, "l", 2, "f", "b" )
			        RETURN
			            "<div class='ds " & _cls & " sobe d12' style='top:"
			                & FORMAT ( 180 + 50 + [@ant] * _esc + ( [D] - 1 ) * 70 + [@tot] * _esc / 2 - 38, _fx, "en-US" )
			                & "px'><div class='ft " & _cls & "'></div><b class='" & SWITCH ( [D], 1, "lula", 2, "flavio", "" ) & "'>" & [Rot]
			                & "</b></div>",
			        "",
			        [D], ASC
			    )
			VAR _rotEsq =
			    CONCATENATEX (
			        _lido,
			        "<div class='gr sobe" & IF ( NOT ISBLANK ( _foco ) && [Seg] <> _foco, " fora" ) & "' style='top:" & FORMAT ( 180 + 115 + ( [Ordem] - 1 ) * 160 - 34, _fx, "en-US" ) & "px;animation-delay:"
			            & ( 200 + ( [Ordem] - 1 ) * 320 ) & "ms'><b>" & [Nome] & "</b><span>"
			            & IF (
			                [Cand] = "",
			                FORMAT ( [@votos] / 1000000, "0.0" ) & " mi de eleitores<br>" & FORMAT ( [@pct], "0.0%" ) & " faltaram no 1º turno",
			                FORMAT ( [@votos] / 1000000, "0.00" ) & " mi de votos<br>" & FORMAT ( [@pct], "0.0%" ) & " dos válidos"
			            ) & "</span></div>",
			        "",
			        [Ordem], ASC
			    )
			-- nota à mão sob a faixa de branco e nulo do grupo com mais branco e nulo
			VAR _maisB = TOPN ( 1, _lido, [@b], DESC ) /* lista */
			VAR _ordB = MAXX ( _maisB, [Ordem] ) /* lista */
			VAR _segB = MAXX ( _maisB, [Seg] ) /* lista */
			VAR _yNota = 180 + 115 + ( _ordB - 1 ) * 160 + 40 -- geometria
			-- 4 · Marcação
			RETURN
			    "<div class='tela t16f'>"
			        & "<div class='cab'>"
			            & "<div class='sob sobe'>Depois do 1º turno · em quem dizem que votam no 2º turno</div>"
			            & "<div class='tit sobe d2'>" & _tit & "</div>"
			            & "<div class='txt sobe d3'>" & _txtNota & "</div>"
			        & "</div>"
			        & "<svg width='1040' height='680' viewBox='0 0 1040 680'>"
			            & "<text x='0' y='14' class='colrot'>O ELEITOR DE…</text>"
			            & "<text x='818' y='14' class='colrot'>…DIZ QUE VOTA EM</text>"
			            & _faixas & _nosEsq & _nosDir & _valores
			        & "</svg>"
			        & _rotEsq & _rotDir
			        & "<div class='mao entra d16" & IF ( NOT ISBLANK ( _foco ) && _segB <> _foco, " fora" ) & "' style='left:0px;top:" & FORMAT ( _yNota, _fx, "en-US" ) & "px'>muito branco e nulo</div>"
			    & "</div>"
		displayFolder: T16 Os outros\Desenho
		lineageTag: 8ba21370-76b9-54c0-9751-d567573ba49a

	/// Texto para leitor de tela dos alvos dos grupos.
	measure 'T16 · Grupos · ALT' =
			"Passe o mouse em cada grupo de eleitores (Cury, Renan, Caiado, quem não votou) para ver a última pesquisa de cada instituto."
		displayFolder: T16 Os outros\Desenho
		lineageTag: d1b56aeb-760c-5a9e-8fe2-fc56ee742523

	/// Alvo do mouse sobre cada grupo de eleitores do diagrama (grão Transferência[Segmento]; só Cury, Renan, Caiado e nao_votou): abre o dossiê ttT16Segmento. Mesma geometria do T16 · Fluxo · HTML.
	measure 'T16 · Grupos · HTML' =
			-- 1 · Leituras
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _n = [T16 · transferência · institutos]
			-- 2 · Textos
			VAR _ordem = SWITCH ( _seg, "Cury", 1, "Renan", 2, "Caiado", 3, "nao_votou", 4 )
			-- 3 · Geometria (centro do grupo em 180 + 115 + 160 × (ordem − 1))
			VAR _top = 180 + 115 + ( _ordem - 1 ) * 160 - 72 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _ordem ) && _n > 0,
			        "<div class='tela t16g'><div class='alvo' style='top:" & FORMAT ( _top, "0.0", "en-US" ) & "px;height:144px'></div></div>"
			    )
		displayFolder: T16 Os outros\Desenho
		lineageTag: e21b6486-b6a9-55fe-92d5-55404006f233

	/// Texto para leitor de tela das linhas e etiquetas de apoio.
	measure 'T16 · Itens · ALT' =
			"Uma linha por candidato derrotado com a posição dele no 2º turno; passe o mouse para ver a frase e a data do anúncio."
		displayFolder: T16 Os outros\Desenho
		lineageTag: 1a1292aa-8374-5221-a683-56ba0184a535

	/// Uma linha (os quatro mais votados depois de Lula e Flávio) ou etiqueta (os menores) por pessoa (grão Apoio[Quem]): o partido e a posição mais recente no 2º turno, com a data e a condição. Clique num grupo do diagrama: a linha do candidato daquele grupo fica em destaque (fx) e as outras esmaecem (fora). Alvo do dossiê ttT16Apoio; vazio para quem não está na lista.
	measure 'T16 · Itens · HTML' =
			-- 1 · Leituras
			VAR _q = SELECTEDVALUE ( Apoio[Quem] )
			VAR _pos = [T16 · apoio · posição]
			VAR _cond = [T16 · apoio · condicionado]
			VAR _dia = [T16 · apoio · data]
			VAR _foco = [T16 · foco · grupo clicado]
			-- 2 · Textos
			VAR _item =
			    SWITCH (
			        _q,
			        "Augusto Cury", "1|Avante",
			        "Renan Santos", "2|Missão",
			        "Ronaldo Caiado", "3|PSD",
			        "Romeu Zema", "4|Novo",
			        "Hertz Dias", "5|PSTU",
			        "Edmilson Costa", "6|PCB",
			        "Samara Martins", "7|UP",
			        "Clariana Barão", "8|DC",
			        "Wilson Grassi", "9|Democrata",
			        "Rui Costa Pimenta", "10|PCO"
			    )
			VAR _ordem = IF ( NOT ISBLANK ( _item ), VALUE ( LEFT ( _item, SEARCH ( "|", _item ) - 1 ) ) )
			VAR _partido = IF ( NOT ISBLANK ( _item ), MID ( _item, SEARCH ( "|", _item ) + 1, 40 ) )
			VAR _meuGrupo = SWITCH ( _q, "Augusto Cury", "Cury", "Renan Santos", "Renan", "Ronaldo Caiado", "Caiado" )
			VAR _clsFoco = IF ( ISBLANK ( _foco ) || _foco = "nao_votou", "", IF ( _meuGrupo = _foco, " fx", " fora" ) )
			VAR _cls = SWITCH ( _pos, "Flávio", "f", "Lula", "l", "n" )
			VAR _txtPos = SWITCH ( _pos, "liberou", "liberou o eleitor", _pos )
			VAR _escQ = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _q, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtNota =
			    IF ( ISBLANK ( _dia ), "", "em " & FORMAT ( _dia, "dd/MM" ) )
			        & IF ( _cond = "Sim", IF ( ISBLANK ( _dia ), "", " · " ) & "com condições", "" )
			-- 3 · Geometria (linhas de 58 px a partir de y 32; etiquetas em duas fileiras de três a partir de y 300)
			VAR _top = 32 + ( _ordem - 1 ) * 58 -- geometria
			VAR _col = MOD ( _ordem - 5, 3 ) -- geometria
			VAR _fil = INT ( ( _ordem - 5 ) / 3 ) -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _item ) && NOT ISBLANK ( _pos ),
			        "<div class='tela t16i" & _clsFoco & "'>"
			            & IF (
			                _ordem <= 4,
			                "<div class='ln sobe' style='top:" & _top & "px;animation-delay:" & ( 200 + _ordem * 120 ) & "ms'>"
			                    & "<div class='q'><b>" & _escQ & "</b><span>" & _partido & "</span></div>"
			                    & "<span class='seta'>→</span><span class='bd " & _cls & "'>" & _txtPos & "</span>"
			                    & "<small>" & _txtNota & "</small></div>",
			                "<div class='ch entra' style='left:" & ( _col * 176 ) & "px;top:" & ( 300 + _fil * 38 ) & "px;animation-delay:"
			                    & ( 700 + _ordem * 80 ) & "ms'>" & _partido & "<span class='bd " & _cls & "'>" & _txtPos
			                    & IF ( _cond = "Sim", "*", "" ) & "</span></div>"
			            )
			        & "</div>"
			    )
		displayFolder: T16 Os outros\Desenho
		lineageTag: 9d76470d-6bc2-5dd0-b72f-0867f983afed

	/// Texto para leitor de tela do quadro 'o eleitor segue o apoio?'.
	measure 'T16 · Seguir · ALT' =
			"Vox Brasil, 09/10: " & FORMAT ( [T16 · Vox · seguiriam o candidato], "0.0%" ) & " dizem que vão seguir o candidato do 1º turno; "
			    & FORMAT ( [T16 · Vox · manteriam a própria escolha], "0.0%" ) & " mantêm a própria escolha; "
			    & FORMAT ( [T16 · Vox · depende de quem recebe o apoio], "0.0%" ) & " dizem que depende."
		displayFolder: T16 Os outros\Desenho
		lineageTag: 8486ee32-2815-5d4d-a552-2cfdd80de51e

	/// O eleitor segue o apoio? O 17,2% da Vox Brasil (contador), a barra das três respostas e a nota à mão. Só lê as contas 'T16 · Vox · …'.
	measure 'T16 · Seguir · HTML' =
			-- 1 · Leituras
			VAR _s = [T16 · Vox · seguiriam o candidato]
			VAR _m = [T16 · Vox · manteriam a própria escolha]
			VAR _d = [T16 · Vox · depende de quem recebe o apoio]
			-- 2 · Textos
			VAR _txtS = FORMAT ( _s, "0.0%" )
			-- 3 · Geometria (barra de 520 px)
			VAR _ws = FORMAT ( _s * 520, "0.0", "en-US" ) -- geometria
			VAR _wd = FORMAT ( _d * 520, "0.0", "en-US" ) -- geometria
			VAR _wm = FORMAT ( _m * 520, "0.0", "en-US" ) -- geometria
			-- 4 · Marcação
			RETURN
			    "<div class='tela t16s'>"
			        & "<div class='sob sobe'>O eleitor segue o apoio?</div>"
			        & "<div class='hero sobe d2'><span class='num'>" & _txtS & "</span></div>"
			        & "<div class='frase sobe d3'>dizem que vão seguir a orientação do candidato em quem votaram no 1º turno.</div>"
			        & "<div class='bar'><i class='s' style='width:" & _ws & "px;animation-delay:.6s'></i><i class='d' style='width:" & _wd
			            & "px;animation-delay:.8s'></i><i class='m' style='width:" & _wm & "px;animation-delay:1s'></i></div>"
			        & "<div class='leg sobe d8'><b>" & FORMAT ( _m, "0.0%" ) & "</b> mantêm a própria escolha · <b>" & FORMAT ( _d, "0.0%" )
			            & "</b> dizem que depende de quem recebe o apoio</div>"
			        & "<div class='nota entra d10'>Vox Brasil, 09/10 · pergunta feita a todos os entrevistados</div>"
			        & "<div class='mao entra d14'>apoio não é voto</div>"
			    & "</div>"
		displayFolder: T16 Os outros\Desenho
		lineageTag: 7497b4b6-c3b6-5ce9-a6f9-63eb8f01ba02

	/// Texto para leitor de tela do dossiê de um apoio.
	measure 'T16 · Tooltip apoio · ALT' =
			IF (
			    NOT ISBLANK ( [T16 · apoio · posição] ),
			    LEFT ( SELECTEDVALUE ( Apoio[Quem] ) & ": " & [T16 · apoio · posição] & ". " & [T16 · apoio · citação], 250 )
			)
		displayFolder: T16 Os outros\Desenho
		lineageTag: 3fb72e0e-722f-5a88-8ad6-5728bb89d554

	/// Dossiê de um apoio declarado (ttT16Apoio, grão Apoio[Quem]): quem, cargo ou partido, a data, a frase literal (≤ 15 palavras) e a posição, com a condição quando houve.
	measure 'T16 · Tooltip apoio · HTML' =
			-- 1 · Leituras
			VAR _q = SELECTEDVALUE ( Apoio[Quem] )
			VAR _pos = [T16 · apoio · posição]
			VAR _cond = [T16 · apoio · condicionado]
			VAR _dia = [T16 · apoio · data]
			VAR _cit = [T16 · apoio · citação]
			VAR _cargo = [T16 · apoio · cargo]
			-- 2 · Textos
			VAR _escQ = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _q, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escCargo = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _cargo, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _escCit = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _cit, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtPos =
			    SWITCH ( _pos, "Flávio", "Apoia Flávio", "Lula", "Apoia Lula", "liberou", "Liberou o eleitor", "voto nulo", "Orienta voto nulo", "Neutro" )
			        & IF ( _cond = "Sim", ", com condições", "" )
			VAR _mao = SWITCH ( _pos, "Flávio", "com Flávio", "Lula", "com Lula", "liberou", "cada um decide", "voto nulo", "voto nulo", "neutro" )
			VAR _clsMao = SWITCH ( _pos, "Flávio", " az", "Lula", "", " ti" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _pos ),
			        "<div class='tt16a'>"
			            & "<div class='sob sobe'>" & IF ( ISBLANK ( _dia ), "Data não informada", FORMAT ( _dia, "dd/MM" ) ) & " · 2º turno</div>"
			            & "<div class='tt sobe d2'>" & _escQ & "</div>"
			            & "<div class='nota sobe d2' style='margin-top:-6px'>" & _escCargo & "</div>"
			            & IF ( ISBLANK ( _cit ) || _cit = "", "", "<div class='cit sobe d3'>“" & _escCit & "”</div>" )
			            & "<div class='txt sobe d4'><b>" & _txtPos & ".</b></div>"
			            & "<div class='mao" & _clsMao & " entra d6'>" & _mao & "</div>"
			        & "</div>"
			    )
		displayFolder: T16 Os outros\Desenho
		lineageTag: 36093b8c-4423-5847-aea5-99e5c6385ec3

	/// Texto para leitor de tela do dossiê de um grupo.
	measure 'T16 · Tooltip grupo · ALT' =
			IF (
			    [T16 · transferência · institutos] > 0,
			    "Última pesquisa de cada instituto: Lula de " & FORMAT ( [T16 · transferência · Lula mínimo], "0" ) & "% a "
			        & FORMAT ( [T16 · transferência · Lula máximo], "0" ) & "%, Flávio de " & FORMAT ( [T16 · transferência · Flávio mínimo], "0" )
			        & "% a " & FORMAT ( [T16 · transferência · Flávio máximo], "0" ) & "%."
			)
		displayFolder: T16 Os outros\Desenho
		lineageTag: 8aa5be5e-1f1c-516b-a384-bf3dd7eb6764

	/// Dossiê de um grupo de eleitores (ttT16Segmento, grão Transferência[Segmento]): a medição mais recente de cada instituto depois do 1º turno, com a barra de 100% (Lula, Flávio, branco/nulo), os números e o n quando publicado, e a faixa de variação entre institutos. A distribuição que a média da tela esconde.
	measure 'T16 · Tooltip grupo · HTML' =
			-- 1 · Leituras
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _n = [T16 · transferência · institutos]
			VAR _lMin = [T16 · transferência · Lula mínimo]
			VAR _lMax = [T16 · transferência · Lula máximo]
			VAR _fMin = [T16 · transferência · Flávio mínimo]
			VAR _fMax = [T16 · transferência · Flávio máximo]
			VAR _lista =
			    ADDCOLUMNS (
			        VALUES ( 'Transferência'[Instituto] ),
			        "@d", [T16 · instituto · divulgação],
			        "@l", [T16 · instituto · Lula],
			        "@f", [T16 · instituto · Flávio],
			        "@b", [T16 · instituto · branco ou nulo],
			        "@n", [T16 · instituto · entrevistas]
			    )
			-- 2 · Textos
			VAR _titulo =
			    SWITCH (
			        _seg,
			        "Cury", "Quem votou em Augusto Cury",
			        "Renan", "Quem votou em Renan Santos",
			        "Caiado", "Quem votou em Ronaldo Caiado",
			        "nao_votou", "Quem não votou no 1º turno"
			    )
			VAR _txtFaixa =
			    "Entre os institutos, Lula vai de " & FORMAT ( _lMin, "0" ) & "% a " & FORMAT ( _lMax, "0" ) & "% e Flávio, de "
			        & FORMAT ( _fMin, "0" ) & "% a " & FORMAT ( _fMax, "0" ) & "%."
			        & IF ( _seg = "nao_votou", " Na Quaest, o grupo inclui quem votou branco ou nulo.", " Com tão pouca gente por grupo, cada instituto vê um retrato um pouco diferente." )
			-- 3 · Geometria (barra de 100% com 210 px)
			VAR _linhas =
			    CONCATENATEX (
			        FILTER ( _lista, NOT ISBLANK ( [@d] ) ), /* lista */
			        VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'Transferência'[Instituto], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			        RETURN
			            "<div class='ins entra'><span>" & _esc & "</span><div class='b100'>"
			                & "<i class='l' style='width:" & FORMAT ( [@l] / 100 * 210, "0.0", "en-US" ) & "px'></i>"
			                & "<i class='f' style='width:" & FORMAT ( [@f] / 100 * 210, "0.0", "en-US" ) & "px'></i>"
			                & "<i class='b' style='width:" & FORMAT ( [@b] / 100 * 210, "0.0", "en-US" ) & "px'></i></div>"
			                & "<em><span class='lula'>" & FORMAT ( [@l], "0" ) & "</span> · <span class='flavio'>" & FORMAT ( [@f], "0" )
			                & "</span>" & IF ( ISBLANK ( [@b] ), "", " · " & FORMAT ( [@b], "0" ) )
			                & IF ( ISBLANK ( [@n] ), "", " · n=" & FORMAT ( [@n], "0" ) ) & "</em></div>",
			        "",
			        [@d], DESC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        _n > 0,
			        "<div class='tt16'>"
			            & "<div class='sob sobe'>A última de cada instituto · " & _n & IF ( _n = 1, " instituto", " institutos" ) & "</div>"
			            & "<div class='tt sobe d2'>" & _titulo & "</div>"
			            & _linhas
			            & "<div class='txt sobe d6'>" & _txtFaixa & "</div>"
			        & "</div>"
			    )
		displayFolder: T16 Os outros\Desenho
		lineageTag: 95034253-4531-5800-8b33-a044665ec27b

	/// Dia do 1º turno (04/10/2026), o corte entre as simulações de 2º turno feitas antes da eleição e as pesquisas de 2º turno de verdade. Constante do calendário do TSE.
	measure 'T17 · 1º turno · data' =
			DATE ( 2026, 10, 4 )
		formatString: dd/MM
		displayFolder: T17 2º turno\Contas
		lineageTag: f6ed74ae-58a4-5a14-9c7f-0f3f392da1a3

