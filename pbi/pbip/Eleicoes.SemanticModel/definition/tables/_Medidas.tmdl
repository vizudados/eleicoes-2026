		formatString: 0.0%
		displayFolder: T21 20 anos\Contas
		lineageTag: 22310a2b-8e81-5f38-acb3-e20c694dc71d

	/// Margem do PT em 2026 no contexto (o ponto do município no mapa dos 20 anos); vazio quando o município ainda não existia.
	measure 'T21 · margem 2026' =
			CALCULATE ( [T21 · margem], 'Ano'[Ano] = 2026 )
		formatString: 0.0%
		displayFolder: T21 20 anos\Contas
		lineageTag: c84d2289-05ca-592f-a7c3-038c9ff9adb8

	/// Margem nacional do PT no ano do contexto, como o TSE totaliza (com o exterior): votos do PT − votos do mais votado fora do PT, ÷ válidos.
	measure 'T21 · margem nacional' =
			VAR _pt =
			    CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Candidato ano'[Partido] = "PT" )
			VAR _adv =
			    MAXX (
			        FILTER (
			            VALUES ( 'Candidato ano'[Candidato] ),
			            CALCULATE ( MAX ( 'Candidato ano'[Partido] ) ) <> "PT"
			        ),
			        CALCULATE ( SUM ( 'Candidato ano'[Votos] ) )
			    )
			VAR _val =
			    CALCULATE ( MAX ( 'Candidato ano'[ValidosAno] ) )
			RETURN
			    DIVIDE ( _pt - _adv, _val )
		formatString: 0.0%
		displayFolder: T21 20 anos\Contas
		lineageTag: 01e85fec-2f17-5941-998e-79b53485cfc9

	/// Municípios do Brasil em que o PT ficou à frente no ano do contexto (margem > 0). Ignora o município da linha: o mesmo número em todos os pontos do mapa.
	measure 'T21 · municípios com o PT à frente' =
			CALCULATE (
			    COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T21 · margem] > 0 ) ),
			    REMOVEFILTERS ( 'Município' )
			)
		formatString: #,0
		displayFolder: T21 20 anos\Contas
		lineageTag: 90e0b3bf-ae24-5802-a28a-879a925c6410

	/// Texto alternativo da tela 21.
	measure 'T21 · Fundo · ALT' =
			-- 1 · Leituras
			VAR _n06 = CALCULATE ( [T21 · municípios com o PT à frente], 'Ano'[Ano] = 2006 )
			VAR _n26 = CALCULATE ( [T21 · municípios com o PT à frente], 'Ano'[Ano] = 2026 )
			RETURN
			    "De " & FORMAT ( _n06, "#,0" ) & " para " & FORMAT ( _n26, "#,0" ) & " municípios com o PT à frente, de 2006 a "
			        & "2026. Mapa de pontos com a margem de cada ano; o play anda pelas seis eleições."
		displayFolder: T21 20 anos\Desenho
		lineageTag: 57c1d4c2-3ebf-5028-8233-93a84270dbc7

	/// Fundo da tela 21 (atrás do Deneb, mesma caixa): a manchete com os municípios com o PT à frente em 2006 e em 2026 e, na régua, quem disputou cada eleição.
	measure 'T21 · Fundo · HTML' =
			-- 1 · Leituras
			VAR _n06 = CALCULATE ( [T21 · municípios com o PT à frente], 'Ano'[Ano] = 2006 )
			VAR _n26 = CALCULATE ( [T21 · municípios com o PT à frente], 'Ano'[Ano] = 2026 )
			VAR _pt06 = CALCULATE ( [T21 · candidato do PT], 'Ano'[Ano] = 2006 )
			VAR _adv06 = CALCULATE ( [T21 · adversário], 'Ano'[Ano] = 2006 )
			VAR _pt10 = CALCULATE ( [T21 · candidato do PT], 'Ano'[Ano] = 2010 )
			VAR _adv10 = CALCULATE ( [T21 · adversário], 'Ano'[Ano] = 2010 )
			VAR _pt14 = CALCULATE ( [T21 · candidato do PT], 'Ano'[Ano] = 2014 )
			VAR _adv14 = CALCULATE ( [T21 · adversário], 'Ano'[Ano] = 2014 )
			VAR _pt18 = CALCULATE ( [T21 · candidato do PT], 'Ano'[Ano] = 2018 )
			VAR _adv18 = CALCULATE ( [T21 · adversário], 'Ano'[Ano] = 2018 )
			VAR _pt22 = CALCULATE ( [T21 · candidato do PT], 'Ano'[Ano] = 2022 )
			VAR _adv22 = CALCULATE ( [T21 · adversário], 'Ano'[Ano] = 2022 )
			VAR _pt26 = CALCULATE ( [T21 · candidato do PT], 'Ano'[Ano] = 2026 )
			VAR _adv26 = CALCULATE ( [T21 · adversário], 'Ano'[Ano] = 2026 )
			-- 2 · Textos
			VAR _txt06 = FORMAT ( _n06, "#,0" )
			VAR _txt26 = FORMAT ( _n26, "#,0" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t21b'>"
			        & "<div class='man sobe d2'>De <span class='num'>" & _txt06 & "</span> para <span class='num'>" & _txt26
			            & "</span> municípios com o PT à frente, de 2006 a 2026</div>"
			        & "<div class='regua entra d6'>"
			        & "<div class='ano' style='left:106px'><b>2006</b><span>" & SWITCH ( _pt06, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _pt06 ) & " × " & SWITCH ( _adv06, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _adv06 ) & "</span></div>"
			        & "<div class='ano' style='left:200px'><b>2010</b><span>" & SWITCH ( _pt10, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _pt10 ) & " × " & SWITCH ( _adv10, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _adv10 ) & "</span></div>"
			        & "<div class='ano' style='left:294px'><b>2014</b><span>" & SWITCH ( _pt14, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _pt14 ) & " × " & SWITCH ( _adv14, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _adv14 ) & "</span></div>"
			        & "<div class='ano' style='left:388px'><b>2018</b><span>" & SWITCH ( _pt18, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _pt18 ) & " × " & SWITCH ( _adv18, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _adv18 ) & "</span></div>"
			        & "<div class='ano' style='left:482px'><b>2022</b><span>" & SWITCH ( _pt22, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _pt22 ) & " × " & SWITCH ( _adv22, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _adv22 ) & "</span></div>"
			        & "<div class='ano' style='left:576px'><b>2026</b><span>" & SWITCH ( _pt26, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _pt26 ) & " × " & SWITCH ( _adv26, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Jair", "Flávio Bolsonaro", "Flávio", _adv26 ) & "</span></div>"
			        & "</div>"
			    & "</div>"
		displayFolder: T21 20 anos\Desenho
		lineageTag: a603c8dc-eb57-51f1-a766-5f51a349cccd

	/// Texto alternativo do mapa animado da tela 21.
	measure 'T21 · Mapa · ALT' =
			-- 1 · Leituras
			VAR _n26 = CALCULATE ( [T21 · municípios com o PT à frente], 'Ano'[Ano] = 2026 )
			VAR _m26 = CALCULATE ( [T21 · margem nacional], 'Ano'[Ano] = 2026 )
			RETURN
			    "Mapa dos municípios pela margem do PT. Em 2026, " & FORMAT ( _n26, "#,0" ) & " municípios com o PT à frente e "
			        & "margem nacional de " & FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" ) & " pontos. Use o play ou clique num ano."
		displayFolder: T21 20 anos\Desenho
		lineageTag: af51f027-3039-558c-9a58-fed2be08eb71

	/// Os seis anos num texto só, para o Deneb: 'ano|municípios com o PT à frente|margem nacional' separados por ';' (o mesmo em todas as linhas do mapa). Só lê as contas.
	measure 'T21 · Mapa · anos para o Deneb' =
			-- 1 · Leituras e 2 · Textos (uma linha por ano)
			VAR _anos =
			    ADDCOLUMNS (
			        VALUES ( 'Ano'[Ano] ),
			        "@n", CALCULATE ( [T21 · municípios com o PT à frente], 'Ano'[Ano] = EARLIER ( 'Ano'[Ano] ) ),
			        "@m", CALCULATE ( [T21 · margem nacional], 'Ano'[Ano] = EARLIER ( 'Ano'[Ano] ) )
			    ) /* lista */
			-- 4 · Marcação
			RETURN
			    CONCATENATEX (
			        _anos,
			        'Ano'[Ano] & "|" & [@n] & "|" & FORMAT ( [@m], "0.0000", "en-US" ),
			        ";",
			        'Ano'[Ano], ASC
			    ) /* lista */
		displayFolder: T21 20 anos\Desenho
		lineageTag: 01497897-7fc4-5091-a5e2-94f316f85042

	/// Eleitores aptos em 2026 no contexto (sem o exterior: o TSE não publica os aptos do exterior por município).
	measure 'T22 · aptos 2026' =
			CALCULATE ( SUM ( 'Município ano'[Aptos] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 8a680d63-a713-51ee-a57d-80f8afb74f13

	/// Votos de Lula − votos de Flávio no 2º turno simulado (positivo = Lula à frente).
	measure 'T22 · cenário · diferença' =
			[T22 · cenário · votos de Lula] - [T22 · cenário · votos de Flávio]
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 4c8229e7-2e76-5c44-94d0-f97251f79e88

	/// Flávio ÷ (Lula + Flávio) no 2º turno simulado.
	measure 'T22 · cenário · Flávio %' =
			DIVIDE (
			    [T22 · cenário · votos de Flávio],
			    [T22 · cenário · votos de Lula] + [T22 · cenário · votos de Flávio]
			)
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 44b6f437-6065-50b5-b479-3d1ee89174fd

	/// Lula ÷ (Lula + Flávio) no 2º turno simulado (votos válidos).
	measure 'T22 · cenário · Lula %' =
			DIVIDE (
			    [T22 · cenário · votos de Lula],
			    [T22 · cenário · votos de Lula] + [T22 · cenário · votos de Flávio]
			)
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 011ce6b6-a63b-5e59-a169-4f9c864e218e

	/// UFs (as 27, sem o exterior) em que Flávio fica à frente no cenário.
	measure 'T22 · cenário · UFs com Flávio à frente' =
			COALESCE (
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" ),
			            [T22 · cenário · votos de Flávio] > [T22 · cenário · votos de Lula]
			        )
			    ),
			    0
			)
		formatString: 0
		displayFolder: T22 Simulador\Contas
		lineageTag: 17b6e9b3-203d-5119-a5ec-efafcc0b7949

	/// UFs (as 27, sem o exterior) em que Lula fica à frente no cenário.
	measure 'T22 · cenário · UFs com Lula à frente' =
			COALESCE (
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" ),
			            [T22 · cenário · votos de Lula] > [T22 · cenário · votos de Flávio]
			        )
			    ),
			    0
			)
		formatString: 0
		displayFolder: T22 Simulador\Contas
		lineageTag: 9650fdab-a394-5a47-8f05-7411a75d641b

	/// Votos de Flávio no 2º turno simulado.
	measure 'T22 · cenário · votos de Flávio' =
			[T22 · votos de Flávio no 1º turno] + [T22 · cenário · votos que Flávio ganha] + [T22 · votos novos] / 2
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 47902240-8c80-5336-bd77-a158540ce79f

	/// Votos de Lula no 2º turno simulado: os do 1º turno + os que ganha dos outros + metade dos votos novos do comparecimento.
	measure 'T22 · cenário · votos de Lula' =
			[T22 · votos de Lula no 1º turno] + [T22 · cenário · votos que Lula ganha] + [T22 · votos novos] / 2
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 1a30a050-06b1-5938-9100-d8451e523540

	/// Votos dos outros candidatos que vão para Flávio no cenário (o resto dos que votam, ou o cruzamento da pesquisa em uso).
	measure 'T22 · cenário · votos que Flávio ganha' =
			VAR _pesquisa = [T22 · pesquisa em uso]
			VAR _controles =
			    [T22 · votos dos outros] * ( 1 - [T22 · parte que não vota] ) * ( 1 - [T22 · parte para Lula] )
			VAR _segundo =
			    [T22 · votos de Cury] * [T22 · pesquisa · Flávio entre os eleitores de Cury]
			        + [T22 · votos de Renan] * [T22 · pesquisa · Flávio entre os eleitores de Renan]
			        + [T22 · votos de Caiado] * [T22 · pesquisa · Flávio entre os eleitores de Caiado]
			        + [T22 · votos dos demais] * [T22 · pesquisa · Flávio entre os eleitores de demais]
			RETURN
			    IF ( ISBLANK ( _pesquisa ), _controles, _segundo )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 52291c0c-ef7d-5811-8c66-e70493c5991f

	/// Votos dos outros candidatos que vão para Lula no cenário: pelos controles (outros × (1 − não vota) × parte para Lula) ou, com uma pesquisa em uso, pelo cruzamento de cada candidato.
	measure 'T22 · cenário · votos que Lula ganha' =
			VAR _pesquisa = [T22 · pesquisa em uso]
			VAR _controles =
			    [T22 · votos dos outros] * ( 1 - [T22 · parte que não vota] ) * [T22 · parte para Lula]
			VAR _segundo =
			    [T22 · votos de Cury] * [T22 · pesquisa · Lula entre os eleitores de Cury]
			        + [T22 · votos de Renan] * [T22 · pesquisa · Lula entre os eleitores de Renan]
			        + [T22 · votos de Caiado] * [T22 · pesquisa · Lula entre os eleitores de Caiado]
			        + [T22 · votos dos demais] * [T22 · pesquisa · Lula entre os eleitores de demais]
			RETURN
			    IF ( ISBLANK ( _pesquisa ), _controles, _segundo )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: cb42be5a-beec-5853-a933-3691642c0b0b

	/// Votos de Flávio − votos de Lula no 1º turno de 2026 (positivo = Flávio à frente).
	measure 'T22 · diferença no 1º turno' =
			[T22 · votos de Flávio no 1º turno] - [T22 · votos de Lula no 1º turno]
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 4772dc04-1676-5e0c-8342-0ed2c563fe79

	/// Parte dos que votarem, entre os eleitores dos outros, que Lula precisaria para empatar com a abstenção do controle: 1/2 + diferença ÷ (2 × (1 − não vota) × outros). O comparecimento extra se divide ao meio e não muda o empate.
	measure 'T22 · empate com a abstenção escolhida' =
			0.5
			    + DIVIDE (
			        [T22 · diferença no 1º turno],
			        2 * ( 1 - [T22 · parte que não vota] ) * [T22 · votos dos outros]
			    )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: b1ead6fc-39c5-5815-90da-b68ef2a7f795

	/// Parte dos votos dos outros que Lula precisaria para empatar se todos votassem: 1/2 + diferença ÷ (2 × votos dos outros).
	measure 'T22 · empate sem abstenção' =
			0.5 + DIVIDE ( [T22 · diferença no 1º turno], 2 * [T22 · votos dos outros] )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: ea5621f8-a63b-5d80-b681-2214a80236ae

	/// Flávio sobre os votos de Lula e Flávio no 1º turno de 2026 no contexto (só os dois): o ponto de partida do cenário.
	measure 'T22 · Flávio % no 1º turno' =
			VAR _l = [T22 · Lula % no 1º turno]
			RETURN
			    IF ( NOT ISBLANK ( _l ), 1 - _l )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 761e9762-25fa-540d-b2aa-dcb41d715543

	/// Votos de Lula ÷ (Lula + Flávio) no 1º turno, no contexto (para comparar com o cenário no dossiê da UF).
	measure 'T22 · Lula % no 1º turno' =
			DIVIDE (
			    [T22 · votos de Lula no 1º turno],
			    [T22 · votos de Lula no 1º turno] + [T22 · votos de Flávio no 1º turno]
			)
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 618d02b9-b577-527b-b306-8e2730a81321

	/// Controle do simulador: pontos de comparecimento a mais (ou a menos) sobre os aptos de cada UF (−0,05 a +0,05); sem marca, zero.
	measure 'T22 · mudança no comparecimento' =
			SELECTEDVALUE ( 'T22 Comparecimento'[Comparecimento], 0 ) / 100
		formatString: 0.00
		displayFolder: T22 Simulador\Contas
		lineageTag: ee1dd7b2-efcf-5901-a7ac-80736a341823

	/// Peso dos outros candidatos nos votos válidos do 1º turno, no contexto (onde o simulador mexe mais).
	measure 'T22 · parte dos outros nos válidos' =
			DIVIDE (
			    [T22 · votos dos outros],
			    [T22 · votos dos outros] + [T22 · votos de Lula no 1º turno] + [T22 · votos de Flávio no 1º turno]
			)
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 84d6afbf-183c-51e8-b7db-bbcdd5e01e0e

	/// Controle do simulador: dos eleitores dos outros candidatos que forem votar, a parte que escolhe Lula (0–1); sem marca, metade.
	measure 'T22 · parte para Lula' =
			SELECTEDVALUE ( 'T22 Para Lula'[Para Lula], 50 ) / 100
		formatString: 0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 933203ac-327d-5978-bc42-c93ccb7d5f81

	/// Controle do simulador: a parte dos votos dos outros candidatos que não vai para ninguém (branco, nulo ou falta), 0–0,5; sem marca, zero.
	measure 'T22 · parte que não vota' =
			SELECTEDVALUE ( 'T22 Não votam'[Não votam], 0 ) / 100
		formatString: 0%
		displayFolder: T22 Simulador\Contas
		lineageTag: c0dea3ea-2437-54fc-bd32-e0a02a8f54c5

	/// O instituto cuja pesquisa a conta usa (linha clicada na lista das pesquisas); vazio = os controles da tela.
	measure 'T22 · pesquisa em uso' =
			IF (
			    ISFILTERED ( 'Transferência'[Instituto] ) && HASONEVALUE ( 'Transferência'[Instituto] ),
			    VALUES ( 'Transferência'[Instituto] )
			)
		displayFolder: T22 Simulador\Contas
		lineageTag: 41fe848a-8063-5f0d-9291-9b5d9652c02b

	/// Divulgação da última pesquisa do instituto em uso feita depois do 1º turno (04/10/2026) com o cruzamento por candidato; vazio sem pesquisa.
	measure 'T22 · pesquisa · data' =
			IF (
			    NOT ISBLANK ( [T22 · pesquisa em uso] ),
			    CALCULATE (
			        MAX ( 'Transferência'[Divulgação] ),
			        'Transferência'[Segmento] IN { "Cury", "Renan", "Caiado", "outros", "Zema", "agregado_3via" },
			        'Transferência'[Divulgação] > DATE ( 2026, 10, 4 )
			    )
			)
		formatString: dd/MM/yyyy
		displayFolder: T22 Simulador\Contas
		lineageTag: 1de99f3c-6064-5fa9-b401-cb978b3e8a55

	/// Sim quando a pesquisa em uso não publicou os eleitores dos demais candidatos (nem 'outros', nem Zema, nem o agregado): a conta usa a média de Cury, Renan e Caiado pelos votos; Não nas outras; vazio sem pesquisa em uso.
	measure 'T22 · pesquisa · demais pela média' =
			VAR _data = [T22 · pesquisa · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			        VAR _demais = COUNTROWS ( FILTER ( _linhas, 'Transferência'[Segmento] IN { "outros", "Zema", "agregado_3via" } ) )
			        RETURN
			            IF ( ISBLANK ( _demais ), "Sim", "Não" )
			    )
		displayFolder: T22 Simulador\Contas
		lineageTag: 0bee6de4-edb6-5851-ab7e-88863aaf1690

	/// Na pesquisa em uso (a última de cada instituto depois do 1º turno), a parte dos eleitores de Caiado que vai para Flávio no 2º turno; sem o segmento, o agregado da terceira via.
	measure 'T22 · pesquisa · Flávio entre os eleitores de Caiado' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _seg = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Caiado" ), 'Transferência'[Flavio] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Flavio] )
			RETURN
			    IF ( NOT ISBLANK ( _data ), DIVIDE ( COALESCE ( _seg, _agregado, 0 ), 100 ) )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: e26c7e1f-42a9-5896-b610-da118e33000c

	/// Na pesquisa em uso (a última de cada instituto depois do 1º turno), a parte dos eleitores de Cury que vai para Flávio no 2º turno; sem o segmento, o agregado da terceira via.
	measure 'T22 · pesquisa · Flávio entre os eleitores de Cury' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _seg = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Cury" ), 'Transferência'[Flavio] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Flavio] )
			RETURN
			    IF ( NOT ISBLANK ( _data ), DIVIDE ( COALESCE ( _seg, _agregado, 0 ), 100 ) )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 4b643e3a-49d1-51c8-98fd-5e5ac59fb8a6

	/// Na pesquisa em uso, a parte dos eleitores dos demais candidatos (Zema e mais 6) que vai para Flávio: o segmento 'outros'; sem ele, Zema; sem ele, o agregado; sem nenhum, a média de Cury, Renan e Caiado pelos votos.
	measure 'T22 · pesquisa · Flávio entre os eleitores de demais' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _outros = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "outros" ), 'Transferência'[Flavio] )
			VAR _zema = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Zema" ), 'Transferência'[Flavio] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Flavio] )
			VAR _media =
			    DIVIDE (
			        [T22 · votos de Cury] * [T22 · pesquisa · Flávio entre os eleitores de Cury]
			            + [T22 · votos de Renan] * [T22 · pesquisa · Flávio entre os eleitores de Renan]
			            + [T22 · votos de Caiado] * [T22 · pesquisa · Flávio entre os eleitores de Caiado],
			        [T22 · votos de Cury] + [T22 · votos de Renan] + [T22 · votos de Caiado]
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        COALESCE ( DIVIDE ( COALESCE ( _outros, _zema, _agregado ), 100 ), _media )
			    )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: c156a0ac-1349-516f-a437-4c2fe0fc71d9

	/// Na pesquisa em uso (a última de cada instituto depois do 1º turno), a parte dos eleitores de Renan que vai para Flávio no 2º turno; sem o segmento, o agregado da terceira via.
	measure 'T22 · pesquisa · Flávio entre os eleitores de Renan' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _seg = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Renan" ), 'Transferência'[Flavio] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Flavio] )
			RETURN
			    IF ( NOT ISBLANK ( _data ), DIVIDE ( COALESCE ( _seg, _agregado, 0 ), 100 ) )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: e1520700-8c5d-5a3b-abe4-701bf9b68f4b

	/// Na pesquisa em uso (a última de cada instituto depois do 1º turno), a parte dos eleitores de Caiado que vai para Lula no 2º turno; sem o segmento, o agregado da terceira via.
	measure 'T22 · pesquisa · Lula entre os eleitores de Caiado' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _seg = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Caiado" ), 'Transferência'[Lula] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Lula] )
			RETURN
			    IF ( NOT ISBLANK ( _data ), DIVIDE ( COALESCE ( _seg, _agregado, 0 ), 100 ) )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: b27341f0-a297-5be6-a488-9b4e5af4e5c6

	/// Na pesquisa em uso (a última de cada instituto depois do 1º turno), a parte dos eleitores de Cury que vai para Lula no 2º turno; sem o segmento, o agregado da terceira via.
	measure 'T22 · pesquisa · Lula entre os eleitores de Cury' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _seg = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Cury" ), 'Transferência'[Lula] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Lula] )
			RETURN
			    IF ( NOT ISBLANK ( _data ), DIVIDE ( COALESCE ( _seg, _agregado, 0 ), 100 ) )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: a664d3ef-ffb3-507d-b676-a201e7d17c9c

	/// Na pesquisa em uso, a parte dos eleitores dos demais candidatos (Zema e mais 6) que vai para Lula: o segmento 'outros'; sem ele, Zema; sem ele, o agregado; sem nenhum, a média de Cury, Renan e Caiado pelos votos.
	measure 'T22 · pesquisa · Lula entre os eleitores de demais' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _outros = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "outros" ), 'Transferência'[Lula] )
			VAR _zema = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Zema" ), 'Transferência'[Lula] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Lula] )
			VAR _media =
			    DIVIDE (
			        [T22 · votos de Cury] * [T22 · pesquisa · Lula entre os eleitores de Cury]
			            + [T22 · votos de Renan] * [T22 · pesquisa · Lula entre os eleitores de Renan]
			            + [T22 · votos de Caiado] * [T22 · pesquisa · Lula entre os eleitores de Caiado],
			        [T22 · votos de Cury] + [T22 · votos de Renan] + [T22 · votos de Caiado]
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        COALESCE ( DIVIDE ( COALESCE ( _outros, _zema, _agregado ), 100 ), _media )
			    )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 7ffda6cb-295d-5e48-91f2-d9782e18b285

	/// Na pesquisa em uso (a última de cada instituto depois do 1º turno), a parte dos eleitores de Renan que vai para Lula no 2º turno; sem o segmento, o agregado da terceira via.
	measure 'T22 · pesquisa · Lula entre os eleitores de Renan' =
			VAR _data = [T22 · pesquisa · data]
			VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			VAR _seg = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "Renan" ), 'Transferência'[Lula] )
			VAR _agregado = MAXX ( FILTER ( _linhas, 'Transferência'[Segmento] = "agregado_3via" ), 'Transferência'[Lula] )
			RETURN
			    IF ( NOT ISBLANK ( _data ), DIVIDE ( COALESCE ( _seg, _agregado, 0 ), 100 ) )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 7eec8e8c-cc4b-5c42-a738-262ac8b0f7ec

	/// Na pesquisa em uso, dos eleitores dos outros que vão votar em alguém, a parte que escolhe Lula (o número que a régua do controle compara).
	measure 'T22 · pesquisa · parte para Lula entre os que votam' =
			DIVIDE (
			    [T22 · cenário · votos que Lula ganha],
			    [T22 · cenário · votos que Lula ganha] + [T22 · cenário · votos que Flávio ganha]
			)
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: b5c44f50-aa47-53d1-8a8e-f341171aa2df

	/// Na pesquisa em uso, a parte dos votos dos outros que não vai para Lula nem para Flávio (branco, nulo, não vota ou não sabe).
	measure 'T22 · pesquisa · parte que não vota' =
			1
			    - DIVIDE (
			        [T22 · cenário · votos que Lula ganha] + [T22 · cenário · votos que Flávio ganha],
			        [T22 · votos dos outros]
			    )
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: b7cba6ff-1010-57a4-a474-05131b7f88f2

	/// Posição da pesquisa na lista, da que dá mais votos a Lula à que dá menos.
	measure 'T22 · pesquisa · posição' =
			IF (
			    NOT ISBLANK ( [T22 · pesquisa · data] ),
			    RANKX (
			        FILTER ( ALLSELECTED ( 'Transferência'[Instituto] ), NOT ISBLANK ( [T22 · pesquisa · data] ) ),
			        [T22 · cenário · Lula %], , DESC, SKIP
			    )
			)
		formatString: 0
		displayFolder: T22 Simulador\Contas
		lineageTag: 10fa9265-3418-597a-bdb9-ea9abdc881e1

	/// Sim quando a pesquisa em uso publicou os eleitores de Cury, Renan e Caiado num grupo só (agregado da terceira via): os três ganham o mesmo número; Não quando publicou cada um; vazio sem pesquisa em uso.
	measure 'T22 · pesquisa · terceira via junta' =
			VAR _data = [T22 · pesquisa · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        VAR _linhas = CALCULATETABLE ( 'Transferência', 'Transferência'[Divulgação] = _data )
			        VAR _separados = COUNTROWS ( FILTER ( _linhas, 'Transferência'[Segmento] IN { "Cury", "Renan", "Caiado" } ) )
			        RETURN
			            IF ( ISBLANK ( _separados ), "Sim", "Não" )
			    )
		displayFolder: T22 Simulador\Contas
		lineageTag: 2ed1d534-ae51-5324-b7d4-5ae1a9b95541

	/// Na pesquisa em uso, os votos dos outros candidatos que não vão para Lula nem para Flávio (branco, nulo, não vota ou não sabe); vazio sem pesquisa em uso.
	measure 'T22 · pesquisa · votos para ninguém' =
			VAR _data = [T22 · pesquisa · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        [T22 · votos dos outros] - [T22 · cenário · votos que Lula ganha] - [T22 · cenário · votos que Flávio ganha]
			    )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: dc8edceb-740f-5b82-9d6f-cd0419be36a2

	/// Entre as últimas pesquisas de cada instituto, a que dá a Lula a maior parte dos eleitores dos outros que votam. Ignora a pesquisa em uso.
	measure 'T22 · pesquisas · maior parte para Lula' =
			CALCULATE (
			    MAXX (
			        FILTER ( VALUES ( 'Transferência'[Instituto] ), NOT ISBLANK ( [T22 · pesquisa · data] ) ),
			        [T22 · pesquisa · parte para Lula entre os que votam]
			    ),
			    REMOVEFILTERS ( 'Transferência'[Instituto] )
			)
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: 41389257-7136-51ee-938f-8a07db557199

	/// Entre as últimas pesquisas de cada instituto (depois do 1º turno), a que dá a Lula a menor parte dos eleitores dos outros que votam. Ignora a pesquisa em uso.
	measure 'T22 · pesquisas · menor parte para Lula' =
			CALCULATE (
			    MINX (
			        FILTER ( VALUES ( 'Transferência'[Instituto] ), NOT ISBLANK ( [T22 · pesquisa · data] ) ),
			        [T22 · pesquisa · parte para Lula entre os que votam]
			    ),
			    REMOVEFILTERS ( 'Transferência'[Instituto] )
			)
		formatString: 0.0%
		displayFolder: T22 Simulador\Contas
		lineageTag: c7b41ab8-4c1e-58af-9b18-4de196736ee6

	/// Quantos institutos têm pesquisa depois do 1º turno com o cruzamento por candidato. Ignora a pesquisa em uso.
	measure 'T22 · pesquisas · quantas' =
			CALCULATE (
			    COUNTROWS ( FILTER ( VALUES ( 'Transferência'[Instituto] ), NOT ISBLANK ( [T22 · pesquisa · data] ) ) ),
			    REMOVEFILTERS ( 'Transferência'[Instituto] )
			)
		formatString: 0
		displayFolder: T22 Simulador\Contas
		lineageTag: 1778e30a-5bc6-57af-bb31-e8e39f78226d

	/// Nome da UF clicada no mapa de quadrados (filtro cruzado em UF[UF]); vazio sem clique: o resultado é o Brasil.
	measure 'T22 · UF escolhida' =
			IF ( ISFILTERED ( 'UF'[UF] ) && HASONEVALUE ( 'UF'[UF] ), VALUES ( 'UF'[Nome] ) )
		displayFolder: T22 Simulador\Contas
		lineageTag: d51d51f2-7bc3-5568-91d0-92f9adb1c49b

	/// Coluna do quadrado da UF no mapa de quadrados (0 = Acre).
	measure 'T22 · UF · coluna na grade' =
			SELECTEDVALUE ( 'UF'[GradeColuna] )
		formatString: 0
		displayFolder: T22 Simulador\Contas
		lineageTag: 1e54795c-0188-57fe-a6b3-d3173c346d04

	/// Linha do quadrado da UF no mapa de quadrados (0 = Roraima, Amapá e o exterior).
	measure 'T22 · UF · linha na grade' =
			SELECTEDVALUE ( 'UF'[GradeLinha] )
		formatString: 0
		displayFolder: T22 Simulador\Contas
		lineageTag: 12efed51-9e34-518e-80b2-5b8f0317e761

	/// Nome da UF do quadrado.
	measure 'T22 · UF · nome' =
			SELECTEDVALUE ( 'UF'[Nome] )
		displayFolder: T22 Simulador\Contas
		lineageTag: 4e898c94-df9d-54f7-8ff6-d622a1bc3ea3

	/// Sigla da UF do quadrado (ZZ = exterior).
	measure 'T22 · UF · sigla' =
			SELECTEDVALUE ( 'UF'[UF] )
		displayFolder: T22 Simulador\Contas
		lineageTag: 5fcf8c5f-1e90-57a2-9204-a29200ebe683

	/// Votos de Ronaldo Caiado no 1º turno de 2026 no contexto.
	measure 'T22 · votos de Caiado' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 55 )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 7b1fc283-ac7c-57cc-8533-00c4dd8d9ba7

	/// Votos de Augusto Cury no 1º turno de 2026 no contexto.
	measure 'T22 · votos de Cury' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 70 )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 38d586ae-ee9d-57ba-907c-c52ce41206d8

	/// Votos de Flávio Bolsonaro no 1º turno de 2026 no contexto.
	measure 'T22 · votos de Flávio no 1º turno' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 22 )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: f0d898f5-a90a-5e3a-bb5b-22a1a7f2267d

	/// Votos de Lula no 1º turno de 2026 no contexto (Brasil com o exterior, ou a UF do quadrado).
	measure 'T22 · votos de Lula no 1º turno' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 13 )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 2e63da20-ee58-5e22-9e9b-cbeeaf69f1ad

	/// Votos de Renan Santos no 1º turno de 2026 no contexto.
	measure 'T22 · votos de Renan' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 14 )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 5f65c1c5-5c14-587d-b8e0-d351d3497aa1

	/// Votos dos outros 7 candidatos (Zema e mais 6) no 1º turno de 2026 no contexto.
	measure 'T22 · votos dos demais' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, NOT 'Candidato UF'[Número] IN { 13, 22, 70, 14, 55 } )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: cd27c5a2-1072-5baa-92ca-f2f921b68cc2

	/// Votos dos candidatos fora Lula e Flávio no 1º turno de 2026 (Cury, Renan, Caiado e os demais): o que está em jogo no 2º turno.
	measure 'T22 · votos dos outros' =
			[T22 · votos de Cury] + [T22 · votos de Renan] + [T22 · votos de Caiado] + [T22 · votos dos demais]
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 8bf32863-8a7a-5ff2-834d-4470abae0fba

	/// Votos a mais (ou a menos) pela mudança no comparecimento: pontos × aptos de cada UF; no simulador, metade vai para cada candidato.
	measure 'T22 · votos novos' =
			SUMX ( VALUES ( 'UF'[UF] ), [T22 · mudança no comparecimento] * [T22 · aptos 2026] )
		formatString: #,0
		displayFolder: T22 Simulador\Contas
		lineageTag: 01e26c0a-26c8-5d94-a5c0-0d339b3a613c

	/// Texto alternativo da resposta do simulador.
	measure 'T22 · Herói · ALT' =
			-- 1 · Leituras
			VAR _emp = [T22 · empate sem abstenção]
			VAR _outros = [T22 · votos dos outros]
			RETURN
			    "Para empatar, Lula precisaria de " & FORMAT ( _emp * 100, "0" ) & "% dos " & FORMAT ( _outros / 1000000, "0.00" ) & " mi"
			        & " de votos dos outros candidatos. Simulação, não previsão."
		displayFolder: T22 Simulador\Desenho
		lineageTag: 2184442d-b2ea-5545-960b-e5bb333df70d

	/// A resposta da tela: quanto dos votos dos outros candidatos Lula precisaria para empatar (contador), a manchete e o aviso de que é simulação.
	measure 'T22 · Herói · HTML' =
			-- 1 · Leituras
			VAR _emp = [T22 · empate sem abstenção]
			VAR _outros = [T22 · votos dos outros]
			VAR _dif = [T22 · diferença no 1º turno]
			-- 2 · Textos
			VAR _txtEmp = FORMAT ( _emp * 100, "0" )
			VAR _txtOutros = FORMAT ( _outros / 1000000, "0.00" ) & " mi"
			VAR _txtDif = FORMAT ( _dif / 1000000, "0.00" ) & " mi"
			-- 4 · Marcação
			RETURN
			    "<div class='tela t22h'>"
			        & "<div class='grande sobe'><span class='num'>" & _txtEmp & "</span>%</div>"
			        & "<div class='lado sobe d2'>dos <b>" & _txtOutros & "</b> de votos dos outros candidatos: o que Lula "
			            & "precisaria para empatar com Flávio</div>"
			        & "<div class='man sobe d3'>Flávio terminou o 1º turno <span class='num'>" & _txtDif
			            & "</span> à frente. Para empatar, Lula precisaria de " & _txtEmp & "% dos votos dos outros; metade "
			            & "não basta.</div>"
			    & "</div>"
		displayFolder: T22 Simulador\Desenho
		lineageTag: 4882e2f4-5cd4-57ae-8a91-b41cdb3c8939

	/// Texto alternativo da lista das pesquisas.
	measure 'T22 · Pesquisas · ALT' =
			"Lista das " & [T22 · pesquisas · quantas] & " pesquisas com o cruzamento dos eleitores dos outros candidatos: a parte "
			    & "que vai para Lula e o 2º turno que isso daria. Clique numa linha para ver o cenário no mapa."
		displayFolder: T22 Simulador\Desenho
		lineageTag: c401ce66-52a9-5209-8179-984664b6d2a0

	/// Uma linha da lista das pesquisas (granularidade Transferência[Instituto]): para onde vão os votos dos outros segundo a última pesquisa do instituto depois do 1º turno, e o 2º turno que isso daria. Clicar leva o cenário da pesquisa ao resultado e ao mapa.
	measure 'T22 · Pesquisas · HTML' =
			-- 1 · Leituras
			VAR _data = [T22 · pesquisa · data]
			VAR _pos = [T22 · pesquisa · posição]
			VAR _a = [T22 · pesquisa · parte para Lula entre os que votam]
			VAR _b = [T22 · pesquisa · parte que não vota]
			VAR _lula = [T22 · cenário · Lula %]
			VAR _flavio = [T22 · cenário · Flávio %]
			-- 2 · Textos
			VAR _inst0 = [T22 · pesquisa em uso]
			VAR _inst = SUBSTITUTE ( SUBSTITUTE ( _inst0, "&", "&amp;" ), "<", "&lt;" )
			VAR _txtData = FORMAT ( _data, "dd/MM" )
			VAR _txtL = FORMAT ( _lula, "0.0%" )
			VAR _txtF = FORMAT ( _flavio, "0.0%" )
			-- 3 · Geometria
			VAR _wl = ( 1 - _b ) * _a * 260 -- geometria
			VAR _wf = ( 1 - _b ) * ( 1 - _a ) * 260 -- geometria
			VAR _y = 62 + ( _pos - 1 ) * 28 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        "<div class='tela t22p'><div class='ln sobe d" & ( _pos + 2 ) & "' style='top:" & _y & "px'>"
			            & "<span class='i'>" & _inst & "</span><span class='d'>" & _txtData & "</span>"
			            & "<span class='b'><i class='l' style='width:" & FORMAT ( _wl, "0.0##", "en-US" ) & "px'></i>"
			            & "<i class='f' style='width:" & FORMAT ( _wf, "0.0##", "en-US" ) & "px'></i></span>"
			            & "<span class='pa tnum'>" & FORMAT ( _a * 100, "0" ) & "%</span>"
			            & "<span class='r tnum'><b class='lula'>" & _txtL & "</b> × <b class='flavio'>" & _txtF & "</b></span>"
			        & "</div></div>"
			    )
		displayFolder: T22 Simulador\Desenho
		lineageTag: 893eafd4-c805-5b3a-876d-a9fd40a58f88

	/// Texto alternativo do resultado simulado.
	measure 'T22 · Resultado · ALT' =
			-- 1 · Leituras
			VAR _lula = [T22 · cenário · Lula %]
			VAR _flavio = [T22 · cenário · Flávio %]
			VAR _ufL = [T22 · cenário · UFs com Lula à frente]
			VAR _ufF = [T22 · cenário · UFs com Flávio à frente]
			VAR _uf = [T22 · UF escolhida]
			RETURN
			    IF (
			        NOT ISBLANK ( _uf ),
			        "2º turno simulado em " & _uf & ": Lula " & FORMAT ( _lula, "0.0%" ) & ", Flávio " & FORMAT ( _flavio, "0.0%" ) & ".",
			        "2º turno simulado: Lula " & FORMAT ( _lula, "0.0%" ) & ", Flávio " & FORMAT ( _flavio, "0.0%" ) & ". Lula à frente "
			            & "em " & _ufL & IF ( _ufL = 1, " UF", " UFs" ) & ", Flávio em " & _ufF & IF ( _ufF = 1, " UF.", " UFs." )
			    )
		displayFolder: T22 Simulador\Desenho
		lineageTag: 41c3b361-fd7c-5216-9add-ac1f9d5489b8

	/// O 2º turno simulado no Brasil (com o exterior): Lula × Flávio em % dos válidos, em quantas UFs cada um fica à frente e a diferença em votos; o rótulo diz se a conta usa os controles ou uma pesquisa. Com uma UF clicada no mapa (filtro cruzado), o resultado daquela UF, com o 1º turno dela (só os dois) no lugar da contagem de UFs.
	measure 'T22 · Resultado · HTML' =
			-- 1 · Leituras
			VAR _pesq = [T22 · pesquisa em uso]
			VAR _data = [T22 · pesquisa · data]
			VAR _lula = [T22 · cenário · Lula %]
			VAR _flavio = [T22 · cenário · Flávio %]
			VAR _ufL = [T22 · cenário · UFs com Lula à frente]
			VAR _ufF = [T22 · cenário · UFs com Flávio à frente]
			VAR _dif = [T22 · cenário · diferença]
			VAR _uf = [T22 · UF escolhida]
			VAR _lula1 = [T22 · Lula % no 1º turno]
			VAR _flavio1 = [T22 · Flávio % no 1º turno]
			-- 2 · Textos
			VAR _rotulo =
			    IF (
			        ISBLANK ( _pesq ),
			        "Seus controles",
			        "Pesquisa " & SUBSTITUTE ( _pesq, "<", "&lt;" ) & ", " & FORMAT ( _data, "dd/MM" )
			    )
			VAR _ehUf = NOT ISBLANK ( _uf )
			VAR _escUf = SUBSTITUTE ( SUBSTITUTE ( _uf, "&", "&amp;" ), "<", "&lt;" )
			VAR _txtUfL =
			    IF ( _ehUf, "no 1º turno, " & FORMAT ( _lula1, "0.0%" ) & " (só os dois)", "à frente em " & _ufL & IF ( _ufL = 1, " UF", " UFs" ) )
			VAR _txtUfF =
			    IF ( _ehUf, "no 1º turno, " & FORMAT ( _flavio1, "0.0%" ) & " (só os dois)", "à frente em " & _ufF & IF ( _ufF = 1, " UF", " UFs" ) )
			VAR _limite = IF ( _ehUf, 5000, 50000 )
			VAR _nota =
			    IF ( _ehUf, _escUf & ": ", "" )
			        & SWITCH (
			            TRUE (),
			            ABS ( _dif ) < _limite, "praticamente empatados",
			            _dif > 0, "Lula vence por " & IF ( _dif >= 1000000, FORMAT ( _dif / 1000000, "0.0" ) & " mi", FORMAT ( _dif, "#,0" ) ) & " de votos",
			            "Flávio vence por " & IF ( - _dif >= 1000000, FORMAT ( - _dif / 1000000, "0.0" ) & " mi", FORMAT ( - _dif, "#,0" ) ) & " de votos"
			        )
			-- 3 · Geometria
			VAR _wl = _lula * 100 -- geometria
			-- 4 · Marcação
			RETURN
			    "<div class='tela t22r'>"
			        & "<div class='rot sobe'>Resultado do 2º turno simulado · " & IF ( _ehUf, _escUf & " · ", "" ) & _rotulo & "</div>"
			        & "<div class='lado l sobe d1'><span class='q'>Lula</span><span class='num'>" & FORMAT ( _lula, "0.0%" )
			            & "</span><span class='u'>" & _txtUfL & "</span></div>"
			        & "<div class='lado f sobe d2'><span class='q'>Flávio</span><span class='num'>" & FORMAT ( _flavio, "0.0%" )
			            & "</span><span class='u'>" & _txtUfF & "</span></div>"
			        & "<div class='br'><i class='bl barra-x' style='width:" & FORMAT ( _wl, "0.0##", "en-US" ) & "%'></i>"
			            & "<i class='bf barra-x-dir' style='width:" & FORMAT ( 100 - _wl, "0.0##", "en-US" ) & "%'></i>"
			            & "<i class='meio'></i></div>"
			        & "<div class='cinq'>50%</div>"
			        & "<div class='mao sobe d6'>" & _nota & "</div>"
			    & "</div>"
		displayFolder: T22 Simulador\Desenho
		lineageTag: ba64f6c5-a9eb-5c5f-9118-963971288a4c

	/// Texto alternativo da régua de abstenção.
	measure 'T22 · Régua abstenção · ALT' =
			"Controle: " & FORMAT ( [T22 · parte que não vota] * 100, "0" ) & "% dos eleitores dos outros não escolhem ninguém."
		displayFolder: T22 Simulador\Desenho
		lineageTag: ef425fc7-e11d-5e99-b3ca-fdc114d563ec

	/// Título e subtítulo da régua de quem não escolhe ninguém (0 a 50%); o trilho e o botão são do VizuFilter no modo régua.
	measure 'T22 · Régua abstenção · HTML' =
			-- 1 · Leituras
			VAR _b = [T22 · parte que não vota]
			VAR _outros = [T22 · votos dos outros]
			-- 2 · Textos
			VAR _txt =
			    IF ( _b = 0, "ninguém: todos votam", FORMAT ( _b * 100, "0" ) & "% · " & FORMAT ( _outros * _b / 1000000, "0.00" ) & " mi" & " de votos a menos" )
			-- 3 · Marcação (trilho, botão e os rótulos 0% e 50% são do VizuFilter no modo régua, por cima)
			RETURN
			    "<div class='tela t22c'>"
			        & "<div class='pergunta sobe'>Quantos deles não vão escolher ninguém?</div>"
			        & "<div class='valor sobe d1'>" & _txt & "</div>"
			    & "</div>"
		displayFolder: T22 Simulador\Desenho
		lineageTag: ea231e4b-dab5-58db-90cb-f34c7c3d2bdf

	/// Texto alternativo da régua de comparecimento.
	measure 'T22 · Régua comparecimento · ALT' =
			"Controle: comparecimento " & FORMAT ( [T22 · mudança no comparecimento] * 100, "+0;−0;0" ) & " pontos sobre o 1º turno."
		displayFolder: T22 Simulador\Desenho
		lineageTag: bb5ccaba-6aee-5831-9547-2bdd7d1e3188

	/// Título e subtítulo da régua de comparecimento (−5 a +5 pontos), com os votos a mais ou a menos e a regra: metade para cada um; o trilho e o botão são do VizuFilter no modo régua.
	measure 'T22 · Régua comparecimento · HTML' =
			-- 1 · Leituras
			VAR _c = [T22 · mudança no comparecimento]
			VAR _novos = [T22 · votos novos]
			-- 2 · Textos
			VAR _txt =
			    IF (
			        _c = 0,
			        "como no 1º turno",
			        FORMAT ( _c * 100, "+0;−0" ) & IF ( ABS ( _c ) = 0.01, " ponto · ", " pontos · " )
			            & FORMAT ( ABS ( _novos ) / 1000000, "0.0" ) & " mi" & IF ( _c > 0, " a mais", " a menos" ) & ", metade para cada um"
			    )
			-- 3 · Marcação (trilho, marca do zero, botão e os rótulos −5 e +5 são do VizuFilter no modo régua, por cima)
			RETURN
			    "<div class='tela t22c'>"
			        & "<div class='pergunta sobe'>E se o comparecimento mudar?</div>"
			        & "<div class='valor sobe d1'>" & _txt & "</div>"
			    & "</div>"
		displayFolder: T22 Simulador\Desenho
		lineageTag: 22f51ae9-ffa2-5c64-9c46-2b13ac8e57bc

	/// Texto alternativo da régua do controle principal.
	measure 'T22 · Régua Lula · ALT' =
			-- 1 · Leituras
			VAR _a = [T22 · parte para Lula]
			VAR _emp = [T22 · empate com a abstenção escolhida]
			RETURN
			    "Controle: " & FORMAT ( _a * 100, "0" ) & "% dos eleitores dos outros que votam escolhem Lula. Empate em "
			        & FORMAT ( _emp * 100, "0" ) & "%. Arraste o botão da régua (ou use as setas) para mudar."
		displayFolder: T22 Simulador\Desenho
		lineageTag: 18dcd982-a785-5dbb-94c1-f5584e291168

	/// A régua do controle principal: a barra dividida (Lula à esquerda, Flávio à direita) na posição escolhida, a marca do empate e a faixa onde caem as pesquisas.
	measure 'T22 · Régua Lula · HTML' =
			-- 1 · Leituras
			VAR _a = [T22 · parte para Lula]
			VAR _emp = [T22 · empate com a abstenção escolhida]
			VAR _min = [T22 · pesquisas · menor parte para Lula]
			VAR _max = [T22 · pesquisas · maior parte para Lula]
			VAR _n = [T22 · pesquisas · quantas]
			VAR _pesq0 =
			    ADDCOLUMNS (
			        VALUES ( 'Transferência'[Instituto] ),
			        "@d", [T22 · pesquisa · data],
			        "@a", [T22 · pesquisa · parte para Lula entre os que votam]
			    ) /* lista */
			VAR _pesq = FILTER ( _pesq0, NOT ISBLANK ( [@d] ) ) /* lista */
			-- 2 · Textos
			VAR _txtA = FORMAT ( _a * 100, "0" ) & "% Lula"
			VAR _txtF = FORMAT ( ( 1 - _a ) * 100, "0" ) & "% Flávio"
			VAR _txtEmp = "empate: " & FORMAT ( _emp * 100, "0" ) & "%"
			VAR _txtFaixa =
			    "as " & _n & " pesquisas: de " & FORMAT ( _min * 100, "0" ) & "% a " & FORMAT ( _max * 100, "0" ) & "%"
			-- 3 · Geometria
			VAR _xa = 30 + _a * 100 * 8.0 -- geometria
			VAR _xe = 30 + MIN ( 1, _emp ) * 100 * 8.0 -- geometria
			VAR _x0 = 30 + _min * 100 * 8.0 -- geometria
			VAR _x1 = 30 + _max * 100 * 8.0 -- geometria
			VAR _marcas =
			    CONCATENATEX (
			        _pesq,
			        "<i class='pq' style='left:" & FORMAT ( 30 + [@a] * 100 * 8.0 - 1, "0.0##", "en-US" ) & "px'></i>",
			        ""
			    ) /* lista */
			-- 4 · Marcação
			RETURN
			    "<div class='tela t22a'>"
			        & "<div class='pergunta sobe'>Dos eleitores dos outros candidatos que forem votar, quantos escolhem Lula?</div>"
			        & "<div class='barra entra d2'>"
			            & "<i class='l' style='width:" & FORMAT ( _xa - 30, "0.0##", "en-US" ) & "px'></i>"
			            & "<i class='f' style='left:" & FORMAT ( _xa - 30, "0.0##", "en-US" ) & "px;width:"
			            & FORMAT ( 830 - _xa, "0.0##", "en-US" ) & "px'></i>"
			            & "<span class='tl'>" & IF ( _a >= 0.12, _txtA, "" ) & "</span>"
			            & "<span class='tf'>" & IF ( _a <= 0.88, _txtF, "" ) & "</span>"
			        & "</div>"
			        & "<i class='emp' style='left:" & FORMAT ( _xe - 1, "0.0##", "en-US" ) & "px'></i>"
			        & "<span class='emp-t mao' style='left:" & FORMAT ( _xe - 4, "0.0##", "en-US" ) & "px'>" & _txtEmp & "</span>"
			        & "<i class='faixa entra d4' style='left:" & FORMAT ( _x0, "0.0##", "en-US" ) & "px;width:"
			        & FORMAT ( _x1 - _x0, "0.0##", "en-US" ) & "px'></i>" & _marcas
			        & "<span class='faixa-t entra d5' style='left:" & FORMAT ( _x0, "0.0##", "en-US" ) & "px'>" & _txtFaixa
			        & "</span>"
			    & "</div>"
		displayFolder: T22 Simulador\Desenho
		lineageTag: f546329b-4866-5819-a710-bb257cc471fb

	/// Texto alternativo do dossiê de uma pesquisa da lista.
	measure 'T22 · Tooltip pesquisa · ALT' =
			-- 1 · Leituras
			VAR _inst = [T22 · pesquisa em uso]
			VAR _data = [T22 · pesquisa · data]
			VAR _ganhaL = [T22 · cenário · votos que Lula ganha]
			VAR _ganhaF = [T22 · cenário · votos que Flávio ganha]
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        _inst & ", " & FORMAT ( _data, "dd/MM" ) & ": dos votos dos outros candidatos, Lula ganha "
			            & FORMAT ( _ganhaL / 1000000, "0.00" ) & " mi e Flávio " & FORMAT ( _ganhaF / 1000000, "0.00" ) & " mi."
			    )
		displayFolder: T22 Simulador\Desenho
		lineageTag: 82e07cf6-9516-59e4-b7bc-afccce82722a

	/// Dossiê de uma pesquisa da lista (página de tooltip ttT22Pesquisa, grão Transferência[Instituto]): para onde vão os eleitores de Cury, Renan, Caiado e dos demais segundo a última pesquisa do instituto depois do 1º turno (barra Lula | Flávio | ninguém, com os votos de cada grupo no 1º turno), quanto cada um ganha no total e como a pesquisa publicou os grupos.
	measure 'T22 · Tooltip pesquisa · HTML' =
			-- 1 · Leituras
			VAR _inst0 = [T22 · pesquisa em uso]
			VAR _data = [T22 · pesquisa · data]
			VAR _outros = [T22 · votos dos outros]
			VAR _vCu = [T22 · votos de Cury]
			VAR _lCu = [T22 · pesquisa · Lula entre os eleitores de Cury]
			VAR _fCu = [T22 · pesquisa · Flávio entre os eleitores de Cury]
			VAR _vRe = [T22 · votos de Renan]
			VAR _lRe = [T22 · pesquisa · Lula entre os eleitores de Renan]
			VAR _fRe = [T22 · pesquisa · Flávio entre os eleitores de Renan]
			VAR _vCa = [T22 · votos de Caiado]
			VAR _lCa = [T22 · pesquisa · Lula entre os eleitores de Caiado]
			VAR _fCa = [T22 · pesquisa · Flávio entre os eleitores de Caiado]
			VAR _vde = [T22 · votos dos demais]
			VAR _lde = [T22 · pesquisa · Lula entre os eleitores de demais]
			VAR _fde = [T22 · pesquisa · Flávio entre os eleitores de demais]
			VAR _ganhaL = [T22 · cenário · votos que Lula ganha]
			VAR _ganhaF = [T22 · cenário · votos que Flávio ganha]
			VAR _ninguem = [T22 · pesquisa · votos para ninguém]
			VAR _junta = [T22 · pesquisa · terceira via junta]
			VAR _media = [T22 · pesquisa · demais pela média]
			-- 2 · Textos
			VAR _inst = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _inst0, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			VAR _txtSoma =
			    "No total, Lula ganha <b class='lula'>" & FORMAT ( _ganhaL / 1000000, "0.00" ) & " mi" & "</b> e Flávio, <b class='flavio'>" & FORMAT ( _ganhaF / 1000000, "0.00" ) & " mi"
			        & "</b>; " & FORMAT ( _ninguem / 1000000, "0.00" ) & " mi" & " não vão para nenhum dos dois."
			VAR _nota =
			    SWITCH (
			        TRUE (),
			        _junta = "Sim", "Esta pesquisa publicou os eleitores da terceira via num grupo só: todos os grupos levam o mesmo número.",
			        _media = "Sim", "Sem o grupo dos demais candidatos nesta pesquisa, a conta usa a média de Cury, Renan e Caiado pelo peso dos votos.",
			        "Cada grupo tem poucos entrevistados (em geral menos de 100): é sinal, não medida."
			    )
			VAR _mao =
			    SWITCH ( TRUE (), _ganhaL > _ganhaF, "pendem para Lula", _ganhaF > _ganhaL, "pendem para Flávio", "meio a meio" )
			VAR _gCu =
			    "<div class='gr sobe d3'><span class='g'>Cury<small>" & FORMAT ( _vCu / 1000000, "0.00" ) & " mi" & "</small></span>"
			        & "<span class='b'><i class='l barra-x' style='width:" & FORMAT ( _lCu * 200, "0.0##", "en-US" ) & "px'></i>"
			        & "<i class='f barra-x' style='width:" & FORMAT ( _fCu * 200, "0.0##", "en-US" ) & "px'></i></span>"
			        & "<span class='v'><b class='lula'>" & FORMAT ( _lCu, "0%" ) & "</b> · <b class='flavio'>"
			        & FORMAT ( _fCu, "0%" ) & "</b></span></div>"
			VAR _gRe =
			    "<div class='gr sobe d4'><span class='g'>Renan<small>" & FORMAT ( _vRe / 1000000, "0.00" ) & " mi" & "</small></span>"
			        & "<span class='b'><i class='l barra-x' style='width:" & FORMAT ( _lRe * 200, "0.0##", "en-US" ) & "px'></i>"
			        & "<i class='f barra-x' style='width:" & FORMAT ( _fRe * 200, "0.0##", "en-US" ) & "px'></i></span>"
			        & "<span class='v'><b class='lula'>" & FORMAT ( _lRe, "0%" ) & "</b> · <b class='flavio'>"
			        & FORMAT ( _fRe, "0%" ) & "</b></span></div>"
			VAR _gCa =
			    "<div class='gr sobe d5'><span class='g'>Caiado<small>" & FORMAT ( _vCa / 1000000, "0.00" ) & " mi" & "</small></span>"
			        & "<span class='b'><i class='l barra-x' style='width:" & FORMAT ( _lCa * 200, "0.0##", "en-US" ) & "px'></i>"
			        & "<i class='f barra-x' style='width:" & FORMAT ( _fCa * 200, "0.0##", "en-US" ) & "px'></i></span>"
			        & "<span class='v'><b class='lula'>" & FORMAT ( _lCa, "0%" ) & "</b> · <b class='flavio'>"
			        & FORMAT ( _fCa, "0%" ) & "</b></span></div>"
			VAR _gde =
			    "<div class='gr sobe d6'><span class='g'>Demais<small>" & FORMAT ( _vde / 1000000, "0.00" ) & " mi" & "</small></span>"
			        & "<span class='b'><i class='l barra-x' style='width:" & FORMAT ( _lde * 200, "0.0##", "en-US" ) & "px'></i>"
			        & "<i class='f barra-x' style='width:" & FORMAT ( _fde * 200, "0.0##", "en-US" ) & "px'></i></span>"
			        & "<span class='v'><b class='lula'>" & FORMAT ( _lde, "0%" ) & "</b> · <b class='flavio'>"
			        & FORMAT ( _fde, "0%" ) & "</b></span></div>"
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _data ),
			        "<div class='tela tt22p'>"
			            & "<div class='nm sobe'>" & _inst & " · " & FORMAT ( _data, "dd/MM" ) & "</div>"
			            & "<div class='rot sobe d1'>Para onde vão os " & FORMAT ( _outros / 1000000, "0.00" ) & " mi" & " de votos dos outros</div>"
			            & "<div class='leg sobe d2'><i class='l'></i>Lula <i class='f'></i>Flávio <i class='n'></i>nenhum dos dois</div>"
			            & _gCu & _gRe & _gCa & _gde
			            & "<div class='pe sobe d8'>" & _txtSoma & "</div>"
			            & "<div class='nota sobe d9'>" & _nota & "</div>"
			            & "<div class='mao" & IF ( _ganhaF > _ganhaL, " az", "" ) & " entra d10'>os outros " & _mao & "</div>"
			        & "</div>"
			    )
		displayFolder: T22 Simulador\Desenho
		lineageTag: e8669bd9-4c22-51fe-a0f7-b7fca29777a6

	/// Texto alternativo do dossiê da UF.
	measure 'T22 · Tooltip UF · ALT' =
			-- 1 · Leituras
			VAR _nome = [T22 · UF · nome]
			VAR _lula = [T22 · cenário · Lula %]
			RETURN
			    IF ( NOT ISBLANK ( _nome ), _nome & " no cenário: Lula " & FORMAT ( _lula, "0.0%" ) & ", Flávio "
			        & FORMAT ( 1 - _lula, "0.0%" ) & "." )
		displayFolder: T22 Simulador\Desenho
		lineageTag: 8712883a-38c2-5b20-b18c-5b5a615c95e7

	/// Dossiê da UF no cenário (página de tooltip ttT22UF): Lula × Flávio no cenário, no 1º turno (só os dois) e o peso dos outros candidatos ali.
	measure 'T22 · Tooltip UF · HTML' =
			-- 1 · Leituras
			VAR _nome = [T22 · UF · nome]
			VAR _lula = [T22 · cenário · Lula %]
			VAR _flavio = [T22 · cenário · Flávio %]
			VAR _lula1 = [T22 · Lula % no 1º turno]
			VAR _outros = [T22 · parte dos outros nos válidos]
			VAR _dif = [T22 · cenário · diferença]
			-- 2 · Textos
			VAR _quem = IF ( _dif > 0, "Lula à frente", IF ( _dif < 0, "Flávio à frente", "empate" ) )
			VAR _mudou = ( _lula - _lula1 ) * 100
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _nome ),
			        "<div class='tela tt22'>"
			            & "<div class='nm'>" & _nome & "</div>"
			            & "<div class='rot'>No cenário</div>"
			            & "<div class='duelo'><span class='lula'>Lula " & FORMAT ( _lula, "0.0%" ) & "</span>"
			            & "<span class='flavio'>Flávio " & FORMAT ( _flavio, "0.0%" ) & "</span></div>"
			            & "<div class='rot'>No 1º turno, só os dois</div>"
			            & "<div class='duelo menor'><span class='lula'>Lula " & FORMAT ( _lula1, "0.0%" ) & "</span>"
			            & "<span class='flavio'>Flávio " & FORMAT ( 1 - _lula1, "0.0%" ) & "</span></div>"
			            & "<div class='pe'>Os outros candidatos tiveram " & FORMAT ( _outros, "0.0%" ) & " dos votos aqui. No "
			            & "cenário, Lula " & IF ( _mudou < 0, "perde ", "ganha " ) & FORMAT ( ABS ( _mudou ), "0.0" )
			            & IF ( ROUND ( ABS ( _mudou ), 1 ) = 1, " ponto", " pontos" ) & " em relação ao 1º turno.</div>"
			            & "<div class='mao'>" & _quem & "</div>"
			        & "</div>"
			    )
		displayFolder: T22 Simulador\Desenho
		lineageTag: 14f94bc1-946c-5305-b2af-116900711fbe

	/// Texto alternativo do mapa de quadrados.
	measure 'T22 · UF · ALT' =
			-- 1 · Leituras
			VAR _ufL = [T22 · cenário · UFs com Lula à frente]
			VAR _ufF = [T22 · cenário · UFs com Flávio à frente]
			RETURN
			    "Mapa de quadrados das UFs no cenário: Lula à frente em " & _ufL & ", Flávio em " & _ufF
			        & ". Passe o mouse num estado para ver o detalhe."
		displayFolder: T22 Simulador\Desenho
		lineageTag: dd47130c-3a03-5bab-ad30-16aecf1e728d

	/// Um quadrado do mapa de quadrados (granularidade UF[UF], com o exterior): a cor de quem fica à frente no cenário, mais forte quanto maior a vantagem, a sigla e o % de Lula.
	measure 'T22 · UF · HTML' =
			-- 1 · Leituras
			VAR _uf = [T22 · UF · sigla]
			VAR _col = [T22 · UF · coluna na grade]
			VAR _lin = [T22 · UF · linha na grade]
			VAR _lula = [T22 · cenário · Lula %]
			-- 2 · Textos
			VAR _sigla = IF ( _uf = "ZZ", "EX", _uf )
			VAR _m = _lula - 0.5
			VAR _cor =
			    SWITCH (
			        TRUE (),
			        _m <= -0.15, "#1D3C6E",
			        _m <= -0.05, "#2B5797",
			        _m < 0, "#8FA8CF",
			        _m < 0.05, "#D9877B",
			        _m < 0.15, "#B8322A",
			        "#8E2620"
			    )
			VAR _clara = _m > -0.05 && _m < 0.05
			VAR _cls = IF ( _clara, "q clara", "q" ) & IF ( _uf = "ZZ", " ex", "" )
			-- 3 · Geometria
			VAR _x = _col * 66 -- geometria
			VAR _y = _lin * 66 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _lula ),
			        "<div class='tela t22g'><div class='" & _cls & " cor-q' style='left:" & _x & "px;top:" & _y
			            & "px;background:" & _cor & ";animation-delay:" & ( 400 + ( _col + _lin ) * 70 ) & "ms'>"
			            & "<b>" & _sigla & "</b><span>" & FORMAT ( _lula, "0%" ) & "</span></div></div>"
			    )
		displayFolder: T22 Simulador\Desenho
		lineageTag: 7db4dd5e-0af6-50db-9477-182e59dc4026

	/// Degrau no contexto (1 a 5): o grão do gráfico e do tooltip.
	measure 'T24 · degrau' =
