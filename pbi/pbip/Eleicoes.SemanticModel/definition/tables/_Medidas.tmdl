	/// Municípios em que Lula estava à frente em 2022 e Flávio ficou à frente em 2026. Conta município a município no recorte.
	measure 'T11 · viraram' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			        VAR _d22 = [T11 · saldo 2022]
			        VAR _d26 = [T11 · saldo 2026]
			        RETURN
