	/// Posição do dia entre os dias da campanha (de 16/08 ao fim da curva) pelo índice de Flávio (1 = o dia de mais buscas por ele na campanha), na série que a curva mostra (Brasil, consulta T2; com um estado clicado, a consulta U2 dele, nos mesmos dias). Vazio fora da campanha (01 a 15/08): a manchete do dia só diz 'na campanha' de um dia da campanha.
	measure 'T08 · dia · posição Flávio' =
			VAR _v = [T08 · dia · Flávio]
			VAR _d = [T08 · dia · data]
			VAR _ini = [T08 · campanha · início]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@v", [T08 · dia · Flávio]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _v ) && _d >= _ini, COUNTROWS ( FILTER ( _dias, [@d] >= _ini && [@v] > _v ) ) + 1 )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 672accad-0e4b-5aba-9fb9-6a4c72c3e972

	/// Posição do dia entre os dias da campanha (de 16/08 ao fim da curva) pelo índice de Lula (1 = o dia de mais buscas por ele na campanha), na série que a curva mostra (Brasil, consulta T2; com um estado clicado, a consulta U2 dele, nos mesmos dias). Vazio fora da campanha (01 a 15/08): a manchete do dia só diz 'na campanha' de um dia da campanha.
	measure 'T08 · dia · posição Lula' =
			VAR _v = [T08 · dia · Lula]
			VAR _d = [T08 · dia · data]
			VAR _ini = [T08 · campanha · início]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@v", [T08 · dia · Lula]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _v ) && _d >= _ini, COUNTROWS ( FILTER ( _dias, [@d] >= _ini && [@v] > _v ) ) + 1 )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: df920617-dac4-5dda-8c6c-ccd375bc9fb1

	/// Dias da campanha na curva: de 16/08 (T08 · campanha · início) ao último dia da curva (22/10). Antes de 24/10/2026 a conta começava em 01/08, o começo da consulta, e dava 83.
	measure 'T08 · dias' =
			VAR _ini = [T08 · campanha · início]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
