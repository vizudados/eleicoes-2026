		lineageTag: 1a32a20c-7f62-5a30-899a-2748c4c55161

	/// Votos em branco no ano do contexto: Brasil oficial ('Comparecimento ano') sem filtro; soma dos municípios com o filtro de UF.
	measure 'T06 · brancos (ano)' =
