	/// Quinto de renda da célula de maior queda.
	measure 'T13 · maior queda · quinto' =
			VAR _c =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            FILTER (
			                SUMMARIZE ( 'Município', 'Município'[Porte], 'Município'[Quinto de renda] ),
