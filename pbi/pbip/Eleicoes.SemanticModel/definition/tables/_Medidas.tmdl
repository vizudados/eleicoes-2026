	/// 1 quando um local foi escolhido (no filtro do topo, no mapa ou na lista); 0 quando a ficha mostra o exemplo da cidade.
	measure 'T20 · há escolha' =
			IF ( NOT ISBLANK ( [T20 · escola clicada] ) || NOT ISBLANK ( [T20 · escola do filtro] ), 1, 0 )
