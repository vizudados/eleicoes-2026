	/// Nome da cidade da tela com a UF: Contagem (MG).
	measure 'T20 · cidade' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    LOOKUPVALUE ( 'T20 Cidade'[Cidade], 'T20 Cidade'[CodIBGE], _cod )
