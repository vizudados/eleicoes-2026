	/// Votos dos demais candidatos sobre os válidos no ano, no município.
	measure 'T15 · outros % no ano' =
			DIVIDE ( SUM ( 'Município ano'[VotosDemais] ), SUM ( 'Município ano'[Validos] ) )
		formatString: 0.0%
