	/// Último dia em que Flávio teve índice maior que Lula, nos dias da curva dentro do período escolhido no filtro Período (o dia do debate conta como depois), na série que a curva mostra (Brasil, T2, ou o estado clicado, U2); vazio sem período (o texto usa quando é um dia só).
	measure 'T08 · período · dia com Flávio à frente' =
			VAR _ini = [T08 · período · início no Google]
			VAR _fim = [T08 · período · fim no Google]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@l", [T08 · dia · Lula],
			        "@f", [T08 · dia · Flávio]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _ini ), MAXX ( FILTER ( _dias, [@d] >= _ini && [@d] <= _fim && [@f] > [@l] ), [@d] ) )
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: 51fb8c91-b129-55ad-876e-6161cd1c6c07

