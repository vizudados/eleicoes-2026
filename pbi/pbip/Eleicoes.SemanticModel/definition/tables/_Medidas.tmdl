	/// Seções totalizadas no Brasil em cada hora do TSE.
	measure 'Histórico · seções %' =
			DIVIDE ( SUM ( 'Apuração histórico'[SecoesTotalizadas] ), SUM ( 'Apuração histórico'[SecoesTotal] ) )
