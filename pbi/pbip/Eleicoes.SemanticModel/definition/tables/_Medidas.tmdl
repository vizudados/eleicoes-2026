	/// Locais de votação da cidade da tela em 2026 (112 em Contagem).
	measure 'T20 · locais' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE (
			        CALCULATE ( COUNTROWS ( 'T20 Local' ), REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[CodIBGE] = _cod ),
			        0
			    )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 994b5cac-bdfa-51b7-b998-ce552b7f36c9

	/// Locais de 2026 da cidade da tela em que Flávio teve mais votos que Lula.
	measure 'T20 · locais com Flávio à frente' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE (
			        CALCULATE (
			            COUNTROWS ( FILTER ( 'T20 Local', 'T20 Local'[VotosPT2026] < 'T20 Local'[VotosAdv2026] ) ),
			            REMOVEFILTERS ( 'T20 Local' ),
			            'T20 Local'[CodIBGE] = _cod
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 03c0e890-95df-5030-8272-5f93bf7da2bc

	/// Locais de 2026 da cidade da tela em que Lula teve mais votos que Flávio.
	measure 'T20 · locais com Lula à frente' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE (
			        CALCULATE (
			            COUNTROWS ( FILTER ( 'T20 Local', 'T20 Local'[VotosPT2026] > 'T20 Local'[VotosAdv2026] ) ),
			            REMOVEFILTERS ( 'T20 Local' ),
			            'T20 Local'[CodIBGE] = _cod
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 14b9d522-1265-5479-90ad-2821da324255

	/// Locais de 2022 da cidade da tela (os do próprio ano) em que Lula teve mais votos que Jair Bolsonaro (calculado no pipeline).
	measure 'T20 · locais com Lula à frente em 2022' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE ( LOOKUPVALUE ( 'T20 Cidade'[Lula2022], 'T20 Cidade'[CodIBGE], _cod ), 0 )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 45147b3e-c8b1-5ba8-a6ce-6faa513f58d4

	/// Locais de votação da cidade da tela em 2022, como o TSE os listou naquele ano (zona, número, nome e endereço; calculado no pipeline).
	measure 'T20 · locais em 2022' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE ( LOOKUPVALUE ( 'T20 Cidade'[Locais2022], 'T20 Cidade'[CodIBGE], _cod ), 0 )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 05fc0525-df3d-530f-9ec3-5097dd11fd10

	/// Locais de 2026 da cidade da tela longe da mancha urbana, fora do recorte do mapa (só nas cidades de território grande): entram nas contas e na lista.
	measure 'T20 · locais fora do recorte' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE (
			        CALCULATE (
			            COUNTROWS ( 'T20 Local' ),
			            REMOVEFILTERS ( 'T20 Local' ),
			            'T20 Local'[CodIBGE] = _cod,
			            'T20 Local'[Fora do mapa] = "fora do recorte"
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 2b2f0c5b-a6f2-5586-8092-ff1589423780

	/// Locais de 2026 da cidade da tela em que Lula ficou à frente em 2022 (mesmo zona + número) e Flávio em 2026.
	measure 'T20 · locais que viraram' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE (
			        CALCULATE (
			            COUNTROWS (
			                FILTER (
			                    'T20 Local',
			                    'T20 Local'[VotosPT2022] > 'T20 Local'[VotosAdv2022]
			                        && 'T20 Local'[VotosPT2026] < 'T20 Local'[VotosAdv2026]
			                )
			            ),
			            REMOVEFILTERS ( 'T20 Local' ),
			            'T20 Local'[CodIBGE] = _cod
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 9b264b0b-b7de-51b3-9fbd-585704f64bdc

	/// Locais de 2026 da cidade da tela em que Jair Bolsonaro ficou à frente em 2022 (mesmo zona + número) e Lula em 2026: o caminho inverso, contado com a mesma regra.
	measure 'T20 · locais que viraram para Lula' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE (
			        CALCULATE (
			            COUNTROWS (
			                FILTER (
			                    'T20 Local',
			                    'T20 Local'[VotosPT2022] < 'T20 Local'[VotosAdv2022]
			                        && 'T20 Local'[VotosPT2026] > 'T20 Local'[VotosAdv2026]
			                )
			            ),
			            REMOVEFILTERS ( 'T20 Local' ),
			            'T20 Local'[CodIBGE] = _cod
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 8452b92a-1943-5a1e-8060-70a4b6d7c214

	/// Locais de 2026 da cidade da tela sem coordenada no cadastro de locais do TSE (2022, por zona + número e, sem par, pelo nome): entram nas contas e na lista, ficam fora do mapa.
	measure 'T20 · locais sem endereço' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    COALESCE (
			        CALCULATE (
			            COUNTROWS ( 'T20 Local' ),
			            REMOVEFILTERS ( 'T20 Local' ),
			            'T20 Local'[CodIBGE] = _cod,
			            'T20 Local'[Fora do mapa] = "sem endereço"
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 60a30334-93b4-5f1b-ae0d-40e9f8297bed

	/// Id do local da ficha sem contar o clique no mapa ou na lista: o escolhido no filtro ou, sem ele, o exemplo da cidade. O mapa (que não enxerga o próprio clique) põe o nome dessa escola na camada da frente.
	measure 'T20 · local da ficha sem clique' =
			COALESCE ( [T20 · escola do filtro], [T20 · id do exemplo] )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: 63353e18-0538-5908-b62d-8ad1e48ea53b

	/// Nome do local da ficha (Id escolhido).
	measure 'T20 · local escolhido' =
			VAR _id = [T20 · id escolhido]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( 'T20 Local'[Nome] ), REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
		displayFolder: T20 Escola\Contas
		lineageTag: beaddb07-7150-5d05-8f0b-c8aa9c246286

	/// Votos de Lula ÷ válidos no local, 2026.
	measure 'T20 · Lula % 2026' =
			DIVIDE ( SUM ( 'T20 Local'[VotosPT2026] ), SUM ( 'T20 Local'[Validos2026] ) )
		formatString: 0.0%
		displayFolder: T20 Escola\Contas
		lineageTag: 6f7e1b72-2aee-566d-b2e9-ea91a2836ab9

	/// Maior número de votos válidos entre os locais da cidade da tela (escala do tamanho dos pontos; ignora a escolha de local).
	measure 'T20 · maior válidos' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    CALCULATE ( MAX ( 'T20 Local'[Validos2026] ), REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[CodIBGE] = _cod )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 740c4ec1-4007-5639-ab90-bf4461bbb691

	/// Margem do PT no local em 2018: (votos do PT − votos do adversário) ÷ válidos; em 2022 e 2018, os votos do mesmo zona + número. Vazio quando o local não existia.
	measure 'T20 · margem 2018' =
			DIVIDE (
			    SUM ( 'T20 Local'[VotosPT2018] ) - SUM ( 'T20 Local'[VotosAdv2018] ),
			    SUM ( 'T20 Local'[Validos2018] )
			)
		formatString: 0.0%
		displayFolder: T20 Escola\Contas
		lineageTag: c30d3e9f-dccb-5872-8363-82f2244ddc67

	/// Margem do PT no local em 2022: (votos do PT − votos do adversário) ÷ válidos; em 2022 e 2018, os votos do mesmo zona + número. Vazio quando o local não existia.
	measure 'T20 · margem 2022' =
			DIVIDE (
			    SUM ( 'T20 Local'[VotosPT2022] ) - SUM ( 'T20 Local'[VotosAdv2022] ),
			    SUM ( 'T20 Local'[Validos2022] )
			)
		formatString: 0.0%
		displayFolder: T20 Escola\Contas
		lineageTag: d703557e-b36e-5578-9950-bb669cdf7526

	/// Margem do PT no local em 2026: (votos do PT − votos do adversário) ÷ válidos; em 2022 e 2018, os votos do mesmo zona + número. Vazio quando o local não existia.
	measure 'T20 · margem 2026' =
			DIVIDE (
			    SUM ( 'T20 Local'[VotosPT2026] ) - SUM ( 'T20 Local'[VotosAdv2026] ),
			    SUM ( 'T20 Local'[Validos2026] )
			)
		formatString: 0.0%
		displayFolder: T20 Escola\Contas
		lineageTag: 8dd8503b-3187-599a-8e9d-1ecfb82fb77e

	/// 1 quando o local da linha é da cidade da tela: o mapa e a lista só desenham esses.
	measure 'T20 · na cidade' =
			IF ( SELECTEDVALUE ( 'T20 Local'[CodIBGE] ) = [T20 · cidade (código)], 1, 0 )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: 2b8fc13d-3cf3-5c9c-9074-ba7c9b620d26

	/// Nome legível do local (escola).
	measure 'T20 · nome do local' =
			SELECTEDVALUE ( 'T20 Local'[Nome] )
		displayFolder: T20 Escola\Contas
		lineageTag: 8d1eedad-239a-5a3a-83ae-60526e4b20a9

	/// Posição do local na lista da cidade, da maior queda da margem de Lula 2022 → 2026 à maior alta, com os locais novos (sem 2022) no fim, por nome; calculada no pipeline por cidade (pipeline/exportar_t20.py), o que poupa um RANKX por linha nas 2.060 de São Paulo.
	measure 'T20 · posição na queda' =
			SELECTEDVALUE ( 'T20 Local'[PosQueda] )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: a6d68a8b-39c1-5486-af73-f47f92906263

	/// Posição horizontal do local no mapa (% da largura); vazio sem coordenada.
	measure 'T20 · posição x' =
			SELECTEDVALUE ( 'T20 Local'[PX] )
		formatString: 0.00
		displayFolder: T20 Escola\Contas
		lineageTag: af5b3a36-a8d1-5c08-979e-6cf452c9c781

	/// Posição vertical do local no mapa (% da altura); vazio sem coordenada.
	measure 'T20 · posição y' =
			SELECTEDVALUE ( 'T20 Local'[PY] )
		formatString: 0.00
		displayFolder: T20 Escola\Contas
		lineageTag: beea18de-4eb4-5b22-b22c-facf922b02a3

	/// A variação com o sinal trocado (quanto a margem de Lula caiu): ordena a lista dos locais, da maior queda à maior alta.
	measure 'T20 · queda da margem' =
			- [T20 · variação da margem]
		formatString: 0.0%
		displayFolder: T20 Escola\Contas
		lineageTag: 3240c967-8736-5df2-a902-8f56ad4fcd69

	/// Seções eleitorais no local em 2026.
	measure 'T20 · seções' =
			SUM ( 'T20 Local'[Seções] )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: 4d588015-d40b-5ff3-ab5c-446bdd809b70

	/// Quanto a margem do PT no local mudou de 2022 para 2026 (pontos); vazio sem 2022.
	measure 'T20 · variação da margem' =
			VAR _m22 = [T20 · margem 2022]
			VAR _m26 = [T20 · margem 2026]
			RETURN
			    IF ( NOT ISBLANK ( _m22 ) && NOT ISBLANK ( _m26 ), _m26 - _m22 )
		formatString: 0.0%
		displayFolder: T20 Escola\Contas
		lineageTag: f1f7d5f4-e20c-5b18-81d1-32b74d7ce1e8

	/// 1 quando Lula estava à frente no local em 2022 e Flávio em 2026.
	measure 'T20 · virou' =
			VAR _m22 = [T20 · margem 2022]
			VAR _m26 = [T20 · margem 2026]
			RETURN
			    IF ( _m22 > 0 && _m26 < 0, 1, 0 )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: 62777fab-ab4b-59f6-84fd-884aad0b4d8a

	/// 1 quando Jair Bolsonaro estava à frente no local em 2022 e Lula em 2026 (o caminho inverso de [T20 · virou]).
	measure 'T20 · virou para Lula' =
			VAR _m22 = [T20 · margem 2022]
			VAR _m26 = [T20 · margem 2026]
			RETURN
			    IF ( _m22 < 0 && _m26 > 0, 1, 0 )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: 6b045c79-a3ca-5ad9-8179-70a3da27f8e0

	/// Votos válidos no local em 2026 (dá o tamanho do ponto no mapa).
	measure 'T20 · válidos 2026' =
			SUM ( 'T20 Local'[Validos2026] )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: cf6796d0-cffa-565c-86e9-df511af6b052

	/// Id do último local da cidade da tela no mapa: o ponto que leva os rótulos de bairro (o último a ser desenhado fica por cima).
	measure 'T20 · último local do mapa' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    CALCULATE (
			        MAX ( 'T20 Local'[Id] ),
			        REMOVEFILTERS ( 'T20 Local' ),
			        'T20 Local'[CodIBGE] = _cod,
			        NOT ISBLANK ( 'T20 Local'[PX] )
			    )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: c30621b1-ef44-5239-b724-bab206cb1e76

	/// Texto alternativo do cartão 'como explorar'.
	measure 'T20 · Como · ALT' =
			"Como explorar: passe o mouse num ponto para ver a zona; clique num ponto ou numa linha para levá-la à ficha; o filtro do topo troca a cidade e procura a zona. "
			    & IF ( [T20 · locais sem endereço] + [T20 · locais fora do recorte] > 0,
			        FORMAT ( [T20 · locais sem endereço] + [T20 · locais fora do recorte], "#,0" ) & " zonas não aparecem no mapa.", "" )
		displayFolder: T20 Escola\Desenho
		lineageTag: 509b4caf-a673-5691-8ddc-f68b05320395

	/// O aviso do cartão 'como explorar', por cidade: quantos locais não aparecem no mapa (sem endereço no cadastro do TSE ou fora do recorte da mancha urbana) e que eles entram nas contas e na lista.
	measure 'T20 · Como · HTML' =
			-- 1 · Leituras
			VAR _sem = [T20 · locais sem endereço]
			VAR _fora = [T20 · locais fora do recorte]
			-- 2 · Textos
			VAR _txtSem = FORMAT ( _sem, "#,0" ) & IF ( _sem = 1, " zona sem endereço", " zonas sem endereço" )
			VAR _txtFora = FORMAT ( _fora, "#,0" ) & IF ( _fora = 1, " zona fora do recorte", " zonas fora do recorte" )
			VAR _quem =
			    SWITCH (
			        TRUE (),
			        _sem > 0 && _fora > 0, _txtSem & " e " & FORMAT ( _fora, "#,0" ) & " fora do recorte não aparecem no mapa",
			        _sem > 0, _txtSem & IF ( _sem = 1, " não aparece no mapa", " não aparecem no mapa" ),
			        _fora > 0, _txtFora & IF ( _fora = 1, " não aparece no mapa", " não aparecem no mapa" )
			    )
			VAR _nota =
			    IF (
			        _sem + _fora > 0,
			        _quem & IF ( _sem + _fora = 1, ", mas entra nas contas e na lista.", ", mas entram nas contas e na lista." ),
			        "Todas as zonas da cidade estão no mapa."
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t20n'><div class='nota entra d6'>" & _nota & "</div></div>"
		displayFolder: T20 Escola\Desenho
		lineageTag: 3d8d6f05-7a95-5f14-abf5-b99079e4c242

	/// Texto alternativo do anel do local escolhido.
	measure 'T20 · Escolhido · ALT' =
			"Mapa de " & [T20 · cidade] & "; zona em destaque: " & [T20 · local escolhido]
		displayFolder: T20 Escola\Desenho
		lineageTag: fa071ec2-b80d-586a-9b83-39955d17f13f

	/// A camada atrás dos pontos: o contorno da cidade escolhida (rabisco que se desenha, o creme esmaece), o mapinha da cidade inteira quando o mapa é um recorte e o anel à mão em volta do local da ficha (recebe a escolha do filtro, do mapa e da lista); o nome vai ao lado só quando a escola veio de um clique (com clique, os outros pontos esmaecem e o nome aparece; sem clique, o nome vai na camada da frente, em T20 · Mapa · HTML).
	measure 'T20 · Escolhido · HTML' =
			-- 1 · Leituras
			VAR _contorno = [T20 · cidade · contorno]
			VAR _recorte = [T20 · cidade · recorte]
			VAR _mapinha = [T20 · cidade · mapinha]
			VAR _moldura = SUBSTITUTE ( [T20 · cidade · moldura do mapinha], " ", "|" )
			VAR _canto = [T20 · cidade · canto do mapinha]
			VAR _id = [T20 · id escolhido]
			VAR _px = CALCULATE ( [T20 · posição x], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _py = CALCULATE ( [T20 · posição y], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _fora = CALCULATE ( [T20 · fora do mapa], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _clique = NOT ISBLANK ( [T20 · escola clicada] )
			-- 2 · Textos
			VAR _nome0 = [T20 · local escolhido]
			VAR _nome1 = SUBSTITUTE ( SUBSTITUTE ( _nome0, "&", "&amp;" ), "<", "&lt;" )
			VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome1, ">", "&gt;" ), "'", "&#39;" )
			VAR _motivo = IF ( _fora = "fora do recorte", ": fora do recorte do mapa", ": sem endereço no mapa" )
			-- 3 · Geometria
			VAR _x = _px / 100 * 692 -- geometria
			VAR _y = _py / 100 * 860 -- geometria
			VAR _direita = _x > 692 * 0.62 -- geometria
			VAR _xr = IF ( _direita, _x - 22, _x + 22 ) -- geometria
			VAR _mx = IF ( _canto = "so" || _canto = "no", 10, 550 ) -- geometria
			VAR _my = IF ( _canto = "no" || _canto = "ne", 10, 682 ) -- geometria
			-- 4 · Marcação
			VAR _mapa =
			    "<svg class='mapa" & IF ( _recorte = 1, " rec", "" ) & "' width='692' height='860' viewBox='0 0 100 100' "
			        & "preserveAspectRatio='none'>"
			        & "<path class='fundo' d='" & _contorno & "'/>"
			        & "<path class='borda traco' pathLength='1' filter='url(#rb20)' d='" & _contorno & "'/>"
			        & IF ( _recorte = 1, "<rect class='quadro' x='0' y='0' width='100' height='100'/>" )
			    & "</svg>"
			VAR _mini =
			    IF (
			        _recorte = 1,
			        "<div class='mini entra d8' style='left:" & _mx & "px;top:" & _my & "px'>"
			            & "<svg width='132' height='132' viewBox='0 0 100 100'><path class='mf' d='" & _mapinha & "'/>"
			            & "<rect class='mr' x='" & PATHITEM ( _moldura, 1 ) & "' y='" & PATHITEM ( _moldura, 2 ) & "' width='"
			            & PATHITEM ( _moldura, 3 ) & "' height='" & PATHITEM ( _moldura, 4 ) & "'/></svg>"
			            & "<span>a cidade inteira</span>"
			        & "</div>"
			    )
			VAR _anel =
			    IF (
			        ISBLANK ( _px ),
			        "<div class='sem'>" & _nome & _motivo & "</div>",
			        "<div class='anel' style='left:" & FORMAT ( _x - 26, "0.0##", "en-US" ) & "px;top:"
			            & FORMAT ( _y - 24, "0.0##", "en-US" ) & "px'>"
			            & "<svg width='52' height='48' viewBox='0 0 52 48'><path class='traco' pathLength='1' filter='url(#rbe)' "
			            & "d='M8,28 C2,10 30,-2 44,10 C54,20 46,42 26,44 C8,46 2,30 12,16 C18,8 30,6 38,9'/></svg></div>"
			            & IF (
			                _clique,
			                "<div class='nome sobe d4" & IF ( _direita, " dir", "" ) & "' style='left:"
			                    & FORMAT ( _xr, "0.0##", "en-US" ) & "px;top:" & FORMAT ( _y - 12, "0.0##", "en-US" ) & "px'>"
			                    & _nome & "</div>"
			            )
			    )
			RETURN
			    "<div class='tela t20e'>" & _mapa & _mini & _anel & "</div>"
		displayFolder: T20 Escola\Desenho
		lineageTag: 234cc51b-20aa-53eb-9125-6d325eed1cfc

	/// Texto alternativo da ficha do local.
	measure 'T20 · Ficha · ALT' =
			-- 1 · Leituras
			VAR _id = [T20 · id escolhido]
			VAR _m18 = CALCULATE ( [T20 · margem 2018], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _m22 = CALCULATE ( [T20 · margem 2022], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _m26 = CALCULATE ( [T20 · margem 2026], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			-- 2 · Textos
			VAR _t18 = IF ( ISBLANK ( _m18 ), "sem dado", FORMAT ( _m18 * 100, "+0.0;−0.0;0.0" ) )
			VAR _t22 = IF ( ISBLANK ( _m22 ), "sem dado", FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" ) )
			RETURN
			    "Ficha: " & [T20 · local escolhido] & " (" & [T20 · cidade] & "). Margem do PT em pontos (Haddad em 2018, Lula em 2022 e 2026): 2018 " & _t18
			        & "; 2022 " & _t22 & "; 2026 " & FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" ) & "."
		displayFolder: T20 Escola\Desenho
		lineageTag: d7e95492-c879-524c-be08-21c5b5ddc05c

	/// A ficha do local escolhido (post-it com alfinete): bairro, seções e válidos, Lula × Flávio em 2026 e a margem do PT em 2018 → 2022 → 2026 (Haddad em 2018), com o selo de quem virou. Sem escolha, o exemplo da cidade: em todas, a escola que virou com mais votos válidos (ou a de maior queda).
	measure 'T20 · Ficha · HTML' =
			-- 1 · Leituras
			VAR _id = [T20 · id escolhido]
			VAR _ha = [T20 · há escolha]
			VAR _exemplo = [T20 · exemplo]
			VAR _bairroL = CALCULATE ( [T20 · bairro], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _secoes = CALCULATE ( [T20 · seções], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _val = CALCULATE ( [T20 · válidos 2026], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _lula = CALCULATE ( [T20 · Lula % 2026], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _flavio = CALCULATE ( [T20 · Flávio % 2026], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _m18 = CALCULATE ( [T20 · margem 2018], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _m22 = CALCULATE ( [T20 · margem 2022], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _m26 = CALCULATE ( [T20 · margem 2026], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _virou = CALCULATE ( [T20 · virou], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			VAR _virouLula = CALCULATE ( [T20 · virou para Lula], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
			-- 2 · Textos
			VAR _nome0 = [T20 · local escolhido]
			VAR _nome1 = SUBSTITUTE ( SUBSTITUTE ( _nome0, "&", "&amp;" ), "<", "&lt;" )
			VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome1, ">", "&gt;" ), "'", "&#39;" )
			VAR _bairro0 = _bairroL
			VAR _bairro1 = SUBSTITUTE ( SUBSTITUTE ( _bairro0, "&", "&amp;" ), "<", "&lt;" )
			VAR _bairro = SUBSTITUTE ( SUBSTITUTE ( _bairro1, ">", "&gt;" ), "'", "&#39;" )
			VAR _cidade0 = [T20 · cidade (nome)]
			VAR _cidade1 = SUBSTITUTE ( SUBSTITUTE ( _cidade0, "&", "&amp;" ), "<", "&lt;" )
			VAR _cidade = SUBSTITUTE ( SUBSTITUTE ( _cidade1, ">", "&gt;" ), "'", "&#39;" )
			VAR _sobre = IF ( _ha = 1, "A zona escolhida", "Um exemplo · " & _cidade )
			-- a zona: quantos locais de votação (a coluna Bairro), seções e válidos de 2026, numa linha só
			VAR _sub =
			    IF ( _bairro <> "", _bairro & " · ", "" ) & _secoes & IF ( _secoes = 1, " seção · ", " seções · " )
			        & FORMAT ( _val, "#,0" ) & " válidos"
			VAR _t18 = IF ( ISBLANK ( _m18 ), "—", FORMAT ( _m18 * 100, "+0.0;−0.0;0.0" ) )
			VAR _t22 = IF ( ISBLANK ( _m22 ), "—", FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" ) )
			VAR _t26 = FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" )
			VAR _c18 = IF ( _m18 > 0, "lula", IF ( _m18 < 0, "flavio", "" ) )
			VAR _c22 = IF ( _m22 > 0, "lula", IF ( _m22 < 0, "flavio", "" ) )
			VAR _c26 = IF ( _m26 > 0, "lula", IF ( _m26 < 0, "flavio", "" ) )
			VAR _nota =
			    SWITCH (
			        TRUE (),
			        _ha = 0 && _exemplo = "virou", "a maior zona que virou",
			        _ha = 0, "a maior queda da cidade",
			        _virou = 1, "virou para Flávio",
			        _virouLula = 1, "virou para Lula",
			        _m26 > 0, "Lula à frente",
			        _m26 < 0, "Flávio à frente",
			        "empate"
			    )
			VAR _selo = IF ( _virou + _virouLula = 1, "<div class='selo'>virou</div>", "" )
			-- 3 · Geometria
			VAR _base = { ( 0, 70, _m18 ), ( 1, 230, _m22 ), ( 2, 390, _m26 ) } /* lista */
			VAR _yy =
			    SELECTCOLUMNS (
			        FILTER ( _base, NOT ISBLANK ( [Value3] ) ) /* lista */,
			        "i", [Value1], "x", [Value2], "y", 34 - MAX ( -0.3, MIN ( 0.3, [Value3] ) ) / 0.3 * 28
			    ) -- geometria
			VAR _primeiro = MINX ( _yy, [i] ) /* lista */
			VAR _d =
			    CONCATENATEX (
			        _yy, IF ( [i] = _primeiro, "M", "L" ) & [x] & "," & FORMAT ( [y], "0.0##", "en-US" ), " ", [i], ASC
			    ) /* lista */
			VAR _bolas =
			    CONCATENATEX (
			        _yy,
			        "<circle cx='" & [x] & "' cy='" & FORMAT ( [y], "0.0##", "en-US" ) & "' r='5'/>",
			        "",
			        [i], ASC
			    ) /* lista */
			-- 4 · Marcação
			RETURN
			    "<div class='tela t20f'><div class='fl'>"
			        & "<div class='rot sobe'>" & _sobre & "</div>"
			        & "<div class='nm sobe d1'>" & _nome & "</div>"
			        & "<div class='sub sobe d2'>" & _sub & "</div>"
			        & "<div class='duelo sobe d3'>"
			            & "<div class='lado lula'><span class='num'>" & FORMAT ( _lula, "0.0%" ) & "</span><span class='r'>Lula</span></div>"
			            & "<div class='lado flavio'><span class='num'>" & FORMAT ( _flavio, "0.0%" ) & "</span><span class='r'>Flávio</span></div>"
			            & _selo
			        & "</div>"
			        & "<div class='rot cap sobe d4'>Margem do PT, em pontos</div>"
			        & "<div class='serie sobe d5'>"
			            & "<div class='c c0'><span class='a'>2018</span><span class='num " & _c18 & "'>" & _t18 & "</span></div>"
			            & "<div class='c c1'><span class='a'>2022</span><span class='num " & _c22 & "'>" & _t22 & "</span></div>"
			            & "<div class='c c2'><span class='a'>2026</span><span class='num " & _c26 & "'>" & _t26 & "</span></div>"
			            & "<svg class='linha' width='460' height='70' viewBox='0 0 460 70'>"
			                & "<line class='zero' x1='20' x2='440' y1='34' y2='34'/>"
			                & "<path class='traco' pathLength='1' d='" & _d & "'/>" & _bolas
			            & "</svg>"
			        & "</div>"
			        & "</div>"
			        & "<div class='mao'>" & _nota & "</div>"
			    & "</div>"
		displayFolder: T20 Escola\Desenho
		lineageTag: a5c52298-5a39-543d-86ba-3a3d554519d6

	/// Texto alternativo do filtro da tela (o VizuFilter em árvore, com o gatilho dele; sem pílula desde 24/10/2026): a cidade e a escola em uso.
	measure 'T20 · Filtro · ALT' =
			-- 1 · Leituras
			VAR _escola = [T20 · escola do filtro]
			VAR _marcadas = [T20 · escolas no filtro]
			VAR _locais = [T20 · locais]
			VAR _id = _escola
			RETURN
			    "Filtro de cidade e zona: " & [T20 · cidade]
			        & SWITCH (
			            TRUE (),
			            NOT ISBLANK ( _escola ), " · " & CALCULATE ( [T20 · nome do local], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id ),
			            _marcadas > 1 && _marcadas < _locais, " · " & FORMAT ( _marcadas, "#,0" ) & " zonas marcadas",
			            " (nenhuma zona escolhida)"
			        )
		displayFolder: T20 Escola\Desenho
		lineageTag: a4a2825d-700a-526f-a110-2f7eaa2152a9

	/// Texto alternativo do mapa das zonas eleitorais.
	measure 'T20 · Mapa · ALT' =
			-- 1 · Leituras
			VAR _n = [T20 · locais]
			VAR _lula = [T20 · locais com Lula à frente]
			VAR _fora = [T20 · locais sem endereço] + [T20 · locais fora do recorte]
			RETURN
			    "Mapa de " & [T20 · cidade] & " com " & FORMAT ( _n - _fora, "#,0" ) & " das " & FORMAT ( _n, "#,0" )
			        & " zonas eleitorais: " & FORMAT ( _lula, "#,0" ) & " com Lula à frente (vermelho) e as outras com Flávio "
			        & "(azul). Passe o mouse num ponto para ver a zona; clique para pôr na ficha."
		displayFolder: T20 Escola\Desenho
		lineageTag: aa1ebfe6-813c-53ff-9078-a8577df80ed2

	/// Um ponto do mapa da cidade escolhida (granularidade: T20 Local[Local]; local de outra cidade ou sem posição devolve vazio): posição PX/PY em % da moldura, tamanho pelos votos válidos e pelo espaço entre locais da cidade (São Paulo não vira mancha), cor pela margem de 2026; brota em onda do oeste para o leste. O último local da cidade no mapa leva também os rótulos de bairro, e o local da ficha sem clique (a escola do filtro ou o exemplo) leva o nome dele, numa camada por cima dos pontos (z-index na entrada: não depende da ordem em que o visual entrega as linhas; em São Paulo o nome atrás dos pontos sumia).
	measure 'T20 · Mapa · HTML' =
			-- 1 · Leituras
			VAR _na = [T20 · na cidade]
			VAR _px = [T20 · posição x]
			VAR _py = [T20 · posição y]
			VAR _val = [T20 · válidos 2026]
			VAR _maior = [T20 · maior válidos]
			VAR _m26 = [T20 · margem 2026]
			VAR _espaco = [T20 · cidade · espaço entre locais]
			VAR _id = [T20 · id do local]
			VAR _ultimo = [T20 · último local do mapa] = _id
			VAR _bairros = IF ( _ultimo, [T20 · cidade · bairros] )
			VAR _alvo = [T20 · local da ficha sem clique] = _id
			-- 2 · Textos
			VAR _nome0 = IF ( _alvo, [T20 · nome do local] )
			VAR _nome1 = SUBSTITUTE ( SUBSTITUTE ( _nome0, "&", "&amp;" ), "<", "&lt;" )
			VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome1, ">", "&gt;" ), "'", "&#39;" )
			VAR _cor =
			    SWITCH (
			        TRUE (),
			        _m26 < -0.2, "#1D3C6E",
			        _m26 < -0.1, "#2B5797",
			        _m26 < -0.03, "#6F8DBE",
			        _m26 < 0.0, "#A9B8CF",
			        _m26 < 0.03, "#E2B3A9",
			        _m26 < 0.1, "#D9877B",
			        _m26 < 0.2, "#B8322A",
			        "#8E2620"
			    )
			VAR _rotulos =
			    IF (
			        _ultimo && NOT ISBLANK ( _bairros ) && _bairros <> "",
			        CONCATENATEX (
			            GENERATESERIES ( 1, PATHLENGTH ( _bairros ) ),
			            VAR _item = SUBSTITUTE ( PATHITEM ( _bairros, [Value] ), "@", "|" )
			            VAR _nome0 = PATHITEM ( _item, 1 )
			            VAR _nome = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome0, "&", "&amp;" ), "<", "&lt;" ), "'", "&#39;" )
			            RETURN
			                "<span class='bairro entra d" & ( 10 + [Value] ) & "' style='left:" & PATHITEM ( _item, 2 ) & "%;top:"
			                    & PATHITEM ( _item, 3 ) & "%'>" & _nome & "</span>",
			            "",
			            [Value], ASC
			        ) /* lista */
			    )
			-- 3 · Geometria (diâmetro: o maior ponto ocupa ~2,2 vezes o espaço típico entre vizinhos, de 4,5 a 16 px: raio de
			-- até 8 px, para o ponto grande não pesar nas cidades de pouca escola)
			VAR _dmax = MIN ( 16, MAX ( 4.5, 2.2 * _espaco / 100 * 692 ) ) -- geometria
			VAR _dmin = MAX ( 2.5, _dmax * 0.35 ) -- geometria
			VAR _d = _dmin + ( _dmax - _dmin ) * SQRT ( DIVIDE ( _val, _maior ) ) -- geometria
			VAR _borda = MIN ( 1.2, _d / 6 ) -- geometria
			VAR _x = _px / 100 * 692 - _d / 2 -- geometria
			VAR _y = _py / 100 * 860 - _d / 2 -- geometria
			VAR _atraso = 1700 + ROUND ( _px * 14, 0 ) -- geometria
			VAR _cx = _px / 100 * 692 -- geometria
			VAR _direita = _cx > 692 * 0.62 -- geometria
			VAR _xr = IF ( _direita, _cx - 22, _cx + 22 ) -- geometria
			-- 4 · Marcação
			VAR _rotuloEscola =
			    IF (
			        _alvo,
			        "<div class='nome sobe d4" & IF ( _direita, " dir", "" ) & "' style='left:" & FORMAT ( _xr, "0.0##", "en-US" )
			            & "px;top:" & FORMAT ( _py / 100 * 860 - 12, "0.0##", "en-US" ) & "px'>" & _nome & "</div>"
			    )
			RETURN
			    IF (
			        _na = 1 && NOT ISBLANK ( _px ),
			        "<div class='tela t20p" & IF ( _ultimo || _alvo, " topo", "" ) & "'><i class='pt' style='left:"
			            & FORMAT ( _x, "0.0##", "en-US" ) & "px;top:"
			            & FORMAT ( _y, "0.0##", "en-US" ) & "px;width:" & FORMAT ( _d, "0.0##", "en-US" ) & "px;height:"
			            & FORMAT ( _d, "0.0##", "en-US" ) & "px;border-width:" & FORMAT ( _borda, "0.0##", "en-US" )
			            & "px;background:" & _cor & ";animation-delay:" & _atraso & "ms'></i>"
			            & _rotulos & _rotuloEscola
			        & "</div>"
			    )
		displayFolder: T20 Escola\Desenho
		lineageTag: 4b63704c-6bdd-5710-b0d6-7eaa640a9255

	/// Texto alternativo da lista dos locais pela queda.
	measure 'T20 · Quedas · ALT' =
			"Os " & FORMAT ( [T20 · locais], "#,0" ) & " zonas eleitorais de " & [T20 · cidade]
			    & ", da maior queda à maior alta da margem de Lula de 2022 para 2026; a lista rola. Clique numa linha para pôr a zona na ficha."
		displayFolder: T20 Escola\Desenho
		lineageTag: 8d3a2f9d-5e51-5e84-ab67-c6e5da56f7f8

	/// Uma linha da lista de todos os locais da cidade escolhida, da maior queda à maior alta da margem de Lula, 2022 → 2026 (granularidade T20 Local[Local]; local de outra cidade devolve vazio): posição, nome, bairro e seções, a variação (ou 'novo', sem 2022) e o selo de quem virou. A ordem vem da posição (order no CSS, com quatro dígitos: a lista não depende da ordem em que o visual entrega as linhas) e a lista rola dentro da caixa.
	measure 'T20 · Quedas · HTML' =
			-- 1 · Leituras
			VAR _na = [T20 · na cidade]
			VAR _pos = [T20 · posição na queda]
			VAR _bairroL = [T20 · bairro]
			VAR _secoes = [T20 · seções]
			VAR _var = [T20 · variação da margem]
			VAR _virou = [T20 · virou] + [T20 · virou para Lula]
			-- 2 · Textos
			VAR _nome0 = [T20 · nome do local]
			VAR _nome1 = SUBSTITUTE ( SUBSTITUTE ( _nome0, "&", "&amp;" ), "<", "&lt;" )
			VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome1, ">", "&gt;" ), "'", "&#39;" )
			VAR _bairro0 = _bairroL
			VAR _bairro1 = SUBSTITUTE ( SUBSTITUTE ( _bairro0, "&", "&amp;" ), "<", "&lt;" )
			VAR _bairro = SUBSTITUTE ( SUBSTITUTE ( _bairro1, ">", "&gt;" ), "'", "&#39;" )
			VAR _txtVar = IF ( ISBLANK ( _var ), "novo", FORMAT ( _var * 100, "+0.0;−0.0;0.0" ) & " p.p." )
			VAR _sub =
			    IF ( _bairro <> "", _bairro & " · ", "" ) & _secoes & IF ( _secoes = 1, " seção", " seções" )
			VAR _selo = IF ( _virou = 1, "<span class='selo'>virou</span>", "" )
			VAR _cor = IF ( ISBLANK ( _var ), "novo", IF ( _var < 0, "flavio", "lula" ) )
			-- 3 · Geometria (a ordem na lista e a cascata de entrada das primeiras linhas)
			VAR _ordem = FORMAT ( _pos, "0000" ) -- geometria
			VAR _d = MIN ( _pos + 2, 12 ) -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _na = 1 && NOT ISBLANK ( _pos ),
			        "<div class='t20q' style='order:" & _ordem & "'><div class='ln sobe d" & _d & "' data-p='" & _pos & "'>"
			            & "<span class='p'>" & _pos & "</span>"
			            & "<span class='dir'><span class='v " & _cor & " tnum'>" & _txtVar & "</span></span>"
			            & "<span class='nm'>" & _nome & "</span>"
			            & "<span class='sb'><span class='bt'>" & _sub & "</span>" & _selo & "</span>"
			        & "</div></div>"
			    )
		displayFolder: T20 Escola\Desenho
		lineageTag: 34316919-fc75-5242-857e-e957874201df

	/// Texto alternativo da resposta da tela 20.
	measure 'T20 · Resposta · ALT' =
			-- 1 · Leituras
			VAR _lula = [T20 · locais com Lula à frente]
			VAR _n = [T20 · locais]
			VAR _lula22 = [T20 · locais com Lula à frente em 2022]
			VAR _n22 = [T20 · locais em 2022]
			VAR _viraram = [T20 · locais que viraram]
			VAR _paraLula = [T20 · locais que viraram para Lula]
			RETURN
			    [T20 · cidade] & ": Lula ficou à frente em " & FORMAT ( _lula, "#,0" ) & " das " & FORMAT ( _n, "#,0" )
			        & " zonas eleitorais em 2026; em 2022, em " & FORMAT ( _lula22, "#,0" ) & " das " & FORMAT ( _n22, "#,0" )
			        & ". " & FORMAT ( _viraram, "#,0" ) & IF ( _viraram = 1, " zona virou", " zonas viraram" )
			        & " de Lula para Flávio e " & FORMAT ( _paraLula, "#,0" ) & " de Flávio para Lula."
		displayFolder: T20 Escola\Desenho
		lineageTag: 17adf2d2-f94d-59fd-a6b4-ed407fc2b7c1

	/// A resposta da tela na cidade escolhida: '12 de 112' locais de votação com Lula à frente em 2026 (contador), quantos eram em 2022 e quantos viraram, nos dois sentidos.
	measure 'T20 · Resposta · HTML' =
			-- 1 · Leituras
			VAR _lula = [T20 · locais com Lula à frente]
			VAR _n = [T20 · locais]
			VAR _lula22 = [T20 · locais com Lula à frente em 2022]
			VAR _n22 = [T20 · locais em 2022]
			VAR _viraram = [T20 · locais que viraram]
			VAR _paraLula = [T20 · locais que viraram para Lula]
			-- 2 · Textos
			VAR _cidade0 = [T20 · cidade]
			VAR _cidade1 = SUBSTITUTE ( SUBSTITUTE ( _cidade0, "&", "&amp;" ), "<", "&lt;" )
			VAR _cidade = SUBSTITUTE ( SUBSTITUTE ( _cidade1, ">", "&gt;" ), "'", "&#39;" )
			VAR _rotLocal = IF ( _lula = 1, "zona eleitoral com Lula à frente em 2026", "zonas eleitorais com Lula à frente em 2026" )
			VAR _antes =
			    SWITCH (
			        TRUE (),
			        _lula22 = 0 && _lula = 0, "Em 2022, também nenhuma",
			        _lula22 = 0, "Em 2022, nenhuma",
			        _lula22 = 1, "Em 2022, <span class='num'>1</span>",
			        "Em 2022, eram <span class='num'>" & FORMAT ( _lula22, "#,0" ) & "</span>"
			    ) & IF ( _n22 = 1, " na única zona.", " das " & FORMAT ( _n22, "#,0" ) & " zonas." )
			VAR _txtViraram =
			    SWITCH (
			        TRUE (),
			        -- sem virada nos dois sentidos, a frase fala dos dois (revisão do vídeo, 24/10/2026)
			        _viraram = 0 && _paraLula = 0, "Nenhuma zona da cidade mudou de lado",
			        _viraram = 0, "Nenhuma zona virou de Lula para Flávio",
			        _viraram = 1, "1 zona virou de Lula para Flávio",
			        FORMAT ( _viraram, "#,0" ) & " zonas viraram de Lula para Flávio"
			    ) & SWITCH (
			        TRUE (),
			        _paraLula = 0, ".",
			        _paraLula = 1, "; 1 fez o caminho inverso.",
			        "; " & FORMAT ( _paraLula, "#,0" ) & " fizeram o caminho inverso."
			    )
			-- 3 · Geometria (com milhar, o número grande desce de 96 para 72 px e cabe na caixa)
			VAR _classe = IF ( _n >= 1000, "grande g4", "grande" ) -- geometria
			-- 4 · Marcação
			RETURN
			    "<div class='tela t20r'>"
			        & "<div class='rot cid sobe'>" & _cidade & "</div>"
			        & "<div class='" & _classe & " sobe d1'><span class='num'>" & FORMAT ( _lula, "#,0" ) & "</span> de "
			            & "<span class='num'>" & FORMAT ( _n, "#,0" ) & "</span></div>"
			        & "<div class='fluxo'>"
			            & "<div class='rotulo sobe d2'>" & _rotLocal & "</div>"
			            & "<div class='man sobe d3'>" & _antes & "</div>"
			            & "<div class='txt sobe d4'>" & _txtViraram & "</div>"
			        & "</div>"
			    & "</div>"
		displayFolder: T20 Escola\Desenho
		lineageTag: 352a859b-5127-539a-aa5b-067cc9bcdb70

	/// Texto alternativo do post-it do local.
	measure 'T20 · Tooltip escola · ALT' =
			-- 1 · Leituras
			VAR _nome = [T20 · nome do local]
			VAR _m22 = [T20 · margem 2022]
			VAR _m26 = [T20 · margem 2026]
			-- 2 · Textos
			VAR _t22 = IF ( ISBLANK ( _m22 ), "sem dado em 2022", FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" ) & " em 2022" )
			RETURN
			    IF ( NOT ISBLANK ( _nome ), _nome & ": margem de Lula " & _t22 & " e " & FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" ) & " em 2026." )
		displayFolder: T20 Escola\Desenho
		lineageTag: ac53ea94-7605-52cc-9eee-46293c309d4d

	/// Post-it do local sob o mouse (página de tooltip ttT20Escola): bairro, seções, Lula × Flávio em 2026 e a margem do PT em 2018 → 2022 → 2026 (Haddad em 2018).
	measure 'T20 · Tooltip escola · HTML' =
			-- 1 · Leituras
			VAR _bairroL = [T20 · bairro]
			VAR _secoes = [T20 · seções]
			VAR _val = [T20 · válidos 2026]
			VAR _lula = [T20 · Lula % 2026]
			VAR _flavio = [T20 · Flávio % 2026]
			VAR _m18 = [T20 · margem 2018]
			VAR _m22 = [T20 · margem 2022]
			VAR _m26 = [T20 · margem 2026]
			VAR _virou = [T20 · virou]
			VAR _virouLula = [T20 · virou para Lula]
			-- 2 · Textos
			VAR _nome0 = [T20 · nome do local]
			VAR _nome1 = SUBSTITUTE ( SUBSTITUTE ( _nome0, "&", "&amp;" ), "<", "&lt;" )
			VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome1, ">", "&gt;" ), "'", "&#39;" )
			VAR _bairro0 = _bairroL
			VAR _bairro1 = SUBSTITUTE ( SUBSTITUTE ( _bairro0, "&", "&amp;" ), "<", "&lt;" )
			VAR _bairro = SUBSTITUTE ( SUBSTITUTE ( _bairro1, ">", "&gt;" ), "'", "&#39;" )
			VAR _sub =
			    IF ( _bairro <> "", _bairro & " · ", "" ) & _secoes & IF ( _secoes = 1, " seção · ", " seções · " )
			        & FORMAT ( _val, "#,0" ) & " válidos"
			VAR _t18 = IF ( ISBLANK ( _m18 ), "—", FORMAT ( _m18 * 100, "+0.0;−0.0;0.0" ) )
			VAR _t22 = IF ( ISBLANK ( _m22 ), "—", FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" ) )
			VAR _t26 = FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" )
			VAR _nota =
			    SWITCH (
			        TRUE (),
			        _virou = 1, "virou para Flávio",
			        _virouLula = 1, "virou para Lula",
			        _m26 > 0, "Lula à frente",
			        _m26 < 0, "Flávio à frente",
			        "empate"
			    )
			VAR _selo = IF ( _virou + _virouLula = 1, "<div class='selo'>virou</div>", "" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _nome0 ),
			        "<div class='tela tt20'>"
			            & "<div class='nm'>" & _nome & "</div>"
			            & "<div class='sub'>" & _sub & "</div>"
			            & "<div class='duelo'><span class='lula'>Lula " & FORMAT ( _lula, "0.0%" ) & "</span>"
			            & "<span class='flavio'>Flávio " & FORMAT ( _flavio, "0.0%" ) & "</span></div>"
			            & "<div class='rot'>Margem do PT · 2018 → 2022 → 2026</div>"
			            & "<div class='serie tnum'>" & _t18 & " <i>→</i> " & _t22 & " <i>→</i> " & _t26 & " p.p.</div>"
			            & _selo
			            & "<div class='mao'>" & _nota & "</div>"
			        & "</div>"
			    )
		displayFolder: T20 Escola\Desenho
		lineageTag: 8156f200-0747-508c-a407-df93d0469436

	/// Principal adversário (o mais votado fora do PT) no ano do contexto.
	measure 'T21 · adversário' =
			SELECTEDVALUE ( 'Ano'[Adversário] )
