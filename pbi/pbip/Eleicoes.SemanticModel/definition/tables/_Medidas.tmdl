	/// O que as contas mostram: 'Brasil' sem estado no contexto; com estado (o filtro de estado em árvore, Região › Estado, ou o clique num quadrado do mapa), o nome comum do recorte [Recorte · nome] ('Bahia', 'Nordeste', 'MG e SP', '3 estados', 'Exterior'). Vazio quando o clique no mapa cai fora do filtro de estado (nenhuma UF no contexto; ver T18 · recorte vazio).
	measure 'Apuração · escopo' =
			VAR _ufs = COUNTROWS ( VALUES ( 'UF'[UF] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISFILTERED ( 'UF' ), "Brasil",
			        _ufs = 0, BLANK (),
			        [Recorte · nome]
			    )
		displayFolder: T18 Apuração\Contas
		lineageTag: ffe3f546-3263-5577-b165-bc42d9e2c4fd

	/// aguardando · apurando · definido · encerrada, na última coleta.
	measure 'Apuração · fase' =
			SELECTEDVALUE ( 'Apuração status'[Status] )
		displayFolder: T18 Apuração\Contas
		lineageTag: bd6ab43b-c655-5f76-9457-4942f07b051a

