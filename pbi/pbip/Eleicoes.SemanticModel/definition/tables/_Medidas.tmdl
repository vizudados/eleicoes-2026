	/// Data da pesquisa mais recente entre as últimas de cada instituto (a véspera do 1º turno, 03/10).
	measure 'T10 · véspera' =
			CALCULATE (
			    MAX ( Pesquisa[Divulgação] ),
			    REMOVEFILTERS ( Pesquisa ),
			    Pesquisa[Cenário] = "1º turno",
			    NOT ISBLANK ( Pesquisa[Lula] ),
