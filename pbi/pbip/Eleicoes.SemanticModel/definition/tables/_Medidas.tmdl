		displayFolder: T11 Virada\Contas
		lineageTag: 128f0571-591e-57fc-945c-c2466d8afb5a

	/// Votos do adversário (PL) sobre os válidos em 2026.
	measure 'T11 · PL % 2026' =
			DIVIDE ( [T11 · votos do PL 2026], [T11 · válidos 2026] )
