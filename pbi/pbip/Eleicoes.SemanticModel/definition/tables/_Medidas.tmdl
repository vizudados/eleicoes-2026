	/// Estado do cartão do contexto ('T26 Debate Globo'[Cartão]): aguardando, parcial, publicado, previa, consolidado (audiência), nao_divulgado, ou a situação do debate quando ele foi cancelado ou adiado. O valor no arquivo vence a coluna situação; as pesquisas contam pela tabela Pesquisa.
	measure 'T26 · cartão · estado' =
			VAR _c = SELECTEDVALUE ( 'T26 Debate Globo'[Cartão] )
			VAR _sit = [T26 · debate · situação]
			VAR _linhas = CALCULATE ( COUNTROWS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "metrica" )
			VAR _com = CALCULATE ( COUNTROWS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "metrica", NOT ISBLANK ( 'T26 Debate Globo'[Valor] ) )
			VAR _nd = CALCULATE ( COUNTROWS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "metrica", 'T26 Debate Globo'[Situação] = "nao_divulgado" )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _c ) || _c = "" || ISBLANK ( _linhas ), BLANK (),
			        _sit IN { "cancelado", "adiado" }, _sit,
			        _c = "pesquisas",
			            IF ( [T26 · pesquisas · depois · n] > 0, "publicado", IF ( _nd > 0, "nao_divulgado", "aguardando" ) ),
			        _c = "audiencia",
			            SWITCH (
			                TRUE (),
			                NOT ISBLANK ( [T26 · audiência · consolidado] ), "consolidado",
			                NOT ISBLANK ( [T26 · audiência · prévia] ), "previa",
			                _nd >= _linhas, "nao_divulgado",
			                "aguardando"
			            ),
			        _com >= _linhas, "publicado",
			        _com > 0, "parcial",
			        _nd > 0, "nao_divulgado",
			        "aguardando"
			    )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: e8fd09f9-dba9-5cfa-bd44-83b437df012a

	/// Menor Ordem das linhas do cartão do contexto.
	measure 'T26 · cartão · ordem' =
			CALCULATE ( MIN ( 'T26 Debate Globo'[Ordem] ), 'T26 Debate Globo'[Grupo] = "metrica" )
		formatString: 0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 28413372-4419-51fe-b12b-161e8502a928

	/// Posição do cartão do contexto na fita (1 = o primeiro a chegar), pela Ordem.
	measure 'T26 · cartão · posição' =
			VAR _o = [T26 · cartão · ordem]
			VAR _todos =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( 'T26 Debate Globo'[Cartão] ), "@o", CALCULATE ( MIN ( 'T26 Debate Globo'[Ordem] ) ) ),
			        REMOVEFILTERS ( 'T26 Debate Globo' ),
			        'T26 Debate Globo'[Grupo] = "metrica"
			    )
			RETURN
			    IF ( NOT ISBLANK ( _o ), COUNTROWS ( FILTER ( _todos, [@o] <= _o ) ) )
		formatString: 0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: f4d07527-b37d-5b69-b7ef-b52557585f3d

	/// Quantos cartões já têm o número (publicado, prévia ou consolidado).
	measure 'T26 · cartões · chegaram' =
			COUNTROWS (
			    FILTER (
			        CALCULATETABLE ( VALUES ( 'T26 Debate Globo'[Cartão] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "metrica" ),
			        CALCULATE ( [T26 · cartão · estado] ) IN { "publicado", "previa", "consolidado" }
			    )
			) + 0
		formatString: 0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 61ba29ad-d0e7-5223-ac2a-ed282350e597

	/// Quantos cartões ficaram sem número (não divulgado).
	measure 'T26 · cartões · não divulgados' =
			COUNTROWS (
			    FILTER (
			        CALCULATETABLE ( VALUES ( 'T26 Debate Globo'[Cartão] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "metrica" ),
			        CALCULATE ( [T26 · cartão · estado] ) = "nao_divulgado"
			    )
			) + 0
		formatString: 0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 344856a3-67eb-5661-88fa-c2f972a10931

	/// Quantos cartões a noite tem (métricas no arquivo).
	measure 'T26 · cartões · total' =
			COUNTROWS ( CALCULATETABLE ( VALUES ( 'T26 Debate Globo'[Cartão] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "metrica" ) ) + 0
		formatString: 0
