		displayFolder: T08 Buscas\Contas
		lineageTag: 50dad4cf-68ea-56fb-9d21-1af9b9712c14

	/// UFs em que Lula teve a maior parte das buscas entre os dois no 2º turno.
	measure 'T08 · UFs com Lula à frente' =
			COUNTROWS ( FILTER ( ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( UF[UF] ), REMOVEFILTERS ( UF ), UF[Tipo] = "UF" ),
			        "@l", [T08 · UF · Lula],
			        "@f", [T08 · UF · Flávio]
			    ), [@l] > [@f] ) ) + 0
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 13e45c35-f5e4-5d86-9367-9d7372e9dd2e

	/// Primeiro dia depois do debate em que quem estava atrás no dia do debate (T08 · virada · quem passa) teve índice maior que o outro, na série que a curva mostra; vazio se não passou.
	measure 'T08 · virada · data' =
			VAR _deb = [T08 · debate · dia no Google]
			VAR _quem = [T08 · virada · quem passa]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@l", [T08 · dia · Lula],
			        "@f", [T08 · dia · Flávio]
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _quem ),
			        MINX ( FILTER ( _dias, [@d] > _deb && IF ( _quem = "Flávio", [@f] > [@l], [@l] > [@f] ) ), [@d] )
			    )
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: dac0f05d-3ae7-5cdc-b278-dfedce5d0927

	/// Quantos dias depois do debate veio a virada (1 = no dia seguinte); vazio sem virada.
	measure 'T08 · virada · dias depois do debate' =
			VAR _deb = [T08 · debate · dia no Google]
			VAR _v = [T08 · virada · data]
			RETURN
			    IF ( NOT ISBLANK ( _v ), DATEDIFF ( _deb, _v, DAY ) )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 5c21b05a-9961-5ed4-9d9f-8ec98c3c8f06

	/// Índice de Flávio no dia da virada depois do debate (T08 · virada · data), na série que a curva mostra.
	measure 'T08 · virada · Flávio' =
			VAR _d = [T08 · virada · data]
			RETURN
			    CALCULATE (
			        [T08 · dia · Flávio],
			        REMOVEFILTERS ( 'Trends tempo' ),
			        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 74904c8a-81bd-50d8-97a6-9c02d8b2b490

	/// Índice de Lula no dia da virada depois do debate (T08 · virada · data), na série que a curva mostra.
	measure 'T08 · virada · Lula' =
			VAR _d = [T08 · virada · data]
			RETURN
			    CALCULATE (
			        [T08 · dia · Lula],
			        REMOVEFILTERS ( 'Trends tempo' ),
			        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: fbf2f1e7-0a5c-5b7b-b070-02fde25414f9

	/// Quem estava atrás nas buscas no dia do debate (o que pode passar o outro depois dele), na série que a curva mostra; vazio se os dois empataram. A mesma regra para os dois candidatos.
	measure 'T08 · virada · quem passa' =
			VAR _l = [T08 · debate · Lula]
			VAR _f = [T08 · debate · Flávio]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _l ) || ISBLANK ( _f ), BLANK (),
			        _l > _f, "Flávio",
			        _f > _l, "Lula",
			        BLANK ()
			    )
		displayFolder: T08 Buscas\Contas
		lineageTag: 59469542-3596-596c-9d59-4035f69a4e47

	/// Último dia antes do debate em que quem passou o outro depois dele (T08 · virada · quem passa) já tinha estado na frente, na série que a curva mostra (o 'desde' da manchete).
	measure 'T08 · virada · último dia à frente antes do debate' =
			VAR _deb = [T08 · debate · dia no Google]
			VAR _quem = [T08 · virada · quem passa]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@l", [T08 · dia · Lula],
			        "@f", [T08 · dia · Flávio]
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _quem ),
			        MAXX ( FILTER ( _dias, [@d] < _deb && IF ( _quem = "Flávio", [@f] > [@l], [@l] > [@f] ) ), [@d] )
			    )
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: e5a7b760-96e4-5961-97c5-ead2cc6a4846

	/// Dias da curva (até 22/10) em que Flávio tem índice 0 no estado clicado porque a busca ficou abaixo do mínimo que o Google mede (nota hasData=false da consulta U2; em AC, AP e RR entram também os zeros de 19 a 21/09, em que não dá para separar volume baixo de lacuna). Os zeros da provável lacuna de coleta de 19 a 21/09 ficam de fora: a curva marca essa faixa à parte. 0 no Brasil (a série T2 não tem zero).
	measure 'T08 · zeros · Flávio' =
			VAR _uf = [T08 · escolha · UF]
			VAR _fim =
			    CALCULATE (
			        MAX ( 'Trends tempo'[Momento] ),
			        REMOVEFILTERS ( 'Trends tempo' ),
			        'Trends tempo'[Série] = "Lula [tópico | T2]"
			    )
			RETURN
			    IF (
			        ISBLANK ( _uf ),
			        0,
			        CALCULATE (
			            COUNTROWS ( 'Trends UF tempo' ),
			            'Trends UF tempo'[UF] = _uf,
			            'Trends UF tempo'[Série] = "Flávio Bolsonaro [tópico | U2]",
			            'Trends UF tempo'[Índice] = 0,
			            'Trends UF tempo'[Data] <= _fim,
			            NOT CONTAINSSTRING ( 'Trends UF tempo'[Observação], "provável lacuna" )
			        ) + 0
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 45bf1093-8c05-5d4d-be11-d1f8e87d1ed7

	/// Dias da curva (até 22/10) em que Lula tem índice 0 no estado clicado porque a busca ficou abaixo do mínimo que o Google mede (nota hasData=false da consulta U2; em AC, AP e RR entram também os zeros de 19 a 21/09, em que não dá para separar volume baixo de lacuna). Os zeros da provável lacuna de coleta de 19 a 21/09 ficam de fora: a curva marca essa faixa à parte. 0 no Brasil (a série T2 não tem zero).
	measure 'T08 · zeros · Lula' =
			VAR _uf = [T08 · escolha · UF]
			VAR _fim =
			    CALCULATE (
			        MAX ( 'Trends tempo'[Momento] ),
			        REMOVEFILTERS ( 'Trends tempo' ),
			        'Trends tempo'[Série] = "Lula [tópico | T2]"
			    )
			RETURN
			    IF (
			        ISBLANK ( _uf ),
			        0,
			        CALCULATE (
			            COUNTROWS ( 'Trends UF tempo' ),
			            'Trends UF tempo'[UF] = _uf,
			            'Trends UF tempo'[Série] = "Lula [tópico | U2]",
			            'Trends UF tempo'[Índice] = 0,
			            'Trends UF tempo'[Data] <= _fim,
			            NOT CONTAINSSTRING ( 'Trends UF tempo'[Observação], "provável lacuna" )
			        ) + 0
			    )
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: b79eb348-8330-5f49-8aa1-7d82029bf452

	/// Texto para leitor de tela da curva diária das buscas (≤ 250 caracteres): a do Brasil ou, com um estado clicado nos cartões, a do estado; com um período escolhido no filtro, o que está em destaque nele (no lugar do pico, que fica fora dos períodos).
	measure 'T08 · Curva · ALT' =
			VAR _uf = [T08 · escolha · UF]
			VAR _no = [T08 · UF · no estado]
			VAR _quem = [T08 · virada · quem passa]
			VAR _outro = IF ( _quem = "Flávio", "Lula", "Flávio" )
			VAR _vD = [T08 · virada · data]
			VAR _vQ = IF ( _quem = "Lula", [T08 · virada · Lula], [T08 · virada · Flávio] )
			VAR _vO = IF ( _quem = "Lula", [T08 · virada · Flávio], [T08 · virada · Lula] )
			VAR _per = [Período · escolhido]
			VAR _mD = [T08 · período · maior · data]
			VAR _base =
			    "Curva diária das buscas"
			        & IF ( NOT ISBLANK ( _uf ), " " & LOWER ( LEFT ( _no, 1 ) ) & MID ( _no, 2, 60 ) )
			        & ", 01/08 a 24/10, índice 0 a 100" & IF ( NOT ISBLANK ( _uf ), " dentro do estado" )
			        & "; o dia do Google vai das 21h às 21h de Brasília, e a noite de cada debate cai no dia seguinte."
			VAR _txtPer =
			    " Em destaque, " & [Período · rótulo]
			        & IF (
			            ISBLANK ( _mD ),
			            ": ainda sem dado.",
			            ": dia de mais buscas " & FORMAT ( _mD, "dd/MM" ) & ", Lula " & [T08 · período · maior · Lula] & " e Flávio "
			                & [T08 · período · maior · Flávio] & "."
			                & IF (
			                    NOT ISBLANK ( _vD ) && _vD >= [T08 · período · início no Google] && _vD <= [T08 · período · fim no Google],
			                    " Em " & FORMAT ( _vD, "dd/MM" ) & ", " & _quem & " passou " & _outro & "."
			                )
			        )
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        _base & " Pico em " & FORMAT ( [T08 · pico · data], "dd/MM" ) & ": Lula " & [T08 · pico · Lula] & " e Flávio "
			            & [T08 · pico · Flávio] & "."
			            & IF (
			                NOT ISBLANK ( _vD ),
			                " Em " & FORMAT ( _vD, "dd/MM" ) & ", depois do debate, " & _quem & " " & _vQ & " e " & _outro & " " & _vO & ".",
			                IF ( NOT ISBLANK ( _quem ), " Depois do debate, " & _quem & " não passou " & _outro & "." )
			            ),
			        _base & _txtPer
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: 96fc1791-6cd6-50c0-91f9-c152d685be95

	/// Fundo da curva diária das buscas (01/08 a 24/10, no dia do Google: das 21h às 21h de Brasília): título, grade, datas, as duas linhas que se desenham, o pico e o dia em que quem estava atrás no dia do debate passou o outro, com notas à mão. Sem estado clicado: a consulta T2 do Brasil (os candidatos como tópico). Com um estado clicado nos cartões (filtro cruzado em UF[UF], T08 · escolha · UF): a consulta U2 daquele estado, em que 100 é o pico dentro do próprio estado; título, manchete, rótulos, nota da virada (só se ela aconteceu ali) e legenda seguem o estado, a faixa de 19 a 21/09 marca a lacuna de coleta e a legenda avisa dos zeros (volume abaixo do mínimo do Google). Com um período escolhido no filtro Período: a curva inteira continua, o período fica realçado (faixa e linhas cheias) e o resto esmaece; a manchete e a nota passam a ser do período (a virada, se aconteceu nele, ou o dia de mais buscas); Depois da Globo, a faixa vazia e 'aguardando'. As faixas de cada dia (mouse e dossiê) são outro visual (T08 · Dias · HTML), na mesma caixa e escala. Só lê contas 'T08 · …' e 'Período · …'.
	measure 'T08 · Curva · HTML' =
			-- 1 · Leituras
			VAR _uf = [T08 · escolha · UF]
			VAR _dias =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'Trends tempo'[DataTexto] ),
			            REMOVEFILTERS ( 'Trends tempo' ),
			            'Trends tempo'[Série] = "Lula [tópico | T2]"
			        ),
			        "@d", [T08 · dia · data],
			        "@l", [T08 · dia · Lula],
			        "@f", [T08 · dia · Flávio]
			    ) /* lista */
			VAR _pD = [T08 · pico · data]
			VAR _pL = [T08 · pico · Lula]
			VAR _pF = [T08 · pico · Flávio]
			VAR _quem = [T08 · virada · quem passa]
			VAR _vD = [T08 · virada · data]
			VAR _vL = [T08 · virada · Lula]
			VAR _vF = [T08 · virada · Flávio]
			VAR _vDias = [T08 · virada · dias depois do debate]
			VAR _antes = [T08 · virada · último dia à frente antes do debate]
			VAR _deb = [T08 · debate · dia no Google]
			VAR _glo = [T08 · debate Globo · dia no Google]
			VAR _nDep = [T08 · depois do debate · dias]
			VAR _nLider = [T08 · depois do debate · dias com o líder à frente]
			VAR _maxDep = [T08 · depois do pico · maior índice]
			VAR _zL = [T08 · zeros · Lula]
			VAR _zF = [T08 · zeros · Flávio]
			VAR _lac = [T08 · lacuna · nota]
			VAR _uNome = [T08 · UF · nome]
			VAR _camp = [T08 · campanha · início]
			VAR _noUf = NOT ISBLANK ( _uf )
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pIni = [T08 · período · início no Google]
			VAR _pFim = [T08 · período · fim no Google]
			VAR _mD = [T08 · período · maior · data]
			VAR _mL = [T08 · período · maior · Lula]
			VAR _mF = [T08 · período · maior · Flávio]
			VAR _noPer = NOT ISBLANK ( _per )
			VAR _semDado = _noPer && ISBLANK ( _mD ) -- período sem nenhum dia na curva (Depois da Globo)
			VAR _viradaNoPer = _noPer && NOT ISBLANK ( _vD ) && _vD >= _pIni && _vD <= _pFim
			-- 2 · Textos
			VAR _t1 = DATE ( 2026, 10, 4 ) -- dia do 1º turno (marco do calendário)
			VAR _outro = IF ( _quem = "Flávio", "Lula", "Flávio" )
			VAR _txtPico = IF ( _pD = _t1, "O pico foi no dia do 1º turno", "O pico foi em " & FORMAT ( _pD, "dd/MM" ) )
			VAR _quando =
			    IF ( _vDias = 1, "um dia depois do debate", "em " & FORMAT ( _vD, "dd/MM" ) & ", depois do debate" )
			VAR _desde = IF ( ISBLANK ( _antes ), "na série", "desde " & FORMAT ( _antes, "dd/MM" ) )
			-- quem passou já estava na frente na véspera do ponto do debate: não é "pela primeira vez", é "voltou à frente"
			VAR _volta = NOT ISBLANK ( _antes ) && _antes = _deb - 1
			VAR _txtPassa =
			    IF ( _volta, _quem & " voltou à frente de " & _outro, _quem & " passou " & _outro & " pela primeira vez " & _desde )
			VAR _txtDepois =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _vD ),
			            "; " & _quando & ", " & _txtPassa,
			        ISBLANK ( _quem ), "",
			        _nLider = _nDep, "; depois do debate, " & _outro & " seguiu mais buscado que " & _quem & " em todos os dias",
			        "; depois do debate, " & _quem & " não passou " & _outro & " em nenhum dia"
			    )
			VAR _quandoP = IF ( _vDias = 1, "um dia depois do debate", "em " & FORMAT ( _vD, "dd/MM" ) )
			VAR _txtMan =
			    SWITCH (
			        TRUE (),
			        NOT _noPer, _txtPico & _txtDepois & ".",
			        _semDado, _pNome & ", ainda não há dado: as consultas ao Google são de antes do debate de 23/10.",
			        _viradaNoPer, _pNome & ": " & _quandoP & ", " & _txtPassa & ".",
			        _pNome & ", o dia de mais buscas foi " & FORMAT ( _mD, "dd/MM" ) & ": Lula " & _mL & ", Flávio " & _mF & "."
			    )
			VAR _txtSob =
			    IF (
			        _noUf,
			        "Quanto cada um foi buscado, dia a dia · " & _uNome & ", índice de 0 a 100 no estado",
			        "Quanto cada um foi buscado, dia a dia · índice de 0 a 100, os candidatos como tópico"
			    )
			VAR _txtZeros =
			    IF ( _zL > 0, "Lula em " & _zL & IF ( _zL = 1, " dia", " dias" ) )
			        & IF ( _zL > 0 && _zF > 0, ", " )
			        & IF ( _zF > 0, "Flávio em " & _zF & IF ( _zF = 1, " dia", " dias" ) )
			VAR _txtLeg =
			    IF (
			        _noUf,
			        "100 = o dia de mais buscas no estado, não o número de buscas; o índice não se compara de um estado para outro"
			            & IF ( _zL + _zF > 0, " · 0 = busca abaixo do mínimo que o Google mede (" & _txtZeros & ")" )
			            & " · passe o mouse num dia",
			        "100 = o dia de mais buscas na consulta, não o número de buscas · o dia do Google vai das 21h às 21h (Brasília): a noite de cada debate cai no dia seguinte · passe o mouse num dia"
			    )
			-- a nota do período: a virada, se aconteceu nele; senão, o dia de mais buscas (o maior índice na frente; no empate,
			-- Lula primeiro, na ordem da tela)
			VAR _notaVirada = IF ( _noPer, _viradaNoPer, NOT ISBLANK ( _vD ) )
			VAR _notaMaior = _noPer && NOT _semDado && NOT _viradaNoPer
			VAR _maiorLula = _mL >= _mF
			VAR _txtNota = IF ( _notaVirada, IF ( _volta, _quem & " volta à frente", _quem & " passa " & _outro ), "o dia de mais buscas" )
			-- 3 · Geometria (x: 01/08 a 24/10 em 40–1090; y: índice 0 a 100 em 345–30; o svg começa em y 80)
			VAR _ini = DATE ( 2026, 8, 1 )
			VAR _f = "0.0"
			VAR _pts =
			    ADDCOLUMNS (
			        _dias,
			        "@x", 40 + DATEDIFF ( _ini, [@d], DAY ) / 84 * 1050, -- geometria
			        "@yl", 345 - [@l] * 3.15, -- geometria
			        "@yf", 345 - [@f] * 3.15 -- geometria
			    )
			VAR _linhaL = "M" & CONCATENATEX ( _pts, FORMAT ( [@x], _f, "en-US" ) & " " & FORMAT ( [@yl], _f, "en-US" ), " L", [@d], ASC )
			VAR _linhaF = "M" & CONCATENATEX ( _pts, FORMAT ( [@x], _f, "en-US" ) & " " & FORMAT ( [@yf], _f, "en-US" ), " L", [@d], ASC )
			VAR _xP = 40 + DATEDIFF ( _ini, _pD, DAY ) / 84 * 1050 -- geometria
			VAR _xT1 = 40 + DATEDIFF ( _ini, _t1, DAY ) / 84 * 1050 -- geometria
			VAR _xV = 40 + DATEDIFF ( _ini, _vD, DAY ) / 84 * 1050 -- geometria
			VAR _xDeb = 40 + DATEDIFF ( _ini, _deb, DAY ) / 84 * 1050 -- geometria
			VAR _xGlo = 40 + DATEDIFF ( _ini, _glo, DAY ) / 84 * 1050 -- geometria
			VAR _yPL = 345 - _pL * 3.15 -- geometria
			VAR _yPF = 345 - _pF * 3.15 -- geometria
			VAR _yVL = 345 - _vL * 3.15 -- geometria
			VAR _yVF = 345 - _vF * 3.15 -- geometria
			VAR _xM = 40 + DATEDIFF ( _ini, _mD, DAY ) / 84 * 1050 -- geometria (dia de mais buscas do período)
			VAR _yML = 345 - _mL * 3.15 -- geometria
			VAR _yMF = 345 - _mF * 3.15 -- geometria
			VAR _xA = 40 + DATEDIFF ( _ini, _pIni, DAY ) / 84 * 1050 - 6.4 -- geometria (faixa do período)
			VAR _xB = 40 + DATEDIFF ( _ini, _pFim, DAY ) / 84 * 1050 + 6.4 -- geometria
			-- rótulos do pico: no lugar de cada ponto; se ficam a menos de 26 px, abrem em volta do meio (o maior em cima; no
			-- empate, Lula em cima, na ordem da tela)
			VAR _abre = ABS ( _yPL - _yPF ) < 26
			VAR _meio = ( _yPL + _yPF ) / 2
			VAR _lulaCima = _pL >= _pF
			VAR _yRL = IF ( _abre, IF ( _lulaCima, _meio - 13, _meio + 13 ), _yPL ) -- geometria
			VAR _yRF = IF ( _abre, IF ( _lulaCima, _meio + 13, _meio - 13 ), _yPF ) -- geometria
			-- nota (virada ou dia de mais buscas): acima das linhas de 06 a 22/10 e acima da seta que aponta o ponto (topo 150,
			-- como no Brasil, ou mais alto quando a linha sobe); nunca colada à manchete (topo mínimo 62); a seta só entra se
			-- couber embaixo dela; ponto à esquerda da nota (dia de mais buscas logo depois do 1º turno): seta para a esquerda
			VAR _xQ = IF ( _notaVirada, _xV, _xM ) -- geometria
			VAR _yQ = IF ( _notaVirada, IF ( _quem = "Lula", _yVL, _yVF ), MIN ( _yML, _yMF ) ) -- geometria
			VAR _yTopo = 345 - _maxDep * 3.15 -- geometria
			VAR _topo = ROUND ( MAX ( 62, MIN ( 150, MIN ( 80 + _yQ - 118, 80 + _yTopo - 70 ) ) ), 0 ) -- geometria (px inteiro)
			VAR _comSeta = 80 + _yQ - 54 >= _topo + 64
			VAR _setaEsq = _xQ < _xP + 40 -- o ponto fica à esquerda do começo da nota
			VAR _xL1 = 40 + DATEDIFF ( _ini, DATE ( 2026, 9, 19 ), DAY ) / 84 * 1050 - 6.4 -- geometria (lacuna 19 a 21/09)
			VAR _xL2 = 40 + DATEDIFF ( _ini, DATE ( 2026, 9, 21 ), DAY ) / 84 * 1050 + 6.4 -- geometria
			VAR _grade =
			    CONCATENATEX (
			        { 0, 50, 100 },
			        "<line x1='40' x2='1090' y1='" & FORMAT ( 345 - [Value] * 3.15, _f, "en-US" ) & "' y2='"
			            & FORMAT ( 345 - [Value] * 3.15, _f, "en-US" ) & "' class='g'/><text x='30' y='"
			            & FORMAT ( 350 - [Value] * 3.15, _f, "en-US" ) & "' class='ex' text-anchor='end'>" & [Value] & "</text>",
			        ""
			    )
			VAR _datas =
			    CONCATENATEX (
			        { DATE ( 2026, 8, 1 ), DATE ( 2026, 9, 1 ), DATE ( 2026, 9, 15 ) },
			        "<text x='" & FORMAT ( 40 + DATEDIFF ( _ini, [Value], DAY ) / 84 * 1050, _f, "en-US" )
			            & "' y='372' class='ex' text-anchor='middle'>" & FORMAT ( [Value], "dd/MM" ) & "</text>",
			        ""
			    )
			VAR _xCamp = 40 + DATEDIFF ( _ini, _camp, DAY ) / 84 * 1050 -- geometria
			-- 4 · Marcação
			VAR _lacuna =
			    IF (
			        NOT ISBLANK ( _lac ),
			        "<rect x='" & FORMAT ( _xL1, _f, "en-US" ) & "' y='50' width='" & FORMAT ( _xL2 - _xL1, _f, "en-US" )
			            & "' height='295' class='lac esmaece d12'/><text x='" & FORMAT ( _xL1 - 8, _f, "en-US" )
			            & "' y='120' class='ex' text-anchor='end'>19 a 21/09 · " & _lac & "</text>"
			    )
			-- período: a faixa atrás das linhas e o recorte que deixa só o trecho do período com a linha cheia
			VAR _faixa =
			    IF (
			        _noPer,
			        "<defs><clipPath id='t08per'><rect x='" & FORMAT ( _xA, _f, "en-US" ) & "' y='0' width='"
			            & FORMAT ( _xB - _xA, _f, "en-US" ) & "' height='400'/></clipPath></defs>"
			            & "<rect x='" & FORMAT ( _xA, _f, "en-US" ) & "' y='22' width='" & FORMAT ( _xB - _xA, _f, "en-US" )
			            & "' height='323' class='per" & IF ( _semDado, " esp", "" ) & " esmaece d6'/>"
			    )
			VAR _cl = IF ( _noPer, " fora", "" )
			VAR _cheias =
			    IF (
			        _noPer && NOT _semDado,
			        "<path d='" & _linhaF & "' pathLength='1' class='lf traco' clip-path='url(#t08per)' filter='url(#rbu)' style='animation-delay:.4s'/>"
			            & "<path d='" & _linhaL & "' pathLength='1' class='ll traco' clip-path='url(#t08per)' filter='url(#rbu)' style='animation-delay:.6s'/>"
			    )
			VAR _pontosPico =
			    IF (
			        NOT _noPer,
			        "<circle cx='" & FORMAT ( _xP, _f, "en-US" ) & "' cy='" & FORMAT ( _yPL, _f, "en-US" ) & "' r='7' class='pl brota d16'/>"
			            & "<circle cx='" & FORMAT ( _xP, _f, "en-US" ) & "' cy='" & FORMAT ( _yPF, _f, "en-US" ) & "' r='7' class='pf brota d16'/>"
			    )
			VAR _pontosNota =
			    SWITCH (
			        TRUE (),
			        _notaVirada,
			            "<circle cx='" & FORMAT ( _xV, _f, "en-US" ) & "' cy='" & FORMAT ( _yVL, _f, "en-US" ) & "' r='6' class='pl brota d16'/>"
			                & "<circle cx='" & FORMAT ( _xV, _f, "en-US" ) & "' cy='" & FORMAT ( _yVF, _f, "en-US" ) & "' r='6' class='pf brota d16'/>",
			        _notaMaior,
			            "<circle cx='" & FORMAT ( _xM, _f, "en-US" ) & "' cy='" & FORMAT ( _yML, _f, "en-US" ) & "' r='6' class='pl brota d16'/>"
			                & "<circle cx='" & FORMAT ( _xM, _f, "en-US" ) & "' cy='" & FORMAT ( _yMF, _f, "en-US" ) & "' r='6' class='pf brota d16'/>"
			    )
			VAR _svg =
			    "<svg width='1130' height='400' viewBox='0 0 1130 400'>"
			        & _grade & _datas & _lacuna & _faixa
			        & "<text x='" & FORMAT ( _xCamp, _f, "en-US" ) & "' y='372' class='ex' text-anchor='middle'>" & FORMAT ( _camp, "dd/MM" ) & " · campanha</text>"
			        & "<line x1='" & FORMAT ( _xT1, _f, "en-US" ) & "' x2='" & FORMAT ( _xT1, _f, "en-US" ) & "' y1='22' y2='350' class='ev'/>"
			        & "<text x='" & FORMAT ( _xT1, _f, "en-US" ) & "' y='372' class='ex b' text-anchor='middle'>1º turno · "
			            & FORMAT ( _t1, "dd/MM" ) & "</text>"
			        & "<line x1='" & FORMAT ( _xDeb, _f, "en-US" ) & "' x2='" & FORMAT ( _xDeb, _f, "en-US" ) & "' y1='150' y2='350' class='ev'/>"
			        & "<text x='" & FORMAT ( _xDeb - 4, _f, "en-US" ) & "' y='388' class='ex b' text-anchor='middle'>Band</text>"
			        & IF ( NOT ISBLANK ( _glo ), "<line x1='" & FORMAT ( _xGlo, _f, "en-US" ) & "' x2='" & FORMAT ( _xGlo, _f, "en-US" )
			            & "' y1='150' y2='350' class='ev'/><text x='" & FORMAT ( _xGlo, _f, "en-US" )
			            & "' y='388' class='ex b' text-anchor='middle'>Globo</text>" )
			        & "<path d='" & _linhaF & "' pathLength='1' class='lf traco" & _cl & "' filter='url(#rbu)' style='animation-delay:.4s'/>"
			        & "<path d='" & _linhaL & "' pathLength='1' class='ll traco" & _cl & "' filter='url(#rbu)' style='animation-delay:.6s'/>"
			        & _cheias & _pontosPico & _pontosNota
			    & "</svg>"
			VAR _rotulos =
			    IF (
			        NOT _noPer,
			        "<div class='rotulo e lula-esc entra d16' style='right:" & FORMAT ( 1130 - _xP + 14, _f, "en-US" ) & "px;top:"
			            & FORMAT ( 80 + _yRL - 14, _f, "en-US" ) & "px'>Lula " & _pL & "</div>"
			            & "<div class='rotulo e flavio-esc entra d16' style='right:" & FORMAT ( 1130 - _xP + 14, _f, "en-US" ) & "px;top:"
			            & FORMAT ( 80 + _yRF - 14, _f, "en-US" ) & "px'>Flávio " & _pF & "</div>"
			            & IF (
			                _pD = _t1,
			                "<div class='mao entra d16' style='left:" & FORMAT ( _xP - 330, _f, "en-US" ) & "px;top:"
			                    & FORMAT ( 80 + MIN ( _yRL, _yRF ) - 18, _f, "en-US" ) & "px;transform:rotate(-3deg)'>o dia da eleição</div>"
			            )
			    )
			VAR _spanL = "<span class='lula-esc'>Lula " & IF ( _notaVirada, _vL, _mL ) & "</span>"
			VAR _spanF = "<span class='flavio-esc'>Flávio " & IF ( _notaVirada, _vF, _mF ) & "</span>"
			VAR _primeiroLula = IF ( _notaVirada, _quem = "Lula", _maiorLula )
			VAR _nota =
			    IF (
			        _notaVirada || _notaMaior,
			        "<div class='mao entra d16' style='left:" & FORMAT ( _xP + 40, _f, "en-US" ) & "px;top:" & FORMAT ( _topo, "0", "en-US" )
			            & "px;transform:rotate(-2deg)'>" & _txtNota & "</div>"
			            & "<div class='rotulo entra d16' style='left:" & FORMAT ( _xP + 40, _f, "en-US" ) & "px;top:"
			            & FORMAT ( _topo + 38, "0", "en-US" ) & "px'>"
			            & IF ( _primeiroLula, _spanL & " " & _spanF, _spanF & " " & _spanL ) & "</div>"
			            & IF (
			                _comSeta,
			                IF (
			                    _setaEsq,
			                    "<div class='seta e entra d16' style='left:" & FORMAT ( _xQ + 6, _f, "en-US" ) & "px;top:"
			                        & FORMAT ( 80 + _yQ - 54, _f, "en-US" ) & "px;width:56px;height:50px'></div>",
			                    "<div class='seta e entra d16' style='left:" & FORMAT ( _xQ - 64, _f, "en-US" ) & "px;top:"
			                        & FORMAT ( 80 + _yQ - 54, _f, "en-US" ) & "px;width:56px;height:50px;transform:scaleX(-1)'></div>"
			                )
			            )
			    )
			VAR _espera =
			    IF (
			        _semDado,
			        "<div class='mao entra d16' style='right:" & FORMAT ( 1130 - _xA + 10, _f, "en-US" )
			            & "px;top:96px;transform:rotate(-2deg)'>aguardando</div>"
			    )
			VAR _zeroMao =
			    IF (
			        MAX ( _zL, _zF ) >= 20,
			        "<div class='mao entra d16' style='left:70px;top:290px;transform:rotate(-2deg)'>zero = busca abaixo do mínimo</div>"
			    )
			RETURN
			    "<div class='tela t08c'>"
			        & "<div class='cab'><div class='sob sobe'>" & _txtSob & "</div>"
			        & "<div class='man sobe d2'>" & _txtMan & "</div></div>"
			        & _svg & _rotulos & _nota & _espera & _zeroMao
			        & "<div class='leg entra d12'><b><i style='background:var(--vermelho)'></i>Lula</b>"
			        & "<b><i style='background:var(--azul)'></i>Flávio</b>"
			        & _txtLeg & "</div>"
			    & "</div>"
		displayFolder: T08 Buscas\Desenho
		lineageTag: 9dc06051-e5f8-521d-b321-14d7b0592ebd

	/// Texto para leitor de tela das faixas de cada dia da curva (a do Brasil ou a do estado clicado nos cartões).
	measure 'T08 · Dias · ALT' =
			IF (
			    ISBLANK ( [T08 · escolha · UF] ),
			    "Uma faixa por dia da curva (" & [T08 · curva · dias] & " dias): passe o mouse para ver o índice de cada um no dia e, em outubro, a curva hora a hora.",
			    "Uma faixa por dia da curva de " & [T08 · UF · nome] & " (" & [T08 · curva · dias] & " dias): passe o mouse para ver o índice de cada um no dia, de 0 a 100 dentro do estado."
			)
		displayFolder: T08 Buscas\Desenho
		lineageTag: 5e606e93-2f50-5128-844a-358071a32046

	/// Uma faixa por dia da série T2 (grão 'Trends tempo'[DataTexto]) sobre a curva de T08 · Curva · HTML, na mesma escala: no mouse aparecem a linha do dia e os dois pontos; cada faixa abre o dossiê ttT08Dia. Vazio nas linhas por hora e nas outras séries.
	measure 'T08 · Dias · HTML' =
			-- 1 · Leituras
			VAR _d = [T08 · dia · data]
			VAR _l = [T08 · dia · Lula]
			VAR _fl = [T08 · dia · Flávio]
			-- 3 · Geometria (x: 01/08 a 22/10 em 40–1090; y: índice em 345–30 no svg que começa em y 80; a faixa começa em y 100)
			VAR _x = 40 + DATEDIFF ( DATE ( 2026, 8, 1 ), _d, DAY ) / 84 * 1050 - 6.5 -- geometria
			VAR _yl = 80 + 345 - _l * 3.15 - 100 - 5.5 -- geometria
			VAR _yf = 80 + 345 - _fl * 3.15 - 100 - 5.5 -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _l ),
			        "<div class='tela t08d'><div class='dia' style='left:" & FORMAT ( _x, "0.0", "en-US" ) & "px'><i class='v'></i>"
			            & "<i class='m mf' style='top:" & FORMAT ( _yf, "0.0", "en-US" ) & "px'></i>"
			            & "<i class='m ml' style='top:" & FORMAT ( _yl, "0.0", "en-US" ) & "px'></i></div></div>"
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: 7fa7884f-d370-55e5-9287-d1670faa74ee

	/// Texto para leitor de tela do cabeçalho do mapa das buscas por estado.
	measure 'T08 · Mapa · ALT' =
			VAR _per = [Período · escolhido]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _per ) && [T08 · UFs] = 0,
			            "Nos estados, " & [Período · nome] & ": ainda sem dado de buscas.",
			        IF ( ISBLANK ( _per ), "No 2º turno", [Período · nome] ) & ", Lula teve a maior parte das buscas entre os dois em "
			            & [T08 · UFs com Lula à frente] & " de " & [T08 · UFs] & " estados: de " & [T08 · UF · menor parte · Lula]
			            & "% a " & [T08 · UF · maior parte · Lula] & "%."
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: 3312603b-78e7-5ea2-b135-da633156595c

	/// Cabeçalho do mapa de quadrados das buscas no 2º turno: 'N de 27' estados com Lula à frente (contadores), a faixa de cada um entre as UFs e a legenda (barra = parte das buscas; fundo = interesse). Os quadrados são outro visual (T08 · UFs · HTML), na mesma caixa. Com um período escolhido no filtro Período: as contas passam a ser as do período (a parte de cada um pela consulta U2 de cada estado, dia a dia), o fundo dos quadrados fica igual (o interesse por estado só existe para o 2º turno inteiro) e a legenda fala só da barra; Depois da Globo, 'aguardando'.
	measure 'T08 · Mapa · HTML' =
			-- 1 · Leituras
			VAR _n = [T08 · UFs com Lula à frente]
			VAR _nF = [T08 · UFs com Flávio à frente]
			VAR _t = [T08 · UFs]
			VAR _lMin = [T08 · UF · menor parte · Lula]
			VAR _lMax = [T08 · UF · maior parte · Lula]
			VAR _fMin = [T08 · UF · menor parte · Flávio]
			VAR _fMax = [T08 · UF · maior parte · Flávio]
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pRot = [Período · rótulo]
			VAR _noPer = NOT ISBLANK ( _per )
			VAR _semDado = _noPer && _t = 0
			-- 2 · Textos
			VAR _quem = IF ( _n >= _nF, "Lula", "Flávio" )
			VAR _num = MAX ( _n, _nF )
			VAR _pDatas = MID ( _pRot, SEARCH ( " · ", _pRot, 1, 0 ) + 3, 40 ) -- "05 a 17/10", "21 e 22/10"
			VAR _pDe = IF ( CONTAINSSTRING ( _pDatas, " e " ), "Em ", "De " ) & _pDatas
			VAR _txt =
			    IF ( _noPer, _pDe & ", Lula", "Lula" ) & " teve de " & _lMin & "% a " & _lMax & "% das buscas entre os dois; Flávio, de "
			        & _fMin & "% a " & _fMax & "%."
			VAR _leg =
			    IF (
			        _noPer,
			        "<div class='leg entra d14'><div class='bar'><i class='l'></i><i class='f'></i></div>"
			            & "barra: as buscas entre os dois no período</div>",
			        "<div class='leg entra d14'><div class='bar'><i class='l'></i><i class='f'></i></div>"
			            & "barra: as buscas entre os dois"
			            & "<div class='fundo'><i style='background:rgba(203,189,162,.18)'></i><i style='background:rgba(203,189,162,.55)'></i>"
			            & "<i style='background:rgba(203,189,162,1)'></i></div>fundo escuro: mais interesse</div>"
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t08m'>"
			        & "<div class='sob sobe'>Nos estados · " & IF ( _noPer, _pNome, "2º turno, 05 a 22/10" ) & "</div>"
			        & IF (
			            _semDado,
			            "<div class='linha sobe d2'><span class='mao'>aguardando</span></div>"
			                & "<div class='txt sobe d3'>Ainda não há dado por estado " & LOWER ( LEFT ( _pNome, 1 ) ) & MID ( _pNome, 2, 40 )
			                & ": as consultas ao Google são de antes do debate de 23/10.</div>",
			            "<div class='linha sobe d2'><span class='num " & IF ( _quem = "Lula", "lula", "flavio" ) & "'>" & _num
			                & "</span><span class='de'>de</span><span class='num'>" & _t & "</span><span class='man'>com " & _quem & " na frente</span></div>"
			                & "<div class='txt sobe d3'>" & _txt & "</div>"
			                & _leg
			        )
			    & "</div>"
		displayFolder: T08 Buscas\Desenho
		lineageTag: f647f3ff-8d84-50fa-8cab-bf6d09962402

	/// Texto para leitor de tela da caixa de busca com as perguntas.
	measure 'T08 · Perguntas · ALT' =
			"O que o Brasil perguntou: Que horas começa a votação (" & FORMAT ( [T08 · pergunta · que horas começa a votação · alta], "+0%" )
			    & " na semana até 01/10), local de votação (pico no dia da eleição), Quem ganhou a eleição e Quando vai ser o segundo turno (as mais buscadas depois)."
		displayFolder: T08 Buscas\Desenho
		lineageTag: 0b05dad3-7c91-5226-85cc-e23aab7c76ac

	/// A caixa de busca desenhada: o que se digita e, na lista, as perguntas e termos de serviço na ordem do tempo (a semana antes do 1º turno, o dia da votação, os dias depois), cada um com o seu número (contador) e a fonte no pé. Só lê contas 'T08 · …'.
	measure 'T08 · Perguntas · HTML' =
			-- 1 · Leituras
			VAR _alta = [T08 · pergunta · que horas começa a votação · alta]
			VAR _local = [T08 · serviço · local de votação · pico]
			VAR _diaLocal = [T08 · serviço · local de votação · dia do pico]
			VAR _titulo = [T08 · serviço · título de eleitor · no pico]
			VAR _p1 = [T08 · pergunta · quem ganhou a eleição · posição]
			VAR _p2 = [T08 · pergunta · quando vai ser o segundo turno · posição]
			-- 2 · Textos
			VAR _txtAlta = FORMAT ( _alta, "+0%" )
			VAR _txtDia = FORMAT ( _diaLocal, "dd/MM" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t08q'>"
			        & "<div class='sob sobe'>O que o Brasil perguntou ao Google</div>"
			        & "<div class='busca sobe d1'><i class='lupa'></i><span class='dig'>quem ganhou a eleição?</span><b class='cursor'></b></div>"
			        & "<div class='lista entra d3'>"
			            & "<div class='it sobe d4'><span class='qd'>semana até 01/10</span><i class='lp'></i>"
			                & "<span class='q'>Que horas começa a votação?</span>"
			                & "<span class='v'><span class='num'>" & _txtAlta & "</span><small>na semana</small></span></div>"
			            & "<div class='it sobe d5'><span class='qd'>" & _txtDia & " · eleição</span><i class='lp'></i>"
			                & "<span class='q'>local de votação · título de eleitor</span>"
			                & "<span class='v'><span class='num'>" & _local & "</span><small>e " & _titulo & " no índice</small></span></div>"
			            & "<div class='it sobe d6'><span class='qd'>05 a 08/10</span><i class='lp'></i>"
			                & "<span class='q'>Quem ganhou a eleição?</span>"
			                & "<span class='v'><span class='ord'>" & _p1 & "ª</span><small>mais buscada</small></span></div>"
			            & "<div class='it sobe d7'><span class='qd'>05 a 08/10</span><i class='lp'></i>"
			                & "<span class='q'>Quando vai ser o segundo turno?</span>"
			                & "<span class='v'><span class='ord'>" & _p2 & "ª</span><small>mais buscada</small></span></div>"
			        & "</div>"
			        & "<div class='nota entra d9'>Fontes: Google ao UOL (alta contra a semana anterior); Google Trends, termos de serviço "
			            & "(0 a 100, 01/08 a 24/10); lista do Google obtida pelo Estadão</div>"
			    & "</div>"
		displayFolder: T08 Buscas\Desenho
		lineageTag: dbe60636-9a59-5f5c-9e85-0dd8097abd22

	/// Texto para leitor de tela da abertura das buscas (≤ 250 caracteres): o resumo dos 30 dias com os dias da campanha (desde 16/08), o dia clicado na curva ou o estado clicado no mapa (com os dias da campanha na série do estado).
	measure 'T08 · Placar · ALT' =
			VAR _dia = [T08 · escolha · dia]
			VAR _uf = [T08 · escolha · UF]
			VAR _per = [Período · escolhido]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _dia ),
			            "Em " & FORMAT ( _dia, "dd/MM" ) & ", índice de buscas: Lula " & [T08 · dia · Lula] & " e Flávio "
			                & [T08 · dia · Flávio] & ", de 0 a 100.",
			        NOT ISBLANK ( _per ) && ISBLANK ( IF ( ISBLANK ( _uf ), [T08 · período · parte Lula], [T08 · UF · parte Lula] ) ),
			            IF ( ISBLANK ( _uf ), "Brasil", [T08 · UF · nome] ) & ", " & [Período · rótulo] & ": ainda sem dado de buscas.",
			        NOT ISBLANK ( _per ) && NOT ISBLANK ( _uf ),
			            [T08 · UF · nome] & ", " & [Período · rótulo] & ": Lula " & FORMAT ( [T08 · UF · parte Lula], "0%" ) & " e Flávio "
			                & FORMAT ( [T08 · UF · parte Flávio], "0%" ) & " das buscas pelos dois.",
			        NOT ISBLANK ( _per ),
			            "Brasil, " & [Período · rótulo] & ": Lula " & FORMAT ( [T08 · período · parte Lula], "0%" ) & " e Flávio "
			                & FORMAT ( [T08 · período · parte Flávio], "0%" ) & " da soma dos índices diários. Lula na frente em "
			                & [T08 · período · dias com Lula à frente] & " de " & [T08 · período · dias] & " dias; Flávio, em "
			                & [T08 · período · dias com Flávio à frente] & ".",
			        NOT ISBLANK ( _uf ),
			            [T08 · UF · nome] & ", 2º turno: Lula " & FORMAT ( [T08 · UF · parte Lula], "0%" ) & " e Flávio "
			                & FORMAT ( [T08 · UF · parte Flávio], "0%" ) & " das buscas pelos dois. Na campanha, desde 16/08, Lula foi mais buscado em "
			                & [T08 · dias com Lula à frente] & " de " & [T08 · dias] & " dias; Flávio, em " & [T08 · dias com Flávio à frente] & ".",
			        "Central do Google, últimos 30 dias: Lula " & FORMAT ( [T08 · Central · Lula], "0%" ) & " e Flávio "
			            & FORMAT ( [T08 · Central · Flávio], "0%" ) & " do interesse. Na campanha, desde 16/08, Lula foi mais buscado em "
			            & [T08 · dias com Lula à frente] & " de " & [T08 · dias] & " dias; Flávio, em " & [T08 · dias com Flávio à frente] & "."
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: 6d6e1793-47e0-5eb0-9bef-62f212a20620

	/// Abertura da tela das buscas. Sem clique: a parte de cada um no interesse dos últimos 30 dias (resumo da Central Google Trends, contadores), a manchete com os dias da campanha (desde 16/08, T08 · campanha · início; a curva começa em 01/08) em que cada um foi mais buscado (consulta T2), quem ficou na frente em mais dias abrindo a frase e o lembrete de que o Trends dá um índice relativo, não o número de buscas. Com um dia clicado na curva (filtro cruzado de 'Trends tempo'[DataTexto]): a parte de cada um na soma dos dois índices daquele dia, quem foi mais buscado e se foi um dos dias de mais buscas. Com um estado clicado no mapa (filtro cruzado de UF[UF]): a parte de cada um nas buscas do estado no 2º turno, a mesma frase dos dias da campanha na série do estado (consulta U2, desde 16/08) e o aviso de que a curva abaixo passou a ser a do estado (100 = o pico dentro do próprio estado; o índice não se compara entre estados). Com estado e dia (Ctrl+clique), o dia é o do estado. Com um período escolhido no filtro Período (sem dia clicado): no Brasil, a parte de cada um na soma dos índices diários da consulta T2 no período e quantos dias cada um ficou na frente; no estado, a parte de cada um pela consulta U2 do estado no período; Depois da Globo, a espera honesta (os números com traço, nunca zero). Só lê contas 'T08 · …' e 'Período · …'.
	measure 'T08 · Placar · HTML' =
			-- 1 · Leituras
			VAR _dia = [T08 · escolha · dia]
			VAR _ufEsc = [T08 · escolha · UF]
			VAR _cL = [T08 · Central · Lula]
			VAR _cF = [T08 · Central · Flávio]
			VAR _dias = [T08 · dias]
			VAR _dL = [T08 · dias com Lula à frente]
			VAR _dF = [T08 · dias com Flávio à frente]
			VAR _dFdep = [T08 · dias com Flávio à frente depois do debate]
			VAR _dLdep = [T08 · dias com Lula à frente depois do debate]
			VAR _iL = [T08 · dia · Lula]
			VAR _iF = [T08 · dia · Flávio]
			VAR _pdL = [T08 · dia · parte Lula]
			VAR _pdF = [T08 · dia · parte Flávio]
			VAR _posL = [T08 · dia · posição Lula]
			VAR _posF = [T08 · dia · posição Flávio]
			VAR _marco = [T08 · dia · marco]
			VAR _pico = [T08 · pico · data]
			VAR _uNome = [T08 · UF · nome]
			VAR _uNo = [T08 · UF · no estado]
			VAR _ufL = [T08 · UF · Lula]
			VAR _ufF = [T08 · UF · Flávio]
			VAR _upL = [T08 · UF · parte Lula]
			VAR _upF = [T08 · UF · parte Flávio]
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pRot = [Período · rótulo]
			VAR _pFim = [T08 · período · fim no Google]
			VAR _pDias = [T08 · período · dias]
			VAR _pqL = [T08 · período · dias com Lula à frente]
			VAR _pqF = [T08 · período · dias com Flávio à frente]
			VAR _pqE = [T08 · período · empates]
			VAR _pqLD = [T08 · período · dia com Lula à frente]
			VAR _pqFD = [T08 · período · dia com Flávio à frente]
			VAR _pqED = [T08 · período · dia de empate]
			VAR _ppL = [T08 · período · parte Lula]
			VAR _ppF = [T08 · período · parte Flávio]
			VAR _noPer = NOT ISBLANK ( _per ) && ISBLANK ( _dia ) -- o dia clicado vale mais que o período
			-- 2 · Textos
			VAR _modo = SWITCH ( TRUE (), NOT ISBLANK ( _dia ), "dia", NOT ISBLANK ( _ufEsc ), "uf", "brasil" )
			-- os dias da campanha (desde 16/08, T08 · campanha · início), na série que a curva mostra: a do Brasil ou a do estado
			-- clicado. Quem ficou na frente em mais dias abre a frase (a mesma regra para os dois; no empate, Lula primeiro, na
			-- ordem da tela); o outro vem depois, com quantos dos dias dele foram depois do debate da Band
			VAR _cA = IF ( _dF > _dL, "Flávio", "Lula" )
			VAR _cB = IF ( _cA = "Lula", "Flávio", "Lula" )
			VAR _nA = IF ( _cA = "Lula", _dL, _dF )
			VAR _nB = IF ( _cA = "Lula", _dF, _dL )
			VAR _kB = IF ( _cA = "Lula", _dFdep, _dLdep )
			-- o ponto do Google com a noite do debate da Band (19/10: o dia do Google fecha às 21h de Brasília) não é "depois"
			-- do debate; se quem ficou atrás na campanha liderou nele, a frase diz isso
			VAR _noite =
			    IF (
			        _cB = "Flávio",
			        [T08 · debate · Flávio] > [T08 · debate · Lula],
			        [T08 · debate · Lula] > [T08 · debate · Flávio]
			    )
			VAR _txtDep =
			    SWITCH (
			        TRUE (),
			        _noite && _nB = 1, ", na noite do debate da Band",
			        _noite && _nB = 2 && _kB = 1, ", um na noite do debate da Band e outro depois",
			        _noite && _kB = _nB - 1, ", um na noite do debate da Band e " & _kB & " depois",
			        _kB = 0, "",
			        _kB = _nB, SWITCH ( _nB, 1, ", depois do debate da Band", 2, ", ambos depois do debate da Band", ", todos depois do debate da Band" ),
			        _kB = 1, ", um deles depois do debate da Band",
			        _kB = 2, ", dois deles depois do debate da Band",
			        ", " & _kB & " deles depois do debate da Band"
			    )
			VAR _manBrasil =
			    IF (
			        _nA = _nB,
			        "Lula e Flávio foram mais buscados no mesmo número de dias da campanha: " & _nA & " cada um, dos " & _dias,
			        _cA & " foi mais buscado que " & _cB & " em " & _nA & " dos " & _dias & " dias da campanha; "
			            & SWITCH (
			                TRUE (),
			                _nB = 0, _cB & " não ficou na frente em nenhum",
			                -- liderou no ponto da noite do debate: a frase curta cabe em duas linhas
			                _noite && _nB = 1, _cB & " liderou só na noite do debate da Band",
			                _noite, _cB & " liderou na noite do debate da Band e em mais " & _nB - 1 & IF ( _nB = 2, " dia", " dias" ),
			                _cB & " ficou na frente em " & _nB & IF ( _nB = 1, " dia", " dias" ) & _txtDep
			            )
			    )
			-- no dia: quem foi mais buscado e, se for o caso, a posição do dia para quem liderou
			VAR _lider = SWITCH ( TRUE (), _iL > _iF, "Lula", _iF > _iL, "Flávio", "" )
			VAR _outro = IF ( _lider = "Lula", "Flávio", "Lula" )
			VAR _pos = IF ( _lider = "Lula", _posL, _posF )
			VAR _txtPos =
			    SWITCH (
			        TRUE (),
			        _lider = "", "",
			        ISBLANK ( _pos ), "", -- dia antes da campanha (01 a 15/08): sem 'na campanha'
			        _pos = 1, ": o dia de mais buscas por " & _lider & " na campanha",
			        _pos <= 10, ": um dos 10 dias de mais buscas por " & _lider & " na campanha",
			        ""
			    )
			VAR _manDia =
			    "Em " & FORMAT ( _dia, "dd/MM" ) & ", "
			        & IF ( _lider = "", "os dois empataram nas buscas", _lider & " foi mais buscado que " & _outro ) & _txtPos
			-- no estado clicado, a mesma frase dos dias da campanha, na série do estado (consulta U2, desde 16/08), mais curta
			-- para caber em duas linhas com o nome do estado
			VAR _manUf =
			    IF (
			        _nA = _nB,
			        _uNo & ", Lula e Flávio foram mais buscados em " & _nA & " dos " & _dias & " dias da campanha cada um",
			        _uNo & ", " & _cA & " foi mais buscado em " & _nA & " dos " & _dias & " dias da campanha; "
			            & IF ( _nB = 0, _cB & " não ficou na frente em nenhum", _cB & ", em " & _nB & IF ( _nB = 1, " dia", " dias" ) & _txtDep )
			    )
			VAR _sob =
			    SWITCH (
			        _modo,
			        "dia", FORMAT ( _dia, "dd/MM" ) & IF ( NOT ISBLANK ( _ufEsc ), " · " & _uNome ) & " · " & _marco & " · índice do dia",
			        "uf", _uNome & " · 2º turno, 05 a 22/10",
			        "Quem o Brasil mais buscou · Central Google Trends, últimos 30 dias"
			    )
			VAR _lado =
			    SWITCH (
			        _modo,
			        "dia", "da soma dos dois índices no dia (Lula " & _iL & ", Flávio " & _iF & ", de 0 a 100)",
			        "uf", "das buscas pelos dois no estado, de 05 a 22/10",
			        "do interesse nas buscas pelos dois, de 22/09 a 22/10"
			    )
			VAR _txt =
			    SWITCH (
			        _modo,
			        "dia",
			            IF (
			                ISBLANK ( _ufEsc ),
			                "O índice vai de 0 a 100 dentro da consulta: 100 é o dia de mais buscas por Lula, " & FORMAT ( _pico, "dd/MM" )
			                    & ". Clique de novo no dia para voltar aos 30 dias.",
			                "O índice vai de 0 a 100 dentro da consulta do estado: 100 é o dia de mais buscas ali, " & FORMAT ( _pico, "dd/MM" )
			                    & ". Clique de novo no dia para voltar ao estado."
			            ),
			        "uf", "A curva abaixo agora é a do estado: 100 é o dia de mais buscas dentro do próprio estado, e o índice não se "
			            & "compara de um estado para outro. Clique de novo no estado para voltar.",
			        "O Google não diz quantas buscas houve: o Trends dá um índice de 0 a 100 dentro de cada consulta, em que 100 é o "
			            & "momento de mais procura. Só se comparam números da mesma consulta."
			    )
			VAR _pL = SWITCH ( _modo, "dia", _pdL, "uf", _upL, _cL )
			VAR _pF = SWITCH ( _modo, "dia", _pdF, "uf", _upF, _cF )
			VAR _man = SWITCH ( _modo, "dia", _manDia, "uf", _manUf, _manBrasil )
			-- período escolhido (sem dia clicado): os ramos 'brasil' e 'uf' passam a ser do período
			VAR _pDatas = MID ( _pRot, SEARCH ( " · ", _pRot, 1, 0 ) + 3, 40 ) -- "05 a 17/10", "21 e 22/10"
			VAR _pDe = IF ( CONTAINSSTRING ( _pDatas, " e " ), "em ", "de " ) & _pDatas
			VAR _pNomeMin = LOWER ( LEFT ( _pNome, 1 ) ) & MID ( _pNome, 2, 40 )
			VAR _semDadoP = _noPer && IF ( _modo = "uf", ISBLANK ( _upL ), ISBLANK ( _ppL ) )
			-- quem ficou na frente em mais dias (a mesma regra para os dois); um dia só vira a data
			VAR _pA = IF ( _pqF > _pqL, "Flávio", "Lula" )
			VAR _pB = IF ( _pA = "Lula", "Flávio", "Lula" )
			VAR _pnA = IF ( _pA = "Lula", _pqL, _pqF )
			VAR _pnB = IF ( _pA = "Lula", _pqF, _pqL )
			VAR _pdB = IF ( _pA = "Lula", _pqFD, _pqLD )
			VAR _manBrasilP =
			    SWITCH (
			        TRUE (),
			        _pnA = 0, _pNome & ", os dois empataram em todos os dias",
			        _pnA = _pnB,
			            _pNome & ", cada um foi mais buscado "
			                & IF (
			                    _pnA = 1,
			                    "num dos " & IF ( _pDias = 2, "dois", FORMAT ( _pDias, "0" ) ) & " dias: Lula em " & FORMAT ( _pqLD, "dd/MM" )
			                        & ", Flávio em " & FORMAT ( _pqFD, "dd/MM" ),
			                    "em " & _pnA & " dos " & _pDias & " dias"
			                ),
			        _pNome & ", " & _pA & " foi mais buscado que " & _pB & " em " & _pnA & " dos " & _pDias & " dias"
			            & IF ( _pnB > 0, "; " & _pB & " ficou na frente " & IF ( _pnB = 1, "em " & FORMAT ( _pdB, "dd/MM" ), "em " & _pnB & " dias" ) )
			            & IF ( _pqE > 0, "; empataram " & IF ( _pqE = 1, "em " & FORMAT ( _pqED, "dd/MM" ), "em " & _pqE & " dias" ) )
			    )
			VAR _manUfP =
			    _uNo & ", "
			        & SWITCH ( TRUE (), _ufL > _ufF, "Lula foi mais buscado ", _ufF > _ufL, "Flávio foi mais buscado ", "os dois empataram nas buscas " )
			        & _pNomeMin
			VAR _sobP =
			    IF ( _modo = "uf", _uNome & " · " & _pRot, "Quem o Brasil mais buscou · " & _pRot )
			VAR _ladoP =
			    SWITCH (
			        TRUE (),
			        _semDadoP, "ainda sem dado: as consultas ao Google são de antes do debate de 23/10",
			        _modo = "uf", "das buscas pelos dois no estado, " & _pDe,
			        "da soma dos índices diários dos dois, " & _pDe
			    )
			VAR _manP =
			    SWITCH (
			        TRUE (),
			        _semDadoP, IF ( _modo = "uf", _uNo & ", ainda não há dado " & _pNomeMin, _pNome & ", ainda não há dado de buscas" ),
			        _modo = "uf", _manUfP,
			        _manBrasilP
			    )
			VAR _txtP =
			    SWITCH (
			        TRUE (),
			        _semDadoP, "Os números depois do debate da Globo chegam numa nova coleta do Google. Escolha outro período no "
			            & "filtro, ou nenhum para voltar ao 2º turno inteiro.",
			        _modo = "uf", _txt,
			        "A parte de cada um soma os índices dos dias do período na mesma consulta (0 a 100, em que 100 é o dia de mais "
			            & "procura), não o número de buscas." & " O dia do Google vai das 21h da véspera às 21h, no horário de Brasília."
			    )
			VAR _numL = IF ( _noPer, FORMAT ( IF ( _modo = "uf", _upL, _ppL ), "0%" ), FORMAT ( _pL, "0%" ) )
			VAR _numF = IF ( _noPer, FORMAT ( IF ( _modo = "uf", _upF, _ppF ), "0%" ), FORMAT ( _pF, "0%" ) )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t08a'>"
			        & "<div class='sob sobe'>" & IF ( _noPer, _sobP, _sob ) & "</div>"
			        & "<div class='par'>"
			            & IF (
			                _semDadoP,
			                -- período sem dado: a espera no lugar dos números (nunca zero)
			                "<div class='mao sobe d1' style='font-size:64px;color:var(--grafite);padding-bottom:14px'>aguardando</div>",
			                "<div class='cand l sobe d1'><div class='rot'>Lula</div><div class='num'>" & _numL & "</div></div>"
			                    & "<div class='x entra d2'>×</div>"
			                    & "<div class='cand f sobe d2'><div class='rot'>Flávio</div><div class='num'>" & _numF & "</div></div>"
			            )
			            & "<div class='lado sobe d3'>" & IF ( _noPer, _ladoP, _lado ) & "</div>"
			        & "</div>"
			        & "<div class='man sobe d4'>" & IF ( _noPer, _manP, _man ) & "</div>"
			        & "<div class='txt sobe d5'>" & IF ( _noPer, _txtP, _txt ) & "</div>"
			    & "</div>"
		displayFolder: T08 Buscas\Desenho
		lineageTag: 2505e843-7b65-5e7f-a65a-ea5d863c1fa6

	/// Texto para leitor de tela do dossiê de um dia (do Brasil ou do estado clicado nos cartões).
	measure 'T08 · Tooltip dia · ALT' =
			IF (
			    NOT ISBLANK ( [T08 · dia · Lula] ),
			    FORMAT ( [T08 · dia · data], "dd/MM" )
			        & IF ( NOT ISBLANK ( [T08 · escolha · UF] ), ", " & [T08 · UF · nome] )
			        & ": índice de Lula " & [T08 · dia · Lula] & " e de Flávio " & [T08 · dia · Flávio]
			        & IF ( NOT ISBLANK ( [T08 · escolha · UF] ), ", de 0 a 100 dentro do estado" ) & "."
			)
		displayFolder: T08 Buscas\Desenho
		lineageTag: c00056c5-30c0-5a6f-a690-066bf283f9f2

	/// Dossiê de um dia da curva das buscas (ttT08Dia, grão 'Trends tempo'[DataTexto]): o índice de cada um no dia, quem foi mais buscado e, nos dias que têm série por hora (01 a 07/10 e 15 a 21/10), a curva hora a hora com a hora do pico de cada um; nota à mão nos dias marcantes. Com um estado clicado nos cartões, o dia é o do estado (consulta U2): no lugar da curva por hora, que só existe para o Brasil, o lembrete de que o índice é de dentro do estado e, nos dias com 0, o porquê do zero. Só lê contas 'T08 · …'; a curva por hora lê 'T08 · hora · …' em cada hora do dia (igualdade na coluna do item).
	measure 'T08 · Tooltip dia · HTML' =
			-- 1 · Leituras
			VAR _uf = [T08 · escolha · UF]
			VAR _uNome = [T08 · UF · nome]
			VAR _pico = [T08 · pico · data]
			VAR _zero = [T08 · dia · nota do zero]
			VAR _d = [T08 · dia · data]
			VAR _camp = [T08 · campanha · início]
			VAR _l = [T08 · dia · Lula]
			VAR _f = [T08 · dia · Flávio]
			VAR _dif = [T08 · dia · diferença]
			VAR _h = [T08 · dia · horas]
			VAR _pl = [T08 · dia · pico na hora · Lula]
			VAR _pf = [T08 · dia · pico na hora · Flávio]
			VAR _hl = [T08 · dia · hora do pico · Lula]
			VAR _hf = [T08 · dia · hora do pico · Flávio]
			VAR _horas =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 23, 1 ),
			        "@k", FORMAT ( _d, "yyyy-MM-dd" ) & " " & FORMAT ( [Value], "00" ) & ":00"
			    )
			VAR _serie =
			    ADDCOLUMNS (
			        _horas,
			        "@l",
			            VAR _k = [@k]
			            RETURN
			                CALCULATE ( [T08 · hora · Lula], 'Trends tempo'[DataTexto] = _k ),
			        "@f",
			            VAR _k = [@k]
			            RETURN
			                CALCULATE ( [T08 · hora · Flávio], 'Trends tempo'[DataTexto] = _k )
			    )
			-- 2 · Textos
			VAR _txtQuem =
			    SWITCH (
			        TRUE (),
			        _dif > 0, "Lula foi mais buscado no dia.",
			        _dif < 0, "Flávio foi mais buscado no dia.",
			        NOT ISBLANK ( _zero ) && _l = 0, "Os dois aparecem com 0 no dia.", -- estado clicado: zero não é empate
			        "Os dois empataram no dia."
			    )
			VAR _evento =
			    SWITCH (
			        _d,
			        _camp, "começa a campanha",
			        DATE ( 2026, 10, 4 ), "o dia da eleição",
			        -- o dia do Google vai das 21h da véspera às 21h (Brasília): a noite de cada debate cai no ponto seguinte
			        DATE ( 2026, 10, 18 ), "até as 21h do debate da Band",
			        DATE ( 2026, 10, 19 ), "a noite do debate da Band (o dia do Google começa às 21h)",
			        DATE ( 2026, 10, 24 ), "a noite do debate da Globo (o dia do Google começa às 21h)",
			        ""
			    )
			VAR _quemZero =
			    SWITCH ( TRUE (), _l = 0 && _f = 0, "dos dois", _l = 0, "de Lula", "de Flávio" )
			VAR _txtEstado =
			    IF ( NOT ISBLANK ( _zero ), "O 0 " & _quemZero & " é " & _zero & ", não falta de busca. " )
			        & "Índice de 0 a 100 dentro do estado: 100 é o dia de mais buscas ali (" & FORMAT ( _pico, "dd/MM" )
			        & "). A curva hora a hora só existe para o Brasil."
			VAR _txtPico =
			    "Pico: Lula às " & _hl & "h (" & _pl & "), Flávio às " & _hf & "h (" & _pf & ")"
			-- 3 · Geometria (curva por hora: 400 × 92; índice 0–100)
			VAR _f2 = "0.0"
			VAR _pts =
			    ADDCOLUMNS (
			        FILTER ( _serie, NOT ISBLANK ( [@l] ) ), /* lista */
			        "@x", 34 + [Value] / 23 * 380, -- geometria
			        "@yl", 86 - [@l] * 0.8, -- geometria
			        "@yf", 86 - [@f] * 0.8 -- geometria
			    )
			VAR _linhaL = CONCATENATEX ( _pts, FORMAT ( [@x], _f2, "en-US" ) & "," & FORMAT ( [@yl], _f2, "en-US" ), " ", [Value], ASC )
			VAR _linhaF = CONCATENATEX ( _pts, FORMAT ( [@x], _f2, "en-US" ) & "," & FORMAT ( [@yf], _f2, "en-US" ), " ", [Value], ASC )
			VAR _eixo =
			    CONCATENATEX (
			        { 0, 6, 12, 18, 23 },
			        "<text x='" & FORMAT ( 34 + [Value] / 23 * 380, _f2, "en-US" ) & "' y='106' class='ex' text-anchor='middle'>"
			            & [Value] & "h</text>",
			        ""
			    )
			VAR _grafico =
			    IF (
			        NOT ISBLANK ( _uf ),
			        "<div class='nota sobe d4'>" & _txtEstado & "</div>",
			        IF (
			            _h > 0,
			            "<div class='sob sobe d4' style='margin-top:6px'>Hora a hora · 0 a 100 na semana</div>"
			                & "<svg width='420' height='112' viewBox='0 0 420 112'>"
			                    & "<line x1='34' x2='414' y1='86' y2='86' class='g'/><line x1='34' x2='414' y1='6' y2='6' class='g'/>"
			                    & "<text x='26' y='90' class='ex' text-anchor='end'>0</text><text x='26' y='10' class='ex' text-anchor='end'>100</text>"
			                    & _eixo
			                    & "<polyline points='" & _linhaF & "' class='hf traco-rapido' pathLength='1'/>"
			                    & "<polyline points='" & _linhaL & "' class='hl traco-rapido' pathLength='1'/>"
			                & "</svg>"
			                & "<div class='nota entra d6'>" & _txtPico & "</div>",
			            "<div class='nota sobe d4'>A curva hora a hora só existe de 01 a 07/10 e de 15 a 21/10.</div>"
			        )
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _l ),
			        "<div class='tt8d'>"
			            & "<div class='sob sobe'>" & FORMAT ( _d, "dd/MM" ) & IF ( ISBLANK ( _uf ), " · Google Trends, tópicos", " · " & _uNome ) & "</div>"
			            & "<div class='par sobe d2'>"
			                & "<div class='lula'><small>Lula</small><span class='num'>" & _l & "</span></div>"
			                & "<div class='flavio'><small>Flávio</small><span class='num'>" & _f & "</span></div>"
			                & IF ( _evento <> "", "<div class='mao entra d6' style='position:static;margin-left:auto;align-self:center'>" & _evento & "</div>" )
			            & "</div>"
			            & "<div class='txt sobe d3'>" & _txtQuem & "</div>"
			            & _grafico
			        & "</div>"
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: 506591e5-be95-5f5c-be54-55a56e987084

	/// Texto para leitor de tela do dossiê de uma UF.
	measure 'T08 · Tooltip UF · ALT' =
			VAR _per = [Período · escolhido]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _per ) && NOT ISBLANK ( [T08 · UF · Lula] ),
			            [T08 · UF · nome] & ", 2º turno: interesse de " & [T08 · UF · interesse Lula] & " por Lula e " & [T08 · UF · interesse Flávio]
			                & " por Flávio; buscas entre os dois: Lula " & [T08 · UF · Lula] & "%, Flávio " & [T08 · UF · Flávio] & "%.",
			        NOT ISBLANK ( _per ) && NOT ISBLANK ( [T08 · UF · interesse Lula] ),
			            [T08 · UF · nome] & ", " & [Período · rótulo] & ": "
			                & IF (
			                    ISBLANK ( [T08 · UF · Lula] ),
			                    "ainda sem dado de buscas.",
			                    "buscas entre os dois: Lula " & [T08 · UF · Lula] & "%, Flávio " & [T08 · UF · Flávio] & "%."
			                )
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: 8a0615a8-b9ca-537e-8686-2cdc5a0862cd

	/// Dossiê de uma UF no mapa das buscas (ttT08Uf, grão UF[UF]): o interesse pelos dois no estado no 2º turno (índice 0–100, 100 = o estado de mais interesse) e, no período todo, a parte de cada um nas buscas entre os 5 candidatos; nota à mão quando o estado está entre os que mais ou menos buscaram. Com um período escolhido no filtro Período, a linha dos cinco candidatos dá lugar à parte de cada um entre os dois no período (consulta U2 do estado); Depois da Globo, 'ainda sem dado'. Só lê contas 'T08 · UF · …' e 'Período · …'.
	measure 'T08 · Tooltip UF · HTML' =
			-- 1 · Leituras
			VAR _nome = [T08 · UF · nome]
			VAR _uf = [T08 · UF · sigla]
			VAR _iL = [T08 · UF · interesse Lula]
			VAR _iF = [T08 · UF · interesse Flávio]
			VAR _l = [T08 · UF · Lula]
			VAR _f = [T08 · UF · Flávio]
			VAR _c5L = [T08 · UF · Lula entre os 5]
			VAR _c5F = [T08 · UF · Flávio entre os 5]
			VAR _nivel = [T08 · UF · nível de interesse]
			VAR _per = [Período · escolhido]
			VAR _pRot = [Período · rótulo]
			-- 2 · Textos
			VAR _mao = SWITCH ( _nivel, "alto", "dos que mais buscaram", "baixo", "dos que menos buscaram", "" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _l ) || ( NOT ISBLANK ( _per ) && NOT ISBLANK ( _iL ) ),
			        "<div class='tt8u'>"
			            & "<div class='sob sobe'>" & _uf & " · 2º turno, 05 a 22/10</div>"
			            & "<div class='tt sobe d2'>" & _nome & "</div>"
			            & "<div class='par sobe d3'>"
			                & "<div class='lula'><small>Lula</small><span class='num'>" & _iL & "</span></div>"
			                & "<div class='flavio'><small>Flávio</small><span class='num'>" & _iF & "</span></div>"
			            & "</div>"
			            & "<div class='txt sobe d4'>Interesse no estado, de 0 a 100: 100 é o estado que mais buscou cada um.</div>"
			            & IF (
			                ISBLANK ( _per ),
			                "<div class='txt sobe d5'>De 01/08 a 22/10, entre os cinco candidatos: Lula " & _c5L
			                    & "% e Flávio " & _c5F & "% das buscas.</div>",
			                "<div class='txt sobe d5'>" & _pRot & ": "
			                    & IF ( ISBLANK ( _l ), "ainda sem dado de buscas.", "Lula " & _l & "% e Flávio " & _f & "% das buscas entre os dois." )
			                    & "</div>"
			            )
			            & IF ( _mao <> "", "<div class='mao entra d7'>" & _mao & "</div>" )
			        & "</div>"
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: ea104aec-f06d-511f-b940-54a23e823f33

	/// Texto para leitor de tela dos quadrados do mapa (um por UF).
	measure 'T08 · UFs · ALT' =
			IF (
			    ISBLANK ( [Período · escolhido] ),
			    "Mapa de quadrados com as " & [T08 · UFs] & " unidades da federação: a barra divide as buscas entre Lula e Flávio; o fundo mais escuro marca mais interesse. Passe o mouse num estado.",
			    IF (
			        [T08 · UFs] = 0,
			        "Mapa de quadrados das unidades da federação, " & [Período · nome] & ": ainda sem dado de buscas. Passe o mouse num estado.",
			        "Mapa de quadrados com as " & [T08 · UFs] & " unidades da federação, " & [Período · nome] & ": a barra divide as buscas entre Lula e Flávio no período. Passe o mouse num estado."
			    )
			)
		displayFolder: T08 Buscas\Desenho
		lineageTag: 9f2d6a10-2944-5466-9c51-2481bd8313d6

	/// Um quadrado por UF (grão UF[UF]) no mapa de quadrados das buscas do 2º turno: a sigla, a parte de cada um nas buscas entre os dois (números e barra que cresce dos dois lados) e o fundo mais escuro onde o interesse pelos dois foi maior. Cada quadrado abre o dossiê ttT08Uf. Vazio no exterior e sem dado. Com um período escolhido no filtro Período, a parte de cada um é a do período (consulta U2 do estado) e o fundo fica igual em todos (o interesse por estado só existe para o 2º turno inteiro); no período sem dado (Depois da Globo), o quadrado fica só com a sigla, tracejado.
	measure 'T08 · UFs · HTML' =
			-- 1 · Leituras
			VAR _uf = [T08 · UF · sigla]
			VAR _l = [T08 · UF · Lula]
			VAR _f = [T08 · UF · Flávio]
			VAR _int = [T08 · UF · interesse médio]
			VAR _col = [T08 · UF · coluna]
			VAR _lin = [T08 · UF · linha]
			VAR _noPer = NOT ISBLANK ( [Período · escolhido] )
			-- 3 · Geometria (quadrado 68 × 44, passo 74 × 46, a grade começa em y 150)
			VAR _x = 4 + _col * 74 -- geometria
			VAR _y = 150 + _lin * 46 -- geometria
			VAR _alfa = IF ( _noPer, 0.4, MIN ( 1, MAX ( 0.12, 0.12 + ( _int - 45 ) / 55 * 0.88 ) ) ) -- geometria
			VAR _atraso = 500 + ( _col + _lin ) * 70 -- geometria
			VAR _larL = _l / ( _l + _f ) * 100 -- geometria
			VAR _larF = 100 - _larL -- geometria
			-- 4 · Marcação
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _l ),
			        "<div class='tela t08u'><div class='q' style='left:" & _x & "px;top:" & _y & "px;background:rgba(203,189,162,"
			            & FORMAT ( _alfa, "0.00", "en-US" ) & ");animation-delay:" & _atraso & "ms'>"
			            & "<b>" & _uf & "</b><span class='vl'>" & _l & "</span><span class='vf'>" & _f & "</span>"
			            & "<div class='br'><i class='l barra-x' style='width:" & FORMAT ( _larL, "0.0", "en-US" ) & "%;animation-delay:"
			            & _atraso + 300 & "ms'></i><i class='f barra-x-dir' style='width:" & FORMAT ( _larF, "0.0", "en-US" )
			            & "%;animation-delay:" & _atraso + 300 & "ms'></i></div>"
			        & "</div></div>",
			        -- período sem dado: só a sigla, tracejado (nunca zero)
			        _noPer && NOT ISBLANK ( _int ),
			        "<div class='tela t08u'><div class='q esp' style='left:" & _x & "px;top:" & _y & "px;animation-delay:" & _atraso
			            & "ms'><b>" & _uf & "</b></div></div>"
			    )
		displayFolder: T08 Buscas\Desenho
		lineageTag: 4cac6a33-52a2-5e9f-a4e2-5d31c1a175a1

	/// Quantos dias tem a janela de interações da Bites na campanha do 1º turno, 16/08 a 04/10 (os dois extremos inclusos).
	measure 'T09 · 1º turno · dias' =
			DATEDIFF ( [T09 · 1º turno · início], [T09 · 1º turno · fim], DAY ) + 1
		formatString: 0
		displayFolder: T09 Redes\Contas
		lineageTag: 1de0a4b3-b17d-5dd0-882f-996b30846356

	/// Último dia da janela de interações da Bites na campanha do 1º turno, 16/08 a 04/10.
	measure 'T09 · 1º turno · fim' =
			CALCULATE ( MAX ( Monitoramento[Fim] ), REMOVEFILTERS ( Monitoramento ), Monitoramento[Métrica] = "interações nos perfis oficiais (X, Instagram, Facebook, TikTok, YouTube)", Monitoramento[Início] = DATE ( 2026, 8, 16 ) )
