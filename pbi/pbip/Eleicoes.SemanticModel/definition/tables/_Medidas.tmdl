	/// 1 com estado ou região escolhido no filtro de estado da casca (as contas somam os municípios das UFs escolhidas), 0 no Brasil (o total oficial, com o exterior).
	measure 'T06 · com UF' =
			INT ( ISCROSSFILTERED ( 'UF' ) )
		formatString: 0
		displayFolder: T06 Ausência\Contas
		lineageTag: f8952382-d2fa-5b4d-af12-d9db1f345a99

	/// Diferença de votos entre os dois primeiros no 1º turno do ano da linha: no Brasil, o resultado oficial (com o exterior); com UF, PT × principal adversário nos municípios da UF.
	measure 'T06 · diferença do ano' =
			IF (
			    [T06 · com UF] = 1,
			    ABS ( [T06 · votos do PT (ano)] - [T06 · votos do adversário (ano)] ),
			    CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Candidato ano'[Posição] = 1 )
			        - CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Candidato ano'[Posição] = 2 )
			)
		formatString: #,0
		displayFolder: T06 Ausência\Contas
		lineageTag: 27958b11-e97d-5394-8e22-63d95048ea20

	/// Diferença de votos entre Flávio e Lula no 1º turno de 2026, no recorte, sem sinal.
	measure 'T06 · diferença Flávio Lula' =
			ABS (
			    CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 22 )
			        - CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 13 )
			)
		formatString: #,0
		displayFolder: T06 Ausência\Contas
		lineageTag: 959b7517-cab9-519b-ba85-729def936539

	/// Os dois primeiros do 1º turno do ano da linha, o mais votado antes: no Brasil, o resultado oficial ('Candidato ano'); com UF, o candidato do PT e o principal adversário na ordem dos votos na UF.
	measure 'T06 · disputa do ano' =
			VAR _1 = CALCULATE ( SELECTEDVALUE ( 'Candidato ano'[Candidato] ), 'Candidato ano'[Posição] = 1 )
			VAR _2 = CALCULATE ( SELECTEDVALUE ( 'Candidato ano'[Candidato] ), 'Candidato ano'[Posição] = 2 )
			VAR _pt = SELECTEDVALUE ( 'Ano'[Candidato do PT] )
			VAR _adv = SELECTEDVALUE ( 'Ano'[Adversário] )
			RETURN
			    IF (
			        [T06 · com UF] = 1,
			        IF ( [T06 · votos do PT (ano)] >= [T06 · votos do adversário (ano)], _pt & " e " & _adv, _adv & " e " & _pt ),
			        IF ( NOT ISBLANK ( _1 ), _1 & " e " & _2 )
			    )
		displayFolder: T06 Ausência\Contas
		lineageTag: 003f3579-c188-5c28-8266-3da1c22fc4a4

	/// Parcela de quem não escolheu ninguém que nem foi votar, no ano do contexto (0–1).
	measure 'T06 · faltaram entre quem não escolheu (ano)' =
