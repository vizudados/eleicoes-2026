	/// Quantas UFs do escopo têm Lula à frente (o exterior não conta como UF).
	measure 'Apuração · UFs com Lula à frente' =
			COUNTROWS (
			    FILTER (
			        CALCULATETABLE ( VALUES ( 'UF'[UF] ), KEEPFILTERS ( 'UF'[Tipo] = "UF" ) ),
			        [Apuração · Lula votos] > [Apuração · Flávio votos]
			    )
			) + 0
		formatString: 0
