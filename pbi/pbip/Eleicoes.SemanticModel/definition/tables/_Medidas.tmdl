	/// Posição de 'Quem ganhou a eleição?' na lista das perguntas mais buscadas de 05 a 08/10 (Google Trends obtido pelo Estadão). Constante: trends_consultas.csv (fora do modelo).
	measure 'T08 · pergunta · quem ganhou a eleição · posição' =
