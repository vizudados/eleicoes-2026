	/// Janela da pesquisa do contexto (Pesquisa[Id]) em relação aos debates: antes, atravessa ou depois; vazio fora do 2º turno em votos totais ou antes da Band.
	measure 'T26 · pesquisa · janela' =
			VAR _band = [T26 · Band · data]
			VAR _globo = [T26 · debate · dia]
			VAR _ini = MIN ( Pesquisa[Campo início] )
			VAR _fim = MAX ( Pesquisa[Campo fim] )
			VAR _ok =
			    HASONEVALUE ( Pesquisa[Id] )
			        && SELECTEDVALUE ( Pesquisa[Cenário] ) = "2º turno"
			        && SELECTEDVALUE ( Pesquisa[Tipo] ) = "totais"
			        && NOT ISBLANK ( MAX ( Pesquisa[Lula] ) )
			        && NOT ISBLANK ( MAX ( Pesquisa[Flavio] ) )
			RETURN
			    IF (
			        _ok,
			        SWITCH (
			            TRUE (),
			            _ini > _globo, "depois",
			            _ini > _band && _fim < _globo, "antes",
			            _ini <= _globo && _fim >= _globo, "atravessa"
			        )
			    )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: f7d86235-e58f-55a0-a28d-a516d5a38a8d

	/// Lula da pesquisa do contexto (Pesquisa[Id]).
	measure 'T26 · pesquisa · Lula' =
			MAX ( Pesquisa[Lula] )
		formatString: 0.0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 7627daf1-f147-57d8-b606-d0281e3a05df

	/// Média simples de Flávio (votos totais, %) nas pesquisas com o campo inteiro entre os dois debates (começa depois da Band, termina antes do dia da Globo).
	measure 'T26 · pesquisas · antes · Flávio' =
			VAR _band = [T26 · Band · data]
			VAR _globo = [T26 · debate · dia]
			RETURN
			    CALCULATE (
			        AVERAGE ( Pesquisa[Flavio] ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "2º turno",
			        Pesquisa[Tipo] = "totais",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Campo início] > _band,
			        Pesquisa[Campo fim] < _globo
			    )
		formatString: 0.0
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: d5ab1828-461d-5d79-984a-6c3bc3654eda

	/// Média simples de Lula (votos totais, %) nas pesquisas com o campo inteiro entre os dois debates (começa depois da Band, termina antes do dia da Globo).
