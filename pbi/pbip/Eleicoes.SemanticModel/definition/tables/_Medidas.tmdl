	/// % dos votos válidos de Flávio no 1º turno de 2026 (TSE), em pontos de 0 a 100, na mesma unidade das pesquisas.
	measure 'T10 · urna · Flávio' =
			CALCULATE (
			    DIVIDE ( SUM ( 'Candidato ano'[Votos] ), MAX ( 'Candidato ano'[ValidosAno] ) ) * 100,
			    REMOVEFILTERS ( 'Candidato ano' ),
			    'Candidato ano'[Ano] = 2026,
			    'Candidato ano'[Partido] = "PL"
			)
		formatString: 0.00
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 987786e7-3388-51b6-a30a-e486848f6157

	/// % dos votos válidos de Lula no 1º turno de 2026 (TSE), em pontos de 0 a 100, na mesma unidade das pesquisas.
	measure 'T10 · urna · Lula' =
			CALCULATE (
			    DIVIDE ( SUM ( 'Candidato ano'[Votos] ), MAX ( 'Candidato ano'[ValidosAno] ) ) * 100,
			    REMOVEFILTERS ( 'Candidato ano' ),
			    'Candidato ano'[Ano] = 2026,
