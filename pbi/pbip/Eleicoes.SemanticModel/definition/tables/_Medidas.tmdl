	/// Municípios do IBGE no painel (5.571).
	measure 'T00 · municípios no mapa' =
			CALCULATE ( COUNTROWS ( 'Município' ), REMOVEFILTERS ( 'UF' ) )
		formatString: #,0
		displayFolder: T00 Capa\Contas
		lineageTag: d1710c36-0d18-5a01-a41c-221698a00429

	/// Municípios em que Lula estava à frente em 2022 e Flávio ficou à frente em 2026 (margem do PT passou de positiva a negativa).
	measure 'T00 · municípios que viraram' =
			VAR _m =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[CodIBGE] ), REMOVEFILTERS ( 'UF' ) ),
			        "@m22", CALCULATE ( SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ), 'Ano'[Ano] = 2022 ),
			        "@m26", CALCULATE ( SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ), 'Ano'[Ano] = 2026 )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _m, [@m22] > 0 && [@m26] < 0 ) ) + 0
		formatString: #,0
		displayFolder: T00 Capa\Contas
		lineageTag: 4060ce9d-b97c-5833-84c1-c4a8db3344db

	/// O caminho inverso: municípios com o adversário do PT à frente em 2022 e Lula à frente em 2026.
	measure 'T00 · municípios que voltaram' =
			VAR _m =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[CodIBGE] ), REMOVEFILTERS ( 'UF' ) ),
			        "@m22", CALCULATE ( SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ), 'Ano'[Ano] = 2022 ),
			        "@m26", CALCULATE ( SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ), 'Ano'[Ano] = 2026 )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _m, [@m22] < 0 && [@m26] > 0 ) ) + 0
		formatString: #,0
		displayFolder: T00 Capa\Contas
		lineageTag: 153bcaab-bfd0-582a-953d-7c2078adcbe1

	/// Votos válidos do 1º turno de 2026, Brasil com o exterior.
	measure 'T00 · válidos' =
			CALCULATE ( MAX ( 'Candidato ano'[ValidosAno] ), 'Candidato ano'[Ano] = 2026, REMOVEFILTERS ( 'UF' ) )
		formatString: #,0
		displayFolder: T00 Capa\Contas
		lineageTag: c2b2852f-e812-5f3a-84dd-e6b6a7d5abc3

	/// Texto alternativo da capa.
	measure 'T00 · Capa · ALT' =
			"Eleições 2026, 1º turno presidencial: o voto, de perto. Flávio Bolsonaro " & FORMAT ( [T00 · Flávio %], "0.0%" )
			    & " dos válidos, Lula " & FORMAT ( [T00 · Lula %], "0.0%" ) & "; " & FORMAT ( [T00 · municípios que viraram], "#,0" )
			    & " municípios mudaram de lado."
		displayFolder: T00 Capa\Desenho
		lineageTag: 0d864498-c632-554f-b66c-f1122cf1f603

	/// Os números da capa (o vídeo, o título e a composição fixa estão no bodyTemplate do visual): os dois candidatos em blocos simétricos, os municípios que mudaram de lado e os do mapa. Os números contam na entrada.
	measure 'T00 · Capa · HTML' =
			VAR _f = [T00 · Flávio votos]
			VAR _l = [T00 · Lula votos]
			VAR _fp = [T00 · Flávio %]
			VAR _lp = [T00 · Lula %]
			VAR _vir = [T00 · municípios que viraram]
			VAR _n = [T00 · municípios no mapa]
			RETURN
			    "<div class='bl esq sobe d6'><div class='rot'>FLÁVIO BOLSONARO · PL</div><div class='num v flavio-c'>"
			        & FORMAT ( _f / 1e6, "0.00" ) & " mi</div><div class='p'>" & FORMAT ( _fp * 100, "0.0" ) & "% dos válidos</div></div>"
			        & "<div class='bl dir sobe d7'><div class='rot'>LULA · PT</div><div class='num v lula-c'>"
			        & FORMAT ( _l / 1e6, "0.00" ) & " mi</div><div class='p'>" & FORMAT ( _lp * 100, "0.0" ) & "% dos válidos</div></div>"
			        & "<div class='pe-esq sobe d10'><span class='vir'><span class='num'>" & FORMAT ( _vir, "#,0" ) & "</span>"
			        & "<span class='risco'></span></span> municípios mudaram de lado</div>"
			        & "<div class='pe-dir sobe d11'><span class='num'>" & FORMAT ( _n, "#,0" ) & "</span> municípios, um ponto cada</div>"
		displayFolder: T00 Capa\Desenho
		lineageTag: cadebdf1-e508-53eb-a59d-e62670da03cd

	/// Parcela do candidato do item nos válidos de 2026 da UF da linha (0–1); vazio no exterior. Base das contas do dossiê.
	measure 'T01 · % do candidato na UF' =
			IF (
			    SELECTEDVALUE ( 'UF'[Tipo] ) = "UF",
			    DIVIDE (
			        [T01 · votos do candidato],
			        CALCULATE ( [T01 · votos do candidato], REMOVEFILTERS ( 'Candidato UF'[Candidato] ) )
			    )
			)
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 54c8f4b8-6c15-5cbc-94cb-283ac32c9ea3

	/// Parcela dos válidos do candidato do item na UF mais forte (0–1), entre as UFs do dossiê.
	measure 'T01 · % na UF mais forte do candidato' =
			VAR _noRecorte = [T01 · dossiê no recorte]
			VAR _sel = CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
			VAR _todas =
			    CALCULATETABLE (
			        ADDCOLUMNS ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome] ), "@p", [T01 · % do candidato na UF] ),
			        REMOVEFILTERS ( 'UF' ),
			        'UF'[Tipo] = "UF"
			    )
			VAR _ufs = FILTER ( _todas, _noRecorte = 0 || 'UF'[UF] IN _sel )
			RETURN
			    MAXX ( _ufs, [@p] )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 9c6d5c8b-36c0-5565-b04d-467fe271748f

	/// Parcela dos válidos do candidato do item na UF mais fraca (0–1), entre as UFs do dossiê.
	measure 'T01 · % na UF mais fraca do candidato' =
			VAR _noRecorte = [T01 · dossiê no recorte]
			VAR _sel = CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
			VAR _todas =
			    CALCULATETABLE (
			        ADDCOLUMNS ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome] ), "@p", [T01 · % do candidato na UF] ),
			        REMOVEFILTERS ( 'UF' ),
			        'UF'[Tipo] = "UF"
			    )
			VAR _ufs = FILTER ( _todas, _noRecorte = 0 || 'UF'[UF] IN _sel )
			RETURN
			    MINX ( _ufs, [@p] )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: d0088da1-84bd-53d6-b70d-b16ef1b86dcb

	/// 1 com estado ou região escolhido no filtro de estado da casca (a tela mostra a soma das UFs escolhidas), 0 no Brasil: a medida comum [Recorte · com escolha].
	measure 'T01 · com UF' =
			[Recorte · com escolha]
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: 142e9a51-44b5-5c55-9ae9-b30980ff5d1f

	/// Nomes dos candidatos do 5º lugar em diante, do mais ao menos votado ('A, B e C').
	measure 'T01 · demais nomes' =
			VAR _lista =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Candidato UF'[Candidato] ), 'Candidato UF'[Ano] = 2026 ),
			            "@v", [T01 · votos do candidato],
			            "@p", [T01 · posição do candidato]
			        ),
			        [@p] >= 5 && [@v] > 0
			    )
			VAR _n = COUNTROWS ( _lista )
			VAR _ord = ADDCOLUMNS ( _lista, "@r", RANKX ( _lista, [@v], , DESC, DENSE ) )
			RETURN
			    CONCATENATEX (
			        _ord,
			        'Candidato UF'[Candidato] & SWITCH ( TRUE (), [@r] = _n, "", [@r] = _n - 1, " e ", ", " ),
			        "",
			        [@v], DESC
			    )
		displayFolder: T01 Placar\Contas
		lineageTag: e9a3b283-6ffc-586a-a72e-cfec5bb96c8e

	/// Parcela dos candidatos do 5º lugar em diante nos válidos (0–1).
	measure 'T01 · demais parte' =
			DIVIDE ( [T01 · demais votos], [T01 · válidos] )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: ae2252ed-c129-5c30-9b35-2d7a4dd2a601

	/// Quantos candidatos ficaram do 5º lugar em diante, no recorte.
	measure 'T01 · demais quantidade' =
			VAR _lista =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Candidato UF'[Candidato] ), 'Candidato UF'[Ano] = 2026 ),
			            "@v", [T01 · votos do candidato],
			            "@p", [T01 · posição do candidato]
			        ),
			        [@p] >= 5 && [@v] > 0
			    )
			RETURN
			    COUNTROWS ( _lista )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: 38454b63-e9f5-5d64-9c0d-291fc10e4d21

	/// Votos somados dos candidatos do 5º lugar em diante, no recorte.
	measure 'T01 · demais votos' =
			VAR _lista =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Candidato UF'[Candidato] ), 'Candidato UF'[Ano] = 2026 ),
			            "@v", [T01 · votos do candidato],
			            "@p", [T01 · posição do candidato]
			        ),
			        [@p] >= 5 && [@v] > 0
			    )
			RETURN
			    SUMX ( _lista, [@v] )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 716388d0-6008-5e05-a944-d267d921fcc2

	/// Diferença de votos entre Flávio e Lula em 2026, sem sinal.
	measure 'T01 · diferença' =
			ABS ( [T01 · Flávio votos] - [T01 · Lula votos] )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 37442b0b-e98e-585c-9a74-fe5404b92f9c

	/// Diferença entre os percentuais de Flávio e Lula, em pontos percentuais, sem sinal.
	measure 'T01 · diferença em p.p.' =
			ABS ( [T01 · Flávio %] - [T01 · Lula %] ) * 100
		formatString: 0.0
		displayFolder: T01 Placar\Contas
		lineageTag: 22e21d17-8f7a-58d8-ae77-52571fdcfbd8

	/// 1 quando a distância entre PT e PL em 2026 é menor que em 2022, no recorte.
	measure 'T01 · distância encolheu' =
			VAR _d22 = ABS ( [T01 · PT 2022 votos] - [T01 · PL 2022 votos] )
			VAR _d26 = ABS ( [T01 · Lula votos] - [T01 · Flávio votos] )
			RETURN
			    IF ( _d26 < _d22, 1, 0 )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: 3bc1e5ca-c0f7-5ec7-9f3b-8d4018b18d12

	/// 1 quando o recorte tem mais de uma UF (uma região inteira ou vários estados): o dossiê do candidato compara as UFs de dentro dele; 0 no Brasil e com um estado só (aí o dossiê compara as 27).
	measure 'T01 · dossiê no recorte' =
			IF ( [Recorte · com escolha] = 1 && [Recorte · UFs] > 1, 1, 0 )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: fe7f6313-6d6d-521d-8c57-adfced61bf65

	/// Parcela de Flávio nos votos válidos de 2026 (0–1).
	measure 'T01 · Flávio %' =
			DIVIDE ( [T01 · Flávio votos], [T01 · válidos] )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 53bef1ac-c6a6-54f8-89a9-b35d42c4e82f

	/// Votos de Flávio (número 22) no 1º turno de 2026, no recorte.
	measure 'T01 · Flávio votos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 22 )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 26403df8-9d6e-5754-8390-3f27b09fa03f

	/// Onde o candidato do item começa na barra dos válidos: soma das parcelas dos mais votados que ele (0–1).
	measure 'T01 · início na barra' =
			VAR _v = [T01 · votos do candidato]
			VAR _todos =
			    CALCULATETABLE (
			        VALUES ( 'Candidato UF'[Candidato] ),
			        REMOVEFILTERS ( 'Candidato UF'[Candidato] ),
			        'Candidato UF'[Ano] = 2026
			    )
			VAR _antes = SUMX ( FILTER ( _todos, [T01 · votos do candidato] > _v ), [T01 · votos do candidato] )
			RETURN
			    IF ( _v > 0, DIVIDE ( _antes, CALCULATE ( [T01 · válidos], REMOVEFILTERS ( 'Candidato UF'[Candidato] ) ) ) )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 1ce3fc15-d54a-50b4-85f2-820c56e75fef

	/// Parcela de Lula nos votos válidos de 2026 (0–1).
	measure 'T01 · Lula %' =
			DIVIDE ( [T01 · Lula votos], [T01 · válidos] )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 2b18bc84-7811-5e37-bb86-d9ad5445ffe2

	/// Votos de Lula (número 13) no 1º turno de 2026, no recorte.
	measure 'T01 · Lula votos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 13 )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 12313c9c-b730-5d7b-b99d-7da882fdd995

	/// Número de urna do candidato do item em 2026.
	measure 'T01 · número do candidato' =
			CALCULATE ( SELECTEDVALUE ( 'Candidato UF'[Número] ), 'Candidato UF'[Ano] = 2026 )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: 3f4cdab0-4b07-559c-bfe8-2e3537f7a4d5

	/// Ordem do porte da linha (1 = até 10 mil habitantes), para listar do menor ao maior.
	measure 'T01 · ordem do porte' =
			MIN ( 'Município'[PorteOrdem] )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: eb000430-2b9a-5995-8172-c4ae5e4e65a0

	/// Parcela do candidato do item nos válidos de 2026 do recorte (0–1).
	measure 'T01 · parte dos válidos' =
			DIVIDE (
			    [T01 · votos do candidato],
			    CALCULATE ( [T01 · válidos], REMOVEFILTERS ( 'Candidato UF'[Candidato] ) )
			)
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 5c3f4737-eba4-520b-be73-69683edc9594

	/// Sigla do partido do candidato do item em 2026.
	measure 'T01 · partido do candidato' =
			CALCULATE ( SELECTEDVALUE ( 'Candidato UF'[Partido] ), 'Candidato UF'[Ano] = 2026 )
		displayFolder: T01 Placar\Contas
		lineageTag: 10a6ee5b-5554-5d8f-9dbf-3ccd25fa1259

	/// Parcela do PL nos válidos de 2022 (0–1).
	measure 'T01 · PL 2022 %' =
			DIVIDE ( [T01 · PL 2022 votos], [T01 · válidos 2022] )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 96a766a3-0c32-5172-bb51-ad2fdeddfefb

	/// Nome de urna do candidato do PL em 2022.
	measure 'T01 · PL 2022 candidato' =
			CALCULATE ( SELECTEDVALUE ( 'Candidato UF'[Candidato] ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 22 )
		displayFolder: T01 Placar\Contas
		lineageTag: 96be3c6d-d69f-5d23-9f95-988f416018d4

	/// Votos do candidato do PL (número 22) no 1º turno de 2022, no recorte.
	measure 'T01 · PL 2022 votos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 22 )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 90bfeb9b-ac50-52b8-a169-6b7dd8d23c06

	/// Votos do PL em 2026 menos 2022, no recorte (positivo = ganhou).
	measure 'T01 · PL variação' =
			[T01 · Flávio votos] - [T01 · PL 2022 votos]
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: d392ba4e-f1cc-5a96-a2b4-ebba48e5ca16

	/// Parcela do partido do ponto nos válidos de 2022 da região ou do porte da linha (0–1).
	measure 'T01 · ponto · % no grupo em 2022' =
			DIVIDE ( [T01 · ponto · votos no grupo em 2022], CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2022 ) )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 4441609d-4166-5c99-bcb5-bc866cd756d6

	/// Parcela do partido do ponto nos válidos de 2026 da região ou do porte da linha (0–1).
	measure 'T01 · ponto · % no grupo em 2026' =
			DIVIDE ( [T01 · ponto · votos no grupo em 2026], CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2026 ) )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: 29b74c59-cbeb-5432-8553-263d27f897e8

	/// Ano do ponto da virada (linha do grão 'Candidato UF'[Ano]).
	measure 'T01 · ponto · ano' =
			SELECTEDVALUE ( 'Candidato UF'[Ano] )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: d6d894e5-8da4-5116-aaa8-53517d2c678c

	/// Nome de urna do candidato do ponto da virada.
	measure 'T01 · ponto · candidato' =
			SELECTEDVALUE ( 'Candidato UF'[Candidato] )
		displayFolder: T01 Placar\Contas
		lineageTag: a6fbba95-41aa-5957-81f1-2113ec06645d

	/// Quantas UFs o recorte tem, para o dossiê do ponto avisar quando mostra só as 5 com mais votos.
	measure 'T01 · ponto · estados no recorte' =
			[Recorte · UFs]
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: b2f5397c-1cb4-5973-83d9-85be7c9a2128

	/// Como o dossiê do ponto divide os votos: 'região' no Brasil, 'porte' (tamanho de cidade) num estado só, 'estado' num recorte de vários (uma região inteira ou estados soltos).
	measure 'T01 · ponto · grupo' =
			SWITCH (
			    TRUE (),
			    [Recorte · com escolha] = 0, "região",
			    [Recorte · UFs] = 1, "porte",
			    "estado"
			)
		displayFolder: T01 Placar\Contas
		lineageTag: 0d766971-5cab-575d-a44e-63e15607a523

	/// Número do candidato do ponto da virada (13 = PT, 22 = PL).
	measure 'T01 · ponto · número' =
			SELECTEDVALUE ( 'Candidato UF'[Número] )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: f4518bba-38f9-5b6a-97b3-b4dbbb93a384

	/// Parcela dos votos do partido do ponto, no ano do ponto, que veio do estado da linha, dentro do recorte de vários estados (0–1). Tira só o estado da linha: o recorte (o filtro de estado, em 'UF'[Caminho]) fica.
	measure 'T01 · ponto · parte do estado' =
			DIVIDE (
			    [T01 · ponto · votos no grupo],
			    CALCULATE ( [T01 · ponto · votos no grupo], REMOVEFILTERS ( 'UF'[UF], 'UF'[Nome] ) )
			)
		formatString: 0%
		displayFolder: T01 Placar\Contas
		lineageTag: bf4fcadd-f929-5686-856d-28e4f725b665

	/// Parcela dos votos do partido do ponto, no ano do ponto, que veio da região ou do porte da linha (0–1). Tira só as colunas do grupo.
	measure 'T01 · ponto · parte do grupo' =
			DIVIDE ( [T01 · ponto · votos no grupo], CALCULATE ( [T01 · ponto · votos no grupo], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ), REMOVEFILTERS ( 'Município'[Porte], 'Município'[PorteOrdem] ) ) )
		formatString: 0%
		displayFolder: T01 Placar\Contas
		lineageTag: ca771b2b-a258-520d-98c2-0ae8a482601e

	/// Sigla do partido do candidato do ponto da virada.
	measure 'T01 · ponto · partido' =
			SELECTEDVALUE ( 'Candidato UF'[Partido] )
		displayFolder: T01 Placar\Contas
		lineageTag: 65c88fd0-4d27-5a95-8c2b-7328470b587f

	/// Votos do partido do ponto em 2026 menos 2022 na região ou no porte da linha.
	measure 'T01 · ponto · variação no grupo' =
			[T01 · ponto · votos no grupo em 2026] - [T01 · ponto · votos no grupo em 2022]
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: bcfdec83-c237-579f-baec-8dbfb091cf8a

	/// Votos do partido do ponto (PT ou PL) no ano do ponto, somados nos municípios do contexto (sem o exterior): a região ou o porte da linha do dossiê.
	measure 'T01 · ponto · votos no grupo' =
			VAR _a = [T01 · ponto · ano]
			VAR _n = [T01 · ponto · número]
			RETURN
			    SWITCH (
			        _n,
			        13, CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = _a ),
			        22, CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = _a )
			    )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: bbbb4e1f-befa-5c7d-95bf-6c0b0e1b16c9

	/// Votos do partido do ponto (PT ou PL) em 2022, somados nos municípios do contexto (sem o exterior): a região ou o porte da linha do dossiê.
	measure 'T01 · ponto · votos no grupo em 2022' =
			VAR _a = [T01 · ponto · ano]
			VAR _n = [T01 · ponto · número]
			RETURN
			    SWITCH (
			        _n,
			        13, CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2022 ),
			        22, CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2022 )
			    )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 42c8307e-bced-5189-9b6a-c1b04a625a0c

	/// Votos do partido do ponto (PT ou PL) em 2026, somados nos municípios do contexto (sem o exterior): a região ou o porte da linha do dossiê.
	measure 'T01 · ponto · votos no grupo em 2026' =
			VAR _a = [T01 · ponto · ano]
			VAR _n = [T01 · ponto · número]
			RETURN
			    SWITCH (
			        _n,
			        13, CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2026 ),
			        22, CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2026 )
			    )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 35dcdfb3-4fb3-5252-b1af-8324e0623c50

	/// Colocação do candidato do item em 2026, no recorte (1 = mais votado).
	measure 'T01 · posição do candidato' =
			VAR _v = [T01 · votos do candidato]
			VAR _todos =
			    CALCULATETABLE (
			        VALUES ( 'Candidato UF'[Candidato] ),
			        REMOVEFILTERS ( 'Candidato UF'[Candidato] ),
			        'Candidato UF'[Ano] = 2026
			    )
			RETURN
			    IF ( _v > 0, 1 + COUNTROWS ( FILTER ( _todos, [T01 · votos do candidato] > _v ) ) )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: 744ba1b2-fea6-54d8-89dd-b90d36011683

	/// Parcela do PT nos válidos de 2022 (0–1).
	measure 'T01 · PT 2022 %' =
			DIVIDE ( [T01 · PT 2022 votos], [T01 · válidos 2022] )
		formatString: 0.0%
		displayFolder: T01 Placar\Contas
		lineageTag: a009bca8-b51d-5cb0-a62a-ce4f68607fb7

	/// Nome de urna do candidato do PT em 2022.
	measure 'T01 · PT 2022 candidato' =
			CALCULATE ( SELECTEDVALUE ( 'Candidato UF'[Candidato] ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 13 )
		displayFolder: T01 Placar\Contas
		lineageTag: a56ac45d-5db2-5134-a8b7-7304d0d3f610

	/// Votos do candidato do PT (número 13) no 1º turno de 2022, no recorte.
	measure 'T01 · PT 2022 votos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 13 )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: ed18703a-4dff-5fb7-9e11-81ebbc3c4129

	/// Votos do PT em 2026 menos 2022, no recorte (negativo = perdeu).
	measure 'T01 · PT variação' =
			[T01 · Lula votos] - [T01 · PT 2022 votos]
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 27511fe3-8eb2-5128-98e0-1c581c3e4f52

	/// Nome do recorte, da medida comum [Recorte · nome]: 'Brasil', o estado ('Bahia'), a região inteira ('Nordeste') ou vários estados ('MG e SP', '3 estados').
	measure 'T01 · recorte' =
			[Recorte · nome]
		displayFolder: T01 Placar\Contas
		lineageTag: 50647a02-f28c-586b-b523-5dc05cb37876

	/// UF onde o candidato do item teve a maior parcela dos válidos: entre as 27 (sem escolha ou com um estado só) ou entre as UFs do recorte (região ou vários estados).
	measure 'T01 · UF mais forte do candidato' =
			VAR _noRecorte = [T01 · dossiê no recorte]
			VAR _sel = CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
			VAR _todas =
			    CALCULATETABLE (
			        ADDCOLUMNS ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome] ), "@p", [T01 · % do candidato na UF] ),
			        REMOVEFILTERS ( 'UF' ),
			        'UF'[Tipo] = "UF"
			    )
			VAR _ufs = FILTER ( _todas, _noRecorte = 0 || 'UF'[UF] IN _sel )
			RETURN
			    MAXX ( TOPN ( 1, _ufs, [@p], DESC, 'UF'[Nome], ASC ), 'UF'[Nome] )
		displayFolder: T01 Placar\Contas
		lineageTag: 0de3c591-9394-5c9e-a756-2dd32f8b13ce

	/// UF onde o candidato do item teve a menor parcela dos válidos: entre as 27 (sem escolha ou com um estado só) ou entre as UFs do recorte (região ou vários estados).
	measure 'T01 · UF mais fraca do candidato' =
			VAR _noRecorte = [T01 · dossiê no recorte]
			VAR _sel = CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
			VAR _todas =
			    CALCULATETABLE (
			        ADDCOLUMNS ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome] ), "@p", [T01 · % do candidato na UF] ),
			        REMOVEFILTERS ( 'UF' ),
			        'UF'[Tipo] = "UF"
			    )
			VAR _ufs = FILTER ( _todas, _noRecorte = 0 || 'UF'[UF] IN _sel )
			RETURN
			    MAXX ( TOPN ( 1, _ufs, [@p], ASC, 'UF'[Nome], ASC ), 'UF'[Nome] )
		displayFolder: T01 Placar\Contas
		lineageTag: 03a7a712-46ba-5870-bca2-533279f36e15

	/// Quantas UFs o dossiê do candidato compara: as do recorte (região ou vários estados) ou as 27.
	measure 'T01 · UFs do dossiê' =
			IF ( [T01 · dossiê no recorte] = 1, [Recorte · UFs], 27 )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: f9c60b4e-8168-5e5c-8349-337cc8425b08

	/// Em quantas UFs do dossiê o candidato do item foi o mais votado: das 27 (sem escolha ou com um estado só) ou das UFs do recorte (região ou vários estados).
	measure 'T01 · UFs em 1º do candidato' =
			VAR _cand = SELECTEDVALUE ( 'Candidato UF'[Candidato] )
			VAR _noRecorte = [T01 · dossiê no recorte]
			VAR _sel = CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
			VAR _lider =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome] ),
			            "@lider",
			                CALCULATE (
			                    MAXX (
			                        TOPN (
			                            1,
			                            ADDCOLUMNS (
			                                CALCULATETABLE ( VALUES ( 'Candidato UF'[Candidato] ), REMOVEFILTERS ( 'Candidato UF'[Candidato] ) ),
			                                "@v", [T01 · votos do candidato]
			                            ),
			                            [@v], DESC
			                        ),
			                        'Candidato UF'[Candidato]
			                    )
			                )
			        ),
			        REMOVEFILTERS ( 'UF' ),
			        'UF'[Tipo] = "UF"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _cand ),
			        COUNTROWS ( FILTER ( _lider, [@lider] = _cand && ( _noRecorte = 0 || 'UF'[UF] IN _sel ) ) ) + 0
			    )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: d75e261f-a194-51f5-a6b9-ad3d9b4f667c

	/// Quem teve mais votos no recorte: Flávio, Lula ou empate.
	measure 'T01 · vencedor' =
			VAR _f = [T01 · Flávio votos]
			VAR _l = [T01 · Lula votos]
			RETURN
			    SWITCH ( TRUE (), _f > _l, "Flávio", _l > _f, "Lula", "empate" )
		displayFolder: T01 Placar\Contas
		lineageTag: 7d28a995-1bf3-5588-bfd6-7cb37a4c519b

	/// 1 quando o mais votado entre PT e PL mudou de 2022 para 2026 no recorte (as linhas se cruzam).
	measure 'T01 · virou' =
			VAR _d22 = [T01 · PT 2022 votos] - [T01 · PL 2022 votos]
			VAR _d26 = [T01 · Lula votos] - [T01 · Flávio votos]
			RETURN
			    IF ( SIGN ( _d22 ) <> SIGN ( _d26 ) && _d22 <> 0 && _d26 <> 0, 1, 0 )
		formatString: 0
		displayFolder: T01 Placar\Contas
		lineageTag: b063d351-0ac0-578e-aaef-5469dbc979c9

	/// Votos do candidato do item (barra/legenda) em 2026, no recorte.
	measure 'T01 · votos do candidato' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 03ba442b-1cfc-5b10-93cc-a5767cf1ae5c

	/// Votos válidos do 1º turno de 2026 no recorte (com o exterior no Brasil).
	measure 'T01 · válidos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: 9716bf32-892f-5fbf-ae9b-37af07282821

	/// Votos válidos do 1º turno de 2022 no recorte.
	measure 'T01 · válidos 2022' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T01 Placar\Contas
		lineageTag: bc430862-7644-5471-a3b6-76e7a33dac57

	/// Texto para leitor de tela da barra dos válidos.
	measure 'T01 · Barra · ALT' =
			LEFT (
			    "Barra dos votos válidos " & [Recorte · de]
			        & ", um segmento por candidato, do mais ao menos votado. Passe o mouse num segmento para ver onde cada "
			        & "um foi mais forte.",
			    250
			)
		displayFolder: T01 Placar\Desenho
		lineageTag: 4fb1a406-8b7f-5624-923a-a927cc32f7ae

	/// Segmento da barra dos votos válidos para o candidato da linha (uma entrada por candidato): começa onde terminam os mais votados, largura = parcela dos válidos.
	measure 'T01 · Barra · HTML' =
			-- 1 · Leituras
			VAR _v = [T01 · votos do candidato]
			VAR _p = [T01 · parte dos válidos]
			VAR _ini = [T01 · início na barra]
			VAR _pos = [T01 · posição do candidato]
			VAR _num = [T01 · número do candidato]
			-- 2 · Textos
			VAR _cor =
			    SWITCH (
			        TRUE (),
			        _num = 22, "f",
			        _num = 13, "l",
			        _pos = 3, "s3",
			        _pos = 4, "s4",
			        "s5"
			    )
			VAR _lado = IF ( _pos = 2, " dir", "" )
			VAR _txtP = IF ( _p >= 0.08, "<b>" & FORMAT ( _p, "0.0%" ) & "</b>", "" )
			-- 3 · Geometria (barra de 860 px)
			VAR _x = FORMAT ( _ini * 860, "0.0##", "en-US" ) -- geometria
			VAR _w = FORMAT ( _p * 860, "0.0##", "en-US" ) -- geometria
			VAR _atraso = MIN ( _pos + 3, 12 ) -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _v > 0,
			        "<div class='tela br'><div class='sg " & _cor & _lado & " barra-x d" & _atraso
			            & "' style='left:" & _x & "px;width:" & _w & "px'>" & _txtP & "</div></div>"
			    )
		displayFolder: T01 Placar\Desenho
		lineageTag: 0a76e8f8-7bea-5cd7-8ee5-35c1c49a4567

	/// Texto para leitor de tela do bloco do placar (≤ 250 caracteres).
	measure 'T01 · Placar · ALT' =
			-- 1 · Leituras
			VAR _rec = [T01 · recorte]
			VAR _fv = [T01 · Flávio votos]
			VAR _lv = [T01 · Lula votos]
			VAR _fp = [T01 · Flávio %]
			VAR _lp = [T01 · Lula %]
			VAR _dif = [T01 · diferença]
			-- 2 · Textos
			RETURN
			    LEFT (
			        "Resultado do 1º turno, " & _rec & ": Flávio Bolsonaro " & SWITCH ( TRUE (), ABS ( _fv ) >= 1000000, FORMAT ( _fv / 1000000, "0.00" ) & " mi", ABS ( _fv ) >= 1000, FORMAT ( _fv / 1000, "0.0" ) & " mil", FORMAT ( _fv, "#,0" ) ) & " (" & FORMAT ( _fp, "0.0%" ) & "), Lula "
			            & SWITCH ( TRUE (), ABS ( _lv ) >= 1000000, FORMAT ( _lv / 1000000, "0.00" ) & " mi", ABS ( _lv ) >= 1000, FORMAT ( _lv / 1000, "0.0" ) & " mil", FORMAT ( _lv, "#,0" ) ) & " (" & FORMAT ( _lp, "0.0%" ) & "). Diferença de " & FORMAT ( _dif, "#,0" ) & " votos.",
			        250
			    )
		displayFolder: T01 Placar\Desenho
		lineageTag: b7226348-d829-5d3f-8589-a7628dd81887

	/// Bloco da esquerda da tela 01: a diferença (com o sublinhado à mão), a manchete, o duelo Flávio × Lula (o mais votado à esquerda) e a legenda dos outros candidatos. Só lê as contas 'T01 · …'.
	measure 'T01 · Placar · HTML' =
			-- 1 · Leituras
			VAR _comUF = [T01 · com UF]
			VAR _recorte = [T01 · recorte]
			VAR _val = [T01 · válidos]
			VAR _fv = [T01 · Flávio votos]
			VAR _lv = [T01 · Lula votos]
			VAR _fp = [T01 · Flávio %]
			VAR _lp = [T01 · Lula %]
			VAR _dif = [T01 · diferença]
			VAR _difpp = [T01 · diferença em p.p.]
			VAR _venc = [T01 · vencedor]
			VAR _dv = [T01 · demais votos]
			VAR _dp = [T01 · demais parte]
			VAR _dq = [T01 · demais quantidade]
			VAR _dn = [T01 · demais nomes]
			VAR _lista =
			    ADDCOLUMNS (
			        VALUES ( 'Candidato UF'[Candidato] ),
			        "@v", [T01 · votos do candidato],
			        "@p", [T01 · parte dos válidos],
			        "@pos", [T01 · posição do candidato],
			        "@par", [T01 · partido do candidato]
			    )
			VAR _c3 = FILTER ( _lista, [@pos] = 3 ) /* lista */
			VAR _c4 = FILTER ( _lista, [@pos] = 4 ) /* lista */
			-- 2 · Textos
			VAR _txtDif = SWITCH ( TRUE (), ABS ( _dif ) >= 1000000, FORMAT ( _dif / 1000000, "0.00" ) & " mi", ABS ( _dif ) >= 1000, FORMAT ( _dif / 1000, "0.0" ) & " mil", FORMAT ( _dif, "#,0" ) )
			VAR _txtDifCheio = FORMAT ( _dif, "#,0" )
			VAR _txtDifPP = FORMAT ( _difpp, "0.0" )
			VAR _txtVal = FORMAT ( _val, "#,0" )
			VAR _txtRec = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtVF = SWITCH ( TRUE (), ABS ( _fv ) >= 1000000, FORMAT ( _fv / 1000000, "0.00" ) & " mi", ABS ( _fv ) >= 1000, FORMAT ( _fv / 1000, "0.0" ) & " mil", FORMAT ( _fv, "#,0" ) )
			VAR _txtVL = SWITCH ( TRUE (), ABS ( _lv ) >= 1000000, FORMAT ( _lv / 1000000, "0.00" ) & " mi", ABS ( _lv ) >= 1000, FORMAT ( _lv / 1000, "0.0" ) & " mil", FORMAT ( _lv, "#,0" ) )
			VAR _txtPF = FORMAT ( _fp, "0.0%" )
			VAR _txtPL = FORMAT ( _lp, "0.0%" )
			VAR _txtDV = SWITCH ( TRUE (), ABS ( _dv ) >= 1000000, FORMAT ( _dv / 1000000, "0.00" ) & " mi", ABS ( _dv ) >= 1000, FORMAT ( _dv / 1000, "0.0" ) & " mil", FORMAT ( _dv, "#,0" ) )
			VAR _txtDP = FORMAT ( _dp, "0.0%" )
			VAR _ganhou = IF ( _venc = "Lula", "Lula", "Flávio" )
			VAR _perdeu = IF ( _venc = "Lula", "Flávio", "Lula" )
			VAR _manchete =
			    IF (
			        _venc = "empate",
			        "Flávio e Lula empataram",
			        _ganhou & " terminou " & _txtDifCheio & " votos à frente de " & _perdeu
			    )
			VAR _pontos = IF ( _difpp < 2, " ponto percentual", " pontos percentuais" )
			VAR _ext = IF ( _comUF = 1, "", ", com o exterior" )
			VAR _detalhe = _txtDifPP & _pontos & " de vantagem, entre " & _txtVal & " votos válidos" & _ext
			VAR _sobDif = "A diferença · " & _txtRec
			VAR _lugarF = IF ( _venc = "Lula", "2º", "1º" )
			VAR _lugarL = IF ( _venc = "Lula", "1º", "2º" )
			VAR _txtOutros = IF ( _dq = 1, "Outro candidato", "Outros " & _dq )
			-- 4 · Marcação
			VAR _cardF =
			    "<div class='cand sobe d4'><div class='rt rt-f'><span class='selo'>" & _lugarF & "</span></div>"
			        & "<div class='rot flavio-esc'>FLÁVIO BOLSONARO · PL · 22</div>"
			        & "<div class='v flavio'>" & _txtVF & "</div>"
			        & "<div class='p'><span class='pn'>" & _txtPF & "</span> dos votos válidos</div>"
			    & "</div>"
			VAR _cardL =
			    "<div class='cand sobe d4'><div class='rt rt-l'><span class='selo'>" & _lugarL & "</span></div>"
			        & "<div class='rot lula-esc'>LULA · PT · 13</div>"
			        & "<div class='v lula'>" & _txtVL & "</div>"
			        & "<div class='p'><span class='pn'>" & _txtPL & "</span> dos votos válidos</div>"
			    & "</div>"
			VAR _duelo = IF ( _venc = "Lula", _cardL & _cardF, _cardF & _cardL )
			VAR _linha3 =
			    CONCATENATEX (
			        _c3,
			    "<div class='ln'><i class='sw s3'></i><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'Candidato UF'[Candidato], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & [@par]
			        & "</span><span class='vv'>" & SWITCH ( TRUE (), ABS ( [@v] ) >= 1000000, FORMAT ( [@v] / 1000000, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( [@v] / 1000, "0.0" ) & " mil", FORMAT ( [@v], "#,0" ) ) & "</span><span class='pp'>" & FORMAT ( [@p], "0.0%" ) & "</span></div>"
			    )
			VAR _linha4 =
			    CONCATENATEX (
			        _c4,
			    "<div class='ln'><i class='sw s4'></i><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'Candidato UF'[Candidato], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & [@par]
			        & "</span><span class='vv'>" & SWITCH ( TRUE (), ABS ( [@v] ) >= 1000000, FORMAT ( [@v] / 1000000, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( [@v] / 1000, "0.0" ) & " mil", FORMAT ( [@v], "#,0" ) ) & "</span><span class='pp'>" & FORMAT ( [@p], "0.0%" ) & "</span></div>"
			    )
			VAR _linhaD =
			    IF (
			        _dq > 0,
			        "<div class='ln dm'><i class='sw s5'></i><span class='nm'>" & _txtOutros & " · <em>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _dn, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			            & "</em></span><span class='vv'>" & _txtDV & "</span><span class='pp'>" & _txtDP & "</span></div>"
			    )
			VAR _html =
			    "<div class='tela t1'>"
			        & "<div class='sob sobe'>" & _sobDif & "</div>"
			        & "<div class='dn'><span class='dnum sobe d1'>" & _txtDif & "</span>" & [T01 · sublinhado · SVG] & "</div>"
			        & "<div class='mm sobe d3'><div class='man m1'>" & _manchete & "</div>"
			        & "<div class='txt m2'>" & _detalhe & "</div></div>"
			        & "<div class='duelo'>" & _duelo & "</div>"
			        & "<div class='rot vtit sobe d6'>Votos válidos · " & _txtVal & "</div>"
			        & "<div class='leg sobe d8'>" & _linha3 & _linha4 & _linhaD & "</div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T01 Placar\Desenho
		lineageTag: a8c10e34-49d7-5a11-96a5-8266f3df55d7

	/// Texto para leitor de tela dos alvos da virada.
	measure 'T01 · Ponto · ALT' =
			"Pontos da virada: Lula e o PL em 2022 e em 2026. Passe o mouse num ponto para ver de onde vieram os votos "
			    & "daquele ano."
		displayFolder: T01 Placar\Desenho
		lineageTag: 883afcf1-fd1f-5eb7-8df4-589ef1731f67

	/// Alvo do ponto da virada (uma entrada por ano × candidato, só PT e PL): um círculo transparente sobre a bolinha desenhada, com um anel no hover; abre o dossiê do ponto. A posição usa a mesma escala do bloco da virada.
	measure 'T01 · Ponto · HTML' =
			-- 1 · Leituras
			VAR _a = [T01 · ponto · ano]
			VAR _n = [T01 · ponto · número]
			VAR _pt22 = [T01 · PT 2022 votos]
			VAR _pl22 = [T01 · PL 2022 votos]
			VAR _pt26 = [T01 · Lula votos]
			VAR _pl26 = [T01 · Flávio votos]
			-- 2 · Textos
			VAR _cls = IF ( _n = 13, "lula", "flavio" )
			-- 3 · Geometria (a escala da virada; eixos em x 175 e 545; o gráfico começa em y 116 do visual)
			VAR _max = MAX ( MAX ( _pt22, _pl22 ), MAX ( _pt26, _pl26 ) ) -- geometria
			VAR _min = MIN ( MIN ( _pt22, _pl22 ), MIN ( _pt26, _pl26 ) ) -- geometria
			VAR _folga = MAX ( ( _max - _min ) * 0.18, _max * 0.02 ) -- geometria
			VAR _topo = _max + _folga -- geometria
			VAR _esc = DIVIDE ( 480, _topo - ( _min - _folga ) ) -- geometria
			VAR _v =
			    SWITCH (
			        TRUE (),
			        _a = 2022 && _n = 13, _pt22,
			        _a = 2022 && _n = 22, _pl22,
			        _a = 2026 && _n = 13, _pt26,
			        _a = 2026 && _n = 22, _pl26
			    ) -- geometria
			VAR _cx = IF ( _a = 2022, 175, 545 ) -- geometria
			VAR _cy = 116 + 40 + ( _topo - _v ) * _esc -- geometria
			-- 4 · Marcação
			RETURN
			    IF (
			        _v > 0,
			        "<div class='tela vp'><div class='alvo " & _cls & "' style='left:" & FORMAT ( _cx - 24, "0.0##", "en-US" ) & "px;top:"
			            & FORMAT ( _cy - 24, "0.0##", "en-US" ) & "px'></div></div>"
			    )
		displayFolder: T01 Placar\Desenho
		lineageTag: 7bb42087-a43f-57fc-b978-1ce98900044e

	/// Filtro do traço tremido de caneta (defs) para os SVG da tela 01. Desenho fixo.
	measure 'T01 · rabisco · SVG' =
			"<defs><filter id='rb' x='-5%' y='-5%' width='110%' height='110%'><feTurbulence type='fractalNoise' baseFrequency='0.035' numOctaves='2' seed='7' result='r'/><feDisplacementMap in='SourceGraphic' in2='r' scale='2.2' xChannelSelector='R' yChannelSelector='G'/></filter></defs>"
		displayFolder: T01 Placar\Desenho
		lineageTag: e40e6aca-7123-5834-959d-3b95e826261e

	/// Sublinhado duplo à mão embaixo do número da diferença: escala com a largura do número (preserveAspectRatio none), traço que se desenha com o tremido de caneta. Desenho fixo.
	measure 'T01 · sublinhado · SVG' =
			"<svg class='sub' viewBox='0 0 400 24' preserveAspectRatio='none' aria-hidden='true'><defs><filter id='rbl' filterUnits='userSpaceOnUse' x='-10' y='-10' width='420' height='44'><feTurbulence type='fractalNoise' baseFrequency='0.035' numOctaves='2' seed='3' result='r'/><feDisplacementMap in='SourceGraphic' in2='r' scale='2.2' xChannelSelector='R' yChannelSelector='G'/></filter></defs><path pathLength='1' class='traco' style='animation-delay:.9s' filter='url(#rbl)' fill='none' stroke='#1C1915' stroke-width='3.6' stroke-linecap='round' d='M6,8 C120,3 280,2 394,7'/><path pathLength='1' class='traco' style='animation-delay:1.25s' filter='url(#rbl)' fill='none' stroke='#1C1915' stroke-width='3' stroke-linecap='round' d='M44,19 C150,14 280,14 356,17'/></svg>"
		displayFolder: T01 Placar\Desenho
		lineageTag: b277e623-788d-539d-9871-a621b00d6844

	/// Texto para leitor de tela do dossiê do candidato.
	measure 'T01 · Tooltip candidato · ALT' =
			-- 1 · Leituras
			VAR _nome = SELECTEDVALUE ( 'Candidato UF'[Candidato] )
			VAR _ufF = [T01 · UF mais forte do candidato]
			VAR _pF = [T01 · % na UF mais forte do candidato]
			VAR _ufR = [T01 · UF mais fraca do candidato]
			VAR _pR = [T01 · % na UF mais fraca do candidato]
			-- 2 · Textos
			RETURN
			    LEFT (
			        _nome & ": mais forte em " & _ufF & " (" & FORMAT ( _pF, "0.0%" ) & "), mais fraco em " & _ufR & " ("
			            & FORMAT ( _pR, "0.0%" ) & ").",
			        250
			    )
		displayFolder: T01 Placar\Desenho
		lineageTag: 65404a0b-f95b-5228-8fe6-ddcf903c86be

	/// Dossiê do candidato da barra (ficha com clipe): onde foi mais forte e mais fraco e em quantas UFs ficou em 1º, no Brasil (sem escolha ou com um estado só) ou entre as UFs do recorte (região ou vários estados). Só lê contas.
	measure 'T01 · Tooltip candidato · HTML' =
			-- 1 · Leituras
			VAR _nome = SELECTEDVALUE ( 'Candidato UF'[Candidato] )
			VAR _num = [T01 · número do candidato]
			VAR _par = [T01 · partido do candidato]
			VAR _pos = [T01 · posição do candidato]
			VAR _ufF = [T01 · UF mais forte do candidato]
			VAR _pF = [T01 · % na UF mais forte do candidato]
			VAR _ufR = [T01 · UF mais fraca do candidato]
			VAR _pR = [T01 · % na UF mais fraca do candidato]
			VAR _n1 = [T01 · UFs em 1º do candidato]
			VAR _noRecorte = [T01 · dossiê no recorte]
			VAR _nUFs = [T01 · UFs do dossiê]
			VAR _em = [Recorte · em]
			-- 2 · Textos
			VAR _cor = SWITCH ( _num, 22, "flavio", 13, "lula", "neutro" )
			VAR _ic = SWITCH ( _num, 22, "urna-azul", 13, "urna-vermelho", "urna-tinta" )
			VAR _txtNome = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtPar = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _par, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & _num
			VAR _txtPF = FORMAT ( _pF, "0.0%" )
			VAR _txtPR = FORMAT ( _pR, "0.0%" )
			VAR _onde = _pos & "º lugar " & _em
			VAR _nota =
			    SWITCH (
			        TRUE (),
			        _n1 > 0 && _noRecorte = 1, "1º lugar em " & _n1 & " de " & _nUFs & " UFs",
			        _n1 > 0, "1º lugar em " & _n1 & IF ( _n1 = 1, " UF", " UFs" ),
			        _onde
			    )
			VAR _escopo = IF ( _noRecorte = 1, _em, "no Brasil" )
			-- 4 · Marcação
			VAR _css =
			    "<style>"
			        & ".tt1{position:fixed;inset:0;background:var(--papel)}"
			        & ".tt1 .ficha{position:absolute;left:16px;top:18px;right:16px;bottom:16px;background:var(--branco);"
			        & "border:1.5px solid var(--areia);box-shadow:3px 4px 0 rgba(28,25,21,.08)}"
			        & ".tt1 .clipe{position:absolute;right:34px;top:-12px;width:34px;transform:rotate(8deg)}"
			        & ".tt1 .ic{position:absolute;left:22px;top:20px;width:46px}"
			        & ".tt1 .cab{position:absolute;left:82px;top:20px;right:70px}"
			        & ".tt1 .nm{font-size:24px;font-weight:700;line-height:1.1;letter-spacing:-.01em}"
			        & ".tt1 .pt{margin-top:6px}"
			        & ".tt1 .lin{position:absolute;left:22px;right:22px;display:flex;justify-content:space-between;"
			        & "align-items:baseline;border-top:1px dashed var(--areia);padding-top:12px}"
			        & ".tt1 .lin .rot{white-space:nowrap}.tt1 .lin .v{text-align:right;font-size:16px}"
			        & ".tt1 .lin .v b{font-size:24px;font-weight:700;margin-left:8px}"
			        & ".tt1 .l1{top:108px}.tt1 .l2{top:164px}"
			        & ".tt1 .mao{position:absolute;left:22px;bottom:12px;font-size:28px}"
			        & ".tt1 .neutro{color:var(--tinta)}"
			    & "</style>"
			VAR _html =
			    _css
			        & "<div class='tt1'><div class='ficha'>"
			        & "<img class='clipe' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/clipe-tinta.png'/>"
			        & "<img class='ic entra' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/" & _ic & ".png'/>"
			        & "<div class='cab sobe'><div class='nm " & _cor & "'>" & _txtNome & "</div>"
			        & "<div class='rot pt'>" & _txtPar & " · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _escopo, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div>"
			        & "<div class='lin l1 sobe d2'><span class='rot'>Mais forte em</span>"
			        & "<span class='v'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _ufF, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "<b class='" & _cor & "'>" & _txtPF & "</b></span></div>"
			        & "<div class='lin l2 sobe d3'><span class='rot'>Mais fraco em</span>"
			        & "<span class='v'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _ufR, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "<b>" & _txtPR & "</b></span></div>"
			        & "<div class='mao " & _cor & " entra d5'>" & _nota & "</div>"
			        & "</div></div>"
			RETURN
			    IF ( NOT ISBLANK ( _nome ), _html )
		displayFolder: T01 Placar\Desenho
		lineageTag: 19722ef4-f8f8-5b33-8c0a-09cb78afbd2d

	/// Texto para leitor de tela do dossiê do ponto da virada.
	measure 'T01 · Tooltip ponto · ALT' =
			LEFT (
			    [T01 · ponto · candidato] & " em " & [T01 · ponto · ano] & ": de onde vieram os votos, por "
			        & SWITCH ( [T01 · ponto · grupo], "porte", "tamanho de cidade", "estado", "estado", "região" )
			        & ", e o % dele em cada grupo em 2022 e 2026.",
			    250
			)
		displayFolder: T01 Placar\Desenho
		lineageTag: d28518dd-ec3d-5ddc-aaa9-7a1bedfeefec

	/// Dossiê do ponto da virada (ficha com clipe): de onde vieram os votos do candidato naquele ano — por região no Brasil, por tamanho de cidade num estado, por estado num recorte de vários (os 5 com mais votos) —, com o % dele em cada grupo em 2022 e em 2026 e a nota à mão com a maior perda ou ganho (2026) ou a base mais forte (2022). Só lê contas.
	measure 'T01 · Tooltip ponto · HTML' =
			-- 1 · Leituras
			VAR _a = [T01 · ponto · ano]
			VAR _n = [T01 · ponto · número]
			VAR _nome = [T01 · ponto · candidato]
			VAR _par = [T01 · ponto · partido]
			VAR _grupo = [T01 · ponto · grupo]
			VAR _rec = [T01 · recorte]
			VAR _nEst = [T01 · ponto · estados no recorte]
			VAR _regs =
			    TOPN (
			        IF ( _grupo = "região", 10, 0 ),
			        ADDCOLUMNS (
			            VALUES ( 'UF'[Região] ),
			            "@v", [T01 · ponto · votos no grupo],
			            "@p", [T01 · ponto · parte do grupo],
			            "@p22", [T01 · ponto · % no grupo em 2022],
			            "@p26", [T01 · ponto · % no grupo em 2026],
			            "@d", [T01 · ponto · variação no grupo]
			        ),
			        [@v], DESC
			    )
			VAR _ests =
			    TOPN (
			        IF ( _grupo = "estado", 5, 0 ),
			        ADDCOLUMNS (
			            SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome] ),
			            "@v", [T01 · ponto · votos no grupo],
			            "@p", [T01 · ponto · parte do estado],
			            "@p22", [T01 · ponto · % no grupo em 2022],
			            "@p26", [T01 · ponto · % no grupo em 2026],
			            "@d", [T01 · ponto · variação no grupo]
			        ),
			        [@v], DESC
			    )
			VAR _portes =
			    TOPN (
			        IF ( _grupo = "porte", 10, 0 ),
			        ADDCOLUMNS (
			            VALUES ( 'Município'[Porte] ),
			            "@v", [T01 · ponto · votos no grupo],
			            "@p", [T01 · ponto · parte do grupo],
			            "@p22", [T01 · ponto · % no grupo em 2022],
			            "@p26", [T01 · ponto · % no grupo em 2026],
			            "@d", [T01 · ponto · variação no grupo],
			            "@o", [T01 · ordem do porte]
			        ),
			        [@v], DESC
			    )
			VAR _lista =
			    UNION (
			        SELECTCOLUMNS (
			            FILTER ( _regs, [@v] > 0 ), /* lista */
			            "@g", 'UF'[Região], "@v", [@v], "@p", [@p], "@p22", [@p22], "@p26", [@p26], "@d", [@d], "@o", - [@v]
			        ),
			        SELECTCOLUMNS (
			            FILTER ( _ests, [@v] > 0 ), /* lista */
			            "@g", 'UF'[Nome], "@v", [@v], "@p", [@p], "@p22", [@p22], "@p26", [@p26], "@d", [@d], "@o", - [@v]
			        ),
			        SELECTCOLUMNS (
			            FILTER ( _portes, [@v] > 0 && LEN ( 'Município'[Porte] ) > 0 ), /* lista */
			            "@g", 'Município'[Porte], "@v", [@v], "@p", [@p], "@p22", [@p22], "@p26", [@p26], "@d", [@d], "@o", [@o]
			        )
			    )
			VAR _pmax = MAXX ( _lista, [@p] ) /* lista */
			VAR _topD = TOPN ( 1, _lista, ABS ( [@d] ), DESC, [@g], ASC ) /* lista */
			VAR _topP = TOPN ( 1, _lista, IF ( _a = 2022, [@p22], [@p26] ), DESC, [@g], ASC ) /* lista */
			VAR _gD = MAXX ( _topD, [@g] ) /* lista */
			VAR _dD = MAXX ( _topD, [@d] ) /* lista */
			VAR _gP = MAXX ( _topP, [@g] ) /* lista */
			-- 2 · Textos
			VAR _cls = IF ( _n = 13, "lula", "flavio" )
			VAR _ic = IF ( _n = 13, "barras-vermelho", "barras-azul" )
			VAR _txtNome = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & _a
			VAR _sub = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _par, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & _n & " · " & IF ( _grupo = "região", "Brasil, sem o exterior", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rec, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) )
			VAR _rotG =
			    SWITCH (
			        _grupo,
			        "porte", "cidades de",
			        "estado", IF ( _nEst > 5, "estado · 5 de " & _nEst, "estado" ),
			        "região"
			    )
			VAR _nota =
			    IF (
			        _a = 2026,
			        IF ( _dD < 0, "maior perda: ", "maior ganho: " ) & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _gD, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ", " & IF ( _dD < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dD ) ) >= 1000000, FORMAT ( ABS ( _dD ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dD ) ) >= 1000, FORMAT ( ABS ( _dD ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dD ), "#,0" ) ),
			        "base mais forte: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _gP, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			    )
			VAR _on22 = IF ( _a = 2022, " on", "" )
			VAR _on26 = IF ( _a = 2026, " on", "" )
			-- 3 · Geometria (barra do peso em até 84 px; linhas de 30 px)
			VAR _linhas =
			    CONCATENATEX (
			        _lista,
			        VAR _w = FORMAT ( DIVIDE ( [@p], _pmax ) * 84, "0.0##", "en-US" ) -- geometria
			        RETURN
			            "<div class='ln'><span class='g'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [@g], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span><span class='br'><i class='barra-x "
			                & _cls & "-bg' style='width:" & _w & "px'></i><b>" & FORMAT ( [@p], "0%" ) & "</b></span>"
			                & "<span class='pc" & _on22 & "'>" & FORMAT ( [@p22], "0.0%" ) & "</span>"
			                & "<span class='pc" & _on26 & "'>" & FORMAT ( [@p26], "0.0%" ) & "</span></div>",
			        "",
			        [@o], ASC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _nome ) && NOT ISEMPTY ( _lista ),
			        "<div class='tp'><div class='ficha'>"
			            & "<img class='ico entra' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/" & _ic & ".png'/>"
			            & "<div class='cab sobe'><div class='nm " & _cls & "'>" & _txtNome & "</div>"
			            & "<div class='sub'>" & _sub & "</div></div>"
			            & "<div class='hd sobe d1'><span class='g'>" & _rotG & "</span><span class='br'>peso nos votos</span>"
			            & "<span class='pc" & _on22 & "'>% 2022</span><span class='pc" & _on26 & "'>% 2026</span></div>"
			            & "<div class='lista sobe d2'>" & _linhas & "</div>"
			            & "<div class='mao " & _cls & "-esc entra d6'>" & _nota & "</div>"
			        & "</div></div>"
			    )
		displayFolder: T01 Placar\Desenho
		lineageTag: 8d217b80-8bb1-5add-a3ff-aeb4b03b458e

	/// Texto para leitor de tela do bloco de 2022 para 2026.
	measure 'T01 · Virada · ALT' =
			-- 1 · Leituras
			VAR _rec = [Recorte · em]
			VAR _pt22 = [T01 · PT 2022 votos]
			VAR _pt26 = [T01 · Lula votos]
			VAR _pl22 = [T01 · PL 2022 votos]
			VAR _pl26 = [T01 · Flávio votos]
			-- 2 · Textos
			RETURN
			    LEFT (
			        "De 2022 para 2026, " & _rec & ": Lula foi de " & SWITCH ( TRUE (), ABS ( _pt22 ) >= 1000000, FORMAT ( _pt22 / 1000000, "0.00" ) & " mi", ABS ( _pt22 ) >= 1000, FORMAT ( _pt22 / 1000, "0.0" ) & " mil", FORMAT ( _pt22, "#,0" ) ) & " para " & SWITCH ( TRUE (), ABS ( _pt26 ) >= 1000000, FORMAT ( _pt26 / 1000000, "0.00" ) & " mi", ABS ( _pt26 ) >= 1000, FORMAT ( _pt26 / 1000, "0.0" ) & " mil", FORMAT ( _pt26, "#,0" ) )
			            & " votos; o PL foi de " & SWITCH ( TRUE (), ABS ( _pl22 ) >= 1000000, FORMAT ( _pl22 / 1000000, "0.00" ) & " mi", ABS ( _pl22 ) >= 1000, FORMAT ( _pl22 / 1000, "0.0" ) & " mil", FORMAT ( _pl22, "#,0" ) ) & " para " & SWITCH ( TRUE (), ABS ( _pl26 ) >= 1000000, FORMAT ( _pl26 / 1000000, "0.00" ) & " mi", ABS ( _pl26 ) >= 1000, FORMAT ( _pl26 / 1000, "0.0" ) & " mil", FORMAT ( _pl26, "#,0" ) ) & ".",
			        250
			    )
		displayFolder: T01 Placar\Desenho
		lineageTag: a33bfeb2-4d16-57d5-a749-7c6d40eae4fe

	/// Bloco da direita da tela 01: de 2022 para 2026, os votos do PT e do PL (duas linhas que se cruzam quando o mais votado muda). Só lê as contas 'T01 · …'; a escala é geometria.
	measure 'T01 · Virada · HTML' =
			-- 1 · Leituras
			VAR _comUF = [T01 · com UF]
			VAR _recorte = [T01 · recorte]
			VAR _pt22 = [T01 · PT 2022 votos]
			VAR _pl22 = [T01 · PL 2022 votos]
			VAR _pt26 = [T01 · Lula votos]
			VAR _pl26 = [T01 · Flávio votos]
			VAR _ptp22 = [T01 · PT 2022 %]
			VAR _plp22 = [T01 · PL 2022 %]
			VAR _ptp26 = [T01 · Lula %]
			VAR _plp26 = [T01 · Flávio %]
			VAR _dPT = [T01 · PT variação]
			VAR _dPL = [T01 · PL variação]
			VAR _nPT22 = [T01 · PT 2022 candidato]
			VAR _nPL22 = [T01 · PL 2022 candidato]
			VAR _virou = [T01 · virou]
			VAR _encolheu = [T01 · distância encolheu]
			-- 2 · Textos
			VAR _txtDPT = IF ( _dPT < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dPT ) ) >= 1000000, FORMAT ( ABS ( _dPT ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dPT ) ) >= 1000, FORMAT ( ABS ( _dPT ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dPT ), "#,0" ) )
			VAR _txtDPL = IF ( _dPL < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dPL ) ) >= 1000000, FORMAT ( ABS ( _dPL ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dPL ) ) >= 1000, FORMAT ( ABS ( _dPL ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dPL ), "#,0" ) )
			VAR _verboPT = IF ( _dPT < 0, " perdeu ", " ganhou " )
			VAR _verboPL = IF ( _dPL < 0, " perdeu ", " ganhou " )
			VAR _manchete = "Lula" & _verboPT & SWITCH ( TRUE (), ABS ( ABS ( _dPT ) ) >= 1000000, FORMAT ( ABS ( _dPT ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dPT ) ) >= 1000, FORMAT ( ABS ( _dPT ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dPT ), "#,0" ) ) & " de votos; o PL" & _verboPL & SWITCH ( TRUE (), ABS ( ABS ( _dPL ) ) >= 1000000, FORMAT ( ABS ( _dPL ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dPL ) ) >= 1000, FORMAT ( ABS ( _dPL ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dPL ), "#,0" ) )
			VAR _txtPT22 = SWITCH ( TRUE (), ABS ( _pt22 ) >= 1000000, FORMAT ( _pt22 / 1000000, "0.00" ) & " mi", ABS ( _pt22 ) >= 1000, FORMAT ( _pt22 / 1000, "0.0" ) & " mil", FORMAT ( _pt22, "#,0" ) ) & " · " & FORMAT ( _ptp22, "0.0%" )
			VAR _txtPL22 = SWITCH ( TRUE (), ABS ( _pl22 ) >= 1000000, FORMAT ( _pl22 / 1000000, "0.00" ) & " mi", ABS ( _pl22 ) >= 1000, FORMAT ( _pl22 / 1000, "0.0" ) & " mil", FORMAT ( _pl22, "#,0" ) ) & " · " & FORMAT ( _plp22, "0.0%" )
			VAR _txtPT26 = SWITCH ( TRUE (), ABS ( _pt26 ) >= 1000000, FORMAT ( _pt26 / 1000000, "0.00" ) & " mi", ABS ( _pt26 ) >= 1000, FORMAT ( _pt26 / 1000, "0.0" ) & " mil", FORMAT ( _pt26, "#,0" ) ) & " · " & FORMAT ( _ptp26, "0.0%" )
			VAR _txtPL26 = SWITCH ( TRUE (), ABS ( _pl26 ) >= 1000000, FORMAT ( _pl26 / 1000000, "0.00" ) & " mi", ABS ( _pl26 ) >= 1000, FORMAT ( _pl26 / 1000, "0.0" ) & " mil", FORMAT ( _pl26, "#,0" ) ) & " · " & FORMAT ( _plp26, "0.0%" )
			VAR _nomePT22 = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nPT22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _nomePL22 = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nPL22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _nota =
			    SWITCH ( TRUE (), _virou = 1, "as linhas se cruzaram", _encolheu = 1, "a distância encolheu", "a distância cresceu" )
			VAR _rodape =
			    IF ( _comUF = 1, "Votos válidos · " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ".", "Votos válidos, com o exterior." )
			        & " Em 2022, o PL concorreu com " & _nomePL22 & "."
			-- 3 · Geometria (eixos em x 175 e 545; votos de cima para baixo em y 40–520 do gráfico)
			VAR _max = MAX ( MAX ( _pt22, _pl22 ), MAX ( _pt26, _pl26 ) ) -- geometria
			VAR _min = MIN ( MIN ( _pt22, _pl22 ), MIN ( _pt26, _pl26 ) ) -- geometria
			VAR _folga = MAX ( ( _max - _min ) * 0.18, _max * 0.02 ) -- geometria
			VAR _topo = _max + _folga -- geometria
			VAR _esc = DIVIDE ( 480, _topo - ( _min - _folga ) ) -- geometria
			VAR _yPT22 = 40 + ( _topo - _pt22 ) * _esc -- geometria
			VAR _yPL22 = 40 + ( _topo - _pl22 ) * _esc -- geometria
			VAR _yPT26 = 40 + ( _topo - _pt26 ) * _esc -- geometria
			VAR _yPL26 = 40 + ( _topo - _pl26 ) * _esc -- geometria
			-- rótulos: centros a 56 px no mínimo em cada eixo; o rótulo (2 linhas) sobe 21 px
			VAR _m22 = ( _yPT22 + _yPL22 ) / 2 -- geometria
			VAR _s22 = MAX ( ABS ( _yPT22 - _yPL22 ), 56 ) / 2 * IF ( _yPT22 <= _yPL22, -1, 1 ) -- geometria
			VAR _m26 = ( _yPT26 + _yPL26 ) / 2 -- geometria
			VAR _s26 = MAX ( ABS ( _yPT26 - _yPL26 ), 56 ) / 2 * IF ( _yPT26 <= _yPL26, -1, 1 ) -- geometria
			VAR _lPT22 = FORMAT ( _m22 + _s22 - 21, "0.0##", "en-US" ) -- geometria
			VAR _lPL22 = FORMAT ( _m22 - _s22 - 21, "0.0##", "en-US" ) -- geometria
			VAR _lPT26 = FORMAT ( _m26 + _s26 - 21, "0.0##", "en-US" ) -- geometria
			VAR _lPL26 = FORMAT ( _m26 - _s26 - 21, "0.0##", "en-US" ) -- geometria
			-- a nota à mão fica embaixo (y 548), com uma seta curva até o cruzamento (ou até o vão de 2026)
			VAR _t = DIVIDE ( _yPT22 - _yPL22, ( _yPT22 - _yPL22 ) - ( _yPT26 - _yPL26 ), 0.5 ) -- geometria
			VAR _xAlvo = IF ( _virou = 1, 175 + 370 * _t, 533 ) -- geometria
			VAR _yAlvo = IF ( _virou = 1, _yPT22 + ( _yPT26 - _yPT22 ) * _t + 14, ( _yPT26 + _yPL26 ) / 2 ) -- geometria
			VAR _seta =
			    "M452,548 C" & FORMAT ( ( 452 + _xAlvo ) / 2 + 30, "0.0##", "en-US" ) & ",548 " & FORMAT ( _xAlvo + 6, "0.0##", "en-US" ) & ","
			        & FORMAT ( ( 548 + _yAlvo ) / 2 + 30, "0.0##", "en-US" ) & " " & FORMAT ( _xAlvo, "0.0##", "en-US" ) & "," & FORMAT ( _yAlvo + 6, "0.0##", "en-US" ) -- geometria
			VAR _ponta =
			    "M" & FORMAT ( _xAlvo - 8, "0.0##", "en-US" ) & "," & FORMAT ( _yAlvo + 18, "0.0##", "en-US" ) & " L" & FORMAT ( _xAlvo, "0.0##", "en-US" ) & "," & FORMAT ( _yAlvo + 6, "0.0##", "en-US" )
			        & " L" & FORMAT ( _xAlvo + 9, "0.0##", "en-US" ) & "," & FORMAT ( _yAlvo + 16, "0.0##", "en-US" ) -- geometria
			-- deltas a 30% de cada linha (longe do cruzamento), por fora do par
			VAR _mPT = _yPT22 + ( _yPT26 - _yPT22 ) * 0.3 -- geometria
			VAR _mPL = _yPL22 + ( _yPL26 - _yPL22 ) * 0.3 -- geometria
			VAR _inclPT = ABS ( _yPT26 - _yPT22 ) / 370 * 75 -- geometria
			VAR _inclPL = ABS ( _yPL26 - _yPL22 ) / 370 * 75 -- geometria
			VAR _yDPT = FORMAT ( _mPT + IF ( _mPT <= _mPL, -38 - _inclPT, 10 + _inclPT ), "0.0##", "en-US" ) -- geometria
			VAR _yDPL = FORMAT ( _mPL + IF ( _mPL < _mPT, -38 - _inclPL, 10 + _inclPL ), "0.0##", "en-US" ) -- geometria
			VAR _cPT22 = FORMAT ( _yPT22, "0.0##", "en-US" ) -- geometria
			VAR _cPL22 = FORMAT ( _yPL22, "0.0##", "en-US" ) -- geometria
			VAR _cPT26 = FORMAT ( _yPT26, "0.0##", "en-US" ) -- geometria
			VAR _cPL26 = FORMAT ( _yPL26, "0.0##", "en-US" ) -- geometria
			-- 4 · Marcação
			VAR _ponto = "' r='9' class='brota d6'/>"
			VAR _svg =
			    "<svg class='sl' width='720' height='600' viewBox='0 0 720 600'>" & [T01 · rabisco · SVG]
			        & "<line x1='175' y1='10' x2='175' y2='590' class='eixo'/>"
			        & "<line x1='545' y1='10' x2='545' y2='590' class='eixo'/>"
			        & "<path pathLength='1' class='lpl traco d3' filter='url(#rb)' d='M175," & _cPL22 & " L545," & _cPL26 & "'/>"
			        & "<path pathLength='1' class='lpt traco d3' filter='url(#rb)' d='M175," & _cPT22 & " L545," & _cPT26 & "'/>"
			        & "<circle cx='175' cy='" & _cPL22 & "' fill='#2B5797" & _ponto
			        & "<circle cx='175' cy='" & _cPT22 & "' fill='#B8322A" & _ponto
			        & "<circle cx='545' cy='" & _cPL26 & "' fill='#2B5797" & _ponto
			        & "<circle cx='545' cy='" & _cPT26 & "' fill='#B8322A" & _ponto
			        & "<path pathLength='1' class='seta traco d14' filter='url(#rb)' d='" & _seta & "'/>"
			        & "<path pathLength='1' class='seta traco-rapido d16' d='" & _ponta & "'/>"
			    & "</svg>"
			VAR _rotulos =
			    "<div class='rs e sobe d7' style='top:" & _lPT22 & "px'><b class='lula-esc'>" & _nomePT22 & "</b>" & _txtPT22 & "</div>"
			        & "<div class='rs e sobe d7' style='top:" & _lPL22 & "px'><b class='flavio-esc'>" & _nomePL22 & "</b>" & _txtPL22 & "</div>"
			        & "<div class='rs d sobe d9' style='top:" & _lPT26 & "px'><b class='lula-esc'>Lula</b>" & _txtPT26 & "</div>"
			        & "<div class='rs d sobe d9' style='top:" & _lPL26 & "px'><b class='flavio-esc'>Flávio Bolsonaro</b>" & _txtPL26 & "</div>"
			        & "<div class='dl lula-esc sobe d8' style='top:" & _yDPT & "px'>" & _txtDPT & "</div>"
			        & "<div class='dl flavio-esc sobe d8' style='top:" & _yDPL & "px'>" & _txtDPL & "</div>"
			        & "<div class='mao anot entra d12'>" & _nota & "</div>"
			VAR _html =
			    "<div class='tela t1v'>"
			        & "<div class='sob sobe'>De 2022 para 2026 · votos no 1º turno</div>"
			        & "<div class='man sobe d1'>" & _manchete & "</div>"
			        & "<div class='grafico'>" & _svg & _rotulos
			            & "<div class='ano a1'>2022</div><div class='ano a2'>2026</div>"
			        & "</div>"
			        & "<div class='nota pe'>" & _rodape & "</div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T01 Placar\Desenho
		lineageTag: a62b7979-e2b5-575e-a5ce-626fc3aaf7c1

	/// Parcela de Lula nos votos válidos do 1º turno de 2026, no Brasil (0–1).
	measure 'T02 · % 2026' =
			DIVIDE (
			    [T02 · votos 2026],
			    CALCULATE ( SUM ( 'Candidato UF'[Votos] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026 )
			)
		formatString: 0.0%
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 8f51ad85-eb91-5174-b037-d1ba48ed1e07

	/// Anos do primeiro marco até a eleição de 2026.
	measure 'T02 · anos de vida pública' =
			2026 - [T02 · Trajetória · primeiro ano]
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 6919e072-d4ec-587e-be7e-3c8503a30d87

	/// Colocação de Lula no 1º turno de 2026, no Brasil.
	measure 'T02 · posição 2026' =
			VAR _v = [T02 · votos 2026]
			VAR _todos =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Candidato UF'[Número] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026 ),
			        "@v", CALCULATE ( SUM ( 'Candidato UF'[Votos] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026 )
			    )
			RETURN
			    1 + COUNTROWS ( FILTER ( _todos, [@v] > _v ) )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: bf2c0c4e-c8df-57c2-816f-9fd3f8111a14

	/// Ano do marco da linha.
	measure 'T02 · Trajetória · ano' =
			SELECTEDVALUE ( 'Trajetória'[Ano] )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 263395a1-414d-5de9-a7e9-bcfc1611c57b

	/// Crédito curto do desenho e da foto original do marco da linha. Fonte: dados/bruto/trajetoria/desenhos.csv; na falta, autor e licença da tabela Trajetória.
	measure 'T02 · Trajetória · crédito da foto' =
			VAR _f = [T02 · Trajetória · foto]
			VAR _reserva =
			    "Desenho a partir de foto de " & SELECTEDVALUE ( 'Trajetória'[Autor da foto] ) & " ("
			        & SELECTEDVALUE ( 'Trajetória'[Licença da foto] ) & ")"
			RETURN
			    IF (
			        _f <> "",
			        SWITCH (
			            _f,
			        "lula-1975-sindicato", "Ilustração CC BY-SA 4.0 recriada de registros da época; rosto: CEDI/Câmara (CC BY 2.0)",
			        "lula-1980-fundacao-pt", "Ilustração CC BY-SA 4.0 recriada de registros da época; rosto: CEDI/Câmara (CC BY 2.0)",
			        "lula-1986-constituinte", "Desenho CC BY-SA 4.0 a partir de foto de Senado Federal/Agência Senado (CC BY 2.0)",
			        "lula-1989-presidencia", "Desenho CC BY-SA 4.0 a partir de foto de CEDI/Câmara dos Deputados (CC BY 2.0)",
			        "lula-2002-posse", "Desenho CC BY-SA 4.0 a partir de foto de Marcello Casal Jr./Agência Brasil (CC BY 3.0 BR)",
			        "lula-2006-reeleicao", "Desenho CC BY-SA 4.0 a partir de foto de Marcello Casal Jr./Agência Brasil (CC BY 3.0 BR)",
			        "lula-2018-prisao", "Desenho CC BY-SA 4.0 a partir de foto de Ricardo Stuckert/Lula Oficial (CC BY-SA 4.0)",
			        "lula-2021-anulacao", "Desenho CC BY-SA 4.0 a partir de foto de Ricardo Stuckert/Lula Oficial (CC BY-SA 4.0)",
			        "lula-2022-eleicao", "Desenho CC BY-SA 4.0 a partir de foto de Ricardo Stuckert/Lula Oficial (CC BY-SA 4.0)",
			        "lula-2026-primeiro-turno", "Desenho CC BY-SA 4.0 a partir de foto de Ricardo Stuckert/Lula Oficial (CC BY-SA 4.0)",
			            _reserva
			        )
			    )
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 9b810d73-ee3b-5631-8cc8-dcdc2df4ca36

	/// Data do marco da linha; vazio quando a fonte só dá o ano.
	measure 'T02 · Trajetória · data' =
			VAR _d = SELECTEDVALUE ( 'Trajetória'[Data] )
			RETURN
			    IF ( LEN ( _d ) = 10, DATE ( VALUE ( LEFT ( _d, 4 ) ), VALUE ( MID ( _d, 6, 2 ) ), VALUE ( RIGHT ( _d, 2 ) ) ) )
		formatString: dd/mm/yyyy
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 36bd90aa-0fa9-5b99-8314-4cd06193e42d

	/// Nome do desenho da foto do marco da linha; vazio quando não há foto livre.
	measure 'T02 · Trajetória · foto' =
			SELECTEDVALUE ( 'Trajetória'[Foto] )
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 363559d8-6a1e-5417-ba7c-7f9e2fb6f287

	/// Onde e quando a foto original do marco da linha foi feita (pode ser de outro momento que o do marco). Fonte: dados/bruto/trajetoria/desenhos.csv.
	measure 'T02 · Trajetória · legenda da foto' =
			VAR _f = [T02 · Trajetória · foto]
			RETURN
			    SWITCH (
			        _f,
			"lula-1975-sindicato", "Assembleia de metalúrgicos num estádio do ABC paulista, fim dos anos 1970 (cena recriada)",
			"lula-1980-fundacao-pt", "Fundação do PT no Colégio Sion, São Paulo, 10 de fevereiro de 1980 (cena recriada)",
			"lula-1986-constituinte", "Assembleia Nacional Constituinte, Brasília, 1987–1988 (foto de arquivo)",
			"lula-1989-presidencia", "Homenagem do Diap a constituintes, Brasília, outubro de 1988",
			"lula-2002-posse", "Posse no Palácio do Planalto, Brasília, 1º de janeiro de 2003",
			"lula-2006-reeleicao", "Depois de votar no 2º turno, São Bernardo do Campo (SP), 29 de outubro de 2006",
			"lula-2018-prisao", "Carregado por apoiadores, São Bernardo do Campo (SP), 7 de abril de 2018",
			"lula-2021-anulacao", "Encontro com movimentos sociais em Pernambuco, 16 de agosto de 2021",
			"lula-2022-eleicao", "Noite da eleição na Av. Paulista, São Paulo, 30 de outubro de 2022",
			"lula-2026-primeiro-turno", "Pronunciamento após o 1º turno, São Paulo, 4 de outubro de 2026",
			        BLANK ()
			    )
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: a4e8b5d5-f9c5-5fb4-8d4b-63520c0583df

	/// Quantos marcos a trajetória de Lula tem.
	measure 'T02 · Trajetória · marcos' =
			CALCULATE ( COUNTROWS ( 'Trajetória' ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Lula" )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 40096fd9-3d60-5dd6-8087-c1ea90a4277e

	/// Quantos marcos de Lula têm foto da época redesenhada (sem contar as ilustrações recriadas).
	measure 'T02 · Trajetória · marcos com foto' =
			CALCULATE ( COUNTROWS ( 'Trajetória' ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Lula", 'Trajetória'[Foto] <> "", NOT ( 'Trajetória'[Foto] IN { "lula-1975-sindicato", "lula-1980-fundacao-pt" } ) )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: fc18da53-3ed5-549d-b517-f13a8b6fd3d7

	/// Quantos marcos de Lula não têm foto de licença aberta e mostram a cena da época recriada em ilustração.
	measure 'T02 · Trajetória · marcos ilustrados' =
			CALCULATE ( COUNTROWS ( 'Trajetória' ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Lula", 'Trajetória'[Foto] IN { "lula-1975-sindicato", "lula-1980-fundacao-pt" } )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 77455706-015c-53e0-bcbc-b1bb7bf89a4d

	/// Posição cronológica do marco da linha (1 = o mais antigo).
	measure 'T02 · Trajetória · ordem' =
			SELECTEDVALUE ( 'Trajetória'[Ordem] )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 78c4a063-b2a2-5b05-9c8d-58df56234496

	/// Ano do primeiro marco de Lula.
	measure 'T02 · Trajetória · primeiro ano' =
			CALCULATE ( MIN ( 'Trajetória'[Ano] ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Lula" )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: c394b9fa-5d8f-5cdd-af56-365f21542d9d

	/// Ano do segundo marco mais antigo de Lula (onde a régua retoma quando o primeiro marco fica longe dos outros e a régua ganha um corte).
	measure 'T02 · Trajetória · segundo ano' =
			VAR _p = [T02 · Trajetória · primeiro ano] RETURN CALCULATE ( MIN ( 'Trajetória'[Ano] ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Lula", 'Trajetória'[Ano] > _p )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 4e7315b6-f238-5435-8e92-d876306f9372

	/// 1 quando o marco da linha tem desenho: foto da época redesenhada ou, sem foto de licença aberta, ilustração recriada.
	measure 'T02 · Trajetória · tem foto' =
			IF ( SELECTEDVALUE ( 'Trajetória'[Foto] ) <> "", 1, 0 )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 0674145b-96a4-5725-b07e-b4390f70d002

	/// Momento do marco da linha em anos decimais (ano + fração do ano; meio do ano quando a fonte só dá o ano). Posição do ponto na régua.
	measure 'T02 · Trajetória · tempo' =
			VAR _a = [T02 · Trajetória · ano]
			VAR _d = [T02 · Trajetória · data]
			RETURN
			    IF ( ISBLANK ( _d ), _a + 0.5, _a + DIVIDE ( _d - DATE ( _a, 1, 1 ), 365 ) )
		formatString: 0.00
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: fb060a4d-08a8-5de3-8edf-1121d4ac493d

	/// O que aconteceu no marco da linha (até ~200 caracteres).
	measure 'T02 · Trajetória · texto do marco' =
			SELECTEDVALUE ( 'Trajetória'[Texto] )
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: eeb12610-ab8a-5505-b067-b585b0d4d1fc

	/// Título curto do marco da linha.
	measure 'T02 · Trajetória · título' =
			SELECTEDVALUE ( 'Trajetória'[Título] )
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 6f6d1dd2-bec2-5b44-9a4e-0cc288686c27

	/// 1 quando o desenho do marco da linha é ilustração recriada da época (não há foto de licença aberta). Fonte: dados/bruto/trajetoria/desenhos.csv, coluna tipo.
	measure 'T02 · Trajetória · é ilustração' =
			VAR _f = [T02 · Trajetória · foto]
			RETURN
			    IF ( _f IN { "lula-1975-sindicato", "lula-1980-fundacao-pt" }, 1, 0 )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 61b68926-92a4-5b1d-9d23-4a2cd119318d

	/// Ano do último marco de Lula.
	measure 'T02 · Trajetória · último ano' =
			CALCULATE ( MAX ( 'Trajetória'[Ano] ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Lula" )
		formatString: 0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 5ab3c32c-4176-509b-985e-3e92d11caf4f

	/// Votos de Lula no 1º turno de 2026, no Brasil (com o exterior).
	measure 'T02 · votos 2026' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 13 )
		formatString: #,0
		displayFolder: T02 Lula · quem é\Contas
		lineageTag: 2f2f1daf-461d-522f-a658-e1383b399ab0

	/// Texto para leitor de tela da ficha.
	measure 'T02 · Ficha · ALT' =
			LEFT (
			    "Luiz Inácio Lula da Silva, na vida pública desde " & [T02 · Trajetória · primeiro ano] & ". No 1º turno de 2026, "
			        & SWITCH ( TRUE (), ABS ( [T02 · votos 2026] ) >= 1000000, FORMAT ( [T02 · votos 2026] / 1000000, "0.00" ) & " mi", ABS ( [T02 · votos 2026] ) >= 1000, FORMAT ( [T02 · votos 2026] / 1000, "0.0" ) & " mil", FORMAT ( [T02 · votos 2026], "#,0" ) ) & " de votos (" & FORMAT ( [T02 · % 2026], "0.0%" ) & "), "
			        & [T02 · posição 2026] & "º lugar.",
			    250
			)
		displayFolder: T02 Lula · quem é\Desenho
		lineageTag: b8d64031-fdf3-5c06-837f-e44777ae6049

	/// Ficha de Lula (alto à esquerda da tela): desde quando está na vida pública, o 1º turno de 2026 e quantos marcos a linha do tempo tem (com foto da época e em ilustração recriada). Só lê contas.
	measure 'T02 · Ficha · HTML' =
			-- 1 · Leituras
			VAR _desde = [T02 · Trajetória · primeiro ano]
			VAR _anos = [T02 · anos de vida pública]
			VAR _votos = [T02 · votos 2026]
			VAR _pct = [T02 · % 2026]
			VAR _pos = [T02 · posição 2026]
			VAR _marcos = [T02 · Trajetória · marcos]
			VAR _fotos = [T02 · Trajetória · marcos com foto]
			VAR _ilus = [T02 · Trajetória · marcos ilustrados]
			-- 2 · Textos
			VAR _txtVotos = SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) )
			VAR _txtPct = FORMAT ( _pct, "0.0%" )
			VAR _txtFotos =
			    SWITCH (
			        TRUE (),
			        _fotos = _marcos, "todos com foto da época",
			        _fotos = 0, "nenhum com foto da época",
			        _fotos = 1, "1 com foto da época",
			        _fotos & " com foto da época"
			    )
			VAR _txtIlus =
			    SWITCH ( _ilus, 0, "", 1, ", 1 em ilustração recriada", ", " & _ilus & " em ilustração recriada" )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela fc'>"
			        & "<div class='lin sobe d3'><div class='rot'>Na vida pública desde</div>"
			        & "<div class='val'><span class='nc'>" & _desde & "</span><small>há <span>" & _anos & "</span> anos</small></div></div>"
			        & "<div class='lin sobe d4'><div class='rot'>No 1º turno de 2026</div>"
			        & "<div class='val'><span class='lula'>" & _txtVotos & "</span><small>de votos · " & _txtPct
			        & " · " & _pos & "º lugar</small></div></div>"
			        & "<div class='lin sobe d5'><div class='rot'>Na linha do tempo abaixo</div>"
			        & "<div class='val'><span>" & _marcos & "</span><small>marcos, " & _txtFotos & _txtIlus
			        & "</small></div></div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T02 Lula · quem é\Desenho
		lineageTag: 99c7615d-3f9a-5b4b-871a-bd2c315eace4

	/// Texto para leitor de tela do dossiê do marco.
	measure 'T02 · Tooltip marco · ALT' =
			LEFT (
			    [T02 · Trajetória · ano] & " · " & [T02 · Trajetória · título] & ": " & [T02 · Trajetória · texto do marco],
			    250
			)
		displayFolder: T02 Lula · quem é\Desenho
		lineageTag: d168baac-d16a-579d-86e5-076844a081ba

	/// Dossiê do marco (polaroide presa com fita): a foto da época redesenhada em traço ou, sem foto de licença aberta, a cena recriada em ilustração (reserva: um ícone e a nota 'sem foto de licença aberta'), a data, o título, o texto, a legenda e o crédito. Só lê contas.
	measure 'T02 · Tooltip marco · HTML' =
			-- 1 · Leituras
			VAR _tit = [T02 · Trajetória · título]
			VAR _txt = [T02 · Trajetória · texto do marco]
			VAR _ano = [T02 · Trajetória · ano]
			VAR _data = [T02 · Trajetória · data]
			VAR _foto = [T02 · Trajetória · foto]
			VAR _temFoto = [T02 · Trajetória · tem foto]
			VAR _ilus = [T02 · Trajetória · é ilustração]
			VAR _leg = [T02 · Trajetória · legenda da foto]
			VAR _cred = [T02 · Trajetória · crédito da foto]
			-- 2 · Textos
			VAR _txtData =
			    IF (
			        ISBLANK ( _data ),
			        FORMAT ( _ano, "0" ),
			        IF ( DAY ( _data ) = 1, "1º", FORMAT ( _data, "d" ) ) & FORMAT ( _data, " ""de"" mmmm ""de"" yyyy" )
			    )
			VAR _icone =
			    SWITCH (
			        TRUE (),
			        SEARCH ( "sindicato", _tit, 1, 0 ) > 0, "megafone",
			        SEARCH ( "campanha", _tit, 1, 0 ) > 0, "megafone",
			        SEARCH ( "fundação", _tit, 1, 0 ) > 0, "pessoas",
			        SEARCH ( "Disputa", _tit, 1, 0 ) > 0, "urna",
			        "jornal"
			    )
			VAR _srcIcone = "https://vizudados.github.io/eleicoes-2026/midia/arte/icones/" & _icone & "-tinta.png"
			VAR _quadro =
			    IF (
			        _temFoto = 1,
			        "<img class='foto' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/trajetoria/" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _foto, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ".png' data-reserva='"
			            & _srcIcone & "'/>",
			        "<img class='foto reserva' alt='' src='" & _srcIcone & "'/>"
			            & "<div class='sem mao'>sem foto de licença aberta</div>"
			    )
			VAR _rodape =
			    IF ( _temFoto = 1, "<div class='nota lg'><b>" & IF ( _ilus = 1, "Na ilustração:", "Na foto:" ) & "</b> "
			        & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _leg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='nota cr'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _cred, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>" )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tt2'>"
			        & "<div class='pol'>" & _quadro & "<div class='ano mao nc'>" & _ano & "</div>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/></div>"
			        & "<div class='col'><div class='rot lula-esc sobe'>" & _txtData & "</div>"
			        & "<div class='man sobe d1'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _tit, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='txt sobe d2'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & IF ( _temFoto = 1, "<div class='pe sobe d3'>" & _rodape & "</div>" ) & "</div>"
			    & "</div>"
			RETURN
			    IF ( NOT ISBLANK ( _tit ), _html )
		displayFolder: T02 Lula · quem é\Desenho
		lineageTag: 0881b0c1-c647-5358-bc0d-fed484fe078d

	/// Texto para leitor de tela da linha do tempo.
	measure 'T02 · Trajetória · ALT' =
			LEFT (
			    "Linha do tempo da trajetória política de Lula: " & [T02 · Trajetória · marcos] & " marcos, de "
			        & [T02 · Trajetória · primeiro ano] & " a " & [T02 · Trajetória · último ano]
			        & ". Passe o mouse num marco para ver a foto da época e o que aconteceu.",
			    250
			)
		displayFolder: T02 Lula · quem é\Desenho
		lineageTag: ffbff087-56a5-544a-82da-52928268f70a

	/// Um marco da trajetória (uma entrada por marco, granularidade 'Trajetória'[Título]): o cartão na sua vaga (câmera se tem foto da época, lápis se é ilustração recriada), o fio até o ponto no ano real e, no 1º marco, a régua com os anos. Só lê contas; posições são geometria.
	measure 'T02 · Trajetória · HTML' =
			-- 1 · Leituras
			VAR _ordem = [T02 · Trajetória · ordem]
			VAR _n = [T02 · Trajetória · marcos]
			VAR _tempo = [T02 · Trajetória · tempo]
			VAR _ano = [T02 · Trajetória · ano]
			VAR _tit = [T02 · Trajetória · título]
			VAR _temFoto = [T02 · Trajetória · tem foto]
			VAR _ilus = [T02 · Trajetória · é ilustração]
			VAR _ini = [T02 · Trajetória · primeiro ano]
			VAR _fim = [T02 · Trajetória · último ano]
			-- 2 · Textos
			VAR _txtTit = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _tit, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _icone =
			    SWITCH (
			        TRUE (),
			        _ilus = 1,
			            "<svg class='cam' viewBox='0 0 20 16' aria-label='ilustração recriada da época'><path d='M3,14 L4,10 L13,2 L16,5 L7,13 Z'/><path d='M4,10 L7,13'/></svg>",
			        _temFoto = 1,
			            "<svg class='cam' viewBox='0 0 20 16' aria-label='tem foto da época'><path d='M2,4 H6 L8,2 H12 L14,4 H18 V14 H2 Z'/><circle cx='10' cy='9' r='3'/></svg>",
			        ""
			    )
			VAR _cab =
			    "<div class='cab'><span class='sob'>Trajetória política · " & _n & " marcos</span>"
			        & "<span class='dica'>passe o mouse num marco para ver a foto da época, redesenhada em traço</span></div>"
			-- 3 · Geometria (régua em y 296, de x 30 a 1590; vagas iguais para os cartões)
			-- com o 1º marco a mais de 8 anos do 2º (Flávio: 2002 e depois 2016), a régua ganha um corte: um trecho curto
			-- em volta do 1º marco, o sinal de corte e o resto da régua do 2º marco ao fim, para os fios não se cruzarem
			VAR _seg = [T02 · Trajetória · segundo ano]
			VAR _corte = _seg - _ini > 8 -- geometria
			VAR _t0 = FLOOR ( _ini - 1, 5 ) -- geometria
			VAR _t1 = CEILING ( _fim + 2, 5 ) -- geometria
			VAR _escala = DIVIDE ( 1560, _t1 - _t0 ) -- geometria
			VAR _wa = 200 -- geometria
			VAR _vao = 44 -- geometria
			VAR _a0 = _ini - 1.5 -- geometria
			VAR _a1 = _ini + 1.5 -- geometria
			VAR _b0 = _seg - 1 -- geometria
			VAR _b1 = _fim + 1 -- geometria
			VAR _xb = 30 + _wa + _vao -- geometria
			VAR _eb = DIVIDE ( 1560 - _wa - _vao, _b1 - _b0 ) -- geometria
			VAR _xd =
			    IF (
			        _corte,
			        IF ( _tempo <= _a1, 30 + ( _tempo - _a0 ) * DIVIDE ( _wa, _a1 - _a0 ), _xb + ( _tempo - _b0 ) * _eb ),
			        30 + ( _tempo - _t0 ) * _escala
			    ) -- geometria
			VAR _xs = ( _ordem - 0.5 ) * DIVIDE ( 1620, _n ) -- geometria
			VAR _txd = FORMAT ( _xd, "0.0##", "en-US" ) -- geometria
			VAR _txs = FORMAT ( _xs, "0.0##", "en-US" ) -- geometria
			VAR _fio =
			    "M" & _txs & ",176 L" & _txs & ",200 L" & _txd & ",262 L" & _txd & ",287" -- geometria
			VAR _atraso = MIN ( _ordem + 4, 16 ) -- geometria
			VAR _anosInteira = SELECTCOLUMNS ( GENERATESERIES ( _t0, _t1, 5 ), "@a", [Value], "@c", 0 ) /* lista */
			VAR _anosCorte =
			    UNION (
			        ROW ( "@a", _ini, "@c", 1 ),
			        SELECTCOLUMNS ( GENERATESERIES ( CEILING ( _b0, 5 ), FLOOR ( _b1, 5 ), 5 ), "@a", [Value], "@c", 1 )
			    ) /* lista */
			VAR _anos = FILTER ( UNION ( _anosInteira, _anosCorte ), [@c] = IF ( _corte, 1, 0 ) ) /* lista */
			VAR _marcas =
			    CONCATENATEX (
			        _anos,
			        VAR _x =
			            FORMAT ( IF ( _corte, IF ( [@a] <= _a1, 30 + ( [@a] - _a0 ) * DIVIDE ( _wa, _a1 - _a0 ), _xb + ( [@a] - _b0 ) * _eb ), 30 + ( [@a] - _t0 ) * _escala ), "0.0##", "en-US" ) -- geometria
			        RETURN
			            "<line x1='" & _x & "' y1='290' x2='" & _x & "' y2='302'/>"
			                & "<text x='" & _x & "' y='324'>" & [@a] & "</text>",
			        "",
			        [@a], ASC
			    )
			-- 4 · Marcação
			VAR _regua =
			    IF (
			        _ordem = 1,
			        _cab
			            & "<svg class='regua' width='1620' height='364' viewBox='0 0 1620 364'>"
			            & IF (
			                _corte,
			                "<line class='eixo traco' pathLength='1' x1='30' y1='296' x2='" & FORMAT ( 30 + _wa, "0.0##", "en-US" ) & "' y2='296'/>"
			                    & "<line class='eixo traco' pathLength='1' x1='" & FORMAT ( _xb, "0.0##", "en-US" ) & "' y1='296' x2='1590' y2='296'/>"
			                    & "<g class='corte'><line x1='" & FORMAT ( 30 + _wa + 12, "0.0##", "en-US" ) & "' y1='304' x2='" & FORMAT ( 30 + _wa + 20, "0.0##", "en-US" ) & "' y2='288'/>"
			                    & "<line x1='" & FORMAT ( 30 + _wa + 24, "0.0##", "en-US" ) & "' y1='304' x2='" & FORMAT ( 30 + _wa + 32, "0.0##", "en-US" ) & "' y2='288'/></g>",
			                "<line class='eixo traco' pathLength='1' x1='30' y1='296' x2='1590' y2='296'/>"
			            )
			            & "<g class='anos entra d4'>" & _marcas & "</g></svg>"
			    )
			VAR _html =
			    "<div class='tela m'>" & _regua
			        & "<svg class='liga' width='1620' height='364' viewBox='0 0 1620 364'>"
			        & "<path class='fio traco d" & _atraso & "' pathLength='1' d='" & _fio & "'/>"
			        & "<circle class='ponto brota d" & _atraso & "' cx='" & _txd & "' cy='296' r='7'/></svg>"
			        & "<div class='alvo card sobe d" & _atraso & "' style='left:" & FORMAT ( _xs - 76, "0.0##", "en-US" ) & "px'>"
			        & "<div class='ano nc'>" & _ano & _icone & "</div>"
			        & "<div class='tt'>" & _txtTit & "</div></div>"
			    & "</div>"
			RETURN
			    IF ( NOT ISBLANK ( _ordem ), _html )
		displayFolder: T02 Lula · quem é\Desenho
		lineageTag: c69dd040-0f9e-5de4-8f9d-9ff23aafa232

	/// Parcela de Lula nos válidos de 2026 do recorte (0–1); na linha de uma UF, o % da UF.
	measure 'T03 · %' =
			DIVIDE ( [T03 · votos], [T03 · válidos] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: bae320a3-7fbb-5a42-9d0c-7c60b815179c

	/// Parcela de Lula nos válidos de 2026 dos municípios do contexto (0–1).
	measure 'T03 · % (municípios)' =
			DIVIDE ( [T03 · votos (municípios)], [T03 · válidos (municípios)] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 9e0aee41-3b5c-5fc7-b41a-f1ae1f80d67e

	/// Parcela do PT nos válidos de 2022 do recorte (0–1).
	measure 'T03 · % 2022' =
			DIVIDE ( [T03 · votos 2022], [T03 · válidos 2022] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 8286e5ef-6dac-555b-9e16-3476316625ea

	/// Parcela do PT nos válidos de 2022 dos municípios do contexto.
	measure 'T03 · % 2022 (municípios)' =
			DIVIDE ( [T03 · votos 2022 (municípios)], [T03 · válidos 2022 (municípios)] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 2c9e509e-b7fa-5839-82f6-33fc0f996713

	/// Parcela de Lula nos válidos de 2026 no Brasil, com o exterior (sem recorte).
	measure 'T03 · % no Brasil' =
			CALCULATE ( [T03 · %], REMOVEFILTERS ( 'UF' ) )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 146828b2-e008-5d8f-a876-fc127ede17da

	/// Parcela de Lula nos válidos de 2026 da UF do município marcado (resultado oficial da UF).
	measure 'T03 · % no estado do município' =
			VAR _s = [T03 · UF do município]
			RETURN
			    IF ( NOT ISBLANK ( _s ), CALCULATE ( [T03 · %], REMOVEFILTERS ( 'UF' ), 'UF'[UF] = _s ) )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: ed845a05-3121-5b54-9997-339503689455

	/// Parcela de Lula nos válidos de 2026 somados em todas as cidades do Brasil com o mesmo porte do município marcado.
	measure 'T03 · % no porte do município' =
			VAR _p = [T03 · porte do município]
			RETURN
			    IF (
			        NOT ISBLANK ( _p ),
			        CALCULATE ( [T03 · % (municípios)], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[Porte] = _p )
			    )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 9b10a2c7-5a06-5140-97ee-74d8b8b989b9

	/// Parcela de Flávio nos válidos de 2026 dos municípios do contexto.
	measure 'T03 · adversário % (municípios)' =
			DIVIDE ( [T03 · votos do adversário (municípios)], [T03 · válidos (municípios)] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 9f36dfbb-333c-5d7d-90fd-9401ee6b2c20

	/// Parcela do adversário nos válidos de 2022 dos municípios do contexto.
	measure 'T03 · adversário % 2022 (municípios)' =
			DIVIDE ( [T03 · votos do adversário 2022 (municípios)], [T03 · válidos 2022 (municípios)] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: f2dedd99-ad41-50f7-aa76-ed389b7e9bbe

	/// Eleitores aptos em 2026 somados nos municípios (sem o exterior).
	measure 'T03 · aptos (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[Aptos] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 4c19b548-b5f2-5203-a313-2f250e6fca1a

	/// Nome de urna do candidato do PT em 2022.
	measure 'T03 · candidato 2022' =
			CALCULATE ( SELECTEDVALUE ( 'Candidato UF'[Candidato] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 13 )
		displayFolder: T03 Lula\Contas
		lineageTag: 4c381bf1-362a-56aa-b261-9f43f58f6c9c

	/// Entre as cidades de 100 mil habitantes ou mais do recorte, a de maior % do candidato (vazio se o recorte não tem cidade desse porte).
	measure 'T03 · cidade grande mais forte' =
			VAR _gr =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
			        "@p", [T03 · % (municípios)],
			        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
			    )
			VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
			RETURN
			    MAXX ( _top, 'Município'[Rótulo] )
		displayFolder: T03 Lula\Contas
		lineageTag: 23695967-a4cc-54ba-8dbe-d652053507aa

	/// % do candidato na cidade grande mais forte (0–1).
	measure 'T03 · cidade grande mais forte %' =
			VAR _gr =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
			        "@p", [T03 · % (municípios)],
			        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
			    )
			VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
			RETURN
			    MAXX ( _top, [@p] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 848a5757-2162-5030-a6de-1fcb17a4ac2b

	/// População (Censo 2022) da cidade grande mais forte.
	measure 'T03 · cidade grande mais forte população' =
			VAR _gr =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
			        "@p", [T03 · % (municípios)],
			        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
			    )
			VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
			RETURN
			    MAXX ( _top, [@pop] )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 1094662d-cbb6-5502-ab79-c31c002fe03f

	/// Quantas cidades do Brasil têm o mesmo porte do município marcado.
	measure 'T03 · cidades do porte' =
			VAR _p = [T03 · porte do município]
			RETURN
			    IF (
			        NOT ISBLANK ( _p ),
			        CALCULATE ( [T03 · municípios], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[Porte] = _p )
			    )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 49a1c618-af9d-5f01-a492-d5b086facfd3

	/// 1 quando há município marcado (o clique no mapa filtra 'Município'[CodIBGE]).
	measure 'T03 · com município' =
			INT ( ISFILTERED ( 'Município'[CodIBGE] ) || ISFILTERED ( 'Município'[Rótulo] ) )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: fe5e6892-4159-5524-b973-67385e672e88

	/// 1 quando a região foi CLICADA na origem dos votos (filtro cruzado em 'UF'[Região]); 0 nos outros casos. O filtro de estado da casca, em árvore, filtra 'UF'[Caminho] e não conta aqui (uma região escolhida nele é um recorte de vários estados: [T03 · vários estados]).
	measure 'T03 · com região' =
			INT ( ISFILTERED ( 'UF'[Região] ) || ISFILTERED ( 'UF'[RegiaoOrdem] ) )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: b4c22a05-8bf5-57f0-8b03-f6c1eb99f0d9

	/// 1 quando o recorte é UMA UF (filtro de estado da casca), 0 no Brasil, numa região ou com vários estados.
	measure 'T03 · com UF' =
			VAR _ufs = CALCULATE ( DISTINCTCOUNT ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
			RETURN
			    IF ( ISCROSSFILTERED ( 'UF' ) && _ufs = 1, 1, 0 )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 89f3aa54-e6bf-5e8c-85af-9ee3ac7703e6

	/// Parcela dos eleitores aptos do recorte que vivem nos municípios em que Lula ficou à frente (0–1).
	measure 'T03 · eleitores nos municípios à frente' =
			DIVIDE (
			    SUMX ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T03 · votos (municípios)] > [T03 · votos do adversário (municípios)] ), [T03 · aptos (municípios)] ),
			    [T03 · aptos (municípios)]
			)
		formatString: 0%
		displayFolder: T03 Lula\Contas
		lineageTag: 93b96f37-0d01-554b-9b92-f8b6abcf0408

	/// Nome da UF do município marcado.
	measure 'T03 · estado do município' =
			LOOKUPVALUE ( 'UF'[Nome], 'UF'[UF], [T03 · UF do município] )
		displayFolder: T03 Lula\Contas
		lineageTag: ca1686cd-74a7-5845-a3a5-bbf9e5a65435

	/// Onde a região da linha começa na barra da origem: soma das parcelas das regiões que deram mais votos que ela (0–1).
	measure 'T03 · início da região' =
			VAR _v = [T03 · votos (municípios)]
			VAR _antes =
			    CALCULATE (
			        SUMX ( FILTER ( VALUES ( 'UF'[Região] ), [T03 · votos (municípios)] > _v ), [T03 · votos (municípios)] ),
			        REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] )
			    )
			VAR _total = CALCULATE ( [T03 · votos (municípios)], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			RETURN
			    IF ( _v > 0, DIVIDE ( _antes, _total ) + 0 )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: a4cd5b0d-0a37-5ae7-aa58-b2df10c61a34

	/// 1 na entrada da origem (grão 'UF'[Região]) da primeira região do recorte, do Norte ao Sul: com vários estados no filtro, só ela desenha a lista de estados (as outras entradas ficam vazias).
	measure 'T03 · linha da primeira região' =
			VAR _primeira =
			    CALCULATE ( MIN ( 'UF'[RegiaoOrdem] ), REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ), 'UF'[Tipo] = "UF" )
			RETURN
			    INT ( SELECTEDVALUE ( 'UF'[RegiaoOrdem] ) = _primeira )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 2faf947a-59c3-5f72-b90c-6fa0d2fe564c

	/// UF (no Brasil ou na região) ou município (numa UF) onde o candidato teve o forte % dos válidos.
	measure 'T03 · lugar mais forte' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T03 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T03 · com UF] = 1 && [T03 · válidos (municípios)] > 0 ),
			        "@p", [T03 · % (municípios)]
			    )
			VAR _uf = [T03 · com UF] = 1
			RETURN
			    IF (
			        _uf,
			        MAXX ( TOPN ( 1, _mun, [@p], DESC, 'Município'[Rótulo], ASC ), 'Município'[Rótulo] ),
			        MAXX ( TOPN ( 1, _ufs, [@p], DESC, 'UF'[Nome], ASC ), 'UF'[Nome] )
			    )
		displayFolder: T03 Lula\Contas
		lineageTag: 956a84f8-8763-5dc0-9745-fa31b3d56048

	/// % do candidato nos válidos do lugar mais forte (0–1).
	measure 'T03 · lugar mais forte %' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T03 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T03 · com UF] = 1 && [T03 · válidos (municípios)] > 0 ),
			        "@p", [T03 · % (municípios)]
			    )
			VAR _uf = [T03 · com UF] = 1
			RETURN
			    IF ( _uf, MAXX ( _mun, [@p] ), MAXX ( _ufs, [@p] ) )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 0d3c3c23-a0ad-51fd-b6cb-7657efc1ee77

	/// UF (no Brasil ou na região) ou município (numa UF) onde o candidato teve o fraco % dos válidos.
	measure 'T03 · lugar mais fraco' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T03 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T03 · com UF] = 1 && [T03 · válidos (municípios)] > 0 ),
			        "@p", [T03 · % (municípios)]
			    )
			VAR _uf = [T03 · com UF] = 1
			RETURN
			    IF (
			        _uf,
			        MAXX ( TOPN ( 1, _mun, [@p], ASC, 'Município'[Rótulo], ASC ), 'Município'[Rótulo] ),
			        MAXX ( TOPN ( 1, _ufs, [@p], ASC, 'UF'[Nome], ASC ), 'UF'[Nome] )
			    )
		displayFolder: T03 Lula\Contas
		lineageTag: 7958dc34-2c46-5ca8-9ee1-a51bd1db68e0

	/// % do candidato nos válidos do lugar mais fraco (0–1).
	measure 'T03 · lugar mais fraco %' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T03 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T03 · com UF] = 1 && [T03 · válidos (municípios)] > 0 ),
			        "@p", [T03 · % (municípios)]
			    )
			VAR _uf = [T03 · com UF] = 1
			RETURN
			    IF ( _uf, MINX ( _mun, [@p] ), MINX ( _ufs, [@p] ) )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 4ad98ba8-02b3-5535-a3ea-f9509783abfc

	/// Margem de Lula em 2026: (votos dele − votos de Flávio) ÷ válidos (−1 a 1). Cor do ponto no mapa.
	measure 'T03 · margem' =
			DIVIDE ( [T03 · votos (municípios)] - [T03 · votos do adversário (municípios)], [T03 · válidos (municípios)] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: c264b4ca-a2e2-5459-83ea-f93e0f3c9da2

	/// Margem do PT em 2022: (votos − votos do adversário) ÷ válidos (−1 a 1).
	measure 'T03 · margem 2022' =
			DIVIDE ( [T03 · votos 2022 (municípios)] - [T03 · votos do adversário 2022 (municípios)], [T03 · válidos 2022 (municípios)] )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 12e746c5-a3bc-512d-8c0d-baa7e8095e9b

	/// Margem de Lula na região da linha em 2026, em pontos (votos dele − votos de Flávio) ÷ válidos × 100.
	measure 'T03 · margem na região' =
			[T03 · margem] * 100
		formatString: 0.0
		displayFolder: T03 Lula\Contas
		lineageTag: 573a2e70-64a2-52bf-a91a-684e20a3aa0a

	/// Nome (UF) do município da linha.
	measure 'T03 · município' =
			SELECTEDVALUE ( 'Município'[Rótulo] )
		displayFolder: T03 Lula\Contas
		lineageTag: 4c73b737-53d5-5ed1-91b8-a094497ab277

	/// Municípios do recorte com votos válidos em 2026.
	measure 'T03 · municípios' =
			COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T03 · válidos (municípios)] > 0 ) )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 92e4397a-0087-508e-85a2-49598fdb4df6

	/// Quantos municípios tem a UF do município marcado.
	measure 'T03 · municípios no estado do município' =
			VAR _s = [T03 · UF do município]
			RETURN
			    IF ( NOT ISBLANK ( _s ), CALCULATE ( [T03 · municípios], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s ) )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 1f032c8b-6b3a-5838-a6d8-149ab78b5976

	/// Municípios do recorte em que Lula teve mais votos que Flávio.
	measure 'T03 · municípios à frente' =
			COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T03 · votos (municípios)] > [T03 · votos do adversário (municípios)] ) ) + 0
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 8bddd01a-80a1-585c-8a73-957650d0377b

	/// Colocação da região da linha pelos votos de Lula (1 = a que mais deu votos), entre as regiões do recorte.
	measure 'T03 · ordem da região' =
			VAR _v = [T03 · votos (municípios)]
			VAR _maiores =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'UF'[Região] ), [T03 · votos (municípios)] > _v ),
			        REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] )
			    )
			RETURN
			    IF ( _v > 0, 1 + COUNTROWS ( _maiores ) )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 02e4be70-13bd-57a6-8a35-93d583e6d0e7

	/// Parcela dos votos de Lula na região que veio da UF da linha (0–1), resultado oficial.
	measure 'T03 · parte do estado na região' =
			DIVIDE (
			    [T03 · votos],
			    CALCULATE ( [T03 · votos], REMOVEFILTERS ( 'UF'[UF], 'UF'[Nome], 'UF'[Ordem] ) )
			)
		formatString: 0%
		displayFolder: T03 Lula\Contas
		lineageTag: b789c217-5ad5-568d-bff6-600fdf9b68e8

	/// Parcela dos votos de Lula no recorte (soma dos municípios) que veio da UF da linha (0–1): a lista de estados da origem quando o filtro escolheu vários. Tira só as colunas da UF da linha; o recorte do filtro ('UF'[Caminho]) fica.
	measure 'T03 · parte do estado no recorte' =
			DIVIDE (
			    [T03 · votos (municípios)],
			    CALCULATE ( [T03 · votos (municípios)], REMOVEFILTERS ( 'UF'[UF], 'UF'[Nome], 'UF'[Ordem] ) )
			)
		formatString: 0%
		displayFolder: T03 Lula\Contas
		lineageTag: 663681b8-bd4d-53a9-8c8d-0e3680366a7b

	/// Parcela dos votos de Lula na UF (soma dos municípios) que saiu do município marcado (0–1).
	measure 'T03 · parte do município no estado' =
			VAR _s = [T03 · UF do município]
			RETURN
			    IF (
			        NOT ISBLANK ( _s ),
			        DIVIDE ( [T03 · votos (municípios)], CALCULATE ( [T03 · votos (municípios)], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s ) )
			    )
		formatString: 0.0%
		displayFolder: T03 Lula\Contas
		lineageTag: 203a4d25-506c-5f1f-b52d-088f7cb3c3ba

	/// Parcela dos votos de Lula (soma dos municípios do recorte) que veio da região ou do município da linha (0–1). Tira só as colunas do item (a região e a ordem dela, o rótulo do município).
	measure 'T03 · parte dos votos' =
			DIVIDE (
			    [T03 · votos (municípios)],
			    CALCULATE ( [T03 · votos (municípios)], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ), REMOVEFILTERS ( 'Município'[Rótulo] ) )
			)
		formatString: 0%
		displayFolder: T03 Lula\Contas
		lineageTag: 15db599c-b099-5e3c-828d-d30a0b6ddc77

	/// População (Censo 2022) do município da linha.
	measure 'T03 · população' =
			SUM ( 'Município'[População] )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 553387a8-521c-557c-b09d-ba9edb38041a

	/// Faixa de população do município marcado.
	measure 'T03 · porte do município' =
			SELECTEDVALUE ( 'Município'[Porte] )
		displayFolder: T03 Lula\Contas
		lineageTag: 00027a15-35a1-50ea-ba40-8a2832daa5c0

	/// Colocação de Lula no 1º turno de 2026, no recorte.
	measure 'T03 · posição' =
			VAR _v = [T03 · votos]
			VAR _todos =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Candidato UF'[Número] ), 'Candidato UF'[Ano] = 2026 ),
			        "@v", CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026 )
			    )
			RETURN
			    1 + COUNTROWS ( FILTER ( _todos, [@v] > _v ) )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 785b953f-f108-520d-a9a7-13273dff87df

	/// Lugar do município marcado entre as cidades da UF dele pelos % dos válidos de Lula (1 = o maior).
	measure 'T03 · posição em % no estado' =
			VAR _s = [T03 · UF do município]
			VAR _v = [T03 · % (municípios)]
			VAR _maiores =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'Município'[CodIBGE] ), [T03 · válidos (municípios)] > 0 && [T03 · % (municípios)] > _v ),
			        REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s
			    )
			RETURN
			    IF ( NOT ISBLANK ( _s ) && _v > 0, 1 + COUNTROWS ( _maiores ) )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 89dcdb98-74cc-5ffd-8559-0b10a1e227d0

	/// Lugar do município marcado entre as cidades da UF dele pelos votos de Lula (1 = o maior).
	measure 'T03 · posição em votos no estado' =
			VAR _s = [T03 · UF do município]
			VAR _v = [T03 · votos (municípios)]
			VAR _maiores =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'Município'[CodIBGE] ), [T03 · válidos (municípios)] > 0 && [T03 · votos (municípios)] > _v ),
			        REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s
			    )
			RETURN
			    IF ( NOT ISBLANK ( _s ) && _v > 0, 1 + COUNTROWS ( _maiores ) )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 98b5b142-3ca4-5d12-b0bc-ace51d285e28

	/// Nome do recorte: o município marcado ou o recorte de estado, lido da medida comum [Recorte · nome] (Brasil; a UF; a região, escolhida no filtro ou clicada na origem; 'MG e SP'; '3 estados').
	measure 'T03 · recorte' =
			IF (
			    [T03 · com município] = 1,
			    SELECTEDVALUE ( 'Município'[Rótulo], "municípios marcados" ),
			    [Recorte · nome]
			)
		displayFolder: T03 Lula\Contas
		lineageTag: 97cf38f2-0ab9-56bb-9835-67289bd4d596

	/// Nome da região da linha da origem (grão 'UF'[Região]).
	measure 'T03 · região da linha' =
			SELECTEDVALUE ( 'UF'[Região] )
		displayFolder: T03 Lula\Contas
		lineageTag: 45f5c154-ac1d-56f5-98a4-e40937aa0064

	/// Região do município da linha.
	measure 'T03 · região do município' =
			SELECTEDVALUE ( 'Município'[Região] )
		displayFolder: T03 Lula\Contas
		lineageTag: 7186e8f6-982a-5805-b5dc-22cc31a6caa9

	/// No município da linha: 1 = à frente nos dois anos · 2 = estava à frente em 2022 e ficou atrás em 2026 · 3 = virou a favor · 4 = atrás nos dois anos.
	measure 'T03 · situação' =
			VAR _m22 = [T03 · margem 2022]
			VAR _m26 = [T03 · margem]
			RETURN
			    SWITCH ( TRUE (), _m22 > 0 && _m26 > 0, 1, _m22 > 0, 2, _m26 > 0, 3, 4 )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 288a3a42-900d-5029-8eb2-f80316a748d6

	/// Nome da UF da linha (lista de estados do dossiê da região e da origem com vários estados).
	measure 'T03 · UF da linha' =
			SELECTEDVALUE ( 'UF'[Nome] )
		displayFolder: T03 Lula\Contas
		lineageTag: 34cf69ae-efdd-503e-847e-eb9bb4de4e96

	/// Sigla da UF do município da linha (ou do município marcado).
	measure 'T03 · UF do município' =
			SELECTEDVALUE ( 'Município'[UF] )
		displayFolder: T03 Lula\Contas
		lineageTag: 950c81a1-1c64-59ad-9194-8e685dbdb54c

	/// Votos do PT em 2026 menos 2022, no recorte.
	measure 'T03 · variação de votos' =
			[T03 · votos] - [T03 · votos 2022]
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 359cefd6-0e49-5fbf-939b-a8d7bb165552

	/// Votos do PT em 2026 menos 2022, somados nos municípios do contexto (a ficha do município marcado).
	measure 'T03 · variação de votos (municípios)' =
			[T03 · votos (municípios)] - [T03 · votos 2022 (municípios)]
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 4c28d1f7-e716-5a90-ae5f-8f67bbbb85c6

	/// Variação do % do PT de 2022 para 2026, em pontos percentuais.
	measure 'T03 · variação em p.p.' =
			( [T03 · %] - [T03 · % 2022] ) * 100
		formatString: 0.0
		displayFolder: T03 Lula\Contas
		lineageTag: 77b9f692-86a4-5cb9-b9d3-c643fb07b05c

	/// Variação do % do PT de 2022 para 2026 nos municípios do contexto, em pontos percentuais.
	measure 'T03 · variação em p.p. (municípios)' =
			( [T03 · % (municípios)] - [T03 · % 2022 (municípios)] ) * 100
		formatString: 0.0
		displayFolder: T03 Lula\Contas
		lineageTag: da632259-0519-512f-b617-9612274ea60b

	/// Votos de Lula (número 13) no 1º turno de 2026, no recorte (com o exterior no Brasil).
	measure 'T03 · votos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 13 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: d902bfb8-0b53-55bf-829c-4c953c9583c4

	/// Votos de Lula em 2026 somados nos municípios do contexto (sem o exterior).
	measure 'T03 · votos (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 9d356702-448b-5700-a05e-8212dad3763e

	/// Votos do candidato do PT no 1º turno de 2022, no recorte.
	measure 'T03 · votos 2022' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 13 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 67fdc316-987a-5acf-9d1f-7cf1481b907f

	/// Votos do PT em 2022 somados nos municípios (sem o exterior).
	measure 'T03 · votos 2022 (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 77e7cc4f-3c6f-5b1e-8a36-ec249853aa1c

	/// Votos de Flávio em 2026 somados nos municípios (sem o exterior).
	measure 'T03 · votos do adversário (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 7451c810-6fb9-5d98-ab0a-eb71bd8b122b

	/// Votos do adversário em 2022 somados nos municípios (sem o exterior).
	measure 'T03 · votos do adversário 2022 (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 3e1e5a20-9723-566a-8099-acb01d1d06ef

	/// Votos válidos do 1º turno de 2026 no recorte.
	measure 'T03 · válidos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 3f986090-7237-5c92-9b41-5c53d34c37d0

	/// Votos válidos de 2026 somados nos municípios (sem o exterior).
	measure 'T03 · válidos (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: a32f9de8-4c02-5ce5-9395-37513ca4f097

	/// Votos válidos do 1º turno de 2022 no recorte.
	measure 'T03 · válidos 2022' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: e70aafa5-f290-5ec4-9137-3d37a0791894

	/// Votos válidos de 2022 somados nos municípios (sem o exterior).
	measure 'T03 · válidos 2022 (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T03 Lula\Contas
		lineageTag: 03889dde-92b6-508f-94b5-13bbc29353e4

	/// 1 quando o filtro de estado escolheu mais de uma UF (uma região inteira, estados soltos ou regiões misturadas): a origem mostra os estados do recorte. Ignora a região da linha da origem (o grão) e a região clicada; 0 no Brasil e numa UF.
	measure 'T03 · vários estados' =
			VAR _com = CALCULATE ( [Recorte · com escolha], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			VAR _n = CALCULATE ( [Recorte · UFs], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			RETURN
			    IF ( _com = 1 && _n > 1, 1, 0 )
		formatString: 0
		displayFolder: T03 Lula\Contas
		lineageTag: 07866482-b6bd-5776-9615-a580da7fa6d1

	/// Centro do município no quadro 1000 × 1000 dos mapas (x), para o ponto do mapa.
	measure 'T03 · x do município' =
			SELECTEDVALUE ( 'Município'[X] )
		formatString: 0.00
		displayFolder: T03 Lula\Contas
		lineageTag: c5248d63-8915-5c0f-a40f-77cd843f691d

	/// Centro do município no quadro 1000 × 1000 dos mapas (y, para baixo).
	measure 'T03 · y do município' =
			SELECTEDVALUE ( 'Município'[Y] )
		formatString: 0.00
		displayFolder: T03 Lula\Contas
		lineageTag: 41f20f8f-7eec-5089-a582-23ae03a702cd

	/// Texto para leitor de tela da legenda do mapa.
	measure 'T03 · Legenda · ALT' =
			"Legenda: cada ponto é um município, o tamanho segue os votos de Lula; a cor mostra onde Lula ficou à "
			    & "frente (mais escuro, maior margem) e, em areia, onde Flávio ficou à frente. Clique num ponto para levar "
			    & "a cidade ao painel."
		displayFolder: T03 Lula\Desenho
		lineageTag: b7392a91-3aff-5a03-a305-dbab75ac0349

	/// Legenda do mapa de pontos (como ler a cor e o tamanho) e a dica do que o clique faz, ou do que está marcado agora.
	measure 'T03 · Legenda · HTML' =
			-- 1 · Leituras
			VAR _comMun = [T03 · com município]
			VAR _comReg = [T03 · com região]
			VAR _rec = [T03 · recorte]
			-- 2 · Textos
			VAR _dica =
			    SWITCH (
			        TRUE (),
			        _comMun = 1, "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rec, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</b> marcado · clique no vazio do mapa para voltar",
			        _comReg = 1, "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rec, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</b> marcado · clique de novo na região para voltar",
			        "passe o mouse num ponto para ver a cidade; clique para levá-la ao painel"
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela lgm entra d6'>"
			        & "<span class='it'><i class='bol'></i>cada ponto é um município; o tamanho segue os votos de Lula</span>"
			        & "<span class='it'><i class='esc'></i>Lula à frente: quanto mais escuro, maior a margem</span>"
			        & "<span class='it'><i class='atr'></i>Flávio à frente</span>"
			        & "<span class='it dica'>" & _dica & "</span>"
			    & "</div>"
		displayFolder: T03 Lula\Desenho
		lineageTag: 0339856b-3b37-576d-8303-b8b07715b48e

	/// Texto para leitor de tela do mapa de pontos.
	measure 'T03 · Mapa · ALT' =
			LEFT (
			    "Mapa (" & [T03 · recorte] & ") com um ponto por município: Lula ficou à frente em "
			        & [T03 · municípios à frente] & " de " & [T03 · municípios]
			        & IF ( [T03 · municípios] = 1, " município", " municípios" ) & ". Passe o mouse num ponto "
			        & "para ver a cidade; clique para levá-la ao painel.",
			    250
			)
		displayFolder: T03 Lula\Desenho
		lineageTag: 0dbe72c3-5bca-5e22-b91c-bace5d8cd440

	/// Texto para leitor de tela da origem dos votos.
	measure 'T03 · Origem · ALT' =
			LEFT (
			    SWITCH (
			        TRUE (),
			        [T03 · com município] = 1,
			            [T03 · município] & ": " & FORMAT ( [T03 · parte do município no estado], "0.0%" ) & " dos votos de Lula em "
			                & [T03 · estado do município] & ".",
			        [T03 · vários estados] = 1,
			            "Os estados que mais deram votos a Lula " & [Recorte · em] & ", com a parte de cada um nos "
			                & "votos dele.",
			        [T03 · com UF] = 1,
			            "As cidades que mais deram votos a Lula " & [Recorte · em] & ".",
			        "De onde vêm os votos de Lula, por região. Clique numa região para ver só ela no mapa; passe o mouse "
			            & "para ver os estados dela."
			    ),
			    250
			)
		displayFolder: T03 Lula\Desenho
		lineageTag: e257d182-5bb8-5aa8-b5cb-b07d7777e486

	/// Com vários estados no filtro de estado (uma região inteira, estados soltos ou regiões misturadas): os estados que mais deram votos a Lula na barra (os 5 maiores e os demais estados) e na lista — a parte de cada um nos votos dele no recorte, os votos e o % dos válidos. Só a entrada da primeira região do recorte desenha (as outras ficam vazias). Sem clique (o clique numa cidade é no mapa).
	measure 'T03 · Origem · bloco estados' =
			-- 1 · Leituras
			VAR _primeira = [T03 · linha da primeira região]
			VAR _n = CALCULATE ( [Recorte · UFs], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			VAR _ufsBase =
			    CALCULATETABLE (
			        TOPN (
			            5,
			            ADDCOLUMNS (
			                VALUES ( 'UF'[UF] ),
			                "@nome", [T03 · UF da linha],
			                "@v", [T03 · votos (municípios)],
			                "@p", [T03 · parte do estado no recorte],
			                "@pv", [T03 · % (municípios)]
			            ),
			            [@v], DESC
			        ),
			        REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ),
			        'UF'[Tipo] = "UF"
			    )
			VAR _lista =
			    SELECTCOLUMNS ( FILTER ( _ufsBase, [@v] > 0 ), "@nome", [@nome], "@v", [@v], "@p", [@p], "@pv", [@pv] ) /* lista */
			-- 3 · Geometria (barra de 620 px; as fatias seguem a ordem dos votos; linhas de 30 px a partir de y 92)
			VAR _comIni =
			    ADDCOLUMNS (
			        _lista,
			        "@ini", VAR _vv = [@v] RETURN SUMX ( FILTER ( _lista, [@v] > _vv ), [@p] ) + 0, /* lista */
			        "@ord", VAR _vv = [@v] RETURN 1 + COUNTROWS ( FILTER ( _lista, [@v] > _vv ) ) /* lista */
			    )
			VAR _sobra = ( 1 - SUMX ( _lista, [@p] ) ) * 620 -- geometria (o trilho dos demais estados)
			VAR _fatias =
			    CONCATENATEX (
			        _comIni,
			        VAR _w = [@p] * 620 -- geometria
			        VAR _cabe = ( LEN ( [@nome] ) + 4 ) * 9.4 + 16 -- geometria (nome e % em Sora 15 semibold)
			        VAR _rot = IF ( _w >= _cabe, [@nome] & " " & FORMAT ( [@p], "0%" ), IF ( _w >= 44, FORMAT ( [@p], "0%" ), "" ) )
			        RETURN
			            "<div class='fa o" & MIN ( [@ord], 5 ) & " barra-x d" & ( [@ord] + 4 ) & "' style='left:"
			                & FORMAT ( [@ini] * 620, "0.0##", "en-US" ) & "px;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rot, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span></div>",
			        "",
			        [@v], DESC
			    )
			VAR _linhas =
			    CONCATENATEX (
			        _comIni,
			        "<div class='li sobe d" & ( [@ord] + 6 ) & "' style='top:" & ( 92 + ( [@ord] - 1 ) * 30 ) & "px'>"
			            & "<i class='sw o" & MIN ( [@ord], 5 ) & "'></i><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [@nome], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>"
			            & "<span class='a'>" & FORMAT ( [@p], "0%" ) & " dos votos dele · " & SWITCH ( TRUE (), ABS ( [@v] ) >= 1000000, FORMAT ( [@v] / 1000000, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( [@v] / 1000, "0.0" ) & " mil", FORMAT ( [@v], "#,0" ) ) & "</span>"
			            & "<span class='b'>" & FORMAT ( [@pv], "0.0%" ) & " dos válidos</span></div>",
			        "",
			        [@v], DESC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        _primeira = 1,
			        "<div class='tela og'><div class='oc'>"
			            & "<div class='rot ro sobe'>De onde vêm os votos · os estados que mais deram votos</div>"
			            & "<div class='trilho entra d3'></div>"
			            & IF ( _n > 5 && _sobra >= 136, "<span class='resto entra d9'>demais estados</span>" )
			            & _fatias & _linhas
			            & "<div class='dica entra d14'>clique num ponto do mapa para ver uma cidade</div>"
			        & "</div></div>"
			    )
		displayFolder: T03 Lula\Desenho
		lineageTag: edba55c8-df45-5c3e-bd4e-7f99ddcb84e8

	/// Com um município marcado (uma entrada só): o lugar dele entre as cidades da UF — a fatia dos votos de Lula no estado que saiu dele e as posições em votos e em % dos válidos. Sem clique.
	measure 'T03 · Origem · bloco município' =
			-- 1 · Leituras
			VAR _mun = [T03 · município]
			VAR _est = [T03 · estado do município]
			VAR _parte = [T03 · parte do município no estado]
			VAR _posV = [T03 · posição em votos no estado]
			VAR _posP = [T03 · posição em % no estado]
			VAR _n = [T03 · municípios no estado do município]
			-- 2 · Textos
			VAR _nm = IF ( RIGHT ( _mun, 1 ) = ")", LEFT ( _mun, LEN ( _mun ) - 5 ), _mun )
			VAR _txtNm = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtEst = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _est, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _rotulo =
			    IF (
			        _n = 1,
			        _txtNm & " · " & _txtEst & " · o único município",
			        "No estado · " & _txtEst & " · " & FORMAT ( _n, "#,0" ) & " cidades"
			    )
			VAR _txtParte = FORMAT ( _parte, "0.0%" ) & " dos votos de Lula no estado saíram daqui"
			VAR _linhaV =
			    IF (
			        _posV = 1,
			        "a cidade que mais deu votos a Lula no estado",
			        "cidade que mais deu votos a Lula no estado"
			    )
			VAR _linhaP =
			    IF (
			        _posP = 1,
			        "onde Lula teve o maior % dos válidos no estado",
			        "no % dos válidos de Lula, da mais forte à mais fraca"
			    )
			-- 3 · Geometria (barra de 620 px)
			VAR _w = MAX ( _parte * 620, 4 ) -- geometria
			VAR _dentro = _w >= 360 -- geometria
			VAR _xr = FORMAT ( _w + 12, "0.0##", "en-US" ) -- geometria
			-- 4 · Marcação
			VAR _rk =
			    IF (
			        _n > 1,
			        "<div class='rk sobe d8' style='top:96px'><span class='n lula'>" & _posV & "ª</span><span class='t'>"
			            & _linhaV & "</span></div>"
			            & "<div class='rk sobe d10' style='top:160px'><span class='n'>" & _posP & "ª</span><span class='t'>"
			            & _linhaP & "</span></div>"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _mun ),
			        "<div class='tela og'><div class='oc'>"
			            & "<div class='rot ro sobe'>" & _rotulo & "</div>"
			            & "<div class='trilho entra d3'></div>"
			            & "<div class='fa o1 barra-x d5' style='left:0;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>"
			            & IF ( _dentro, _txtParte ) & "</span></div>"
			            & IF ( NOT _dentro, "<span class='lfa entra d8' style='left:" & _xr & "px'>" & _txtParte & "</span>" )
			            & _rk
			            & "<div class='dica entra d14'>clique no vazio do mapa para voltar</div>"
			        & "</div></div>"
			    )
		displayFolder: T03 Lula\Desenho
		lineageTag: accc3b2a-1043-5503-880a-6ecc1e2ecc6a

	/// A região da linha na barra da origem (fatia proporcional aos votos, na ordem dos votos) e na lista (parte dos votos dele, votos e % dos válidos). O rótulo do bloco e a dica do clique ficam no modelo do visual (fora das entradas, não esmaecem com a seleção). Fatia e linha têm alvos de clique próprios, fixos (L012).
	measure 'T03 · Origem · bloco região' =
			-- 1 · Leituras
			VAR _reg = [T03 · região da linha]
			VAR _v = [T03 · votos (municípios)]
			VAR _p = [T03 · parte dos votos]
			VAR _pv = [T03 · % (municípios)]
			VAR _ord = [T03 · ordem da região]
			VAR _ini = [T03 · início da região]
			-- 2 · Textos
			VAR _txtNome = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtP = FORMAT ( _p, "0%" )
			VAR _o = MIN ( _ord, 5 )
			-- 3 · Geometria (barra de 620 px; linhas de 30 px a partir de y 92)
			VAR _w = _p * 620 -- geometria
			VAR _rot = IF ( _w >= 120, _txtNome & " " & _txtP, IF ( _w >= 44, _txtP, "" ) )
			VAR _x = FORMAT ( _ini * 620, "0.0##", "en-US" ) -- geometria
			VAR _wc = FORMAT ( _w, "0.0##", "en-US" ) -- geometria
			VAR _y = 92 + ( _ord - 1 ) * 30 -- geometria
			-- 4 · Marcação
			RETURN
			    "<div class='tela og'><div class='oc'>"
			        & "<div class='vis fa o" & _o & " barra-x d" & ( _ord + 4 ) & "' style='left:" & _x & "px;width:" & _wc
			        & "px'><span>" & _rot & "</span></div>"
			        & "<div class='hv' style='left:" & _x & "px;top:28px;width:" & _wc & "px;height:46px'></div>"
			        & "<div class='vis li sobe d" & ( _ord + 6 ) & "' style='top:" & _y & "px'><i class='sw o" & _o & "'></i>"
			        & "<span class='nm'>" & _txtNome & "</span><span class='a'>" & _txtP & " dos votos dele · " & SWITCH ( TRUE (), ABS ( _v ) >= 1000000, FORMAT ( _v / 1000000, "0.00" ) & " mi", ABS ( _v ) >= 1000, FORMAT ( _v / 1000, "0.0" ) & " mil", FORMAT ( _v, "#,0" ) )
			        & "</span><span class='b'>" & FORMAT ( _pv, "0.0%" ) & " dos válidos</span></div>"
			        & "<div class='hv' style='left:-10px;top:" & _y & "px;width:640px;height:30px'></div>"
			    & "</div></div>"
		displayFolder: T03 Lula\Desenho
		lineageTag: 5c6712a5-6e7d-58f1-a853-f23996a15af2

	/// Numa UF (uma entrada só): as cidades que mais deram votos a Lula na barra (as 5 maiores e os demais municípios) e na lista. Sem clique (o clique numa cidade é no mapa).
	measure 'T03 · Origem · bloco UF' =
			-- 1 · Leituras
			VAR _munsBase =
			    TOPN (
			        5,
			        ADDCOLUMNS (
			            VALUES ( 'Município'[Rótulo] ),
			            "@v", [T03 · votos (municípios)],
			            "@p", [T03 · parte dos votos],
			            "@pv", [T03 · % (municípios)]
			        ),
			        [@v], DESC
			    )
			VAR _lista =
			    SELECTCOLUMNS ( FILTER ( _munsBase, [@v] > 0 ), "@nome", 'Município'[Rótulo], "@v", [@v], "@p", [@p], "@pv", [@pv] ) /* lista */
			-- 3 · Geometria (barra de 620 px; as fatias seguem a ordem dos votos; linhas de 30 px a partir de y 92)
			VAR _comIni =
			    ADDCOLUMNS (
			        _lista,
			        "@ini", VAR _vv = [@v] RETURN SUMX ( FILTER ( _lista, [@v] > _vv ), [@p] ) + 0, /* lista */
			        "@ord", VAR _vv = [@v] RETURN 1 + COUNTROWS ( FILTER ( _lista, [@v] > _vv ) ) /* lista */
			    )
			VAR _fatias =
			    CONCATENATEX (
			        _comIni,
			        VAR _w = [@p] * 620 -- geometria
			        VAR _nm = IF ( RIGHT ( [@nome], 1 ) = ")", LEFT ( [@nome], LEN ( [@nome] ) - 5 ), [@nome] )
			        VAR _rot = IF ( _w >= 120, _nm & " " & FORMAT ( [@p], "0%" ), IF ( _w >= 44, FORMAT ( [@p], "0%" ), "" ) )
			        RETURN
			            "<div class='fa o" & MIN ( [@ord], 5 ) & " barra-x d" & ( [@ord] + 4 ) & "' style='left:"
			                & FORMAT ( [@ini] * 620, "0.0##", "en-US" ) & "px;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rot, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span></div>",
			        "",
			        [@v], DESC
			    )
			VAR _linhas =
			    CONCATENATEX (
			        _comIni,
			        VAR _nm = IF ( RIGHT ( [@nome], 1 ) = ")", LEFT ( [@nome], LEN ( [@nome] ) - 5 ), [@nome] )
			        RETURN
			            "<div class='li sobe d" & ( [@ord] + 6 ) & "' style='top:" & ( 92 + ( [@ord] - 1 ) * 30 ) & "px'>"
			                & "<i class='sw o" & MIN ( [@ord], 5 ) & "'></i><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>"
			                & "<span class='a'>" & FORMAT ( [@p], "0%" ) & " dos votos dele · " & SWITCH ( TRUE (), ABS ( [@v] ) >= 1000000, FORMAT ( [@v] / 1000000, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( [@v] / 1000, "0.0" ) & " mil", FORMAT ( [@v], "#,0" ) ) & "</span>"
			                & "<span class='b'>" & FORMAT ( [@pv], "0.0%" ) & " dos válidos</span></div>",
			        "",
			        [@v], DESC
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela og'><div class='oc'>"
			        & "<div class='rot ro sobe'>De onde vêm os votos · as cidades que mais deram votos</div>"
			        & "<div class='trilho entra d3'></div><span class='resto entra d9'>demais municípios</span>"
			        & _fatias & _linhas
			        & "<div class='dica entra d14'>clique num ponto do mapa para ver uma cidade</div>"
			    & "</div></div>"
		displayFolder: T03 Lula\Desenho
		lineageTag: fa0e8e8e-005e-5886-a046-e98d0a8d142e

	/// De onde vêm os votos de Lula, uma entrada por região: no Brasil, a fatia e a linha da região (clicáveis); com vários estados no filtro (uma região inteira ou estados soltos), os estados que mais deram votos; numa UF, as cidades que mais deram votos; com um município marcado, o lugar dele entre as cidades do estado. Só escolhe o bloco.
	measure 'T03 · Origem · HTML' =
			VAR _v = [T03 · votos (municípios)]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ( _v > 0 ), BLANK (),
			        [T03 · com município] = 1, [T03 · Origem · bloco município],
			        [T03 · vários estados] = 1, [T03 · Origem · bloco estados],
			        [T03 · com UF] = 1, [T03 · Origem · bloco UF],
			        [T03 · Origem · bloco região]
			    )
		displayFolder: T03 Lula\Desenho
		lineageTag: cece9420-6fd2-555c-ae47-3df6501369b7

	/// Texto para leitor de tela da coluna do resumo (recorte ou município marcado).
	measure 'T03 · Resumo · ALT' =
			IF (
			    [T03 · com município] = 1,
			    LEFT (
			        "Lula em " & [T03 · município] & ": " & FORMAT ( [T03 · % (municípios)], "0.0%" ) & " dos válidos, "
			            & SWITCH ( TRUE (), ABS ( [T03 · votos (municípios)] ) >= 1000000, FORMAT ( [T03 · votos (municípios)] / 1000000, "0.00" ) & " mi", ABS ( [T03 · votos (municípios)] ) >= 1000, FORMAT ( [T03 · votos (municípios)] / 1000, "0.0" ) & " mil", FORMAT ( [T03 · votos (municípios)], "#,0" ) ) & " de votos; no estado, " & FORMAT ( [T03 · % no estado do município], "0.0%" )
			            & ".",
			        250
			    ),
			    LEFT (
			        "Lula, " & [T03 · recorte] & ": " & FORMAT ( [T03 · %], "0.0%" ) & " dos válidos, " & SWITCH ( TRUE (), ABS ( [T03 · votos] ) >= 1000000, FORMAT ( [T03 · votos] / 1000000, "0.00" ) & " mi", ABS ( [T03 · votos] ) >= 1000, FORMAT ( [T03 · votos] / 1000, "0.0" ) & " mil", FORMAT ( [T03 · votos], "#,0" ) )
			            & " de votos; à frente em " & [T03 · municípios à frente] & " de " & [T03 · municípios]
			            & IF ( [T03 · municípios] = 1, " município", " municípios" ) & ". Mais forte: "
			            & [T03 · lugar mais forte] & "; mais fraco: " & [T03 · lugar mais fraco] & ".",
			        250
			    )
			)
		displayFolder: T03 Lula\Desenho
		lineageTag: d94ddd46-fee9-5ccf-86a3-4e7c29ff670f

	/// Ficha do município marcado no mapa: o % e os votos de Lula lá, a margem sobre Flávio (e se a cidade virou desde 2022), 2022 → 2026 e três comparações: o estado, as cidades do mesmo porte no Brasil e o Brasil.
	measure 'T03 · Resumo · bloco município' =
			-- 1 · Leituras
			VAR _mun = [T03 · município]
			VAR _pct = [T03 · % (municípios)]
			VAR _votos = [T03 · votos (municípios)]
			VAR _m26 = [T03 · margem]
			VAR _sit = [T03 · situação]
			VAR _v22 = [T03 · votos 2022 (municípios)]
			VAR _p22 = [T03 · % 2022 (municípios)]
			VAR _c22 = [T03 · candidato 2022]
			VAR _dv = [T03 · variação de votos (municípios)]
			VAR _dpp = [T03 · variação em p.p. (municípios)]
			VAR _est = [T03 · estado do município]
			VAR _pEst = [T03 · % no estado do município]
			VAR _porte = [T03 · porte do município]
			VAR _pPorte = [T03 · % no porte do município]
			VAR _nPorte = [T03 · cidades do porte]
			VAR _pBr = [T03 · % no Brasil]
			-- 2 · Textos
			VAR _nm = IF ( RIGHT ( _mun, 1 ) = ")", LEFT ( _mun, LEN ( _mun ) - 5 ), _mun )
			VAR _txtNm = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtMun = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mun, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _mpp = ABS ( _m26 ) * 100
			VAR _txtM = FORMAT ( _mpp, "0.0" ) & IF ( _mpp < 2, " ponto", " pontos" )
			VAR _lado = IF ( _m26 > 0, "à frente de Flávio", "atrás de Flávio" )
			VAR _manchete =
			    SWITCH (
			        TRUE (),
			        _m26 = 0, "Em " & _txtNm & ", Lula e Flávio empataram",
			        _sit = 2 || _sit = 3, _txtNm & " virou: Lula ficou " & _txtM & " " & _lado,
			        "Em " & _txtNm & ", Lula ficou " & _txtM & " " & _lado & ", como em 2022"
			    )
			VAR _clsMc = IF ( LEN ( _manchete ) > 74, " l", "" )
			VAR _txtLado = IF ( _m26 > 0, "à frente de Flávio", IF ( _m26 < 0, "atrás de Flávio", "empate com Flávio" ) )
			VAR _txtDV = IF ( _dv < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dv ) ) >= 1000000, FORMAT ( ABS ( _dv ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dv ) ) >= 1000, FORMAT ( ABS ( _dv ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dv ), "#,0" ) )
			VAR _pontos = IF ( ABS ( _dpp ) < 2, " ponto", " pontos" )
			VAR _compara =
			    "Em 2022, " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " teve " & SWITCH ( TRUE (), ABS ( _v22 ) >= 1000000, FORMAT ( _v22 / 1000000, "0.00" ) & " mi", ABS ( _v22 ) >= 1000, FORMAT ( _v22 / 1000, "0.0" ) & " mil", FORMAT ( _v22, "#,0" ) ) & IF ( _v22 = 1, " voto", " votos" ) & " aqui ("
			        & FORMAT ( _p22, "0.0%" ) & "). Agora: <b class='lula-esc'>" & _txtDV
			        & IF ( ABS ( _dv ) >= 1000, " de votos", IF ( ABS ( _dv ) = 1, " voto", " votos" ) )
			        & "</b> e <b class='lula-esc'>" & FORMAT ( _dpp, "+0.0;−0.0;0.0" ) & _pontos & "</b>."
			VAR _txtPorte = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _porte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " <small>" & FORMAT ( _nPorte, "#,0" ) & IF ( _nPorte = 1, " cidade", " cidades" ) & "</small>"
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela rv'>"
			        & "<div class='sob sobe'>Lula · PT · 13 · " & _txtMun & "</div>"
			        & "<div class='topo'><div class='big lula sobe d1'>" & FORMAT ( _pct, "0.0%" ) & "</div>"
			        & "<div class='lado sobe d2'><div class='vv lula'>" & SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) ) & "</div>"
			        & "<div class='txt'>de votos · " & _txtLado & "</div></div></div>"
			        & "<div class='man mc" & _clsMc & " sobe d3'>" & _manchete & "</div>"
			        & "<div class='txt cp sobe d4'>" & _compara & "</div>"
			        & "<div class='fatos'>"
			        & "<div class='fato sobe d10'><span class='ic f'></span><div><div class='rot'>" & "Em todo o estado" & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _est, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp lula'>" & FORMAT ( _pEst, "0.0%" ) & "</div></div>"
			        & "<div class='fato sobe d11'><span class='ic g'></span><div><div class='rot'>" & "Nas cidades do mesmo porte, no Brasil" & "</div><div class='lg'>" & _txtPorte & "</div></div><div class='vp'>" & FORMAT ( _pPorte, "0.0%" ) & "</div></div>"
			        & "<div class='fato sobe d12'><span class='ic r'></span><div><div class='rot'>" & "No Brasil inteiro" & "</div><div class='lg'>" & "resultado oficial, com o exterior" & "</div></div><div class='vp'>" & FORMAT ( _pBr, "0.0%" ) & "</div></div>"
			        & "</div>"
			    & "</div>"
			RETURN
			    IF ( NOT ISBLANK ( _mun ) && NOT ISBLANK ( _votos ), _html )
		displayFolder: T03 Lula\Desenho
		lineageTag: 08bbab49-27c4-5806-b7c1-5a1c2743ab23

	/// Resumo do recorte: o % de Lula, os votos, em quantos municípios ficou à frente, o que mudou desde 2022 e três fatos (mais forte, mais fraco, cidade grande). A faixa do meio fica livre para a origem (outro visual).
	measure 'T03 · Resumo · bloco recorte' =
			-- 1 · Leituras
			VAR _comUF = [T03 · com UF]
			VAR _recorte = [T03 · recorte]
			VAR _votos = [T03 · votos]
			VAR _pct = [T03 · %]
			VAR _pos = [T03 · posição]
			VAR _v22 = [T03 · votos 2022]
			VAR _p22 = [T03 · % 2022]
			VAR _c22 = [T03 · candidato 2022]
			VAR _dv = [T03 · variação de votos]
			VAR _dpp = [T03 · variação em p.p.]
			VAR _nFrente = [T03 · municípios à frente]
			VAR _nMun = [T03 · municípios]
			VAR _eleit = [T03 · eleitores nos municípios à frente]
			VAR _forte = [T03 · lugar mais forte]
			VAR _forteP = [T03 · lugar mais forte %]
			VAR _fraco = [T03 · lugar mais fraco]
			VAR _fracoP = [T03 · lugar mais fraco %]
			VAR _grande = [T03 · cidade grande mais forte]
			VAR _grandeP = [T03 · cidade grande mais forte %]
			VAR _grandePop = [T03 · cidade grande mais forte população]
			-- 2 · Textos
			VAR _txtRec = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtPct = FORMAT ( _pct, "0.0%" )
			VAR _txtVotos = SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) )
			VAR _txtNFrente = FORMAT ( _nFrente, "#,0" )
			VAR _txtNMun = FORMAT ( _nMun, "#,0" )
			VAR _txtEleit = IF ( _eleit >= 0.995 && _nFrente < _nMun, FORMAT ( _eleit, "0.0%" ), FORMAT ( _eleit, "0%" ) )
			VAR _txtMun = IF ( _nMun = 1, " município", " municípios" )
			VAR _manchete =
			    SWITCH (
			        TRUE (),
			        _nMun = 1 && _nFrente = 1, "Lula ficou à frente no único município do recorte",
			        _nMun = 1, "Lula ficou atrás no único município do recorte",
			        _nFrente = 0, "Lula não ficou à frente em nenhum dos " & _txtNMun & _txtMun,
			        "Lula ficou à frente em " & _txtNFrente & " dos " & _txtNMun & _txtMun & ", onde votam " & _txtEleit & " dos eleitores"
			    )
			VAR _txtDV = IF ( _dv < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dv ) ) >= 1000000, FORMAT ( ABS ( _dv ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dv ) ) >= 1000, FORMAT ( ABS ( _dv ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dv ), "#,0" ) )
			VAR _txtDPP = FORMAT ( _dpp, "+0.0;−0.0;0.0" )
			VAR _pontos = IF ( ABS ( _dpp ) < 2, " ponto", " pontos" )
			VAR _compara =
			    "Em 2022, " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " teve " & SWITCH ( TRUE (), ABS ( _v22 ) >= 1000000, FORMAT ( _v22 / 1000000, "0.00" ) & " mi", ABS ( _v22 ) >= 1000, FORMAT ( _v22 / 1000, "0.0" ) & " mil", FORMAT ( _v22, "#,0" ) ) & " (" & FORMAT ( _p22, "0.0%" ) & "). Agora: <b class='lula-esc'>"
			        & _txtDV & IF ( ABS ( _dv ) >= 1000, " de votos", IF ( ABS ( _dv ) = 1, " voto", " votos" ) )
			        & "</b> e <b class='lula-esc'>" & _txtDPP & _pontos & "</b>."
			VAR _rotForte = IF ( _comUF = 1, "Município mais forte", "UF mais forte" )
			VAR _rotFraco = IF ( _comUF = 1, "Município mais fraco", "UF mais fraca" )
			VAR _fatoGrande =
			    IF (
			        NOT ISBLANK ( _grande ),
			        "<div class='fato sobe d12'><span class='ic g'></span><div><div class='rot'>" & "Entre as cidades de 100 mil+" & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _grande, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " <small>" & FORMAT ( _grandePop, "#,0" ) & " habitantes</small>" & "</div></div><div class='vp lula'>" & FORMAT ( _grandeP, "0.0%" ) & "</div></div>"
			    )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela rv'>"
			        & "<div class='sob sobe'>Luiz Inácio Lula da Silva · PT · 13 · " & _txtRec & "</div>"
			        & "<div class='topo'><div class='big lula sobe d1'>" & _txtPct & "</div>"
			        & "<div class='lado sobe d2'><div class='vv lula'>" & _txtVotos & "</div>"
			        & "<div class='txt'>de votos · " & _pos & "º lugar</div></div></div>"
			        & "<div class='man mc sobe d3'>" & _manchete & "</div>"
			        & "<div class='txt cp sobe d4'>" & _compara & "</div>"
			        & "<div class='fatos'>"
			        & "<div class='fato sobe d10'><span class='ic f'></span><div><div class='rot'>" & _rotForte & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _forte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp lula'>" & FORMAT ( _forteP, "0.0%" ) & "</div></div>"
			        & IF ( _fraco <> _forte, "<div class='fato sobe d11'><span class='ic r'></span><div><div class='rot'>" & _rotFraco & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fraco, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp'>" & FORMAT ( _fracoP, "0.0%" ) & "</div></div>" )
			        & _fatoGrande & "</div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T03 Lula\Desenho
		lineageTag: 065e2081-3c96-55b9-8e38-ddd5a05e03e1

	/// Coluna da esquerda da tela 03: a ficha do município marcado no mapa ou a do recorte (Brasil, região clicada ou UF do filtro). Só escolhe o bloco.
	measure 'T03 · Resumo · HTML' =
			IF ( [T03 · com município] = 1, [T03 · Resumo · bloco município], [T03 · Resumo · bloco recorte] )
		displayFolder: T03 Lula\Desenho
		lineageTag: 702409b4-536c-5c07-be35-433309daeb60

	/// Texto para leitor de tela do dossiê do município.
	measure 'T03 · Tooltip município · ALT' =
			LEFT (
			    [T03 · município] & ": Lula " & FORMAT ( [T03 · % (municípios)], "0.0%" ) & " e Flávio "
			        & FORMAT ( [T03 · adversário % (municípios)], "0.0%" ) & " em 2026; margem do PT de "
			        & FORMAT ( [T03 · margem 2022] * 100, "+0.0;−0.0;0.0" ) & " para " & FORMAT ( [T03 · margem] * 100, "+0.0;−0.0;0.0" ) & " pontos.",
			    250
			)
		displayFolder: T03 Lula\Desenho
		lineageTag: e9e8b2f1-832a-5e16-a792-f623310752fe

	/// Dossiê do município do ponto (ficha pautada presa com fita): Lula × Flávio em 2026, o mesmo par em 2022 e a margem antes e agora, com a nota à mão do que aconteceu. Só lê contas.
	measure 'T03 · Tooltip município · HTML' =
			-- 1 · Leituras
			VAR _mun = [T03 · município]
			VAR _reg = [T03 · região do município]
			VAR _pop = [T03 · população]
			VAR _p26 = [T03 · % (municípios)]
			VAR _a26 = [T03 · adversário % (municípios)]
			VAR _p22 = [T03 · % 2022 (municípios)]
			VAR _a22 = [T03 · adversário % 2022 (municípios)]
			VAR _m22 = [T03 · margem 2022]
			VAR _m26 = [T03 · margem]
			VAR _v26 = [T03 · votos (municípios)]
			VAR _sit = [T03 · situação]
			VAR _c22 = [T03 · candidato 2022]
			-- 2 · Textos
			VAR _nome22 = IF ( "PT" = "PT", "Lula", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) )
			VAR _outro22 = IF ( "PT" = "PT", "Jair Bolsonaro", "Lula" )
			VAR _nota =
			    SWITCH (
			        _sit,
			        1, "seguiu com Lula",
			        2, "virou para Flávio",
			        3, "virou para Lula",
			        "seguiu com o PL"
			    )
			VAR _clsNota = IF ( _sit = 1 || _sit = 3, "lula-esc", "neutro" )
			VAR _txtM22 = FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" )
			VAR _txtM26 = FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" )
			-- 3 · Geometria (barras de 0 a 100% em 180 px)
			VAR _w26 = FORMAT ( _p26 * 180, "0.0##", "en-US" ) -- geometria
			VAR _wa26 = FORMAT ( _a26 * 180, "0.0##", "en-US" ) -- geometria
			VAR _w22 = FORMAT ( _p22 * 180, "0.0##", "en-US" ) -- geometria
			VAR _wa22 = FORMAT ( _a22 * 180, "0.0##", "en-US" ) -- geometria
			-- 4 · Marcação
			VAR _css =
			    "<style>"
			        & ".tt3{position:fixed;inset:0;background:var(--papel)}"
			        & ".tt3 .ficha{position:absolute;left:14px;top:22px;right:14px;bottom:14px;background:var(--branco);"
			        & "border:1.5px solid var(--areia);background-image:repeating-linear-gradient(transparent 0 31px,"
			        & "rgba(203,189,162,.45) 31px 32px);box-shadow:3px 4px 0 rgba(28,25,21,.07)}"
			        & ".tt3 .fita{position:absolute;left:170px;top:-16px;width:96px;transform:rotate(-3deg);opacity:.9}"
			        & ".tt3 .pino{position:absolute;right:16px;top:14px;width:30px}"
			        & ".tt3 .cab{position:absolute;left:18px;top:14px;right:56px}"
			        & ".tt3 .nm{font-size:22px;font-weight:700;line-height:1.15;letter-spacing:-.01em}"
			        & ".tt3 .an{position:absolute;left:18px;right:18px;display:grid;grid-template-columns:52px 1fr;row-gap:6px;"
			        & "align-items:center}.tt3 .a26{top:84px}.tt3 .a22{top:166px}"
			        & ".tt3 .ano{font-size:15px;font-weight:700}"
			        & ".tt3 .lin{display:flex;align-items:center;gap:8px;font-size:15px}"
			        & ".tt3 .lin i{display:block;height:12px}.tt3 .lin b{font-weight:700;min-width:50px}"
			        & ".tt3 .lin span{color:var(--grafite)}"
			        & ".tt3 .ci{background:var(--vermelho)}.tt3 .co{background:var(--areia)}"
			        & ".tt3 .mg{position:absolute;left:18px;right:18px;top:248px;font-size:15px;color:var(--grafite)}"
			        & ".tt3 .mg b{color:var(--tinta)}"
			        & ".tt3 .mao{position:absolute;right:18px;bottom:8px;font-size:28px}"
			        & ".tt3 .neutro{color:var(--grafite)}"
			    & "</style>"
			VAR _lin = "<div class='lin'><i class='"
			VAR _html =
			    _css
			        & "<div class='tt3'><div class='ficha'>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/>"
			        & "<img class='pino' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/pino-tinta.png'/>"
			        & "<div class='cab sobe'><div class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mun, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='rot'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & FORMAT ( _pop, "#,0" ) & " habitantes</div></div>"
			        & "<div class='an a26 sobe d1'><div class='ano'>2026</div><div>"
			        & _lin & "ci barra-x' style='width:" & _w26 & "px'></i><b>" & FORMAT ( _p26, "0.0%" ) & "</b><span>Lula</span></div>"
			        & _lin & "co barra-x' style='width:" & _wa26 & "px'></i><b>" & FORMAT ( _a26, "0.0%" ) & "</b><span>Flávio</span></div>"
			        & "</div></div>"
			        & "<div class='an a22 sobe d2'><div class='ano'>2022</div><div>"
			        & _lin & "ci barra-x' style='width:" & _w22 & "px;opacity:.55'></i><b>" & FORMAT ( _p22, "0.0%" ) & "</b><span>"
			        & _nome22 & "</span></div>"
			        & _lin & "co barra-x' style='width:" & _wa22 & "px;opacity:.55'></i><b>" & FORMAT ( _a22, "0.0%" ) & "</b><span>"
			        & _outro22 & "</span></div>"
			        & "</div></div>"
			        & "<div class='mg sobe d3'>Margem do PT, em pontos: <b>" & _txtM22 & "</b> → <b>"
			        & _txtM26 & "</b></div>"
			        & "<div class='mao " & _clsNota & " entra d5'>" & _nota & "</div>"
			        & "</div></div>"
			RETURN
			    IF ( NOT ISBLANK ( _mun ) && NOT ISBLANK ( _v26 ), _html )
		displayFolder: T03 Lula\Desenho
		lineageTag: d578e9ec-f528-54b6-bd43-fa23bb02fdc2

	/// Texto para leitor de tela do dossiê da região.
	measure 'T03 · Tooltip região · ALT' =
			LEFT (
			    "Lula na região " & [T03 · região da linha] & ", estado por estado: a parte de cada estado nos votos dele, "
			        & "o % dele em cada um e a mudança desde 2022.",
			    250
			)
		displayFolder: T03 Lula\Desenho
		lineageTag: c21f84a6-2351-5443-b410-eb44383256ca

	/// Dossiê da região da origem (ficha com clipe): os estados da região, do que mais deu votos a Lula ao que menos — a parte de cada um nos votos dele na região, o % dele lá e a mudança desde 2022 —, com a nota à mão da maior mudança. Só lê contas.
	measure 'T03 · Tooltip região · HTML' =
			-- 1 · Leituras
			VAR _reg = [T03 · região da linha]
			VAR _mg = [T03 · margem na região]
			VAR _ufs =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" ),
			        "@nome", [T03 · UF da linha],
			        "@v", [T03 · votos],
			        "@s", [T03 · parte do estado na região],
			        "@p", [T03 · %],
			        "@d", [T03 · variação em p.p.]
			    )
			VAR _lista = FILTER ( _ufs, [@v] > 0 ) /* lista */
			VAR _n = COUNTROWS ( _lista ) /* lista */
			VAR _smax = MAXX ( _lista, [@s] ) /* lista */
			VAR _top = TOPN ( 1, _lista, ABS ( [@d] ), DESC, 'UF'[UF], ASC ) /* lista */
			VAR _topNome = MAXX ( _top, [@nome] ) /* lista */
			VAR _topD = MAXX ( _top, [@d] ) /* lista */
			-- 2 · Textos
			VAR _txtReg = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtMg = "Lula ficou " & FORMAT ( ABS ( _mg ), "0.0" ) & IF ( ABS ( _mg ) < 2, " ponto ", " pontos " )
			    & IF ( _mg >= 0, "à frente de Flávio", "atrás de Flávio" ) & " na região"
			VAR _nota = IF ( _topD < 0, "maior queda: ", "maior alta: " ) & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _topNome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _clsNota = IF ( _topD < 0, "neutro", "lula-esc" )
			-- 3 · Geometria (barra da parte em até 120 px; linhas de 26 px)
			VAR _h = IF ( _n > 7, 24, 27 ) -- geometria
			VAR _linhas =
			    CONCATENATEX (
			        _lista,
			        VAR _w = FORMAT ( DIVIDE ( [@s], _smax ) * 60, "0.0##", "en-US" ) -- geometria
			        RETURN
			            "<div class='ln' style='height:" & _h & "px'><span class='uf'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [@nome], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>"
			                & "<span class='br'><i class='barra-x lula-bg' style='width:" & _w & "px'></i><b>"
			                & FORMAT ( [@s], "0%" ) & "</b></span><span class='pc'>" & FORMAT ( [@p], "0.0%" ) & "</span>"
			                & "<span class='dd " & IF ( [@d] < 0, "neg", "pos" ) & "'>" & FORMAT ( [@d], "+0.0;−0.0;0.0" ) & "</span></div>",
			        "",
			        [@v], DESC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _reg ) && _n > 0,
			        "<div class='tt3r'><div class='ficha'>"
			            & "<div class='cab sobe'><div class='nm lula'>" & _txtReg & ", por estado</div>"
			            & "<div class='sub'>" & _txtMg & "</div></div>"
			            & "<div class='hd sobe d1'><span class='uf'>UF</span><span class='br'>peso</span>"
			            & "<span class='pc'>% dele</span><span class='dd'>vs. 2022</span></div>"
			            & "<div class='lista sobe d2'>" & _linhas & "</div>"
			            & "<div class='mao " & _clsNota & " entra d6'>" & _nota & "</div>"
			        & "</div></div>"
			    )
		displayFolder: T03 Lula\Desenho
		lineageTag: 7fad8eb7-c891-5b1d-b1c8-176ca3d0b681

	/// Parcela de Flávio nos votos válidos do 1º turno de 2026, no Brasil (0–1).
	measure 'T04 · % 2026' =
			DIVIDE (
			    [T04 · votos 2026],
			    CALCULATE ( SUM ( 'Candidato UF'[Votos] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026 )
			)
		formatString: 0.0%
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 23a1085a-902c-5ca2-ae4f-8afb93d5f13b

	/// Anos do primeiro marco até a eleição de 2026.
	measure 'T04 · anos de vida pública' =
			2026 - [T04 · Trajetória · primeiro ano]
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: f9dd58a9-f5ad-56c1-b545-3b94fbfcdabf

	/// Colocação de Flávio no 1º turno de 2026, no Brasil.
	measure 'T04 · posição 2026' =
			VAR _v = [T04 · votos 2026]
			VAR _todos =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Candidato UF'[Número] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026 ),
			        "@v", CALCULATE ( SUM ( 'Candidato UF'[Votos] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026 )
			    )
			RETURN
			    1 + COUNTROWS ( FILTER ( _todos, [@v] > _v ) )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 5acc8cf6-9366-5d8b-9fbb-2b30b87aeebd

	/// Ano do marco da linha.
	measure 'T04 · Trajetória · ano' =
			SELECTEDVALUE ( 'Trajetória'[Ano] )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: ff3fda33-5023-5ebd-95b1-52980b8f0934

	/// Crédito curto do desenho e da foto original do marco da linha. Fonte: dados/bruto/trajetoria/desenhos.csv; na falta, autor e licença da tabela Trajetória.
	measure 'T04 · Trajetória · crédito da foto' =
			VAR _f = [T04 · Trajetória · foto]
			VAR _reserva =
			    "Desenho a partir de foto de " & SELECTEDVALUE ( 'Trajetória'[Autor da foto] ) & " ("
			        & SELECTEDVALUE ( 'Trajetória'[Licença da foto] ) & ")"
			RETURN
			    IF (
			        _f <> "",
			        SWITCH (
			            _f,
			        "flavio-2002-alerj", "Desenho CC BY-SA 4.0 a partir de foto de Governo do Estado do RJ/Seap (CC BY 2.0 BR)",
			        "flavio-2016-prefeitura", "Desenho CC BY-SA 4.0 a partir de foto de Família Bolsonaro/Flickr (domínio público)",
			        "flavio-2018-senado", "Desenho CC BY-SA 4.0 a partir de foto do Consulado dos EUA no Rio (domínio público)",
			        "flavio-2019-posse", "Desenho CC BY-SA 4.0 a partir de foto de Edilson Rodrigues/Agência Senado (CC BY 2.0)",
			        "flavio-2020-denuncia", "Desenho CC BY-SA 4.0 a partir de foto de Pedro França/Agência Senado (CC BY 2.0)",
			        "flavio-2022-arquivamento", "Desenho CC BY-SA 4.0 a partir de foto de Edilson Rodrigues/Agência Senado (CC BY 2.0)",
			        "flavio-2022-campanha", "Desenho CC BY-SA 4.0 a partir de foto de Geraldo Magela/Agência Senado (CC BY 2.0)",
			        "flavio-2025-csp", "Desenho CC BY-SA 4.0 a partir de foto de Edilson Rodrigues/Agência Senado (CC BY-SA 4.0)",
			        "flavio-2025-precandidatura", "Desenho CC BY-SA 4.0 a partir de foto de Andressa Anholete/Agência Senado (CC BY-SA 4.0)",
			        "flavio-2026-primeiro-turno", "Desenho CC BY-SA 4.0 a partir de foto de Carlos Moura/Agência Senado (CC BY-SA 4.0)",
			            _reserva
			        )
			    )
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 633466b8-f0b5-5611-ad47-bcc6e6b9cd31

	/// Data do marco da linha; vazio quando a fonte só dá o ano.
	measure 'T04 · Trajetória · data' =
			VAR _d = SELECTEDVALUE ( 'Trajetória'[Data] )
			RETURN
			    IF ( LEN ( _d ) = 10, DATE ( VALUE ( LEFT ( _d, 4 ) ), VALUE ( MID ( _d, 6, 2 ) ), VALUE ( RIGHT ( _d, 2 ) ) ) )
		formatString: dd/mm/yyyy
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 8b887391-bc72-5e14-84a4-79300c6054ef

	/// Nome do desenho da foto do marco da linha; vazio quando não há foto livre.
	measure 'T04 · Trajetória · foto' =
			SELECTEDVALUE ( 'Trajetória'[Foto] )
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 1b138053-1295-5021-9bbd-f92ed8587562

	/// Onde e quando a foto original do marco da linha foi feita (pode ser de outro momento que o do marco). Fonte: dados/bruto/trajetoria/desenhos.csv.
	measure 'T04 · Trajetória · legenda da foto' =
			VAR _f = [T04 · Trajetória · foto]
			RETURN
			    SWITCH (
			        _f,
			"flavio-2002-alerj", "Como deputado estadual do RJ, em formatura de grupamento da Seap, 17 de dezembro de 2014",
			"flavio-2016-prefeitura", "Como deputado estadual do RJ, 2015",
			"flavio-2018-senado", "Já eleito senador, Rio de Janeiro, 29 de novembro de 2018",
			"flavio-2019-posse", "Posse no plenário do Senado, Brasília, 1º de fevereiro de 2019",
			"flavio-2020-denuncia", "Entrevista no Senado, Brasília, 30 de novembro de 2021",
			"flavio-2022-arquivamento", "Entrevista no Senado, Brasília, 12 de maio de 2022",
			"flavio-2022-campanha", "Sabatina na Comissão de Relações Exteriores do Senado, Brasília, 22 de novembro de 2022",
			"flavio-2025-csp", "Reunião da Comissão de Segurança Pública do Senado, Brasília, 19 de agosto de 2025",
			"flavio-2025-precandidatura", "Comissão do Senado, Brasília, 3 de setembro de 2025",
			"flavio-2026-primeiro-turno", "Discurso no plenário do Senado, Brasília, 1º de setembro de 2026",
			        BLANK ()
			    )
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 88372fb4-58fd-56db-90e5-ba82a5ff61cd

	/// Quantos marcos a trajetória de Flávio tem.
	measure 'T04 · Trajetória · marcos' =
			CALCULATE ( COUNTROWS ( 'Trajetória' ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Flávio" )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 0f08caba-2209-550f-8144-4e36fca254ca

	/// Quantos marcos de Flávio têm foto da época redesenhada (sem contar as ilustrações recriadas).
	measure 'T04 · Trajetória · marcos com foto' =
			CALCULATE ( COUNTROWS ( 'Trajetória' ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Flávio", 'Trajetória'[Foto] <> "", NOT ( 'Trajetória'[Foto] IN { "lula-1975-sindicato", "lula-1980-fundacao-pt" } ) )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 140c9c07-d6a2-5cdb-bb1d-b0ab23f69ef8

	/// Quantos marcos de Flávio não têm foto de licença aberta e mostram a cena da época recriada em ilustração.
	measure 'T04 · Trajetória · marcos ilustrados' =
			CALCULATE ( COUNTROWS ( 'Trajetória' ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Flávio", 'Trajetória'[Foto] IN { "lula-1975-sindicato", "lula-1980-fundacao-pt" } )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 2fa555fd-09e0-5b77-abe0-01b8903a9204

	/// Posição cronológica do marco da linha (1 = o mais antigo).
	measure 'T04 · Trajetória · ordem' =
			SELECTEDVALUE ( 'Trajetória'[Ordem] )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: a264261a-b1af-53f2-bfa6-225a546feb54

	/// Ano do primeiro marco de Flávio.
	measure 'T04 · Trajetória · primeiro ano' =
			CALCULATE ( MIN ( 'Trajetória'[Ano] ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Flávio" )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 112d2c39-90a1-57fe-b5eb-5e09e2c04a48

	/// Ano do segundo marco mais antigo de Flávio (onde a régua retoma quando o primeiro marco fica longe dos outros e a régua ganha um corte).
	measure 'T04 · Trajetória · segundo ano' =
			VAR _p = [T04 · Trajetória · primeiro ano] RETURN CALCULATE ( MIN ( 'Trajetória'[Ano] ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Flávio", 'Trajetória'[Ano] > _p )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 85afd8bb-d92c-5853-a457-0e2d78adc32a

	/// 1 quando o marco da linha tem desenho: foto da época redesenhada ou, sem foto de licença aberta, ilustração recriada.
	measure 'T04 · Trajetória · tem foto' =
			IF ( SELECTEDVALUE ( 'Trajetória'[Foto] ) <> "", 1, 0 )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 0f37a7bd-8842-5789-9d73-74b0b477c839

	/// Momento do marco da linha em anos decimais (ano + fração do ano; meio do ano quando a fonte só dá o ano). Posição do ponto na régua.
	measure 'T04 · Trajetória · tempo' =
			VAR _a = [T04 · Trajetória · ano]
			VAR _d = [T04 · Trajetória · data]
			RETURN
			    IF ( ISBLANK ( _d ), _a + 0.5, _a + DIVIDE ( _d - DATE ( _a, 1, 1 ), 365 ) )
		formatString: 0.00
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 13ad763e-21e8-5de4-bebf-259a5a3683ac

	/// O que aconteceu no marco da linha (até ~200 caracteres).
	measure 'T04 · Trajetória · texto do marco' =
			SELECTEDVALUE ( 'Trajetória'[Texto] )
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: b0eb4523-1f69-5bad-957a-a7302cd7d26f

	/// Título curto do marco da linha.
	measure 'T04 · Trajetória · título' =
			SELECTEDVALUE ( 'Trajetória'[Título] )
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: e5ad47c4-6b40-5a5d-b691-a1590416a7e9

	/// 1 quando o desenho do marco da linha é ilustração recriada da época (não há foto de licença aberta). Fonte: dados/bruto/trajetoria/desenhos.csv, coluna tipo.
	measure 'T04 · Trajetória · é ilustração' =
			VAR _f = [T04 · Trajetória · foto]
			RETURN
			    IF ( _f IN { "lula-1975-sindicato", "lula-1980-fundacao-pt" }, 1, 0 )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: fca749a4-52b4-5e62-9097-23ac671597ec

	/// Ano do último marco de Flávio.
	measure 'T04 · Trajetória · último ano' =
			CALCULATE ( MAX ( 'Trajetória'[Ano] ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Flávio" )
		formatString: 0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: 5812e3dd-0153-5a16-a357-0f668d4cfcc2

	/// Votos de Flávio no 1º turno de 2026, no Brasil (com o exterior).
	measure 'T04 · votos 2026' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 22 )
		formatString: #,0
		displayFolder: T04 Flávio · quem é\Contas
		lineageTag: bca1cc26-2acb-5b93-9276-3c957aa19e2c

	/// Texto para leitor de tela da ficha.
	measure 'T04 · Ficha · ALT' =
			LEFT (
			    "Flávio Bolsonaro, na vida pública desde " & [T04 · Trajetória · primeiro ano] & ". No 1º turno de 2026, "
			        & SWITCH ( TRUE (), ABS ( [T04 · votos 2026] ) >= 1000000, FORMAT ( [T04 · votos 2026] / 1000000, "0.00" ) & " mi", ABS ( [T04 · votos 2026] ) >= 1000, FORMAT ( [T04 · votos 2026] / 1000, "0.0" ) & " mil", FORMAT ( [T04 · votos 2026], "#,0" ) ) & " de votos (" & FORMAT ( [T04 · % 2026], "0.0%" ) & "), "
			        & [T04 · posição 2026] & "º lugar.",
			    250
			)
		displayFolder: T04 Flávio · quem é\Desenho
		lineageTag: 5b47164a-1e3e-5577-a404-2e50a9f52a19

	/// Ficha de Flávio (alto à esquerda da tela): desde quando está na vida pública, o 1º turno de 2026 e quantos marcos a linha do tempo tem (com foto da época e em ilustração recriada). Só lê contas.
	measure 'T04 · Ficha · HTML' =
			-- 1 · Leituras
			VAR _desde = [T04 · Trajetória · primeiro ano]
			VAR _anos = [T04 · anos de vida pública]
			VAR _votos = [T04 · votos 2026]
			VAR _pct = [T04 · % 2026]
			VAR _pos = [T04 · posição 2026]
			VAR _marcos = [T04 · Trajetória · marcos]
			VAR _fotos = [T04 · Trajetória · marcos com foto]
			VAR _ilus = [T04 · Trajetória · marcos ilustrados]
			-- 2 · Textos
			VAR _txtVotos = SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) )
			VAR _txtPct = FORMAT ( _pct, "0.0%" )
			VAR _txtFotos =
			    SWITCH (
			        TRUE (),
			        _fotos = _marcos, "todos com foto da época",
			        _fotos = 0, "nenhum com foto da época",
			        _fotos = 1, "1 com foto da época",
			        _fotos & " com foto da época"
			    )
			VAR _txtIlus =
			    SWITCH ( _ilus, 0, "", 1, ", 1 em ilustração recriada", ", " & _ilus & " em ilustração recriada" )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela fc'>"
			        & "<div class='lin sobe d3'><div class='rot'>Na vida pública desde</div>"
			        & "<div class='val'><span class='nc'>" & _desde & "</span><small>há <span>" & _anos & "</span> anos</small></div></div>"
			        & "<div class='lin sobe d4'><div class='rot'>No 1º turno de 2026</div>"
			        & "<div class='val'><span class='flavio'>" & _txtVotos & "</span><small>de votos · " & _txtPct
			        & " · " & _pos & "º lugar</small></div></div>"
			        & "<div class='lin sobe d5'><div class='rot'>Na linha do tempo abaixo</div>"
			        & "<div class='val'><span>" & _marcos & "</span><small>marcos, " & _txtFotos & _txtIlus
			        & "</small></div></div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T04 Flávio · quem é\Desenho
		lineageTag: 5bcff663-9328-5dee-bdbb-4ba4ddadcdf7

	/// Texto para leitor de tela do dossiê do marco.
	measure 'T04 · Tooltip marco · ALT' =
			LEFT (
			    [T04 · Trajetória · ano] & " · " & [T04 · Trajetória · título] & ": " & [T04 · Trajetória · texto do marco],
			    250
			)
		displayFolder: T04 Flávio · quem é\Desenho
		lineageTag: 546afbf0-0912-546a-932e-bda85deac2ea

	/// Dossiê do marco (polaroide presa com fita): a foto da época redesenhada em traço ou, sem foto de licença aberta, a cena recriada em ilustração (reserva: um ícone e a nota 'sem foto de licença aberta'), a data, o título, o texto, a legenda e o crédito. Só lê contas.
	measure 'T04 · Tooltip marco · HTML' =
			-- 1 · Leituras
			VAR _tit = [T04 · Trajetória · título]
			VAR _txt = [T04 · Trajetória · texto do marco]
			VAR _ano = [T04 · Trajetória · ano]
			VAR _data = [T04 · Trajetória · data]
			VAR _foto = [T04 · Trajetória · foto]
			VAR _temFoto = [T04 · Trajetória · tem foto]
			VAR _ilus = [T04 · Trajetória · é ilustração]
			VAR _leg = [T04 · Trajetória · legenda da foto]
			VAR _cred = [T04 · Trajetória · crédito da foto]
			-- 2 · Textos
			VAR _txtData =
			    IF (
			        ISBLANK ( _data ),
			        FORMAT ( _ano, "0" ),
			        IF ( DAY ( _data ) = 1, "1º", FORMAT ( _data, "d" ) ) & FORMAT ( _data, " ""de"" mmmm ""de"" yyyy" )
			    )
			VAR _icone =
			    SWITCH (
			        TRUE (),
			        SEARCH ( "sindicato", _tit, 1, 0 ) > 0, "megafone",
			        SEARCH ( "campanha", _tit, 1, 0 ) > 0, "megafone",
			        SEARCH ( "fundação", _tit, 1, 0 ) > 0, "pessoas",
			        SEARCH ( "Disputa", _tit, 1, 0 ) > 0, "urna",
			        "jornal"
			    )
			VAR _srcIcone = "https://vizudados.github.io/eleicoes-2026/midia/arte/icones/" & _icone & "-tinta.png"
			VAR _quadro =
			    IF (
			        _temFoto = 1,
			        "<img class='foto' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/trajetoria/" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _foto, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & ".png' data-reserva='"
			            & _srcIcone & "'/>",
			        "<img class='foto reserva' alt='' src='" & _srcIcone & "'/>"
			            & "<div class='sem mao'>sem foto de licença aberta</div>"
			    )
			VAR _rodape =
			    IF ( _temFoto = 1, "<div class='nota lg'><b>" & IF ( _ilus = 1, "Na ilustração:", "Na foto:" ) & "</b> "
			        & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _leg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='nota cr'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _cred, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>" )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tt2'>"
			        & "<div class='pol'>" & _quadro & "<div class='ano mao nc'>" & _ano & "</div>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/></div>"
			        & "<div class='col'><div class='rot flavio-esc sobe'>" & _txtData & "</div>"
			        & "<div class='man sobe d1'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _tit, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='txt sobe d2'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _txt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & IF ( _temFoto = 1, "<div class='pe sobe d3'>" & _rodape & "</div>" ) & "</div>"
			    & "</div>"
			RETURN
			    IF ( NOT ISBLANK ( _tit ), _html )
		displayFolder: T04 Flávio · quem é\Desenho
		lineageTag: 8881fbcd-d71a-5a1e-a791-0e039cfcf28c

	/// Texto para leitor de tela da linha do tempo.
	measure 'T04 · Trajetória · ALT' =
			LEFT (
			    "Linha do tempo da trajetória política de Flávio: " & [T04 · Trajetória · marcos] & " marcos, de "
			        & [T04 · Trajetória · primeiro ano] & " a " & [T04 · Trajetória · último ano]
			        & ". Passe o mouse num marco para ver a foto da época e o que aconteceu.",
			    250
			)
		displayFolder: T04 Flávio · quem é\Desenho
		lineageTag: b0488bb2-5064-500c-a8c1-186dbe10f2d8

	/// Um marco da trajetória (uma entrada por marco, granularidade 'Trajetória'[Título]): o cartão na sua vaga (câmera se tem foto da época, lápis se é ilustração recriada), o fio até o ponto no ano real e, no 1º marco, a régua com os anos. Só lê contas; posições são geometria.
	measure 'T04 · Trajetória · HTML' =
			-- 1 · Leituras
			VAR _ordem = [T04 · Trajetória · ordem]
			VAR _n = [T04 · Trajetória · marcos]
			VAR _tempo = [T04 · Trajetória · tempo]
			VAR _ano = [T04 · Trajetória · ano]
			VAR _tit = [T04 · Trajetória · título]
			VAR _temFoto = [T04 · Trajetória · tem foto]
			VAR _ilus = [T04 · Trajetória · é ilustração]
			VAR _ini = [T04 · Trajetória · primeiro ano]
			VAR _fim = [T04 · Trajetória · último ano]
			-- 2 · Textos
			VAR _txtTit = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _tit, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _icone =
			    SWITCH (
			        TRUE (),
			        _ilus = 1,
			            "<svg class='cam' viewBox='0 0 20 16' aria-label='ilustração recriada da época'><path d='M3,14 L4,10 L13,2 L16,5 L7,13 Z'/><path d='M4,10 L7,13'/></svg>",
			        _temFoto = 1,
			            "<svg class='cam' viewBox='0 0 20 16' aria-label='tem foto da época'><path d='M2,4 H6 L8,2 H12 L14,4 H18 V14 H2 Z'/><circle cx='10' cy='9' r='3'/></svg>",
			        ""
			    )
			VAR _cab =
			    "<div class='cab'><span class='sob'>Trajetória política · " & _n & " marcos</span>"
			        & "<span class='dica'>passe o mouse num marco para ver a foto da época, redesenhada em traço</span></div>"
			-- 3 · Geometria (régua em y 296, de x 30 a 1590; vagas iguais para os cartões)
			-- com o 1º marco a mais de 8 anos do 2º (Flávio: 2002 e depois 2016), a régua ganha um corte: um trecho curto
			-- em volta do 1º marco, o sinal de corte e o resto da régua do 2º marco ao fim, para os fios não se cruzarem
			VAR _seg = [T04 · Trajetória · segundo ano]
			VAR _corte = _seg - _ini > 8 -- geometria
			VAR _t0 = FLOOR ( _ini - 1, 5 ) -- geometria
			VAR _t1 = CEILING ( _fim + 2, 5 ) -- geometria
			VAR _escala = DIVIDE ( 1560, _t1 - _t0 ) -- geometria
			VAR _wa = 200 -- geometria
			VAR _vao = 44 -- geometria
			VAR _a0 = _ini - 1.5 -- geometria
			VAR _a1 = _ini + 1.5 -- geometria
			VAR _b0 = _seg - 1 -- geometria
			VAR _b1 = _fim + 1 -- geometria
			VAR _xb = 30 + _wa + _vao -- geometria
			VAR _eb = DIVIDE ( 1560 - _wa - _vao, _b1 - _b0 ) -- geometria
			VAR _xd =
			    IF (
			        _corte,
			        IF ( _tempo <= _a1, 30 + ( _tempo - _a0 ) * DIVIDE ( _wa, _a1 - _a0 ), _xb + ( _tempo - _b0 ) * _eb ),
			        30 + ( _tempo - _t0 ) * _escala
			    ) -- geometria
			VAR _xs = ( _ordem - 0.5 ) * DIVIDE ( 1620, _n ) -- geometria
			VAR _txd = FORMAT ( _xd, "0.0##", "en-US" ) -- geometria
			VAR _txs = FORMAT ( _xs, "0.0##", "en-US" ) -- geometria
			VAR _fio =
			    "M" & _txs & ",176 L" & _txs & ",200 L" & _txd & ",262 L" & _txd & ",287" -- geometria
			VAR _atraso = MIN ( _ordem + 4, 16 ) -- geometria
			VAR _anosInteira = SELECTCOLUMNS ( GENERATESERIES ( _t0, _t1, 5 ), "@a", [Value], "@c", 0 ) /* lista */
			VAR _anosCorte =
			    UNION (
			        ROW ( "@a", _ini, "@c", 1 ),
			        SELECTCOLUMNS ( GENERATESERIES ( CEILING ( _b0, 5 ), FLOOR ( _b1, 5 ), 5 ), "@a", [Value], "@c", 1 )
			    ) /* lista */
			VAR _anos = FILTER ( UNION ( _anosInteira, _anosCorte ), [@c] = IF ( _corte, 1, 0 ) ) /* lista */
			VAR _marcas =
			    CONCATENATEX (
			        _anos,
			        VAR _x =
			            FORMAT ( IF ( _corte, IF ( [@a] <= _a1, 30 + ( [@a] - _a0 ) * DIVIDE ( _wa, _a1 - _a0 ), _xb + ( [@a] - _b0 ) * _eb ), 30 + ( [@a] - _t0 ) * _escala ), "0.0##", "en-US" ) -- geometria
			        RETURN
			            "<line x1='" & _x & "' y1='290' x2='" & _x & "' y2='302'/>"
			                & "<text x='" & _x & "' y='324'>" & [@a] & "</text>",
			        "",
			        [@a], ASC
			    )
			-- 4 · Marcação
			VAR _regua =
			    IF (
			        _ordem = 1,
			        _cab
			            & "<svg class='regua' width='1620' height='364' viewBox='0 0 1620 364'>"
			            & IF (
			                _corte,
			                "<line class='eixo traco' pathLength='1' x1='30' y1='296' x2='" & FORMAT ( 30 + _wa, "0.0##", "en-US" ) & "' y2='296'/>"
			                    & "<line class='eixo traco' pathLength='1' x1='" & FORMAT ( _xb, "0.0##", "en-US" ) & "' y1='296' x2='1590' y2='296'/>"
			                    & "<g class='corte'><line x1='" & FORMAT ( 30 + _wa + 12, "0.0##", "en-US" ) & "' y1='304' x2='" & FORMAT ( 30 + _wa + 20, "0.0##", "en-US" ) & "' y2='288'/>"
			                    & "<line x1='" & FORMAT ( 30 + _wa + 24, "0.0##", "en-US" ) & "' y1='304' x2='" & FORMAT ( 30 + _wa + 32, "0.0##", "en-US" ) & "' y2='288'/></g>",
			                "<line class='eixo traco' pathLength='1' x1='30' y1='296' x2='1590' y2='296'/>"
			            )
			            & "<g class='anos entra d4'>" & _marcas & "</g></svg>"
			    )
			VAR _html =
			    "<div class='tela m'>" & _regua
			        & "<svg class='liga' width='1620' height='364' viewBox='0 0 1620 364'>"
			        & "<path class='fio traco d" & _atraso & "' pathLength='1' d='" & _fio & "'/>"
			        & "<circle class='ponto brota d" & _atraso & "' cx='" & _txd & "' cy='296' r='7'/></svg>"
			        & "<div class='alvo card sobe d" & _atraso & "' style='left:" & FORMAT ( _xs - 76, "0.0##", "en-US" ) & "px'>"
			        & "<div class='ano nc'>" & _ano & _icone & "</div>"
			        & "<div class='tt'>" & _txtTit & "</div></div>"
			    & "</div>"
			RETURN
			    IF ( NOT ISBLANK ( _ordem ), _html )
		displayFolder: T04 Flávio · quem é\Desenho
		lineageTag: a4df6fcb-fe31-55e8-bc27-b8e87df1b3a3

	/// Parcela de Flávio nos válidos de 2026 do recorte (0–1); na linha de uma UF, o % da UF.
	measure 'T05 · %' =
			DIVIDE ( [T05 · votos], [T05 · válidos] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: e5608f45-c78b-5894-a7bf-89e792875db5

	/// Parcela de Flávio nos válidos de 2026 dos municípios do contexto (0–1).
	measure 'T05 · % (municípios)' =
			DIVIDE ( [T05 · votos (municípios)], [T05 · válidos (municípios)] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 6a6d264f-1712-56a4-837c-e74022ac07e6

	/// Parcela do PL nos válidos de 2022 do recorte (0–1).
	measure 'T05 · % 2022' =
			DIVIDE ( [T05 · votos 2022], [T05 · válidos 2022] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: aceb5d88-7291-5d9f-a210-d5d505a80143

	/// Parcela do PL nos válidos de 2022 dos municípios do contexto.
	measure 'T05 · % 2022 (municípios)' =
			DIVIDE ( [T05 · votos 2022 (municípios)], [T05 · válidos 2022 (municípios)] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 0ffabfce-c3cc-5770-bea1-49d9cda5df76

	/// Parcela de Flávio nos válidos de 2026 no Brasil, com o exterior (sem recorte).
	measure 'T05 · % no Brasil' =
			CALCULATE ( [T05 · %], REMOVEFILTERS ( 'UF' ) )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 8221b520-5691-55bd-b187-6b8a5e5f9177

	/// Parcela de Flávio nos válidos de 2026 da UF do município marcado (resultado oficial da UF).
	measure 'T05 · % no estado do município' =
			VAR _s = [T05 · UF do município]
			RETURN
			    IF ( NOT ISBLANK ( _s ), CALCULATE ( [T05 · %], REMOVEFILTERS ( 'UF' ), 'UF'[UF] = _s ) )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: b6ed795c-55f1-57cd-867a-c17ae42003e0

	/// Parcela de Flávio nos válidos de 2026 somados em todas as cidades do Brasil com o mesmo porte do município marcado.
	measure 'T05 · % no porte do município' =
			VAR _p = [T05 · porte do município]
			RETURN
			    IF (
			        NOT ISBLANK ( _p ),
			        CALCULATE ( [T05 · % (municípios)], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[Porte] = _p )
			    )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 0539aed2-0ad6-5bba-b37c-57b4194aa783

	/// Parcela de Lula nos válidos de 2026 dos municípios do contexto.
	measure 'T05 · adversário % (municípios)' =
			DIVIDE ( [T05 · votos do adversário (municípios)], [T05 · válidos (municípios)] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 86cad954-45c4-5ee7-8524-9f5b068aeb8e

	/// Parcela do adversário nos válidos de 2022 dos municípios do contexto.
	measure 'T05 · adversário % 2022 (municípios)' =
			DIVIDE ( [T05 · votos do adversário 2022 (municípios)], [T05 · válidos 2022 (municípios)] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: a2c0a150-387f-5c61-83a1-c10fa3372d5a

	/// Eleitores aptos em 2026 somados nos municípios (sem o exterior).
	measure 'T05 · aptos (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[Aptos] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: f54ef294-2357-510b-b872-6ca5bc1eb277

	/// Nome de urna do candidato do PL em 2022.
	measure 'T05 · candidato 2022' =
			CALCULATE ( SELECTEDVALUE ( 'Candidato UF'[Candidato] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 22 )
		displayFolder: T05 Flávio\Contas
		lineageTag: a2668de0-df83-5c92-89ef-b5ed8903ca13

	/// Entre as cidades de 100 mil habitantes ou mais do recorte, a de maior % do candidato (vazio se o recorte não tem cidade desse porte).
	measure 'T05 · cidade grande mais forte' =
			VAR _gr =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
			        "@p", [T05 · % (municípios)],
			        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
			    )
			VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
			RETURN
			    MAXX ( _top, 'Município'[Rótulo] )
		displayFolder: T05 Flávio\Contas
		lineageTag: c36228cf-0654-53c7-9965-afee8a6e53e3

	/// % do candidato na cidade grande mais forte (0–1).
	measure 'T05 · cidade grande mais forte %' =
			VAR _gr =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
			        "@p", [T05 · % (municípios)],
			        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
			    )
			VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
			RETURN
			    MAXX ( _top, [@p] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 0fdfb498-fb9c-5f98-899e-669e7c1ca35a

	/// População (Censo 2022) da cidade grande mais forte.
	measure 'T05 · cidade grande mais forte população' =
			VAR _gr =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
			        "@p", [T05 · % (municípios)],
			        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
			    )
			VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
			RETURN
			    MAXX ( _top, [@pop] )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 7c782625-b1ec-50a3-9f5d-1107c3e95b06

	/// Quantas cidades do Brasil têm o mesmo porte do município marcado.
	measure 'T05 · cidades do porte' =
			VAR _p = [T05 · porte do município]
			RETURN
			    IF (
			        NOT ISBLANK ( _p ),
			        CALCULATE ( [T05 · municípios], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[Porte] = _p )
			    )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 6f3218df-ac49-5608-afb2-b96edd68e983

	/// 1 quando há município marcado (o clique no mapa filtra 'Município'[CodIBGE]).
	measure 'T05 · com município' =
			INT ( ISFILTERED ( 'Município'[CodIBGE] ) || ISFILTERED ( 'Município'[Rótulo] ) )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: fab9d5da-2d64-52b1-9a03-e6d229eff6ce

	/// 1 quando a região foi CLICADA na origem dos votos (filtro cruzado em 'UF'[Região]); 0 nos outros casos. O filtro de estado da casca, em árvore, filtra 'UF'[Caminho] e não conta aqui (uma região escolhida nele é um recorte de vários estados: [T05 · vários estados]).
	measure 'T05 · com região' =
			INT ( ISFILTERED ( 'UF'[Região] ) || ISFILTERED ( 'UF'[RegiaoOrdem] ) )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: d794688b-85b0-534a-aebb-5eb52d0c5aa8

	/// 1 quando o recorte é UMA UF (filtro de estado da casca), 0 no Brasil, numa região ou com vários estados.
	measure 'T05 · com UF' =
			VAR _ufs = CALCULATE ( DISTINCTCOUNT ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
			RETURN
			    IF ( ISCROSSFILTERED ( 'UF' ) && _ufs = 1, 1, 0 )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: a1cd3871-6b7d-5eab-a0d5-a51fdbec63f7

	/// Parcela dos eleitores aptos do recorte que vivem nos municípios em que Flávio ficou à frente (0–1).
	measure 'T05 · eleitores nos municípios à frente' =
			DIVIDE (
			    SUMX ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T05 · votos (municípios)] > [T05 · votos do adversário (municípios)] ), [T05 · aptos (municípios)] ),
			    [T05 · aptos (municípios)]
			)
		formatString: 0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 53f1082e-1af6-5c26-b637-8f947e30ca52

	/// Nome da UF do município marcado.
	measure 'T05 · estado do município' =
			LOOKUPVALUE ( 'UF'[Nome], 'UF'[UF], [T05 · UF do município] )
		displayFolder: T05 Flávio\Contas
		lineageTag: 711da1e4-6d9b-5d0c-b3e4-ef3af2ee0e70

	/// Onde a região da linha começa na barra da origem: soma das parcelas das regiões que deram mais votos que ela (0–1).
	measure 'T05 · início da região' =
			VAR _v = [T05 · votos (municípios)]
			VAR _antes =
			    CALCULATE (
			        SUMX ( FILTER ( VALUES ( 'UF'[Região] ), [T05 · votos (municípios)] > _v ), [T05 · votos (municípios)] ),
			        REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] )
			    )
			VAR _total = CALCULATE ( [T05 · votos (municípios)], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			RETURN
			    IF ( _v > 0, DIVIDE ( _antes, _total ) + 0 )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: eb8a44e9-38d6-535b-ad3b-77078d7b9915

	/// 1 na entrada da origem (grão 'UF'[Região]) da primeira região do recorte, do Norte ao Sul: com vários estados no filtro, só ela desenha a lista de estados (as outras entradas ficam vazias).
	measure 'T05 · linha da primeira região' =
			VAR _primeira =
			    CALCULATE ( MIN ( 'UF'[RegiaoOrdem] ), REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ), 'UF'[Tipo] = "UF" )
			RETURN
			    INT ( SELECTEDVALUE ( 'UF'[RegiaoOrdem] ) = _primeira )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: e0cfd506-637a-5183-a17e-5bec993a8995

	/// UF (no Brasil ou na região) ou município (numa UF) onde o candidato teve o forte % dos válidos.
	measure 'T05 · lugar mais forte' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T05 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T05 · com UF] = 1 && [T05 · válidos (municípios)] > 0 ),
			        "@p", [T05 · % (municípios)]
			    )
			VAR _uf = [T05 · com UF] = 1
			RETURN
			    IF (
			        _uf,
			        MAXX ( TOPN ( 1, _mun, [@p], DESC, 'Município'[Rótulo], ASC ), 'Município'[Rótulo] ),
			        MAXX ( TOPN ( 1, _ufs, [@p], DESC, 'UF'[Nome], ASC ), 'UF'[Nome] )
			    )
		displayFolder: T05 Flávio\Contas
		lineageTag: 9acf0088-05f3-5257-994e-1e586247cf3a

	/// % do candidato nos válidos do lugar mais forte (0–1).
	measure 'T05 · lugar mais forte %' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T05 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T05 · com UF] = 1 && [T05 · válidos (municípios)] > 0 ),
			        "@p", [T05 · % (municípios)]
			    )
			VAR _uf = [T05 · com UF] = 1
			RETURN
			    IF ( _uf, MAXX ( _mun, [@p] ), MAXX ( _ufs, [@p] ) )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 3feb1919-4daa-543b-9966-d1cf1c8f0541

	/// UF (no Brasil ou na região) ou município (numa UF) onde o candidato teve o fraco % dos válidos.
	measure 'T05 · lugar mais fraco' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T05 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T05 · com UF] = 1 && [T05 · válidos (municípios)] > 0 ),
			        "@p", [T05 · % (municípios)]
			    )
			VAR _uf = [T05 · com UF] = 1
			RETURN
			    IF (
			        _uf,
			        MAXX ( TOPN ( 1, _mun, [@p], ASC, 'Município'[Rótulo], ASC ), 'Município'[Rótulo] ),
			        MAXX ( TOPN ( 1, _ufs, [@p], ASC, 'UF'[Nome], ASC ), 'UF'[Nome] )
			    )
		displayFolder: T05 Flávio\Contas
		lineageTag: d2f6e238-67d8-59d2-9803-ca22a05e4522

	/// % do candidato nos válidos do lugar mais fraco (0–1).
	measure 'T05 · lugar mais fraco %' =
			VAR _ufs =
			    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T05 · %] )
			VAR _mun =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( 'Município'[Rótulo] ), [T05 · com UF] = 1 && [T05 · válidos (municípios)] > 0 ),
			        "@p", [T05 · % (municípios)]
			    )
			VAR _uf = [T05 · com UF] = 1
			RETURN
			    IF ( _uf, MINX ( _mun, [@p] ), MINX ( _ufs, [@p] ) )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: e656e995-3b44-58ba-8881-a1f1f1d78bc3

	/// Margem de Flávio em 2026: (votos dele − votos de Lula) ÷ válidos (−1 a 1). Cor do ponto no mapa.
	measure 'T05 · margem' =
			DIVIDE ( [T05 · votos (municípios)] - [T05 · votos do adversário (municípios)], [T05 · válidos (municípios)] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 37154cd3-93cb-5f88-839f-b6d0bbafd880

	/// Margem do PL em 2022: (votos − votos do adversário) ÷ válidos (−1 a 1).
	measure 'T05 · margem 2022' =
			DIVIDE ( [T05 · votos 2022 (municípios)] - [T05 · votos do adversário 2022 (municípios)], [T05 · válidos 2022 (municípios)] )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 8f6a03aa-a99c-5d74-8ea1-99c8a73e3987

	/// Margem de Flávio na região da linha em 2026, em pontos (votos dele − votos de Lula) ÷ válidos × 100.
	measure 'T05 · margem na região' =
			[T05 · margem] * 100
		formatString: 0.0
		displayFolder: T05 Flávio\Contas
		lineageTag: 3fd6a8e5-fe24-5884-8b11-7eea3f03a1bc

	/// Nome (UF) do município da linha.
	measure 'T05 · município' =
			SELECTEDVALUE ( 'Município'[Rótulo] )
		displayFolder: T05 Flávio\Contas
		lineageTag: 6b87249e-c1ea-551d-8c6a-c5710517c054

	/// Municípios do recorte com votos válidos em 2026.
	measure 'T05 · municípios' =
			COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T05 · válidos (municípios)] > 0 ) )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 6e05f04c-0605-5f55-b90b-ddb527f70f32

	/// Quantos municípios tem a UF do município marcado.
	measure 'T05 · municípios no estado do município' =
			VAR _s = [T05 · UF do município]
			RETURN
			    IF ( NOT ISBLANK ( _s ), CALCULATE ( [T05 · municípios], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s ) )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: c19fe7ec-c23d-5562-a72e-cb897ab566e5

	/// Municípios do recorte em que Flávio teve mais votos que Lula.
	measure 'T05 · municípios à frente' =
			COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T05 · votos (municípios)] > [T05 · votos do adversário (municípios)] ) ) + 0
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 3a344006-e210-5a05-ae4d-ddea6f2a32be

	/// Colocação da região da linha pelos votos de Flávio (1 = a que mais deu votos), entre as regiões do recorte.
	measure 'T05 · ordem da região' =
			VAR _v = [T05 · votos (municípios)]
			VAR _maiores =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'UF'[Região] ), [T05 · votos (municípios)] > _v ),
			        REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] )
			    )
			RETURN
			    IF ( _v > 0, 1 + COUNTROWS ( _maiores ) )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: a0a951a7-7b43-5d4a-88bb-e4cb1bd56bff

	/// Parcela dos votos de Flávio na região que veio da UF da linha (0–1), resultado oficial.
	measure 'T05 · parte do estado na região' =
			DIVIDE (
			    [T05 · votos],
			    CALCULATE ( [T05 · votos], REMOVEFILTERS ( 'UF'[UF], 'UF'[Nome], 'UF'[Ordem] ) )
			)
		formatString: 0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 119e4ff8-8a69-5c63-80eb-917c5c2c28cf

	/// Parcela dos votos de Flávio no recorte (soma dos municípios) que veio da UF da linha (0–1): a lista de estados da origem quando o filtro escolheu vários. Tira só as colunas da UF da linha; o recorte do filtro ('UF'[Caminho]) fica.
	measure 'T05 · parte do estado no recorte' =
			DIVIDE (
			    [T05 · votos (municípios)],
			    CALCULATE ( [T05 · votos (municípios)], REMOVEFILTERS ( 'UF'[UF], 'UF'[Nome], 'UF'[Ordem] ) )
			)
		formatString: 0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 3e20ba14-c4e6-5b35-9bd6-bdd710720af7

	/// Parcela dos votos de Flávio na UF (soma dos municípios) que saiu do município marcado (0–1).
	measure 'T05 · parte do município no estado' =
			VAR _s = [T05 · UF do município]
			RETURN
			    IF (
			        NOT ISBLANK ( _s ),
			        DIVIDE ( [T05 · votos (municípios)], CALCULATE ( [T05 · votos (municípios)], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s ) )
			    )
		formatString: 0.0%
		displayFolder: T05 Flávio\Contas
		lineageTag: e939da37-445c-5699-bc3c-694b55d98d12

	/// Parcela dos votos de Flávio (soma dos municípios do recorte) que veio da região ou do município da linha (0–1). Tira só as colunas do item (a região e a ordem dela, o rótulo do município).
	measure 'T05 · parte dos votos' =
			DIVIDE (
			    [T05 · votos (municípios)],
			    CALCULATE ( [T05 · votos (municípios)], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ), REMOVEFILTERS ( 'Município'[Rótulo] ) )
			)
		formatString: 0%
		displayFolder: T05 Flávio\Contas
		lineageTag: 1d08c715-6023-52a5-9f56-522829a073ef

	/// População (Censo 2022) do município da linha.
	measure 'T05 · população' =
			SUM ( 'Município'[População] )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: a537c13f-b021-5628-83f2-bac7f5f35d32

	/// Faixa de população do município marcado.
	measure 'T05 · porte do município' =
			SELECTEDVALUE ( 'Município'[Porte] )
		displayFolder: T05 Flávio\Contas
		lineageTag: 70ba19b6-638d-5cc7-86ec-8dab5f3455c5

	/// Colocação de Flávio no 1º turno de 2026, no recorte.
	measure 'T05 · posição' =
			VAR _v = [T05 · votos]
			VAR _todos =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Candidato UF'[Número] ), 'Candidato UF'[Ano] = 2026 ),
			        "@v", CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026 )
			    )
			RETURN
			    1 + COUNTROWS ( FILTER ( _todos, [@v] > _v ) )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: 849ce97f-0b3e-5088-87c1-71eec6886df2

	/// Lugar do município marcado entre as cidades da UF dele pelos % dos válidos de Flávio (1 = o maior).
	measure 'T05 · posição em % no estado' =
			VAR _s = [T05 · UF do município]
			VAR _v = [T05 · % (municípios)]
			VAR _maiores =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'Município'[CodIBGE] ), [T05 · válidos (municípios)] > 0 && [T05 · % (municípios)] > _v ),
			        REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s
			    )
			RETURN
			    IF ( NOT ISBLANK ( _s ) && _v > 0, 1 + COUNTROWS ( _maiores ) )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: 109f79e6-e807-573e-8efb-ec1546bd3818

	/// Lugar do município marcado entre as cidades da UF dele pelos votos de Flávio (1 = o maior).
	measure 'T05 · posição em votos no estado' =
			VAR _s = [T05 · UF do município]
			VAR _v = [T05 · votos (municípios)]
			VAR _maiores =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'Município'[CodIBGE] ), [T05 · válidos (municípios)] > 0 && [T05 · votos (municípios)] > _v ),
			        REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s
			    )
			RETURN
			    IF ( NOT ISBLANK ( _s ) && _v > 0, 1 + COUNTROWS ( _maiores ) )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: 88e25884-7c9a-516a-8ad0-9b52f4419ead

	/// Nome do recorte: o município marcado ou o recorte de estado, lido da medida comum [Recorte · nome] (Brasil; a UF; a região, escolhida no filtro ou clicada na origem; 'MG e SP'; '3 estados').
	measure 'T05 · recorte' =
			IF (
			    [T05 · com município] = 1,
			    SELECTEDVALUE ( 'Município'[Rótulo], "municípios marcados" ),
			    [Recorte · nome]
			)
		displayFolder: T05 Flávio\Contas
		lineageTag: ca58133b-1220-5641-833d-a6130abbe6d2

	/// Nome da região da linha da origem (grão 'UF'[Região]).
	measure 'T05 · região da linha' =
			SELECTEDVALUE ( 'UF'[Região] )
		displayFolder: T05 Flávio\Contas
		lineageTag: 37eaeca3-c418-53b8-a6ad-a017aa425a6d

	/// Região do município da linha.
	measure 'T05 · região do município' =
			SELECTEDVALUE ( 'Município'[Região] )
		displayFolder: T05 Flávio\Contas
		lineageTag: 22155f16-e7b4-59af-a2a5-be97ef90f5a9

	/// No município da linha: 1 = à frente nos dois anos · 2 = estava à frente em 2022 e ficou atrás em 2026 · 3 = virou a favor · 4 = atrás nos dois anos.
	measure 'T05 · situação' =
			VAR _m22 = [T05 · margem 2022]
			VAR _m26 = [T05 · margem]
			RETURN
			    SWITCH ( TRUE (), _m22 > 0 && _m26 > 0, 1, _m22 > 0, 2, _m26 > 0, 3, 4 )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: 72823186-2c54-5cd5-a112-b65e56eda9e6

	/// Nome da UF da linha (lista de estados do dossiê da região e da origem com vários estados).
	measure 'T05 · UF da linha' =
			SELECTEDVALUE ( 'UF'[Nome] )
		displayFolder: T05 Flávio\Contas
		lineageTag: eee5a922-268c-5176-a91d-ddd670413c2e

	/// Sigla da UF do município da linha (ou do município marcado).
	measure 'T05 · UF do município' =
			SELECTEDVALUE ( 'Município'[UF] )
		displayFolder: T05 Flávio\Contas
		lineageTag: f4fd8648-0240-56b4-a2e4-37080aad004a

	/// Votos do PL em 2026 menos 2022, no recorte.
	measure 'T05 · variação de votos' =
			[T05 · votos] - [T05 · votos 2022]
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 2bf6a3d1-9a37-5687-9565-e6a583878395

	/// Votos do PL em 2026 menos 2022, somados nos municípios do contexto (a ficha do município marcado).
	measure 'T05 · variação de votos (municípios)' =
			[T05 · votos (municípios)] - [T05 · votos 2022 (municípios)]
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 5e71dc8e-0db5-5c50-9f59-1147ecdd4be6

	/// Variação do % do PL de 2022 para 2026, em pontos percentuais.
	measure 'T05 · variação em p.p.' =
			( [T05 · %] - [T05 · % 2022] ) * 100
		formatString: 0.0
		displayFolder: T05 Flávio\Contas
		lineageTag: be5b4862-32e2-50dd-8853-b9dd7befb6ae

	/// Variação do % do PL de 2022 para 2026 nos municípios do contexto, em pontos percentuais.
	measure 'T05 · variação em p.p. (municípios)' =
			( [T05 · % (municípios)] - [T05 · % 2022 (municípios)] ) * 100
		formatString: 0.0
		displayFolder: T05 Flávio\Contas
		lineageTag: 21999a68-e1ec-5118-8be6-03cd5674bb7e

	/// Votos de Flávio (número 22) no 1º turno de 2026, no recorte (com o exterior no Brasil).
	measure 'T05 · votos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 22 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: d8128375-c335-5700-9d8e-3247a92a7471

	/// Votos de Flávio em 2026 somados nos municípios do contexto (sem o exterior).
	measure 'T05 · votos (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: b034a373-5db8-52c9-9cd4-cb7784424038

	/// Votos do candidato do PL no 1º turno de 2022, no recorte.
	measure 'T05 · votos 2022' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2022, 'Candidato UF'[Número] = 22 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 975ecca2-282c-5c59-b2f3-63209a023bd8

	/// Votos do PL em 2022 somados nos municípios (sem o exterior).
	measure 'T05 · votos 2022 (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 1953c892-1257-5b01-bfe1-4d1d5ecb47a7

	/// Votos de Lula em 2026 somados nos municípios (sem o exterior).
	measure 'T05 · votos do adversário (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: cc96abc0-1a91-54ec-b5c2-f22822219ec6

	/// Votos do adversário em 2022 somados nos municípios (sem o exterior).
	measure 'T05 · votos do adversário 2022 (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 3d83a09e-3161-58d0-9f9c-cafab42cf0c5

	/// Votos válidos do 1º turno de 2026 no recorte.
	measure 'T05 · válidos' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: fbd71f15-bb31-5e99-b6ce-3f8d66209594

	/// Votos válidos de 2026 somados nos municípios (sem o exterior).
	measure 'T05 · válidos (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: f629cba5-baf2-51d8-9f66-bdba6d72b46a

	/// Votos válidos do 1º turno de 2022 no recorte.
	measure 'T05 · válidos 2022' =
			CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: baa9acb7-9820-507d-aae4-04b22ceba65b

	/// Votos válidos de 2022 somados nos municípios (sem o exterior).
	measure 'T05 · válidos 2022 (municípios)' =
			CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2022 )
		formatString: #,0
		displayFolder: T05 Flávio\Contas
		lineageTag: 20a711f7-0343-5c89-9bfd-d703fb2dad08

	/// 1 quando o filtro de estado escolheu mais de uma UF (uma região inteira, estados soltos ou regiões misturadas): a origem mostra os estados do recorte. Ignora a região da linha da origem (o grão) e a região clicada; 0 no Brasil e numa UF.
	measure 'T05 · vários estados' =
			VAR _com = CALCULATE ( [Recorte · com escolha], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			VAR _n = CALCULATE ( [Recorte · UFs], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			RETURN
			    IF ( _com = 1 && _n > 1, 1, 0 )
		formatString: 0
		displayFolder: T05 Flávio\Contas
		lineageTag: 864c2af0-efd8-5385-bc30-153bf96b126e

	/// Centro do município no quadro 1000 × 1000 dos mapas (x), para o ponto do mapa.
	measure 'T05 · x do município' =
			SELECTEDVALUE ( 'Município'[X] )
		formatString: 0.00
		displayFolder: T05 Flávio\Contas
		lineageTag: 45b60219-2ae7-53b0-8e58-88fe9736446c

	/// Centro do município no quadro 1000 × 1000 dos mapas (y, para baixo).
	measure 'T05 · y do município' =
			SELECTEDVALUE ( 'Município'[Y] )
		formatString: 0.00
		displayFolder: T05 Flávio\Contas
		lineageTag: 5b581896-f699-5747-bc75-f901dc6b87cb

	/// Texto para leitor de tela da legenda do mapa.
	measure 'T05 · Legenda · ALT' =
			"Legenda: cada ponto é um município, o tamanho segue os votos de Flávio; a cor mostra onde Flávio ficou à "
			    & "frente (mais escuro, maior margem) e, em areia, onde Lula ficou à frente. Clique num ponto para levar "
			    & "a cidade ao painel."
		displayFolder: T05 Flávio\Desenho
		lineageTag: 67cf5bc2-0dd8-574e-ab3d-6e43fc85e23c

	/// Legenda do mapa de pontos (como ler a cor e o tamanho) e a dica do que o clique faz, ou do que está marcado agora.
	measure 'T05 · Legenda · HTML' =
			-- 1 · Leituras
			VAR _comMun = [T05 · com município]
			VAR _comReg = [T05 · com região]
			VAR _rec = [T05 · recorte]
			-- 2 · Textos
			VAR _dica =
			    SWITCH (
			        TRUE (),
			        _comMun = 1, "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rec, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</b> marcado · clique no vazio do mapa para voltar",
			        _comReg = 1, "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rec, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</b> marcado · clique de novo na região para voltar",
			        "passe o mouse num ponto para ver a cidade; clique para levá-la ao painel"
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela lgm entra d6'>"
			        & "<span class='it'><i class='bol'></i>cada ponto é um município; o tamanho segue os votos de Flávio</span>"
			        & "<span class='it'><i class='esc'></i>Flávio à frente: quanto mais escuro, maior a margem</span>"
			        & "<span class='it'><i class='atr'></i>Lula à frente</span>"
			        & "<span class='it dica'>" & _dica & "</span>"
			    & "</div>"
		displayFolder: T05 Flávio\Desenho
		lineageTag: 5ed1b9f5-da6d-5501-8ed2-609309d005e1

	/// Texto para leitor de tela do mapa de pontos.
	measure 'T05 · Mapa · ALT' =
			LEFT (
			    "Mapa (" & [T05 · recorte] & ") com um ponto por município: Flávio ficou à frente em "
			        & [T05 · municípios à frente] & " de " & [T05 · municípios]
			        & IF ( [T05 · municípios] = 1, " município", " municípios" ) & ". Passe o mouse num ponto "
			        & "para ver a cidade; clique para levá-la ao painel.",
			    250
			)
		displayFolder: T05 Flávio\Desenho
		lineageTag: 1d773202-b08c-5acf-8f84-1d6daf3ede9b

	/// Texto para leitor de tela da origem dos votos.
	measure 'T05 · Origem · ALT' =
			LEFT (
			    SWITCH (
			        TRUE (),
			        [T05 · com município] = 1,
			            [T05 · município] & ": " & FORMAT ( [T05 · parte do município no estado], "0.0%" ) & " dos votos de Flávio em "
			                & [T05 · estado do município] & ".",
			        [T05 · vários estados] = 1,
			            "Os estados que mais deram votos a Flávio " & [Recorte · em] & ", com a parte de cada um nos "
			                & "votos dele.",
			        [T05 · com UF] = 1,
			            "As cidades que mais deram votos a Flávio " & [Recorte · em] & ".",
			        "De onde vêm os votos de Flávio, por região. Clique numa região para ver só ela no mapa; passe o mouse "
			            & "para ver os estados dela."
			    ),
			    250
			)
		displayFolder: T05 Flávio\Desenho
		lineageTag: 27343143-d8da-5ae4-90bc-9e1d64b671ac

	/// Com vários estados no filtro de estado (uma região inteira, estados soltos ou regiões misturadas): os estados que mais deram votos a Flávio na barra (os 5 maiores e os demais estados) e na lista — a parte de cada um nos votos dele no recorte, os votos e o % dos válidos. Só a entrada da primeira região do recorte desenha (as outras ficam vazias). Sem clique (o clique numa cidade é no mapa).
	measure 'T05 · Origem · bloco estados' =
			-- 1 · Leituras
			VAR _primeira = [T05 · linha da primeira região]
			VAR _n = CALCULATE ( [Recorte · UFs], REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ) )
			VAR _ufsBase =
			    CALCULATETABLE (
			        TOPN (
			            5,
			            ADDCOLUMNS (
			                VALUES ( 'UF'[UF] ),
			                "@nome", [T05 · UF da linha],
			                "@v", [T05 · votos (municípios)],
			                "@p", [T05 · parte do estado no recorte],
			                "@pv", [T05 · % (municípios)]
			            ),
			            [@v], DESC
			        ),
			        REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] ),
			        'UF'[Tipo] = "UF"
			    )
			VAR _lista =
			    SELECTCOLUMNS ( FILTER ( _ufsBase, [@v] > 0 ), "@nome", [@nome], "@v", [@v], "@p", [@p], "@pv", [@pv] ) /* lista */
			-- 3 · Geometria (barra de 620 px; as fatias seguem a ordem dos votos; linhas de 30 px a partir de y 92)
			VAR _comIni =
			    ADDCOLUMNS (
			        _lista,
			        "@ini", VAR _vv = [@v] RETURN SUMX ( FILTER ( _lista, [@v] > _vv ), [@p] ) + 0, /* lista */
			        "@ord", VAR _vv = [@v] RETURN 1 + COUNTROWS ( FILTER ( _lista, [@v] > _vv ) ) /* lista */
			    )
			VAR _sobra = ( 1 - SUMX ( _lista, [@p] ) ) * 620 -- geometria (o trilho dos demais estados)
			VAR _fatias =
			    CONCATENATEX (
			        _comIni,
			        VAR _w = [@p] * 620 -- geometria
			        VAR _cabe = ( LEN ( [@nome] ) + 4 ) * 9.4 + 16 -- geometria (nome e % em Sora 15 semibold)
			        VAR _rot = IF ( _w >= _cabe, [@nome] & " " & FORMAT ( [@p], "0%" ), IF ( _w >= 44, FORMAT ( [@p], "0%" ), "" ) )
			        RETURN
			            "<div class='fa o" & MIN ( [@ord], 5 ) & " barra-x d" & ( [@ord] + 4 ) & "' style='left:"
			                & FORMAT ( [@ini] * 620, "0.0##", "en-US" ) & "px;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rot, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span></div>",
			        "",
			        [@v], DESC
			    )
			VAR _linhas =
			    CONCATENATEX (
			        _comIni,
			        "<div class='li sobe d" & ( [@ord] + 6 ) & "' style='top:" & ( 92 + ( [@ord] - 1 ) * 30 ) & "px'>"
			            & "<i class='sw o" & MIN ( [@ord], 5 ) & "'></i><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [@nome], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>"
			            & "<span class='a'>" & FORMAT ( [@p], "0%" ) & " dos votos dele · " & SWITCH ( TRUE (), ABS ( [@v] ) >= 1000000, FORMAT ( [@v] / 1000000, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( [@v] / 1000, "0.0" ) & " mil", FORMAT ( [@v], "#,0" ) ) & "</span>"
			            & "<span class='b'>" & FORMAT ( [@pv], "0.0%" ) & " dos válidos</span></div>",
			        "",
			        [@v], DESC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        _primeira = 1,
			        "<div class='tela og'><div class='oc'>"
			            & "<div class='rot ro sobe'>De onde vêm os votos · os estados que mais deram votos</div>"
			            & "<div class='trilho entra d3'></div>"
			            & IF ( _n > 5 && _sobra >= 136, "<span class='resto entra d9'>demais estados</span>" )
			            & _fatias & _linhas
			            & "<div class='dica entra d14'>clique num ponto do mapa para ver uma cidade</div>"
			        & "</div></div>"
			    )
		displayFolder: T05 Flávio\Desenho
		lineageTag: 0d3a2a34-9296-5be8-a022-d65253244017

	/// Com um município marcado (uma entrada só): o lugar dele entre as cidades da UF — a fatia dos votos de Flávio no estado que saiu dele e as posições em votos e em % dos válidos. Sem clique.
	measure 'T05 · Origem · bloco município' =
			-- 1 · Leituras
			VAR _mun = [T05 · município]
			VAR _est = [T05 · estado do município]
			VAR _parte = [T05 · parte do município no estado]
			VAR _posV = [T05 · posição em votos no estado]
			VAR _posP = [T05 · posição em % no estado]
			VAR _n = [T05 · municípios no estado do município]
			-- 2 · Textos
			VAR _nm = IF ( RIGHT ( _mun, 1 ) = ")", LEFT ( _mun, LEN ( _mun ) - 5 ), _mun )
			VAR _txtNm = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtEst = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _est, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _rotulo =
			    IF (
			        _n = 1,
			        _txtNm & " · " & _txtEst & " · o único município",
			        "No estado · " & _txtEst & " · " & FORMAT ( _n, "#,0" ) & " cidades"
			    )
			VAR _txtParte = FORMAT ( _parte, "0.0%" ) & " dos votos de Flávio no estado saíram daqui"
			VAR _linhaV =
			    IF (
			        _posV = 1,
			        "a cidade que mais deu votos a Flávio no estado",
			        "cidade que mais deu votos a Flávio no estado"
			    )
			VAR _linhaP =
			    IF (
			        _posP = 1,
			        "onde Flávio teve o maior % dos válidos no estado",
			        "no % dos válidos de Flávio, da mais forte à mais fraca"
			    )
			-- 3 · Geometria (barra de 620 px)
			VAR _w = MAX ( _parte * 620, 4 ) -- geometria
			VAR _dentro = _w >= 360 -- geometria
			VAR _xr = FORMAT ( _w + 12, "0.0##", "en-US" ) -- geometria
			-- 4 · Marcação
			VAR _rk =
			    IF (
			        _n > 1,
			        "<div class='rk sobe d8' style='top:96px'><span class='n flavio'>" & _posV & "ª</span><span class='t'>"
			            & _linhaV & "</span></div>"
			            & "<div class='rk sobe d10' style='top:160px'><span class='n'>" & _posP & "ª</span><span class='t'>"
			            & _linhaP & "</span></div>"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _mun ),
			        "<div class='tela og'><div class='oc'>"
			            & "<div class='rot ro sobe'>" & _rotulo & "</div>"
			            & "<div class='trilho entra d3'></div>"
			            & "<div class='fa o1 barra-x d5' style='left:0;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>"
			            & IF ( _dentro, _txtParte ) & "</span></div>"
			            & IF ( NOT _dentro, "<span class='lfa entra d8' style='left:" & _xr & "px'>" & _txtParte & "</span>" )
			            & _rk
			            & "<div class='dica entra d14'>clique no vazio do mapa para voltar</div>"
			        & "</div></div>"
			    )
		displayFolder: T05 Flávio\Desenho
		lineageTag: 2e351c3d-a301-54ac-a1a3-64cd9e9a267f

	/// A região da linha na barra da origem (fatia proporcional aos votos, na ordem dos votos) e na lista (parte dos votos dele, votos e % dos válidos). O rótulo do bloco e a dica do clique ficam no modelo do visual (fora das entradas, não esmaecem com a seleção). Fatia e linha têm alvos de clique próprios, fixos (L012).
	measure 'T05 · Origem · bloco região' =
			-- 1 · Leituras
			VAR _reg = [T05 · região da linha]
			VAR _v = [T05 · votos (municípios)]
			VAR _p = [T05 · parte dos votos]
			VAR _pv = [T05 · % (municípios)]
			VAR _ord = [T05 · ordem da região]
			VAR _ini = [T05 · início da região]
			-- 2 · Textos
			VAR _txtNome = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtP = FORMAT ( _p, "0%" )
			VAR _o = MIN ( _ord, 5 )
			-- 3 · Geometria (barra de 620 px; linhas de 30 px a partir de y 92)
			VAR _w = _p * 620 -- geometria
			VAR _rot = IF ( _w >= 120, _txtNome & " " & _txtP, IF ( _w >= 44, _txtP, "" ) )
			VAR _x = FORMAT ( _ini * 620, "0.0##", "en-US" ) -- geometria
			VAR _wc = FORMAT ( _w, "0.0##", "en-US" ) -- geometria
			VAR _y = 92 + ( _ord - 1 ) * 30 -- geometria
			-- 4 · Marcação
			RETURN
			    "<div class='tela og'><div class='oc'>"
			        & "<div class='vis fa o" & _o & " barra-x d" & ( _ord + 4 ) & "' style='left:" & _x & "px;width:" & _wc
			        & "px'><span>" & _rot & "</span></div>"
			        & "<div class='hv' style='left:" & _x & "px;top:28px;width:" & _wc & "px;height:46px'></div>"
			        & "<div class='vis li sobe d" & ( _ord + 6 ) & "' style='top:" & _y & "px'><i class='sw o" & _o & "'></i>"
			        & "<span class='nm'>" & _txtNome & "</span><span class='a'>" & _txtP & " dos votos dele · " & SWITCH ( TRUE (), ABS ( _v ) >= 1000000, FORMAT ( _v / 1000000, "0.00" ) & " mi", ABS ( _v ) >= 1000, FORMAT ( _v / 1000, "0.0" ) & " mil", FORMAT ( _v, "#,0" ) )
			        & "</span><span class='b'>" & FORMAT ( _pv, "0.0%" ) & " dos válidos</span></div>"
			        & "<div class='hv' style='left:-10px;top:" & _y & "px;width:640px;height:30px'></div>"
			    & "</div></div>"
		displayFolder: T05 Flávio\Desenho
		lineageTag: 43fe9e9e-48c1-5520-bbe9-e38bff4fc01d

	/// Numa UF (uma entrada só): as cidades que mais deram votos a Flávio na barra (as 5 maiores e os demais municípios) e na lista. Sem clique (o clique numa cidade é no mapa).
	measure 'T05 · Origem · bloco UF' =
			-- 1 · Leituras
			VAR _munsBase =
			    TOPN (
			        5,
			        ADDCOLUMNS (
			            VALUES ( 'Município'[Rótulo] ),
			            "@v", [T05 · votos (municípios)],
			            "@p", [T05 · parte dos votos],
			            "@pv", [T05 · % (municípios)]
			        ),
			        [@v], DESC
			    )
			VAR _lista =
			    SELECTCOLUMNS ( FILTER ( _munsBase, [@v] > 0 ), "@nome", 'Município'[Rótulo], "@v", [@v], "@p", [@p], "@pv", [@pv] ) /* lista */
			-- 3 · Geometria (barra de 620 px; as fatias seguem a ordem dos votos; linhas de 30 px a partir de y 92)
			VAR _comIni =
			    ADDCOLUMNS (
			        _lista,
			        "@ini", VAR _vv = [@v] RETURN SUMX ( FILTER ( _lista, [@v] > _vv ), [@p] ) + 0, /* lista */
			        "@ord", VAR _vv = [@v] RETURN 1 + COUNTROWS ( FILTER ( _lista, [@v] > _vv ) ) /* lista */
			    )
			VAR _fatias =
			    CONCATENATEX (
			        _comIni,
			        VAR _w = [@p] * 620 -- geometria
			        VAR _nm = IF ( RIGHT ( [@nome], 1 ) = ")", LEFT ( [@nome], LEN ( [@nome] ) - 5 ), [@nome] )
			        VAR _rot = IF ( _w >= 120, _nm & " " & FORMAT ( [@p], "0%" ), IF ( _w >= 44, FORMAT ( [@p], "0%" ), "" ) )
			        RETURN
			            "<div class='fa o" & MIN ( [@ord], 5 ) & " barra-x d" & ( [@ord] + 4 ) & "' style='left:"
			                & FORMAT ( [@ini] * 620, "0.0##", "en-US" ) & "px;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rot, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span></div>",
			        "",
			        [@v], DESC
			    )
			VAR _linhas =
			    CONCATENATEX (
			        _comIni,
			        VAR _nm = IF ( RIGHT ( [@nome], 1 ) = ")", LEFT ( [@nome], LEN ( [@nome] ) - 5 ), [@nome] )
			        RETURN
			            "<div class='li sobe d" & ( [@ord] + 6 ) & "' style='top:" & ( 92 + ( [@ord] - 1 ) * 30 ) & "px'>"
			                & "<i class='sw o" & MIN ( [@ord], 5 ) & "'></i><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>"
			                & "<span class='a'>" & FORMAT ( [@p], "0%" ) & " dos votos dele · " & SWITCH ( TRUE (), ABS ( [@v] ) >= 1000000, FORMAT ( [@v] / 1000000, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( [@v] / 1000, "0.0" ) & " mil", FORMAT ( [@v], "#,0" ) ) & "</span>"
			                & "<span class='b'>" & FORMAT ( [@pv], "0.0%" ) & " dos válidos</span></div>",
			        "",
			        [@v], DESC
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela og'><div class='oc'>"
			        & "<div class='rot ro sobe'>De onde vêm os votos · as cidades que mais deram votos</div>"
			        & "<div class='trilho entra d3'></div><span class='resto entra d9'>demais municípios</span>"
			        & _fatias & _linhas
			        & "<div class='dica entra d14'>clique num ponto do mapa para ver uma cidade</div>"
			    & "</div></div>"
		displayFolder: T05 Flávio\Desenho
		lineageTag: 21d0f58f-d007-589f-97a9-cd6c99427363

	/// De onde vêm os votos de Flávio, uma entrada por região: no Brasil, a fatia e a linha da região (clicáveis); com vários estados no filtro (uma região inteira ou estados soltos), os estados que mais deram votos; numa UF, as cidades que mais deram votos; com um município marcado, o lugar dele entre as cidades do estado. Só escolhe o bloco.
	measure 'T05 · Origem · HTML' =
			VAR _v = [T05 · votos (municípios)]
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ( _v > 0 ), BLANK (),
			        [T05 · com município] = 1, [T05 · Origem · bloco município],
			        [T05 · vários estados] = 1, [T05 · Origem · bloco estados],
			        [T05 · com UF] = 1, [T05 · Origem · bloco UF],
			        [T05 · Origem · bloco região]
			    )
		displayFolder: T05 Flávio\Desenho
		lineageTag: 687542f7-0380-50a9-b0e8-0ace7d161bb9

	/// Texto para leitor de tela da coluna do resumo (recorte ou município marcado).
	measure 'T05 · Resumo · ALT' =
			IF (
			    [T05 · com município] = 1,
			    LEFT (
			        "Flávio em " & [T05 · município] & ": " & FORMAT ( [T05 · % (municípios)], "0.0%" ) & " dos válidos, "
			            & SWITCH ( TRUE (), ABS ( [T05 · votos (municípios)] ) >= 1000000, FORMAT ( [T05 · votos (municípios)] / 1000000, "0.00" ) & " mi", ABS ( [T05 · votos (municípios)] ) >= 1000, FORMAT ( [T05 · votos (municípios)] / 1000, "0.0" ) & " mil", FORMAT ( [T05 · votos (municípios)], "#,0" ) ) & " de votos; no estado, " & FORMAT ( [T05 · % no estado do município], "0.0%" )
			            & ".",
			        250
			    ),
			    LEFT (
			        "Flávio, " & [T05 · recorte] & ": " & FORMAT ( [T05 · %], "0.0%" ) & " dos válidos, " & SWITCH ( TRUE (), ABS ( [T05 · votos] ) >= 1000000, FORMAT ( [T05 · votos] / 1000000, "0.00" ) & " mi", ABS ( [T05 · votos] ) >= 1000, FORMAT ( [T05 · votos] / 1000, "0.0" ) & " mil", FORMAT ( [T05 · votos], "#,0" ) )
			            & " de votos; à frente em " & [T05 · municípios à frente] & " de " & [T05 · municípios]
			            & IF ( [T05 · municípios] = 1, " município", " municípios" ) & ". Mais forte: "
			            & [T05 · lugar mais forte] & "; mais fraco: " & [T05 · lugar mais fraco] & ".",
			        250
			    )
			)
		displayFolder: T05 Flávio\Desenho
		lineageTag: 128ec165-aff3-5a52-9ae5-f7b568eb61cf

	/// Ficha do município marcado no mapa: o % e os votos de Flávio lá, a margem sobre Lula (e se a cidade virou desde 2022), 2022 → 2026 e três comparações: o estado, as cidades do mesmo porte no Brasil e o Brasil.
	measure 'T05 · Resumo · bloco município' =
			-- 1 · Leituras
			VAR _mun = [T05 · município]
			VAR _pct = [T05 · % (municípios)]
			VAR _votos = [T05 · votos (municípios)]
			VAR _m26 = [T05 · margem]
			VAR _sit = [T05 · situação]
			VAR _v22 = [T05 · votos 2022 (municípios)]
			VAR _p22 = [T05 · % 2022 (municípios)]
			VAR _c22 = [T05 · candidato 2022]
			VAR _dv = [T05 · variação de votos (municípios)]
			VAR _dpp = [T05 · variação em p.p. (municípios)]
			VAR _est = [T05 · estado do município]
			VAR _pEst = [T05 · % no estado do município]
			VAR _porte = [T05 · porte do município]
			VAR _pPorte = [T05 · % no porte do município]
			VAR _nPorte = [T05 · cidades do porte]
			VAR _pBr = [T05 · % no Brasil]
			-- 2 · Textos
			VAR _nm = IF ( RIGHT ( _mun, 1 ) = ")", LEFT ( _mun, LEN ( _mun ) - 5 ), _mun )
			VAR _txtNm = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtMun = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mun, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _mpp = ABS ( _m26 ) * 100
			VAR _txtM = FORMAT ( _mpp, "0.0" ) & IF ( _mpp < 2, " ponto", " pontos" )
			VAR _lado = IF ( _m26 > 0, "à frente de Lula", "atrás de Lula" )
			VAR _manchete =
			    SWITCH (
			        TRUE (),
			        _m26 = 0, "Em " & _txtNm & ", Flávio e Lula empataram",
			        _sit = 2 || _sit = 3, _txtNm & " virou: Flávio ficou " & _txtM & " " & _lado,
			        "Em " & _txtNm & ", Flávio ficou " & _txtM & " " & _lado & ", como em 2022"
			    )
			VAR _clsMc = IF ( LEN ( _manchete ) > 74, " l", "" )
			VAR _txtLado = IF ( _m26 > 0, "à frente de Lula", IF ( _m26 < 0, "atrás de Lula", "empate com Lula" ) )
			VAR _txtDV = IF ( _dv < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dv ) ) >= 1000000, FORMAT ( ABS ( _dv ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dv ) ) >= 1000, FORMAT ( ABS ( _dv ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dv ), "#,0" ) )
			VAR _pontos = IF ( ABS ( _dpp ) < 2, " ponto", " pontos" )
			VAR _compara =
			    "Em 2022, " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " teve " & SWITCH ( TRUE (), ABS ( _v22 ) >= 1000000, FORMAT ( _v22 / 1000000, "0.00" ) & " mi", ABS ( _v22 ) >= 1000, FORMAT ( _v22 / 1000, "0.0" ) & " mil", FORMAT ( _v22, "#,0" ) ) & IF ( _v22 = 1, " voto", " votos" ) & " aqui ("
			        & FORMAT ( _p22, "0.0%" ) & "). Agora: <b class='flavio-esc'>" & _txtDV
			        & IF ( ABS ( _dv ) >= 1000, " de votos", IF ( ABS ( _dv ) = 1, " voto", " votos" ) )
			        & "</b> e <b class='flavio-esc'>" & FORMAT ( _dpp, "+0.0;−0.0;0.0" ) & _pontos & "</b>."
			VAR _txtPorte = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _porte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " <small>" & FORMAT ( _nPorte, "#,0" ) & IF ( _nPorte = 1, " cidade", " cidades" ) & "</small>"
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela rv'>"
			        & "<div class='sob sobe'>Flávio · PL · 22 · " & _txtMun & "</div>"
			        & "<div class='topo'><div class='big flavio sobe d1'>" & FORMAT ( _pct, "0.0%" ) & "</div>"
			        & "<div class='lado sobe d2'><div class='vv flavio'>" & SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) ) & "</div>"
			        & "<div class='txt'>de votos · " & _txtLado & "</div></div></div>"
			        & "<div class='man mc" & _clsMc & " sobe d3'>" & _manchete & "</div>"
			        & "<div class='txt cp sobe d4'>" & _compara & "</div>"
			        & "<div class='fatos'>"
			        & "<div class='fato sobe d10'><span class='ic f'></span><div><div class='rot'>" & "Em todo o estado" & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _est, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp flavio'>" & FORMAT ( _pEst, "0.0%" ) & "</div></div>"
			        & "<div class='fato sobe d11'><span class='ic g'></span><div><div class='rot'>" & "Nas cidades do mesmo porte, no Brasil" & "</div><div class='lg'>" & _txtPorte & "</div></div><div class='vp'>" & FORMAT ( _pPorte, "0.0%" ) & "</div></div>"
			        & "<div class='fato sobe d12'><span class='ic r'></span><div><div class='rot'>" & "No Brasil inteiro" & "</div><div class='lg'>" & "resultado oficial, com o exterior" & "</div></div><div class='vp'>" & FORMAT ( _pBr, "0.0%" ) & "</div></div>"
			        & "</div>"
			    & "</div>"
			RETURN
			    IF ( NOT ISBLANK ( _mun ) && NOT ISBLANK ( _votos ), _html )
		displayFolder: T05 Flávio\Desenho
		lineageTag: 0e8cfa8c-dd37-5755-83fa-3957f75dee47

	/// Resumo do recorte: o % de Flávio, os votos, em quantos municípios ficou à frente, o que mudou desde 2022 e três fatos (mais forte, mais fraco, cidade grande). A faixa do meio fica livre para a origem (outro visual).
	measure 'T05 · Resumo · bloco recorte' =
			-- 1 · Leituras
			VAR _comUF = [T05 · com UF]
			VAR _recorte = [T05 · recorte]
			VAR _votos = [T05 · votos]
			VAR _pct = [T05 · %]
			VAR _pos = [T05 · posição]
			VAR _v22 = [T05 · votos 2022]
			VAR _p22 = [T05 · % 2022]
			VAR _c22 = [T05 · candidato 2022]
			VAR _dv = [T05 · variação de votos]
			VAR _dpp = [T05 · variação em p.p.]
			VAR _nFrente = [T05 · municípios à frente]
			VAR _nMun = [T05 · municípios]
			VAR _eleit = [T05 · eleitores nos municípios à frente]
			VAR _forte = [T05 · lugar mais forte]
			VAR _forteP = [T05 · lugar mais forte %]
			VAR _fraco = [T05 · lugar mais fraco]
			VAR _fracoP = [T05 · lugar mais fraco %]
			VAR _grande = [T05 · cidade grande mais forte]
			VAR _grandeP = [T05 · cidade grande mais forte %]
			VAR _grandePop = [T05 · cidade grande mais forte população]
			-- 2 · Textos
			VAR _txtRec = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtPct = FORMAT ( _pct, "0.0%" )
			VAR _txtVotos = SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) )
			VAR _txtNFrente = FORMAT ( _nFrente, "#,0" )
			VAR _txtNMun = FORMAT ( _nMun, "#,0" )
			VAR _txtEleit = IF ( _eleit >= 0.995 && _nFrente < _nMun, FORMAT ( _eleit, "0.0%" ), FORMAT ( _eleit, "0%" ) )
			VAR _txtMun = IF ( _nMun = 1, " município", " municípios" )
			VAR _manchete =
			    SWITCH (
			        TRUE (),
			        _nMun = 1 && _nFrente = 1, "Flávio ficou à frente no único município do recorte",
			        _nMun = 1, "Flávio ficou atrás no único município do recorte",
			        _nFrente = 0, "Flávio não ficou à frente em nenhum dos " & _txtNMun & _txtMun,
			        "Flávio ficou à frente em " & _txtNFrente & " dos " & _txtNMun & _txtMun & ", onde votam " & _txtEleit & " dos eleitores"
			    )
			VAR _txtDV = IF ( _dv < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dv ) ) >= 1000000, FORMAT ( ABS ( _dv ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dv ) ) >= 1000, FORMAT ( ABS ( _dv ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dv ), "#,0" ) )
			VAR _txtDPP = FORMAT ( _dpp, "+0.0;−0.0;0.0" )
			VAR _pontos = IF ( ABS ( _dpp ) < 2, " ponto", " pontos" )
			VAR _compara =
			    "Em 2022, " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " teve " & SWITCH ( TRUE (), ABS ( _v22 ) >= 1000000, FORMAT ( _v22 / 1000000, "0.00" ) & " mi", ABS ( _v22 ) >= 1000, FORMAT ( _v22 / 1000, "0.0" ) & " mil", FORMAT ( _v22, "#,0" ) ) & " (" & FORMAT ( _p22, "0.0%" ) & "). Agora: <b class='flavio-esc'>"
			        & _txtDV & IF ( ABS ( _dv ) >= 1000, " de votos", IF ( ABS ( _dv ) = 1, " voto", " votos" ) )
			        & "</b> e <b class='flavio-esc'>" & _txtDPP & _pontos & "</b>."
			VAR _rotForte = IF ( _comUF = 1, "Município mais forte", "UF mais forte" )
			VAR _rotFraco = IF ( _comUF = 1, "Município mais fraco", "UF mais fraca" )
			VAR _fatoGrande =
			    IF (
			        NOT ISBLANK ( _grande ),
			        "<div class='fato sobe d12'><span class='ic g'></span><div><div class='rot'>" & "Entre as cidades de 100 mil+" & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _grande, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " <small>" & FORMAT ( _grandePop, "#,0" ) & " habitantes</small>" & "</div></div><div class='vp flavio'>" & FORMAT ( _grandeP, "0.0%" ) & "</div></div>"
			    )
			-- 4 · Marcação
			VAR _html =
			    "<div class='tela rv'>"
			        & "<div class='sob sobe'>Flávio Bolsonaro · PL · 22 · " & _txtRec & "</div>"
			        & "<div class='topo'><div class='big flavio sobe d1'>" & _txtPct & "</div>"
			        & "<div class='lado sobe d2'><div class='vv flavio'>" & _txtVotos & "</div>"
			        & "<div class='txt'>de votos · " & _pos & "º lugar</div></div></div>"
			        & "<div class='man mc sobe d3'>" & _manchete & "</div>"
			        & "<div class='txt cp sobe d4'>" & _compara & "</div>"
			        & "<div class='fatos'>"
			        & "<div class='fato sobe d10'><span class='ic f'></span><div><div class='rot'>" & _rotForte & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _forte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp flavio'>" & FORMAT ( _forteP, "0.0%" ) & "</div></div>"
			        & IF ( _fraco <> _forte, "<div class='fato sobe d11'><span class='ic r'></span><div><div class='rot'>" & _rotFraco & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fraco, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp'>" & FORMAT ( _fracoP, "0.0%" ) & "</div></div>" )
			        & _fatoGrande & "</div>"
			    & "</div>"
			RETURN
			    _html
		displayFolder: T05 Flávio\Desenho
		lineageTag: b42c94e5-4a20-5385-88e8-499d52896bb1

	/// Coluna da esquerda da tela 05: a ficha do município marcado no mapa ou a do recorte (Brasil, região clicada ou UF do filtro). Só escolhe o bloco.
	measure 'T05 · Resumo · HTML' =
			IF ( [T05 · com município] = 1, [T05 · Resumo · bloco município], [T05 · Resumo · bloco recorte] )
		displayFolder: T05 Flávio\Desenho
		lineageTag: e0a61b69-be34-5438-b5f2-db4ecdd241b3

	/// Texto para leitor de tela do dossiê do município.
	measure 'T05 · Tooltip município · ALT' =
			LEFT (
			    [T05 · município] & ": Flávio " & FORMAT ( [T05 · % (municípios)], "0.0%" ) & " e Lula "
			        & FORMAT ( [T05 · adversário % (municípios)], "0.0%" ) & " em 2026; margem do PL de "
			        & FORMAT ( [T05 · margem 2022] * 100, "+0.0;−0.0;0.0" ) & " para " & FORMAT ( [T05 · margem] * 100, "+0.0;−0.0;0.0" ) & " pontos.",
			    250
			)
		displayFolder: T05 Flávio\Desenho
		lineageTag: fe8d0b8f-8952-5d2a-9cb8-c65dd2cea43b

	/// Dossiê do município do ponto (ficha pautada presa com fita): Flávio × Lula em 2026, o mesmo par em 2022 e a margem antes e agora, com a nota à mão do que aconteceu. Só lê contas.
	measure 'T05 · Tooltip município · HTML' =
			-- 1 · Leituras
			VAR _mun = [T05 · município]
			VAR _reg = [T05 · região do município]
			VAR _pop = [T05 · população]
			VAR _p26 = [T05 · % (municípios)]
			VAR _a26 = [T05 · adversário % (municípios)]
			VAR _p22 = [T05 · % 2022 (municípios)]
			VAR _a22 = [T05 · adversário % 2022 (municípios)]
			VAR _m22 = [T05 · margem 2022]
			VAR _m26 = [T05 · margem]
			VAR _v26 = [T05 · votos (municípios)]
			VAR _sit = [T05 · situação]
			VAR _c22 = [T05 · candidato 2022]
			-- 2 · Textos
			VAR _nome22 = IF ( "PL" = "PT", "Lula", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) )
			VAR _outro22 = IF ( "PL" = "PT", "Jair Bolsonaro", "Lula" )
			VAR _nota =
			    SWITCH (
			        _sit,
			        1, "seguiu com o PL",
			        2, "virou para Lula",
			        3, "virou para Flávio",
			        "seguiu com Lula"
			    )
			VAR _clsNota = IF ( _sit = 1 || _sit = 3, "flavio-esc", "neutro" )
			VAR _txtM22 = FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" )
			VAR _txtM26 = FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" )
			-- 3 · Geometria (barras de 0 a 100% em 180 px)
			VAR _w26 = FORMAT ( _p26 * 180, "0.0##", "en-US" ) -- geometria
			VAR _wa26 = FORMAT ( _a26 * 180, "0.0##", "en-US" ) -- geometria
			VAR _w22 = FORMAT ( _p22 * 180, "0.0##", "en-US" ) -- geometria
			VAR _wa22 = FORMAT ( _a22 * 180, "0.0##", "en-US" ) -- geometria
			-- 4 · Marcação
			VAR _css =
			    "<style>"
			        & ".tt3{position:fixed;inset:0;background:var(--papel)}"
			        & ".tt3 .ficha{position:absolute;left:14px;top:22px;right:14px;bottom:14px;background:var(--branco);"
			        & "border:1.5px solid var(--areia);background-image:repeating-linear-gradient(transparent 0 31px,"
			        & "rgba(203,189,162,.45) 31px 32px);box-shadow:3px 4px 0 rgba(28,25,21,.07)}"
			        & ".tt3 .fita{position:absolute;left:170px;top:-16px;width:96px;transform:rotate(-3deg);opacity:.9}"
			        & ".tt3 .pino{position:absolute;right:16px;top:14px;width:30px}"
			        & ".tt3 .cab{position:absolute;left:18px;top:14px;right:56px}"
			        & ".tt3 .nm{font-size:22px;font-weight:700;line-height:1.15;letter-spacing:-.01em}"
			        & ".tt3 .an{position:absolute;left:18px;right:18px;display:grid;grid-template-columns:52px 1fr;row-gap:6px;"
			        & "align-items:center}.tt3 .a26{top:84px}.tt3 .a22{top:166px}"
			        & ".tt3 .ano{font-size:15px;font-weight:700}"
			        & ".tt3 .lin{display:flex;align-items:center;gap:8px;font-size:15px}"
			        & ".tt3 .lin i{display:block;height:12px}.tt3 .lin b{font-weight:700;min-width:50px}"
			        & ".tt3 .lin span{color:var(--grafite)}"
			        & ".tt3 .ci{background:var(--azul)}.tt3 .co{background:var(--areia)}"
			        & ".tt3 .mg{position:absolute;left:18px;right:18px;top:248px;font-size:15px;color:var(--grafite)}"
			        & ".tt3 .mg b{color:var(--tinta)}"
			        & ".tt3 .mao{position:absolute;right:18px;bottom:8px;font-size:28px}"
			        & ".tt3 .neutro{color:var(--grafite)}"
			    & "</style>"
			VAR _lin = "<div class='lin'><i class='"
			VAR _html =
			    _css
			        & "<div class='tt3'><div class='ficha'>"
			        & "<img class='fita' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/dossie/fita-tinta.png'/>"
			        & "<img class='pino' alt='' src='https://vizudados.github.io/eleicoes-2026/midia/arte/icones/pino-tinta.png'/>"
			        & "<div class='cab sobe'><div class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _mun, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
			        & "<div class='rot'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · " & FORMAT ( _pop, "#,0" ) & " habitantes</div></div>"
			        & "<div class='an a26 sobe d1'><div class='ano'>2026</div><div>"
			        & _lin & "ci barra-x' style='width:" & _w26 & "px'></i><b>" & FORMAT ( _p26, "0.0%" ) & "</b><span>Flávio</span></div>"
			        & _lin & "co barra-x' style='width:" & _wa26 & "px'></i><b>" & FORMAT ( _a26, "0.0%" ) & "</b><span>Lula</span></div>"
			        & "</div></div>"
			        & "<div class='an a22 sobe d2'><div class='ano'>2022</div><div>"
			        & _lin & "ci barra-x' style='width:" & _w22 & "px;opacity:.55'></i><b>" & FORMAT ( _p22, "0.0%" ) & "</b><span>"
			        & _nome22 & "</span></div>"
			        & _lin & "co barra-x' style='width:" & _wa22 & "px;opacity:.55'></i><b>" & FORMAT ( _a22, "0.0%" ) & "</b><span>"
			        & _outro22 & "</span></div>"
			        & "</div></div>"
			        & "<div class='mg sobe d3'>Margem do PL, em pontos: <b>" & _txtM22 & "</b> → <b>"
			        & _txtM26 & "</b></div>"
			        & "<div class='mao " & _clsNota & " entra d5'>" & _nota & "</div>"
			        & "</div></div>"
			RETURN
			    IF ( NOT ISBLANK ( _mun ) && NOT ISBLANK ( _v26 ), _html )
		displayFolder: T05 Flávio\Desenho
		lineageTag: e7346e3b-f466-5b74-b35b-2aead0f6bb80

	/// Texto para leitor de tela do dossiê da região.
	measure 'T05 · Tooltip região · ALT' =
			LEFT (
			    "Flávio na região " & [T05 · região da linha] & ", estado por estado: a parte de cada estado nos votos dele, "
			        & "o % dele em cada um e a mudança desde 2022.",
			    250
			)
		displayFolder: T05 Flávio\Desenho
		lineageTag: d2519116-b490-583d-9f4f-b65b641af1e6

	/// Dossiê da região da origem (ficha com clipe): os estados da região, do que mais deu votos a Flávio ao que menos — a parte de cada um nos votos dele na região, o % dele lá e a mudança desde 2022 —, com a nota à mão da maior mudança. Só lê contas.
	measure 'T05 · Tooltip região · HTML' =
			-- 1 · Leituras
			VAR _reg = [T05 · região da linha]
			VAR _mg = [T05 · margem na região]
			VAR _ufs =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" ),
			        "@nome", [T05 · UF da linha],
			        "@v", [T05 · votos],
			        "@s", [T05 · parte do estado na região],
			        "@p", [T05 · %],
			        "@d", [T05 · variação em p.p.]
			    )
			VAR _lista = FILTER ( _ufs, [@v] > 0 ) /* lista */
			VAR _n = COUNTROWS ( _lista ) /* lista */
			VAR _smax = MAXX ( _lista, [@s] ) /* lista */
			VAR _top = TOPN ( 1, _lista, ABS ( [@d] ), DESC, 'UF'[UF], ASC ) /* lista */
			VAR _topNome = MAXX ( _top, [@nome] ) /* lista */
			VAR _topD = MAXX ( _top, [@d] ) /* lista */
			-- 2 · Textos
			VAR _txtReg = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _reg, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _txtMg = "Flávio ficou " & FORMAT ( ABS ( _mg ), "0.0" ) & IF ( ABS ( _mg ) < 2, " ponto ", " pontos " )
			    & IF ( _mg >= 0, "à frente de Lula", "atrás de Lula" ) & " na região"
			VAR _nota = IF ( _topD < 0, "maior queda: ", "maior alta: " ) & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _topNome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
			VAR _clsNota = IF ( _topD < 0, "neutro", "flavio-esc" )
			-- 3 · Geometria (barra da parte em até 120 px; linhas de 26 px)
			VAR _h = IF ( _n > 7, 24, 27 ) -- geometria
			VAR _linhas =
			    CONCATENATEX (
			        _lista,
			        VAR _w = FORMAT ( DIVIDE ( [@s], _smax ) * 60, "0.0##", "en-US" ) -- geometria
			        RETURN
			            "<div class='ln' style='height:" & _h & "px'><span class='uf'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [@nome], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span>"
			                & "<span class='br'><i class='barra-x flavio-bg' style='width:" & _w & "px'></i><b>"
			                & FORMAT ( [@s], "0%" ) & "</b></span><span class='pc'>" & FORMAT ( [@p], "0.0%" ) & "</span>"
			                & "<span class='dd " & IF ( [@d] < 0, "neg", "pos" ) & "'>" & FORMAT ( [@d], "+0.0;−0.0;0.0" ) & "</span></div>",
			        "",
			        [@v], DESC
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _reg ) && _n > 0,
			        "<div class='tt3r'><div class='ficha'>"
			            & "<div class='cab sobe'><div class='nm flavio'>" & _txtReg & ", por estado</div>"
			            & "<div class='sub'>" & _txtMg & "</div></div>"
			            & "<div class='hd sobe d1'><span class='uf'>UF</span><span class='br'>peso</span>"
			            & "<span class='pc'>% dele</span><span class='dd'>vs. 2022</span></div>"
			            & "<div class='lista sobe d2'>" & _linhas & "</div>"
			            & "<div class='mao " & _clsNota & " entra d6'>" & _nota & "</div>"
			        & "</div></div>"
			    )
		displayFolder: T05 Flávio\Desenho
		lineageTag: a2af630a-646b-5405-abc7-f5a116715a9c

	/// Parcela dos aptos que faltaram em 2026, no recorte (0–1).
	measure 'T06 · abstenção %' =
			DIVIDE ( [T06 · abstenções], [T06 · aptos] )
		formatString: 0.0%
		displayFolder: T06 Ausência\Contas
		lineageTag: 866b18a2-95b0-57a9-884a-44f9167e727c

	/// Parcela dos aptos que faltaram no ano do contexto (0–1).
	measure 'T06 · abstenção % (ano)' =
			DIVIDE ( [T06 · abstenções (ano)], [T06 · aptos (ano)] )
		formatString: 0.0%
		displayFolder: T06 Ausência\Contas
		lineageTag: 3356d6c3-031b-55fa-b17d-9d9bab692718

	/// Parcela dos aptos que faltaram em 2006, no recorte (0–1).
	measure 'T06 · abstenção % 2006' =
			CALCULATE ( [T06 · abstenção % (ano)], 'Ano'[Ano] = 2006 )
		formatString: 0.0%
		displayFolder: T06 Ausência\Contas
		lineageTag: 9ed1f271-1257-525a-bdbb-175ec9451351

	/// Eleitores que faltaram no 1º turno de 2026, no recorte.
	measure 'T06 · abstenções' =
			CALCULATE ( [T06 · abstenções (ano)], 'Ano'[Ano] = 2026 )
		formatString: #,0
		displayFolder: T06 Ausência\Contas
		lineageTag: bc5ce2fc-cfc3-502a-a9f0-b5745a09c7f9

	/// Eleitores que faltaram no ano do contexto: Brasil oficial ('Comparecimento ano') sem filtro; soma dos municípios com o filtro de UF.
	measure 'T06 · abstenções (ano)' =
			IF ( [T06 · com UF] = 1, SUM ( 'Município ano'[Abstencoes] ), SUM ( 'Comparecimento ano'[Abstencoes] ) )
		formatString: #,0
		displayFolder: T06 Ausência\Contas
		lineageTag: 3e9b380a-911f-581a-b12b-45e286e68479

	/// Ano da linha (coluna da composição ou ponto da série).
	measure 'T06 · ano' =
