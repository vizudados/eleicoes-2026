	/// Posição da cidade entre as parecidas pela queda da margem (1 = a maior queda).
	measure 'T15 · parecidas · posição' =
			VAR _p = SELECTEDVALUE ( 'Município'[Porte] )
			VAR _q = SELECTEDVALUE ( 'Município'[Quinto de renda] )
			VAR _t =
			    CALCULATETABLE (
