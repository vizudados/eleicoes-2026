	/// Quem mediu a janela de seguidores ganhos do período (a primeira palavra do estudo: Bites, Quaest…). Só entra a janela que cabe inteira dentro do período escolhido (o dia do debate conta como depois); entre as que cabem, a mais longa (no empate, a mais recente). Vazio sem período ou sem janela que caiba.
	measure 'T09 · período · seguidores · fonte' =
			VAR _ini = [Período · início]
			VAR _fim = [Período · fim]
			VAR _jan =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( Monitoramento, Monitoramento[Estudo], Monitoramento[Métrica], Monitoramento[Início], Monitoramento[Fim] ),
			                REMOVEFILTERS ( Monitoramento ),
			                CONTAINSSTRING ( Monitoramento[Métrica], "seguidores ganhos" ),
			                NOT CONTAINSSTRING ( Monitoramento[Métrica], " - " ),
			                Monitoramento[Unidade] = "seguidores",
			                Monitoramento[Início] >= _ini,
			                Monitoramento[Fim] <= _fim
			            ),
			            "@dois",
			                CALCULATE (
			                    DISTINCTCOUNT ( Monitoramento[Candidato] ),
			                    REMOVEFILTERS ( Monitoramento[Candidato] ),
			                    Monitoramento[Candidato] IN { "Lula", "Flávio Bolsonaro" },
			                    NOT ISBLANK ( Monitoramento[Valor] )
			                ),
			            "@dur", DATEDIFF ( Monitoramento[Início], Monitoramento[Fim], DAY )
			        ),
			        [@dois] = 2
			    )
			VAR _top = TOPN ( 1, _jan, [@dur], DESC, Monitoramento[Início], DESC )
			RETURN
			    IF ( NOT ISBLANK ( _ini ), MAXX ( _top, LEFT ( Monitoramento[Estudo], FIND ( " ", Monitoramento[Estudo] & " " ) - 1 ) ) )
		displayFolder: T09 Redes\Contas
		lineageTag: 7aa74624-d1c0-5f15-9197-406343b34199

	/// Primeiro dia da janela de seguidores ganhos (os dois candidatos, total, não por dia nem rede a rede) usada no período escolhido. Só entra a janela que cabe inteira dentro do período escolhido (o dia do debate conta como depois); entre as que cabem, a mais longa (no empate, a mais recente). Vazio sem período ou sem janela que caiba.
	measure 'T09 · período · seguidores · início' =
			VAR _ini = [Período · início]
			VAR _fim = [Período · fim]
			VAR _jan =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( Monitoramento, Monitoramento[Estudo], Monitoramento[Métrica], Monitoramento[Início], Monitoramento[Fim] ),
			                REMOVEFILTERS ( Monitoramento ),
			                CONTAINSSTRING ( Monitoramento[Métrica], "seguidores ganhos" ),
			                NOT CONTAINSSTRING ( Monitoramento[Métrica], " - " ),
			                Monitoramento[Unidade] = "seguidores",
			                Monitoramento[Início] >= _ini,
			                Monitoramento[Fim] <= _fim
			            ),
			            "@dois",
			                CALCULATE (
			                    DISTINCTCOUNT ( Monitoramento[Candidato] ),
			                    REMOVEFILTERS ( Monitoramento[Candidato] ),
			                    Monitoramento[Candidato] IN { "Lula", "Flávio Bolsonaro" },
			                    NOT ISBLANK ( Monitoramento[Valor] )
			                ),
			            "@dur", DATEDIFF ( Monitoramento[Início], Monitoramento[Fim], DAY )
			        ),
			        [@dois] = 2
			    )
			VAR _top = TOPN ( 1, _jan, [@dur], DESC, Monitoramento[Início], DESC )
			RETURN
			    IF ( NOT ISBLANK ( _ini ), MAXX ( _top, Monitoramento[Início] ) )
		formatString: dd/MM
		displayFolder: T09 Redes\Contas
		lineageTag: 6c5909f8-35a1-5cc1-8c13-60c3b7021c1b

	/// A métrica da janela de seguidores ganhos do período (diz se é só o Instagram). Só entra a janela que cabe inteira dentro do período escolhido (o dia do debate conta como depois); entre as que cabem, a mais longa (no empate, a mais recente). Vazio sem período ou sem janela que caiba.
	measure 'T09 · período · seguidores · métrica' =
			VAR _ini = [Período · início]
			VAR _fim = [Período · fim]
			VAR _jan =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( Monitoramento, Monitoramento[Estudo], Monitoramento[Métrica], Monitoramento[Início], Monitoramento[Fim] ),
			                REMOVEFILTERS ( Monitoramento ),
			                CONTAINSSTRING ( Monitoramento[Métrica], "seguidores ganhos" ),
			                NOT CONTAINSSTRING ( Monitoramento[Métrica], " - " ),
			                Monitoramento[Unidade] = "seguidores",
			                Monitoramento[Início] >= _ini,
			                Monitoramento[Fim] <= _fim
			            ),
			            "@dois",
			                CALCULATE (
			                    DISTINCTCOUNT ( Monitoramento[Candidato] ),
			                    REMOVEFILTERS ( Monitoramento[Candidato] ),
			                    Monitoramento[Candidato] IN { "Lula", "Flávio Bolsonaro" },
			                    NOT ISBLANK ( Monitoramento[Valor] )
			                ),
			            "@dur", DATEDIFF ( Monitoramento[Início], Monitoramento[Fim], DAY )
			        ),
			        [@dois] = 2
			    )
			VAR _top = TOPN ( 1, _jan, [@dur], DESC, Monitoramento[Início], DESC )
			RETURN
			    IF ( NOT ISBLANK ( _ini ), MAXX ( _top, Monitoramento[Métrica] ) )
		displayFolder: T09 Redes\Contas
		lineageTag: 486421cf-5635-5346-a3d8-b2360ce1ad6a

	/// Seguidores ganhos de 05 a 17/10 nos perfis oficiais, segundo a Bites; no contexto do candidato.
	measure 'T09 · seguidores ganhos · 2º turno Bites' =
