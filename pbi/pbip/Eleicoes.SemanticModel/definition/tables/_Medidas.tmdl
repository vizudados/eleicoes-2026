	/// População do município quando ele trocou de lado (situação 2 ou 3); vazio nos outros. Ordena e recorta a lista das maiores que viraram (filtro Top 6 do visual).
	measure 'T11 · população das que viraram' =
			VAR _s = [T11 · situação]
			RETURN
			    IF ( _s = 2 || _s = 3, [T11 · população] )
		formatString: #,0
		displayFolder: T11 Virada\Contas
