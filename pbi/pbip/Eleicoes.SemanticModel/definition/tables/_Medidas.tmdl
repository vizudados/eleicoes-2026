	/// Onde a pesquisa da linha (grão Pesquisa[Id]) fica em relação ao período escolhido: dentro (campo inteiro na janela), atravessa (o campo pega o dia do debate de referência), em parte (só parte do campo na janela) ou fora; vazio sem período e fora das pesquisas de 2º turno.
	measure 'T17 · pesquisa · no período' =
			VAR _de = [T17 · período · campo de]
			VAR _ate = [T17 · período · campo até]
			VAR _deb = [Período · debate · data]
			VAR _mom = [T17 · pesquisa · momento]
			VAR _ini = SELECTEDVALUE ( Pesquisa[Campo início] )
			VAR _fim = SELECTEDVALUE ( Pesquisa[Campo fim] )
			RETURN
			    IF (
			        NOT ISBLANK ( _de ) && NOT ISBLANK ( _mom ),
			        SWITCH (
			            TRUE (),
			            _ini >= _de && _fim <= _ate, "dentro",
			            _ini <= _deb && _fim >= _deb, "atravessa",
			            _ini <= _ate && _fim >= _de, "em parte",
			            "fora"
			        )
			    )
		displayFolder: T17 2º turno\Contas
		lineageTag: f86c6907-5d77-5692-b982-73f309940d3a

	/// Posição (0, 1, 2…) da pesquisa entre as divulgadas no mesmo dia, pela ordem do Id; afasta os pontos que cairiam um sobre o outro.
	measure 'T17 · pesquisa · ordem no dia' =
			VAR _id = SELECTEDVALUE ( Pesquisa[Id] )
			VAR _dia = [T17 · pesquisa · divulgação]
			RETURN
			    IF (
			        NOT ISBLANK ( _dia ),
			        CALCULATE (
			            COUNTROWS ( Pesquisa ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Divulgação] = _dia,
			            Pesquisa[Id] < _id
			        ) + 0
			    )
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: 71b83d55-877b-51e4-a70a-37026f2dfa9a

