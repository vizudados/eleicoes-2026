		lineageTag: 2e35cc6c-f7bf-5d99-86ee-5f174521c562

	/// O dia clicado na curva (filtro cruzado de T08_Curva_Dias, grão 'Trends tempo'[DataTexto]); vazio sem clique e dentro da própria faixa dos dias (o dia está no grão).
	measure 'T08 · escolha · dia' =
			IF (
			    ISFILTERED ( 'Trends tempo'[DataTexto] )
			        && NOT ISINSCOPE ( 'Trends tempo'[DataTexto] )
			        && HASONEVALUE ( 'Trends tempo'[DataTexto] ),
			    [T08 · dia · data]
			)
		formatString: dd/MM
		displayFolder: T08 Buscas\Contas
		lineageTag: 631f723a-df3e-5119-8140-6366d79dcb00

	/// A sigla da UF clicada no mapa (filtro cruzado de T08_Mapa_Ufs, grão UF[UF]); vazia sem clique e dentro do próprio mapa. Vale em qualquer período (o interesse do 2º turno diz que a UF tem dado; a parte de cada um pode faltar no período sem dado).
	measure 'T08 · escolha · UF' =
			IF (
			    ISFILTERED ( UF[UF] ) && NOT ISINSCOPE ( UF[UF] ) && HASONEVALUE ( UF[UF] ) && NOT ISBLANK ( [T08 · UF · interesse médio] ),
			    SELECTEDVALUE ( UF[UF] )
			)
		displayFolder: T08 Buscas\Contas
		lineageTag: 5e7aee82-ecad-528f-8cd7-cfc2adbf593e

	/// Índice por hora (0–100 dentro da semana da consulta H1 ou H2) de Flávio na hora da linha ('Trends tempo'[DataTexto] = 'aaaa-mm-dd hh:mm').
	measure 'T08 · hora · Flávio' =
			CALCULATE (
			    MAX ( 'Trends tempo'[Índice] ),
			    'Trends tempo'[Série] IN { "Flávio Bolsonaro [tópico | H1]", "Flávio Bolsonaro [tópico | H2]" }
			)
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 047620c6-2e46-5202-8207-23761abf3921

	/// Índice por hora (0–100 dentro da semana da consulta H1 ou H2) de Lula na hora da linha ('Trends tempo'[DataTexto] = 'aaaa-mm-dd hh:mm').
	measure 'T08 · hora · Lula' =
			CALCULATE (
			    MAX ( 'Trends tempo'[Índice] ),
			    'Trends tempo'[Série] IN { "Lula [tópico | H1]", "Lula [tópico | H2]" }
			)
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: 1372c54f-e452-5b8c-9181-3127c7fdf062

	/// Nota da lacuna de 19 a 21/09 no estado clicado (zeros marcados na Observação da consulta U2): 'provável falha de coleta do Google' ou, em AC, AP e RR, 'pouca busca ou falha do Google' (não dá para separar); vazio sem lacuna e no Brasil.
	measure 'T08 · lacuna · nota' =
			VAR _uf = [T08 · escolha · UF]
			VAR _obs =
			    IF (
			        NOT ISBLANK ( _uf ),
			        CALCULATE (
			            CONCATENATEX ( VALUES ( 'Trends UF tempo'[Observação] ), 'Trends UF tempo'[Observação], " | " ),
			            'Trends UF tempo'[UF] = _uf,
			            CONTAINSSTRING ( 'Trends UF tempo'[Observação], "19-21/09" )
			        )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _obs ) || _obs = "", BLANK (),
			        CONTAINSSTRING ( _obs, "não dá para separar" ), "pouca busca ou falha do Google",
			        "provável falha de coleta do Google"
			    )
		displayFolder: T08 Buscas\Contas
		lineageTag: ce5314c7-ec28-507b-86dd-0d5128c71d31

	/// Posição de 'Quando vai ser o segundo turno?' na lista das perguntas mais buscadas de 05 a 08/10 (Google Trends obtido pelo Estadão). Constante: trends_consultas.csv (fora do modelo).
	measure 'T08 · pergunta · quando vai ser o segundo turno · posição' =
			2
		formatString: 0
		displayFolder: T08 Buscas\Contas
		lineageTag: ea975921-5e43-52fe-8a71-29e9ba620ed1

	/// Alta das buscas por 'Que horas começa a votação eleitoral?' na semana até 01/10, contra a semana anterior (Google ao UOL, via Olhar Digital). Constante: dados/bruto/digital/trends_consultas.csv (fora do modelo).
	measure 'T08 · pergunta · que horas começa a votação · alta' =
			5.5
		formatString: 0%
