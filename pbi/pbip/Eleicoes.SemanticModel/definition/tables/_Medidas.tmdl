	/// Eleitores que faltaram ÷ aptos, 1º turno de 2026, no contexto.
	measure 'T19 · abstenção 2026' =
			DIVIDE (
			    CALCULATE ( SUM ( 'Município ano'[Abstencoes] ), 'Município ano'[Ano] = 2026 ),
			    CALCULATE ( SUM ( 'Município ano'[Aptos] ), 'Município ano'[Ano] = 2026 )
			)
		formatString: 0.0%
		displayFolder: T19 Explorador\Contas
		lineageTag: da76d62a-c8f0-5515-8eeb-b2d359190bb3

	/// Em quantas das seis eleições (2006–2026) o PT ficou à frente no contexto (dossiê do município).
	measure 'T19 · eleições com o PT à frente' =
			COALESCE (
			    COUNTROWS (
			        FILTER (
			            VALUES ( 'Ano'[Ano] ),
			            CALCULATE (
			                SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] )
			            ) > 0
			        )
			    ),
			    0
			)
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: 1c222d59-8bb2-5873-99cb-4e6411aca919

	/// Em quantas das seis eleições (2006–2026) há votos no contexto (o município pode ter sido criado depois de 2006).
	measure 'T19 · eleições com voto' =
			COALESCE (
			    COUNTROWS (
			        FILTER ( VALUES ( 'Ano'[Ano] ), CALCULATE ( SUM ( 'Município ano'[Validos] ) ) > 0 )
			    ),
			    0
			)
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: 88b744f2-9347-5372-8eee-a95516e14073

	/// O filtro do recorte em poucas palavras, para a pílula: um pedaço por grupo com escolha, na ordem da árvore ('Nordeste · até 10 mil hab.'; 'MG · Virou para Flávio'); o lugar vem resumido de cima para baixo ([T19 · filtro · lugar]: regiões inteiras, estados inteiros, cidades soltas); com vários itens nos outros grupos, a contagem ('2 faixas de renda'). Vazio sem filtro.
	measure 'T19 · filtro em uso' =
			-- 1 · Escolhas por grupo (RaizOrdem: 1 o lugar, 2 Tamanho da cidade, 3 Renda, 4 Virou?)
			VAR _f = ISFILTERED ( 'T19 Filtro'[Caminho] )
			VAR _t2 =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Valor], 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
			        'T19 Filtro'[RaizOrdem] = 2
			    )
			VAR _t3 =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Valor], 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
			        'T19 Filtro'[RaizOrdem] = 3
			    )
			VAR _t4 =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Valor], 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
			        'T19 Filtro'[RaizOrdem] = 4
			    )
			VAR _n2 = IF ( _f, COUNTROWS ( _t2 ), 0 )
			VAR _n3 = IF ( _f, COUNTROWS ( _t3 ), 0 )
			VAR _n4 = IF ( _f, COUNTROWS ( _t4 ), 0 )
			-- 2 · Um pedaço por grupo: o valor quando é um só; a contagem quando são vários
			VAR _p1 = [T19 · filtro · lugar]
			VAR _p2 =
			    SWITCH (
			        TRUE (),
			        _n2 = 1, CONCATENATEX ( _t2, 'T19 Filtro'[Valor], ", " ) & " hab.",
			        _n2 > 1, _n2 & " tamanhos de cidade"
			    )
			VAR _p3 =
			    SWITCH (
			        TRUE (),
			        _n3 = 1, "renda: " & CONCATENATEX ( _t3, 'T19 Filtro'[Curto], ", " ),
			        _n3 > 1, _n3 & " faixas de renda"
			    )
			VAR _p4 =
			    SWITCH (
			        TRUE (),
			        _n4 = 1, CONCATENATEX ( _t4, 'T19 Filtro'[Valor], ", " ),
			        _n4 > 1, _n4 & " situações"
			    )
			VAR _partes = { ( 1, _p1 ), ( 2, _p2 ), ( 3, _p3 ), ( 4, _p4 ) }
			RETURN
			    CONCATENATEX ( FILTER ( _partes, NOT ISBLANK ( [Value2] ) ), [Value2], " · ", [Value1], ASC )
		displayFolder: T19 Explorador\Contas
		lineageTag: 116a0e0f-2cc5-5ceb-9bb3-858606a8e6fe

	/// Quantos grupos do filtro do recorte têm escolha (o lugar, tamanho, renda, virou); 0 sem filtro. A pílula usa para o ponto vermelho e para "N filtros" quando o texto não cabe (no lugar, marcar uma região marca centenas de cidades: contar os itens marcados não diria nada ao leitor).
	measure 'T19 · filtro · escolhas' =
			IF (
			    ISFILTERED ( 'T19 Filtro'[Caminho] ),
			    DISTINCTCOUNT ( 'T19 Filtro'[RaizOrdem] ),
			    0
			)
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: a56f2bd9-2843-5299-9d95-bbae0e83b9fe

	/// O lugar escolhido no filtro, em poucas palavras. A árvore filtra sempre no último nível (a cidade): marcar uma região ou um estado marca as cidades de dentro. Aqui a escolha volta a ser lida de cima para baixo: as regiões inteiras pelo nome ("Nordeste"), os estados inteiros fora delas pela sigla ("MG"), e as cidades soltas pelo nome (até duas) ou pela contagem ("3 cidades"). Vazio sem escolha no lugar.
	measure 'T19 · filtro · lugar' =
			-- 1 · As cidades escolhidas (folhas do lugar) e todas as do lugar
			VAR _f = ISFILTERED ( 'T19 Filtro'[Caminho] )
			VAR _sel =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Regiao], 'T19 Filtro'[UF], 'T19 Filtro'[Valor], 'T19 Filtro'[Ordem] ),
			        'T19 Filtro'[RaizOrdem] = 1
			    )
			VAR _tot =
			    CALCULATETABLE (
			        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Regiao], 'T19 Filtro'[UF], 'T19 Filtro'[Valor] ),
			        REMOVEFILTERS ( 'T19 Filtro' ),
			        'T19 Filtro'[RaizOrdem] = 1
			    )
			VAR _nSel = IF ( _f, COUNTROWS ( _sel ), 0 )
			-- 2 · Regiões inteiras
			VAR _regioes =
			    ADDCOLUMNS (
			        DISTINCT ( SELECTCOLUMNS ( _sel, "@r", 'T19 Filtro'[Regiao] ) ),
			        "@s", COUNTROWS ( FILTER ( _sel, 'T19 Filtro'[Regiao] = [@r] ) ),
			        "@t", COUNTROWS ( FILTER ( _tot, 'T19 Filtro'[Regiao] = [@r] ) ),
			        "@o", MINX ( FILTER ( _sel, 'T19 Filtro'[Regiao] = [@r] ), 'T19 Filtro'[Ordem] )
			    )
			VAR _cheias = FILTER ( _regioes, [@s] = [@t] )
			VAR _nomesCheias = SELECTCOLUMNS ( _cheias, "@r", [@r] )
			-- 3 · Estados inteiros fora das regiões inteiras
			VAR _resto = FILTER ( _sel, NOT ( 'T19 Filtro'[Regiao] IN _nomesCheias ) )
			VAR _ufs =
			    ADDCOLUMNS (
			        DISTINCT ( SELECTCOLUMNS ( _resto, "@u", 'T19 Filtro'[UF] ) ),
			        "@s", COUNTROWS ( FILTER ( _resto, 'T19 Filtro'[UF] = [@u] ) ),
			        "@t", COUNTROWS ( FILTER ( _tot, 'T19 Filtro'[UF] = [@u] ) ),
			        "@o", MINX ( FILTER ( _resto, 'T19 Filtro'[UF] = [@u] ), 'T19 Filtro'[Ordem] )
			    )
			VAR _ufCheias = FILTER ( _ufs, [@s] = [@t] )
			VAR _siglasCheias = SELECTCOLUMNS ( _ufCheias, "@u", [@u] )
			-- 4 · Cidades soltas
			VAR _cidades = FILTER ( _resto, NOT ( 'T19 Filtro'[UF] IN _siglasCheias ) )
			VAR _nR = COUNTROWS ( _cheias ) + 0
			VAR _nU = COUNTROWS ( _ufCheias ) + 0
			VAR _nC = COUNTROWS ( _cidades ) + 0
			VAR _tR =
			    IF (
			        _nR > 0,
			        IF ( _nR <= 3, CONCATENATEX ( _cheias, [@r], ", ", [@o], ASC ), _nR & " regiões" )
			    )
			VAR _tU =
			    IF (
			        _nU > 0,
			        IF ( _nU <= 4, CONCATENATEX ( _ufCheias, [@u], ", ", [@o], ASC ), _nU & " estados" )
			    )
			VAR _tC =
			    IF (
			        _nC > 0,
			        IF (
			            _nC <= 2,
			            CONCATENATEX ( _cidades, 'T19 Filtro'[Valor], ", ", 'T19 Filtro'[Ordem], ASC ),
			            FORMAT ( _nC, "#,0" ) & " cidades"
			        )
			    )
			VAR _partes = { ( 1, _tR ), ( 2, _tU ), ( 3, _tC ) }
			RETURN
			    IF (
			        _nSel > 0,
			        CONCATENATEX ( FILTER ( _partes, NOT ISBLANK ( [Value2] ) ), [Value2], ", ", [Value1], ASC )
			    )
		displayFolder: T19 Explorador\Contas
		lineageTag: 32239d0c-fc75-5ca5-b942-d0adefd42e1a

	/// Ordem do caminho no acordeão do filtro (papel itemSort do VizuFilter: a raiz vai pela menor ordem das suas linhas, de Região a Cidade).
	measure 'T19 · filtro · ordem' =
			MIN ( 'T19 Filtro'[Ordem] )
		formatString: 0
		displayFolder: T19 Explorador\Contas
		lineageTag: 1a2c95a4-004d-5f9d-8c5c-eccc3cff3580

