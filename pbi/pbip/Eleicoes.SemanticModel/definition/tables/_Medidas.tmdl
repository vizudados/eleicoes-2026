	/// Id do local clicado no mapa ou na lista (filtro cruzado em T20 Local), se for da cidade da tela; vazio sem clique.
	measure 'T20 · escola clicada' =
			VAR _cod = [T20 · cidade (código)]
			RETURN
			    IF (
			        ( ISFILTERED ( 'T20 Local'[Local] ) || ISFILTERED ( 'T20 Local'[Id] ) )
			            && HASONEVALUE ( 'T20 Local'[Id] )
			            && SELECTEDVALUE ( 'T20 Local'[CodIBGE] ) = _cod,
			        SELECTEDVALUE ( 'T20 Local'[Id] )
			    )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: f8fc2c8e-ce60-5e73-a2b8-afeea401fdf2

	/// Id da escola escolhida no filtro: quando há exatamente uma folha marcada e ela não é a cidade inteira; vazio com a cidade inteira, com várias escolas ou sem escolha.
	measure 'T20 · escola do filtro' =
			VAR _n = [T20 · escolas no filtro]
			RETURN
			    IF ( _n = 1 && [T20 · locais] > 1, SELECTEDVALUE ( 'T20 Filtro'[IdLocal] ) )
		formatString: 0
		displayFolder: T20 Escola\Contas
		lineageTag: 423a014c-9783-5650-90f2-23e32ab6eb0b

	/// Escolas (folhas) marcadas no filtro; 0 sem escolha. Igual a [T20 · locais] quando a cidade inteira foi marcada.
	measure 'T20 · escolas no filtro' =
			IF ( ISFILTERED ( 'T20 Filtro' ), COUNTROWS ( VALUES ( 'T20 Filtro'[Caminho] ) ), 0 )
		formatString: #,0
		displayFolder: T20 Escola\Contas
		lineageTag: e1b71af6-0b2a-55a1-a2b1-5416a875187d

	/// Por que o exemplo da ficha: começo (Contagem), virou ou queda.
	measure 'T20 · exemplo' =
