			        'Município ano'[Ano] = 2026,
			        TREATAS ( _m, 'Município'[CodIBGE] )
			    )
		formatString: #,0
		displayFolder: T24 Quem vota\Contas
		lineageTag: 535b70cf-41b0-516f-85a2-dfb884f15a3e

	/// Texto alternativo da manchete da lente.
	measure 'T24 · Fundo · ALT' =
			VAR _l = [T24 · lente]
			RETURN
			    "Lente " & _l & ": no 1º degrau, Lula " & FORMAT ( [T24 · Lula % 2026 · degrau 1], "0.0%" ) & " e Flávio "
			        & FORMAT ( [T24 · Flávio % 2026 · degrau 1], "0.0%" ) & "; no 5º, Lula " & FORMAT ( [T24 · Lula % 2026 · degrau 5], "0.0%" )
			        & " e Flávio " & FORMAT ( [T24 · Flávio % 2026 · degrau 5], "0.0%" ) & "."
		displayFolder: T24 Quem vota\Desenho
		lineageTag: df53fae0-59e9-5a73-b7f8-693db5a3a37c

	/// Manchete da lente (quem lidera em cada ponta, com o %), o que mede o indicador, a grade de % do gráfico e o eixo de menos a mais.
	measure 'T24 · Fundo · HTML' =
			-- 1 · Leituras
			VAR _l = [T24 · lente]
			VAR _l1 = [T24 · Lula % 2026 · degrau 1]
			VAR _l5 = [T24 · Lula % 2026 · degrau 5]
			VAR _f1 = [T24 · Flávio % 2026 · degrau 1]
			VAR _f5 = [T24 · Flávio % 2026 · degrau 5]
			-- 2 · Textos
			VAR _baixo =
			    SWITCH ( _l,
			        "Renda", "Nas cidades de renda mais baixa",
			        "Escolaridade", "Onde menos eleitores terminaram o ensino médio",
			        "Bolsa Família", "Onde menos casas recebem Bolsa Família",
			        "Nas cidades de IDH mais baixo" )
			VAR _alto =
			    SWITCH ( _l,
			        "Renda", "Nas cidades de renda mais alta",
			        "Escolaridade", "Onde mais eleitores terminaram o ensino médio",
			        "Bolsa Família", "Onde mais casas recebem Bolsa Família",
			        "Nas cidades de IDH mais alto" )
			VAR _lulaEmBaixo = _l1 >= _l5
			VAR _pontaLula = IF ( _lulaEmBaixo, _baixo, _alto )
			VAR _pontaFlavio = IF ( _lulaEmBaixo, _alto, _baixo )
			VAR _pctLula = IF ( _lulaEmBaixo, _l1, _l5 )
			VAR _pctFlavio = IF ( _lulaEmBaixo, _f5, _f1 )
			VAR _mede =
			    SWITCH ( _l,
			        "Renda", "Renda: quanto entra por mês, por pessoa, na casa (média da cidade, Censo 2022).",
			        "Escolaridade", "Escolaridade: quantos eleitores da cidade têm pelo menos o ensino médio completo (TSE, 2026).",
			        "Bolsa Família", "Bolsa Família: famílias pagas em agosto de 2026 para cada 100 casas da cidade (Censo 2022).",
			        "IDH: a nota da cidade de 0 a 1 em renda, escola e saúde (IDHM 2010, o último por município)." )
			VAR _eixo =
			    SWITCH ( _l,
			        "Renda", "menos renda", "Escolaridade", "menos escolaridade", "Bolsa Família", "menos Bolsa Família",
			        "IDH menor" )
			VAR _eixo2 =
			    SWITCH ( _l,
			        "Renda", "mais renda", "Escolaridade", "mais escolaridade", "Bolsa Família", "mais Bolsa Família",
			        "IDH maior" )
			-- 3 · Grade (% de 30 a 60; 50% tracejado)
			VAR _grade =
			    CONCATENATEX (
			        GENERATESERIES ( 3, 6, 1 ),
			        VAR _p = [Value] / 10
			        VAR _y = 106 + ( 520 - ( MAX ( 0.2, MIN ( 0.7, _p ) ) - 0.2 ) * 960 )
			        RETURN
			            "<i class='g" & IF ( [Value] = 5, " meio", "" ) & "' style='top:" & FORMAT ( _y, "0.0", "en-US" ) & "px'></i>"
			                & "<span class='gy' style='top:" & FORMAT ( _y - 9, "0.0", "en-US" ) & "px'>" & [Value] * 10 & "%</span>",
			        "", [Value], ASC
			    )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t24f'>"
			        & "<div class='man sobe'>" & _pontaLula & ", <b class='lula'>Lula teve " & FORMAT ( _pctLula * 100, "0" )
			        & "%</b>. " & _pontaFlavio & ", <b class='flavio'>Flávio teve " & FORMAT ( _pctFlavio * 100, "0" )
			        & "%</b>.</div>"
			        & "<div class='mede nota entra d3'>" & _mede & "</div>"
			        & _grade
			        & "<div class='eixo rot entra d10'><span>← " & _eixo & "</span><span>CADA DEGRAU: UM QUINTO DOS ELEITORES</span>"
			        & "<span>" & _eixo2 & " →</span></div>"
			    & "</div>"
		displayFolder: T24 Quem vota\Desenho
		lineageTag: 4b4d3495-0ad9-54c7-8475-22051afb358d

	/// Texto alternativo do gráfico dos degraus.
	measure 'T24 · Gráfico · ALT' =
			"Gráfico da lente " & [T24 · lente] & ": cinco degraus de eleitores, de menos a mais; Lula começa com "
			    & FORMAT ( [T24 · Lula % 2026 · degrau 1], "0.0%" ) & " e termina com " & FORMAT ( [T24 · Lula % 2026 · degrau 5], "0.0%" )
			    & "; Flávio vai de " & FORMAT ( [T24 · Flávio % 2026 · degrau 1], "0.0%" ) & " a "
			    & FORMAT ( [T24 · Flávio % 2026 · degrau 5], "0.0%" ) & ". Passe o mouse num degrau para ver 2022 e as cidades."
		displayFolder: T24 Quem vota\Desenho
		lineageTag: 266c8037-44cf-5885-aac1-ec594c3aa0b0

	/// Um degrau por entrada (granularidade T24 Degrau): a coluna que pega o mouse, os pontos de Lula e Flávio com o %, o traço a caneta até o degrau seguinte, a nota onde a vantagem troca de lado e a faixa do indicador embaixo.
	measure 'T24 · Gráfico · HTML' =
			-- 1 · Leituras
			VAR _d = [T24 · degrau]
			VAR _l = [T24 · lente]
			VAR _lu = [T24 · Lula % 2026]
			VAR _fl = [T24 · Flávio % 2026]
			VAR _lu2 = [T24 · Lula % 2026 · degrau seguinte]
			VAR _fl2 = [T24 · Flávio % 2026 · degrau seguinte]
			VAR _vmin = [T24 · valor mínimo]
			VAR _vmax = [T24 · valor máximo]
			-- 2 · Textos (a faixa do indicador no degrau)
			VAR _fmt =
			    SWITCH ( _l, "Renda", "#,0", "Escolaridade", "0", "Bolsa Família", "0", "0.000" )
			VAR _k = IF ( _l = "Escolaridade", 100, 1 )
			VAR _a = FORMAT ( _vmin * _k, _fmt )
			VAR _b = FORMAT ( _vmax * _k, _fmt )
			-- nas pontas, só o limite de dentro: o extremo de fora é uma cidade só (há cidade com mais famílias que casas)
			VAR _pre = SWITCH ( _l, "Renda", "R$ ", "IDH", "IDHM ", "" )
			VAR _pos = SWITCH ( _l, "Escolaridade", "%", "Bolsa Família", " por 100 casas", "" )
			VAR _faixa =
			    SWITCH ( _d,
			        1, "até " & _pre & _b & _pos,
			        5, "mais de " & _pre & _a & _pos,
			        _pre & _a & IF ( _l = "Escolaridade", "%", "" ) & " a " & _b & _pos )
			-- 3 · Geometria
			VAR _x = 130 + ( _d - 1 ) * 180
			VAR _yl = ( 520 - ( MAX ( 0.2, MIN ( 0.7, _lu ) ) - 0.2 ) * 960 )
			VAR _yf = ( 520 - ( MAX ( 0.2, MIN ( 0.7, _fl ) ) - 0.2 ) * 960 )
			VAR _temSeg = NOT ISBLANK ( _lu2 )
			VAR _x2 = _x + 180
			VAR _yl2 = ( 520 - ( MAX ( 0.2, MIN ( 0.7, _lu2 ) ) - 0.2 ) * 960 )
			VAR _yf2 = ( 520 - ( MAX ( 0.2, MIN ( 0.7, _fl2 ) ) - 0.2 ) * 960 )
			VAR _luCima = _lu >= _fl
			VAR _a1 = _lu - _fl
			VAR _a2 = _lu2 - _fl2
			VAR _cruza = _temSeg && ( ( _a1 > 0 && _a2 < 0 ) || ( _a1 < 0 && _a2 > 0 ) )
			VAR _t = DIVIDE ( _a1, _a1 - _a2 )
			VAR _xc = _x + _t * 180
			VAR _yc = _yl + _t * ( _yl2 - _yl )
			VAR _atraso = 300 + _d * 260
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _d ) && NOT ISBLANK ( _lu ),
			        "<div class='tela t24g'>"
			            & "<div class='banda entra' style='left:" & ( _x - 86 ) & "px;animation-delay:" & ( _d * 80 )
			            & "ms'></div>"
			            & "<svg class='sv' width='940' height='684' viewBox='0 0 940 684'>"
			            & IF (
			                _temSeg,
			                "<line class='traco ll' pathLength='1' filter='url(#rb24)' style='animation-delay:" & _atraso
			                    & "ms' x1='" & _x & "' y1='" & FORMAT ( _yl, "0.0", "en-US" ) & "' x2='" & _x2 & "' y2='" & FORMAT ( _yl2, "0.0", "en-US" ) & "'/>"
			                    & "<line class='traco lf' pathLength='1' filter='url(#rb24)' style='animation-delay:" & _atraso
			                    & "ms' x1='" & _x & "' y1='" & FORMAT ( _yf, "0.0", "en-US" ) & "' x2='" & _x2 & "' y2='" & FORMAT ( _yf2, "0.0", "en-US" ) & "'/>"
			            )
			            & "<circle class='brota pl' style='animation-delay:" & ( _atraso - 150 ) & "ms' cx='" & _x & "' cy='"
			            & FORMAT ( _yl, "0.0", "en-US" ) & "' r='8'/>"
			            & "<circle class='brota pf' style='animation-delay:" & ( _atraso - 150 ) & "ms' cx='" & _x & "' cy='"
			            & FORMAT ( _yf, "0.0", "en-US" ) & "' r='8'/>"
			            & IF (
			                _cruza,
			                "<ellipse class='traco cz' pathLength='1' filter='url(#rb24)' style='animation-delay:"
			                    & ( _atraso + 700 ) & "ms' cx='" & FORMAT ( _xc, "0.0", "en-US" ) & "' cy='" & FORMAT ( _yc, "0.0", "en-US" ) & "' rx='18' ry='14'/>"
			            )
			            & "</svg>"
			            & "<span class='vl lula-esc sobe' style='left:" & ( _x - 50 ) & "px;top:"
			            & FORMAT ( IF ( _luCima, _yl - 44, _yl + 14 ), "0.0", "en-US" ) & "px;animation-delay:" & ( _atraso + 100 ) & "ms'>"
			            & FORMAT ( _lu * 100, "0.0" ) & "%</span>"
			            & "<span class='vl flavio-esc sobe' style='left:" & ( _x - 50 ) & "px;top:"
			            & FORMAT ( IF ( _luCima, _yf + 14, _yf - 44 ), "0.0", "en-US" ) & "px;animation-delay:" & ( _atraso + 100 ) & "ms'>"
			            & FORMAT ( _fl * 100, "0.0" ) & "%</span>"
			            & IF (
			                _cruza,
			                "<span class='cruz mao entra' style='left:" & ( IF ( _t < 0.5, _x, _x2 ) - 86 )
			                    & "px;animation-delay:" & ( _atraso + 900 ) & "ms'>aqui troca de lado</span>"
			            )
			            & "<div class='pe' style='left:" & ( _x - 86 ) & "px'><b>" & _d & "º QUINTO</b><span>" & _faixa
			            & "</span></div>"
			        & "</div>"
			    )
		displayFolder: T24 Quem vota\Desenho
		lineageTag: f232f75f-056a-5f95-95a5-3bdb7f8b318e

	/// Texto alternativo das abas.
	measure 'T24 · Lentes · ALT' =
			"Lentes: Renda, Escolaridade, Bolsa Família e IDH; marcada: " & [T24 · lente] & "."
		displayFolder: T24 Quem vota\Desenho
		lineageTag: 46fc87c1-bb4a-5dcd-9a25-2781b9b659f8

	/// As quatro abas das lentes, com a escolhida marcada (os botões nativos ficam por cima, invisíveis).
	measure 'T24 · Lentes · HTML' =
			VAR _l = [T24 · lente]
			RETURN
			    "<div class='tela t24l'>"
			        & CONCATENATEX (
			            ALL ( 'T24 Lente' ),
			            "<div class='ab" & IF ( 'T24 Lente'[Lente] = _l, " on", "" ) & " entra d" & 'T24 Lente'[Ordem] & "'>"
			                & 'T24 Lente'[Lente] & "</div>",
			            "", 'T24 Lente'[Ordem], ASC
			        )
			    & "</div>"
		displayFolder: T24 Quem vota\Desenho
		lineageTag: 29eb78cd-fc4c-50e3-b520-dd590fc58d24

	/// Texto alternativo do cartão das pesquisas.
	measure 'T24 · Pesquisa · ALT' =
			VAR _i = [T24 · instituto]
			RETURN
			    IF (
			        ISBLANK ( _i ),
			        "Nesta lente não há pesquisa: o IDH é uma nota do lugar. O voto é secreto; o gráfico mostra os lugares.",
			        "Pesquisa " & _i & " na lente " & [T24 · lente] & ": intenção de voto de Lula e Flávio em cada faixa. O voto é "
			            & "secreto; o gráfico mostra os lugares."
			    )
		displayFolder: T24 Quem vota\Desenho
		lineageTag: f4266e52-4759-5f0b-9ec0-43d4ad1c6cf4

	/// Cartão das pessoas: em cada faixa da lente, a vantagem na pesquisa (barra que sai do centro: à direita, Lula à frente; à esquerda, Flávio), os dois % e o tamanho do grupo; a marca tracejada é a vantagem entre todos os eleitores, e a nota marca a faixa em que a vantagem troca de lado. No IDH, por que não há pesquisa e as pontas da régua. A nota do voto secreto é fixa (corpo do visual).
	measure 'T24 · Pesquisa · HTML' =
			-- 1 · Leituras
			VAR _l = [T24 · lente]
			VAR _i = [T24 · instituto]
			VAR _campo = [T24 · pesquisa data]
			VAR _lt = [T24 · pesquisa Lula % total]
			VAR _ft = [T24 · pesquisa Flávio % total]
			VAR _cats =
			    CALCULATETABLE (
			        SUMMARIZE ( 'Perfil pesquisa', 'Perfil pesquisa'[Categoria], 'Perfil pesquisa'[CategoriaOrdem] ),
			        'Perfil pesquisa'[Lente] = _l,
			        'Perfil pesquisa'[Instituto] = _i
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _cats,
			        "@l", [T24 · pesquisa Lula %],
			        "@f", [T24 · pesquisa Flávio %],
			        "@s", [T24 · pesquisa fatia]
			    )
			VAR _t2 =
			    ADDCOLUMNS (
			        _t,
			        "@v", ( [@l] - [@f] ) * 100,
			        "@vAnt",
			            VAR _o = 'Perfil pesquisa'[CategoriaOrdem]
			            RETURN MAXX ( FILTER ( _t, 'Perfil pesquisa'[CategoriaOrdem] = _o - 1 ), ( [@l] - [@f] ) * 100 )
			    )
			-- 2 · Geometria: o centro da régua em 195 px da coluna do gráfico; 40 pontos de vantagem = 160 px
			VAR _ref = ( _lt - _ft ) * 100
			VAR _xRef = 195 + MAX ( -40, MIN ( 40, _ref ) ) / 40 * 160
			VAR _linhas =
			    CONCATENATEX (
			        _t2,
			        VAR _v = [@v]
			        VAR _w = MIN ( ABS ( _v ), 40 ) / 40 * 160
			        VAR _x = IF ( _v >= 0, 195, 195 - _w )
			        VAR _troca = NOT ISBLANK ( [@vAnt] ) && SIGN ( [@vAnt] ) <> SIGN ( _v ) && _v <> 0
			        RETURN
			            "<div class='lin sobe d" & ( 'Perfil pesquisa'[CategoriaOrdem] + 3 ) & "'><div class='cat'><b>"
			                & 'Perfil pesquisa'[Categoria] & "</b>"
			                & IF ( NOT ISBLANK ( [@s] ), "<i>" & FORMAT ( [@s], "0%" ) & " dos entrevistados</i>" )
			                & "</div><div class='gr'><i class='ref' style='left:" & FORMAT ( _xRef, "0.0", "en-US" ) & "px'></i>"
			                & "<i class='ct'></i><i class='vb " & IF ( _v >= 0, "bl", "bf" ) & " " & IF ( _v >= 0, "barra-x", "barra-x-dir" )
			                & "' style='left:" & FORMAT ( _x, "0.0", "en-US" ) & "px;width:" & FORMAT ( _w, "0.0", "en-US" ) & "px'></i>"
			                & "<span class='vt " & IF ( _v >= 0, "lula-esc", "flavio-esc" ) & "' style='"
			                & IF ( _v >= 0, "left:" & FORMAT ( 195 + _w + 8, "0.0", "en-US" ) & "px",
			                    "right:" & FORMAT ( 390 - ( 195 - _w ) + 8, "0.0", "en-US" ) & "px" ) & "'>"
			                & IF ( _v >= 0, "Lula +", "Flávio +" ) & FORMAT ( ABS ( _v ), "0" ) & "</span>"
			                & "<span class='pp'><span class='lula-esc'>" & FORMAT ( [@l] * 100, "0" ) & "%</span> × "
			                & "<span class='flavio-esc'>" & FORMAT ( [@f] * 100, "0" ) & "%</span></span>"
			                & IF ( _troca, "<span class='tr mao'>troca de lado</span>" )
			                & "</div></div>",
			        "", 'Perfil pesquisa'[CategoriaOrdem], ASC
			    )
			VAR _total =
			    "<div class='lin tot sobe d9'><div class='cat'><b>todos os eleitores</b><i>a marca tracejada</i></div>"
			        & "<div class='gr'><i class='ct'></i><i class='vb " & IF ( _ref >= 0, "bl", "bf" ) & "' style='left:"
			        & FORMAT ( IF ( _ref >= 0, 195, 195 - MIN ( ABS ( _ref ), 40 ) / 40 * 160 ), "0.0", "en-US" ) & "px;width:"
			        & FORMAT ( MIN ( ABS ( _ref ), 40 ) / 40 * 160, "0.0", "en-US" ) & "px'></i>"
			        & "<span class='vt " & IF ( _ref >= 0, "lula-esc", "flavio-esc" ) & "' style='left:"
			        & FORMAT ( 195 + IF ( _ref >= 0, MIN ( ABS ( _ref ), 40 ) / 40 * 160, 0 ) + 8, "0.0", "en-US" ) & "px'>"
			        & IF ( _ref >= 0, "Lula +", "Flávio +" ) & FORMAT ( ABS ( _ref ), "0" ) & "</span>"
			        & "<span class='pp'><span class='lula-esc'>" & FORMAT ( _lt * 100, "0" ) & "%</span> × <span class='flavio-esc'>"
			        & FORMAT ( _ft * 100, "0" ) & "%</span></span></div></div>"
			VAR _pergunta =
			    SWITCH ( _l,
			        "Renda", "por renda da família",
			        "Escolaridade", "por escolaridade",
			        "Bolsa Família", "entre quem recebe e quem não recebe Bolsa Família",
			        "" )
			VAR _notaBF =
			    IF ( _l = "Bolsa Família",
			        "<div class='nota nbf entra d10'>Recebe = recebe Bolsa Família ou mora com quem recebe. O Datafolha não publicou "
			            & "o tamanho de cada grupo nesta pergunta.</div>" )
			-- 3 · As pontas da régua do IDH (a cidade de IDH mais baixo e a de mais alto, com o voto de 2026)
			VAR _idh =
			    CALCULATETABLE (
			        SUMMARIZE ( 'Social município', 'Social município'[CodIBGE], 'Social município'[Valor] ),
			        'Social município'[Lente] = "IDH"
			    )
			VAR _cBaixo = MINX ( TOPN ( 1, _idh, 'Social município'[Valor], ASC ), 'Social município'[CodIBGE] )
			VAR _cAlto = MINX ( TOPN ( 1, _idh, 'Social município'[Valor], DESC ), 'Social município'[CodIBGE] )
			VAR _ponta =
			    CONCATENATEX (
			        { ( 1, _cBaixo, "O MAIS BAIXO" ), ( 2, _cAlto, "O MAIS ALTO" ) },
			        VAR _cod = [Value2]
			        VAR _nome = LOOKUPVALUE ( 'Município'[Rótulo], 'Município'[CodIBGE], _cod )
			        VAR _v = MAXX ( FILTER ( _idh, 'Social município'[CodIBGE] = _cod ), 'Social município'[Valor] )
			        VAR _lu = CALCULATE ( [T24 · Lula % 2026 · município], TREATAS ( { _cod }, 'Município'[CodIBGE] ) )
			        VAR _fl = CALCULATE ( [T24 · Flávio % 2026 · município], TREATAS ( { _cod }, 'Município'[CodIBGE] ) )
			        RETURN
			            "<div class='pt sobe d" & ( [Value1] + 4 ) & "'><span class='rot'>" & [Value3] & " · IDHM "
			                & FORMAT ( _v, "0.000" ) & "</span><b>" & _nome & "</b><span><span class='lula-esc'>Lula "
			                & FORMAT ( _lu * 100, "0" ) & "%</span> × <span class='flavio-esc'>Flávio " & FORMAT ( _fl * 100, "0" )
			                & "%</span></span></div>",
			        "", [Value1], ASC
			    )
			-- 4 · Marcação
			VAR _cartao =
			    IF (
			        ISBLANK ( _i ),
			        "<div class='rot entra'>NAS PESQUISAS, AS PESSOAS</div>"
			            & "<div class='tit sobe d1'>O IDH não se pergunta</div>"
			            & "<div class='txt sobe d2'>É uma nota do lugar, não da pessoa: junta renda, escola e saúde da cidade. "
			            & "Por isso, nesta lente, só aparecem os lugares.</div>"
			            & "<div class='txt sobe d3'>O último IDH por município é de 2010. As 7 cidades criadas depois ficam de fora.</div>"
			            & "<div class='rot regua entra d4'>A RÉGUA, NAS PONTAS</div>" & _ponta,
			        "<div class='rot entra'>NAS PESQUISAS, AS PESSOAS</div>"
			            & "<div class='tit sobe d1'>O que os eleitores disseram ao " & _i & "</div>"
			            & "<div class='nota sobe d2'>intenção de voto no 1º turno " & _pergunta & " · " & _campo & "</div>"
			            & "<div class='eixo entra d3'><span class='flavio-esc'>← Flávio à frente</span>"
			            & "<span class='lula-esc'>Lula à frente →</span></div>"
			            & "<div class='lista realce'>" & _linhas & _total & "</div>" & _notaBF
			    )
			RETURN
			    "<div class='tela t24p'><div class='cartao'>" & _cartao & "</div></div>"
		displayFolder: T24 Quem vota\Desenho
		lineageTag: d2886e2b-5657-5ed1-a26e-8898cfef79d0

	/// Texto alternativo do dossiê do degrau.
	measure 'T24 · Tooltip degrau · ALT' =
			"Degrau " & [T24 · degrau] & " da lente " & [T24 · lente] & ": " & FORMAT ( [T24 · municípios], "#,0" ) & " municípios; Lula "
			    & FORMAT ( [T24 · Lula % 2022], "0.0%" ) & " em 2022 e " & FORMAT ( [T24 · Lula % 2026], "0.0%" ) & " em 2026."
		displayFolder: T24 Quem vota\Desenho
		lineageTag: 9259b28a-dfdb-5f0f-b5d8-8bb361b45d4e

	/// Dossiê do degrau (página de tooltip ttT24Degrau): municípios e eleitores, a faixa do indicador, Lula e o adversário em 2022 e 2026, a variação da margem e as maiores cidades.
	measure 'T24 · Tooltip degrau · HTML' =
			-- 1 · Leituras
			VAR _d = [T24 · degrau]
			VAR _l = [T24 · lente]
			VAR _mun = [T24 · municípios]
			VAR _ele = [T24 · eleitores]
			VAR _l22 = [T24 · Lula % 2022]
			VAR _j22 = [T24 · Jair % 2022]
			VAR _l26 = [T24 · Lula % 2026]
			VAR _f26 = [T24 · Flávio % 2026]
			VAR _var = [T24 · variação da margem]
			VAR _codigos =
			    CALCULATETABLE (
			        VALUES ( 'Social município'[CodIBGE] ),
			        'Social município'[Lente] = _l,
			        'Social município'[Degrau] = _d
			    )
			VAR _cidades =
			    CALCULATETABLE (
			        TOPN ( 3, VALUES ( 'Município'[Rótulo] ), CALCULATE ( SUM ( 'Município'[População] ) ), DESC ),
			        TREATAS ( _codigos, 'Município'[CodIBGE] )
			    )
			-- 2 · Textos
			VAR _txtCid = CONCATENATEX ( _cidades, 'Município'[Rótulo], ", ", CALCULATE ( SUM ( 'Município'[População] ) ), DESC )
			VAR _ponta =
			    SWITCH ( _d, 1, " · o de menos ", 5, " · o de mais ", " · " )
			    & SWITCH ( _l, "Renda", "renda", "Escolaridade", "escolaridade", "Bolsa Família", "Bolsa Família", "IDH" )
			VAR _ponta2 = IF ( _d = 1 || _d = 5, _ponta, "" )
			VAR _frase =
			    IF ( _var < 0,
			        "A margem de Lula aqui caiu " & FORMAT ( ABS ( _var ), "0.0" ) & IF ( ROUND ( ABS ( _var ), 1 ) = 1, " ponto", " pontos" )
			            & " desde 2022.",
			        "A margem de Lula aqui subiu " & FORMAT ( _var, "0.0" ) & IF ( ROUND ( _var, 1 ) = 1, " ponto", " pontos" )
			            & " desde 2022." )
			-- 3 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _d ),
			        "<div class='tela tt24'><div class='fita'></div>"
			            & "<div class='rot'>" & _d & "º QUINTO DOS ELEITORES" & UPPER ( _ponta2 ) & "</div>"
			            & "<div class='num-l'><b>" & FORMAT ( _mun, "#,0" ) & "</b> " & IF ( _mun = 1, "município", "municípios" )
			            & " · <b>" & FORMAT ( _ele / 1e6, "0.0" ) & " mi</b> de eleitores</div>"
			            & "<div class='duas'><div><span class='rot'>2022</span><span class='lula-esc'>Lula " & FORMAT ( _l22 * 100, "0.0" )
			            & "%</span><span class='flavio-esc'>Jair " & FORMAT ( _j22 * 100, "0.0" ) & "%</span></div>"
			            & "<div><span class='rot'>2026</span><span class='lula-esc'>Lula " & FORMAT ( _l26 * 100, "0.0" )
			            & "%</span><span class='flavio-esc'>Flávio " & FORMAT ( _f26 * 100, "0.0" ) & "%</span></div></div>"
			            & "<div class='txt'>" & _frase & "</div>"
			            & "<div class='cid'><span class='rot'>MAIORES CIDADES</span>" & _txtCid & "</div>"
			        & "</div>"
			    )
		displayFolder: T24 Quem vota\Desenho
		lineageTag: 676277c6-bde3-528f-9aac-b2fcbcb9133b

	/// Parcela dos aptos que faltou no ano, no lugar e na faixa do recorte (0–1): o número grande da manchete; na linha de um ano, de uma faixa ou de um município, o % dela.
	measure 'T25 · abstenção %' =
			DIVIDE ( [T25 · abstenções], [T25 · aptos] )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 1d396e29-bde6-5635-a6b4-10712e1f9c4e

	/// A mesma abstenção sem o município marcado ou da linha: a média do recorte de estado (as UFs escolhidas; ou o Brasil, com o exterior) no ano e na faixa do contexto (0–1). Referência da cor do mapa e das comparações.
	measure 'T25 · abstenção % do recorte' =
			CALCULATE (
			    [T25 · abstenção %],
			    REMOVEFILTERS ( 'Município'[CodIBGE], 'Município'[X], 'Município'[Y], 'Município'[UF], 'Município'[Rótulo], 'Município'[Município] )
			)
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 9e411e8f-fdab-50a1-89de-e790bc4bce56

	/// Abstenção no 1º turno de 2006 no lugar e na faixa do contexto (0–1); vazio sem dado (por idade, só de 2014 em diante).
	measure 'T25 · abstenção % em 2006' =
			CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = 2006 )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 989af35c-1379-5bc6-bf4a-01df6b549ca2

	/// Abstenção no 1º turno de 2010 no lugar e na faixa do contexto (0–1); vazio sem dado (por idade, só de 2014 em diante).
	measure 'T25 · abstenção % em 2010' =
			CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = 2010 )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: e4b86b5b-637b-59e3-8087-8ec38fce0965

	/// Abstenção no 1º turno de 2014 no lugar e na faixa do contexto (0–1); vazio sem dado (por idade, só de 2014 em diante).
	measure 'T25 · abstenção % em 2014' =
			CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = 2014 )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 4d50b1ad-cb06-5a9b-9518-53dbad042e64

	/// Abstenção no 1º turno de 2018 no lugar e na faixa do contexto (0–1); vazio sem dado (por idade, só de 2014 em diante).
	measure 'T25 · abstenção % em 2018' =
			CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = 2018 )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 2923175d-61cc-5019-8ad2-f48fbec05b72

	/// Abstenção no 1º turno de 2022 no lugar e na faixa do contexto (0–1); vazio sem dado (por idade, só de 2014 em diante).
	measure 'T25 · abstenção % em 2022' =
			CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = 2022 )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: c0dc664b-ab2f-54ab-a682-f921074218a2

	/// Abstenção no 1º turno de 2026 no lugar e na faixa do contexto (0–1); vazio sem dado (por idade, só de 2014 em diante).
	measure 'T25 · abstenção % em 2026' =
			CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = 2026 )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: a3837250-65a3-5bd3-b071-dfdee90e3c0c

	/// Abstenção no primeiro ano com dado (0–1).
	measure 'T25 · abstenção % no primeiro ano' =
			VAR _a0 = [T25 · primeiro ano da série]
			RETURN
			    CALCULATE ( DIVIDE ( [T25 · abstenções (cru)], [T25 · aptos (cru)] ), 'Ano'[Ano] = _a0 )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: d8379bff-53c2-56da-aed9-3b18b39385a4

	/// Abstenção do lugar no ano do recorte, com todas as idades (0–1): a linha de referência do bloco de idade.
	measure 'T25 · abstenção % todas as idades' =
			CALCULATE ( [T25 · abstenção %], REMOVEFILTERS ( 'T25 Faixa' ) )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 13cb4754-4afb-53c0-9194-4a1d2b4d0316

	/// Abstenção do município da linha dividida pela média do recorte (1 = na média, 2 = o dobro, 0,5 = a metade). Cor do ponto no mapa.
	measure 'T25 · abstenção relativa' =
			DIVIDE ( [T25 · abstenção %], [T25 · abstenção % do recorte] )
		formatString: 0.00
		displayFolder: T25 Quem falta\Contas
		lineageTag: 5ec25da8-b17e-5b79-a6dc-eac78360a4a1

	/// Eleitores que faltaram no ano do recorte (o marcado ou 2026), no lugar e na faixa do contexto. Tamanho do ponto no mapa.
	measure 'T25 · abstenções' =
			VAR _ano = [T25 · ano]
			RETURN
			    CALCULATE ( [T25 · abstenções (cru)], 'Ano'[Ano] = _ano )
		formatString: #,0
		displayFolder: T25 Quem falta\Contas
		lineageTag: b710c369-62d4-5636-97eb-ec45f033fbd4

	/// Eleitores que faltaram no contexto, sem fixar o ano: com faixa marcada, o perfil por idade; sem faixa, 'Município ano' nos recortes de municípios e o total oficial ('Comparecimento ano', com o exterior) no Brasil.
	measure 'T25 · abstenções (cru)' =
			IF (
			    [T25 · com faixa] = 1,
			    [T25 · abstenções por idade (cru)],
			    IF ( [T25 · sem exterior] = 1, SUM ( 'Município ano'[Abstencoes] ), SUM ( 'Comparecimento ano'[Abstencoes] ) )
			)
		formatString: #,0
		displayFolder: T25 Quem falta\Contas
		lineageTag: e577f794-28e4-5eee-b3cb-f03ff058a15e

	/// Eleitores que faltaram no perfil por idade (T25 Abstenção faixa) no contexto, mais o exterior quando o recorte é o Brasil inteiro; soma os anos do contexto.
	measure 'T25 · abstenções por idade (cru)' =
			SUM ( 'T25 Abstenção faixa'[Abstencoes] ) + IF ( [T25 · sem exterior] = 0, SUM ( 'T25 Abstenção exterior'[Abstencoes] ) )
		formatString: #,0
		displayFolder: T25 Quem falta\Contas
		lineageTag: b00a0108-ad4f-54b8-8480-4d85055db0cb

	/// Ano do recorte: o marcado no bloco de anos (o mais recente, se forem vários) ou 2026; na linha de um ano, o próprio.
	measure 'T25 · ano' =
			MAX ( 'Ano'[Ano] )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 4094b144-8afe-5b73-842b-a3ce0ccf3160

	/// Eleitores aptos no ano do recorte (o marcado ou 2026), no lugar e na faixa do contexto.
	measure 'T25 · aptos' =
			VAR _ano = [T25 · ano]
			RETURN
			    CALCULATE ( [T25 · aptos (cru)], 'Ano'[Ano] = _ano )
		formatString: #,0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 8db3d563-ee1a-5662-943e-aa032cdd486b

	/// Eleitores aptos no contexto, sem fixar o ano: com faixa marcada, o perfil por idade; sem faixa, 'Município ano' nos recortes de municípios e o total oficial ('Comparecimento ano', com o exterior) no Brasil.
	measure 'T25 · aptos (cru)' =
			IF (
			    [T25 · com faixa] = 1,
			    [T25 · aptos por idade (cru)],
			    IF ( [T25 · sem exterior] = 1, SUM ( 'Município ano'[Aptos] ), SUM ( 'Comparecimento ano'[Aptos] ) )
			)
		formatString: #,0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 3f138934-c078-5909-ad4c-645452dc5667

	/// Eleitores aptos no perfil por idade (T25 Abstenção faixa) no contexto, mais o exterior quando o recorte é o Brasil inteiro; soma os anos do contexto.
	measure 'T25 · aptos por idade (cru)' =
			SUM ( 'T25 Abstenção faixa'[Aptos] ) + IF ( [T25 · sem exterior] = 0, SUM ( 'T25 Abstenção exterior'[Aptos] ) )
		formatString: #,0
		displayFolder: T25 Quem falta\Contas
		lineageTag: ee26920d-8f31-531c-b986-3d388ea6d5cf

	/// 1 quando há ano marcado no bloco de anos (ou na linha/dica de um ano).
	measure 'T25 · com ano' =
			INT ( ISFILTERED ( 'Ano' ) )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 0d433def-8412-5392-8abd-3b1af0373acc

	/// 1 quando há faixa de idade marcada (clique no bloco de idade) ou na linha/dica de uma faixa.
	measure 'T25 · com faixa' =
			INT ( ISFILTERED ( 'T25 Faixa' ) )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 962e3df4-cda3-5ab0-b611-566cea96783b

	/// 1 quando há município marcado no mapa (ou na linha/dica de um município).
	measure 'T25 · com município' =
			INT ( ISFILTERED ( 'Município' ) )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 7196db9b-eb04-5037-a93a-be512b2555d2

	/// Abstenção do lugar menos a média do recorte, em pontos percentuais.
	measure 'T25 · diferença para o recorte' =
			IF ( NOT ISBLANK ( [T25 · abstenção %] ), ( [T25 · abstenção %] - [T25 · abstenção % do recorte] ) * 100 )
		formatString: 0.0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 2d10281b-ed00-5437-87cc-7392a09a456b

	/// Os dois mais votados no 1º turno do ano da linha (Brasil, resultado oficial), o primeiro antes, com o partido.
	measure 'T25 · disputa do ano' =
			VAR _1 = CALCULATE ( SELECTEDVALUE ( 'Candidato ano'[Candidato] ), 'Candidato ano'[Posição] = 1 )
			VAR _1p = CALCULATE ( SELECTEDVALUE ( 'Candidato ano'[Partido] ), 'Candidato ano'[Posição] = 1 )
			VAR _2 = CALCULATE ( SELECTEDVALUE ( 'Candidato ano'[Candidato] ), 'Candidato ano'[Posição] = 2 )
			VAR _2p = CALCULATE ( SELECTEDVALUE ( 'Candidato ano'[Partido] ), 'Candidato ano'[Posição] = 2 )
			RETURN
			    IF ( NOT ISBLANK ( _1 ), _1 & " (" & _1p & ") e " & _2 & " (" & _2p & ")" )
		displayFolder: T25 Quem falta\Contas
		lineageTag: d1a9bd33-d8ed-5c97-ad0c-0acd5d3fcd27

	/// Quantos em cada 10 eleitores do recorte faltaram, arredondado (para a frase quando é 35% ou mais).
	measure 'T25 · em cada 10' =
			IF ( [T25 · abstenção %] > 0, ROUND ( [T25 · abstenção %] * 10, 0 ) )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: a5753efe-84a0-5963-8ae6-53f43bbf69c2

	/// A faixa marcada (ex.: 18 a 24 anos), ou "N faixas de idade"; vazio sem faixa.
	measure 'T25 · faixa' =
			SWITCH (
			    TRUE (),
			    [T25 · faixas marcadas] = 1, SELECTEDVALUE ( 'T25 Faixa'[Faixa] ),
			    [T25 · faixas marcadas] > 1, FORMAT ( [T25 · faixas marcadas], "0" ) & " faixas de idade"
			)
		displayFolder: T25 Quem falta\Contas
		lineageTag: 94f8ea98-47a0-5d41-ab73-ffa7e61f4bbc

	/// Faixa de idade da linha (ou da dica).
	measure 'T25 · faixa da linha' =
			SELECTEDVALUE ( 'T25 Faixa'[Faixa] )
		displayFolder: T25 Quem falta\Contas
		lineageTag: 1c7247c7-2789-5c79-8c93-a91b4d0f5c4f

	/// Faixa cujo peso entre os que faltaram mais passa do peso entre os aptos, no lugar e no ano da linha (a nota à mão da dica do ano).
	measure 'T25 · faixa mais acima do seu peso' =
			VAR _t =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'T25 Faixa'[Curta] ), REMOVEFILTERS ( 'T25 Faixa' ) ),
			        "@r",
			            VAR _c = 'T25 Faixa'[Curta]
			            RETURN
			                DIVIDE (
			                    DIVIDE (
			                        CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Curta] = _c ),
			                        CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
			                    ),
			                    DIVIDE (
			                        CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Curta] = _c ),
			                        CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
			                    )
			                )
			    )
			RETURN
			    MAXX ( TOPN ( 1, FILTER ( _t, NOT ISBLANK ( [@r] ) ), [@r], DESC, 'T25 Faixa'[Curta], ASC ), 'T25 Faixa'[Curta] )
		displayFolder: T25 Quem falta\Contas
		lineageTag: f29bb374-6de6-5161-b6a7-91a88d3c076c

	/// Quantas vezes o peso dessa faixa entre os que faltaram passa o peso dela entre os aptos.
	measure 'T25 · faixa mais acima do seu peso (vezes)' =
			VAR _c = [T25 · faixa mais acima do seu peso]
			RETURN
			    IF (
			        NOT ISBLANK ( _c ),
			        DIVIDE (
			            DIVIDE (
			                CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Curta] = _c ),
			                CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
			            ),
			            DIVIDE (
			                CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Curta] = _c ),
			                CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
			            )
			        )
			    )
		formatString: 0.0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 32dc204a-c88e-5c7f-9d53-d743fec95006

	/// Faixa de idade com a maior abstenção no lugar e no ano do recorte (ignora a faixa marcada).
	measure 'T25 · faixa que mais falta' =
			VAR _faixas =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'T25 Faixa'[Faixa] ), REMOVEFILTERS ( 'T25 Faixa' ) ),
			        "@p",
			            VAR _f = 'T25 Faixa'[Faixa]
			            RETURN
			                CALCULATE ( [T25 · abstenção %], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Faixa] = _f )
			    )
			VAR _comDado = FILTER ( _faixas, NOT ISBLANK ( [@p] ) )
			RETURN
			    MAXX ( TOPN ( 1, _comDado, [@p], DESC, 'T25 Faixa'[Faixa], ASC ), 'T25 Faixa'[Faixa] )
		displayFolder: T25 Quem falta\Contas
		lineageTag: 6fff22c3-4399-58ba-91a5-50f9a37b11ef

	/// Abstenção da faixa que mais falta (0–1).
	measure 'T25 · faixa que mais falta %' =
			VAR _faixas =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'T25 Faixa'[Faixa] ), REMOVEFILTERS ( 'T25 Faixa' ) ),
			        "@p",
			            VAR _f = 'T25 Faixa'[Faixa]
			            RETURN
			                CALCULATE ( [T25 · abstenção %], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Faixa] = _f )
			    )
			VAR _comDado = FILTER ( _faixas, NOT ISBLANK ( [@p] ) )
			RETURN
			    MAXX ( _comDado, [@p] )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 32cb334e-54b2-5dea-95dd-419501f1e569

	/// Faixa de idade com a menor abstenção no lugar e no ano do recorte (ignora a faixa marcada).
	measure 'T25 · faixa que menos falta' =
			VAR _faixas =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'T25 Faixa'[Faixa] ), REMOVEFILTERS ( 'T25 Faixa' ) ),
			        "@p",
			            VAR _f = 'T25 Faixa'[Faixa]
			            RETURN
			                CALCULATE ( [T25 · abstenção %], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Faixa] = _f )
			    )
			VAR _comDado = FILTER ( _faixas, NOT ISBLANK ( [@p] ) )
			RETURN
			    MAXX ( TOPN ( 1, _comDado, [@p], ASC, 'T25 Faixa'[Faixa], ASC ), 'T25 Faixa'[Faixa] )
		displayFolder: T25 Quem falta\Contas
		lineageTag: b7989e62-0677-5e58-aba3-8a62b3fd4ad5

	/// Abstenção da faixa que menos falta (0–1).
	measure 'T25 · faixa que menos falta %' =
			VAR _faixas =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'T25 Faixa'[Faixa] ), REMOVEFILTERS ( 'T25 Faixa' ) ),
			        "@p",
			            VAR _f = 'T25 Faixa'[Faixa]
			            RETURN
			                CALCULATE ( [T25 · abstenção %], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Faixa] = _f )
			    )
			VAR _comDado = FILTER ( _faixas, NOT ISBLANK ( [@p] ) )
			RETURN
			    MINX ( _comDado, [@p] )
		formatString: 0.0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: f2ffc297-dac0-5f8f-b847-0a1b5fa4f2c1

	/// Quantas faixas de idade estão marcadas (0 sem faixa).
	measure 'T25 · faixas marcadas' =
			IF ( [T25 · com faixa] = 1, COUNTROWS ( VALUES ( 'T25 Faixa'[Faixa] ) ), 0 )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: edb1ac2d-27d0-5c07-8211-a7b9badcd70b

	/// O lugar que a tela mostra: o município marcado, N municípios marcados ou o recorte de estado (Brasil, o estado, a região, os estados).
	measure 'T25 · lugar' =
			SWITCH (
			    TRUE (),
			    [T25 · municípios marcados] = 1, [T25 · município],
			    [T25 · municípios marcados] > 1, FORMAT ( [T25 · municípios marcados], "#,0" ) & " municípios marcados",
			    [T25 · recorte]
			)
		displayFolder: T25 Quem falta\Contas
		lineageTag: de52971e-cae0-543e-83dd-b2b1afcb899a

	/// Nome (UF) do município marcado ou da linha; vazio se não for um só.
	measure 'T25 · município' =
			IF ( [T25 · municípios marcados] = 1, SELECTEDVALUE ( 'Município'[Rótulo] ) )
		displayFolder: T25 Quem falta\Contas
		lineageTag: a55b9c3e-d08f-53c5-958d-36aa72251844

	/// Quantos municípios estão marcados no mapa (0 sem marca).
	measure 'T25 · municípios marcados' =
			IF ( [T25 · com município] = 1, COUNTROWS ( VALUES ( 'Município'[CodIBGE] ) ), 0 )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: e6c3a82f-c66d-54d8-8ee0-a93ba4171497

	/// Nome da média de referência (a do recorte, sem o município marcado): 'média nacional' no Brasil, 'média estadual' num estado, 'média do Nordeste' numa região inteira, 'média de MG e SP' em vários estados.
	measure 'T25 · média (nome)' =
			SWITCH (
			    [Recorte · tipo],
			    "Brasil", "média nacional",
			    "UF", "média estadual",
			    "média " & [Recorte · de]
			)
		displayFolder: T25 Quem falta\Contas
		lineageTag: cb337d0f-8429-5daa-97c0-5ca1c09c206b

	/// Ordem da faixa da linha (1 = 16 e 17 anos … 7 = 70 ou mais).
	measure 'T25 · ordem da faixa' =
			SELECTEDVALUE ( 'T25 Faixa'[Ordem] )
		formatString: 0
		displayFolder: T25 Quem falta\Contas
		lineageTag: 459dd276-6406-54d5-a711-10dcd3271bf5

	/// Parcela dos aptos do lugar, no ano do recorte, que está na faixa da linha (0–1).
	measure 'T25 · parte dos aptos (faixa)' =
			VAR _ano = [T25 · ano]
			RETURN
			    DIVIDE (
			        CALCULATE ( [T25 · aptos por idade (cru)], 'Ano'[Ano] = _ano ),
			        CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'Ano'[Ano] = _ano )
			    )
		formatString: 0%
		displayFolder: T25 Quem falta\Contas
		lineageTag: 01373a17-dbf5-5e8f-834f-e7383d382b0f

	/// Parcela dos eleitores aptos do lugar, no ano da linha, que tinha 16 e 17 anos (0–1), sem a faixa marcada.
	measure 'T25 · parte dos aptos · 16 e 17 anos' =
			DIVIDE (
			    CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Ordem] = 1 ),
			    CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
