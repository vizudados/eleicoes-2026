	/// Grupo em destaque no diagrama: o clicado no diagrama ou o do candidato clicado na lista dos apoios; vazio sem clique.
	measure 'T16 · foco · grupo' =
			VAR _g = [T16 · foco · grupo clicado]
			RETURN
			    IF ( ISBLANK ( _g ), [T16 · foco · grupo do apoio clicado], _g )
		displayFolder: T16 Os outros\Contas
		lineageTag: 539f0c52-a73c-50e0-8e75-26bd1651982a

	/// Grupo de eleitores escolhido no clique num grupo do diagrama (filtro cruzado em 'Transferência'[Segmento]): Cury, Renan, Caiado ou nao_votou; vazio sem clique. Lido pelo diagrama e pela lista dos apoios.
	measure 'T16 · foco · grupo clicado' =
			VAR _seg =
			    IF (
			        ISFILTERED ( 'Transferência'[Segmento] ) && HASONEVALUE ( 'Transferência'[Segmento] ),
			        VALUES ( 'Transferência'[Segmento] )
			    )
			RETURN
			    IF ( _seg IN { "Cury", "Renan", "Caiado", "nao_votou" }, _seg )
		displayFolder: T16 Os outros\Contas
		lineageTag: 78536030-b7b4-5a00-8941-192663e74e9e

	/// Grupo de eleitores do candidato escolhido no clique na lista dos apoios (filtro cruzado em Apoio[Quem]): Augusto Cury → Cury, Renan Santos → Renan, Ronaldo Caiado → Caiado; vazio para os outros nomes ou sem clique. Lido pelo diagrama.
	measure 'T16 · foco · grupo do apoio clicado' =
			VAR _quem = IF ( ISFILTERED ( Apoio[Quem] ) && HASONEVALUE ( Apoio[Quem] ), VALUES ( Apoio[Quem] ) )
			RETURN
			    SWITCH ( _quem, "Augusto Cury", "Cury", "Renan Santos", "Renan", "Ronaldo Caiado", "Caiado" )
		displayFolder: T16 Os outros\Contas
		lineageTag: 6ef00c06-779d-5c23-8eda-f08c439bb3b9

	/// Governadores eleitos ou reeleitos no 1º turno com posição 'Flávio' no 2º turno (levantamento do O Povo, 16/10).
	measure 'T16 · governadores · com Flávio' =
			COUNTROWS (
			    FILTER (
			        ALL ( Apoio ),
			        ( CONTAINSSTRING ( Apoio[Cargo], "governador eleito" ) || CONTAINSSTRING ( Apoio[Cargo], "governador reeleito" )
			            || CONTAINSSTRING ( Apoio[Cargo], "governadora eleita" ) || CONTAINSSTRING ( Apoio[Cargo], "governadora reeleita" ) )
			            && Apoio[Posição] = "Flávio"
			    )
			) + 0
		formatString: 0
		displayFolder: T16 Os outros\Contas
		lineageTag: 610e0be1-23b3-53ea-afa2-f2d3a381cfc6

	/// Governadores eleitos ou reeleitos no 1º turno com posição 'Lula' no 2º turno (levantamento do O Povo, 16/10).
	measure 'T16 · governadores · com Lula' =
			COUNTROWS (
			    FILTER (
			        ALL ( Apoio ),
			        ( CONTAINSSTRING ( Apoio[Cargo], "governador eleito" ) || CONTAINSSTRING ( Apoio[Cargo], "governador reeleito" )
			            || CONTAINSSTRING ( Apoio[Cargo], "governadora eleita" ) || CONTAINSSTRING ( Apoio[Cargo], "governadora reeleita" ) )
			            && Apoio[Posição] = "Lula"
			    )
			) + 0
