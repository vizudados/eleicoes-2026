	/// Flávio − Lula, em pontos, na pesquisa anterior de 2º turno do MESMO instituto (a comparação mais limpa: mesmo método); vazio quando é a primeira dele.
	measure 'T17 · pesquisa · diferença anterior' =
			VAR _inst = [T17 · pesquisa · instituto]
			VAR _ant = [T17 · pesquisa · divulgação anterior]
			RETURN
			    IF (
