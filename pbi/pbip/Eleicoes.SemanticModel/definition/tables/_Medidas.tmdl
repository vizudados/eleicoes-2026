		lineageTag: 181020a1-9165-5d53-b5c1-8b7eab52c2be

	/// Votos válidos no escopo.
	measure 'Apuração · válidos' =
			IF (
			    ISFILTERED ( 'UF' ),
			    SUM ( 'Apuração UF'[Validos] ),
			    SUM ( 'Apuração Brasil'[Validos] )
			)
		formatString: #,0
		displayFolder: T18 Apuração\Contas
