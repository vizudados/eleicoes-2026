	/// Parte de Flávio na soma dos índices diários dos dois no período (a mesma consulta, então a soma dos índices pesa como a soma das buscas); vazio sem período ou sem dia.
	measure 'T08 · período · parte Flávio' =
			VAR _a = [T08 · período · soma Flávio]
			VAR _b = [T08 · período · soma Lula]
			RETURN
			    IF ( NOT ISBLANK ( _a ) && _a + _b > 0, DIVIDE ( _a, _a + _b ) )
