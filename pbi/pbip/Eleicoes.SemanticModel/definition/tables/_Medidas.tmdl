	/// Em quantas das seis eleições (2006–2026) o adversário do PT ficou à frente no contexto.
	measure 'T11 · eleições com o adversário à frente' =
			COUNTROWS ( FILTER ( ALL ( 'Ano'[Ano] ), [T11 · margem no ano] < 0 ) ) + 0
		formatString: 0
