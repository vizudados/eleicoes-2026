	/// Posição no dia (afasta os pontos do mesmo dia) da pesquisa anterior do mesmo instituto (T17 · série · Id anterior): a ponta de onde sai o traço da série; vazio na primeira dele.
	measure 'T17 · série · anterior · ordem no dia' =
			VAR _ant = [T17 · série · Id anterior]
			RETURN
			    IF (
			        NOT ISBLANK ( _ant ),
			        CALCULATE ( [T17 · pesquisa · ordem no dia], REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _ant )
