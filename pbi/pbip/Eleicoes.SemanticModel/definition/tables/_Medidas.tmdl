	/// Instituto em destaque escolhido no clique de um quadrinho da rejeição (filtro cruzado em 'Rejeição'[Instituto]); vazio sem clique. Lido pelos pontos da curva e pelo placar (no quadrinho clicado, é o próprio).
	measure 'T17 · foco · instituto da rejeição' =
			IF (
			    ISFILTERED ( 'Rejeição'[Instituto] ) && HASONEVALUE ( 'Rejeição'[Instituto] ),
			    VALUES ( 'Rejeição'[Instituto] )
			)
		displayFolder: T17 2º turno\Contas
		lineageTag: 03355567-5690-5188-b3e6-c7301f4ee8b0

	/// Do instituto em destaque (T17 · foco · instituto), quantas pesquisas do período escolhido (campo inteiro dentro) deram empate; vazio sem destaque ou sem período.
	measure 'T17 · foco · período · empates' =
			VAR _de = [T17 · período · campo de]
			VAR _ate = [T17 · período · campo até]
			VAR _inst = [T17 · foco · instituto]
			RETURN
			    IF (
			        NOT ISBLANK ( _inst ) && NOT ISBLANK ( _de ),
			        CALCULATE (
			            COUNTROWS ( Pesquisa ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "2º turno",
			            Pesquisa[Tipo] = "totais",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Campo início] >= _de,
			            Pesquisa[Campo fim] <= _ate,
			            Pesquisa[Instituto] = _inst,
			            FILTER ( ALL ( Pesquisa[Lula], Pesquisa[Flavio] ), Pesquisa[Flavio] = Pesquisa[Lula] )
			        ) + 0
			    )
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: 1ca663b8-e025-509f-a778-c3fea80325f1

