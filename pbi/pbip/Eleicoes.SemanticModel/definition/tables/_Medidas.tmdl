			    )
			VAR _ok =
			    FILTER ( _t, NOT ISBLANK ( [@d] ) )
			VAR _d = [T15 · variação]
			RETURN
			    IF ( NOT ISBLANK ( _d ) && NOT ISBLANK ( _p ), COUNTROWS ( FILTER ( _ok, [@d] < _d ) ) + 1 )
