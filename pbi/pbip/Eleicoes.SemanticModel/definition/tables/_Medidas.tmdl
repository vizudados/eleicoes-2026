		lineageTag: 92f32f5a-63fa-5551-bf6a-a96a7e65cc97

	/// Na medição mais recente do instituto do filtro para o grupo do filtro (depois do 1º turno): % para Lula.
	measure 'T16 · instituto · Lula' =
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _i = SELECTEDVALUE ( 'Transferência'[Instituto] )
			VAR _dia =
			    CALCULATE (
			        MAX ( 'Transferência'[Divulgação] ),
			        REMOVEFILTERS ( 'Transferência' ),
			        'Transferência'[Segmento] = _seg,
			        'Transferência'[Instituto] = _i,
			        LEFT ( 'Transferência'[Observação], 19 ) = "momento=apos_1turno"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _dia ),
			        CALCULATE (
			            AVERAGE ( 'Transferência'[Lula] ),
			            REMOVEFILTERS ( 'Transferência' ),
			            'Transferência'[Segmento] = _seg,
			            'Transferência'[Instituto] = _i,
			            'Transferência'[Divulgação] = _dia,
			            LEFT ( 'Transferência'[Observação], 19 ) = "momento=apos_1turno"
			        )
			    )
		formatString: 0.0
		displayFolder: T16 Os outros\Contas
		lineageTag: 70809dec-9605-50df-a4e8-1b2841c31cf9

	/// Na medição mais recente do instituto do filtro para o grupo do filtro (depois do 1º turno): % que não sabe.
	measure 'T16 · instituto · não sabe' =
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _i = SELECTEDVALUE ( 'Transferência'[Instituto] )
			VAR _dia =
