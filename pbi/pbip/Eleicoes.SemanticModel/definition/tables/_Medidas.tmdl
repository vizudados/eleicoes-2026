	/// Dias do período escolhido, de ponta a ponta (13, 3, 2 e 2).
	measure 'Período · dias' =
			IF (
			    ISFILTERED ( 'Período' ) && HASONEVALUE ( 'Período'[Ordem] ),
			    DATEDIFF ( MIN ( 'Período'[Início] ), MAX ( 'Período'[Fim] ), DAY ) + 1
