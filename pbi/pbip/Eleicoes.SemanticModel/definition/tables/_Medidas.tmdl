	/// Interações de 06 a 15/10, sem o YouTube (Bites); no contexto do candidato (Monitoramento[Candidato]).
	measure 'T09 · interações · sem o YouTube' =
			CALCULATE (
			    SUM ( Monitoramento[Valor] ),
			    Monitoramento[Métrica] = "interações (Instagram, Facebook, TikTok, X)",
