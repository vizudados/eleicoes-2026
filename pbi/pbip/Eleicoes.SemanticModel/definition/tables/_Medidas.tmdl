	/// Texto alternativo da camada de células da matriz.
	measure 'T13 · Células · ALT' =
			-- 1 · Leituras
			VAR _v = [T13 · maior queda · variação]
			-- 2 · Textos
			RETURN
			    "Células da matriz: passe o mouse para o dossiê de cada grupo de cidades e clique para vê-lo na resposta. A maior "
			        & "queda é de " & FORMAT ( _v * 100, "+0.0;−0.0;0.0" ) & " pontos."
		displayFolder: T13 Perfil\Desenho
		lineageTag: b230c151-9f72-5173-9484-0e86eccaccc8

	/// Uma entrada por célula da matriz (granularidade T13 Célula[Célula]): a queda da margem de Lula e as cidades da célula, na cor da escala, com contorno vermelho na célula de maior queda e tracejado quando há menos de 10 cidades. Passar o mouse abre o dossiê (ttT13Celula); o clique filtra as cidades da célula na resposta. Vazia fora de uma célula com cidades. Só lê contas.
	measure 'T13 · Células · HTML' =
			-- 1 · Leituras
			VAR _p = [T13 · ordem do porte]
			VAR _q = [T13 · ordem do quinto]
			VAR _n = [T13 · cidades]
			VAR _v = [T13 · variação]
			VAR _pior = [T13 · é a célula da maior queda]
			-- 2 · Textos
			VAR _cls =
			    SWITCH (
			                TRUE (),
			                _n = 0 || ISBLANK ( _v ), "vazia",
			                _v >= 0, "c0",
			                _v > -0.05, "c1",
			                _v > -0.08, "c2",
			                _v > -0.11, "c3",
			                _v > -0.14, "c4",
			                "c5"
			            )
			VAR _poucas = IF ( _n < 10, " poucas", "" )
			VAR _clsPior = IF ( _pior = 1, " pior", "" )
			-- 3 · Geometria (a mesma da moldura: colunas a partir de x 190, passo 176; linhas a partir de y 166, passo 100)
			VAR _x = 190 + ( _q - 1 ) * 176
			VAR _y = 166 + ( _p - 1 ) * 100
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _p ) && NOT ISBLANK ( _q ) && _cls <> "vazia",
			        "<div class='tela t13c'><div class='cel " & _cls & _poucas & _clsPior & " brota' style='left:" & _x & "px;top:"
			            & _y & "px;animation-delay:" & ( 300 + ( _p + _q ) * 70 ) & "ms'>"
			            & "<span class='num'>" & FORMAT ( _v * 100, "+0.0;−0.0;0.0" ) & "</span><span class='n'>" & FORMAT ( _n, "#,0" )
			            & IF ( _n = 1, " cidade", " cidades" ) & "</span></div></div>"
			    )
		displayFolder: T13 Perfil\Desenho
		lineageTag: 5a72a36b-f733-5ace-a688-80c28b537eb4

	/// Texto alternativo da matriz porte × renda.
	measure 'T13 · Matriz · ALT' =
			-- 1 · Leituras
			VAR _v = [T13 · maior queda · variação]
			VAR _p = [T13 · maior queda · porte]
			VAR _q = [T13 · maior queda · quinto]
			VAR _cres = [T13 · queda cresce quando a cidade diminui]
			-- 2 · Textos
			RETURN
			    "Matriz de porte por renda com a queda da margem de Lula em cada grupo de cidades. "
			        & IF ( _cres = 1, "Quanto menor a cidade, maior a queda. ", "" )
			        & "A maior queda: " & _p & " e " & _q & ", " & FORMAT ( _v * 100, "+0.0;−0.0;0.0" ) & " pontos."
		displayFolder: T13 Perfil\Desenho
		lineageTag: f2ddc6f6-4388-59d2-a8dd-9b49078d1ca9

	/// A moldura da matriz porte × quinto de renda: título e manchete, as faixas de renda, os portes com o total de cada linha, as células vazias (sem município no recorte), o total de cada coluna e a nota. As células com cidades são desenhadas por cima, uma por ponto de dado ('T13 · Células · HTML'). Só lê contas 'T13 · …'.
	measure 'T13 · Matriz · HTML' =
			-- 1 · Leituras
			VAR _portes =
			    DATATABLE (
			        "o", INTEGER, "nome", STRING,
			        {
			        { 1, "até 10 mil" },
			        { 2, "10 a 50 mil" },
			        { 3, "50 a 200 mil" },
			        { 4, "200 mil a 1 milhão" },
			        { 5, "mais de 1 milhão" }
			        }
			    )
			VAR _quintos =
			    DATATABLE (
			        "o", INTEGER, "nome", STRING, "tit", STRING,
			        {
			        { 1, "mais pobres", "MAIS POBRES" },
			        { 2, "2º quinto", "2º QUINTO" },
			        { 3, "3º quinto", "3º QUINTO" },
			        { 4, "4º quinto", "4º QUINTO" },
			        { 5, "mais ricas", "MAIS RICAS" }
			        }
			    )
			VAR _cres = [T13 · queda cresce quando a cidade diminui]
			VAR _pPorte = [T13 · porte com maior queda]
			VAR _qMin = [T13 · menor queda por renda]
			VAR _qMax = [T13 · maior queda por renda]
			VAR _tudo = [T13 · variação]
			-- 2 · Textos
			VAR _man =
			    IF ( _cres = 1, "Quanto menor a cidade, maior a queda", "A queda foi maior nas cidades de " & _pPorte )
			        & "; por renda, entre " & FORMAT ( _qMax * 100, "+0.0;−0.0;0.0" ) & " e " & FORMAT ( _qMin * 100, "+0.0;−0.0;0.0" ) & " pontos"
			-- 3 · Geometria e 4 · Marcação (células de 168 × 92 px; colunas a partir de x 190, passo 176; linhas a partir de y 166, passo 100)
			VAR _cab =
			    CONCATENATEX (
			        _quintos,
			        VAR _o = [o]
			        VAR _x = 190 + ( _o - 1 ) * 176
			        VAR _rmin = CALCULATE ( [T13 · renda mínima], 'Município'[QuintoOrdem] = _o )
			        VAR _rmax = CALCULATE ( [T13 · renda máxima], 'Município'[QuintoOrdem] = _o )
			        RETURN
			            "<div class='cq entra d" & [o] & "' style='left:" & _x & "px'><b>" & [tit] & "</b><span>R$ "
			                & FORMAT ( _rmin, "#,0" ) & " a R$ " & FORMAT ( _rmax, "#,0" ) & "</span></div>",
			        "",
			        [o], ASC
			    )
			VAR _rotLinhas =
			    CONCATENATEX (
			        _portes,
			        VAR _o = [o]
			        VAR _y = 166 + ( _o - 1 ) * 100
			        VAR _v = CALCULATE ( [T13 · variação], 'Município'[PorteOrdem] = _o )
			        VAR _n = CALCULATE ( [T13 · cidades], 'Município'[PorteOrdem] = _o )
			        RETURN
			            "<div class='rl sobe d" & [o] & "' style='top:" & _y & "px'><b>" & [nome] & "</b><span class='num'>"
			                & IF ( _n = 0, "—", FORMAT ( _v * 100, "+0.0;−0.0;0.0" ) ) & "</span><i>" & FORMAT ( _n, "#,0" )
			                & IF ( _n = 1, " cidade", " cidades" ) & "</i></div>",
			        "",
			        [o], ASC
			    )
			VAR _vazias =
			    CONCATENATEX (
			        CROSSJOIN ( SELECTCOLUMNS ( _portes, "p", [o] ), SELECTCOLUMNS ( _quintos, "q", [o] ) ),
			        VAR _p = [p]
			        VAR _q = [q]
			        VAR _n = CALCULATE ( [T13 · cidades], 'Município'[PorteOrdem] = _p, 'Município'[QuintoOrdem] = _q )
			        RETURN
			            IF (
			                _n = 0,
			                "<div class='cel vazia entra' style='left:" & ( 190 + ( _q - 1 ) * 176 ) & "px;top:"
			                    & ( 166 + ( _p - 1 ) * 100 ) & "px'><span class='tr'>—</span></div>"
			            ),
			        "",
			        [p], ASC, [q], ASC
			    )
			VAR _rodape =
			    CONCATENATEX (
			        _quintos,
			        VAR _o = [o]
			        VAR _x = 190 + ( _o - 1 ) * 176
			        VAR _v = CALCULATE ( [T13 · variação], 'Município'[QuintoOrdem] = _o )
			        RETURN
			            "<div class='tq entra d" & ( 8 + [o] ) & "' style='left:" & _x & "px'><span class='num'>"
			                & IF ( ISBLANK ( _v ), "—", FORMAT ( _v * 100, "+0.0;−0.0;0.0" ) ) & "</span></div>",
			        "",
			        [o], ASC
			    )
			RETURN
			    "<div class='tela t13m'>"
			        & "<div class='rot entra'>QUEDA DA MARGEM DE LULA, 2022 → 2026 · EM PONTOS</div>"
			        & "<div class='man sobe d1'>" & _man & "</div>"
			        & "<div class='eixoP rot'>PORTE ↓</div><div class='eixoQ rot'>RENDA POR PESSOA →</div>"
			        & _cab & _rotLinhas & _vazias
			        & "<div class='todas entra d9'><b>todas</b><span class='num'>" & FORMAT ( _tudo * 100, "+0.0;−0.0;0.0" ) & "</span>"
			            & "<i>soma dos municípios, sem o exterior</i></div>"
			        & _rodape
			        & "<div class='nota pe entra d12'>Passe o mouse numa célula para o dossiê dela; clique para ver a célula na "
			            & "resposta, ao lado (clique de novo para voltar). — = não há município nessa combinação; células claras e "
			            & "tracejadas têm menos de 10 cidades.</div>"
			    & "</div>"
		displayFolder: T13 Perfil\Desenho
		lineageTag: 939a8864-0e8b-5117-b841-f2bfc2e11eed

	/// Texto alternativo da coluna da resposta.
	measure 'T13 · Resposta · ALT' =
			-- 1 · Leituras
			VAR _sel = [T13 · célula escolhida]
			VAR _pv = [T13 · maior queda · variação]
			VAR _pp = [T13 · maior queda · porte]
			VAR _pq = [T13 · maior queda · quinto]
			VAR _mv = [T13 · menor queda · variação]
			VAR _cv = [T13 · variação]
			VAR _cp = [T13 · porte da célula]
			VAR _cq = [T13 · quinto da célula]
			-- 2 · Textos
			RETURN
			    IF (
			        _sel = 1,
			        "A célula escolhida, cidades " & _cp & " e " & _cq & ": " & FORMAT ( _cv * 100, "+0.0;−0.0;0.0" ) & " pontos. A maior queda: "
			            & FORMAT ( _pv * 100, "+0.0;−0.0;0.0" ) & " pontos.",
			        "A margem de Lula caiu mais nas cidades " & _pp & " e " & _pq & ": " & FORMAT ( _pv * 100, "+0.0;−0.0;0.0" ) & " pontos. A menor queda: "
			            & FORMAT ( _mv * 100, "+0.0;−0.0;0.0" ) & " pontos."
			    )
		displayFolder: T13 Perfil\Desenho
		lineageTag: 79754200-ccb4-5d7b-9126-1dbb7c8017cf

	/// Coluna da resposta. Sem clique: a maior queda (célula, número e exemplos), a menor queda e como ler a célula. Com uma célula clicada na matriz: a queda dessa célula, as cidades dela, a comparação com a maior queda (e a posição entre as células) e a célula anotada. Só lê contas.
	measure 'T13 · Resposta · HTML' =
			-- 1 · Leituras
			VAR _sel = [T13 · célula escolhida]
			VAR _pv = [T13 · maior queda · variação]
			VAR _pp = [T13 · maior queda · porte]
			VAR _pq = [T13 · maior queda · quinto]
			VAR _pn = [T13 · maior queda · cidades]
			VAR _pe = [T13 · maior queda · exemplos]
			VAR _mv = [T13 · menor queda · variação]
			VAR _mp = [T13 · menor queda · porte]
			VAR _mq = [T13 · menor queda · quinto]
			VAR _mn = [T13 · menor queda · cidades]
			VAR _me = [T13 · menor queda · exemplos]
			VAR _uf = [T13 · recorte]
			VAR _cv = [T13 · variação]
			VAR _cp = [T13 · porte da célula]
			VAR _cq = [T13 · quinto da célula]
			VAR _cn = [T13 · cidades]
			VAR _ce = [T13 · exemplos]
			VAR _pos = [T13 · posição da célula na queda]
			VAR _ncel = [T13 · células comparáveis]
			-- 2 · Textos
			VAR _av = IF ( _sel = 1, _cv, _pv )
			VAR _an = IF ( _sel = 1, _cn, _pn )
			VAR _ap = IF ( _sel = 1, _cp, _pp )
			VAR _aq = IF ( _sel = 1, _cq, _pq )
			VAR _ae = IF ( _sel = 1, _ce, _pe )
			VAR _grupo =
			    "cidades de " & _ap & IF ( RIGHT ( _ap, 3 ) = "mil", " habitantes", " de habitantes" )
			        & " e de renda " & SWITCH ( _aq, "mais ricas", "mais alta", "mais pobres", "mais baixa", "no " & _aq )
			VAR _grupoM =
			    IF ( _mn = 1, "na única cidade", "nas " & FORMAT ( _mn, "#,0" ) & " cidades" ) & " "
			        & "de " & _mp & IF ( RIGHT ( _mp, 3 ) = "mil", " habitantes", " de habitantes" )
			        & " e de renda " & SWITCH ( _mq, "mais ricas", "mais alta", "mais pobres", "mais baixa", "no " & _mq )
			VAR _grupoP =
			    IF ( _pn = 1, "na única cidade", "nas " & FORMAT ( _pn, "#,0" ) & " cidades" ) & " "
			        & "de " & _pp & IF ( RIGHT ( _pp, 3 ) = "mil", " habitantes", " de habitantes" )
			        & " e de renda " & SWITCH ( _pq, "mais ricas", "mais alta", "mais pobres", "mais baixa", "no " & _pq )
			VAR _verbo = IF ( _av < 0, "caiu", "subiu" )
			VAR _man =
			    IF ( NOT ISBLANK ( _uf ), _uf & ": n", "N" ) & "as " & _grupo & ", a margem de Lula " & _verbo & " "
			        & FORMAT ( ABS ( _av ) * 100, "0.0" ) & " pontos"
			VAR _txtEx =
			    IF ( _an = 1, "Só uma cidade: ", "São " & FORMAT ( _an, "#,0" ) & " cidades, como " )
			        & SUBSTITUTE ( SUBSTITUTE ( _ae, "&", "&amp;" ), "<", "&lt;" ) & "."
			VAR _txtMenor =
			    _grupoM & IF ( _mn > 3, ", como ", ": " ) & SUBSTITUTE ( SUBSTITUTE ( _me, "&", "&amp;" ), "<", "&lt;" ) & "."
			VAR _txtPos =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _pos ), "Com tão poucas cidades, a célula escolhida fica fora da comparação: um caso só pesa demais.",
			        _pos = 1, "A célula escolhida é a própria maior queda.",
			        _pos = _ncel, "A célula escolhida tem a menor queda entre as " & FORMAT ( _ncel, "0" )
			            & " células que entram na comparação.",
			        "A célula escolhida é a " & FORMAT ( _pos, "0" ) & "ª maior queda entre as " & FORMAT ( _ncel, "0" )
			            & " células que entram na comparação."
			    )
			VAR _blocoMenor =
			    IF (
			        _sel = 1,
			        "<div class='rot entra d6'>PARA COMPARAR · A MAIOR QUEDA</div>"
			            & "<div class='num v sobe d7'>" & FORMAT ( _pv * 100, "+0.0;−0.0;0.0" ) & "<small> p.p.</small></div>"
			            & "<div class='txt entra d8'>" & _grupoP & ". " & _txtPos & "</div>",
			        "<div class='rot entra d6'>" & IF ( _mv > 0, "ONDE A MARGEM DE LULA MAIS SUBIU", "A MENOR QUEDA" ) & "</div>"
			            & "<div class='num v sobe d7'>" & FORMAT ( _mv * 100, "+0.0;−0.0;0.0" ) & "<small> p.p.</small></div>"
			            & "<div class='txt entra d8'>" & _txtMenor & "</div>"
			    )
			VAR _clsAmostra =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _av ), "",
			        _av >= 0, " c0",
			        _av > -0.05, " c1",
			        _av > -0.08, " c2",
			        _av > -0.11, " c3",
			        _av > -0.14, " c4",
			        " c5"
			    )
			VAR _qual =
			    IF ( _sel = 1, "a célula que você clicou; clique nela de novo para voltar",
			        "a célula com contorno vermelho, na matriz" )
			-- 4 · Marcação
			RETURN
			    "<div class='tela t13r'>"
			        & "<div class='g num lula sobe'>" & FORMAT ( _av * 100, "+0.0;−0.0;0.0" ) & "<small> p.p.</small></div>"
			        & "<div class='man m1 sobe d2'>" & _man & "</div>"
			        & "<div class='txt ex entra d4'>" & _txtEx & "</div>"
			        & "<div class='menor'>" & _blocoMenor & "</div>"
			        & "<div class='ler'>"
			            & "<div class='rot entra d9'>COMO LER UMA CÉLULA</div>"
			            & "<div class='amostra" & _clsAmostra & " entra d10'><span class='num'>" & IF ( ISBLANK ( _av ), "—", FORMAT ( _av * 100, "+0.0;−0.0;0.0" ) )
			                & "</span><span class='n'>" & FORMAT ( _an, "#,0" ) & IF ( _an = 1, " cidade", " cidades" ) & "</span></div>"
			            & "<div class='nota qual entra d10'>" & _qual & "</div>"
			            & "<div class='mao a1 entra d11'>quanto a margem caiu</div>"
			            & "<div class='mao a2 entra d12'>quantas cidades</div>"
			            & "<svg class='setas' width='200' height='110' viewBox='0 0 200 110'>"
			                & "<path class='traco-rapido' style='animation-delay:1300ms' pathLength='1' d='M6,22 C30,18 46,20 62,26' "
			                & "fill='none' stroke='var(--grafite)' stroke-width='1.6' stroke-linecap='round'/>"
			                & "<path class='traco-rapido' style='animation-delay:1500ms' pathLength='1' d='M6,86 C30,84 46,80 62,72' "
			                & "fill='none' stroke='var(--grafite)' stroke-width='1.6' stroke-linecap='round'/>"
			            & "</svg>"
			            & "<div class='txt def entra d13'><b>Margem</b> é a diferença entre os votos de Lula e os do adversário, em "
			                & "pontos dos votos válidos. Cada célula soma os votos das suas cidades e compara 2022 com 2026; quanto "
			                & "mais escuro o azul, maior a queda.</div>"
			        & "</div>"
			    & "</div>"
		displayFolder: T13 Perfil\Desenho
		lineageTag: c985d347-5564-5d8e-bf17-88ffc1987617

	/// Texto alternativo do dossiê da célula.
	measure 'T13 · Tooltip célula · ALT' =
			-- 1 · Leituras
			VAR _cp = [T13 · porte da célula]
			VAR _cq = [T13 · quinto da célula]
			VAR _n = [T13 · cidades]
			VAR _vir = [T13 · cidades que viraram]
			VAR _m22 = [T13 · margem 2022]
			VAR _m26 = [T13 · margem 2026]
			-- 2 · Textos
			RETURN
			    "Cidades " & _cp & " e " & _cq & ": " & FORMAT ( _n, "#,0" ) & IF ( _n = 1, " cidade", " cidades" )
			        & "; a margem de Lula foi de " & FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" ) & " para " & FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" ) & " pontos; "
			        & FORMAT ( _vir, "#,0" ) & IF ( _vir = 1, " trocou", " trocaram" ) & " Lula por Flávio."
		displayFolder: T13 Perfil\Desenho
		lineageTag: f0a3bb0f-6b06-5f34-bb1b-224ca12ff0b0

	/// Dossiê da célula no tooltip da matriz: o carimbo com a posição na queda, o grupo de cidades e a população, a margem de Lula de 2022 a 2026 numa régua, como ficaram as cidades (seguiram com Lula, trocaram para Flávio, seguiram com o adversário) e as três maiores, cada uma com a sua variação. Só lê contas.
	measure 'T13 · Tooltip célula · HTML' =
			-- 1 · Leituras
			VAR _cp = [T13 · porte da célula]
			VAR _cq = [T13 · quinto da célula]
			VAR _uf = [T13 · recorte]
			VAR _n = [T13 · cidades]
			VAR _pop = [T13 · população]
			VAR _m22 = [T13 · margem 2022]
			VAR _m26 = [T13 · margem 2026]
			VAR _v = [T13 · variação]
			VAR _vir = [T13 · cidades que viraram]
			VAR _ll = [T13 · cidades com Lula à frente nas duas]
			VAR _aa = [T13 · cidades com o adversário à frente nas duas]
			VAR _pos = [T13 · posição da célula na queda]
			VAR _ncel = [T13 · células comparáveis]
			VAR _top =
			    TOPN (
			        3,
			        ADDCOLUMNS (
			            VALUES ( 'Município'[CodIBGE] ),
			            "@pop", [T13 · população],
			            "@nome", [T13 · nome da cidade],
			            "@v", [T13 · variação]
			        ),
			        [@pop], DESC,
			        'Município'[CodIBGE], ASC
			    ) /* lista */
			-- 2 · Textos
			VAR _grupo =
			    "cidades de " & _cp & IF ( RIGHT ( _cp, 3 ) = "mil", " habitantes", " de habitantes" )
			        & " e de renda " & SWITCH ( _cq, "mais ricas", "mais alta", "mais pobres", "mais baixa", "no " & _cq )
			VAR _tit = UPPER ( LEFT ( _cp, 1 ) ) & MID ( _cp, 2, 100 ) & IF ( RIGHT ( _cp, 3 ) = "mil", " habitantes", " de habitantes" )
			VAR _renda =
			    "renda " & SWITCH ( _cq, "mais ricas", "entre as mais ricas", "mais pobres", "entre as mais pobres", "no " & _cq )
			VAR _selo =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _pos ), "POUCAS CIDADES",
			        _v > 0, "SUBIU",
			        _pos = 1, "A MAIOR QUEDA",
			        _pos = _ncel, "A MENOR QUEDA",
			        FORMAT ( _pos, "0" ) & "ª MAIOR QUEDA"
			    )
			VAR _clsSelo = IF ( _pos = 1, "selo vm", "selo" )
			VAR _txtPop =
			    SWITCH (
			        TRUE (),
			        _pop >= 1000000, FORMAT ( _pop / 1000000, "0.0" ) & " mi de habitantes",
			        _pop >= 10000, FORMAT ( _pop / 1000, "#,0" ) & " mil habitantes",
			        FORMAT ( _pop, "#,0" ) & " habitantes"
			    )
			VAR _txtNota =
			    FORMAT ( _n, "#,0" ) & IF ( _n = 1, " cidade", " cidades" ) & " · " & _txtPop
			        & IF ( ISBLANK ( _uf ), "", " · " & _uf )
			VAR _txtM22 = FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" )
			VAR _txtM26 = FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" )
			VAR _mao =
			    SWITCH (
			        TRUE (),
			        _vir = 0 && _ll > _aa, "Lula segue à frente",
			        _vir = 0, "nenhuma virou",
			        _vir * 2 >= _n, "metade ou mais virou",
			        _vir * 10 >= _n, "1 em cada " & FORMAT ( ROUND ( _n / _vir, 0 ), "0" ) & " virou",
			        "poucas viraram"
			    )
			VAR _maiores =
			    CONCATENATEX (
			        _top,
			        VAR _nome = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [@nome], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			        RETURN
			            "<div class='mc'><span class='nm'>" & _nome & "</span><span class='vv " & IF ( [@v] < 0, "neg", "pos" )
			                & "'>" & FORMAT ( [@v] * 100, "+0.0;−0.0;0.0" ) & "</span></div>",
			        "",
			        [@pop], DESC
			    )
			-- 3 · Geometria (régua de 400 px: zero no meio, ±130 px; os valores ao lado dos pontos; barra das cidades de 400 px)
			VAR _esc = MAX ( 0.1, MAX ( ABS ( _m22 ), ABS ( _m26 ) ) ) /* geometria */
			VAR _x22 = 200 + 130 * _m22 / _esc
			VAR _x26 = 200 + 130 * _m26 / _esc
			VAR _esq22 = _x22 <= _x26
			VAR _sxE = FORMAT ( MIN ( _x22, _x26 ) - 12, "0.0", "en-US" )
			VAR _sxD = FORMAT ( MAX ( _x22, _x26 ) + 12, "0.0", "en-US" )
			VAR _cor = IF ( _m26 < 0, "var(--azul)", IF ( _m26 > 0, "var(--vermelho)", "var(--cinza)" ) )
			VAR _sx22 = FORMAT ( _x22, "0.0", "en-US" )
			VAR _sx26 = FORMAT ( _x26, "0.0", "en-US" )
			VAR _tot = MAX ( 1, _ll + _vir + _aa ) /* geometria */
			VAR _wll = 400 * _ll / _tot
			VAR _wvir = 400 * _vir / _tot
			VAR _waa = 400 * _aa / _tot
			-- 4 · Marcação
			RETURN
			    "<div class='tela tt13'><div class='fita'></div>"
			        & "<div class='" & _clsSelo & "'>" & _selo & "</div>"
			        & "<div class='nm sobe'>" & _tit & "</div>"
			        & "<div class='sub sobe d1'>" & _renda & "</div>"
			        & "<div class='nota sobe d1'>" & _txtNota & "</div>"
			        & "<div class='rot r1 entra d2'>MARGEM DE LULA NA CÉLULA · 2022 → 2026</div>"
			        & "<svg class='regua' width='400' height='54' viewBox='0 0 400 54'>"
			            & "<line x1='200' x2='200' y1='4' y2='38' class='zero'/>"
			            & "<text x='196' y='52' text-anchor='end' class='lado'>← adversário</text>"
			            & "<text x='204' y='52' class='lado'>Lula →</text>"
			            & "<line class='traco-rapido' pathLength='1' style='animation-delay:300ms' x1='" & _sx22 & "' x2='" & _sx26
			                & "' y1='22' y2='22'/>"
			            & "<circle cx='" & _sx22 & "' cy='22' r='6' class='m22'/>"
			            & "<circle class='brota' style='animation-delay:700ms' cx='" & _sx26 & "' cy='22' r='7' fill='" & _cor & "'/>"
			            & "<text x='" & _sxE & "' y='27' text-anchor='end'>" & IF ( _esq22, _txtM22, _txtM26 ) & "</text>"
			            & "<text x='" & _sxD & "' y='27'>" & IF ( _esq22, _txtM26, _txtM22 ) & "</text>"
			        & "</svg>"
			        & "<div class='rot r2 entra d3'>COMO FICARAM AS CIDADES · 2022 → 2026</div>"
			        & "<div class='pilha entra d4'>"
			            & "<i class='ll barra-x' style='width:" & FORMAT ( _wll, "0.0", "en-US" ) & "px'></i>"
			            & "<i class='vir barra-x' style='width:" & FORMAT ( _wvir, "0.0", "en-US" ) & "px'></i>"
			            & "<i class='aa barra-x' style='width:" & FORMAT ( _waa, "0.0", "en-US" ) & "px'></i>"
			        & "</div>"
			        & "<div class='leg entra d5'><span><i class='ll'></i>Lula nas duas <b>" & FORMAT ( _ll, "#,0" ) & "</b></span>"
			            & "<span><i class='vir'></i>viraram <b>" & FORMAT ( _vir, "#,0" ) & "</b></span>"
			            & "<span><i class='aa'></i>adversário nas duas <b>" & FORMAT ( _aa, "#,0" ) & "</b></span></div>"
			        & "<div class='rot r3 entra d6'>" & IF ( _n <= 3, "AS CIDADES", "AS MAIORES" ) & " · VARIAÇÃO DA MARGEM</div>"
			        & "<div class='maiores entra d7'>" & _maiores & "</div>"
			        & "<div class='mao entra d8'>" & _mao & "</div>"
			    & "</div>"
		displayFolder: T13 Perfil\Desenho
		lineageTag: c0a77a3e-ca89-50e3-81d1-a7798d591b65

	/// Votos do candidato sobre os válidos do ano (nacional, com o exterior).
	measure 'T14 · % do candidato' =
			DIVIDE ( SUM ( 'Candidato ano'[Votos] ), MAX ( 'Candidato ano'[ValidosAno] ) )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 63ca0f6e-cdd7-50c4-a13c-580eeb27a675

	/// Eleitores que faltaram sobre os aptos no ano do contexto (Brasil, sem o exterior).
	measure 'T14 · abstenção' =
			DIVIDE ( SUM ( 'Comparecimento ano'[Abstencoes] ), SUM ( 'Comparecimento ano'[Aptos] ) )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 94c974ca-792f-568d-a8a4-d513c1b136fa

	/// Adversário principal no ano do contexto.
	measure 'T14 · adversário' =
			SELECTEDVALUE ( 'Ano'[Adversário] )
		displayFolder: T14 Série\Contas
		lineageTag: 53a043ca-be1a-5fdc-b07a-b52178f9278d

	/// Votos do mais votado fora do PT sobre os válidos no ano do contexto (nacional com o exterior; com UF ou região, os municípios; a região vale por cima da UF).
	measure 'T14 · adversário %' =
			VAR _mun = ISCROSSFILTERED ( 'Município' )
			VAR _reg = ISFILTERED ( 'Município'[Região] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _reg,
			            CALCULATE (
			                DIVIDE ( SUM ( 'Município ano'[VotosAdversario] ), SUM ( 'Município ano'[Validos] ) ),
			                REMOVEFILTERS ( 'UF' )
			            ),
			        _mun, DIVIDE ( SUM ( 'Município ano'[VotosAdversario] ), SUM ( 'Município ano'[Validos] ) ),
			        DIVIDE (
			            CALCULATE ( MAX ( 'Candidato ano'[Votos] ), 'Candidato ano'[Partido] <> "PT" ),
			            MAX ( 'Candidato ano'[ValidosAno] )
			        )
			    )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: ba591267-49cf-5c25-9bce-97cfd4a52dc1

	/// adversário % na UF do contexto, na eleição em destaque (a clicada na série ou 2026), sem a região do painel e sem o recorte do filtro de estado (só a UF do contexto fica: o dossiê da região mostra todos os estados dela, como os painéis ignoram o filtro).
	measure 'T14 · adversário % da UF na eleição dos painéis' =
			VAR _a = [T14 · ano dos painéis]
			RETURN
			    CALCULATE (
			        [T14 · adversário %],
			        REMOVEFILTERS ( 'Município'[Região] ),
			        ALLEXCEPT ( 'UF', 'UF'[UF] ),
			        'Ano'[Ano] = _a
			    )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: ad1c9bc4-5a15-5ab4-8bf4-c765a86d7652

	/// Adversário % somando os municípios da região do contexto (ignora a UF).
	measure 'T14 · adversário % na região' =
			CALCULATE ( [T14 · adversário %], REMOVEFILTERS ( 'UF' ) )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: d8ab8d0c-a99f-5f98-98ce-aa4a6fab24ec

	/// Ano do contexto (a eleição).
	measure 'T14 · ano' =
			SELECTEDVALUE ( 'Ano'[Ano] )
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 6770a8f6-52ab-5d58-a572-e689095c3166

	/// A eleição que os painéis das regiões destacam: a clicada na série ou 2026.
	measure 'T14 · ano dos painéis' =
			VAR _a = [T14 · ano escolhido]
			RETURN
			    IF ( ISBLANK ( _a ), 2026, _a )
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: fd38701d-64c9-5823-9adb-58f793f09a74

	/// A eleição clicada na série (filtro cruzado no Ano); vazio sem clique.
	measure 'T14 · ano escolhido' =
			IF ( ISFILTERED ( 'Ano'[Ano] ) && HASONEVALUE ( 'Ano'[Ano] ), VALUES ( 'Ano'[Ano] ) )
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: cfff5cae-1b33-508a-a65d-ba0c32e11c13

	/// Candidato do PT no ano do contexto.
	measure 'T14 · candidato do PT' =
			SELECTEDVALUE ( 'Ano'[Candidato do PT] )
		displayFolder: T14 Série\Contas
		lineageTag: 724d0dd7-89ed-5cb2-88bd-522ffa92289c

	/// Quantas eleições há na série (seis, de 2006 a 2026).
	measure 'T14 · eleições' =
			COUNTROWS ( ALL ( 'Ano'[Ano] ) )
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 74f60207-c0c1-5c76-b3f1-55ccb171d441

	/// Em quantas eleições da série o PT terminou o 1º turno atrás do adversário.
	measure 'T14 · eleições com o PT atrás' =
			COUNTROWS (
			    FILTER ( ALL ( 'Ano'[Ano] ), [T14 · margem do PT] < 0 )
			) + 0
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 1f7bdb6f-8f4e-557f-aeaa-d19d50153558

	/// Em quantas eleições da série o PT terminou o 1º turno à frente do adversário.
	measure 'T14 · eleições com o PT à frente' =
			COUNTROWS (
			    FILTER ( ALL ( 'Ano'[Ano] ), [T14 · margem do PT] > 0 )
			) + 0
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: e40b87bf-67d5-59ee-bb17-4dd84f289fb1

	/// Maior valor da série (PT e adversário) no recorte, para a escala do gráfico.
	measure 'T14 · escala máxima' =
			MAXX (
			    ALL ( 'Ano'[Ano] ),
			    MAX ( [T14 · PT %], [T14 · adversário %] )
			)
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 358017d9-f85d-5af5-804a-cb2456b9a4f7

	/// Menor valor da série (PT e adversário) no recorte, para a escala do gráfico.
	measure 'T14 · escala mínima' =
			MINX (
			    ALL ( 'Ano'[Ano] ),
			    MIN ( [T14 · PT %], [T14 · adversário %] )
			)
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 1f66b300-227f-5e04-bcf9-2b734c6ae32e

	/// PT % menos adversário % no ano do contexto (negativo: o PT atrás).
	measure 'T14 · margem do PT' =
			[T14 · PT %] - [T14 · adversário %]
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 4c2eb72b-70eb-5aa8-9c3f-51275c82088a

	/// Ano do maior PT % da série no recorte.
	measure 'T14 · melhor ano do PT' =
			MAXX (
			    TOPN ( 1, ALL ( 'Ano'[Ano] ), [T14 · PT %], DESC, 'Ano'[Ano], ASC ),
			    'Ano'[Ano]
			)
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 77d2e3e6-dacc-5b5e-b8e9-8ea49817dbab

	/// O lugar com a preposição e o artigo certo, para as frases: 'no Nordeste' (região clicada ou inteira no filtro), 'na Bahia', 'em Minas Gerais', 'em MG e SP', 'em 3 estados' (medida comum [Recorte · em]); vazio = Brasil.
	measure 'T14 · onde' =
			VAR _reg = [T14 · região clicada]
			RETURN
			    IF (
			        NOT ISBLANK ( _reg ),
			        "no " & _reg,
			        IF ( [Recorte · com escolha] = 1, [Recorte · em] )
			    )
		displayFolder: T14 Série\Contas
		lineageTag: 1134d30f-621a-5dd4-b859-4a89859b6e4e

	/// Partido do adversário principal no ano do contexto.
	measure 'T14 · partido do adversário' =
			SELECTEDVALUE ( 'Ano'[Partido do adversário] )
		displayFolder: T14 Série\Contas
		lineageTag: 048847d1-f687-568e-8ce7-2f6f441e0dd5

	/// Partido do candidato do contexto.
	measure 'T14 · partido do candidato' =
			SELECTEDVALUE ( 'Candidato ano'[Partido] )
		displayFolder: T14 Série\Contas
		lineageTag: 3c162e82-10a0-5f35-824c-3ad6ad5e9262

	/// Ano do menor PT % da série no recorte.
	measure 'T14 · pior ano do PT' =
			MAXX (
			    TOPN ( 1, ALL ( 'Ano'[Ano] ), [T14 · PT %], ASC, 'Ano'[Ano], ASC ),
			    'Ano'[Ano]
			)
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: b50fbe4c-0065-5735-806d-1fe808d52fe4

	/// Colocação nacional do candidato do PT no 1º turno do ano do contexto.
	measure 'T14 · posição do PT' =
			CALCULATE ( MAX ( 'Candidato ano'[Posição] ), 'Candidato ano'[Partido] = "PT" )
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 70d6be9e-cfb0-59a3-8643-5ad4ff7c6224

	/// Votos do candidato do PT sobre os válidos no ano do contexto. Sem recorte de municípios, o resultado nacional oficial (com o exterior); com UF ou região, a soma dos municípios. A região (painel clicado ou do grão) vale por cima do filtro de UF.
	measure 'T14 · PT %' =
			VAR _mun = ISCROSSFILTERED ( 'Município' )
			VAR _reg = ISFILTERED ( 'Município'[Região] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _reg,
			            CALCULATE (
			                DIVIDE ( SUM ( 'Município ano'[VotosPT] ), SUM ( 'Município ano'[Validos] ) ),
			                REMOVEFILTERS ( 'UF' )
			            ),
			        _mun, DIVIDE ( SUM ( 'Município ano'[VotosPT] ), SUM ( 'Município ano'[Validos] ) ),
			        DIVIDE (
			            CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Candidato ano'[Partido] = "PT" ),
			            MAX ( 'Candidato ano'[ValidosAno] )
			        )
			    )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 9af3f27d-3598-5fcd-bd8e-9f49efe7213c

	/// PT % na UF do contexto, na eleição em destaque (a clicada na série ou 2026), sem a região do painel e sem o recorte do filtro de estado (só a UF do contexto fica: o dossiê da região mostra todos os estados dela, como os painéis ignoram o filtro).
	measure 'T14 · PT % da UF na eleição dos painéis' =
			VAR _a = [T14 · ano dos painéis]
			RETURN
			    CALCULATE (
			        [T14 · PT %],
			        REMOVEFILTERS ( 'Município'[Região] ),
			        ALLEXCEPT ( 'UF', 'UF'[UF] ),
			        'Ano'[Ano] = _a
			    )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: b0b7115a-befe-58f1-936a-35a6b91746a9

	/// PT % somando os municípios da região do contexto (ignora o filtro de UF).
	measure 'T14 · PT % na região' =
			CALCULATE ( [T14 · PT %], REMOVEFILTERS ( 'UF' ) )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 2c59b622-680a-58bc-ab11-92a67af3366f

	/// O maior PT % da série no recorte.
	measure 'T14 · PT % no melhor ano' =
			MAXX ( ALL ( 'Ano'[Ano] ), [T14 · PT %] )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: 1ff265e6-ae6b-5619-9a08-6849d6cfa983

	/// O menor PT % da série no recorte.
	measure 'T14 · PT % no pior ano' =
			MINX ( ALL ( 'Ano'[Ano] ), [T14 · PT %] )
		formatString: 0.0%
		displayFolder: T14 Série\Contas
		lineageTag: c290e44c-6789-5ded-a88d-ab6352baeacb

	/// 1 se o PT terminou 2026 atrás do adversário no recorte; 0 se não.
	measure 'T14 · PT atrás em 2026' =
			IF ( CALCULATE ( [T14 · margem do PT], 'Ano'[Ano] = 2026 ) < 0, 1, 0 )
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 495050d4-1ae5-57c7-b14a-b541c10a92af

	/// O lugar que a tela conta: a região clicada nos painéis ou o recorte do filtro de estado (árvore Região › Estado), pela medida comum [Recorte · nome]: 'Bahia', 'Nordeste', 'MG e SP', '3 estados'; vazio = Brasil.
	measure 'T14 · recorte' =
			VAR _reg = [T14 · região clicada]
			RETURN
			    IF ( NOT ISBLANK ( _reg ), _reg, IF ( [Recorte · com escolha] = 1, [Recorte · nome] ) )
		displayFolder: T14 Série\Contas
		lineageTag: 0fdb3041-ad5d-5be2-8470-9eafa365fd39

	/// O que da região do painel está no recorte, com 'de' e o artigo (medida comum [Recorte · de] só nessa região): 'da Bahia', 'de BA e SE', 'de 3 estados'; 'do Nordeste' quando a região está inteira; vazio sem estado dela.
	measure 'T14 · recorte na região do painel' =
			VAR _r = [T14 · região do painel]
			RETURN
			    IF (
			        [T14 · UFs do recorte na região do painel] > 0,
			        CALCULATE ( [Recorte · de], KEEPFILTERS ( 'UF'[Região] = _r ) )
			    )
		displayFolder: T14 Série\Contas
		lineageTag: bb6d217a-6ffc-59eb-b2cf-9ec177b80a6c

	/// A região clicada nos painéis (filtro cruzado em Município[Região]); vazio sem clique.
	measure 'T14 · região clicada' =
			IF (
			    ISFILTERED ( 'Município'[Região] ),
			    CALCULATE ( SELECTEDVALUE ( 'Município'[Região] ), REMOVEFILTERS ( 'UF' ) )
			)
		displayFolder: T14 Série\Contas
		lineageTag: b0003adc-8303-5c2a-ac56-7ba9b7825387

	/// A região do painel (grão dos painéis das regiões e do dossiê da região), mesmo com uma UF de outra região no filtro.
	measure 'T14 · região do painel' =
			CALCULATE ( SELECTEDVALUE ( 'Município'[Região] ), REMOVEFILTERS ( 'UF' ) )
		displayFolder: T14 Série\Contas
		lineageTag: 1ec56d0a-52c4-56ec-b400-0fbc6d4800b6

	/// As regiões que têm estados no recorte do filtro de estado, do Norte ao Sul ('Nordeste', 'Nordeste e Sudeste', 'Norte, Nordeste e Sul'); vazio = Brasil. Os painéis dessas regiões ficam em destaque.
	measure 'T14 · região do recorte' =
			VAR _r =
			    CALCULATETABLE ( SUMMARIZE ( 'UF', 'UF'[Região], 'UF'[RegiaoOrdem] ), KEEPFILTERS ( 'UF'[Tipo] = "UF" ) )
			VAR _n = COUNTROWS ( _r )
			VAR _ult = MAXX ( TOPN ( 1, _r, 'UF'[RegiaoOrdem], DESC ), 'UF'[Região] )
			VAR _resto = CONCATENATEX ( FILTER ( _r, 'UF'[Região] <> _ult ), 'UF'[Região], ", ", 'UF'[RegiaoOrdem], ASC )
			RETURN
			    IF ( [Recorte · com escolha] = 1 && _n > 0, IF ( _n = 1, _ult, _resto & " e " & _ult ) )
		displayFolder: T14 Série\Contas
		lineageTag: 69fc8dbc-3417-5c37-8142-9925ea4a0b64

	/// A sigla do estado escolhido na região do painel, quando é um só ('MS'); vazio nos outros casos. A nota do painel usa a sigla quando o nome não cabe ao lado do nome da região.
	measure 'T14 · sigla do recorte na região do painel' =
			VAR _r = [T14 · região do painel]
			RETURN
			    IF (
			        [T14 · UFs do recorte na região do painel] = 1,
			        CALCULATE ( SELECTEDVALUE ( 'UF'[UF] ), KEEPFILTERS ( 'UF'[Região] = _r ), KEEPFILTERS ( 'UF'[Tipo] = "UF" ) )
			    )
		displayFolder: T14 Série\Contas
		lineageTag: 62d7d43f-a858-53a6-a656-15cb47c5b9a1

	/// Quantas UFs tem a região do painel.
	measure 'T14 · UFs da região' =
			VAR _r = [T14 · região do painel]
			RETURN
			    COUNTROWS ( FILTER ( ALL ( 'UF'[UF], 'UF'[Região] ), 'UF'[Região] = _r ) ) + 0
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 60f9ac26-7806-5487-b869-c07972218b5c

	/// Quantas UFs da região do painel tiveram o PT à frente do adversário na eleição em destaque (a clicada ou 2026); ignora o recorte do filtro de estado, como os painéis.
	measure 'T14 · UFs da região com o PT à frente' =
			VAR _r = [T14 · região do painel]
			VAR _a = [T14 · ano dos painéis]
			RETURN
			    COUNTROWS (
			        FILTER (
			            ADDCOLUMNS (
			                FILTER ( ALL ( 'UF'[UF], 'UF'[Região] ), 'UF'[Região] = _r ),
			                "@m",
			                    CALCULATE (
			                        [T14 · margem do PT],
			                        REMOVEFILTERS ( 'Município'[Região] ),
			                        ALLEXCEPT ( 'UF', 'UF'[UF] ),
			                        'Ano'[Ano] = _a
			                    )
			            ),
			            [@m] > 0
			        )
			    ) + 0
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 139faea1-7078-5308-9552-812a260786cf

	/// Quantos estados da região do painel estão no recorte do filtro de estado (0 sem escolha ou sem estado dela).
	measure 'T14 · UFs do recorte na região do painel' =
			VAR _r = [T14 · região do painel]
			RETURN
			    IF (
			        [Recorte · com escolha] = 1,
			        CALCULATE ( COUNTROWS ( 'UF' ), KEEPFILTERS ( 'UF'[Região] = _r ), KEEPFILTERS ( 'UF'[Tipo] = "UF" ) )
			    ) + 0
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 7997e90f-41dd-5f51-bc77-e43a0b5c826b

	/// No ano do contexto, se o PT ficou atrás: quantas vezes isso já tinha acontecido até ali, contando este ano (1ª, 2ª…). Vazio se o PT ficou à frente.
	measure 'T14 · vez em que o PT ficou atrás' =
			VAR _ano = SELECTEDVALUE ( 'Ano'[Ano] )
			RETURN
			    IF (
			        [T14 · margem do PT] < 0,
			        COUNTROWS ( FILTER ( ALL ( 'Ano'[Ano] ), 'Ano'[Ano] <= _ano && [T14 · margem do PT] < 0 ) )
			    )
		formatString: 0
		displayFolder: T14 Série\Contas
		lineageTag: 2b7ad19f-1d46-5438-821a-66d6d9196d66

	/// Votos do candidato no 1º turno (nacional, com o exterior).
	measure 'T14 · votos do candidato' =
			SUM ( 'Candidato ano'[Votos] )
		formatString: #,0
		displayFolder: T14 Série\Contas
		lineageTag: c79da9fa-51c8-59f9-bbc8-e3ac53d88a0a

	/// Texto alternativo do título do gráfico.
	measure 'T14 · Linhas título · ALT' =
			-- 1 · Leituras
			VAR _ma = [T14 · melhor ano do PT]
			VAR _pa = [T14 · pior ano do PT]
			-- 2 · Textos
			RETURN
			    "Linhas do PT e do adversário principal, de 2006 a 2026. Melhor ano do PT: " & _ma & "; pior: " & _pa & "."
		displayFolder: T14 Série\Desenho
		lineageTag: 666af5fe-e9d9-51b7-9e02-75c1318159ec

	/// Sobretítulo, manchete do gráfico (melhor e pior ano do PT) e a legenda.
	measure 'T14 · Linhas título · HTML' =
			-- 1 · Leituras
			VAR _ma = [T14 · melhor ano do PT]
			VAR _pa = [T14 · pior ano do PT]
			VAR _mv = [T14 · PT % no melhor ano]
			VAR _pv = [T14 · PT % no pior ano]
			VAR _uf = [T14 · recorte]
			-- 2 · Textos
			VAR _man =
			    "O PT teve o melhor resultado em " & _ma & " (" & FORMAT ( _mv, "0.0%" ) & ") e o pior em " & _pa & " ("
			        & FORMAT ( _pv, "0.0%" ) & ")"
			-- 4 · Marcação
			RETURN
			    "<div class='tela t14t'>"
			        & "<div class='rot entra'>% DOS VOTOS VÁLIDOS NO 1º TURNO · PT × ADVERSÁRIO PRINCIPAL"
			            & IF ( ISBLANK ( _uf ), " · BRASIL", " · " & UPPER ( _uf ) ) & "</div>"
			        & "<div class='man sobe d1'>" & _man & "</div>"
			        & "<div class='leg entra d2'><span><i class='pt'></i>PT</span><span><i class='adv'></i>adversário principal: o "
			            & "mais votado fora do PT no ano</span><span><i class='subl'></i>PT atrás</span></div>"
			    & "</div>"
		displayFolder: T14 Série\Desenho
		lineageTag: 86635174-2352-5e25-8ad8-b59ec99999b4

	/// Texto alternativo do gráfico de linhas.
	measure 'T14 · Linhas · ALT' =
			-- 1 · Leituras
			VAR _k = [T14 · eleições com o PT atrás]
			VAR _uf = [T14 · recorte]
			-- 2 · Textos
			RETURN
			    "Gráfico de linhas, " & IF ( ISBLANK ( _uf ), "Brasil", _uf ) & ": % dos votos válidos do PT e do adversário "
			        & "principal em cada 1º turno de 2006 a 2026; o PT ficou atrás em " & FORMAT ( _k, "0" ) & " delas. Clique "
			        & "num ano para levar a resposta e as regiões àquela eleição."
		displayFolder: T14 Série\Desenho
		lineageTag: ed5927b3-85fc-56f7-91b4-7b80d832b3f6

	/// Uma entrada por eleição (granularidade Ano): os pontos do PT e do adversário com o rótulo, o trecho de linha até a eleição seguinte (que se desenha em sequência), o sublinhado à mão sob o PT quando ele ficou atrás e o eixo com os candidatos. A 1ª eleição desenha a grade. Escala pelas contas 'T14 · escala …'. O clique num ano leva a resposta e os painéis das regiões àquela eleição.
	measure 'T14 · Linhas · HTML' =
			-- 1 · Leituras
			VAR _ano = [T14 · ano]
			VAR _pt = [T14 · PT %]
			VAR _adv = [T14 · adversário %]
			VAR _ptN = CALCULATE ( [T14 · PT %], 'Ano'[Ano] = _ano + 4 )
			VAR _advN = CALCULATE ( [T14 · adversário %], 'Ano'[Ano] = _ano + 4 )
			VAR _cpt = [T14 · candidato do PT]
			VAR _cadv = [T14 · adversário]
			VAR _part = [T14 · partido do adversário]
			VAR _min = [T14 · escala mínima]
			VAR _max = [T14 · escala máxima]
			-- 2 · Textos
			VAR _cptCurto = SWITCH ( _cpt, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", _cpt )
			VAR _cadvCurto =
			    SWITCH ( _cadv, "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio",
			        "Jair Bolsonaro", "Bolsonaro", _cadv )
			VAR _atras = _pt < _adv
			-- 3 · Geometria (anos a cada 276 px a partir de x 120; valores de y 30 a 270 entre o piso e o teto da escala)
			VAR _lo = FLOOR ( _min * 100 - 4, 10 ) / 100
			VAR _hi = CEILING ( _max * 100 + 4, 10 ) / 100
			VAR _i = ( _ano - 2006 ) / 4
			VAR _x = 120 + _i * 276
			VAR _yPt = 270 - 240 * ( _pt - _lo ) / ( _hi - _lo )
			VAR _yAdv = 270 - 240 * ( _adv - _lo ) / ( _hi - _lo )
			VAR _yPtN = 270 - 240 * ( _ptN - _lo ) / ( _hi - _lo )
			VAR _yAdvN = 270 - 240 * ( _advN - _lo ) / ( _hi - _lo )
			VAR _f = FORMAT ( _x, "0.0", "en-US" )
			VAR _fN = FORMAT ( _x + 276, "0.0", "en-US" )
			VAR _atraso = 300 + _i * 380
			VAR _ptCima = _pt >= _adv
			VAR _yRotPt = IF ( _ptCima, _yPt - 38, _yPt + 12 )
			VAR _grade =
			    IF (
			        _ano = 2006,
			        CONCATENATEX (
			            GENERATESERIES ( _lo * 100, _hi * 100, 10 ),
			            VAR _yy = 270 - 240 * ( [Value] / 100 - _lo ) / ( _hi - _lo )
			            RETURN
			                "<line class='g' x1='70' x2='1560' y1='" & FORMAT ( _yy, "0.0", "en-US" ) & "' y2='"
			                    & FORMAT ( _yy, "0.0", "en-US" ) & "'/><text class='tk' x='58' y='" & FORMAT ( _yy + 4, "0.0", "en-US" )
			                    & "' text-anchor='end'>" & [Value] & "%</text>",
			            ""
			        ) & "<line class='base' x1='70' x2='1560' y1='290' y2='290'/>"
			    )
			VAR _seg =
			    IF (
			        NOT ISBLANK ( _ptN ),
			        "<line class='lpt traco' pathLength='1' style='animation-delay:" & _atraso & "ms' x1='" & _f & "' y1='"
			            & FORMAT ( _yPt, "0.0", "en-US" ) & "' x2='" & _fN & "' y2='" & FORMAT ( _yPtN, "0.0", "en-US" ) & "'/>"
			            & "<line class='ladv traco' pathLength='1' style='animation-delay:" & _atraso & "ms' x1='" & _f & "' y1='"
			            & FORMAT ( _yAdv, "0.0", "en-US" ) & "' x2='" & _fN & "' y2='" & FORMAT ( _yAdvN, "0.0", "en-US" ) & "'/>"
			    )
			VAR _sublinha =
			    IF (
			        _atras,
			        VAR _yy = _yRotPt + 27
			        RETURN
			            "<path class='subl traco' pathLength='1' style='animation-delay:" & ( _atraso + 900 ) & "ms' d='M"
			                & FORMAT ( _x - 36, "0.0", "en-US" ) & "," & FORMAT ( _yy + 1, "0.0", "en-US" ) & " C"
			                & FORMAT ( _x - 12, "0.0", "en-US" ) & "," & FORMAT ( _yy - 2, "0.0", "en-US" ) & " "
			                & FORMAT ( _x + 12, "0.0", "en-US" ) & "," & FORMAT ( _yy + 3, "0.0", "en-US" ) & " "
			                & FORMAT ( _x + 38, "0.0", "en-US" ) & "," & FORMAT ( _yy - 1, "0.0", "en-US" ) & "'/>"
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _pt ),
			        "<div class='tela ano'>"
			            & "<div class='alvo' style='left:" & FORMAT ( _x - 128, "0.0", "en-US" ) & "px'></div>"
			            & "<svg class='sv' width='1620' height='370' viewBox='0 0 1620 370'>"
			                & _grade & _seg & _sublinha
			                & "<circle class='ppt brota' style='animation-delay:" & ( _atraso - 120 ) & "ms' cx='" & _f & "' cy='"
			                    & FORMAT ( _yPt, "0.0", "en-US" ) & "' r='7.5'/>"
			                & "<circle class='padv brota' style='animation-delay:" & ( _atraso - 120 ) & "ms' cx='" & _f & "' cy='"
			                    & FORMAT ( _yAdv, "0.0", "en-US" ) & "' r='7.5'/>"
			            & "</svg>"
			            & "<div class='vl vpt sobe' style='left:" & FORMAT ( _x - 60, "0.0", "en-US" ) & "px;top:"
			                & FORMAT ( _yRotPt, "0.0", "en-US" ) & "px;animation-delay:" & ( _atraso + 200 )
			                & "ms'>" & FORMAT ( _pt, "0.0%" ) & "</div>"
			            & "<div class='vl vadv sobe' style='left:" & FORMAT ( _x - 60, "0.0", "en-US" ) & "px;top:"
			                & FORMAT ( IF ( _ptCima, _yAdv + 12, _yAdv - 38 ), "0.0", "en-US" ) & "px;animation-delay:" & ( _atraso + 200 )
			                & "ms'>" & FORMAT ( _adv, "0.0%" ) & "</div>"
			            & "<div class='xl entra' style='left:" & FORMAT ( _x - 128, "0.0", "en-US" ) & "px;animation-delay:" & _atraso
			                & "ms'><b>" & _ano & "</b><span>" & _cptCurto & " × " & _cadvCurto & " · " & _part & "</span></div>"
			        & "</div>"
			    )
		displayFolder: T14 Série\Desenho
		lineageTag: c272a225-7e56-5f7e-a66b-327eca7eef00

	/// Texto alternativo das regiões.
	measure 'T14 · Regiões · ALT' =
			-- 1 · Leituras
			VAR _sel = [T14 · região do recorte]
			-- 2 · Textos
			RETURN
			    "Cinco pequenos gráficos, um por região, com o PT e o adversário de 2006 a 2026 na mesma escala"
			        & IF ( ISBLANK ( _sel ), ".", "; em destaque, " & _sel & "." ) & " Clique numa região para ver a série dela."
		displayFolder: T14 Série\Desenho
		lineageTag: 4500ad33-dfa6-59ae-84b0-44d8d34fc685

	/// Uma entrada por região (granularidade Município[Região]), todas na mesma escala (10% a 70%): as linhas do PT e do adversário de 2006 a 2026 e os valores da eleição em destaque (a clicada na série ou 2026). Ignoram o filtro de estado; cada região com estado escolhido fica em destaque, com o que dela está no filtro ('região escolhida', 'região da Bahia', 'região de BA e SE'). O clique numa região leva a série e a resposta àquela região; o mouse abre o dossiê dela (ttT14Regiao).
	measure 'T14 · Regiões · HTML' =
			-- 1 · Leituras
			VAR _r = [T14 · região do painel]
			VAR _nRec = [T14 · UFs do recorte na região do painel]
			VAR _nUf = [T14 · UFs da região]
			VAR _deRec = [T14 · recorte na região do painel]
			VAR _siglaRec = [T14 · sigla do recorte na região do painel]
			VAR _ano = [T14 · ano dos painéis]
			VAR _clique = NOT ISBLANK ( [T14 · ano escolhido] )
			VAR _anos = DATATABLE ( "a", INTEGER, { { 2006 }, { 2010 }, { 2014 }, { 2018 }, { 2022 }, { 2026 } } )
			VAR _pts =
			    ADDCOLUMNS (
			        _anos,
			        "@pt", VAR _a = [a] RETURN CALCULATE ( [T14 · PT % na região], 'Ano'[Ano] = _a ),
			        "@adv", VAR _a = [a] RETURN CALCULATE ( [T14 · adversário % na região], 'Ano'[Ano] = _a )
			    )
			-- 3 · Geometria e 4 · Marcação (painéis de 300 px a cada 330; x do ano de 8 a 218; y de 10% a 70% em 110 px)
			VAR _o = SWITCH ( _r, "Centro-Oeste", 1, "Nordeste", 2, "Norte", 3, "Sudeste", 4, "Sul", 5, 0 )
			VAR _px = ( _o - 1 ) * 330
			VAR _xy =
			    ADDCOLUMNS (
			        _pts,
			        "@x", 8 + ( [a] - 2006 ) / 4 * 42,
			        "@yPt", 112 - 96 * ( MAX ( 0.1, MIN ( 0.7, [@pt] ) ) - 0.1 ) / 0.6,
			        "@yAdv", 112 - 96 * ( MAX ( 0.1, MIN ( 0.7, [@adv] ) ) - 0.1 ) / 0.6
			    )
			VAR _lPt =
			    CONCATENATEX ( _xy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yPt], "0.0", "en-US" ), " ", [a], ASC )
			VAR _lAdv =
			    CONCATENATEX ( _xy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yAdv], "0.0", "en-US" ), " ", [a], ASC )
			VAR _ptA = MAXX ( FILTER ( _xy, [a] = _ano ), [@pt] ) /* lista */
			VAR _advA = MAXX ( FILTER ( _xy, [a] = _ano ), [@adv] ) /* lista */
			VAR _yApt = MAXX ( FILTER ( _xy, [a] = _ano ), [@yPt] ) /* lista */
			VAR _yAadv = MAXX ( FILTER ( _xy, [a] = _ano ), [@yAdv] ) /* lista */
			VAR _xA = 8 + ( _ano - 2006 ) / 4 * 42
			VAR _sep = IF ( ABS ( _yApt - _yAadv ) < 16, 8 - ABS ( _yApt - _yAadv ) / 2, 0 )
			VAR _cls = IF ( _nRec > 0, "pn sel", "pn" )
			-- a nota à mão cabe ao lado do nome no painel de 300 px (nome ~9,6 px por letra, Caveat ~8): "região da Bahia"; com
			-- o nome comprido, a sigla ("região de MS" no Centro-Oeste, "região de RN" no Nordeste)
			VAR _cabe = INT ( ( 292 - 9.6 * LEN ( _r ) ) / 8 ) -- geometria
			VAR _nota1 = "região " & _deRec
			VAR _nota =
			    SWITCH (
			        TRUE (),
			        _nRec = _nUf, "região escolhida",
			        LEN ( _nota1 ) <= _cabe || ISBLANK ( _siglaRec ), _nota1,
			        "região de " & _siglaRec
			    )
			VAR _marca =
			    IF (
			        _clique,
			        "<line class='mk' x1='" & FORMAT ( _xA, "0.0", "en-US" ) & "' x2='" & FORMAT ( _xA, "0.0", "en-US" )
			            & "' y1='4' y2='116'/>"
			            & "<text class='ex' x='" & FORMAT ( _xA, "0.0", "en-US" ) & "' y='130' text-anchor='middle'>" & _ano & "</text>"
			    )
			VAR _eixo =
			    IF (
			        _clique && _ano > 2006 && _ano < 2026,
			        "<text class='ex' x='0' y='130'>2006</text>",
			        "<text class='ex' x='0' y='130'>2006</text><text class='ex' x='218' y='130' text-anchor='middle'>2026</text>"
			    )
			RETURN
			    IF (
			        _o > 0,
			        "<div class='tela t14g'><div class='" & _cls & " sobe d" & ( 2 + _o ) & "' style='left:" & _px & "px'>"
			            & "<div class='nm'>" & _r & IF ( _nRec > 0, " <span class='mao'>" & _nota & "</span>", "" )
			            & "</div>"
			            & "<svg width='300' height='132' viewBox='0 0 300 132'>"
			                & "<line class='b' x1='0' x2='226' y1='116' y2='116'/>"
			                & _marca
			                & "<polyline class='lpt traco' pathLength='1' style='animation-delay:" & ( 600 + _o * 120 )
			                    & "ms' points='" & _lPt & "'/>"
			                & "<polyline class='ladv traco' pathLength='1' style='animation-delay:" & ( 600 + _o * 120 )
			                    & "ms' points='" & _lAdv & "'/>"
			                & "<circle class='ppt' cx='" & FORMAT ( _xA, "0.0", "en-US" ) & "' cy='" & FORMAT ( _yApt, "0.0", "en-US" )
			                    & "' r='4'/>"
			                & "<circle class='padv' cx='" & FORMAT ( _xA, "0.0", "en-US" ) & "' cy='"
			                    & FORMAT ( _yAadv, "0.0", "en-US" ) & "' r='4'/>"
			                & "<text class='vpt' x='" & FORMAT ( _xA + 10, "0.0", "en-US" ) & "' y='"
			                    & FORMAT ( _yApt + 5 + IF ( _yApt >= _yAadv, _sep, -_sep ), "0.0", "en-US" )
			                    & "'>" & FORMAT ( _ptA, "0.0%" ) & "</text>"
			                & "<text class='vadv' x='" & FORMAT ( _xA + 10, "0.0", "en-US" ) & "' y='"
			                    & FORMAT ( _yAadv + 5 + IF ( _yAadv > _yApt, _sep, -_sep ), "0.0", "en-US" )
			                    & "'>" & FORMAT ( _advA, "0.0%" ) & "</text>"
			                & _eixo
			            & "</svg>"
			        & "</div></div>"
			    )
		displayFolder: T14 Série\Desenho
		lineageTag: e2d3b1e9-fbe1-554d-95b7-98f246506362

	/// Texto alternativo do topo da tela.
	measure 'T14 · Resposta · ALT' =
			-- 1 · Leituras
			VAR _k = [T14 · eleições com o PT atrás]
			VAR _a26 = [T14 · PT atrás em 2026]
			VAR _uf = [T14 · recorte]
			VAR _ano = [T14 · ano escolhido]
			VAR _mY = [T14 · margem do PT]
			-- 2 · Textos
			RETURN
			    IF ( ISBLANK ( _uf ), "Brasil", _uf ) & ": o PT terminou o 1º turno atrás do adversário em " & FORMAT ( _k, "0" )
			        & " das seis eleições de 2006 a 2026" & IF ( _a26 = 1, ", inclusive em 2026.", "; em 2026, à frente." )
			        & IF ( ISBLANK ( _ano ), "", " Em " & _ano & ", a margem do PT foi de " & FORMAT ( _mY * 100, "+0.0;−0.0;0.0" )
			            & " pontos." )
		displayFolder: T14 Série\Desenho
		lineageTag: 7fdeb229-588f-51c7-8f0b-81095a7519a6

	/// Topo da tela. Sem clique: quantas vezes o PT terminou o 1º turno atrás (ou à frente) e em quais anos, com os candidatos, e as seis urnas. Com um ano clicado na série: a margem do PT naquela eleição, a manchete do duelo e a urna do ano em destaque. Com uma região clicada, tudo no lugar dela ('no Nordeste'). Só lê contas 'T14 · …'.
	measure 'T14 · Resposta · HTML' =
			-- 1 · Leituras
			VAR _k = [T14 · eleições com o PT atrás]
			VAR _n = [T14 · eleições]
			VAR _a26 = [T14 · PT atrás em 2026]
			VAR _uf = [T14 · recorte]
			VAR _ondeR = [T14 · onde]
			VAR _ano = [T14 · ano escolhido]
			VAR _mY = [T14 · margem do PT]
			VAR _ptY = [T14 · PT %]
			VAR _advY = [T14 · adversário %]
			VAR _cptY = [T14 · candidato do PT]
			VAR _cadvY = [T14 · adversário]
			VAR _vezY = [T14 · vez em que o PT ficou atrás]
			VAR _anos =
			    ADDCOLUMNS (
			        DATATABLE ( "a", INTEGER, { { 2006 }, { 2010 }, { 2014 }, { 2018 }, { 2022 }, { 2026 } } ),
			        "@m", VAR _a = [a] RETURN CALCULATE ( [T14 · margem do PT], 'Ano'[Ano] = _a ),
			        "@pt", VAR _a = [a] RETURN CALCULATE ( [T14 · PT %], 'Ano'[Ano] = _a ),
			        "@adv", VAR _a = [a] RETURN CALCULATE ( [T14 · adversário %], 'Ano'[Ano] = _a ),
			        "@cpt", VAR _a = [a] RETURN CALCULATE ( [T14 · candidato do PT], 'Ano'[Ano] = _a ),
			        "@cadv", VAR _a = [a] RETURN CALCULATE ( [T14 · adversário], 'Ano'[Ano] = _a ),
			        "@vez", VAR _a = [a] RETURN CALCULATE ( [T14 · vez em que o PT ficou atrás], 'Ano'[Ano] = _a )
			    ) /* lista */
			-- 2 · Textos
			VAR _clique = NOT ISBLANK ( _ano )
			VAR _atras = FILTER ( _anos, [@m] < 0 ) /* lista */
			VAR _nAtras = COUNTROWS ( _atras ) /* lista */
			VAR _txtAnos =
			    CONCATENATEX (
			        _atras,
			        "em " & [a] & " (" & [@cpt] & " " & FORMAT ( [@pt], "0.0%" ) & " × " & [@cadv] & " " & FORMAT ( [@adv], "0.0%" ) & ")",
			        "; ",
			        [a], ASC
			    )
			VAR _grande =
			    SWITCH (
			        TRUE (),
			        _clique, FORMAT ( _mY * 100, "+0.0;−0.0;0.0" ) & "<small> p.p.</small>",
			        _k = _n, FORMAT ( _k, "0" ) & " de " & FORMAT ( _n, "0" ),
			        _a26 = 1, FORMAT ( _k, "0" ) & "ª vez",
			        FORMAT ( _n - _k, "0" ) & " de " & FORMAT ( _n, "0" )
			    )
			VAR _clsGrande = IF ( _clique, IF ( _mY < 0, " flavio", " lula" ), "" )
			VAR _onde = IF ( ISBLANK ( _ondeR ), "", " " & _ondeR )
			VAR _abre = IF ( ISBLANK ( _ondeR ), "Em " & _ano, UPPER ( LEFT ( _ondeR, 1 ) ) & MID ( _ondeR, 2, 100 ) & ", em " & _ano )
			VAR _manAno =
			    _abre & ", " & SWITCH ( _cptY, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Bolsonaro", _cptY ) & " (" & FORMAT ( _ptY, "0.0%" ) & ") terminou " & FORMAT ( ABS ( _mY ) * 100, "0.0" )
			        & IF ( _mY < 0, " pontos atrás de ", " pontos à frente de " ) & SWITCH ( _cadvY, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Bolsonaro", _cadvY ) & " (" & FORMAT ( _advY, "0.0%" ) & ")"
			VAR _man =
			    SWITCH (
			        TRUE (),
			        _clique, _manAno,
			        _k = _n, IF ( ISBLANK ( _uf ), "", _uf & ": " ) & "o PT terminou o 1º turno atrás do adversário nas seis eleições",
			        _a26 = 1 && ISBLANK ( _uf ),
			            "Pela " & FORMAT ( _k, "0" ) & "ª vez em seis eleições, o PT termina o 1º turno em segundo lugar",
			        _a26 = 1,
			            _uf & ": pela " & FORMAT ( _k, "0" ) & "ª vez em seis eleições, o PT termina o 1º turno atrás do adversário",
			        _k = 0, "O PT ficou à frente nas seis eleições" & _onde & ", inclusive em 2026",
			        "O PT ficou à frente em " & FORMAT ( _n - _k, "0" ) & " das seis eleições" & _onde & ", inclusive em 2026"
			    )
			VAR _soAnos = CONCATENATEX ( _atras, [a], ", ", [a], ASC )
			VAR _sub =
			    SWITCH (
			        TRUE (),
			        _clique && NOT ISBLANK ( _vezY ),
			            "Foi a " & FORMAT ( _vezY, "0" ) & "ª vez em seis eleições que o PT ficou atrás" & _onde
			                & ". Clique de novo no ano para voltar às seis eleições.",
			        _clique, "O PT ficou à frente" & _onde & " nessa eleição. Clique de novo no ano para voltar às seis eleições.",
			        _nAtras = 0, "",
			        _nAtras <= 2, "Atrás " & _txtAnos & ".",
			        "Atrás em " & _soAnos & "."
			    )
			-- 3 · Geometria e 4 · Marcação (urnas de 76 px a cada 92, a partir de x 1086)
			VAR _urnas =
			    CONCATENATEX (
			        _anos,
			        VAR _i = ( [a] - 2006 ) / 4
			        VAR _vez = [@vez]
			        VAR _apaga = IF ( _clique && [a] <> _ano, " apaga", "" )
			        RETURN
			            "<div class='ux " & IF ( [@m] < 0, "adv", "pt" ) & _apaga & " brota' style='left:" & ( 1086 + _i * 92 )
			                & "px;animation-delay:" & ( 500 + _i * 140 ) & "ms'></div>"
			                & "<div class='ua" & _apaga & "' style='left:" & ( 1086 + _i * 92 ) & "px'>" & [a] & "</div>"
			                & IF (
			                    NOT ISBLANK ( _vez ),
			                    "<div class='uv mao entra" & _apaga & "' style='left:" & ( 1086 + _i * 92 ) & "px;animation-delay:"
			                        & ( 900 + _i * 140 ) & "ms'>" & FORMAT ( _vez, "0" ) & "ª vez</div>"
			                ),
			        "",
			        [a], ASC
			    )
			RETURN
			    "<div class='tela t14r'>"
			        & "<div class='num g" & _clsGrande & " sobe'>" & _grande & "</div>"
			        & "<div class='man m sobe d2'>" & _man & "</div>"
			        & "<div class='nota s entra d4'>" & _sub & "</div>"
			        & "<div class='rot ur entra d3'>QUEM TERMINOU NA FRENTE, ELEIÇÃO A ELEIÇÃO</div>"
			        & _urnas
			        & "<div class='nota ul entra d8'>urna vermelha: o PT à frente · azul: o adversário</div>"
			    & "</div>"
		displayFolder: T14 Série\Desenho
		lineageTag: 40d791ed-3a0a-5245-80b3-53ffc261c449

	/// Texto alternativo do dossiê da eleição.
	measure 'T14 · Tooltip ano · ALT' =
			-- 1 · Leituras
			VAR _ano = [T14 · ano]
			VAR _pos = [T14 · posição do PT]
			-- 2 · Textos
			RETURN
			    "Eleição de " & _ano & ": o PT ficou em " & FORMAT ( _pos, "0" ) & "º lugar no 1º turno."
		displayFolder: T14 Série\Desenho
		lineageTag: 303495b8-f63d-5143-8069-4238c77d64fe

	/// Dossiê da eleição no tooltip da série: os quatro mais votados no Brasil (com o exterior), a colocação do PT e a abstenção. Só lê contas.
	measure 'T14 · Tooltip ano · HTML' =
			-- 1 · Leituras
			VAR _ano = [T14 · ano]
			VAR _pos = [T14 · posição do PT]
			VAR _abs = [T14 · abstenção]
			VAR _cand =
			    TOPN (
			        4,
			        ADDCOLUMNS (
			            VALUES ( 'Candidato ano'[Candidato] ),
			            "@v", [T14 · votos do candidato],
			            "@p", [T14 · % do candidato],
			            "@pa", [T14 · partido do candidato]
			        ),
			        [@v], DESC,
			        'Candidato ano'[Candidato], ASC
			    )
			-- 2 · Textos
			VAR _selo = "PT EM " & FORMAT ( _pos, "0" ) & "º"
			VAR _clsSelo = IF ( _pos = 1, "selo vm", "selo az" )
			VAR _mao = IF ( _pos = 1, "o PT venceu o 1º turno", "o PT ficou em " & FORMAT ( _pos, "0" ) & "º" )
			-- 3 · Geometria e 4 · Marcação (barras: 60% = 140 px)
			VAR _maxOutro = MAXX ( FILTER ( _cand, [@pa] <> "PT" ), [@v] ) /* lista */
			VAR _linhas =
			    CONCATENATEX (
			        _cand,
			        VAR _cor = SWITCH ( TRUE (), [@pa] = "PT", "pt", [@v] = _maxOutro, "adv", "o" )
			        VAR _w = MIN ( 140, 140 * [@p] / 0.6 )
			        RETURN
			            "<div class='cl'><span class='nm'>" & 'Candidato ano'[Candidato] & " <i>" & [@pa] & "</i></span>"
			                & "<span class='tr'><b class='barra-x " & _cor & "' style='width:" & FORMAT ( _w, "0.0", "en-US" )
			                & "px'></b></span><span class='pc'>" & FORMAT ( [@p], "0.0%" ) & "</span></div>",
			        "",
			        [@v], DESC
			    )
			RETURN
			    "<div class='tela tt14'><div class='fita'></div>"
			        & "<div class='" & _clsSelo & "'>" & _selo & "</div>"
			        & "<div class='an sobe'>" & _ano & " · 1º turno</div>"
			        & "<div class='rot entra d1'>OS MAIS VOTADOS NO BRASIL</div>"
			        & "<div class='lista entra d2'>" & _linhas & "</div>"
			        & "<div class='nota entra d4'>Faltaram " & FORMAT ( _abs, "0.0%" ) & " dos eleitores. Votos válidos, com o exterior.</div>"
			        & "<div class='mao entra d6'>" & _mao & "</div>"
			    & "</div>"
		displayFolder: T14 Série\Desenho
		lineageTag: 7f89ce50-a858-5989-aa2b-14729f75a20a

	/// Texto alternativo do dossiê da região.
	measure 'T14 · Tooltip região · ALT' =
			-- 1 · Leituras
			VAR _r = [T14 · região do painel]
			VAR _ano = [T14 · ano dos painéis]
			VAR _nUf = [T14 · UFs da região]
			VAR _nPt = [T14 · UFs da região com o PT à frente]
			-- 2 · Textos
			RETURN
			    _r & ", " & _ano & ": o PT ficou à frente em " & FORMAT ( _nPt, "0" ) & " de " & FORMAT ( _nUf, "0" )
			        & IF ( _nUf = 1, " estado.", " estados." )
		displayFolder: T14 Série\Desenho
		lineageTag: cf405219-02d8-5820-ad03-bb862e023eba

	/// Dossiê da região no tooltip dos painéis: os estados dela na eleição em destaque (a clicada na série ou 2026), cada um com o duelo PT × adversário em barras, do mais petista ao menos; quantos tiveram o PT à frente e em quantas das seis eleições o PT ficou à frente na região. Só lê contas.
	measure 'T14 · Tooltip região · HTML' =
			-- 1 · Leituras
			VAR _r = [T14 · região do painel]
			VAR _ano = [T14 · ano dos painéis]
			VAR _fr = [T14 · eleições com o PT à frente]
			VAR _n = [T14 · eleições]
			VAR _nUf = [T14 · UFs da região]
			VAR _nPt = [T14 · UFs da região com o PT à frente]
			VAR _cpt = CALCULATE ( [T14 · candidato do PT], 'Ano'[Ano] = _ano )
			VAR _cadv = CALCULATE ( [T14 · adversário], 'Ano'[Ano] = _ano )
			VAR _todas = DATATABLE ( "uf", STRING, "reg", STRING, { { "AC", "Norte" }, { "AL", "Nordeste" }, { "AM", "Norte" }, { "AP", "Norte" }, { "BA", "Nordeste" }, { "CE", "Nordeste" }, { "DF", "Centro-Oeste" }, { "ES", "Sudeste" }, { "GO", "Centro-Oeste" }, { "MA", "Nordeste" }, { "MG", "Sudeste" }, { "MS", "Centro-Oeste" }, { "MT", "Centro-Oeste" }, { "PA", "Norte" }, { "PB", "Nordeste" }, { "PE", "Nordeste" }, { "PI", "Nordeste" }, { "PR", "Sul" }, { "RJ", "Sudeste" }, { "RN", "Nordeste" }, { "RO", "Norte" }, { "RR", "Norte" }, { "RS", "Sul" }, { "SC", "Sul" }, { "SE", "Nordeste" }, { "SP", "Sudeste" }, { "TO", "Norte" } } )
			VAR _daRegiao = FILTER ( _todas, [reg] = _r ) /* lista */
			VAR _ufs =
			    ADDCOLUMNS (
			        _daRegiao,
			        "@pt", VAR _u = [uf] RETURN CALCULATE ( [T14 · PT % da UF na eleição dos painéis], 'UF'[UF] = _u ),
			        "@adv", VAR _u = [uf] RETURN CALCULATE ( [T14 · adversário % da UF na eleição dos painéis], 'UF'[UF] = _u )
			    ) /* lista */
			-- 2 · Textos
			VAR _selo = "PT À FRENTE EM " & FORMAT ( _fr, "0" ) & " DE " & FORMAT ( _n, "0" )
			VAR _clsSelo = IF ( _fr * 2 > _n, "selo vm", "selo az" )
			VAR _mao =
			    SWITCH (
			        TRUE (),
			        _nPt = _nUf, "todos com o PT",
			        _nPt = 0, "nenhum com o PT",
			        "dividida: " & FORMAT ( _nPt, "0" ) & " a " & FORMAT ( _nUf - _nPt, "0" )
			    )
			-- 3 · Geometria e 4 · Marcação (barras de duelo: 100% = 190 px)
			VAR _linhas =
			    CONCATENATEX (
			        _ufs,
			        "<div class='ln'><span class='a'>" & [uf] & "</span><span class='tr'><i class='bl barra-x' style='width:"
			            & FORMAT ( 190 * [@pt], "0.0", "en-US" ) & "px'></i><i class='ba barra-x-dir' style='width:"
			            & FORMAT ( 190 * [@adv], "0.0", "en-US" ) & "px'></i></span><span class='p'><b class='lula'>"
			            & FORMAT ( [@pt], "0.0%" ) & "</b> × <b class='flavio'>" & FORMAT ( [@adv], "0.0%" ) & "</b></span></div>",
			        "",
			        [@pt] - [@adv], DESC
			    )
			RETURN
			    "<div class='tela tt14r'><div class='fita'></div>"
			        & "<div class='" & _clsSelo & "'>" & _selo & "</div>"
			        & "<div class='an sobe'>" & _r & " · " & _ano & "</div>"
			        & "<div class='rot entra d1'>OS ESTADOS · " & UPPER ( SWITCH ( _cpt, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Bolsonaro", _cpt ) ) & " × " & UPPER ( SWITCH ( _cadv, "Dilma Rousseff", "Dilma", "Fernando Haddad", "Haddad", "Geraldo Alckmin", "Alckmin", "José Serra", "Serra", "Aécio Neves", "Aécio", "Jair Bolsonaro", "Bolsonaro", _cadv ) )
			            & "</div>"
			        & "<div class='lista entra d2'>" & _linhas & "</div>"
			        & "<div class='nota entra d3'>Votos válidos de cada estado, somando os municípios (sem o exterior).</div>"
			        & "<div class='mao entra d5'>" & _mao & "</div>"
			    & "</div>"
		displayFolder: T14 Série\Desenho
		lineageTag: 3545064b-b4c5-55e0-a6b9-4e5459a83f9e

	/// Eleitores que faltaram sobre os aptos no ano, no município.
	measure 'T15 · abstenção no ano' =
