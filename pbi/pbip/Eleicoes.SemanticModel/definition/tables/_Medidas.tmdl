	/// Na medição mais recente do instituto do filtro para o grupo do filtro (depois do 1º turno): % branco, nulo ou não vota.
	measure 'T16 · instituto · branco ou nulo' =
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _i = SELECTEDVALUE ( 'Transferência'[Instituto] )
			VAR _dia =
			    CALCULATE (
			        MAX ( 'Transferência'[Divulgação] ),
			        REMOVEFILTERS ( 'Transferência' ),
			        'Transferência'[Segmento] = _seg,
			        'Transferência'[Instituto] = _i,
			        LEFT ( 'Transferência'[Observação], 19 ) = "momento=apos_1turno"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _dia ),
			        CALCULATE (
			            AVERAGE ( 'Transferência'[BrancoNulo] ),
			            REMOVEFILTERS ( 'Transferência' ),
			            'Transferência'[Segmento] = _seg,
			            'Transferência'[Instituto] = _i,
			            'Transferência'[Divulgação] = _dia,
			            LEFT ( 'Transferência'[Observação], 19 ) = "momento=apos_1turno"
			        )
			    )
		formatString: 0.0
		displayFolder: T16 Os outros\Contas
		lineageTag: c1722731-41fe-5015-8f6f-54fea99430ff

	/// Data de divulgação da medição mais recente do instituto do filtro para o grupo do filtro, depois do 1º turno.
	measure 'T16 · instituto · divulgação' =
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _i = SELECTEDVALUE ( 'Transferência'[Instituto] )
			VAR _dia =
			    CALCULATE (
			        MAX ( 'Transferência'[Divulgação] ),
			        REMOVEFILTERS ( 'Transferência' ),
			        'Transferência'[Segmento] = _seg,
			        'Transferência'[Instituto] = _i,
			        LEFT ( 'Transferência'[Observação], 19 ) = "momento=apos_1turno"
			    )
			RETURN
			    IF ( HASONEVALUE ( 'Transferência'[Instituto] ), _dia )
		formatString: dd/MM
		displayFolder: T16 Os outros\Contas
		lineageTag: c8d48019-c60c-5fb3-92a9-2a298b040de4

	/// Na medição mais recente do instituto do filtro para o grupo do filtro (depois do 1º turno): entrevistas no grupo (só quando o instituto publicou).
	measure 'T16 · instituto · entrevistas' =
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _i = SELECTEDVALUE ( 'Transferência'[Instituto] )
			VAR _dia =
			    CALCULATE (
			        MAX ( 'Transferência'[Divulgação] ),
