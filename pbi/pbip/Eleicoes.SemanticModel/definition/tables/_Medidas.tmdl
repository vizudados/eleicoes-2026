	/// Maior margem (em módulo) da série do município; escala das barras.
	measure 'T15 · maior margem absoluta' =
			MAXX ( ALL ( 'Ano'[Ano] ), ABS ( [T15 · margem no ano] ) )
		formatString: 0.0%
		displayFolder: T15 Minha cidade\Contas
		lineageTag: 40eec53b-b72f-57b9-8bcd-aca92400f2e2

	/// Margem de Lula em 2026 no município: (Lula − Flávio) ÷ válidos. Fixa em 2026 (título da série), não muda com o clique.
	measure 'T15 · margem 2026' =
			DIVIDE ( CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Ano'[Ano] = 2026 ) - CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Ano'[Ano] = 2026 ), CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Ano'[Ano] = 2026 ) )
		formatString: 0.0%
		displayFolder: T15 Minha cidade\Contas
		lineageTag: 5d194520-08db-5c16-a994-2deebd7c8ece

	/// Margem do PT no Brasil na eleição anterior à escolhida (2022 sem clique), resultado oficial com o exterior (igual às telas 01, 12 e 15).
	measure 'T15 · margem do Brasil no ano anterior' =
			VAR _a = [T15 · ano anterior]
			RETURN
			    IF ( NOT ISBLANK ( _a ), DIVIDE (
			        CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Ano'[Ano] = _a, 'Candidato ano'[Partido] = "PT" )
			            - CALCULATE ( MAX ( 'Candidato ano'[Votos] ), 'Ano'[Ano] = _a, 'Candidato ano'[Partido] <> "PT" ),
			        CALCULATE ( MAX ( 'Candidato ano'[ValidosAno] ), 'Ano'[Ano] = _a )
			    ) )
		formatString: 0.0%
		displayFolder: T15 Minha cidade\Contas
		lineageTag: d8cb5cee-617c-5b8a-a3b7-af43c66919a2

	/// Margem do PT no Brasil na eleição escolhida (2026 sem clique), resultado oficial com o exterior (igual às telas 01, 12 e 15).
	measure 'T15 · margem do Brasil no ano escolhido' =
			VAR _a = [T15 · ano escolhido]
			RETURN
			    DIVIDE (
			        CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Ano'[Ano] = _a, 'Candidato ano'[Partido] = "PT" )
			            - CALCULATE ( MAX ( 'Candidato ano'[Votos] ), 'Ano'[Ano] = _a, 'Candidato ano'[Partido] <> "PT" ),
			        CALCULATE ( MAX ( 'Candidato ano'[ValidosAno] ), 'Ano'[Ano] = _a )
			    )
		formatString: 0.0%
		displayFolder: T15 Minha cidade\Contas
		lineageTag: 6e10751d-df37-5d64-9b0a-65eb529b73d3

	/// Margem do PT na eleição anterior à escolhida (2022 sem clique) na UF da cidade, somando os municípios dela (igual à conta da tela 12).
	measure 'T15 · margem na UF no ano anterior' =
			VAR _uf = [T15 · UF da cidade]
			VAR _a = [T15 · ano anterior]
			RETURN
			    IF (
			        NOT ISBLANK ( _uf ) && NOT ISBLANK ( _a ),
			        CALCULATE (
			            [T15 · margem no ano],
			            REMOVEFILTERS ( 'Município' ),
			            REMOVEFILTERS ( 'UF' ),
			            'Município'[UF] = _uf,
			            'Ano'[Ano] = _a
			        )
			    )
		formatString: 0.0%
		displayFolder: T15 Minha cidade\Contas
		lineageTag: 4af74c6a-17dd-5f7f-bcaf-d33842f4636f

	/// Margem do PT na eleição escolhida (2026 sem clique) na UF da cidade, somando os municípios dela (igual à conta da tela 12).
	measure 'T15 · margem na UF no ano escolhido' =
			VAR _uf = [T15 · UF da cidade]
			VAR _a = [T15 · ano escolhido]
			RETURN
			    IF (
			        NOT ISBLANK ( _uf ) && NOT ISBLANK ( _a ),
			        CALCULATE (
			            [T15 · margem no ano],
			            REMOVEFILTERS ( 'Município' ),
			            REMOVEFILTERS ( 'UF' ),
			            'Município'[UF] = _uf,
			            'Ano'[Ano] = _a
			        )
			    )
		formatString: 0.0%
		displayFolder: T15 Minha cidade\Contas
		lineageTag: 4758b080-71dd-5800-9e2c-b312c8b8d00e

	/// Margem do PT no ano do contexto, no município (série 2006–2026).
	measure 'T15 · margem no ano' =
