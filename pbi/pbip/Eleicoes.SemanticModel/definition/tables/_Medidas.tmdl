	/// Quem não vai (ou não foi) ao debate: Lula, Flávio, Lula e Flávio, ou vazio.
	measure 'T26 · ausentes' =
			VAR _l = [T26 · presença · Lula] = "ausente"
			VAR _f = [T26 · presença · Flávio] = "ausente"
			RETURN
