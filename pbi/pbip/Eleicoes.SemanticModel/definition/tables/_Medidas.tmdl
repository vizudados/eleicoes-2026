		lineageTag: 247ea454-5e71-5ad4-8dd7-bcc263c521de

	/// Eleitores aptos de 2026 nos municípios do degrau (cada degrau tem cerca de um quinto).
	measure 'T24 · eleitores' =
			VAR _l = [T24 · lente]
			VAR _d = [T24 · degrau]
			VAR _m =
			    CALCULATETABLE (
			        VALUES ( 'Social município'[CodIBGE] ),
			        'Social município'[Lente] = _l,
			        'Social município'[Degrau] = _d
			    )
			RETURN
			    CALCULATE (
			        SUM ( 'Município ano'[Aptos] ),
			        'Município ano'[Ano] = 2026,
			        TREATAS ( _m, 'Município'[CodIBGE] )
			    )
		formatString: #,0
		displayFolder: T24 Quem vota\Contas
		lineageTag: 42182244-52a7-556b-b667-44a735a81b34

