	/// No grupo de eleitores do filtro (Transferência[Segmento]: Cury, Renan, Caiado, nao_votou…), média simples do % que diz branco, nulo ou que não vota no 2º turno, usando só a medição mais recente de cada instituto depois do 1º turno (voto declarado). Votos totais; média de percentuais publicados, sem ponderar amostra.
	measure 'T16 · transferência · branco ou nulo' =
			VAR _seg = SELECTEDVALUE ( 'Transferência'[Segmento] )
			VAR _apos =
			    CALCULATETABLE (
			        'Transferência',
			        REMOVEFILTERS ( 'Transferência' ),
			        'Transferência'[Segmento] = _seg,
			        LEFT ( 'Transferência'[Observação], 19 ) = "momento=apos_1turno"
			    )
			VAR _ult =
			    FILTER (
			        _apos,
			        VAR _i = 'Transferência'[Instituto]
			        RETURN
			            'Transferência'[Divulgação]
			                = MAXX ( FILTER ( _apos, 'Transferência'[Instituto] = _i ), 'Transferência'[Divulgação] )
			    )
			RETURN
			    AVERAGEX ( _ult, 'Transferência'[BrancoNulo] )
		formatString: 0.0
		displayFolder: T16 Os outros\Contas
		lineageTag: 4a08b8d1-56dd-5b5d-9c74-7e2d14471df3

	/// No grupo de eleitores do filtro (Transferência[Segmento]: Cury, Renan, Caiado, nao_votou…), média simples do % que diz Flávio no 2º turno, usando só a medição mais recente de cada instituto depois do 1º turno (voto declarado). Votos totais; média de percentuais publicados, sem ponderar amostra.
