	/// A régua de 2026 (quem faltou ÷ a diferença entre Flávio e Lula) vista de qualquer ano: a comparação à mão no dossiê do ano.
	measure 'T06 · vezes a diferença em 2026' =
			CALCULATE ( [T06 · vezes a diferença], 'Ano'[Ano] = 2026 )
		formatString: 0.0
