	/// O recorte como sujeito da frase, com o artigo: 'o Brasil', 'o Nordeste', 'a Bahia', 'o Pará', 'Minas Gerais', 'MG e SP', 'o Nordeste e MG', 'o Norte e o Nordeste', 'os 3 estados'.
	measure 'Recorte · com artigo' =
			-- 1 · A escolha: o filtro de estado (UF[Caminho]) ou um clique que filtra a UF (o mapa da apuração, a região da
			--     origem dos votos). O recorte visual do exterior (UF[Tipo]) não conta como escolha
			VAR _com =
			    ISFILTERED ( 'UF'[Caminho] ) || ISFILTERED ( 'UF'[Nome] ) || ISFILTERED ( 'UF'[UF] )
			        || ISFILTERED ( 'UF'[Região] )
			VAR _sel =
			    SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome], 'UF'[Região], 'UF'[RegiaoOrdem], 'UF'[Ordem], 'UF'[Artigo] )
			VAR _tot =
			    CALCULATETABLE ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Região] ), REMOVEFILTERS ( 'UF' ) )
			-- 2 · Regiões inteiras (todos os estados marcados) e estados soltos
			VAR _regioes =
			    ADDCOLUMNS (
			        DISTINCT ( SELECTCOLUMNS ( _sel, "@r", 'UF'[Região], "@o", 'UF'[RegiaoOrdem] ) ),
			        "@s", COUNTROWS ( FILTER ( _sel, 'UF'[Região] = [@r] ) ),
			        "@t", COUNTROWS ( FILTER ( _tot, 'UF'[Região] = [@r] ) )
			    )
			VAR _cheias = FILTER ( _regioes, [@s] = [@t] && [@r] <> "Exterior" )
			VAR _nomesCheias = SELECTCOLUMNS ( _cheias, "@r", [@r] )
			VAR _soltas = FILTER ( _sel, NOT ( 'UF'[Região] IN _nomesCheias ) )
			VAR _nR = COUNTROWS ( _cheias ) + 0
			VAR _nU = COUNTROWS ( _soltas ) + 0
			VAR _nPartes = IF ( _com, _nR + _nU, 0 )
			VAR _vazio = _com && _nR + _nU = 0
			VAR _nUFs = COUNTROWS ( FILTER ( _sel, 'UF'[UF] <> "ZZ" ) ) + 0
			-- 3 · As partes em ordem (regiões do Norte ao Sul, depois os estados na ordem do filtro); só valem até duas. O
			--     exterior (só pelo clique no mapa da apuração) é um lugar solto, em minúscula no meio da frase
			VAR _primeiraUF = MINX ( _soltas, 'UF'[Ordem] )
			VAR _partes =
			    UNION (
			        SELECTCOLUMNS (
			            _cheias,
			            "@ordem", [@o],
			            "@nome", [@r],
			            "@em", "no " & [@r],
			            "@de", "do " & [@r],
			            "@art", "o " & [@r]
			        ),
			        SELECTCOLUMNS (
			            _soltas,
			            "@ordem", 100 + 'UF'[Ordem],
			            "@nome", IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@em", IF ( 'UF'[Ordem] = _primeiraUF, "em ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@de", IF ( 'UF'[Ordem] = _primeiraUF, "de ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@art", IF ( 'UF'[UF] = "ZZ", "o exterior", 'UF'[UF] )
			        )
			    )
			-- 4 · A parte única: o estado pelo nome, com o artigo dele ("na Bahia", "em Minas Gerais"); a região com "o"; o
			--     exterior com "o" e em minúscula ("no exterior")
			VAR _ufNome = MAXX ( _soltas, 'UF'[Nome] )
			VAR _ufMin = IF ( MAXX ( _soltas, 'UF'[UF] ) = "ZZ", "exterior", _ufNome )
			VAR _ufArtigo = MAXX ( _soltas, 'UF'[Artigo] )
			VAR _regNome = MAXX ( _cheias, [@r] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _vazio, "nenhum estado",
			        _nPartes = 0, "o Brasil",
			        _nPartes = 1 && _nR = 1, "o " & _regNome,
			        _nPartes = 1, IF ( _ufArtigo = "", "", _ufArtigo & " " ) & _ufMin,
			        _nPartes = 2, CONCATENATEX ( _partes, [@art], " e ", [@ordem], ASC ),
			        IF ( _nUFs = 1, "o estado", "os " & FORMAT ( _nUFs, "0" ) & " estados" )
			    )
		displayFolder: _Recorte
		lineageTag: 4afc8f80-4cd0-5252-a3dc-067e1fc6489e

	/// 1 quando há estado ou região escolhido (o filtro de estado da casca, em árvore Região › Estado, ou um clique que filtra a UF, como o mapa da apuração); 0 no Brasil. O recorte visual do exterior não conta.
	measure 'Recorte · com escolha' =
			INT (
			    ISFILTERED ( 'UF'[Caminho] ) || ISFILTERED ( 'UF'[Nome] ) || ISFILTERED ( 'UF'[UF] )
			        || ISFILTERED ( 'UF'[Região] )
			)
		formatString: 0
		displayFolder: _Recorte
		lineageTag: bf741542-09f9-5603-85c2-8743d9b77239

	/// O recorte com a preposição 'de' e o artigo certo, para as frases: 'do Brasil', 'do Nordeste', 'da Bahia', 'do Pará', 'de Minas Gerais', 'de MG e SP', 'do Nordeste e de MG', 'do Norte e do Nordeste', 'de 3 estados'.
	measure 'Recorte · de' =
			-- 1 · A escolha: o filtro de estado (UF[Caminho]) ou um clique que filtra a UF (o mapa da apuração, a região da
			--     origem dos votos). O recorte visual do exterior (UF[Tipo]) não conta como escolha
			VAR _com =
			    ISFILTERED ( 'UF'[Caminho] ) || ISFILTERED ( 'UF'[Nome] ) || ISFILTERED ( 'UF'[UF] )
			        || ISFILTERED ( 'UF'[Região] )
			VAR _sel =
			    SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome], 'UF'[Região], 'UF'[RegiaoOrdem], 'UF'[Ordem], 'UF'[Artigo] )
			VAR _tot =
			    CALCULATETABLE ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Região] ), REMOVEFILTERS ( 'UF' ) )
			-- 2 · Regiões inteiras (todos os estados marcados) e estados soltos
			VAR _regioes =
			    ADDCOLUMNS (
			        DISTINCT ( SELECTCOLUMNS ( _sel, "@r", 'UF'[Região], "@o", 'UF'[RegiaoOrdem] ) ),
			        "@s", COUNTROWS ( FILTER ( _sel, 'UF'[Região] = [@r] ) ),
			        "@t", COUNTROWS ( FILTER ( _tot, 'UF'[Região] = [@r] ) )
			    )
			VAR _cheias = FILTER ( _regioes, [@s] = [@t] && [@r] <> "Exterior" )
			VAR _nomesCheias = SELECTCOLUMNS ( _cheias, "@r", [@r] )
			VAR _soltas = FILTER ( _sel, NOT ( 'UF'[Região] IN _nomesCheias ) )
			VAR _nR = COUNTROWS ( _cheias ) + 0
			VAR _nU = COUNTROWS ( _soltas ) + 0
			VAR _nPartes = IF ( _com, _nR + _nU, 0 )
			VAR _vazio = _com && _nR + _nU = 0
			VAR _nUFs = COUNTROWS ( FILTER ( _sel, 'UF'[UF] <> "ZZ" ) ) + 0
			-- 3 · As partes em ordem (regiões do Norte ao Sul, depois os estados na ordem do filtro); só valem até duas. O
			--     exterior (só pelo clique no mapa da apuração) é um lugar solto, em minúscula no meio da frase
			VAR _primeiraUF = MINX ( _soltas, 'UF'[Ordem] )
			VAR _partes =
			    UNION (
			        SELECTCOLUMNS (
			            _cheias,
			            "@ordem", [@o],
			            "@nome", [@r],
			            "@em", "no " & [@r],
			            "@de", "do " & [@r],
			            "@art", "o " & [@r]
			        ),
			        SELECTCOLUMNS (
			            _soltas,
			            "@ordem", 100 + 'UF'[Ordem],
			            "@nome", IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@em", IF ( 'UF'[Ordem] = _primeiraUF, "em ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@de", IF ( 'UF'[Ordem] = _primeiraUF, "de ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@art", IF ( 'UF'[UF] = "ZZ", "o exterior", 'UF'[UF] )
			        )
			    )
			-- 4 · A parte única: o estado pelo nome, com o artigo dele ("na Bahia", "em Minas Gerais"); a região com "o"; o
			--     exterior com "o" e em minúscula ("no exterior")
			VAR _ufNome = MAXX ( _soltas, 'UF'[Nome] )
			VAR _ufMin = IF ( MAXX ( _soltas, 'UF'[UF] ) = "ZZ", "exterior", _ufNome )
			VAR _ufArtigo = MAXX ( _soltas, 'UF'[Artigo] )
			VAR _regNome = MAXX ( _cheias, [@r] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _vazio, "de nenhum estado",
			        _nPartes = 0, "do Brasil",
			        _nPartes = 1 && _nR = 1, "do " & _regNome,
			        _nPartes = 1, SWITCH ( _ufArtigo, "a", "da ", "o", "do ", "de " ) & _ufMin,
			        _nPartes = 2, CONCATENATEX ( _partes, [@de], " e ", [@ordem], ASC ),
			        "de " & FORMAT ( _nUFs, "0" ) & IF ( _nUFs = 1, " estado", " estados" )
			    )
		displayFolder: _Recorte
		lineageTag: 3161dc95-082c-56f9-8cca-3640ae353ce0

	/// O recorte com a preposição 'em' e o artigo certo, para as frases: 'no Brasil', 'no Nordeste', 'na Bahia', 'no Pará', 'em Minas Gerais', 'em MG e SP', 'no Nordeste e em MG', 'no Norte e no Nordeste', 'em 3 estados'.
	measure 'Recorte · em' =
			-- 1 · A escolha: o filtro de estado (UF[Caminho]) ou um clique que filtra a UF (o mapa da apuração, a região da
			--     origem dos votos). O recorte visual do exterior (UF[Tipo]) não conta como escolha
			VAR _com =
			    ISFILTERED ( 'UF'[Caminho] ) || ISFILTERED ( 'UF'[Nome] ) || ISFILTERED ( 'UF'[UF] )
			        || ISFILTERED ( 'UF'[Região] )
			VAR _sel =
			    SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome], 'UF'[Região], 'UF'[RegiaoOrdem], 'UF'[Ordem], 'UF'[Artigo] )
			VAR _tot =
			    CALCULATETABLE ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Região] ), REMOVEFILTERS ( 'UF' ) )
			-- 2 · Regiões inteiras (todos os estados marcados) e estados soltos
			VAR _regioes =
			    ADDCOLUMNS (
			        DISTINCT ( SELECTCOLUMNS ( _sel, "@r", 'UF'[Região], "@o", 'UF'[RegiaoOrdem] ) ),
			        "@s", COUNTROWS ( FILTER ( _sel, 'UF'[Região] = [@r] ) ),
			        "@t", COUNTROWS ( FILTER ( _tot, 'UF'[Região] = [@r] ) )
			    )
			VAR _cheias = FILTER ( _regioes, [@s] = [@t] && [@r] <> "Exterior" )
			VAR _nomesCheias = SELECTCOLUMNS ( _cheias, "@r", [@r] )
			VAR _soltas = FILTER ( _sel, NOT ( 'UF'[Região] IN _nomesCheias ) )
			VAR _nR = COUNTROWS ( _cheias ) + 0
			VAR _nU = COUNTROWS ( _soltas ) + 0
			VAR _nPartes = IF ( _com, _nR + _nU, 0 )
			VAR _vazio = _com && _nR + _nU = 0
			VAR _nUFs = COUNTROWS ( FILTER ( _sel, 'UF'[UF] <> "ZZ" ) ) + 0
			-- 3 · As partes em ordem (regiões do Norte ao Sul, depois os estados na ordem do filtro); só valem até duas. O
			--     exterior (só pelo clique no mapa da apuração) é um lugar solto, em minúscula no meio da frase
			VAR _primeiraUF = MINX ( _soltas, 'UF'[Ordem] )
			VAR _partes =
			    UNION (
			        SELECTCOLUMNS (
			            _cheias,
			            "@ordem", [@o],
			            "@nome", [@r],
			            "@em", "no " & [@r],
			            "@de", "do " & [@r],
			            "@art", "o " & [@r]
			        ),
			        SELECTCOLUMNS (
			            _soltas,
			            "@ordem", 100 + 'UF'[Ordem],
			            "@nome", IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@em", IF ( 'UF'[Ordem] = _primeiraUF, "em ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@de", IF ( 'UF'[Ordem] = _primeiraUF, "de ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@art", IF ( 'UF'[UF] = "ZZ", "o exterior", 'UF'[UF] )
			        )
			    )
			-- 4 · A parte única: o estado pelo nome, com o artigo dele ("na Bahia", "em Minas Gerais"); a região com "o"; o
			--     exterior com "o" e em minúscula ("no exterior")
			VAR _ufNome = MAXX ( _soltas, 'UF'[Nome] )
			VAR _ufMin = IF ( MAXX ( _soltas, 'UF'[UF] ) = "ZZ", "exterior", _ufNome )
			VAR _ufArtigo = MAXX ( _soltas, 'UF'[Artigo] )
			VAR _regNome = MAXX ( _cheias, [@r] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _vazio, "em nenhum estado",
			        _nPartes = 0, "no Brasil",
			        _nPartes = 1 && _nR = 1, "no " & _regNome,
			        _nPartes = 1, SWITCH ( _ufArtigo, "a", "na ", "o", "no ", "em " ) & _ufMin,
			        _nPartes = 2, CONCATENATEX ( _partes, [@em], " e ", [@ordem], ASC ),
			        "em " & FORMAT ( _nUFs, "0" ) & IF ( _nUFs = 1, " estado", " estados" )
			    )
		displayFolder: _Recorte
		lineageTag: 4d67a35c-c396-575b-b2bd-a308892cf6ec

	/// O nome do recorte, a medida comum das telas com filtro de estado (pílula, títulos '… · BAHIA', ALTs, manchetes): 'Brasil' sem escolha; a região pelo nome quando está inteira ('Nordeste'); o estado pelo nome quando é um só ('Bahia'); duas partes juntas, com os estados soltos pela sigla ('Nordeste e MG', 'MG e SP', 'Norte e Nordeste'); com mais de duas, a contagem de estados ('3 estados').
	measure 'Recorte · nome' =
			-- 1 · A escolha: o filtro de estado (UF[Caminho]) ou um clique que filtra a UF (o mapa da apuração, a região da
			--     origem dos votos). O recorte visual do exterior (UF[Tipo]) não conta como escolha
			VAR _com =
			    ISFILTERED ( 'UF'[Caminho] ) || ISFILTERED ( 'UF'[Nome] ) || ISFILTERED ( 'UF'[UF] )
			        || ISFILTERED ( 'UF'[Região] )
			VAR _sel =
			    SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome], 'UF'[Região], 'UF'[RegiaoOrdem], 'UF'[Ordem], 'UF'[Artigo] )
			VAR _tot =
			    CALCULATETABLE ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Região] ), REMOVEFILTERS ( 'UF' ) )
			-- 2 · Regiões inteiras (todos os estados marcados) e estados soltos
			VAR _regioes =
			    ADDCOLUMNS (
			        DISTINCT ( SELECTCOLUMNS ( _sel, "@r", 'UF'[Região], "@o", 'UF'[RegiaoOrdem] ) ),
			        "@s", COUNTROWS ( FILTER ( _sel, 'UF'[Região] = [@r] ) ),
			        "@t", COUNTROWS ( FILTER ( _tot, 'UF'[Região] = [@r] ) )
			    )
			VAR _cheias = FILTER ( _regioes, [@s] = [@t] && [@r] <> "Exterior" )
			VAR _nomesCheias = SELECTCOLUMNS ( _cheias, "@r", [@r] )
			VAR _soltas = FILTER ( _sel, NOT ( 'UF'[Região] IN _nomesCheias ) )
			VAR _nR = COUNTROWS ( _cheias ) + 0
			VAR _nU = COUNTROWS ( _soltas ) + 0
			VAR _nPartes = IF ( _com, _nR + _nU, 0 )
			VAR _vazio = _com && _nR + _nU = 0
			VAR _nUFs = COUNTROWS ( FILTER ( _sel, 'UF'[UF] <> "ZZ" ) ) + 0
			-- 3 · As partes em ordem (regiões do Norte ao Sul, depois os estados na ordem do filtro); só valem até duas. O
			--     exterior (só pelo clique no mapa da apuração) é um lugar solto, em minúscula no meio da frase
			VAR _primeiraUF = MINX ( _soltas, 'UF'[Ordem] )
			VAR _partes =
			    UNION (
			        SELECTCOLUMNS (
			            _cheias,
			            "@ordem", [@o],
			            "@nome", [@r],
			            "@em", "no " & [@r],
			            "@de", "do " & [@r],
			            "@art", "o " & [@r]
			        ),
			        SELECTCOLUMNS (
			            _soltas,
			            "@ordem", 100 + 'UF'[Ordem],
			            "@nome", IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@em", IF ( 'UF'[Ordem] = _primeiraUF, "em ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@de", IF ( 'UF'[Ordem] = _primeiraUF, "de ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@art", IF ( 'UF'[UF] = "ZZ", "o exterior", 'UF'[UF] )
			        )
			    )
			-- 4 · A parte única: o estado pelo nome, com o artigo dele ("na Bahia", "em Minas Gerais"); a região com "o"; o
			--     exterior com "o" e em minúscula ("no exterior")
			VAR _ufNome = MAXX ( _soltas, 'UF'[Nome] )
			VAR _ufMin = IF ( MAXX ( _soltas, 'UF'[UF] ) = "ZZ", "exterior", _ufNome )
			VAR _ufArtigo = MAXX ( _soltas, 'UF'[Artigo] )
			VAR _regNome = MAXX ( _cheias, [@r] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _vazio, "nenhum estado",
			        _nPartes = 0, "Brasil",
			        _nPartes = 1 && _nR = 1, _regNome,
			        _nPartes = 1, _ufNome,
			        _nPartes = 2, CONCATENATEX ( _partes, [@nome], " e ", [@ordem], ASC ),
			        FORMAT ( _nUFs, "0" ) & IF ( _nUFs = 1, " estado", " estados" )
			    )
		displayFolder: _Recorte
		lineageTag: 19af9de2-2921-5c33-ac8b-5249fcbb47fe

	/// Quantas partes a leitura do recorte tem, de cima para baixo: 0 no Brasil; 1 num estado ou numa região inteira; 2 em duas partes ('Nordeste e MG', 'MG e SP'); 3 ou mais, quando o texto vira a contagem ('5 estados').
	measure 'Recorte · partes' =
			-- 1 · A escolha: o filtro de estado (UF[Caminho]) ou um clique que filtra a UF (o mapa da apuração, a região da
			--     origem dos votos). O recorte visual do exterior (UF[Tipo]) não conta como escolha
			VAR _com =
			    ISFILTERED ( 'UF'[Caminho] ) || ISFILTERED ( 'UF'[Nome] ) || ISFILTERED ( 'UF'[UF] )
			        || ISFILTERED ( 'UF'[Região] )
			VAR _sel =
			    SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome], 'UF'[Região], 'UF'[RegiaoOrdem], 'UF'[Ordem], 'UF'[Artigo] )
			VAR _tot =
			    CALCULATETABLE ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Região] ), REMOVEFILTERS ( 'UF' ) )
			-- 2 · Regiões inteiras (todos os estados marcados) e estados soltos
			VAR _regioes =
			    ADDCOLUMNS (
			        DISTINCT ( SELECTCOLUMNS ( _sel, "@r", 'UF'[Região], "@o", 'UF'[RegiaoOrdem] ) ),
			        "@s", COUNTROWS ( FILTER ( _sel, 'UF'[Região] = [@r] ) ),
			        "@t", COUNTROWS ( FILTER ( _tot, 'UF'[Região] = [@r] ) )
			    )
			VAR _cheias = FILTER ( _regioes, [@s] = [@t] && [@r] <> "Exterior" )
			VAR _nomesCheias = SELECTCOLUMNS ( _cheias, "@r", [@r] )
			VAR _soltas = FILTER ( _sel, NOT ( 'UF'[Região] IN _nomesCheias ) )
			VAR _nR = COUNTROWS ( _cheias ) + 0
			VAR _nU = COUNTROWS ( _soltas ) + 0
			VAR _nPartes = IF ( _com, _nR + _nU, 0 )
			VAR _vazio = _com && _nR + _nU = 0
			VAR _nUFs = COUNTROWS ( FILTER ( _sel, 'UF'[UF] <> "ZZ" ) ) + 0
			-- 3 · As partes em ordem (regiões do Norte ao Sul, depois os estados na ordem do filtro); só valem até duas. O
			--     exterior (só pelo clique no mapa da apuração) é um lugar solto, em minúscula no meio da frase
			VAR _primeiraUF = MINX ( _soltas, 'UF'[Ordem] )
			VAR _partes =
			    UNION (
			        SELECTCOLUMNS (
			            _cheias,
			            "@ordem", [@o],
			            "@nome", [@r],
			            "@em", "no " & [@r],
			            "@de", "do " & [@r],
			            "@art", "o " & [@r]
			        ),
			        SELECTCOLUMNS (
			            _soltas,
			            "@ordem", 100 + 'UF'[Ordem],
			            "@nome", IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@em", IF ( 'UF'[Ordem] = _primeiraUF, "em ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@de", IF ( 'UF'[Ordem] = _primeiraUF, "de ", "" ) & IF ( 'UF'[UF] = "ZZ", "exterior", 'UF'[UF] ),
			            "@art", IF ( 'UF'[UF] = "ZZ", "o exterior", 'UF'[UF] )
			        )
			    )
			-- 4 · A parte única: o estado pelo nome, com o artigo dele ("na Bahia", "em Minas Gerais"); a região com "o"; o
			--     exterior com "o" e em minúscula ("no exterior")
			VAR _ufNome = MAXX ( _soltas, 'UF'[Nome] )
			VAR _ufMin = IF ( MAXX ( _soltas, 'UF'[UF] ) = "ZZ", "exterior", _ufNome )
			VAR _ufArtigo = MAXX ( _soltas, 'UF'[Artigo] )
			VAR _regNome = MAXX ( _cheias, [@r] )
			RETURN
			    _nPartes
		formatString: 0
		displayFolder: _Recorte
		lineageTag: ad8f0df0-2ec8-5cb0-a54f-ed91aebf4f7c

	/// 1 quando o recorte nomeia mais de um lugar ('MG e SP', 'Norte e Nordeste', '3 estados': o verbo vai ao plural); 0 no Brasil, num estado ou numa região inteira.
	measure 'Recorte · plural' =
