		lineageTag: a1ed782c-9a84-553d-967c-2dfd6e800781

	/// Governadores eleitos ou reeleitos no 1º turno com posição 'neutro' no 2º turno (levantamento do O Povo, 16/10).
	measure 'T16 · governadores · neutros' =
			COUNTROWS (
			    FILTER (
			        ALL ( Apoio ),
			        ( CONTAINSSTRING ( Apoio[Cargo], "governador eleito" ) || CONTAINSSTRING ( Apoio[Cargo], "governador reeleito" )
			            || CONTAINSSTRING ( Apoio[Cargo], "governadora eleita" ) || CONTAINSSTRING ( Apoio[Cargo], "governadora reeleita" ) )
