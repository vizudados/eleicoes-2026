	/// Margem de Lula no Brasil em 2026, com o exterior (ignora a UF).
	measure 'T12 · margem do Brasil 2026' =
			CALCULATE ( [T12 · margem 2026], REMOVEFILTERS ( 'UF' ) )
		formatString: 0.0%
		displayFolder: T12 Estados\Contas
		lineageTag: 43495c1e-8e01-5c4d-b625-bcb666b45801

	/// Nomes das UFs com Lula à frente em 2022 e Flávio em 2026, em ordem alfabética, ligados por vírgula e 'e'.
	measure 'T12 · mudaram para o adversário' =
			VAR _t =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'UF'[Nome] ), [T12 · margem 2022] > 0 && [T12 · margem 2026] < 0 ),
			        REMOVEFILTERS ( 'UF' ),
			        'UF'[Tipo] = "UF"
			    )
			VAR _n = COUNTROWS ( _t )
			VAR _ultimo = MAXX ( _t, 'UF'[Nome] )
			VAR _resto = CONCATENATEX ( FILTER ( _t, 'UF'[Nome] <> _ultimo ), 'UF'[Nome], ", ", 'UF'[Nome], ASC )
			RETURN
			    SWITCH ( TRUE (), _n = 0, BLANK (), _n = 1, _ultimo, _resto & " e " & _ultimo )
		displayFolder: T12 Estados\Contas
		lineageTag: dc3e1bd3-718d-55e4-9a79-7262148c0641

	/// 1 se o município do contexto tinha Lula à frente em 2022 e Flávio em 2026; 0 se não.
	measure 'T12 · município virou' =
			VAR _d22 = [T12 · saldo municipal 2022]
			VAR _d26 = [T12 · saldo municipal 2026]
			RETURN
			    IF ( _d22 > 0 && _d26 < 0, 1, 0 )
		formatString: 0
		displayFolder: T12 Estados\Contas
		lineageTag: cb97df0b-98a8-59c2-a029-e43f0df9136a

	/// Municípios da UF com votos em 2026.
	measure 'T12 · municípios' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			    IF ( NOT ISBLANK ( [T12 · saldo municipal 2026] ), 1 )
			) + 0
		formatString: #,0
		displayFolder: T12 Estados\Contas
		lineageTag: 37d4ba18-f3bb-5a67-a0fc-27ff0ca97e36

	/// Municípios da UF com Lula à frente em 2022 e Flávio em 2026.
	measure 'T12 · municípios que viraram' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			    VAR _d22 = [T12 · saldo municipal 2022]
			    VAR _d26 = [T12 · saldo municipal 2026]
			    RETURN
			        IF ( _d22 > 0 && _d26 < 0, 1 )
			) + 0
		formatString: #,0
		displayFolder: T12 Estados\Contas
		lineageTag: fe79e72d-1e60-57eb-99e6-c9e9fadc5ea7

