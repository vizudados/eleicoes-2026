	/// Último dia da janela da Biblioteca de Anúncios que cabe no período. Só entra a janela que cabe inteira dentro do período escolhido (o dia do debate conta como depois); entre as que cabem, a mais longa (no empate, a mais recente). Vazio sem período ou sem janela que caiba.
	measure 'T09 · período · Meta · fim' =
			VAR _ini = [Período · início]
			VAR _fim = [Período · fim]
			VAR _jan =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                VALUES ( 'Anúncios'[Período] ),
			                REMOVEFILTERS ( 'Anúncios' ),
			                'Anúncios'[Plataforma] = "Meta (Facebook/Instagram)"
			            ),
			            "@i",
			                VAR _t = 'Anúncios'[Período]
			                RETURN
			                    IF (
			                        MID ( _t, 5, 1 ) = "-" && MID ( _t, 8, 1 ) = "-",
			                        DATE ( VALUE ( LEFT ( _t, 4 ) ), VALUE ( MID ( _t, 6, 2 ) ), VALUE ( MID ( _t, 9, 2 ) ) )
			                    ),
			            "@f",
			                VAR _t = 'Anúncios'[Período]
			                RETURN
			                    SWITCH (
			                        TRUE (),
			                        MID ( _t, 12, 2 ) = "a " && MID ( _t, 18, 1 ) = "-",
			                            DATE ( VALUE ( MID ( _t, 14, 4 ) ), VALUE ( MID ( _t, 19, 2 ) ), VALUE ( MID ( _t, 22, 2 ) ) ),
			                        MID ( _t, 5, 1 ) = "-" && MID ( _t, 8, 1 ) = "-",
			                            DATE ( VALUE ( LEFT ( _t, 4 ) ), VALUE ( MID ( _t, 6, 2 ) ), VALUE ( MID ( _t, 9, 2 ) ) )
			                    )
			        ),
			        NOT ISBLANK ( [@i] ) && [@i] >= _ini && [@f] <= _fim
			    )
			VAR _top = TOPN ( 1, _jan, [@f] - [@i], DESC, [@i], DESC )
			RETURN
			    IF ( NOT ISBLANK ( _ini ), MAXX ( _top, [@f] ) )
		formatString: dd/MM
		displayFolder: T09 Redes\Contas
		lineageTag: 6eb273c0-8bca-5f33-8c59-03764f033a2a

	/// Reais gastos em anúncios pela página de Flávio na Meta (Facebook e Instagram) na janela da Biblioteca de Anúncios que cabe no período; não se soma aos pagamentos declarados ao TSE (outra base).
	measure 'T09 · período · Meta · Flávio' =
			VAR _j = [T09 · período · Meta · janela]
			RETURN
			    IF (
			        NOT ISBLANK ( _j ),
			        CALCULATE (
			            SUM ( 'Anúncios'[Valor] ),
