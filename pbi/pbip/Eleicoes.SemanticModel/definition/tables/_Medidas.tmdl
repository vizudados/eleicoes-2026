		lineageTag: 7d70c7a3-557d-58d0-9ec4-3fd87126cf31

	/// Texto da linha 'checagem' do arquivo do debate.
	measure 'T26 · checagem' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Texto] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "checagem" )
		displayFolder: T26 Debate na Globo\Contas
		lineageTag: 697eb5a6-666e-5efa-8623-569eafcb6028

	/// Quando a situação do debate foi atualizada no arquivo.
	measure 'T26 · debate · atualizado' =
			CALCULATE ( MAX ( 'T26 Debate Globo'[Atualizado] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "debate" )
