	/// Média do candidato da linha nas últimas pesquisas com votos válidos (a mesma do quadro: Lula ou Flávio).
	measure 'T10 · erro · média' =
			SWITCH ( [T10 · erro · candidato], "Lula", [T10 · válidos · média Lula], "Flávio", [T10 · válidos · média Flávio] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: c1200fd7-f0d2-5d59-b139-1bf2fbf60f0a

	/// % do candidato da linha na urna (votos válidos do 1º turno de 2026).
	measure 'T10 · erro · urna' =
			SWITCH ( [T10 · erro · candidato], "Lula", [T10 · urna · Lula], "Flávio", [T10 · urna · Flávio] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 47e6860c-1c24-53ac-808f-c66620e0b6ce

	/// O instituto clicado na régua (filtro cruzado de T10_Regua_Institutos, grão Pesquisa[Instituto]); vazio sem clique, dentro da própria régua (o instituto da linha está no grão) e para quem não tem pesquisa de 1º turno.
	measure 'T10 · escolha · instituto' =
			VAR _i = SELECTEDVALUE ( Pesquisa[Instituto] )
			RETURN
			    IF (
			        ISFILTERED ( Pesquisa[Instituto] ) && NOT ISINSCOPE ( Pesquisa[Instituto] ) && NOT ISBLANK ( _i ),
			        IF ( NOT ISBLANK ( [T10 · instituto · pesquisa] ), _i )
			    )
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 0edc84ec-0e5b-53ac-8792-cda8db812c1d

	/// Base da última pesquisa do instituto: 'validos' quando ele divulgou votos válidos naquela data; senão 'totais' (a regra do mockup).
	measure 'T10 · instituto · base' =
			VAR _i = SELECTEDVALUE ( Pesquisa[Instituto] )
			VAR _d = [T10 · instituto · última divulgação]
			VAR _nv =
			    CALCULATE (
			        COUNTROWS ( Pesquisa ),
			        REMOVEFILTERS ( Pesquisa ),
			        Pesquisa[Cenário] = "1º turno",
			        NOT ISBLANK ( Pesquisa[Lula] ),
			        NOT ISBLANK ( Pesquisa[Flavio] ),
			        Pesquisa[Instituto] = _i,
			        Pesquisa[Divulgação] = _d,
			        Pesquisa[Tipo] = "validos"
			    )
			RETURN
			    IF ( NOT ISBLANK ( _d ), IF ( _nv > 0, "validos", "totais" ) )
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 0b462238-7b1b-5038-b1cf-31f72e7c265d

	/// Último dia de campo da última pesquisa do instituto.
	measure 'T10 · instituto · campo fim' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Campo fim] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
		formatString: dd/MM
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 34eec3b9-6663-5068-b521-098c500daa0a

	/// Primeiro dia de campo da última pesquisa do instituto.
	measure 'T10 · instituto · campo início' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Campo início] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
		formatString: dd/MM
		displayFolder: T10 Pesquisas\Contas
		lineageTag: bee0d36d-7fea-5db7-b6be-e972230e868f

	/// Flávio − Lula, em pontos, na última pesquisa do instituto (positivo = Flávio à frente).
	measure 'T10 · instituto · diferença' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), [T10 · instituto · Flávio] - [T10 · instituto · Lula] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 559d6a46-ddf3-5540-8043-4210e80a9a6d

	/// Distância, em pontos, entre a diferença Flávio − Lula da última pesquisa do instituto e a da urna, em qualquer base (nos votos totais é a única comparação justa com a urna).
	measure 'T10 · instituto · distância da urna' =
			VAR _d = [T10 · instituto · diferença]
			RETURN
			    IF ( NOT ISBLANK ( _d ), ABS ( _d - [T10 · urna · diferença] ) )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: a915deba-4bf7-56be-b0f2-d438319f6fa9

	/// Entrevistas da última pesquisa do instituto.
	measure 'T10 · instituto · entrevistas' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Amostra] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
		formatString: #,0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 9daa91ea-5c3a-5066-91db-54f66de03483

	/// Urna − pesquisa no número de Flávio, em pontos, na última pesquisa do instituto (só quando ela é em votos válidos; positivo = a pesquisa deu menos que a urna).
	measure 'T10 · instituto · erro Flávio' =
			IF ( [T10 · instituto · base] = "validos", [T10 · urna · Flávio] - [T10 · instituto · Flávio] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 975e676d-391c-56bb-873a-7de0f284f193

	/// Urna − pesquisa no número de Lula, em pontos, na última pesquisa do instituto (só quando ela é em votos válidos; positivo = a pesquisa deu menos que a urna).
	measure 'T10 · instituto · erro Lula' =
			IF ( [T10 · instituto · base] = "validos", [T10 · urna · Lula] - [T10 · instituto · Lula] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 876cf3b6-148c-55c4-89a2-74d33d3ebed7

	/// Diferença da pesquisa menos a diferença da urna, em pontos (negativo = errou a favor de Lula). Só para quem divulgou votos válidos: em votos totais não se compara com a urna.
	measure 'T10 · instituto · erro vs urna' =
			VAR _b = [T10 · instituto · base]
			RETURN
			    IF ( _b = "validos", [T10 · instituto · diferença] - [T10 · urna · diferença] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 8f1b18e8-e1e8-53b6-9eea-809677c6ac06

	/// % de Flávio na última pesquisa do instituto (na base escolhida).
	measure 'T10 · instituto · Flávio' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Flavio] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: c9e472d2-5b4f-5512-a04b-422670123936

	/// % de Lula na última pesquisa do instituto (na base escolhida).
	measure 'T10 · instituto · Lula' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Lula] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 8bd80d65-5741-5a2a-81e9-266f37fa83e5

	/// Margem de erro (pontos) da última pesquisa do instituto.
	measure 'T10 · instituto · margem de erro' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Margem] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 3321ee4d-c5ca-59d2-8c41-777e3d5148af

	/// Quem a última pesquisa do instituto dava à frente: Lula, Flávio ou empate.
	measure 'T10 · instituto · na frente' =
			VAR _d = [T10 · instituto · diferença]
			RETURN
			    IF ( NOT ISBLANK ( _d ), SWITCH ( TRUE (), _d > 0, "Flávio", _d < 0, "Lula", "empate" ) )
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 30beef54-7d2e-5445-b96d-34e11cd4bafe

	/// Nome do instituto da linha, quando ele tem pesquisa de 1º turno com Lula e Flávio (vazio nos outros).
	measure 'T10 · instituto · nome' =
			IF ( NOT ISBLANK ( [T10 · instituto · pesquisa] ), SELECTEDVALUE ( Pesquisa[Instituto] ) )
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 988762b7-7fd9-5ca4-9ff9-38a2f53cd717

	/// Posição do instituto na régua, da maior vantagem de Lula (1) à maior de Flávio; empate na diferença desempata pelo nome (a ordem do mockup).
	measure 'T10 · instituto · ordem' =
			VAR _i = SELECTEDVALUE ( Pesquisa[Instituto] )
			VAR _dif = ROUND ( [T10 · instituto · diferença], 6 )
			VAR _todos =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Instituto] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@d", ROUND ( [T10 · instituto · diferença], 6 )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _dif ),
			        COUNTROWS ( FILTER ( _todos, [@d] < _dif || ( [@d] = _dif && Pesquisa[Instituto] < _i ) ) ) + 1
			    )
		formatString: 0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: b40ed9a6-4253-5c72-a695-827538a13b8c

	/// Id da linha de Pesquisa que vale como a última do instituto (a da data mais recente, na base escolhida; a de menor Id se houver duas).
	measure 'T10 · instituto · pesquisa' =
			VAR _i = SELECTEDVALUE ( Pesquisa[Instituto] )
			VAR _d = [T10 · instituto · última divulgação]
			VAR _b = [T10 · instituto · base]
			RETURN
			    IF (
			        NOT ISBLANK ( _d ),
			        CALCULATE (
			            MIN ( Pesquisa[Id] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Instituto] = _i,
			            Pesquisa[Divulgação] = _d,
			            Pesquisa[Tipo] = _b
			        )
			    )
		formatString: 0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 807751e4-4575-5005-9574-f6038a9aad6a

	/// Quantas pesquisas de 1º turno (votos totais, com Lula e Flávio) o instituto da linha divulgou: os pontos da trajetória no dossiê.
	measure 'T10 · instituto · pesquisas no 1º turno' =
			VAR _i = SELECTEDVALUE ( Pesquisa[Instituto] )
			RETURN
			    IF (
			        NOT ISBLANK ( _i ),
			        CALCULATE (
			            COUNTROWS ( Pesquisa ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Instituto] = _i,
			            Pesquisa[Tipo] = "totais"
			        ) + 0
			    )
		formatString: 0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 32fe9d44-3af2-5063-a3d6-8b9587e64be7

	/// Registro no TSE da última pesquisa do instituto (vazio quando não publicado).
	measure 'T10 · instituto · registro' =
			VAR _id = [T10 · instituto · pesquisa]
			RETURN
			    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Registro] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 1ef45a7f-2fa1-5bac-8794-e24356e27bef

	/// % do candidato da linha ('Candidato ano'[Partido]) na última pesquisa do instituto, só quando ela é em votos válidos (a lista do dossiê ttT10Erro).
	measure 'T10 · instituto · valor válido' =
			VAR _c = [T10 · erro · candidato]
			RETURN
			    IF (
			        [T10 · instituto · base] = "validos",
			        SWITCH ( _c, "Lula", [T10 · instituto · Lula], "Flávio", [T10 · instituto · Flávio] )
			    )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: aa73b412-ede3-574c-899e-379dca34a370

	/// Data da última pesquisa de 1º turno do instituto da linha com Lula e Flávio publicados (grão Pesquisa[Instituto]).
	measure 'T10 · instituto · última divulgação' =
			VAR _i = SELECTEDVALUE ( Pesquisa[Instituto] )
			RETURN
			    IF (
			        NOT ISBLANK ( _i ),
			        CALCULATE (
			            MAX ( Pesquisa[Divulgação] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] ),
			            Pesquisa[Instituto] = _i
			        )
			    )
		formatString: dd/MM
		displayFolder: T10 Pesquisas\Contas
		lineageTag: f398148a-0b2b-57a4-b1e8-8b77776d7d72

	/// Institutos com ao menos uma pesquisa de 1º turno com Lula e Flávio publicados (a última de cada um entra na régua).
	measure 'T10 · institutos' =
			VAR _lista =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Instituto] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@d", [T10 · instituto · diferença],
			        "@b", [T10 · instituto · base]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _lista, NOT ISBLANK ( [@d] ) ) ) + 0
		formatString: 0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 86801489-8517-5bb9-83d6-0e77fd5020bf

	/// Institutos cuja última pesquisa de 1º turno divulgou votos válidos (os únicos comparáveis com a urna).
	measure 'T10 · institutos · com válidos' =
			VAR _lista =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Instituto] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@d", [T10 · instituto · diferença],
			        "@b", [T10 · instituto · base]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _lista, [@b] = "validos" ) ) + 0
		formatString: 0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 885b3ee1-9f4e-5f0b-a330-68a181274f0d

