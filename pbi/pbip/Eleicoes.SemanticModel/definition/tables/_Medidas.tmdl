	/// Índice de Popularidade Digital da Quaest (0–100) no contexto de candidato e data (Monitoramento[Início]); de 08 a 11/10 o ponto de Lula é o patamar máximo do período.
	measure 'T09 · IPD' =
			CALCULATE (
			    AVERAGE ( Monitoramento[Valor] ),
			    Monitoramento[Métrica] IN { "IPD", "IPD (patamar máximo)" }
			)
		formatString: 0.0
		displayFolder: T09 Redes\Contas
		lineageTag: 9b7a4405-9ab8-5a45-a196-38805143ebd4

	/// A data de um ponto do índice de popularidade digital (grão Monitoramento[Início] na camada de pontos e no dossiê ttT09Ipd); vazia nas datas sem índice.
	measure 'T09 · IPD dia · data' =
			VAR _d = SELECTEDVALUE ( Monitoramento[Início] )
			VAR _n =
			    CALCULATE (
			        COUNTROWS ( Monitoramento ),
			        REMOVEFILTERS ( Monitoramento ),
			        Monitoramento[Início] = _d,
			        Monitoramento[Métrica] IN { "IPD", "IPD (patamar máximo)" }
			    )
			RETURN
			    IF ( HASONEVALUE ( Monitoramento[Início] ) && _n > 0, _d )
		formatString: dd/MM
		displayFolder: T09 Redes\Contas
		lineageTag: d1e413a5-6903-52bc-91ed-2c651b49352f

	/// Último dia do período do ponto (o ponto de Lula de 08 a 11/10 é o patamar máximo do período; os outros são de um dia).
	measure 'T09 · IPD dia · fim' =
			VAR _d = [T09 · IPD dia · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _d ),
			        CALCULATE (
			            MAX ( Monitoramento[Fim] ),
			            REMOVEFILTERS ( Monitoramento ),
			            Monitoramento[Início] = _d,
			            Monitoramento[Métrica] IN { "IPD", "IPD (patamar máximo)" }
			        )
			    )
		formatString: dd/MM
		displayFolder: T09 Redes\Contas
		lineageTag: 88be1ba7-519c-56cf-9589-d7f316447002

	/// Índice de popularidade digital de Flávio na data do ponto (Quaest); vazio quando a Quaest não divulgou o dele naquele dia.
	measure 'T09 · IPD dia · Flávio' =
			VAR _d = [T09 · IPD dia · data]
			RETURN
			    IF ( NOT ISBLANK ( _d ), CALCULATE ( [T09 · IPD], REMOVEFILTERS ( Monitoramento ), Monitoramento[Início] = _d, Monitoramento[Candidato] = "Flávio Bolsonaro" ) )
		formatString: 0.0
		displayFolder: T09 Redes\Contas
