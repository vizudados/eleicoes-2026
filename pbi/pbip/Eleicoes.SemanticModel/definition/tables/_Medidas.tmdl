	measure 'T09 · Meta · 7 dias' =
			SWITCH (
			    SELECTEDVALUE ( Monitoramento[Candidato] ),
			    "Lula", [T09 · Meta · 7 dias · Lula],
			    "Flávio Bolsonaro", [T09 · Meta · 7 dias · Flávio]
