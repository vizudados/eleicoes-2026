	/// As três cidades mais populosas do contexto (a UF ou a região) que trocaram Lula por Flávio, da maior para a menor, separadas por vírgula (lista para o dossiê).
	measure 'T12 · maiores cidades que viraram' =
			CONCATENATEX (
			    TOPN (
			        3,
			        FILTER (
			            ADDCOLUMNS (
			                VALUES ( 'Município'[CodIBGE] ),
			                "@v", [T12 · município virou],
			                "@pop", [T12 · população],
			                "@nome", [T12 · nome do município]
			            ),
			            [@v] = 1
			        ),
			        [@pop], DESC,
			        'Município'[CodIBGE], ASC
			    ),
			    [@nome],
			    ", ",
			    [@pop], DESC
			)
		displayFolder: T12 Estados\Contas
		lineageTag: 7c3d7694-9778-57be-bbac-d3b71b015c9e

	/// Margem de Lula em 2022: (Lula − Jair Bolsonaro) ÷ válidos. Positivo, Lula à frente.
	measure 'T12 · margem 2022' =
			DIVIDE ( [T12 · votos de Lula 2022] - [T12 · votos do PL 2022], [T12 · válidos 2022] )
		formatString: 0.0%
		displayFolder: T12 Estados\Contas
		lineageTag: e6b952bc-3dac-512c-9dbc-41a241357d98

	/// Margem de Lula em 2026: (Lula − Flávio Bolsonaro) ÷ válidos. Positivo, Lula à frente.
	measure 'T12 · margem 2026' =
			DIVIDE ( [T12 · votos de Lula 2026] - [T12 · votos do PL 2026], [T12 · válidos 2026] )
		formatString: 0.0%
		displayFolder: T12 Estados\Contas
		lineageTag: 604b17f7-82e7-5f55-9c92-30f311c0bff2

	/// Margem de Lula no Brasil em 2022, com o exterior (ignora a UF).
	measure 'T12 · margem do Brasil 2022' =
			CALCULATE ( [T12 · margem 2022], REMOVEFILTERS ( 'UF' ) )
