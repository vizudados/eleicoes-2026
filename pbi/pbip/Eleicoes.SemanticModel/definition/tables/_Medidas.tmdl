	/// Brancos + nulos no 1º turno de 2006, no recorte.
	measure 'T06 · brancos e nulos · 2006' =
			CALCULATE ( [T06 · brancos (ano)] + [T06 · nulos (ano)], 'Ano'[Ano] = 2006 )
		formatString: #,0
