			        CALCULATE (
			            AVERAGE ( 'Rejeição'[Rejeicao] ),
			            REMOVEFILTERS ( 'Rejeição'[Divulgação], 'Rejeição'[Candidato], 'Rejeição'[Rejeicao], 'Rejeição'[Segmento], 'Rejeição'[Observação] ),
			            'Rejeição'[Segmento] = "total",
			            NOT ISBLANK ( 'Rejeição'[Rejeicao] ),
			            NOT CONTAINSSTRING ( 'Rejeição'[Observação], "rejeicao_exclusiva" ),
			            NOT CONTAINSSTRING ( 'Rejeição'[Observação], "mesma pergunta de resposta múltipla" ),
			            'Rejeição'[Candidato] = "Flávio",
			            'Rejeição'[Divulgação] = _dia
			        )
			    )
		formatString: 0.0
		displayFolder: T17 2º turno\Contas
		lineageTag: 5e52953b-2d3a-5eaf-bf14-3753bbf81ad0

	/// Rejeição (%) de Lula na última medição do instituto do contexto depois do 1º turno (o dia de 'T17 · rejeição · depois · data'). Regra das linhas: eleitorado total; sem a rejeição exclusiva do Datafolha (fica 'não votará de jeito nenhum'); na Ideia, a escala 'poderia votar' (a mesma antes e depois), sem a linha de resposta múltipla.
	measure 'T17 · rejeição · depois · Lula' =
			VAR _dia = [T17 · rejeição · depois · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _dia ),
			        CALCULATE (
			            AVERAGE ( 'Rejeição'[Rejeicao] ),
			            REMOVEFILTERS ( 'Rejeição'[Divulgação], 'Rejeição'[Candidato], 'Rejeição'[Rejeicao], 'Rejeição'[Segmento], 'Rejeição'[Observação] ),
			            'Rejeição'[Segmento] = "total",
			            NOT ISBLANK ( 'Rejeição'[Rejeicao] ),
			            NOT CONTAINSSTRING ( 'Rejeição'[Observação], "rejeicao_exclusiva" ),
			            NOT CONTAINSSTRING ( 'Rejeição'[Observação], "mesma pergunta de resposta múltipla" ),
			            'Rejeição'[Candidato] = "Lula",
			            'Rejeição'[Divulgação] = _dia
			        )
			    )
		formatString: 0.0
		displayFolder: T17 2º turno\Contas
		lineageTag: 58da92bf-2952-53af-b0f0-fdbbcde7930c

	/// Entre os institutos comparáveis, em quantos a rejeição de Flávio caiu da última medição antes do 1º turno para a última depois.
	measure 'T17 · rejeição · Flávio caiu' =
			CALCULATE (
			    VAR _inst =
			        ADDCOLUMNS (
			            VALUES ( 'Rejeição'[Instituto] ),
			            "@ok", [T17 · rejeição · comparável],
			            "@al", [T17 · rejeição · antes · Lula],
			            "@af", [T17 · rejeição · antes · Flávio],
			            "@dl", [T17 · rejeição · depois · Lula],
			            "@df", [T17 · rejeição · depois · Flávio]
			        )
			    VAR _comp = FILTER ( _inst, [@ok] = "Sim" )
			    RETURN
			        COUNTROWS ( FILTER ( _comp, [@df] < [@af] ) ),
			    REMOVEFILTERS ( 'Rejeição' )
			) + 0
		formatString: 0
		displayFolder: T17 2º turno\Contas
		lineageTag: 05a8f5b5-2806-50b5-a85d-a1b56b5eadea

	/// Entre os institutos comparáveis, em quantos a rejeição de Flávio ficou igual ou abaixo da de Lula na última medição depois do 1º turno.
	measure 'T17 · rejeição · Flávio igual ou abaixo' =
			CALCULATE (
