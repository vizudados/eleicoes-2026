	/// Dia do debate de referência do período escolhido (Band 18/10, Globo 23/10).
	measure 'Período · debate · data' =
			IF (
			    ISFILTERED ( 'Período' ) && HASONEVALUE ( 'Período'[Ordem] ),
			    MAX ( 'Período'[Data do debate] )
			)
		formatString: dd/MM
