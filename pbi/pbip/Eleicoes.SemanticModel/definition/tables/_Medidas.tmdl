	/// Texto para leitor de tela dos balões (um par por candidato; com período, a janela da direita é a do período).
	measure 'T09 · Balões · ALT' =
			VAR _per = [Período · escolhido]
			VAR _pL = [T09 · período · interações · Lula]
			VAR _pF = [T09 · período · interações · Flávio]
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "Campanha do 1º turno: Lula " & FORMAT ( [T09 · interações · 1º turno · Lula] / 1000000, "0.0" ) & " mi e Flávio "
			            & FORMAT ( [T09 · interações · 1º turno · Flávio] / 1000000, "0.0" ) & " mi de interações. 2º turno: Lula "
			            & FORMAT ( [T09 · interações · 2º turno · Lula] / 1000000, "0.0" ) & " mi e Flávio "
			            & FORMAT ( [T09 · interações · 2º turno · Flávio] / 1000000, "0.0" ) & " mi.",
			        "Campanha do 1º turno: Lula " & FORMAT ( [T09 · interações · 1º turno · Lula] / 1000000, "0.0" ) & " mi e Flávio "
			            & FORMAT ( [T09 · interações · 1º turno · Flávio] / 1000000, "0.0" ) & " mi de interações. " & [Período · rótulo] & ": "
			            & IF (
			                ISBLANK ( _pL ) || ISBLANK ( _pF ),
			                IF ( _per = 4, "ainda sem números.", "sem dado no período." ),
			                "Lula " & FORMAT ( _pL / 1000000, "0.0" ) & " mi e Flávio " & FORMAT ( _pF / 1000000, "0.0" ) & " mi."
			            )
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 9a3a4a90-5259-5762-8362-b11f9db4d172

	/// Os dois balões de fala de um candidato (grão Monitoramento[Candidato]; vazio para quem não é Lula nem Flávio): área proporcional à média de interações por dia na campanha do 1º turno e no 2º turno, sobre o chão do fundo (y 410). Embaixo, o total da janela (contador) e os dias. Cada balão é alvo do dossiê ttT09Conversa. Com um candidato clicado na coluna da direita ('T09 · foco'), os balões do outro esmaecem (o clique nos próprios balões esmaece pelo visual). Com um período escolhido no filtro, o balão da direita é o da janela da Bites que cabe inteira no período (média por dia; a janela de 24 h depois do debate conta 1 dia) e a escala passa a ser a maior das quatro médias; sem janela no período, só o balão da campanha.
	measure 'T09 · Balões · HTML' =
			-- 1 · Leituras
			VAR _c = [T09 · candidato]
			VAR _i1 = [T09 · interações · 1º turno]
			VAR _per = [Período · escolhido]
			VAR _i2 = IF ( ISBLANK ( _per ), [T09 · interações · 2º turno], [T09 · período · interações] )
			VAR _p1 = [T09 · interações por dia · 1º turno]
			VAR _p2 = IF ( ISBLANK ( _per ), [T09 · interações por dia · 2º turno], [T09 · período · interações por dia] )
			VAR _max = IF ( ISBLANK ( _per ), [T09 · interações por dia · maior], [T09 · período · interações por dia · maior] )
			VAR _d1 = [T09 · 1º turno · dias]
			VAR _d2 = IF ( ISBLANK ( _per ), [T09 · 2º turno · dias], [T09 · período · interações · dias] )
			VAR _p24 = NOT ISBLANK ( _per ) && CONTAINSSTRING ( [T09 · período · interações · métrica], "24h" )
			VAR _foco = [T09 · foco]
			-- 2 · Textos
			VAR _cls = IF ( _c = "Lula", "l", "f" )
			VAR _clsTxt = IF ( _c = "Lula", "lula-esc", "flavio-esc" )
			VAR _focoCurto = SWITCH ( _foco, "Lula", "Lula", "Flávio Bolsonaro", "Flávio" )
			VAR _apaga = IF ( NOT ISBLANK ( _focoCurto ) && _focoCurto <> _c, " apaga", "" )
			VAR _txt1 = FORMAT ( _i1 / 1000000, "0.0" ) & " mi"
			VAR _txt2 = FORMAT ( _i2 / 1000000, "0.0" ) & " mi"
			-- 3 · Geometria (raio até 132 px; área ∝ média por dia; chão em y 410)
			VAR _cx1 = IF ( _c = "Lula", 140, 370 ) -- geometria
			VAR _cx2 = IF ( _c = "Lula", 700, 940 ) -- geometria
			VAR _r1 = 132 * SQRT ( DIVIDE ( _p1, _max ) ) -- geometria
			VAR _r2 = 132 * SQRT ( DIVIDE ( _p2, _max ) ) -- geometria
			VAR _f = "0.0"
			VAR _balao =
			    "<g class='bal #K'>"
			        & "<path class='miolo cor' style='animation-delay:#Tms' d='M#X0 #CY a#R #R 0 1 0 #D 0 a#R #R 0 1 0 -#D 0 Z M#A1 #B1 L#A2 #B2 L#A3 #B3 Z'/>"
			        & "<path class='aro traco' pathLength='1' filter='url(#rbu)' style='animation-delay:#Sms' d='M#A1 #B1 L#A2 #B2 L#A3 #B3'/>"
			        & "<path class='aro traco' pathLength='1' filter='url(#rbu)' style='animation-delay:#Sms' d='M#X0 #CY a#R #R 0 1 0 #D 0 a#R #R 0 1 0 -#D 0'/>"
			    & "</g>"
			VAR _b1 =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
			        _balao,
			        "#K", _cls ),
			        "#T", "1300" ),
			        "#S", IF ( _c = "Lula", "300", "450" ) ),
			        "#X0", FORMAT ( _cx1 - _r1, _f, "en-US" ) ),
			        "#CY", FORMAT ( 410 - _r1, _f, "en-US" ) ),
			        "#R", FORMAT ( _r1, _f, "en-US" ) ),
			        "#D", FORMAT ( 2 * _r1, _f, "en-US" ) ),
			        "#A1", FORMAT ( _cx1 - 0.87 * _r1, _f, "en-US" ) & " " & FORMAT ( 410 - _r1 + 0.5 * _r1, _f, "en-US" ) ),
			        "#B1", "" ),
			        "#A2", FORMAT ( _cx1 - _r1 - 16, _f, "en-US" ) & " 408" ),
			        "#B2", "" ),
			        "#A3", FORMAT ( _cx1 - 0.55 * _r1, _f, "en-US" ) & " " & FORMAT ( 410 - _r1 + 0.83 * _r1, _f, "en-US" ) )
			VAR _b1b = SUBSTITUTE ( _b1, "#B3", "" )
			VAR _b2 =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
			        _balao,
			        "#K", _cls ),
			        "#T", "1900" ),
			        "#S", IF ( _c = "Lula", "1000", "1150" ) ),
			        "#X0", FORMAT ( _cx2 - _r2, _f, "en-US" ) ),
			        "#CY", FORMAT ( 410 - _r2, _f, "en-US" ) ),
			        "#R", FORMAT ( _r2, _f, "en-US" ) ),
			        "#D", FORMAT ( 2 * _r2, _f, "en-US" ) ),
			        "#A1", FORMAT ( _cx2 - 0.87 * _r2, _f, "en-US" ) & " " & FORMAT ( 410 - _r2 + 0.5 * _r2, _f, "en-US" ) ),
			        "#B1", "" ),
			        "#A2", FORMAT ( _cx2 - _r2 - 16, _f, "en-US" ) & " 408" ),
			        "#B2", "" ),
			        "#A3", FORMAT ( _cx2 - 0.55 * _r2, _f, "en-US" ) & " " & FORMAT ( 410 - _r2 + 0.83 * _r2, _f, "en-US" ) ),
			        "#B3", "" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _c ) && NOT ISBLANK ( _i1 ),
			        "<div class='tela t09b" & _apaga & "'>"
			            & "<svg width='1040' height='530' viewBox='0 0 1040 530'>" & _b1b & IF ( NOT ISBLANK ( _i2 ), _b2 ) & "</svg>"
			            & "<div class='lab sobe d8' style='left:" & _cx1 & "px;top:420px'><b class='" & _clsTxt & "'>" & _c & "</b>"
			                & "<span class='num " & _clsTxt & "'>" & _txt1 & "</span><span class='sub'>em " & _d1 & " dias</span></div>"
			            & IF (
			                NOT ISBLANK ( _i2 ),
			                "<div class='lab sobe d12' style='left:" & _cx2 & "px;top:420px'><b class='" & _clsTxt & "'>" & _c & "</b>"
			                    & "<span class='num " & _clsTxt & "'>" & _txt2 & "</span><span class='sub'>"
			                    & IF ( _p24, "em 24 h", "em " & _d2 & " dias" ) & "</span></div>"
			            )
			        & "</div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 75145aa6-222f-5f08-922d-e06bcd4eb932

	/// Texto para leitor de tela do fundo do protagonista (as duas janelas; com período, a da direita é a do período).
	measure 'T09 · Conversa · ALT' =
			VAR _per = [Período · escolhido]
			VAR _pD = [T09 · período · interações · dias]
			VAR _p24 = CONTAINSSTRING ( [T09 · período · interações · métrica], "24h" )
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "Interações nos perfis oficiais em duas janelas da Bites: a campanha do 1º turno (" & [T09 · 1º turno · dias] & " dias) e o 2º turno ("
			            & [T09 · 2º turno · dias] & " dias). O tamanho de cada balão é a média de interações por dia.",
			        "Interações nos perfis oficiais em duas janelas da Bites: a campanha do 1º turno (" & [T09 · 1º turno · dias]
			            & " dias) e " & [Período · rótulo]
			            & IF (
			                ISBLANK ( _pD ),
			                IF ( _per = 4, ", ainda sem números.", ", sem dado no período." ),
			                " (" & IF ( _p24, "24 h após o debate", _pD & " dias" ) & "). O tamanho de cada balão é a média por dia."
			            )
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 8a7b1166-7d32-5480-af55-17e2a3ec1b47

	/// Fundo do protagonista (as interações nas duas janelas da Bites): título, a frase com a média por dia de cada um antes e depois, os nomes das janelas, o chão dos balões, a divisória e as notas à mão. Os balões são outro visual (T09 · Balões · HTML), na mesma caixa. Com um período escolhido no filtro, a janela da direita passa a ser a da Bites que cabe inteira no período (Antes da Band, 05 a 17/10; Depois da Band, as 24 h depois do debate), com a janela real no título; a nota à mão compara a distância das duas janelas e aponta o balão maior da direita, de quem for; sem janela no período, o lugar dos balões fica tracejado com 'sem dado no período' (Depois da Globo, 'aguardando').
	measure 'T09 · Conversa · HTML' =
			-- 1 · Leituras
			VAR _ini1 = [T09 · 1º turno · início]
			VAR _fim1 = [T09 · 1º turno · fim]
			VAR _ini2 = [T09 · 2º turno · início]
			VAR _fim2 = [T09 · 2º turno · fim]
			VAR _d1 = [T09 · 1º turno · dias]
			VAR _d2 = [T09 · 2º turno · dias]
			VAR _r1 = [T09 · interações · razão no 1º turno]
			VAR _l1 = CALCULATE ( [T09 · interações por dia · 1º turno], Monitoramento[Candidato] = "Lula" )
			VAR _f1 = CALCULATE ( [T09 · interações por dia · 1º turno], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			VAR _l2 = CALCULATE ( [T09 · interações por dia · 2º turno], Monitoramento[Candidato] = "Lula" )
			VAR _f2 = CALCULATE ( [T09 · interações por dia · 2º turno], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			-- com período
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pIni = [Período · início]
			VAR _pFim = [Período · fim]
			VAR _pI = [T09 · período · interações · início]
			VAR _pIf = [T09 · período · interações · fim]
			VAR _p24 = CONTAINSSTRING ( [T09 · período · interações · métrica], "24h" )
			VAR _pD = [T09 · período · interações · dias]
			VAR _pR = [T09 · período · interações · razão]
			VAR _pl2 = CALCULATE ( [T09 · período · interações por dia], Monitoramento[Candidato] = "Lula" )
			VAR _pf2 = CALCULATE ( [T09 · período · interações por dia], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			-- 2 · Textos
			VAR _txtMan =
			    "Interações por dia: Flávio foi de " & FORMAT ( _f1 / 1000000, "0.0" ) & " a " & FORMAT ( _f2 / 1000000, "0.0" )
			        & " mi; Lula, de " & FORMAT ( _l1 / 1000000, "0.0" ) & " a " & FORMAT ( _l2 / 1000000, "0.0" ) & " mi"
			VAR _txtJan1 =
			    "Campanha do 1º turno · " & FORMAT ( _ini1, "dd/MM" ) & " a " & FORMAT ( _fim1, "dd/MM" ) & " · " & _d1 & " dias"
			VAR _txtJan2 =
			    "2º turno · " & FORMAT ( _ini2, "dd/MM" ) & " a " & FORMAT ( _fim2, "dd/MM" ) & " · " & _d2 & " dias"
			VAR _txtNota1 = IF ( _r1 >= 0.8 && _r1 <= 1.25, "quase empate", "um à frente" )
			-- com período: a janela real ('05 a 17/10', '18 e 19/10') e o nome do período no meio da frase
			VAR _temP = NOT ISBLANK ( _pl2 ) && NOT ISBLANK ( _pf2 )
			VAR _espera = _per = 4 && NOT _temP
			VAR _nomeMin = LOWER ( LEFT ( _pNome, 1 ) ) & MID ( _pNome, 2, 40 )
			VAR _janP =
			    SWITCH (
			        TRUE (),
			        _pI = _pIf, FORMAT ( _pI, "dd/MM" ),
			        IF ( MONTH ( _pI ) = MONTH ( _pIf ), FORMAT ( _pI, "dd" ), FORMAT ( _pI, "dd/MM" ) )
			            & IF ( DATEDIFF ( _pI, _pIf, DAY ) = 1, " e ", " a " ) & FORMAT ( _pIf, "dd/MM" )
			    )
			VAR _janPer =
			    IF ( MONTH ( _pIni ) = MONTH ( _pFim ), FORMAT ( _pIni, "dd" ), FORMAT ( _pIni, "dd/MM" ) )
			        & IF ( DATEDIFF ( _pIni, _pFim, DAY ) = 1, " e ", " a " ) & FORMAT ( _pFim, "dd/MM" )
			VAR _pMan =
			    SWITCH (
			        TRUE (),
			        _espera, "Por dia, " & _nomeMin & ": os números ainda não chegaram",
			        NOT _temP, "Por dia, " & _nomeMin & ": sem dado no período",
			        "Por dia, " & _nomeMin & ": Flávio foi de " & FORMAT ( _f1 / 1000000, "0.0" ) & " a "
			            & FORMAT ( _pf2 / 1000000, "0.0" ) & " mi; Lula, de " & FORMAT ( _l1 / 1000000, "0.0" ) & " a "
			            & FORMAT ( _pl2 / 1000000, "0.0" ) & " mi"
			    )
			VAR _pJan2 =
			    _pNome & " · " & IF ( _temP, IF ( _p24, "24 h após o debate", _janP & " · " & _pD & " dias" ), _janPer )
			-- a distância entre os dois: abriu ou fechou da campanha para o período (a mesma régua para os dois)
			VAR _pNota2 = IF ( ABS ( LN ( _pR ) ) > ABS ( LN ( _r1 ) ), "a distância abriu", "a distância diminuiu" )
			VAR _lulaMaior = _pl2 >= _pf2
			-- 4 · Marcação
			VAR _direita =
			    IF (
			        ISBLANK ( _per ),
			        "<div class='mao entra d16' style='left:812px;top:138px'>a distância abriu</div>"
			            & "<div class='seta entra d16' style='left:748px;top:166px;width:70px'></div>",
			        SWITCH (
			            TRUE (),
			            _espera, "<div class='vazio entra d6'><span class='mao'>aguardando</span><span class='nota'>Até a manhã de domingo, 25/10, "
			                & "a Bites não tinha publicado as interações por dia depois do debate da Globo.</span></div>",
			            NOT _temP, "<div class='vazio entra d6'><span class='rot'>sem dado no período</span><span class='nota'>"
			                & "Nenhuma medição das interações dos dois cabe inteira em " & _janPer & ".</span></div>",
			            IF (
			                _lulaMaior,
			                "<div class='mao entra d16' style='left:812px;top:138px'>" & _pNota2 & "</div>"
			                    & "<div class='seta entra d16' style='left:748px;top:166px;width:70px'></div>",
			                "<div class='mao entra d16' style='left:566px;top:138px'>" & _pNota2 & "</div>"
			                    & "<div class='seta entra d16' style='left:842px;top:166px;width:70px;transform:scaleX(-1)'></div>"
			            )
			        )
			    )
			RETURN
			    "<div class='tela t09c'>"
			        & "<div class='sob sobe'>Interações nos perfis oficiais · X, Instagram, Facebook, TikTok e YouTube · Bites</div>"
			        & "<div class='man sobe d2'>" & IF ( ISBLANK ( _per ), _txtMan, _pMan ) & "</div>"
			        & "<div class='jan sob sobe d3' style='left:0'>" & _txtJan1 & "</div>"
			        & "<div class='jan sob sobe d4' style='left:560px'>" & IF ( ISBLANK ( _per ), _txtJan2, _pJan2 ) & "</div>"
			        & "<svg width='1040' height='530' viewBox='0 0 1040 530'>"
			            & "<path d='M10 410 H500' pathLength='1' class='chao traco' filter='url(#rbu)'/>"
			            & "<path d='M560 410 H1030' pathLength='1' class='chao traco' filter='url(#rbu)' style='animation-delay:.3s'/>"
			            & "<line x1='530' x2='530' y1='104' y2='500' class='div'/>"
			        & "</svg>"
			        & "<div class='mao entra d14' style='left:168px;top:196px'>" & _txtNota1 & "</div>"
			        & _direita
			        & "<div class='nota entra d12'>Tamanho do balão: a média de interações por dia, para comparar janelas de tamanhos diferentes</div>"
			    & "</div>"
		displayFolder: T09 Redes\Desenho
		lineageTag: e7143f4e-16e5-5239-9628-eb16127aed4b

	/// Texto para leitor de tela do número da tela das redes (≤ 250 caracteres); com período, o da janela de interações da Bites que cabe nele, ou 'sem dado no período'.
	measure 'T09 · Herói · ALT' =
			VAR _per = [Período · escolhido]
			VAR _pL = [T09 · período · interações · Lula]
			VAR _pF = [T09 · período · interações · Flávio]
			VAR _p24 = CONTAINSSTRING ( [T09 · período · interações · métrica], "24h" )
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "No 2º turno, Lula teve " & FORMAT ( [T09 · interações · razão no 2º turno], "0.0" ) & " vezes as interações de Flávio nos perfis oficiais ("
			            & FORMAT ( [T09 · interações · 2º turno · Lula] / 1000000, "0.0" ) & " mi contra " & FORMAT ( [T09 · interações · 2º turno · Flávio] / 1000000, "0.0" )
			            & " mi, Bites). Na campanha do 1º turno, Flávio ganhou mais seguidores.",
			        [Período · rótulo] & ": "
			            & IF (
			                ISBLANK ( _pL ) || ISBLANK ( _pF ),
			                IF ( _per = 4, "os números das redes ainda não chegaram.", "sem dado no período para as interações dos dois." ),
			                "Lula " & FORMAT ( _pL / 1000000, "0.0" ) & " mi e Flávio " & FORMAT ( _pF / 1000000, "0.0" )
			                    & " mi de interações nos perfis oficiais (Bites" & IF ( _p24, ", 24 h após o debate", "" ) & ")."
			            )
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 45b12cd2-7abe-5b32-914e-e43cb367d86e

	/// O número da tela (quantas vezes as interações de um foram as do outro no 2º turno, contador), a frase ao lado, a manchete (quem dominou as interações no 2º turno e quem ganhou mais seguidores na campanha do 1º) e o que é interação. Com um período escolhido no filtro (Período · escolhido): o número e a manchete passam a ser os da janela de interações da Bites que cabe inteira no período (Antes da Band, 05 a 17/10; Depois da Band, as 24 h depois do debate) e dos seguidores ganhos na janela que cabe nele, com a janela real escrita; sem janela que caiba, 'sem dado no período'; Depois da Globo, 'aguardando'. Só lê contas 'T09 · …' e 'Período · …'.
	measure 'T09 · Herói · HTML' =
			-- 1 · Leituras
			VAR _l2 = [T09 · interações · 2º turno · Lula]
			VAR _f2 = [T09 · interações · 2º turno · Flávio]
			VAR _r2 = [T09 · interações · razão no 2º turno]
			VAR _ini2 = [T09 · 2º turno · início]
			VAR _fim2 = [T09 · 2º turno · fim]
			VAR _sL = [T09 · seguidores ganhos · campanha · Lula]
			VAR _sF = [T09 · seguidores ganhos · campanha · Flávio]
			-- com período
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pIni = [Período · início]
			VAR _pFim = [Período · fim]
			VAR _pL = [T09 · período · interações · Lula]
			VAR _pF = [T09 · período · interações · Flávio]
			VAR _pR = [T09 · período · interações · razão]
			VAR _pI = [T09 · período · interações · início]
			VAR _pIf = [T09 · período · interações · fim]
			VAR _p24 = CONTAINSSTRING ( [T09 · período · interações · métrica], "24h" )
			VAR _psL = [T09 · período · seguidores ganhos · Lula]
			VAR _psF = [T09 · período · seguidores ganhos · Flávio]
			VAR _psI = [T09 · período · seguidores · início]
			VAR _psIf = [T09 · período · seguidores · fim]
			VAR _psFonte = [T09 · período · seguidores · fonte]
			VAR _psIg = CONTAINSSTRING ( [T09 · período · seguidores · métrica], "Instagram" )
			-- 2 · Textos
			VAR _quemI = IF ( _l2 >= _f2, "Lula", "Flávio" )
			VAR _outroI = IF ( _quemI = "Lula", "Flávio", "Lula" )
			VAR _vezes = IF ( _l2 >= _f2, _r2, DIVIDE ( 1, _r2 ) )
			VAR _quemS = IF ( _sF >= _sL, "Flávio", "Lula" )
			VAR _txtMan =
			    "No 2º turno, as redes foram de " & _quemI & "; na campanha do 1º, quem ganhou mais seguidores foi " & _quemS
			VAR _txtSob =
			    "2º turno · " & FORMAT ( _ini2, "dd/MM" ) & " a " & FORMAT ( _fim2, "dd/MM" ) & " · interações nos perfis oficiais"
			-- com período: a janela real de cada número ('05 a 17/10', '18 e 19/10', '18/10')
			VAR _janP =
			    SWITCH (
			        TRUE (),
			        _pI = _pIf, FORMAT ( _pI, "dd/MM" ),
			        IF ( MONTH ( _pI ) = MONTH ( _pIf ), FORMAT ( _pI, "dd" ), FORMAT ( _pI, "dd/MM" ) )
			            & IF ( DATEDIFF ( _pI, _pIf, DAY ) = 1, " e ", " a " ) & FORMAT ( _pIf, "dd/MM" )
			    )
			VAR _janI = IF ( _p24, "24 h após o debate (" & _janP & ")", _janP )
			VAR _janS =
			    SWITCH (
			        TRUE (),
			        _psI = _psIf, FORMAT ( _psI, "dd/MM" ),
			        IF ( MONTH ( _psI ) = MONTH ( _psIf ), FORMAT ( _psI, "dd" ), FORMAT ( _psI, "dd/MM" ) )
			            & IF ( DATEDIFF ( _psI, _psIf, DAY ) = 1, " e ", " a " ) & FORMAT ( _psIf, "dd/MM" )
			    )
			VAR _janPer =
			    IF ( MONTH ( _pIni ) = MONTH ( _pFim ), FORMAT ( _pIni, "dd" ), FORMAT ( _pIni, "dd/MM" ) )
			        & IF ( DATEDIFF ( _pIni, _pFim, DAY ) = 1, " e ", " a " ) & FORMAT ( _pFim, "dd/MM" )
			VAR _temI = NOT ISBLANK ( _pL ) && NOT ISBLANK ( _pF )
			VAR _espera = _per = 4 && NOT _temI
			VAR _pQuemI = IF ( _pL >= _pF, "Lula", "Flávio" )
			VAR _pOutroI = IF ( _pQuemI = "Lula", "Flávio", "Lula" )
			VAR _pVezes = IF ( _pL >= _pF, _pR, DIVIDE ( 1, _pR ) )
			VAR _pQuemS = IF ( _psF > _psL, "Flávio", "Lula" )
			VAR _pSob =
			    _pNome & " · " & IF ( _temI, _janI, _janPer ) & " · interações" & IF ( _p24, "", " nos perfis oficiais" )
			VAR _pMan =
			    SWITCH (
			        TRUE (),
			        _espera, _pNome & ", os números das redes ainda não chegaram",
			        NOT _temI, _pNome & ", nenhuma medição das interações dos dois cabe só nesses dias",
			        _pNome & ", as interações foram de " & _pQuemI
			            & SWITCH (
			                TRUE (),
			                ISBLANK ( _psL ) || ISBLANK ( _psF ), "; de seguidores ganhos, sem dado no período",
			                _psL = _psF, "; em seguidores ganhos, empate",
			                _pQuemS = _pQuemI, " e os seguidores ganhos também",
			                "; os seguidores ganhos, de " & _pQuemS
			            )
			    )
			VAR _pTxt =
			    SWITCH (
			        TRUE (),
			        _espera, "Até a manhã de domingo, 25/10, a Bites não tinha publicado as interações dos dois depois do debate. "
			            & "Interação é toda reação a uma publicação: curtida, comentário, compartilhamento.",
			        NOT _temI, "As medições publicadas terminam antes ou atravessam o período, e aqui só entra a que cabe "
			            & "inteira nele. Interação é toda reação a uma publicação.",
			        "Janelas que cabem no período: interações, Bites, " & _janI
			            & IF (
			                NOT ISBLANK ( _psL ) && NOT ISBLANK ( _psF ),
			                "; seguidores, " & _psFonte & IF ( _psIg, ", só Instagram", "" ) & ", " & _janS
			            )
			            & ". Interação é toda reação a uma publicação."
			    )
			VAR _pNum =
			    SWITCH (
			        TRUE (),
			        _espera, "<div class='hero sobe d1'><span class='vazio mao'>aguardando</span></div>",
			        NOT _temI, "<div class='hero sobe d1'><span class='vazio'>sem dado no período</span></div>",
			        "<div class='hero sobe d1'><span class='num'>" & FORMAT ( _pVezes, "0.0" ) & "</span><span class='u'>vezes</span></div>"
			    )
			VAR _pLado =
			    SWITCH (
			        TRUE (),
			        _espera, "os números depois do debate da Globo ainda não chegaram",
			        NOT _temI, "nenhuma medição das interações dos dois cabe em " & _janPer,
			        "mais interações para " & _pQuemI & " do que para " & _pOutroI & IF ( _p24, " nas 24 h depois do debate", "" )
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "<div class='tela t09a'>"
			            & "<div class='sob sobe'>" & _txtSob & "</div>"
			            & "<div class='linha'>"
			                & "<div class='hero sobe d1'><span class='num'>" & FORMAT ( _vezes, "0.0" ) & "</span><span class='u'>vezes</span></div>"
			                & "<div class='lado sobe d3'>mais interações para " & _quemI & " do que para " & _outroI & "</div>"
			            & "</div>"
			            & "<div class='man sobe d5'>" & _txtMan & "</div>"
			            & "<div class='txt sobe d6'>Interação é toda reação a uma publicação: curtida, comentário, compartilhamento. "
			                & "Mostra o alcance nas redes, não a intenção de voto.</div>"
			        & "</div>",
			        "<div class='tela t09a'>"
			            & "<div class='sob sobe'>" & _pSob & "</div>"
			            & "<div class='linha'>" & _pNum & "<div class='lado sobe d3'>" & _pLado & "</div></div>"
			            & "<div class='man sobe d5'>" & _pMan & "</div>"
			            & "<div class='txt sobe d6'>" & _pTxt & "</div>"
			        & "</div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 74fc9dea-d5c8-57de-a47e-f9a235c45713

	/// Texto para leitor de tela da coluna da direita (seguidores ganhos e o ritmo depois do 1º turno; com período, a medição que cabe nele ou 'sem dado no período').
	measure 'T09 · Lado · ALT' =
			VAR _per = [Período · escolhido]
			VAR _psL = [T09 · período · seguidores ganhos · Lula]
			VAR _psF = [T09 · período · seguidores ganhos · Flávio]
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "Seguidores ganhos em Instagram, Facebook, TikTok e YouTube na campanha do 1º turno (Bites) e o ganho médio por dia antes e logo depois do 1º turno. Anúncios na Meta: no dossiê de cada nome.",
			        "Seguidores ganhos, " & [Período · rótulo] & ": "
			            & IF (
			                ISBLANK ( _psL ) || ISBLANK ( _psF ),
			                IF ( _per = 4, "os números ainda não chegaram.", "sem dado no período." ),
			                "Lula +" & FORMAT ( _psL / 1000, "#,0" ) & " mil e Flávio +" & FORMAT ( _psF / 1000, "#,0" )
			                    & " mil (" & [T09 · período · seguidores · fonte]
			                    & IF ( CONTAINSSTRING ( [T09 · período · seguidores · métrica], "Instagram" ), ", só Instagram", "" ) & ")."
			            )
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 01765d06-0e9e-5e8f-bd4f-3f8b4416fb26

	/// Fundo da coluna da direita, só seguidores (os anúncios na Meta foram para o dossiê ttT09Lado): título, frase e fonte dos seguidores ganhos na campanha do 1º turno; o bloco do ritmo logo depois do 1º turno (mesma fonte e mesmas quatro redes, ganho por dia) e a nota de que depois de 08/10 as fontes divergem. As barras e os números de cada um são outro visual (T09 · Linhas · HTML), na mesma caixa. Com um período escolhido no filtro: os seguidores ganhos na janela que cabe inteira no período (Antes da Band, Bites de 05 a 17/10; Depois da Band, Quaest, só Instagram, 18/10), com a janela real e a fonte escritas, e o ritmo por dia na mesma janela (sem ritmo numa janela de um dia); sem janela, o lugar das barras tracejado com 'sem dado no período' (Depois da Globo, 'aguardando').
	measure 'T09 · Lado · HTML' =
			-- 1 · Leituras
			VAR _sL = [T09 · seguidores ganhos · campanha · Lula]
			VAR _sF = [T09 · seguidores ganhos · campanha · Flávio]
			VAR _ini1 = [T09 · seguidores · campanha · início]
			VAR _fim1 = [T09 · seguidores · campanha · fim]
			VAR _d1 = [T09 · seguidores · campanha · dias]
			VAR _ini2 = [T09 · seguidores · após o 1º turno · início]
			VAR _fim2 = [T09 · seguidores · após o 1º turno · fim]
			VAR _d2 = [T09 · seguidores · após o 1º turno · dias]
			-- com período
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pIni = [Período · início]
			VAR _pFim = [Período · fim]
			VAR _psL = [T09 · período · seguidores ganhos · Lula]
			VAR _psF = [T09 · período · seguidores ganhos · Flávio]
			VAR _psI = [T09 · período · seguidores · início]
			VAR _psIf = [T09 · período · seguidores · fim]
			VAR _psD = [T09 · período · seguidores · dias]
			VAR _psFonte = [T09 · período · seguidores · fonte]
			VAR _psIg = CONTAINSSTRING ( [T09 · período · seguidores · métrica], "Instagram" )
			-- 2 · Textos
			VAR _quemS = IF ( _sF >= _sL, "Flávio", "Lula" )
			VAR _txtJan1 = FORMAT ( _ini1, "dd/MM" ) & " a " & FORMAT ( _fim1, "dd/MM" ) & ", " & _d1 & " dias"
			VAR _txtJan2 = FORMAT ( _ini2, "dd/MM" ) & " a " & FORMAT ( _fim2, "dd/MM" ) & ", " & _d2 & IF ( _d2 = 1, " dia", " dias" )
			-- com período: a janela real da medição que cabe nele, a fonte e as redes
			VAR _janS =
			    SWITCH (
			        TRUE (),
			        _psI = _psIf, FORMAT ( _psI, "dd/MM" ),
			        IF ( MONTH ( _psI ) = MONTH ( _psIf ), FORMAT ( _psI, "dd" ), FORMAT ( _psI, "dd/MM" ) )
			            & IF ( DATEDIFF ( _psI, _psIf, DAY ) = 1, " e ", " a " ) & FORMAT ( _psIf, "dd/MM" )
			    )
			VAR _janPer =
			    IF ( MONTH ( _pIni ) = MONTH ( _pFim ), FORMAT ( _pIni, "dd" ), FORMAT ( _pIni, "dd/MM" ) )
			        & IF ( DATEDIFF ( _pIni, _pFim, DAY ) = 1, " e ", " a " ) & FORMAT ( _pFim, "dd/MM" )
			VAR _temP = NOT ISBLANK ( _psL ) && NOT ISBLANK ( _psF )
			VAR _espera = _per = 4 && NOT _temP
			VAR _pQuem = SWITCH ( TRUE (), _psL > _psF, "Lula", _psF > _psL, "Flávio" )
			VAR _pMan =
			    SWITCH (
			        TRUE (),
			        _espera, _pNome & ", os números ainda não chegaram",
			        NOT _temP, _pNome & ": sem dado no período",
			        ISBLANK ( _pQuem ), _pNome & ", os dois ganharam o mesmo número de seguidores",
			        _pNome & ", quem mais ganhou seguidores foi " & _pQuem
			    )
			VAR _pNota =
			    SWITCH (
			        TRUE (),
			        _espera, "Até a manhã de domingo, 25/10, nenhuma medição do ganho dos dois cabia inteira em " & _janPer & ".",
			        NOT _temP, "Nenhuma medição do ganho dos dois cabe inteira em " & _janPer & ".",
			        _janS & IF ( _psD = 1 && _psI = [Período · debate · data], ", dia do debate", "" ) & " · "
			            & IF ( _psIg, "só Instagram", "a fonte não detalha as redes" ) & " · " & _psFonte
			    )
			VAR _pRitmo =
			    IF (
			        _psD = 1,
			        "A janela é de um dia só: o ganho do dia já é o número de cima.",
			        "Ganho médio por dia na mesma janela de cima, " & _janS & ", " & _psD & " dias."
			    )
			VAR _periodo =
			    "<div class='tela t09l'>"
			        & "<div class='bloco' style='top:0'>"
			            & "<div class='sob sobe'>Seguidores ganhos · " & _pNome & "</div>"
			            & "<div class='man sobe d2'>" & _pMan & "</div>"
			            & "<div class='nota sobe d3'>" & _pNota & "</div>"
			        & "</div>"
			        & IF (
			            _temP,
			            "<hr class='entra d8'/>"
			                & "<div class='bloco' style='top:322px'>"
			                    & "<div class='sob sobe d8'>O ritmo no período</div>"
			                    & "<div class='txt sobe d9'>" & _pRitmo & "</div>"
			                & "</div>",
			            "<div class='vazio entra d6'>"
			                & IF ( _espera, "<span class='mao'>aguardando</span>", "<span class='rot'>sem dado no período</span>" )
			            & "</div>"
			        )
			        & "<div class='ress entra d14'>Só entra a medição que cabe inteira no período; as fontes contam redes e dias "
			            & "diferentes. Passe o mouse num nome: redes uma a uma e anúncios na Meta.</div>"
			    & "</div>"
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _per ),
			        _periodo,
			        "<div class='tela t09l'>"
			            & "<div class='bloco' style='top:0'>"
			                & "<div class='sob sobe'>Seguidores ganhos em quatro redes</div>"
			                & "<div class='man sobe d2'>Na campanha do 1º turno, quem mais ganhou seguidores foi " & _quemS & "</div>"
			                & "<div class='nota sobe d3'>" & _txtJan1 & " · Instagram, Facebook, TikTok e YouTube · Bites</div>"
			            & "</div>"
			            & "<hr class='entra d8'/>"
			            & "<div class='bloco' style='top:322px'>"
			                & "<div class='sob sobe d8'>O ritmo logo depois do 1º turno</div>"
			                & "<div class='txt sobe d9'>Ganho médio por dia, mesma fonte e mesmas redes: de " & _txtJan1 & ", e de " & _txtJan2 & ".</div>"
			            & "</div>"
			            & "<div class='ress entra d14'>Depois de 08/10, Bites e Datrix contam redes e dias diferentes e não concordam. "
			                & "Passe o mouse num nome: redes uma a uma e anúncios na Meta.</div>"
			        & "</div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 8204a488-a5a3-5bb0-b0a0-7d647a958eb7

	/// Texto para leitor de tela das barras e do ritmo de cada candidato na coluna da direita (com período, a medição que cabe nele).
	measure 'T09 · Linhas · ALT' =
			VAR _per = [Período · escolhido]
			VAR _psL = [T09 · período · seguidores ganhos · Lula]
			VAR _psF = [T09 · período · seguidores ganhos · Flávio]
			VAR _pD = [T09 · período · seguidores · dias]
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "Seguidores ganhos de 16/08 a 03/10: Lula +" & FORMAT ( [T09 · seguidores ganhos · campanha · Lula] / 1000000, "0.00" )
			            & " mi, Flávio +" & FORMAT ( [T09 · seguidores ganhos · campanha · Flávio] / 1000000, "0.00" )
			            & " mi. Por dia, de 04 a 08/10: Lula " & FORMAT ( CALCULATE ( [T09 · seguidores por dia · após o 1º turno], Monitoramento[Candidato] = "Lula" ) / 1000, "0" )
			            & " mil, Flávio " & FORMAT ( CALCULATE ( [T09 · seguidores por dia · após o 1º turno], Monitoramento[Candidato] = "Flávio Bolsonaro" ) / 1000, "0" ) & " mil.",
			        IF (
			            ISBLANK ( _psL ) || ISBLANK ( _psF ),
			            [Período · rótulo] & ": sem barras de seguidores ganhos no período.",
			            "Seguidores ganhos, " & [Período · rótulo] & ": Lula +" & FORMAT ( _psL / 1000, "#,0" ) & " mil, Flávio +"
			                & FORMAT ( _psF / 1000, "#,0" ) & " mil"
			                & IF ( _pD > 1, "; por dia, Lula " & FORMAT ( _psL / _pD / 1000, "0" ) & " mil e Flávio "
			                    & FORMAT ( _psF / _pD / 1000, "0" ) & " mil.", "." )
			        )
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: cb9e4a97-1e9e-5ba5-b15d-34386cf3c9fd

	/// A linha de um candidato na coluna da direita (grão Seguidores[Candidato], para o clique aqui não apagar os balões e o clique nos balões não sumir com uma linha daqui; vazio para quem não é Lula nem Flávio): a barra larga dos seguidores ganhos na campanha do 1º turno (cresce) com o número grande, e o ritmo por dia antes e logo depois do 1º turno (mesma fonte, mesmas redes). As contas de Monitoramento recebem o candidato da linha. Com um candidato clicado nos balões ('T09 · foco'), a linha do outro esmaece. As duas linhas são alvo do dossiê ttT09Lado (seguidores rede a rede e anúncios na Meta). Com um período escolhido no filtro: a barra é o ganho na janela que cabe inteira no período (em mil abaixo de 1 milhão) e o ritmo é o ganho médio por dia na mesma janela (sem ritmo numa janela de um dia); sem janela no período, a linha fica vazia (o fundo diz 'sem dado no período').
	measure 'T09 · Linhas · HTML' =
			-- 1 · Leituras
			VAR _c = [T09 · lado · candidato]
			VAR _cBase = [T09 · lado · nome completo]
			VAR _foco = [T09 · foco]
			VAR _per = [Período · escolhido]
			VAR _s =
			    IF (
			        ISBLANK ( _per ),
			        CALCULATE ( [T09 · seguidores ganhos · campanha], Monitoramento[Candidato] = _cBase ),
			        CALCULATE ( [T09 · período · seguidores ganhos], Monitoramento[Candidato] = _cBase )
			    )
			VAR _sMax = IF ( ISBLANK ( _per ), [T09 · seguidores ganhos · maior], [T09 · período · seguidores ganhos · maior] )
			VAR _pDia = CALCULATE ( [T09 · período · seguidores por dia], Monitoramento[Candidato] = _cBase )
			VAR _pD = [T09 · período · seguidores · dias]
			VAR _p1 = CALCULATE ( [T09 · seguidores por dia · campanha], Monitoramento[Candidato] = _cBase )
			VAR _p2 = CALCULATE ( [T09 · seguidores por dia · após o 1º turno], Monitoramento[Candidato] = _cBase )
			-- 2 · Textos
			VAR _cls = IF ( _c = "Lula", "l", "f" )
			VAR _clsTxt = IF ( _c = "Lula", "lula-esc", "flavio-esc" )
			VAR _apaga = IF ( NOT ISBLANK ( _foco ) && _foco <> _cBase, " apaga", "" )
			VAR _txtS =
			    IF (
			        ISBLANK ( _per ) || _s >= 1000000,
			        "+" & FORMAT ( _s / 1000000, "0.00" ) & " mi",
			        "+" & FORMAT ( _s / 1000, "0" ) & " mil"
			    )
			VAR _txtPDia = FORMAT ( _pDia / 1000, "0" ) & " mil"
			VAR _txtP1 = FORMAT ( _p1 / 1000, "0" ) & " mil"
			VAR _txtP2 = FORMAT ( _p2 / 1000, "0" ) & " mil"
			-- 3 · Geometria (barra até 290 px; Lula em cima, Flávio embaixo)
			VAR _y = IF ( _c = "Lula", 130, 220 ) -- geometria
			VAR _yR = IF ( _c = "Lula", 404, 448 ) -- geometria
			VAR _larg = DIVIDE ( _s, _sMax ) * 290 -- geometria
			VAR _f = "0.0"
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _c ) && NOT ISBLANK ( _s ),
			        "<div class='tela t09r" & _apaga & "'>"
			            & "<div class='alvo' style='left:-8px;top:" & _y - 8 & "px;width:546px;height:88px'></div>"
			            & "<div class='nome " & _clsTxt & " sobe d4' style='left:0;top:" & _y & "px'>" & _c & "</div>"
			            & "<div class='barra " & _cls & " barra-x' style='left:0;top:" & _y + 36 & "px;width:" & FORMAT ( _larg, _f, "en-US" ) & "px'></div>"
			            & "<div class='num grande " & _clsTxt & " entra d8' style='left:" & FORMAT ( _larg + 16, _f, "en-US" ) & "px;top:" & _y + 22 & "px'>"
			            & _txtS & "</div>"
			            & IF (
			                ISBLANK ( _per ),
			                "<div class='alvo' style='left:-8px;top:" & _yR - 6 & "px;width:546px;height:42px'></div>"
			                    & "<div class='nome " & _clsTxt & " sobe d10' style='left:0;top:" & _yR + 4 & "px'>" & _c & "</div>"
			                    & "<div class='ritmo sobe d11' style='left:96px;top:" & _yR & "px'><span class='num'>" & _txtP1 & "</span>"
			                    & "<i class='seta-r'></i><span class='num " & _clsTxt & "'>" & _txtP2 & "</span><span class='sub'>por dia</span></div>",
			                IF (
			                    _pD > 1,
			                    "<div class='alvo' style='left:-8px;top:" & _yR - 6 & "px;width:546px;height:42px'></div>"
			                        & "<div class='nome " & _clsTxt & " sobe d10' style='left:0;top:" & _yR + 4 & "px'>" & _c & "</div>"
			                        & "<div class='ritmo sobe d11' style='left:96px;top:" & _yR & "px'><span class='num " & _clsTxt & "'>"
			                        & _txtPDia & "</span><span class='sub'>por dia</span></div>"
			                )
			            )
			        & "</div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 5ec852dc-a84a-54cf-a6a2-99055290751e

	/// Texto para leitor de tela da camada de pontos do índice de popularidade.
	measure 'T09 · Popularidade pontos · ALT' =
			"Um ponto por data do índice de popularidade digital da Quaest; passe o mouse para ver o humor da conversa nas redes naquele dia."
		displayFolder: T09 Redes\Desenho
		lineageTag: c1cd4c1a-0f3f-56ca-8522-77c22a5cb58a

	/// Um alvo por data do índice de popularidade digital (grão Monitoramento[Início]; vazio nas datas sem índice), na mesma caixa e escala de T09 · Popularidade · HTML: uma faixa vertical que, no mouse, mostra a linha do dia e os pontos dos dois; cada faixa abre o dossiê ttT09Ipd (o humor da conversa naquele dia).
	measure 'T09 · Popularidade pontos · HTML' =
			-- 1 · Leituras
			VAR _d = [T09 · IPD dia · data]
			VAR _l = [T09 · IPD dia · Lula]
			VAR _fl = [T09 · IPD dia · Flávio]
			VAR _ini = [T09 · IPD · primeiro dia]
			VAR _fim = [T09 · IPD · último dia]
			-- 3 · Geometria (x: primeiro a último dia em 130–600; y: 68 a 86 pontos em 140–10; o svg do fundo começa em y 72)
			VAR _dias = DATEDIFF ( _ini, _fim, DAY ) -- geometria
			VAR _x = 130 + DATEDIFF ( _ini, _d, DAY ) / _dias * 470 -- geometria
			VAR _yl = 72 + 140 - ( _l - 68 ) / 18 * 130 -- geometria
			VAR _yf = 72 + 140 - ( _fl - 68 ) / 18 * 130 -- geometria
			VAR _f = "0.0"
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _d ),
			        "<div class='tela t09p'><div class='dia' style='left:" & FORMAT ( _x - 16, _f, "en-US" ) & "px'><i class='v'></i>"
			            & IF ( NOT ISBLANK ( _fl ), "<i class='m mf' style='top:" & FORMAT ( _yf - 72 - 7, _f, "en-US" ) & "px'></i>" )
			            & IF ( NOT ISBLANK ( _l ), "<i class='m ml' style='top:" & FORMAT ( _yl - 72 - 7, _f, "en-US" ) & "px'></i>" )
			        & "</div></div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 2ad912af-9a5a-57c9-baa6-1117e3d98f70

	/// Texto para leitor de tela do gráfico do índice de popularidade digital; com período, o último dia dele com o índice dos dois, ou 'sem dado no período'.
	measure 'T09 · Popularidade · ALT' =
			VAR _per = [Período · escolhido]
			VAR _pDia = [T09 · período · IPD · dia]
			RETURN
			    IF (
			        ISBLANK ( _per ),
			        "Índice de popularidade digital da Quaest, de 0 a 100: em " & FORMAT ( [T09 · IPD · primeiro dia], "dd/MM" ) & ", Flávio "
			            & FORMAT ( [T09 · IPD · Flávio · início], "0.0" ) & " e Lula " & FORMAT ( [T09 · IPD · Lula · início], "0.0" ) & "; em "
			            & FORMAT ( [T09 · IPD · último dia], "dd/MM" ) & ", Lula " & FORMAT ( [T09 · IPD · Lula · fim], "0.0" ) & " e Flávio "
			            & FORMAT ( [T09 · IPD · Flávio · fim], "0.0" ) & ". Mede popularidade nas redes, não voto.",
			        "Índice de popularidade digital da Quaest, " & [Período · rótulo] & ": "
			            & IF (
			                ISBLANK ( _pDia ),
			                IF ( _per = 4, "o índice ainda não chegou.", "sem dado no período." ),
			                "em " & FORMAT ( _pDia, "dd/MM" ) & ", Lula " & FORMAT ( [T09 · período · IPD · Lula], "0.0" )
			                    & " e Flávio " & FORMAT ( [T09 · período · IPD · Flávio], "0.0" ) & ". Mede popularidade, não voto."
			            )
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 33bda730-715e-5fd8-86e2-aa2a410a8c44

	/// O índice de popularidade digital da Quaest de 04/10 a 19/10: as duas linhas se desenham pelos pontos divulgados e se cruzam; rótulos do primeiro e do último dia com contador, a marca do debate e a nota à mão. Lê 'T09 · IPD' por data (lista de Monitoramento[Início]) e as contas de início e fim. Com um candidato clicado nos balões ou na coluna da direita ('T09 · foco'), a linha do outro esmaece e a manchete conta o caminho de quem foi clicado. Os pontos com dossiê são outro visual (T09 · Popularidade pontos · HTML). Com um período escolhido no filtro: a faixa do período sobre o eixo (até onde o índice vai), as linhas e os pontos de fora esmaecidos e a manchete do período (o último dia dele com o índice dos dois); sem índice no período, 'sem dado no período'; Depois da Globo, a espera.
	measure 'T09 · Popularidade · HTML' =
			-- 1 · Leituras
			VAR _ini = [T09 · IPD · primeiro dia]
			VAR _fim = [T09 · IPD · último dia]
			VAR _deb = [T09 · debate · data]
			VAR _lI = [T09 · IPD · Lula · início]
			VAR _lF = [T09 · IPD · Lula · fim]
			VAR _fI = [T09 · IPD · Flávio · início]
			VAR _fF = [T09 · IPD · Flávio · fim]
			VAR _vantagemFim = [T09 · IPD · vantagem de Lula no fim]
			VAR _foco = [T09 · foco]
			VAR _per = [Período · escolhido]
			VAR _pNome = [Período · nome]
			VAR _pIni = [Período · início]
			VAR _pFim = [Período · fim]
			VAR _pDia = [T09 · período · IPD · dia]
			VAR _pL = [T09 · período · IPD · Lula]
			VAR _pF = [T09 · período · IPD · Flávio]
			VAR _pN = [T09 · período · IPD · pontos]
			VAR _todos =
			    ADDCOLUMNS (
			        ALLNOBLANKROW ( Monitoramento[Início] ),
			        "@l", CALCULATE ( [T09 · IPD], Monitoramento[Candidato] = "Lula" ),
			        "@f", CALCULATE ( [T09 · IPD], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			    )
			VAR _pts = FILTER ( _todos, NOT ISBLANK ( [@l] ) || NOT ISBLANK ( [@f] ) ) /* lista */
			-- 2 · Textos
			VAR _lider0 = IF ( _fI >= _lI, "Flávio", "Lula" )
			VAR _lider1 = IF ( _lF >= _fF, "Lula", "Flávio" )
			VAR _txtTodos =
			    "No 1º turno, " & _lider0 & " liderava; em " & FORMAT ( _fim, "dd/MM" ) & ", " & _lider1 & " tinha "
			        & FORMAT ( ABS ( _vantagemFim ), "0.0" ) & " pontos a mais"
			-- com um candidato clicado: o caminho dele do primeiro ao último dia
			VAR _cI = IF ( _foco = "Lula", _lI, _fI )
			VAR _cF = IF ( _foco = "Lula", _lF, _fF )
			VAR _nomeFoco = IF ( _foco = "Lula", "Lula", "Flávio" )
			VAR _txtFoco =
			    _nomeFoco & IF ( _cF >= _cI, " subiu", " caiu" ) & " de " & FORMAT ( _cI, "0.0" ) & " no dia do 1º turno para "
			        & FORMAT ( _cF, "0.0" ) & " em " & FORMAT ( _fim, "dd/MM" )
			-- com período: o último dia dele com o índice dos dois
			VAR _txtPer =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _pDia ),
			            _pNome & ", em " & FORMAT ( _pDia, "dd/MM" ) & ", "
			                & IF ( _pL = _pF, "os dois empatavam", IF ( _pL > _pF, "Lula", "Flávio" ) & " tinha "
			                & FORMAT ( ABS ( _pL - _pF ), "0.0" ) & " pontos a mais" ),
			        _pN > 0, _pNome & ", a Quaest divulgou o índice de um só dos dois",
			        _per = 4, _pNome & ": o índice ainda não chegou",
			        _pNome & ": sem dado no período (o índice vai até " & FORMAT ( _fim, "dd/MM" ) & ")"
			    )
			VAR _txtMan = IF ( NOT ISBLANK ( _per ), _txtPer, IF ( ISBLANK ( _foco ), _txtTodos, _txtFoco ) )
			-- com período: o que fica de fora esmaece (" fora" / " meio"); sem período, nada muda
			VAR _meio = IF ( ISBLANK ( _per ), "", " meio" )
			VAR _foraIni = IF ( NOT ISBLANK ( _per ) && ( _ini < _pIni || _ini > _pFim ), " fora", "" )
			VAR _foraFim = IF ( NOT ISBLANK ( _per ) && ( _fim < _pIni || _fim > _pFim ), " fora", "" )
			VAR _apL = IF ( _foco = "Flávio Bolsonaro", " apaga", "" )
			VAR _apF = IF ( _foco = "Lula", " apaga", "" )
			-- 3 · Geometria (x: primeiro a último dia em 130–600; y: 68 a 86 pontos em 140–10; o svg começa em y 86)
			VAR _dias = DATEDIFF ( _ini, _fim, DAY ) -- geometria
			VAR _f = "0.0"
			VAR _xy =
			    ADDCOLUMNS (
			        _pts,
			        "@x", 130 + DATEDIFF ( _ini, Monitoramento[Início], DAY ) / _dias * 470,
			        "@yl", 140 - ( [@l] - 68 ) / 18 * 130,
			        "@yf", 140 - ( [@f] - 68 ) / 18 * 130
			    ) -- geometria
			VAR _linhaL =
			    CONCATENATEX (
			        FILTER ( _xy, NOT ISBLANK ( [@l] ) ) /* lista */,
			        FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@yl], _f, "en-US" ),
			        " ",
			        Monitoramento[Início], ASC
			    )
			VAR _linhaF =
			    CONCATENATEX (
			        FILTER ( _xy, NOT ISBLANK ( [@f] ) ) /* lista */,
			        FORMAT ( [@x], _f, "en-US" ) & "," & FORMAT ( [@yf], _f, "en-US" ),
			        " ",
			        Monitoramento[Início], ASC
			    )
			VAR _pontos =
			    CONCATENATEX (
			        _xy,
			        VAR _fora =
			            IF ( NOT ISBLANK ( _per ) && ( Monitoramento[Início] < _pIni || Monitoramento[Início] > _pFim ), " fora", "" )
			        RETURN
			            IF ( NOT ISBLANK ( [@l] ), "<circle cx='" & FORMAT ( [@x], _f, "en-US" ) & "' cy='" & FORMAT ( [@yl], _f, "en-US" )
			                & "' r='5.5' class='pl brota" & _apL & _fora & "' style='animation-delay:" & ( 600 + DATEDIFF ( _ini, Monitoramento[Início], DAY ) * 110 ) & "ms'/>" )
			                & IF ( NOT ISBLANK ( [@f] ), "<circle cx='" & FORMAT ( [@x], _f, "en-US" ) & "' cy='" & FORMAT ( [@yf], _f, "en-US" )
			                & "' r='5.5' class='pf brota" & _apF & _fora & "' style='animation-delay:" & ( 650 + DATEDIFF ( _ini, Monitoramento[Início], DAY ) * 110 ) & "ms'/>" ),
			        "",
			        Monitoramento[Início], ASC
			    )
			-- faixa do período no eixo (só a parte dele que cai entre o primeiro e o último dia do índice)
			VAR _xa = 130 + DATEDIFF ( _ini, MAX ( _pIni, _ini ), DAY ) / _dias * 470 - 9 -- geometria
			VAR _xb = 130 + DATEDIFF ( _ini, MIN ( _pFim, _fim ), DAY ) / _dias * 470 + 9 -- geometria
			VAR _faixa =
			    IF (
			        NOT ISBLANK ( _per ) && _pIni <= _fim && _pFim >= _ini,
			        "<rect x='" & FORMAT ( _xa, _f, "en-US" ) & "' y='4' width='" & FORMAT ( _xb - _xa, _f, "en-US" )
			            & "' height='142' class='faixa esmaece'/>"
			    )
			VAR _xDeb = 130 + DATEDIFF ( _ini, _deb, DAY ) / _dias * 470 -- geometria
			VAR _yLI = 140 - ( _lI - 68 ) / 18 * 130 -- geometria
			VAR _yFI = 140 - ( _fI - 68 ) / 18 * 130 -- geometria
			VAR _yLF = 140 - ( _lF - 68 ) / 18 * 130 -- geometria
			VAR _yFF = 140 - ( _fF - 68 ) / 18 * 130 -- geometria
			VAR _grade =
			    CONCATENATEX (
			        { 70, 75, 80, 85 },
			        "<line x1='130' x2='600' y1='" & FORMAT ( 140 - ( [Value] - 68 ) / 18 * 130, _f, "en-US" ) & "' y2='"
			            & FORMAT ( 140 - ( [Value] - 68 ) / 18 * 130, _f, "en-US" ) & "' class='g'/>",
			        ""
			    )
			VAR _datas =
			    CONCATENATEX (
			        ADDCOLUMNS ( { 0, 7, _dias }, "@d", _ini + [Value] ),
			        "<text x='" & FORMAT ( 130 + DATEDIFF ( _ini, [@d], DAY ) / _dias * 470, _f, "en-US" ) & "' y='164' class='ex' text-anchor='"
			            & SWITCH ( TRUE (), [Value] = 0, "start", [Value] = _dias, "end", "middle" ) & "'>" & FORMAT ( [@d], "dd/MM" )
			            & IF ( [Value] = 0, " · 1º turno", "" ) & "</text>",
			        ""
			    )
			-- 4 · Marcação
			VAR _svg =
			    "<svg width='760' height='176' viewBox='0 0 760 176'>"
			        & _faixa & _grade & _datas
			        & "<line x1='" & FORMAT ( _xDeb, _f, "en-US" ) & "' x2='" & FORMAT ( _xDeb, _f, "en-US" ) & "' y1='4' y2='146' class='deb'/>"
			        & "<text x='" & FORMAT ( _xDeb - 6, _f, "en-US" ) & "' y='154' class='ex' text-anchor='end'>debate</text>"
			        & "<polyline points='" & _linhaF & "' pathLength='1' class='lf traco" & _apF & _meio & "' filter='url(#rbu)' style='animation-delay:.4s'/>"
			        & "<polyline points='" & _linhaL & "' pathLength='1' class='ll traco" & _apL & _meio & "' filter='url(#rbu)' style='animation-delay:.4s'/>"
			        & _pontos
			    & "</svg>"
			VAR _rotulos =
			    "<div class='rotulo e flavio-esc entra d6" & _apF & _foraIni & "' style='right:" & FORMAT ( 760 - 116, _f, "en-US" ) & "px;top:"
			        & FORMAT ( 86 + _yFI - 13, _f, "en-US" ) & "px'>Flávio " & FORMAT ( _fI, "0.0" ) & "</div>"
			        & "<div class='rotulo e lula-esc entra d6" & _apL & _foraIni & "' style='right:" & FORMAT ( 760 - 116, _f, "en-US" ) & "px;top:"
			        & FORMAT ( 86 + _yLI - 13, _f, "en-US" ) & "px'>Lula " & FORMAT ( _lI, "0.0" ) & "</div>"
			        & "<div class='rotulo lula-esc entra d14" & _apL & _foraFim & "' style='left:614px;top:" & FORMAT ( 86 + _yLF - 13, _f, "en-US" ) & "px'>Lula "
			        & FORMAT ( _lF, "0.0" ) & "</div>"
			        & "<div class='rotulo flavio-esc entra d14" & _apF & _foraFim & "' style='left:614px;top:" & FORMAT ( 86 + _yFF - 13, _f, "en-US" ) & "px'>Flávio "
			        & FORMAT ( _fF, "0.0" ) & "</div>"
			RETURN
			    "<div class='tela t09i'>"
			        & "<div class='sob sobe'>Popularidade digital · índice Quaest, de 0 a 100</div>"
			        & "<div class='man sobe d2'>" & _txtMan & "</div>"
			        & _svg & _rotulos
			        & IF ( ISBLANK ( _foco ) && ISBLANK ( _per ), "<div class='mao entra d14' style='left:262px;top:148px'>virou</div>" )
			        & "<div class='nota entra d10'>Soma 175 sinais de redes, Google e Wikipédia · mede popularidade, não voto · Folha, "
			        & FORMAT ( _ini, "dd/MM" ) & " a " & FORMAT ( _fim, "dd/MM" ) & "</div>"
			    & "</div>"
		displayFolder: T09 Redes\Desenho
		lineageTag: 2383f1f2-9499-5c2a-ac1e-91010ded10f0

	/// Texto para leitor de tela do dossiê das interações (grão Monitoramento[Candidato]).
	measure 'T09 · Tooltip conversa · ALT' =
			IF (
			    NOT ISBLANK ( [T09 · candidato] ),
			    "Interações de Lula e Flávio em outras janelas: janeiro e fevereiro, logo após o 1º turno, 06 a 15/10 sem o YouTube, 24 horas depois do debate e o Instagram por dia."
			)
		displayFolder: T09 Redes\Desenho
		lineageTag: 7d4ae025-432d-55c0-8f1f-c298c1f9216d

	/// Dossiê dos balões (ttT09Conversa, grão Monitoramento[Candidato]): as interações dos dois em outras janelas — antes da campanha (jan e fev), logo após o 1º turno, de 06 a 15/10 sem o YouTube, nas 24 h depois do debate — e o engajamento por dia no Instagram (DSC Lab), com a coluna do candidato sob o mouse em destaque. Camada nova: o tempo antes e depois das duas janelas da tela.
	measure 'T09 · Tooltip conversa · HTML' =
			-- 1 · Leituras
			VAR _c = [T09 · candidato]
			VAR _janL = CALCULATE ( [T09 · interações · jan e fev], Monitoramento[Candidato] = "Lula" )
			VAR _janF = CALCULATE ( [T09 · interações · jan e fev], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			VAR _posL = CALCULATE ( [T09 · interações · logo após o 1º turno], Monitoramento[Candidato] = "Lula" )
			VAR _posF = CALCULATE ( [T09 · interações · logo após o 1º turno], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			VAR _semL = CALCULATE ( [T09 · interações · sem o YouTube], Monitoramento[Candidato] = "Lula" )
			VAR _semF = CALCULATE ( [T09 · interações · sem o YouTube], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			VAR _debL = CALCULATE ( [T09 · interações · 24 h após o debate], Monitoramento[Candidato] = "Lula" )
			VAR _debF = CALCULATE ( [T09 · interações · 24 h após o debate], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			VAR _igL = CALCULATE ( [T09 · Instagram · engajamento por dia], Monitoramento[Candidato] = "Lula" )
			VAR _igF = CALCULATE ( [T09 · Instagram · engajamento por dia], Monitoramento[Candidato] = "Flávio Bolsonaro" )
			-- 2 · Textos
			VAR _onL = IF ( _c = "Lula", " on", "" )
			VAR _onF = IF ( _c = "Flávio", " on", "" )
			VAR _linha =
			    "<div class='j'>#J</div><div class='v lula-esc" & _onL & "'>#L</div><div class='v flavio-esc" & _onF & "'>#F</div>"
			VAR _mi = "0.0"
			VAR _linhas =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _linha, "#J", "Jan e fev, pré-campanha" ), "#L", FORMAT ( _janL / 1000000, _mi ) & " mi" ), "#F", FORMAT ( _janF / 1000000, _mi ) & " mi" )
			        & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _linha, "#J", "04 a 08/10, pós-1º turno" ), "#L", FORMAT ( _posL / 1000000, _mi ) & " mi" ), "#F", FORMAT ( _posF / 1000000, _mi ) & " mi" )
			        & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _linha, "#J", "06 a 15/10, sem YouTube" ), "#L", FORMAT ( _semL / 1000000, _mi ) & " mi" ), "#F", FORMAT ( _semF / 1000000, _mi ) & " mi" )
			        & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _linha, "#J", "24 h depois do debate" ), "#L", FORMAT ( _debL / 1000000, _mi ) & " mi" ), "#F", FORMAT ( _debF / 1000000, _mi ) & " mi" )
			        & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _linha, "#J", "Instagram, por dia (DSC Lab)" ), "#L", FORMAT ( _igL / 1000000, _mi ) & " mi" ), "#F", FORMAT ( _igF / 1000000, _mi ) & " mi" )
			VAR _mao = IF ( _janF > _janL, "no começo do ano, o contrário", "a frente se manteve" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _c ),
			        "<div class='tt9c'>"
			            & "<div class='sob sobe'>As interações em outras janelas</div>"
			            & "<div class='tab sobe d2'><div></div><div class='h lula-esc'>Lula</div><div class='h flavio-esc'>Flávio</div>"
			            & _linhas & "</div>"
			            & "<div class='nota sobe d4'>Bites, perfis oficiais (as redes contadas mudam de uma janela para outra). Instagram: DSC Lab, 05 a 16/10.</div>"
			            & "<div class='mao ti entra d6'>" & _mao & "</div>"
			        & "</div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 431432d5-e49f-5295-9735-7d2b3b5f5df6

	/// Texto para leitor de tela do dossiê de uma data do índice de popularidade.
	measure 'T09 · Tooltip IPD · ALT' =
			IF (
			    NOT ISBLANK ( [T09 · IPD dia · data] ),
			    "Índice de popularidade digital em " & FORMAT ( [T09 · IPD dia · data], "dd/MM" ) & ": Lula "
			        & IF ( ISBLANK ( [T09 · IPD dia · Lula] ), "sem dado", FORMAT ( [T09 · IPD dia · Lula], "0.0" ) ) & ", Flávio "
			        & IF ( ISBLANK ( [T09 · IPD dia · Flávio] ), "sem dado", FORMAT ( [T09 · IPD dia · Flávio], "0.0" ) ) & "."
			)
		displayFolder: T09 Redes\Desenho
		lineageTag: ea04214c-9863-5064-be25-da238603bfcf

	/// Dossiê de uma data do índice de popularidade digital (ttT09Ipd, grão Monitoramento[Início]): o índice dos dois no dia (ou só de quem a Quaest divulgou) e uma camada nova, o humor da conversa: o saldo de sentimento da Datrix (% de menções positivas − % de negativas) da semana que contém o dia, ou, nas 24 h depois do debate, as menções positivas e negativas medidas pela FGV, ou, no dia do 1º turno, quem ficou com os comentários nos perfis dos dois (Quaest). Nota à mão quando quem lidera o índice não é quem tem o melhor humor. Só lê contas 'T09 · …'.
	measure 'T09 · Tooltip IPD · HTML' =
			-- 1 · Leituras
			VAR _d = [T09 · IPD dia · data]
			VAR _d1 = [T09 · IPD dia · fim]
			VAR _marco = [T09 · IPD dia · marco]
			VAR _l = [T09 · IPD dia · Lula]
			VAR _fl = [T09 · IPD dia · Flávio]
			VAR _hI = [T09 · humor · início]
			VAR _hF = [T09 · humor · fim]
			VAR _hL = [T09 · humor · Lula]
			VAR _hFl = [T09 · humor · Flávio]
			VAR _deb = [T09 · menções · depois do debate]
			VAR _pL = [T09 · menções · positivas · Lula]
			VAR _pF = [T09 · menções · positivas · Flávio]
			VAR _nL = [T09 · menções · negativas · Lula]
			VAR _nF = [T09 · menções · negativas · Flávio]
			VAR _cQ = [T09 · comentários · quem]
			VAR _cP = [T09 · comentários · parte]
			-- 2 · Textos
			VAR _txtData =
			    IF ( _d1 > _d, FORMAT ( _d, "dd" ) & " a " & FORMAT ( _d1, "dd/MM" ), FORMAT ( _d, "dd/MM" ) & " · " & _marco )
			VAR _txtNum = "<span class='num'>#V</span>"
			VAR _numL = IF ( ISBLANK ( _l ), "<span class='num vazio'>—</span>", SUBSTITUTE ( _txtNum, "#V", FORMAT ( _l, "0.0" ) ) )
			VAR _numF = IF ( ISBLANK ( _fl ), "<span class='num vazio'>—</span>", SUBSTITUTE ( _txtNum, "#V", FORMAT ( _fl, "0.0" ) ) )
			VAR _txtIpd =
			    SWITCH (
			        TRUE (),
			        _d1 > _d, "De " & FORMAT ( _d, "dd/MM" ) & " a " & FORMAT ( _d1, "dd/MM" ) & ", a Quaest divulgou só o patamar máximo de Lula.",
			        ISBLANK ( _l ), "Nesse dia, a Quaest divulgou só o índice de Flávio.",
			        ISBLANK ( _fl ), "Nesse dia, a Quaest divulgou só o índice de Lula.",
			        "Índice de 0 a 100: mede popularidade nas redes, no Google e na Wikipédia, não voto."
			    )
			VAR _modo = SWITCH ( TRUE (), NOT ISBLANK ( _hL ), "humor", _deb = 1, "mencoes", NOT ISBLANK ( _cQ ), "comentarios", "" )
			VAR _txtJanela = IF ( _hF > _hI, FORMAT ( _hI, "dd" ) & " a " & FORMAT ( _hF, "dd/MM" ), FORMAT ( _hI, "dd/MM" ) )
			VAR _sinal = "#S#V"
			VAR _txtHL = SUBSTITUTE ( SUBSTITUTE ( _sinal, "#S", IF ( _hL > 0, "+", IF ( _hL < 0, "−", "" ) ) ), "#V", FORMAT ( ABS ( _hL ), "0.0" ) )
			VAR _txtHF = SUBSTITUTE ( SUBSTITUTE ( _sinal, "#S", IF ( _hFl > 0, "+", IF ( _hFl < 0, "−", "" ) ) ), "#V", FORMAT ( ABS ( _hFl ), "0.0" ) )
			VAR _liderIpd = IF ( NOT ISBLANK ( _l ) && NOT ISBLANK ( _fl ), IF ( _l > _fl, "Lula", "Flávio" ) )
			VAR _liderHumor = IF ( _modo = "humor", IF ( _hL > _hFl, "Lula", "Flávio" ) )
			VAR _mao =
			    IF (
			        NOT ISBLANK ( _liderIpd ) && NOT ISBLANK ( _liderHumor ) && _liderIpd <> _liderHumor,
			        "popularidade não é simpatia"
			    )
			VAR _nomeQ = IF ( _cQ = "Lula", "Lula", "Flávio" )
			-- 3 · Geometria (barras do humor: 0 no meio, 6 px por ponto, até 20 pontos para cada lado)
			VAR _k = 6 -- geometria
			VAR _barra =
			    "<div class='hb'><span class='hn #C'>#N</span><span class='trilho'><i class='#C #D' style='width:#Wpx'></i></span>"
			        & "<b class='#C'>#T</b></div>"
			VAR _barraL =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _barra, "#C", "lula-esc l" ), "#N", "Lula" ),
			        "#D", IF ( _hL < 0, "neg", "pos" ) ), "#W", FORMAT ( MIN ( ABS ( _hL ), 20 ) * _k, "0.0", "en-US" ) ), "#T", _txtHL )
			VAR _barraF =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _barra, "#C", "flavio-esc f" ), "#N", "Flávio" ),
			        "#D", IF ( _hFl < 0, "neg", "pos" ) ), "#W", FORMAT ( MIN ( ABS ( _hFl ), 20 ) * _k, "0.0", "en-US" ) ), "#T", _txtHF )
			-- 4 · Marcação
			VAR _humor =
			    SWITCH (
			        _modo,
			        "humor",
			            "<div class='rot sobe d5'>O humor da conversa · " & _txtJanela & " · Datrix</div>"
			                & "<div class='sobe d6'>" & _barraL & _barraF & "</div>"
			                & "<div class='nota sobe d7'>% de menções positivas menos % de negativas, em pontos.</div>",
			        "mencoes",
			            "<div class='rot sobe d5'>O humor nas 24 h depois do debate · FGV</div>"
			                & "<div class='mt sobe d6'><span></span><span class='h'>positivas</span><span class='h'>negativas</span>"
			                & "<span class='lula-esc'>Lula</span><b>" & _pL & "%</b><b>" & _nL & "%</b>"
			                & "<span class='flavio-esc'>Flávio</span><b>" & _pF & "%</b><b>" & _nF & "%</b></div>"
			                & "<div class='nota sobe d7'>Parte das menções a cada um, nas redes.</div>",
			        "comentarios",
			            "<div class='rot sobe d5'>A conversa no dia · Quaest</div>"
			                & "<div class='txt sobe d6'>Nos comentários dos perfis dos dois, <b>" & _cP & "%</b> foram no de " & _nomeQ & ".</div>",
			        ""
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _d ),
			        "<div class='tt9i'>"
			            & "<div class='sob sobe'>" & _txtData & "</div>"
			            & "<div class='par sobe d2'><div class='lula'><small>Lula</small>" & _numL & "</div>"
			                & "<div class='flavio'><small>Flávio</small>" & _numF & "</div></div>"
			            & "<div class='txt sobe d3'>" & _txtIpd & "</div>"
			            & IF ( _modo <> "", "<hr class='sobe d4'/>" & _humor )
			            & IF ( NOT ISBLANK ( _mao ), "<div class='mao ti entra d8'>" & _mao & "</div>" )
			        & "</div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 1b3a56ef-749f-5cc7-85a8-c992f06e608d

	/// Texto para leitor de tela do dossiê da coluna da direita (grão Seguidores[Candidato]).
	measure 'T09 · Tooltip lado · ALT' =
			VAR _c = [T09 · lado · candidato]
			VAR _cBase = [T09 · lado · nome completo]
			RETURN
			    IF (
			        NOT ISBLANK ( _c ),
			        _c & ": seguidores rede a rede e anúncios na Meta, R$ "
			            & FORMAT ( CALCULATE ( [T09 · Meta · 90 dias], Monitoramento[Candidato] = _cBase ) / 1000000, "0.00" )
			            & " mi em 90 dias na Biblioteca de Anúncios; em outra base, pagamentos à Meta declarados ao TSE, R$ "
			            & FORMAT ( CALCULATE ( [T09 · TSE · pagamentos à Meta], Monitoramento[Candidato] = _cBase ) / 1000000, "0.00" ) & " mi."
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: ae8e8f4e-a817-5785-b06c-bad4b9ec60ab

	/// Dossiê da coluna da direita (ttT09Lado, grão Seguidores[Candidato]; as contas de Monitoramento recebem o candidato da linha), em duas colunas. À esquerda, os seguidores do candidato rede a rede (quanto ganhou na campanha do 1º turno, Bites, e quantos tem hoje, Social Blade e Datrix) e o 2º turno com as duas fontes que divergem. À direita, os anúncios da página na Meta (Biblioteca de Anúncios: 90 dias e última semana) e, à parte e rotulados como outra base, os pagamentos à Meta declarados ao TSE — nunca somados nem comparados com a Biblioteca. Com um período escolhido no filtro, a linha da última semana dá lugar à janela da Biblioteca que cabe inteira no período (Depois da Band: 19/10) ou a 'sem dado no período'.
	measure 'T09 · Tooltip lado · HTML' =
			-- 1 · Leituras
			VAR _c = [T09 · lado · candidato]
			VAR _cBase = [T09 · lado · nome completo]
			VAR _redes =
			    DATATABLE (
			        "Ordem", INTEGER, "Rede", STRING,
			        { { 1, "Instagram" }, { 2, "Facebook" }, { 3, "TikTok" }, { 4, "YouTube" }, { 5, "X" } }
			    )
			VAR _lista =
			    ADDCOLUMNS (
			        _redes,
			        "@g",
			            VAR _r = [Rede]
			            RETURN
			                CALCULATE ( [T09 · seguidores ganhos · rede], Seguidores[Plataforma] = _r, Monitoramento[Candidato] = _cBase ),
			        "@h",
			            VAR _r = [Rede]
			            RETURN
			                CALCULATE ( [T09 · seguidores hoje · rede], Seguidores[Plataforma] = _r, Monitoramento[Candidato] = _cBase )
			    )
			VAR _bites2 = CALCULATE ( [T09 · seguidores ganhos · 2º turno Bites], Monitoramento[Candidato] = _cBase )
			VAR _datrix2 = CALCULATE ( [T09 · seguidores ganhos · 2º turno Datrix], Monitoramento[Candidato] = _cBase )
			VAR _a90 = CALCULATE ( [T09 · Meta · 90 dias], Monitoramento[Candidato] = _cBase )
			VAR _a7 = CALCULATE ( [T09 · Meta · 7 dias], Monitoramento[Candidato] = _cBase )
			VAR _tse = CALCULATE ( [T09 · TSE · pagamentos à Meta], Monitoramento[Candidato] = _cBase )
			VAR _per = [Período · escolhido]
			VAR _aP = CALCULATE ( [T09 · período · Meta], Monitoramento[Candidato] = _cBase )
			VAR _aI = [T09 · período · Meta · início]
			VAR _aF = [T09 · período · Meta · fim]
			-- 2 · Textos
			VAR _clsTxt = IF ( _c = "Lula", "lula-esc", "flavio-esc" )
			VAR _linhas =
			    CONCATENATEX (
			        _lista,
			        "<div class='r'>" & [Rede] & "</div><div class='v'>"
			            & IF ( ISBLANK ( [@g] ), "—", "+" & FORMAT ( [@g] / 1000000, "0.00" ) & " mi" ) & "</div><div class='v " & _clsTxt & "'>"
			            & IF ( ISBLANK ( [@h] ), "—", FORMAT ( [@h] / 1000000, "0.00" ) & " mi" ) & "</div>",
			        "",
			        [Ordem], ASC
			    )
			VAR _txt2 =
			    "No 2º turno, as fontes divergem: a Bites dá +" & FORMAT ( _bites2 / 1000000, "0.0" ) & " mi de 05 a 17/10; a Datrix, +"
			        & FORMAT ( _datrix2 / 1000000, "0.0" ) & " mi de 03 a 19/10, com o X e sem o TikTok."
			VAR _txtA90 = "R$ " & FORMAT ( _a90 / 1000000, "0.00" ) & " mi"
			VAR _txtA7 = "R$ " & FORMAT ( _a7 / 1000000, "0.00" ) & " mi"
			VAR _txtTse = "R$ " & FORMAT ( _tse / 1000000, "0.00" ) & " mi"
			VAR _txtAP = "R$ " & FORMAT ( _aP / 1000000, "0.00" ) & " mi"
			VAR _janA =
			    IF ( _aI = _aF, FORMAT ( _aI, "dd/MM" ), FORMAT ( _aI, "dd" ) & " a " & FORMAT ( _aF, "dd/MM" ) )
			        & ", " & ( DATEDIFF ( _aI, _aF, DAY ) + 1 ) & IF ( _aI = _aF, " dia", " dias" )
			VAR _linhaA2 =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _per ),
			            "<div class='ad sobe d4'><b class='" & _clsTxt & "'>" & _txtA7 & "</b><span>na última semana (13 a 19/10)</span></div>",
			        NOT ISBLANK ( _aP ),
			            "<div class='ad sobe d4'><b class='" & _clsTxt & "'>" & _txtAP & "</b><span>" & [Período · nome] & " ("
			                & _janA & ")</span></div>",
			        "<div class='ad sobe d4'><b class='vazio'>sem dado no período</b><span>" & [Período · nome]
			            & ": as janelas da Biblioteca (90, 30 e 7 dias até 19/10) não cabem nele</span></div>"
			    )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _c ),
			        "<div class='tt9l'>"
			            & "<div class='col'>"
			                & "<div class='sob sobe'>" & _c & " · seguidores rede a rede</div>"
			                & "<div class='tab sobe d2'><div></div><div class='h'>ganhou de<br>16/08 a 03/10</div><div class='h'>tem<br>hoje</div>"
			                & _linhas & "</div>"
			                & "<div class='nota sobe d3'>Ganho: Bites. Hoje: Social Blade (22 e 23/10); X: Datrix (19/10).</div>"
			                & "<div class='txt sobe d4'>" & _txt2 & "</div>"
			                & "<div class='mao ti entra d8'>duas réguas, duas ordens</div>"
			            & "</div>"
			            & "<div class='col'>"
			                & "<div class='sob sobe d2'>Anúncios na Meta</div>"
			                & "<div class='ad sobe d3'><b class='" & _clsTxt & "'>" & _txtA90 & "</b><span>em 90 dias (22/07 a 19/10)</span></div>"
			                & _linhaA2
			                & "<div class='nota sobe d4'>Página do candidato · Biblioteca de Anúncios</div>"
			                & "<div class='outra sobe d5'><div class='rot'>Outra base · não se soma</div>"
			                & "Pagamentos à Meta declarados ao TSE até cerca de 20/10: <b>" & _txtTse & "</b>. Medem o que a campanha pagou, "
			                & "não o que a página veiculou.</div>"
			            & "</div>"
			        & "</div>"
			    )
		displayFolder: T09 Redes\Desenho
		lineageTag: 073be0f9-81d5-518c-9742-6dddd4d9b061

	/// Dia do 1º turno de 2026 (calendário do TSE).
	measure 'T10 · data do 1º turno' =
			DATE ( 2026, 10, 4 )
		formatString: dd/MM
		displayFolder: T10 Pesquisas\Contas
		lineageTag: d8942cfd-f9d8-5dc9-91a7-aaa03730440f

	/// Quantos institutos com votos válidos deram ao candidato da linha meio ponto ou mais abaixo da urna.
	measure 'T10 · erro · abaixo da urna' =
			VAR _u = [T10 · erro · urna]
			VAR _lista =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Instituto] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@v", [T10 · instituto · valor válido]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _u ), COUNTROWS ( FILTER ( _lista, NOT ISBLANK ( [@v] ) && _u - [@v] >= 0.5 ) ) + 0 )
		formatString: 0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 47924a5d-2691-520b-9973-d5287750bfd3

	/// Quantos institutos com votos válidos deram ao candidato da linha meio ponto ou mais acima da urna.
	measure 'T10 · erro · acima da urna' =
			VAR _u = [T10 · erro · urna]
			VAR _lista =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Instituto] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@v", [T10 · instituto · valor válido]
			    )
			RETURN
			    IF ( NOT ISBLANK ( _u ), COUNTROWS ( FILTER ( _lista, NOT ISBLANK ( [@v] ) && [@v] - _u >= 0.5 ) ) + 0 )
		formatString: 0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: ff358582-4065-5406-9b39-fae06a1b571c

	/// O candidato da linha do quadro 'onde foi o erro' (grão 'Candidato ano'[Partido] na camada de alvos e no dossiê ttT10Erro): PT = Lula, PL = Flávio; vazio nos outros partidos.
	measure 'T10 · erro · candidato' =
			SWITCH ( SELECTEDVALUE ( 'Candidato ano'[Partido] ), "PT", "Lula", "PL", "Flávio" )
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 211a59a9-910f-57ce-9747-5de75fb72286

	/// O maior % que um instituto com votos válidos deu ao candidato da linha na véspera.
	measure 'T10 · erro · maior' =
			VAR _lista =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Instituto] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@v", [T10 · instituto · valor válido]
			    )
			RETURN
			    MAXX ( FILTER ( _lista, NOT ISBLANK ( [@v] ) ), [@v] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
		lineageTag: 0bb99971-97fa-512e-8b99-2bd0225bc872

	/// O menor % que um instituto com votos válidos deu ao candidato da linha na véspera.
	measure 'T10 · erro · menor' =
			VAR _lista =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Pesquisa[Instituto] ),
			            REMOVEFILTERS ( Pesquisa ),
			            Pesquisa[Cenário] = "1º turno",
			            NOT ISBLANK ( Pesquisa[Lula] ),
			            NOT ISBLANK ( Pesquisa[Flavio] )
			        ),
			        "@v", [T10 · instituto · valor válido]
			    )
			RETURN
			    MINX ( FILTER ( _lista, NOT ISBLANK ( [@v] ) ), [@v] )
		formatString: 0.0
		displayFolder: T10 Pesquisas\Contas
