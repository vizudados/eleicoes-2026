	/// O lugar escolhido no filtro de estado da casca (árvore Região › Estado), pela medida comum [Recorte · nome]: 'Bahia', 'Nordeste', 'MG e SP', '3 estados'; vazio = Brasil. O filtro cai em 'UF'[Caminho] (24/10/2026), então ISFILTERED ( 'UF'[Nome] ) não serve mais.
	measure 'T11 · recorte' =
			IF ( [Recorte · com escolha] = 1, [Recorte · nome] )
		displayFolder: T11 Virada\Contas
		lineageTag: e97a5ef8-e7cb-5c0b-ab20-32adbc058454

	/// Região com mais municípios que trocaram de lado (vazio se nenhum).
	measure 'T11 · região com mais viradas' =
			VAR _r =
			    ADDCOLUMNS ( VALUES ( 'Município'[Região] ), "@n", [T11 · viraram] )
			VAR _top1 =
			    TOPN ( 1, _r, [@n], DESC, 'Município'[Região], ASC )
			VAR _top2 =
			    TOPN ( 2, _r, [@n], DESC, 'Município'[Região], ASC )
			RETURN
			    IF ( MAXX ( _r, [@n] ) > 0, MAXX ( _top1, 'Município'[Região] ) )
		displayFolder: T11 Virada\Contas
		lineageTag: 07d11721-406e-5286-bcf4-b1f1117141a6

	/// Quantas regiões têm ao menos um município que trocou de lado.
	measure 'T11 · regiões com virada' =
			VAR _r =
			    ADDCOLUMNS ( VALUES ( 'Município'[Região] ), "@n", [T11 · viraram] )
			RETURN
			    COUNTROWS ( FILTER ( _r, [@n] > 0 ) ) + 0
		formatString: 0
		displayFolder: T11 Virada\Contas
		lineageTag: 65c28348-6909-507f-aaa9-e74ee83286de

	/// Votos de Lula (PT) menos os do adversário (PL) em 2022, somados no recorte. Positivo: Lula à frente.
	measure 'T11 · saldo 2022' =
			CALCULATE (
			    SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ),
			    'Município ano'[Ano] = 2022
			)
		formatString: #,0
		displayFolder: T11 Virada\Contas
		lineageTag: 239c7486-f8f1-5d45-a99c-0b0b23718d60

	/// Votos de Lula (PT) menos os do adversário (PL) em 2026, somados no recorte. Positivo: Lula à frente.
	measure 'T11 · saldo 2026' =
			CALCULATE (
			    SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ),
			    'Município ano'[Ano] = 2026
			)
		formatString: #,0
		displayFolder: T11 Virada\Contas
		lineageTag: f395e380-ff7b-5f40-9bb4-f19dfc38892f

	/// Municípios com Lula à frente em 2022 e em 2026. Conta município a município no recorte.
	measure 'T11 · seguiram com Lula' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			        VAR _d22 = [T11 · saldo 2022]
			        VAR _d26 = [T11 · saldo 2026]
			        RETURN
			            IF ( _d22 > 0 && _d26 > 0, 1 )
			) + 0
		formatString: #,0
		displayFolder: T11 Virada\Contas
		lineageTag: 44acf4e2-a033-5466-83a3-443ec2b623d9

	/// Municípios com o adversário à frente em 2022 (Jair) e em 2026 (Flávio). Conta município a município no recorte.
	measure 'T11 · seguiram com o adversário' =
			SUMX (
			    VALUES ( 'Município'[CodIBGE] ),
			        VAR _d22 = [T11 · saldo 2022]
			        VAR _d26 = [T11 · saldo 2026]
			        RETURN
			            IF ( _d22 < 0 && _d26 < 0, 1 )
			) + 0
		formatString: #,0
		displayFolder: T11 Virada\Contas
		lineageTag: 0752d65f-163e-5305-b018-ed2e4eeeea6a

	/// Segunda região com mais municípios que trocaram de lado.
	measure 'T11 · segunda região com mais viradas' =
			VAR _r =
			    ADDCOLUMNS ( VALUES ( 'Município'[Região] ), "@n", [T11 · viraram] )
			VAR _top1 =
			    TOPN ( 1, _r, [@n], DESC, 'Município'[Região], ASC )
			VAR _top2 =
			    TOPN ( 2, _r, [@n], DESC, 'Município'[Região], ASC )
			VAR _seg =
			    EXCEPT ( _top2, _top1 )
			RETURN
			    IF ( MAXX ( _seg, [@n] ) > 0, MAXX ( _seg, 'Município'[Região] ) )
		displayFolder: T11 Virada\Contas
		lineageTag: f2d5b0e1-3aca-5ca1-b6f6-5a87a5c796e6

	/// Quantos municípios estão selecionados no mapa (clique num ponto ou área arrastada) ou na lista; vazio sem seleção. O filtro cruzado chega como filtro direto nas colunas do Município (o de UF da casca, não).
	measure 'T11 · seleção' =
			IF ( ISFILTERED ( 'Município' ), COUNTROWS ( VALUES ( 'Município'[CodIBGE] ) ) )
		formatString: #,0
		displayFolder: T11 Virada\Contas
		lineageTag: 778160a9-bcd5-571c-b57b-b769839c0163

	/// Situação do município, para o mapa: 0 Lula à frente em 2026, 1 Flávio à frente, 2 trocou Lula por Flávio, 3 trocou Flávio por Lula, 4 empate. Lida no grão do município (o Deneb pinta o ponto).
	measure 'T11 · situação' =
			VAR _d22 = [T11 · saldo 2022]
			VAR _d26 = [T11 · saldo 2026]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d26 ), BLANK (),
			        _d22 > 0 && _d26 < 0, 2,
			        _d22 < 0 && _d26 > 0, 3,
			        _d26 > 0, 0,
			        _d26 < 0, 1,
			        4
			    )
		formatString: 0
		displayFolder: T11 Virada\Contas
		lineageTag: cc1b4d00-0c8f-5b62-b424-0926cf684fb6

	/// Votos de Lula em 2026 menos em 2022, somados no recorte.
	measure 'T11 · variação de votos de Lula' =
