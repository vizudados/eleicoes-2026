	measure 'T18 · noite · 17h' =
			VAR _min = CALCULATE ( MIN ( 'Apuração histórico'[AtualizadoTSE] ), REMOVEFILTERS ( 'Apuração histórico' ) )
			RETURN
			    IF ( NOT ISBLANK ( _min ), INT ( _min ) + TIME ( 17, 0, 0 ) )
		formatString: dd/MM/yyyy HH:mm
		displayFolder: T18 Apuração\Contas
		lineageTag: 4bb115e2-9214-5f31-8a81-98efdc3fb0d5

	/// 1 quando o contexto não tem nenhuma UF: o clique num quadrado do mapa (que mostra sempre o Brasil inteiro) caiu fora do filtro de estado (ex.: Nordeste no filtro e SP no mapa). O placar avisa em vez de mostrar zeros; 0 nos outros casos.
	measure 'T18 · recorte vazio' =
			IF ( ISFILTERED ( 'UF' ) && COUNTROWS ( VALUES ( 'UF'[UF] ) ) = 0, 1, 0 )
		formatString: 0
		displayFolder: T18 Apuração\Contas
		lineageTag: 9639d216-6f2c-57cb-9bce-abbc42873559

	/// Texto para leitor de tela dos pontos da curva da noite.
	measure 'T18 · Curva pontos · ALT' =
			VAR _n = [T18 · momento · atualizações da noite]
			RETURN
			    IF (
			        _n = 0,
			        "A curva da noite começa às 17h, com a primeira divulgação do TSE.",
			        "Uma faixa por atualização do TSE (" & _n & IF ( _n = 1, " atualização", " atualizações" )
			            & " até agora): passe o mouse para ver o que mudou; clique para ver o resultado parcial daquele momento."
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: 152bfb0f-e474-5329-9915-174ee0676db1

	/// Os pontos da curva da noite (grão 'Apuração histórico'[AtualizadoTSE]), na mesma caixa e escala da T18 · Curva · HTML: uma faixa de clique por atualização do TSE (de meio caminho da anterior a meio caminho da seguinte), com a linha da hora e os dois pontos que aparecem no mouse. Clique: o placar mostra o retrato daquele momento (e a hora fica marcada); dossiê ttT18Momento. Vazio antes da primeira divulgação.
	measure 'T18 · Curva pontos · HTML' =
			-- 1 · Leituras
			VAR _m = [T18 · momento escolhido]
			VAR _ant = [T18 · momento · anterior]
			VAR _seg = [T18 · momento · seguinte]
			VAR _base = [T18 · noite · 17h]
			VAR _l = [T18 · momento · Lula %]
			VAR _f = [T18 · momento · Flávio %]
			-- 2 · Textos
			VAR _hora = FORMAT ( _m, "HH:mm" )
			-- 3 · Geometria (a da curva: svg a 44 px do topo; x 70–840 = 17h–0h, contadas das 17h do dia da primeira atualização;
			--   y 20–250 = 60%–40%; a faixa de clique vai do meio do caminho até a anterior ao meio do caminho até a seguinte)
			VAR _x = 70 + MIN ( MAX ( ( _m - _base ) * 24, 0 ), 7 ) / 7 * 770 -- geometria
			VAR _xa = IF ( ISBLANK ( _ant ), 64, ( 70 + MIN ( MAX ( ( _ant - _base ) * 24, 0 ), 7 ) / 7 * 770 + _x ) / 2 ) -- geometria
			VAR _xs = IF ( ISBLANK ( _seg ), 846, ( 70 + MIN ( MAX ( ( _seg - _base ) * 24, 0 ), 7 ) / 7 * 770 + _x ) / 2 ) -- geometria
			VAR _ini = MIN ( _xa, _x - 3 ) -- geometria
			VAR _larg = MAX ( _xs, _x + 3 ) - _ini -- geometria
			VAR _yl = 44 + 20 + ( 1 - ( MIN ( MAX ( _l, 0.40 ), 0.60 ) - 0.40 ) / 0.20 ) * 230 -- geometria
			VAR _yf = 44 + 20 + ( 1 - ( MIN ( MAX ( _f, 0.40 ), 0.60 ) - 0.40 ) / 0.20 ) * 230 -- geometria
			VAR _fm = "0.0"
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _m ),
			        "<div class='tela t18k'><i class='al' style='left:" & FORMAT ( _ini, _fm, "en-US" ) & "px;width:"
			            & FORMAT ( _larg, _fm, "en-US" ) & "px'></i><i class='gu' style='left:" & FORMAT ( _x - 1, _fm, "en-US" )
			            & "px'></i><i class='pd l' style='left:" & FORMAT ( _x - 6, _fm, "en-US" ) & "px;top:"
			            & FORMAT ( _yl - 6, _fm, "en-US" ) & "px'></i><i class='pd f' style='left:" & FORMAT ( _x - 6, _fm, "en-US" )
			            & "px;top:" & FORMAT ( _yf - 6, _fm, "en-US" ) & "px'></i><b class='hr' style='left:"
			            & FORMAT ( _x, _fm, "en-US" ) & "px'>" & _hora & "</b></div>"
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: 89872109-bdd8-555a-ac3b-bd71831269f5

	/// Texto alternativo da curva da noite.
	measure 'T18 · Curva · ALT' =
			VAR _n = [Histórico · atualizações]
			RETURN
			    IF (
			        _n = 0,
			        "A curva da noite começa às 17h de 25/10, com a primeira atualização do TSE.",
			        "A curva da noite no Brasil: " & _n & IF ( _n = 1, " atualização", " atualizações" ) & " do TSE guardadas."
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: 5536151e-dd2e-56eb-978c-5a851270ef87

	/// A curva da noite: % dos válidos de cada um a cada hora nova de totalização do TSE, das 17h à 0h (Brasil; o histórico só guarda o Brasil), contadas das 17h do dia da primeira atualização (depois da meia-noite, o ponto fica na borda da direita). As linhas se desenham; o último ponto brota com o rótulo.
	measure 'T18 · Curva · HTML' =
			-- 1 · Leituras
			VAR _n = [Histórico · atualizações]
			VAR _min = 0.40
			VAR _max = 0.60
			VAR _base = [T18 · noite · 17h]
			VAR _pts =
			    ADDCOLUMNS (
			        'Apuração histórico', -- lista (o histórico não tem relação com UF: o filtro do estado não chega nele)
			        "@x", 70 + MIN ( MAX ( ( 'Apuração histórico'[AtualizadoTSE] - _base ) * 24, 0 ), 7 ) / 7 * 770,
			        "@l", DIVIDE ( 'Apuração histórico'[LulaVotos], 'Apuração histórico'[Validos] ),
			        "@f", DIVIDE ( 'Apuração histórico'[FlavioVotos], 'Apuração histórico'[Validos] )
			    )
			VAR _pts2 =
			    ADDCOLUMNS (
			        _pts,
			        "@yl", 20 + ( 1 - ( MIN ( MAX ( [@l], _min ), _max ) - _min ) / ( _max - _min ) ) * 230,
			        "@yf", 20 + ( 1 - ( MIN ( MAX ( [@f], _min ), _max ) - _min ) / ( _max - _min ) ) * 230
			    )
			VAR _linhaL = CONCATENATEX ( _pts2, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yl], "0.0", "en-US" ), " ", [@x], ASC )
			VAR _linhaF = CONCATENATEX ( _pts2, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yf], "0.0", "en-US" ), " ", [@x], ASC )
			VAR _ultimo = TOPN ( 1, _pts2, [@x], DESC )
			VAR _xu = MAXX ( _ultimo, [@x] )
			VAR _lu = MAXX ( _ultimo, [@l] )
			VAR _fu = MAXX ( _ultimo, [@f] )
			VAR _ylu = MAXX ( _ultimo, [@yl] )
			VAR _yfu = MAXX ( _ultimo, [@yf] )
			-- 2 · Desenho
			VAR _grade =
			    CONCATENATEX (
			        ADDCOLUMNS ( { 0.40, 0.45, 0.50, 0.55, 0.60 }, "@y", 20 + ( 1 - ( [Value] - _min ) / ( _max - _min ) ) * 230 ),
			        "<line x1='70' x2='840' y1='" & FORMAT ( [@y], "0.0", "en-US" ) & "' y2='" & FORMAT ( [@y], "0.0", "en-US" )
			            & "' class='g" & IF ( [Value] = 0.5, " meio", "" ) & "'/><text x='58' y='" & FORMAT ( [@y] + 5, "0.0", "en-US" )
			            & "' class='ex' text-anchor='end'>" & FORMAT ( [Value] * 100, "0" ) & "%</text>",
			        "", [Value], ASC
			    )
			VAR _horas =
			    CONCATENATEX (
			        GENERATESERIES ( 17, 24, 1 ),
			        "<text x='" & FORMAT ( 70 + ( [Value] - 17 ) / 7 * 770, "0.0", "en-US" ) & "' y='282' class='ex' text-anchor='middle'>"
			            & IF ( [Value] = 24, "0h", [Value] & "h" ) & "</text>",
			        "", [Value], ASC
			    )
			VAR _series =
			    IF (
			        _n >= 2,
			        "<polyline points='" & _linhaF & "' class='lf traco' pathLength='1' fill='none'/>"
			            & "<polyline points='" & _linhaL & "' class='ll traco' pathLength='1' fill='none'/>"
			    )
			VAR _xr = FORMAT ( _xu, "0.0", "en-US" )
			VAR _esq = _xu < 455
			VAR _xt = FORMAT ( IF ( _esq, _xu + 14, _xu - 14 ), "0.0", "en-US" )
			VAR _ancora = IF ( _esq, "start", "end" )
			VAR _rotulos =
			    IF (
			        _n >= 1,
			        "<circle cx='" & _xr & "' cy='" & FORMAT ( _yfu, "0.0", "en-US" ) & "' r='6' class='pf brota d8'/>"
			            & "<circle cx='" & _xr & "' cy='" & FORMAT ( _ylu, "0.0", "en-US" ) & "' r='6' class='pl brota d8'/>"
			            & "<text x='" & _xt & "' y='" & FORMAT ( _yfu + IF ( _fu >= _lu, -14, 26 ), "0.0", "en-US" )
			            & "' text-anchor='" & _ancora & "' class='rf entra d9'>Flávio " & FORMAT ( _fu * 100, "0.00" ) & "%</text>"
			            & "<text x='" & _xt & "' y='" & FORMAT ( _ylu + IF ( _lu > _fu, -14, 26 ), "0.0", "en-US" )
			            & "' text-anchor='" & _ancora & "' class='rl entra d9'>Lula " & FORMAT ( _lu * 100, "0.00" ) & "%</text>"
			    )
			VAR _vazio = IF ( _n = 0, "<text x='455' y='96' text-anchor='middle' class='vz'>a curva começa às 17h</text>" )
			RETURN
			    "<div class='tela t18c'><div class='rot entra'>A CURVA DA NOITE · % DOS VÁLIDOS A CADA ATUALIZAÇÃO DO TSE · BRASIL</div>"
			        & "<svg viewBox='0 0 900 290' width='900' height='290'>" & _grade & _horas & _series & _rotulos & _vazio
			        & "</svg></div>"
		displayFolder: T18 Apuração\Desenho
		lineageTag: 9f69815b-f16d-5b0f-a13d-12b31bfe0f72

	/// Texto alternativo do mapa de quadrados.
	measure 'T18 · Mapa · ALT' =
			"Mapa de quadrados: quem lidera em cada UF. Lula à frente em " & [Apuração · UFs com Lula à frente] & ", Flávio em "
			    & [Apuração · UFs com Flávio à frente] & "."
		displayFolder: T18 Apuração\Desenho
		lineageTag: 0949c641-d9f6-5e16-a6dd-9944cbe645b0

	/// Um quadrado por UF (granularidade UF[UF]), na posição da grade do mapa: cor de quem lidera, % do líder e % de seções no canto. A raiz da entrada não pega o mouse; o quadrado pega (L114).
	measure 'T18 · Mapa · HTML' =
			VAR _uf = SELECTEDVALUE ( 'UF'[UF] )
			VAR _col = SELECTEDVALUE ( 'UF'[GradeColuna] )
			VAR _lin = SELECTEDVALUE ( 'UF'[GradeLinha] )
			VAR _lider = [Apuração · líder]
			VAR _secoes = [Apuração · seções %]
			VAR _pct = SWITCH ( _lider, "Lula", [Apuração · Lula %], "Flávio", [Apuração · Flávio %] )
			VAR _classe = SWITCH ( _lider, "Lula", "ql", "Flávio", "qf", "qz" )
			VAR _sigla = IF ( _uf = "ZZ", "EX", _uf )
			RETURN
			    IF (
			        NOT ISBLANK ( _uf ),
			        "<div class='tela mq'><div class='q " & _classe & IF ( _uf = "ZZ", " ex", "" ) & " brota d" & ( _lin + 1 )
			            & "' style='left:" & ( 22 + _col * 104 ) & "px;top:" & ( 52 + _lin * 92 ) & "px'>"
			            & "<b>" & _sigla & "</b><i>" & FORMAT ( _secoes * 100, "0" ) & "%</i>"
			            & "<span>" & IF ( ISBLANK ( _pct ), "—", FORMAT ( _pct * 100, "0.0" ) & "%" ) & "</span></div></div>"
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: dc887fab-f0c0-5fa9-ada6-c4e87277cf14

	/// Texto alternativo do placar num momento da noite (lido pela T18 · Placar · ALT quando há momento escolhido).
	measure 'T18 · Placar momento · ALT' =
			VAR _m = [T18 · momento escolhido]
			RETURN
			    IF (
			        NOT ISBLANK ( _m ),
			        "Apuração às " & FORMAT ( _m, "HH:mm" ) & " (Brasil): Lula " & FORMAT ( [T18 · momento · Lula %], "0.00%" )
			            & ", Flávio Bolsonaro " & FORMAT ( [T18 · momento · Flávio %], "0.00%" ) & ", "
			            & FORMAT ( [T18 · momento · seções %], "0.00%" ) & " das seções apuradas."
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: 85c47a05-ae04-5736-9ccb-f2ea85ee9576

	/// O placar num momento da noite (atualização do TSE clicada na curva): os dois candidatos com o % e os votos daquela hora, o selo com a hora, a frase do momento e a barra das seções apuradas até ali. Sempre o Brasil (o histórico só guarda o Brasil). Lido pela T18 · Placar · HTML quando há momento escolhido.
	measure 'T18 · Placar momento · HTML' =
			-- 1 · Leituras
			VAR _m = [T18 · momento escolhido]
			VAR _lula = [T18 · momento · Lula votos]
			VAR _flavio = [T18 · momento · Flávio votos]
			VAR _lulaP = [T18 · momento · Lula %]
			VAR _flavioP = [T18 · momento · Flávio %]
			VAR _secoes = [T18 · momento · seções %]
			VAR _dif = [T18 · momento · diferença]
			VAR _lider = [T18 · momento · líder]
			VAR _brancos = [T18 · momento · brancos]
			VAR _nulos = [T18 · momento · nulos]
			VAR _pos = [T18 · momento · posição]
			VAR _n = [T18 · momento · atualizações da noite]
			-- 2 · Textos
			VAR _hora = FORMAT ( _m, "HH:mm" )
			VAR _lulaTxt = FORMAT ( _lulaP * 100, "0.00" ) & "%"
			VAR _flavioTxt = FORMAT ( _flavioP * 100, "0.00" ) & "%"
			VAR _secoesTxt = FORMAT ( _secoes * 100, "0.00" ) & "%"
			VAR _blocoLula =
			    "<div class='cand sobe d2'><div class='rot lula-esc'>LULA · PT · 13</div><div class='num pct lula'>" & _lulaTxt
			        & "</div><div class='txt votos'>" & FORMAT ( _lula, "#,0" ) & IF ( _lula = 1, " voto", " votos" ) & "</div></div>"
			VAR _blocoFlavio =
			    "<div class='cand sobe d3'><div class='rot flavio-esc'>FLÁVIO BOLSONARO · PL · 22</div><div class='num pct flavio'>"
			        & _flavioTxt & "</div><div class='txt votos'>" & FORMAT ( _flavio, "#,0" ) & IF ( _flavio = 1, " voto", " votos" )
			        & "</div></div>"
			VAR _par = IF ( _lider = "Flávio", _blocoFlavio & _blocoLula, _blocoLula & _blocoFlavio )
			VAR _frase =
			    IF (
			        _lider = "—",
			        "Às " & _hora & ", empate exato, com " & _secoesTxt & " das seções.",
			        "Às " & _hora & ", " & _lider & " liderava por " & FORMAT ( ABS ( _dif ), "#,0" )
			            & IF ( ABS ( _dif ) = 1, " voto", " votos" ) & ", com " & _secoesTxt & " das seções."
			    )
			VAR _barra =
			    "<div class='secoes sobe d5'><div class='rot'>SEÇÕES APURADAS ÀS " & _hora & "</div><div class='trilho'>"
			        & "<div class='enche barra-x' style='width:" & FORMAT ( _secoes * 100, "0.0##", "en-US" ) & "%'></div>"
			        & "<span class='num'>" & _secoesTxt & "</span></div><div class='nota'>Brancos " & FORMAT ( _brancos, "#,0" )
			        & " · nulos " & FORMAT ( _nulos, "#,0" ) & " · atualização " & _pos & " de " & _n
			        & " · clique de novo na curva para voltar ao agora</div></div>"
			VAR _topo =
			    "<div class='rot topo entra'>NAQUELE MOMENTO · TSE ÀS " & _hora & " DE " & FORMAT ( _m, "dd/MM" ) & " · BRASIL</div>"
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _m ),
			        "<div class='tela t18p'>" & _topo & "<div class='par'>" & _par & "<div class='selo entra d6'>RETRATO DAS " & _hora
			            & "</div></div><div class='man frase sobe d4'>" & _frase & "</div>" & _barra & "</div>"
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: ec648c88-fced-52d1-a727-5a2ce8b78b40

	/// Texto alternativo do placar da apuração: o recorte ([Apuração · escopo]: Brasil, o estado, a região, os estados somados) e os números; com a eleição definida e um recorte, o eleito no Brasil; o aviso do clique no mapa fora do filtro; com uma atualização clicada na curva, o momento escolhido.
	measure 'T18 · Placar · ALT' =
			VAR _fase = [Apuração · fase]
			VAR _momento = [T18 · momento escolhido]
			VAR _escopo = [Apuração · escopo]
			VAR _eleito =
			    IF (
			        _escopo <> "Brasil" && _fase = "definido",
			        " " & [Apuração · líder no Brasil] & " está eleito no Brasil."
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _momento ), [T18 · Placar momento · ALT],
			        [T18 · recorte vazio] = 1, "Apuração: o estado clicado no mapa fica fora do filtro de estado.",
			        "Apuração (" & _escopo & "): "
			            & IF (
			                _fase = "aguardando",
			                "aguardando o fechamento das urnas às 17h de 25/10.",
			                "Lula " & FORMAT ( [Apuração · Lula %], "0.00%" ) & ", Flávio Bolsonaro " & FORMAT ( [Apuração · Flávio %], "0.00%" )
			                    & ", " & FORMAT ( [Apuração · seções %], "0.00%" ) & " das seções apuradas; " & [Apuração · líder] & " à frente."
			                    & _eleito
			            )
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: 0ee11881-d25b-54b3-8a2a-d0f98ce1ec39

	/// Placar da apuração: horas do TSE e da coleta, os dois candidatos (o líder à esquerda; zerados, a ordem da urna), o selo do estado, a frase do momento, o relógio até as 17h (aguardando, contado no navegador) e a barra de seções. No recorte (filtro de estado em árvore ou clique no mapa: um estado, uma região, vários estados somados) as contas somam as UFs escolhidas e o texto diz onde ('na Bahia', 'no Nordeste', 'em MG e SP (somados)'); com a eleição definida, a frase separa o eleito no Brasil de quem lidera no recorte. Clique no mapa fora do filtro: o aviso. Com uma atualização clicada na curva da noite, o placar daquele momento (T18 · Placar momento · HTML).
	measure 'T18 · Placar · HTML' =
			-- 1 · Leituras (contas de T18 Apuração\Contas)
			VAR _fase = [Apuração · fase]
			VAR _turno = [Apuração · turno]
			VAR _escopo = [Apuração · escopo]
			VAR _lula = [Apuração · Lula votos]
			VAR _flavio = [Apuração · Flávio votos]
			VAR _lulaP = [Apuração · Lula %]
			VAR _flavioP = [Apuração · Flávio %]
			VAR _secoes = [Apuração · seções %]
			VAR _dif = [Apuração · diferença]
			VAR _lider = [Apuração · líder]
			VAR _eleitorado = [Apuração · eleitorado]
			VAR _abst = [Apuração · abstenção %]
			VAR _brancos = [Apuração · brancos]
			VAR _nulos = [Apuração · nulos]
			VAR _tse = [Apuração · atualizado no TSE]
			VAR _coleta = [Apuração · coletado em]
			VAR _momento = [T18 · momento escolhido]
			VAR _vazio = [T18 · recorte vazio]
			VAR _em = [Recorte · em]
			VAR _tipo = [Recorte · tipo]
			VAR _liderBR = [Apuração · líder no Brasil]
			-- 2 · Textos
			-- onde: vazio no Brasil (a frase de sempre); 'na Bahia', 'no Nordeste', 'em MG e SP (somados)' no recorte
			VAR _ondeTxt = _em & IF ( _tipo = "Vários", " (somados)", "" )
			VAR _onde = IF ( _escopo = "Brasil", "", " " & _ondeTxt )
			VAR _aguarda = _fase = "aguardando"
			VAR _lulaTxt = IF ( _aguarda, "—", FORMAT ( _lulaP * 100, "0.00" ) & "%" )
			VAR _flavioTxt = IF ( _aguarda, "—", FORMAT ( _flavioP * 100, "0.00" ) & "%" )
			-- antes da 1ª parcial, "0,00% · 0 votos" parecia resultado: o placar mostra o traço e diz que espera
			VAR _votosLula = IF ( _aguarda, "aguardando a 1ª parcial", FORMAT ( _lula, "#,0" ) & IF ( _lula = 1, " voto", " votos" ) )
			VAR _votosFlavio = IF ( _aguarda, "aguardando a 1ª parcial", FORMAT ( _flavio, "#,0" ) & IF ( _flavio = 1, " voto", " votos" ) )
			VAR _secoesTxt = FORMAT ( _secoes * 100, "0.00" ) & "%"
			VAR _difTxt = FORMAT ( _dif, "#,0" )
			VAR _tseTxt = IF ( ISBLANK ( _tse ), "—", FORMAT ( _tse, "dd/MM/yyyy HH:mm" ) )
			VAR _coletaTxt = IF ( ISBLANK ( _coleta ), "—", FORMAT ( _coleta, "dd/MM/yyyy HH:mm" ) )
			VAR _blocoLula =
			    "<div class='cand sobe d2'><div class='rot lula-esc'>LULA · PT · 13</div><div class='num pct lula'>" & _lulaTxt
			        & "</div><div class='txt votos'>" & _votosLula & "</div></div>"
			VAR _blocoFlavio =
			    "<div class='cand sobe d3'><div class='rot flavio-esc'>FLÁVIO BOLSONARO · PL · 22</div><div class='num pct flavio'>"
			        & _flavioTxt & "</div><div class='txt votos'>" & _votosFlavio & "</div></div>"
			VAR _par = IF ( _lider = "Flávio", _blocoFlavio & _blocoLula, _blocoLula & _blocoFlavio )
			VAR _selo =
			    SWITCH (
			        TRUE (),
			        _turno = 1, "<div class='selo entra d6'>ENSAIO · 1º TURNO</div>",
			        _fase = "definido", "<div class='selo entra d6'>MATEMATICAMENTE DEFINIDO</div>",
			        _fase = "encerrada", "<div class='selo entra d6'>APURAÇÃO ENCERRADA</div>",
			        ""
			    )
			VAR _frase =
			    SWITCH (
			        TRUE (),
			        _aguarda, "As urnas fecham às 17h de domingo, 25/10.",
			        -- no recorte, o eleito é o do Brasil (a fase é nacional) e o recorte diz só quem lidera nele
			        _escopo <> "Brasil" && _fase = "definido",
			            _liderBR & " está matematicamente eleito no Brasil; " & _ondeTxt & ", "
			                & IF ( _lider = "—", "empate exato", _lider & " está à frente por " & _difTxt & " votos" ) & ".",
			        _lider = "—", "Empate exato" & _onde & " com " & _secoesTxt & " das seções apuradas.",
			        _fase = "apurando", _lider & " está à frente" & _onde & " por " & _difTxt & " votos, com " & _secoesTxt
			            & " das seções apuradas.",
			        _fase = "definido", _lider & " está matematicamente eleito: a diferença de " & _difTxt
			            & " votos já não pode ser revertida.",
			        _lider & " lidera" & _onde & " · apuração encerrada · diferença de " & _difTxt & " votos"
			    )
			VAR _relogio =
			    IF (
			        _aguarda,
			        "<div class='relogio sobe d4'><span class='rot'>FALTAM</span><span class='num' id='t18rel'>—</span></div>"
			            & "<div class='txt sobe d5'>" & FORMAT ( _eleitorado, "#,0" ) & " eleitores podem votar"
			            & IF ( _escopo = "Brasil", "", " " & _em ) & ".</div>"
			    )
			VAR _barra =
			    "<div class='secoes sobe d5'><div class='rot'>SEÇÕES APURADAS" & IF ( _escopo = "Brasil", "", " · " & UPPER ( _escopo ) )
			        & "</div><div class='trilho'><div class='enche barra-x' style='width:"
			        & FORMAT ( _secoes * 100, "0.0##", "en-US" ) & "%'></div><span class='num'>" & _secoesTxt
			        & "</span></div><div class='nota'>Abstenção " & FORMAT ( _abst * 100, "0.00" ) & "% · brancos "
			        & FORMAT ( _brancos, "#,0" ) & " · nulos " & FORMAT ( _nulos, "#,0" ) & "</div></div>"
			-- o recorte no fim da linha do topo; com o selo (ensaio, definido, encerrada) ele ficaria embaixo do carimbo, e a frase e
			-- a barra já dizem onde
			VAR _topo =
			    "<div class='rot topo entra'>"
			        & IF ( ISBLANK ( _tse ), "AGUARDANDO A PRIMEIRA DIVULGAÇÃO DO TSE", "ATUALIZADO PELO TSE · " & _tseTxt )
			        & " · COLETADO EM " & _coletaTxt & IF ( _escopo = "Brasil" || _selo <> "", "", " · " & UPPER ( _escopo ) )
			        & "</div>"
			VAR _marca = IF ( _aguarda || _lider = "—", "", "<span class='visto'>✓</span>" )
			-- clique no mapa fora do filtro de estado: nenhuma UF nas contas; o placar avisa em vez de mostrar zeros
			VAR _aviso =
			    "<div class='tela t18p'><div class='rot topo entra'>"
			        & IF ( ISBLANK ( _tse ), "AGUARDANDO A PRIMEIRA DIVULGAÇÃO DO TSE", "ATUALIZADO PELO TSE · " & _tseTxt )
			        & " · COLETADO EM " & _coletaTxt & "</div><div class='man frase sobe d4'>O estado clicado no mapa fica fora "
			        & "do filtro de estado do alto. Clique nele de novo para voltar ao recorte do filtro.</div></div>"
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _momento ), [T18 · Placar momento · HTML],
			        _vazio = 1, _aviso,
			        "<div class='tela t18p'>" & _topo & "<div class='par'>" & _par & _selo & "</div>"
			            & "<div class='man frase sobe d4'>" & _marca & _frase & "</div>" & _relogio
			            & IF ( _aguarda, "", _barra ) & "</div>"
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: d70b1cf1-80dd-5925-bdaa-ef33b8a9cdb7

	/// Texto alternativo do dossiê de uma atualização do TSE na curva da noite.
	measure 'T18 · Tooltip momento · ALT' =
			VAR _m = [T18 · momento escolhido]
			RETURN
			    IF (
			        NOT ISBLANK ( _m ),
			        "Às " & FORMAT ( _m, "HH:mm" ) & ", com " & FORMAT ( [T18 · momento · seções %] * 100, "0.00" )
			            & "% das seções: Lula " & FORMAT ( [T18 · momento · Lula %] * 100, "0.00" ) & "%, Flávio "
			            & FORMAT ( [T18 · momento · Flávio %] * 100, "0.00" ) & "%."
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: 114e80ba-87ed-5c6c-96d9-1a1222037c26

	/// Dossiê de uma atualização do TSE na curva da noite (ttT18Momento, grão 'Apuração histórico'[AtualizadoTSE]): a hora, as seções, o % de cada um com a mudança desde a anterior, quantos votos entraram e para quem, e como a diferença se moveu; nota à mão com o que aconteceu (abriu, encostou, virou).
	measure 'T18 · Tooltip momento · HTML' =
			-- 1 · Leituras
			VAR _m = [T18 · momento escolhido]
			VAR _ant = [T18 · momento · anterior]
			VAR _pos = [T18 · momento · posição]
			VAR _n = [T18 · momento · atualizações da noite]
			VAR _secoes = [T18 · momento · seções %]
			VAR _lulaP = [T18 · momento · Lula %]
			VAR _flavioP = [T18 · momento · Flávio %]
			VAR _varL = [T18 · momento · Lula % variação]
			VAR _varF = [T18 · momento · Flávio % variação]
			VAR _validos = [T18 · momento · válidos]
			VAR _entrou = [T18 · momento · válidos que entraram]
			VAR _ganhouL = [T18 · momento · Lula ganhou]
			VAR _ganhouF = [T18 · momento · Flávio ganhou]
			VAR _dif = [T18 · momento · diferença]
			VAR _difAnt = [T18 · momento · diferença na anterior]
			-- 2 · Textos
			VAR _hora = FORMAT ( _m, "HH:mm" )
			VAR _txtVarL = IF ( ISBLANK ( _varL ), "", "<span class='vr'>" & FORMAT ( _varL * 100, "+0.00;−0.00;0.00" ) & "</span>" )
			VAR _txtVarF = IF ( ISBLANK ( _varF ), "", "<span class='vr'>" & FORMAT ( _varF * 100, "+0.00;−0.00;0.00" ) & "</span>" )
			VAR _txtDif = SWITCH ( TRUE (), _dif > 0, "Lula +", _dif < 0, "Flávio +", "empate" ) & IF ( _dif = 0, "", FORMAT ( ABS ( _dif ), "#,0" ) )
			VAR _txtDifAnt =
			    SWITCH ( TRUE (), _difAnt > 0, "Lula +", _difAnt < 0, "Flávio +", "empate" ) & IF ( _difAnt = 0, "", FORMAT ( ABS ( _difAnt ), "#,0" ) )
			VAR _txtEntrou =
			    IF (
			        ISBLANK ( _ant ),
			        "A primeira parcial da noite: " & FORMAT ( _validos, "#,0" ) & " votos válidos contados.",
			        "Desde a anterior (" & FORMAT ( _ant, "HH:mm" ) & "), entraram " & FORMAT ( _entrou, "#,0" ) & " votos válidos: "
			            & "<b class='lula'>" & FORMAT ( _ganhouL, "#,0" ) & "</b> para Lula e <b class='flavio'>" & FORMAT ( _ganhouF, "#,0" )
			            & "</b> para Flávio. A diferença foi de " & _txtDifAnt & " para " & _txtDif & "."
			    )
			VAR _virou = NOT ISBLANK ( _difAnt ) && _dif <> 0 && SIGN ( _dif ) <> SIGN ( _difAnt )
			VAR _abriu = NOT ISBLANK ( _difAnt ) && ABS ( _dif ) >= ABS ( _difAnt )
			VAR _mao =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _ant ), "a primeira parcial",
			        _virou, "virou aqui",
			        _dif = 0, "empate",
			        _abriu, IF ( _dif > 0, "Lula abriu mais", "Flávio abriu mais" ),
			        IF ( _dif > 0, "Flávio encostou", "Lula encostou" )
			    )
			VAR _corMao =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _ant ) || _dif = 0, "",
			        _virou || _abriu, IF ( _dif > 0, " lula", " flavio" ),
			        IF ( _dif > 0, " flavio", " lula" )
			    )
			-- 3 · Geometria (barra dividida: Lula à esquerda, Flávio à direita, sobre os válidos)
			VAR _wl = FORMAT ( _lulaP * 100, "0.0##", "en-US" )
			VAR _wf = FORMAT ( _flavioP * 100, "0.0##", "en-US" )
			-- 4 · Marcação
			RETURN
			    IF (
			        NOT ISBLANK ( _m ),
			        "<div class='tela tt18 tt18m'><div class='fita'></div>"
			            & "<div class='rot sobe'>ÀS " & _hora & " · " & _pos & "ª DE " & _n & " · "
			            & FORMAT ( _secoes * 100, "0.00" ) & "% DAS SEÇÕES</div>"
			            & "<div class='duo sobe d2'><div><small class='lula-esc'>LULA</small><span class='num lula'>"
			            & FORMAT ( _lulaP * 100, "0.00" ) & "%</span>" & _txtVarL & "</div>"
			            & "<div><small class='flavio-esc'>FLÁVIO</small><span class='num flavio'>" & FORMAT ( _flavioP * 100, "0.00" )
			            & "%</span>" & _txtVarF & "</div></div>"
			            & "<div class='barra sobe d3'><i class='bl barra-x' style='width:" & _wl & "%'></i>"
			            & "<i class='bf barra-x-dir' style='width:" & _wf & "%'></i></div>"
			            & "<div class='txt sobe d4'>" & _txtEntrou & "</div>"
			            & "<div class='mao" & _corMao & " entra d6'>" & _mao & "</div>"
			        & "</div>"
			    )
		displayFolder: T18 Apuração\Desenho
		lineageTag: c524f719-a3ac-5cb6-8943-fdfe3aa17664

	/// Texto alternativo do dossiê da UF.
	measure 'T18 · Tooltip UF · ALT' =
			SELECTEDVALUE ( 'UF'[Nome] ) & ": Lula " & FORMAT ( [Apuração · Lula %], "0.00%" ) & ", Flávio " & FORMAT ( [Apuração · Flávio %], "0.00%" )
		displayFolder: T18 Apuração\Desenho
		lineageTag: dfda2316-5c64-5e74-8aea-7d6d7169c2c2

	/// Dossiê da UF no mapa (página de tooltip ttT18Uf). Com votos apurados: os dois percentuais com a barra, votos, diferença, seções, abstenção, hora do TSE e a nota à mão de quem está na frente. Antes dos primeiros votos da UF: quando a apuração começa, o eleitorado e as seções, e como a UF votou no 1º turno (contas da tela 13).
	measure 'T18 · Tooltip UF · HTML' =
			VAR _uf = SELECTEDVALUE ( 'UF'[Nome] )
			VAR _lider = [Apuração · líder]
			VAR _l = [Apuração · Lula %]
			VAR _f = [Apuração · Flávio %]
			VAR _hora = [Apuração · atualizado no TSE]
			VAR _apurou = [Apuração · válidos] > 0
			VAR _l1 = [T12 · Lula % 2026]
			VAR _f1 = [T12 · PL % 2026]
			VAR _antes =
			    "<div class='tela tt18'><div class='fita'></div><div class='rot'>" & UPPER ( _uf ) & "</div>"
			        & "<div class='linha'><span class='num'>" & FORMAT ( [Apuração · eleitorado], "#,0" ) & "</span>"
			        & "<span class='rot'>ELEITORES</span></div>"
			        & "<div class='txt'>A apuração começa às 17h de domingo, 25/10: " & FORMAT ( [Apuração · seções], "#,0" )
			        & " seções a contar.</div>"
			        & IF (
			            NOT ISBLANK ( _l1 ),
			            "<div class='nota'>No 1º turno: Lula " & FORMAT ( _l1 * 100, "0.0" ) & "% × Flávio "
			                & FORMAT ( _f1 * 100, "0.0" ) & "% dos válidos.</div>"
			        )
			        & "<div class='mao'>ainda sem votos</div>"
			        & "</div>"
			VAR _depois =
			    "<div class='tela tt18'><div class='fita'></div><div class='rot'>" & UPPER ( _uf ) & "</div>"
			        & "<div class='linha'><span class='lula num'>" & FORMAT ( _l * 100, "0.00" ) & "%</span><span class='rot'>LULA</span></div>"
			        & "<div class='barra'><i class='bl' style='width:" & FORMAT ( _l * 100, "0.0##", "en-US" ) & "%'></i><i class='bf' style='width:"
			        & FORMAT ( _f * 100, "0.0##", "en-US" ) & "%'></i></div>"
			        & "<div class='linha'><span class='flavio num'>" & FORMAT ( _f * 100, "0.00" ) & "%</span><span class='rot'>FLÁVIO</span></div>"
			        & "<div class='txt'>" & FORMAT ( [Apuração · Lula votos], "#,0" ) & " × " & FORMAT ( [Apuração · Flávio votos], "#,0" )
			        & " votos · diferença de " & FORMAT ( [Apuração · diferença], "#,0" ) & "</div>"
			        & "<div class='nota'>" & FORMAT ( [Apuração · seções %] * 100, "0.00" ) & "% das seções · abstenção "
			        & FORMAT ( [Apuração · abstenção %] * 100, "0.00" ) & "%"
			        & IF ( ISBLANK ( _hora ), "", " · atualizado às " & FORMAT ( _hora, "HH:mm" ) ) & "</div>"
			        & IF ( _lider <> "—", "<div class='mao " & IF ( _lider = "Lula", "lula-esc", "flavio-esc" ) & "'>" & _lider & " na frente</div>" )
			        & "</div>"
			RETURN
			    IF ( _apurou, _depois, _antes )
		displayFolder: T18 Apuração\Desenho
		lineageTag: 734a82e1-2f7a-5f6d-85e9-dcab1db40dc9

	/// Quantas horas de totalização o histórico guardou.
	measure 'Histórico · atualizações' =
			COUNTROWS ( 'Apuração histórico' ) + 0
		formatString: 0
		displayFolder: T18 Apuração\Histórico
		lineageTag: 651f59bb-8921-5f71-ae9c-daec09591bcd

	/// Flávio sobre os válidos no Brasil em cada hora do TSE.
	measure 'Histórico · Flávio %' =
			DIVIDE ( SUM ( 'Apuração histórico'[FlavioVotos] ), SUM ( 'Apuração histórico'[Validos] ) )
		formatString: 0.00%
		displayFolder: T18 Apuração\Histórico
