			            ),
			            "@n", [T13 · cidades],
			            "@v", [T13 · variação]
			        ),
			        REMOVEFILTERS ( 'Município' ),
			        VALUES ( 'UF'[UF] )
			    )
			VAR _piso =
			    SWITCH (
			        TRUE (),
			        COUNTROWS ( FILTER ( _c, [@n] >= 10 && NOT ISBLANK ( [@v] ) ) ) > 0, 10,
			        COUNTROWS ( FILTER ( _c, [@n] >= 3 && NOT ISBLANK ( [@v] ) ) ) > 0, 3,
			        1
			    )
			VAR _validas =
			    FILTER ( _c, [@n] >= _piso && NOT ISBLANK ( [@v] ) )
			VAR _pior =
