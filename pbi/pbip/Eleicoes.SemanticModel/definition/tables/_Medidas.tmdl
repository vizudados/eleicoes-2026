	/// Data do debate da Band no 2º turno, o primeiro frente a frente de Lula e Flávio (marca no gráfico do índice de popularidade). Regra explícita e neutra (24/10/2026): a linha da tabela Debate com Emissora = "Band" e Turno = 2. Não usa o MAX(Data) das linhas com os dois nos participantes: com o debate da Globo (23/10) na tabela, esse máximo passaria a ser a Globo.
	measure 'T09 · debate · data' =
			CALCULATE (
			    MAX ( Debate[Data] ),
			    REMOVEFILTERS ( Debate ),
			    Debate[Emissora] = "Band",
			    Debate[Turno] = 2
			)
		formatString: dd/MM
		displayFolder: T09 Redes\Contas
		lineageTag: 3c41dbea-5449-57f7-acf9-1d7a000e85ca

	/// O candidato clicado (nome como na base: Lula ou Flávio Bolsonaro): nos balões (filtro cruzado de Monitoramento[Candidato]) ou na coluna da direita (filtro cruzado de Seguidores[Candidato]); vazio sem clique e dentro do próprio visual que tem o candidato no grão. As outras peças apagam o outro candidato.
	measure 'T09 · foco' =
			VAR _pelosBaloes =
			    IF (
			        ISFILTERED ( Monitoramento[Candidato] ) && NOT ISINSCOPE ( Monitoramento[Candidato] ) && HASONEVALUE ( Monitoramento[Candidato] ),
			        SELECTEDVALUE ( Monitoramento[Candidato] )
			    )
			VAR _pelaColuna =
			    IF (
			        ISFILTERED ( Seguidores[Candidato] ) && NOT ISINSCOPE ( Seguidores[Candidato] ) && HASONEVALUE ( Seguidores[Candidato] ),
			        SELECTEDVALUE ( Seguidores[Candidato] )
			    )
			VAR _c = COALESCE ( _pelosBaloes, _pelaColuna )
			RETURN
			    IF ( _c IN { "Lula", "Flávio Bolsonaro" }, _c )
		displayFolder: T09 Redes\Contas
		lineageTag: 989eea89-51f5-56b8-9cb5-cc19349ed9b6

	/// Fim da janela do saldo de sentimento da Datrix usada no ponto do índice.
	measure 'T09 · humor · fim' =
			VAR _i = [T09 · humor · início]
			VAR _d = [T09 · IPD dia · data]
			RETURN
			    IF (
			        NOT ISBLANK ( _i ),
			        CALCULATE (
			            MAX ( Monitoramento[Fim] ),
			            REMOVEFILTERS ( Monitoramento ),
			            Monitoramento[Métrica] = "saldo de sentimento (% positivas - % negativas)",
			            Monitoramento[Início] = _i,
			            Monitoramento[Fim] >= _d
			        )
			    )
		formatString: dd/MM
		displayFolder: T09 Redes\Contas
		lineageTag: 855a9a3a-ef27-56fd-9950-b9f356da9711

	/// Saldo de sentimento de Flávio nas redes (% de menções positivas − % de negativas, Datrix) na janela do ponto, em pontos.
	measure 'T09 · humor · Flávio' =
