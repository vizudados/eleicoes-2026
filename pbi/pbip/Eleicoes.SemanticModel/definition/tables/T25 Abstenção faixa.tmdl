/// Município × faixa de idade × eleição (1º turno, 2014–2026): eleitores aptos e quantos faltaram, do perfil do eleitor do TSE (somado por município e faixa). Sem o exterior.
table 'T25 Abstenção faixa'
	isHidden
	lineageTag: d4af2e6b-6a8f-5576-87be-19bd6c804a5d

	/// Ano da eleição (2014, 2018, 2022, 2026).
	column Ano
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1506bbf0-52ec-5fe2-8c67-45cf30672958
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

	/// Sigla da UF do município (ZZ = exterior).
	column UF
		dataType: string
		isHidden
		lineageTag: 0e4fb81c-7fc2-57af-bb84-f987a8986375
		summarizeBy: none
		sourceColumn: UF

