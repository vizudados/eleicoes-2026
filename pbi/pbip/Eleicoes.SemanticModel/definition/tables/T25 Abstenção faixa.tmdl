	partition 'T25 Abstenção faixa' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/abstencao_faixa_municipio.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"ano", "uf", "cd_ibge", "faixa_ordem", "aptos", "abstencoes"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"ano", Int64.Type}, {"uf", type text}, {"cd_ibge", type text}, {"faixa_ordem", Int64.Type}, {"aptos", Int64.Type}, {"abstencoes", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"ano", "Ano"}, {"uf", "UF"}, {"cd_ibge", "CodIBGE"}, {"faixa_ordem", "FaixaOrdem"}, {"aptos", "Aptos"}, {"abstencoes", "Abstencoes"}}),
				    Filtro = Table.SelectRows(Nomes, each [UF] <> "ZZ")
				in
				    Filtro

	annotation PBI_ResultType = Table

