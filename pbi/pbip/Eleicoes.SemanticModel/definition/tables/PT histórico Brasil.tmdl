	partition 'PT histórico Brasil' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/pt_historico_brasil.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"ano", "turno", "uf", "candidato_pt", "adversario", "partido_adversario", "votos_pt", "votos_adv", "validos", "comparecimento", "aptos"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"ano", Int64.Type}, {"turno", Int64.Type}, {"uf", type text}, {"candidato_pt", type text}, {"adversario", type text}, {"partido_adversario", type text}, {"votos_pt", Int64.Type}, {"votos_adv", Int64.Type}, {"validos", Int64.Type}, {"comparecimento", Int64.Type}, {"aptos", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"ano", "Ano"}, {"turno", "Turno"}, {"uf", "UF"}, {"candidato_pt", "Candidato PT"}, {"adversario", "Adversário"}, {"partido_adversario", "Partido adversário"}, {"votos_pt", "VotosPT"}, {"votos_adv", "VotosAdversario"}, {"validos", "Validos"}, {"comparecimento", "Comparecimento"}, {"aptos", "Aptos"}})
				in
				    Nomes

	annotation PBI_ResultType = Table

