		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 4ab573f8-0ee7-54dd-8947-e6768f84cbc6
		summarizeBy: none
		sourceColumn: SecoesTotalizadas

		annotation SummarizationSetBy = Automatic

	/// Seções eleitorais.
	column SecoesTotal
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: d0c64ac0-f626-5016-94c5-8815eb4718e8
		summarizeBy: none
		sourceColumn: SecoesTotal

		annotation SummarizationSetBy = Automatic

	partition 'Apuração histórico' = m
		mode: import
		source =
				let
				    Fonte = fxCsv(pPastaApuracao & "/historico.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"coletado_em", "atualizado_tse", "secoes_pct", "lula_votos", "lula_pct", "flavio_votos", "flavio_pct", "brancos", "nulos", "abstencao", "validos", "secoes_totalizadas", "secoes_total"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"coletado_em", type text}, {"atualizado_tse", type text}, {"secoes_pct", type number}, {"lula_votos", Int64.Type}, {"lula_pct", type number}, {"flavio_votos", Int64.Type}, {"flavio_pct", type number}, {"brancos", Int64.Type}, {"nulos", Int64.Type}, {"abstencao", Int64.Type}, {"validos", Int64.Type}, {"secoes_totalizadas", Int64.Type}, {"secoes_total", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"coletado_em", "ColetadoEm"}, {"atualizado_tse", "AtualizadoTSE"}, {"secoes_pct", "SecoesPct"}, {"lula_votos", "LulaVotos"}, {"lula_pct", "LulaPct"}, {"flavio_votos", "FlavioVotos"}, {"flavio_pct", "FlavioPct"}, {"brancos", "Brancos"}, {"nulos", "Nulos"}, {"abstencao", "Abstencao"}, {"validos", "Validos"}, {"secoes_totalizadas", "SecoesTotalizadas"}, {"secoes_total", "SecoesTotal"}}),
				    Horas = Table.TransformColumns(Nomes, {{"ColetadoEm", fxHora, type nullable datetime}, {"AtualizadoTSE", fxHora, type nullable datetime}})
				in
				    Horas

	annotation PBI_ResultType = Table
