	partition 'Apuração Brasil' = m
		mode: import
		source =
				let
				    Fonte = fxCsv(pPastaApuracao & "/ufs.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"uf", "atualizado_tse", "secoes_pct", "eleitorado", "comparecimento", "abstencao", "abstencao_pct", "brancos", "nulos", "validos", "lula_votos", "lula_pct", "flavio_votos", "flavio_pct", "lider", "diferenca_votos", "secoes_total", "secoes_totalizadas", "eleitorado_apurado"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"uf", type text}, {"atualizado_tse", type text}, {"secoes_pct", type number}, {"eleitorado", Int64.Type}, {"comparecimento", Int64.Type}, {"abstencao", Int64.Type}, {"abstencao_pct", type number}, {"brancos", Int64.Type}, {"nulos", Int64.Type}, {"validos", Int64.Type}, {"lula_votos", Int64.Type}, {"lula_pct", type number}, {"flavio_votos", Int64.Type}, {"flavio_pct", type number}, {"lider", type text}, {"diferenca_votos", Int64.Type}, {"secoes_total", Int64.Type}, {"secoes_totalizadas", Int64.Type}, {"eleitorado_apurado", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"uf", "UF"}, {"atualizado_tse", "AtualizadoTSE"}, {"secoes_pct", "SecoesPct"}, {"eleitorado", "Eleitorado"}, {"comparecimento", "Comparecimento"}, {"abstencao", "Abstencao"}, {"abstencao_pct", "AbstencaoPct"}, {"brancos", "Brancos"}, {"nulos", "Nulos"}, {"validos", "Validos"}, {"lula_votos", "LulaVotos"}, {"lula_pct", "LulaPct"}, {"flavio_votos", "FlavioVotos"}, {"flavio_pct", "FlavioPct"}, {"lider", "Lider"}, {"diferenca_votos", "DiferencaVotos"}, {"secoes_total", "SecoesTotal"}, {"secoes_totalizadas", "SecoesTotalizadas"}, {"eleitorado_apurado", "EleitoradoApurado"}}),
				    Horas = Table.TransformColumns(Nomes, {{"AtualizadoTSE", fxHora, type nullable datetime}}),
				    Filtro = Table.SelectRows(Horas, each [UF] = "BR")
				in
				    Filtro

	annotation PBI_ResultType = Table

