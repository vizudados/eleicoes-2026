	partition 'T20 Local' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/t20_locais.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"id", "cod_ibge", "cidade", "uf", "local", "nome", "bairro", "zona", "numero", "secoes", "pt_2026", "adv_2026", "validos_2026", "pt_2022", "adv_2022", "validos_2022", "pt_2018", "adv_2018", "validos_2018", "px", "py", "fora_mapa", "pos_queda", "ordem_nome"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"id", Int64.Type}, {"cod_ibge", type text}, {"cidade", type text}, {"uf", type text}, {"local", type text}, {"nome", type text}, {"bairro", type text}, {"zona", Int64.Type}, {"numero", Int64.Type}, {"secoes", Int64.Type}, {"pt_2026", Int64.Type}, {"adv_2026", Int64.Type}, {"validos_2026", Int64.Type}, {"pt_2022", Int64.Type}, {"adv_2022", Int64.Type}, {"validos_2022", Int64.Type}, {"pt_2018", Int64.Type}, {"adv_2018", Int64.Type}, {"validos_2018", Int64.Type}, {"px", type number}, {"py", type number}, {"fora_mapa", type text}, {"pos_queda", Int64.Type}, {"ordem_nome", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"id", "Id"}, {"cod_ibge", "CodIBGE"}, {"cidade", "Cidade"}, {"uf", "UF"}, {"local", "Local"}, {"nome", "Nome"}, {"bairro", "Bairro"}, {"zona", "Zona"}, {"numero", "Número"}, {"secoes", "Seções"}, {"pt_2026", "VotosPT2026"}, {"adv_2026", "VotosAdv2026"}, {"validos_2026", "Validos2026"}, {"pt_2022", "VotosPT2022"}, {"adv_2022", "VotosAdv2022"}, {"validos_2022", "Validos2022"}, {"pt_2018", "VotosPT2018"}, {"adv_2018", "VotosAdv2018"}, {"validos_2018", "Validos2018"}, {"px", "PX"}, {"py", "PY"}, {"fora_mapa", "Fora do mapa"}, {"pos_queda", "PosQueda"}, {"ordem_nome", "OrdemNome"}}),
				    ComChave = Table.AddColumn(Nomes, "LocalChave",
				        each if [Local] = null or [Local] = "" then [Nome] else [Local], type text),
				    SemVazia = Table.RemoveColumns(ComChave, {"Local"}),
				    Final = Table.RenameColumns(SemVazia, {{"LocalChave", "Local"}})
				in
				    Final

	annotation PBI_ResultType = Table
