/// Segundo turno por UF, 2022 e 2026, com exterior ZZ. Os totais nacionais incluem o exterior; as análises municipais das telas T27 e T28 não incluem.
table 'UF segundo turno'
	isHidden
	lineageTag: 303b5611-6b47-51c3-92dc-23fbbd9d60e8

	/// Sigla da UF ou ZZ, exterior.
	column UF
		dataType: string
		isHidden
		lineageTag: 34562a06-808d-570f-a724-2bbfe8c6728d
		summarizeBy: none
		sourceColumn: UF

		annotation SummarizationSetBy = Automatic

	/// Ano, somente segundo turno.
	column Ano
		dataType: int64
		isHidden
		formatString: 0
