	partition 'UF segundo turno' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/uf_2turno.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"uf", "ano", "pt", "adv", "demais", "validos", "aptos", "comparecimento", "abstencoes", "brancos", "nulos"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"uf", type text}, {"ano", Int64.Type}, {"pt", Int64.Type}, {"adv", Int64.Type}, {"demais", Int64.Type}, {"validos", Int64.Type}, {"aptos", Int64.Type}, {"comparecimento", Int64.Type}, {"abstencoes", Int64.Type}, {"brancos", Int64.Type}, {"nulos", Int64.Type}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"uf", "UF"}, {"ano", "Ano"}, {"pt", "VotosPT"}, {"adv", "VotosAdversario"}, {"demais", "VotosDemais"}, {"validos", "Validos"}, {"aptos", "Aptos"}, {"comparecimento", "Comparecimento"}, {"abstencoes", "Abstencoes"}, {"brancos", "Brancos"}, {"nulos", "Nulos"}})
				in
				    Nomes

	annotation PBI_ResultType = Table
