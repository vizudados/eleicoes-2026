/// O filtro do recorte da tela 19 (árvore do VizuFilter, um campo só): uma linha por município × grupo (o lugar, Região › Estado › Cidade; Tamanho da cidade; Renda; Virou?). Sem relação ativa com o Município: a medida [T19 · no recorte] aplica E entre os grupos e OU dentro do mesmo grupo.
table 'T19 Filtro'
	lineageTag: 83a40b84-1951-5cea-b83e-a0ffc3de0bad

	/// Código IBGE do município da linha (relação INATIVA com o Município, ligada só em [T19 · no recorte]).
	column CodIBGE
		dataType: string
		isHidden
		lineageTag: da7359c8-df38-5fe0-93eb-fe66ad60ff1c
		summarizeBy: none
		sourceColumn: CodIBGE

		annotation SummarizationSetBy = Automatic

	/// O grupo do filtro: Região, estado e cidade; Tamanho da cidade; Renda (quinto); Virou?.
	column Raiz
		dataType: string
		isHidden
		lineageTag: 04c07f82-383d-5528-b634-ef1fb25de512
		summarizeBy: none
		sourceColumn: Raiz
		sortByColumn: RaizOrdem

		annotation SummarizationSetBy = Automatic

	/// Ordem do grupo (1 = o lugar, 2 = tamanho, 3 = renda, 4 = virou); as medidas leem o grupo por ela.
	column RaizOrdem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c5b780b3-1f39-5492-81dd-3e2ee21ded59
		summarizeBy: none
		sourceColumn: RaizOrdem

		annotation SummarizationSetBy = Automatic

	/// O valor escolhido na folha (a cidade, 'Contagem (MG)'; até 10 mil; 1º quinto (mais pobres); Virou para Flávio…).
	column Valor
		dataType: string
		isHidden
		lineageTag: 2cefb080-1378-5f37-9bdd-ab8b71d64ee5
		summarizeBy: none
		sourceColumn: Valor

		annotation SummarizationSetBy = Automatic

	/// Forma curta do valor para o texto do recorte (o quinto como no Município).
	column Curto
		dataType: string
		isHidden
		lineageTag: 4a2cf4b6-8993-57f3-9fbb-bab5d8250d75
		summarizeBy: none
		sourceColumn: Curto

		annotation SummarizationSetBy = Automatic

	/// Grupo › níveis › folha: o campo do VizuFilter em modo caminho (o lugar com três níveis: região, estado e cidade).
	column Caminho
		dataType: string
		lineageTag: d42a2ef3-7570-51c0-9a33-8f4723b6ab88
		summarizeBy: none
		sourceColumn: Caminho
		sortByColumn: Ordem

		annotation SummarizationSetBy = Automatic

	/// Ordem do caminho: grupo × 10⁷ + a ordem dentro do grupo (no lugar, região × 10⁶ + estado × 10⁴ + cidade).
	column Ordem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a1da7324-d423-58e9-8646-779e11816feb
		summarizeBy: none
		sourceColumn: Ordem

		annotation SummarizationSetBy = Automatic

	/// Região da cidade (só nas linhas do lugar): para resumir a escolha ('Nordeste').
	column Regiao
		dataType: string
		isHidden
		lineageTag: 110aedeb-9838-5b03-ad86-c8fd168009ba
		summarizeBy: none
		sourceColumn: Regiao

		annotation SummarizationSetBy = Automatic

	/// Sigla da UF da cidade (só nas linhas do lugar): para resumir a escolha ('MG').
	column UF
		dataType: string
		isHidden
		lineageTag: 69ac0b27-ae7b-5244-8669-3738185ae809
		summarizeBy: none
		sourceColumn: UF

		annotation SummarizationSetBy = Automatic

	partition 'T19 Filtro' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/municipio.csv", ","),
				    Mun = Table.TransformColumnTypes(
				        Table.SelectColumns(Fonte, {"cd_ibge", "uf", "regiao", "rotulo", "porte", "porte_ordem", "quinto",
				            "quinto_ordem"}, MissingField.UseNull),
				        {{"cd_ibge", type text}, {"uf", type text}, {"regiao", type text}, {"rotulo", type text},
				         {"porte", type text}, {"porte_ordem", Int64.Type}, {"quinto", type text}, {"quinto_ordem", Int64.Type}},
				        "en-US"),
				    LadoFonte = fxCsv("dados/pbi/t19_lado.csv", ","),
				    Lado = Table.TransformColumnTypes(
				        Table.RenameColumns(Table.SelectColumns(LadoFonte, {"cd_ibge", "lado", "lado_ordem"}, MissingField.UseNull),
				            {{"cd_ibge", "cd_lado"}}),
				        {{"cd_lado", type text}, {"lado", type text}, {"lado_ordem", Int64.Type}}, "en-US"),
				    UFs = #table(type table [uf_k = text, uf_nome = text, uf_ordem = Int64.Type], {{"AC", "Acre", 1}, {"AL", "Alagoas", 2}, {"AP", "Amapá", 3}, {"AM", "Amazonas", 4}, {"BA", "Bahia", 5}, {"CE", "Ceará", 6}, {"DF", "Distrito Federal", 7}, {"ES", "Espírito Santo", 8}, {"GO", "Goiás", 9}, {"MA", "Maranhão", 10}, {"MT", "Mato Grosso", 11}, {"MS", "Mato Grosso do Sul", 12}, {"MG", "Minas Gerais", 13}, {"PA", "Pará", 14}, {"PB", "Paraíba", 15}, {"PR", "Paraná", 16}, {"PE", "Pernambuco", 17}, {"PI", "Piauí", 18}, {"RJ", "Rio de Janeiro", 19}, {"RN", "Rio Grande do Norte", 20}, {"RS", "Rio Grande do Sul", 21}, {"RO", "Rondônia", 22}, {"RR", "Roraima", 23}, {"SC", "Santa Catarina", 24}, {"SP", "São Paulo", 25}, {"SE", "Sergipe", 26}, {"TO", "Tocantins", 27}}),
				    Regioes = #table(type table [regiao_k = text, regiao_ordem = Int64.Type], {{"Norte", 1}, {"Nordeste", 2}, {"Centro-Oeste", 3}, {"Sudeste", 4}, {"Sul", 5}}),
				    ComLado = Table.Join(Mun, "cd_ibge", Lado, "cd_lado", JoinKind.LeftOuter),
				    ComUF = Table.Join(ComLado, "uf", UFs, "uf_k", JoinKind.LeftOuter),
				    Base = Table.Join(ComUF, "regiao", Regioes, "regiao_k", JoinKind.LeftOuter),
				    // cidades em ordem alfabética pt-BR (acento não manda na ordem: Águas Lindas fica entre os A)
				    Nomes = List.Sort(List.Distinct(Base[rotulo]), Comparer.FromCulture("pt-BR", true)),
				    OrdemCidade = Table.FromColumns({Nomes, {1..List.Count(Nomes)}},
				        type table [rotulo_k = text, cidade_ordem = Int64.Type]),
				    Tudo = Table.Buffer(Table.Join(Base, "rotulo", OrdemCidade, "rotulo_k", JoinKind.LeftOuter)),
				    N = Table.RowCount(Tudo),
				    Quinto = List.Transform(Tudo[quinto_ordem], each if _ = null then null else Text.From(_) & "º quinto"
				        & (if _ = 1 then " (mais pobres)" else if _ = 5 then " (mais ricas)" else "")),
				    Nulos = List.Repeat({null}, N),
				    Raiz = (ordem as number, raiz as text, valores as list, niveis as list, curtos as list, ordens as list,
				             regioes as list, ufs as list) as table =>
				        Table.FromColumns(
				            {Tudo[cd_ibge], List.Repeat({raiz}, N), List.Repeat({ordem}, N), valores, niveis, curtos, ordens,
				              regioes, ufs},
				            type table [CodIBGE = text, Raiz = text, RaizOrdem = Int64.Type, Valor = text, Niveis = text,
				                        Curto = text, ValorOrdem = Int64.Type, Regiao = text, UF = text]),
				    // o lugar: Região › Estado › Cidade num caminho só (a folha é a cidade); a ordem segue a hierarquia. Colunas
				    // da própria tabela (Table.AddColumn): ler Tudo[col]{i} linha a linha refaria a tabela a cada linha
				    ComLugar = Table.Buffer(Table.AddColumn(
				        Table.AddColumn(Tudo, "lugar", each [regiao] & " › " & [uf_nome] & " › " & [rotulo], type text),
				        "lugar_ordem", each [regiao_ordem] * 1000000 + [uf_ordem] * 10000 + [cidade_ordem], Int64.Type)),
				    Todas = Table.Combine({
				        Raiz(1, "Região, estado e cidade", Tudo[rotulo], ComLugar[lugar], Tudo[rotulo], ComLugar[lugar_ordem], Tudo[regiao],
				             Tudo[uf]),
				        Raiz(2, "Tamanho da cidade", Tudo[porte], Tudo[porte], Tudo[porte], Tudo[porte_ordem], Nulos, Nulos),
				        Raiz(3, "Renda (quinto)", Quinto, Quinto, Tudo[quinto], Tudo[quinto_ordem], Nulos, Nulos),
				        Raiz(4, "Virou?", Tudo[lado], Tudo[lado], Tudo[lado], Tudo[lado_ordem], Nulos, Nulos)}),
				    ComValor = Table.SelectRows(Todas, each [Valor] <> null and [Valor] <> "" and [ValorOrdem] <> null
				        and [Niveis] <> null),
				    Caminho = Table.AddColumn(ComValor, "Caminho", each [Raiz] & " › " & [Niveis], type text),
				    Ordem = Table.AddColumn(Caminho, "Ordem", each [RaizOrdem] * 10000000 + [ValorOrdem], Int64.Type),
				    Final = Table.SelectColumns(Ordem, {"CodIBGE", "Raiz", "RaizOrdem", "Valor", "Curto", "Caminho", "Ordem",
				        "Regiao", "UF"})
				in
				    Final

	annotation PBI_ResultType = Table
