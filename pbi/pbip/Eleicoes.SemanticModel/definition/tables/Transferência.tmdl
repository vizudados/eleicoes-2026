	/// Instituto.
	column Instituto
		dataType: string
		lineageTag: 5af39f9d-6a3c-5b15-b25a-f1ae2a3690a8
		summarizeBy: none
		sourceColumn: Instituto

		annotation SummarizationSetBy = Automatic

