	partition 'Transferência' = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/transferencia.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"instituto", "divulgacao", "campo_inicio", "campo_fim", "registro_tse", "segmento_1turno", "n_segmento", "lula", "flavio", "branco_nulo_nao_vota", "nao_sabe", "base", "fonte_url", "observacao"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"instituto", type text}, {"divulgacao", type date}, {"campo_inicio", type date}, {"campo_fim", type date}, {"registro_tse", type text}, {"segmento_1turno", type text}, {"n_segmento", type number}, {"lula", type number}, {"flavio", type number}, {"branco_nulo_nao_vota", type number}, {"nao_sabe", type number}, {"base", type text}, {"fonte_url", type text}, {"observacao", type text}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"instituto", "Instituto"}, {"divulgacao", "Divulgação"}, {"campo_inicio", "Campo início"}, {"campo_fim", "Campo fim"}, {"registro_tse", "Registro"}, {"segmento_1turno", "Segmento"}, {"n_segmento", "N"}, {"lula", "Lula"}, {"flavio", "Flavio"}, {"branco_nulo_nao_vota", "BrancoNulo"}, {"nao_sabe", "NaoSabe"}, {"base", "Base"}, {"fonte_url", "Fonte"}, {"observacao", "Observação"}})
				in
				    Nomes

	annotation PBI_ResultType = Table
