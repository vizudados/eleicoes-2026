	partition Município = m
		mode: import
		source =
				let
				    Fonte = fxCsv("dados/pbi/municipio.csv", ","),
				    Colunas = Table.SelectColumns(Fonte, {"cd_ibge", "cd_tse", "nome", "uf", "regiao", "rotulo", "populacao", "renda_pc", "porte", "porte_ordem", "quinto", "quinto_ordem", "lon", "lat", "x", "y"}, MissingField.UseNull),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"cd_ibge", type text}, {"cd_tse", Int64.Type}, {"nome", type text}, {"uf", type text}, {"regiao", type text}, {"rotulo", type text}, {"populacao", Int64.Type}, {"renda_pc", type number}, {"porte", type text}, {"porte_ordem", Int64.Type}, {"quinto", type text}, {"quinto_ordem", Int64.Type}, {"lon", type number}, {"lat", type number}, {"x", type number}, {"y", type number}}, "en-US"),
				    Nomes = Table.RenameColumns(Tipos, {{"cd_ibge", "CodIBGE"}, {"cd_tse", "CodTSE"}, {"nome", "Município"}, {"uf", "UF"}, {"regiao", "Região"}, {"rotulo", "Rótulo"}, {"populacao", "População"}, {"renda_pc", "Renda per capita"}, {"porte", "Porte"}, {"porte_ordem", "PorteOrdem"}, {"quinto", "Quinto de renda"}, {"quinto_ordem", "QuintoOrdem"}, {"lon", "Longitude"}, {"lat", "Latitude"}, {"x", "X"}, {"y", "Y"}})
				in
				    Nomes

	annotation PBI_ResultType = Table

