				    Nomes = Table.RenameColumns(Tipos, {{"id", "Id"}, {"cenario", "Cenário"}, {"instituto", "Instituto"}, {"contratante", "Contratante"}, {"campo_inicio", "Campo início"}, {"campo_fim", "Campo fim"}, {"divulgacao", "Divulgação"}, {"registro_tse", "Registro"}, {"amostra", "Amostra"}, {"margem_pp", "Margem"}, {"modo", "Modo"}, {"tipo", "Tipo"}, {"lula", "Lula"}, {"flavio", "Flavio"}, {"cury", "Cury"}, {"renan", "Renan"}, {"outros", "Outros"}, {"brancos_nulos", "BrancosNulos"}, {"indecisos", "Indecisos"}, {"momento", "Momento"}, {"fonte_url", "Fonte"}})
				in
