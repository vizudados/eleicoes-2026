				    Nomes = Table.RenameColumns(Tipos, {{"id", "IdLocal"}, {"cd_ibge", "CodIBGE"}, {"zona", "Zona"}, {"ano", "Ano"}, {"turno", "Turno"}, {"pt", "VotosPT"}, {"adv", "VotosAdv"}, {"validos", "Validos"}, {"secoes", "Seções"}, {"locais", "Locais"}, {"aptos", "Aptos"}, {"comparecimento", "Comparecimento"}, {"abstencoes", "Abstencoes"}, {"brancos", "Brancos"}, {"nulos", "Nulos"}})
