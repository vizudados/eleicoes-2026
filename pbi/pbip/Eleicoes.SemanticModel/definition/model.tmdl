/// Eleições 2026 · o voto de perto (Vizu Dados). Dados lidos do repositório público vizudados/eleicoes-2026 no GitHub (dados/pbi e dados/apuracao). Gerado por pbi/scripts/gerar_modelo.py; medidas em pbi/dax.
model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["pRepositorioRaw","pPastaApuracao","fxCsv","fxJson","fxHora","Apuração Brasil","Apuração UF","Apuração histórico","Apuração exterior","Apuração status","UF","Ano","Município","Município ano","Candidato ano","Candidato UF","Comparecimento ano","Abstenção perfil","Pesquisa","Debate","Trends tempo","Trends UF","Trends UF tempo","Seguidores","Monitoramento","Anúncios","Trajetória","Transferência","Rejeição","Apoio","Local Contagem","Exterior país","Período","PT histórico UF","PT histórico Brasil","PT histórico mapa","Município segundo turno","UF segundo turno","T13 Célula","T19 Filtro","T20 Local","T20 Cidade","T20 Filtro","T22 Para Lula","T22 Não votam","T22 Comparecimento","Social município","T24 Lente","T24 Degrau","Perfil pesquisa","T25 Faixa","T25 Abstenção faixa","T25 Abstenção exterior","T26 Debate Globo"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Apuração Brasil'
ref table 'Apuração UF'
ref table 'Apuração histórico'
ref table 'Apuração exterior'
ref table 'Apuração status'
ref table UF
ref table Ano
ref table 'Município'
ref table 'Município ano'
ref table 'Candidato ano'
ref table 'Candidato UF'
ref table 'Comparecimento ano'
ref table 'Abstenção perfil'
ref table Pesquisa
ref table Debate
ref table 'Trends tempo'
ref table 'Trends UF'
ref table 'Trends UF tempo'
ref table Seguidores
ref table Monitoramento
ref table 'Anúncios'
ref table 'Trajetória'
ref table 'Transferência'
ref table 'Rejeição'
ref table Apoio
ref table 'Local Contagem'
ref table 'Exterior país'
ref table 'Período'
ref table 'PT histórico UF'
ref table 'PT histórico Brasil'
ref table 'PT histórico mapa'
ref table 'Município segundo turno'
ref table 'UF segundo turno'
ref table 'T13 Célula'
ref table 'T19 Filtro'
ref table 'T20 Local'
ref table 'T20 Cidade'
ref table 'T20 Filtro'
ref table 'T22 Para Lula'
ref table 'T22 Não votam'
ref table 'T22 Comparecimento'
ref table 'Social município'
ref table 'T24 Lente'
ref table 'T24 Degrau'
ref table 'Perfil pesquisa'
ref table 'T25 Faixa'
ref table 'T25 Abstenção faixa'
ref table 'T25 Abstenção exterior'
ref table 'T26 Debate Globo'
ref table _Medidas

ref cultureInfo pt-BR
