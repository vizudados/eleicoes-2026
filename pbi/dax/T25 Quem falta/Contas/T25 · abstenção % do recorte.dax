/*
@pasta: T25 Quem falta\Contas
@formato: 0.0%
@descricao: A mesma abstenção sem o município marcado ou da linha: a média da UF do filtro (ou do Brasil, com o exterior) no ano e na faixa do contexto (0–1). Referência da cor do mapa e das comparações.
*/
CALCULATE (
    [T25 · abstenção %],
    REMOVEFILTERS ( 'Município'[CodIBGE], 'Município'[X], 'Município'[Y], 'Município'[UF], 'Município'[Rótulo], 'Município'[Município] )
)
