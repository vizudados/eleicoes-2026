/*
@pasta: T25 Quem falta\Contas
@formato: 0.0
@descricao: Quantas vezes o peso dessa faixa entre os que faltaram passa o peso dela entre os aptos.
*/
VAR _c = [T25 · faixa mais acima do seu peso]
RETURN
    IF (
        NOT ISBLANK ( _c ),
        DIVIDE (
            DIVIDE (
                CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Curta] = _c ),
                CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
            ),
            DIVIDE (
                CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'T25 Faixa'[Curta] = _c ),
                CALCULATE ( [T25 · aptos por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ) )
            )
        )
    )
