/*
@pasta: T25 Quem falta\Contas
@formato: 0%
@descricao: Parcela dos faltosos do lugar, no ano do recorte, que está na faixa da linha (0–1).
*/
VAR _ano = [T25 · ano]
RETURN
    DIVIDE (
        CALCULATE ( [T25 · abstenções por idade (cru)], 'Ano'[Ano] = _ano ),
        CALCULATE ( [T25 · abstenções por idade (cru)], REMOVEFILTERS ( 'T25 Faixa' ), 'Ano'[Ano] = _ano )
    )
