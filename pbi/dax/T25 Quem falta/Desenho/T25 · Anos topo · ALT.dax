/*
@pasta: T25 Quem falta\Desenho
@formato: texto
@descricao: Texto para leitor de tela do título do bloco de anos.
*/
LEFT (
    "A ausência ano a ano, " & [T25 · lugar] & IF ( [T25 · com faixa] = 1, ", " & [T25 · faixa] ) & ": "
        & IF ( ISBLANK ( [T25 · variação da série em p.p.] ), "sem série.",
            FORMAT ( [T25 · variação da série em p.p.], "+0.0;−0.0;0.0" ) & " pontos desde " & [T25 · primeiro ano da série] & "." ),
    250
)
