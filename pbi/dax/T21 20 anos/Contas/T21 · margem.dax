/*
@pasta: T21 20 anos\Contas
@formato: 0.0%
@descricao: Conta no turno escolhido: Pré = primeiro turno; Pós = segundo turno. Mantém as seis eleições.
*/
IF ( [Eleição · pós] = 1, DIVIDE (
    SUM ( 'Município segundo turno'[VotosPT] ) - SUM ( 'Município segundo turno'[VotosAdversario] ),
    SUM ( 'Município segundo turno'[Validos] ) ), DIVIDE (
    SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ),
    SUM ( 'Município ano'[Validos] )
) )
