/*
@pasta: T21 20 anos\Contas
@formato: #,0
@descricao: Conta no turno escolhido: Pré = primeiro turno; Pós = segundo turno. Mantém as seis eleições.
*/
IF ( [Eleição · pós] = 1, CALCULATE (
    COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T21 · margem] > 0 ) ),
    REMOVEFILTERS ( 'Município' ), KEEPFILTERS ( VALUES ( 'UF'[UF] ) ) ), CALCULATE (
    COUNTROWS ( FILTER ( VALUES ( 'Município'[CodIBGE] ), [T21 · margem] > 0 ) ),
    REMOVEFILTERS ( 'Município' )
) )
