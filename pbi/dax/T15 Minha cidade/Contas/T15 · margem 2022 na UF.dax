/*
@pasta: T15 Minha cidade\Contas
@formato: 0.0%
@descricao: Margem de Lula em 2022 na UF da cidade, somando os municípios dela (igual à conta da tela 12).
@oraculo: paginas[12] › ufs › margem22 (MG +4,7 → −4,9)
@gerado: pbi/scripts/desenho_t15.py
*/
VAR _uf = [T15 · UF da cidade]
RETURN
    IF (
        NOT ISBLANK ( _uf ),
        CALCULATE ( [T15 · margem 2022], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _uf )
    )
