IF ( [Eleição · pós] = 1, DIVIDE ( SUM ( 'Município segundo turno'[VotosPT] ), SUM ( 'Município segundo turno'[Validos] ) ), DIVIDE ( SUM ( 'Município ano'[VotosPT] ), SUM ( 'Município ano'[Validos] ) ) )
