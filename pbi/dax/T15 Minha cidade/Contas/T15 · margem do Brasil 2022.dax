/*
@pasta: T15 Minha cidade\Contas
@formato: 0.0%
@descricao: Margem de Lula no Brasil em 2022, resultado oficial com o exterior (igual às telas 01 e 12).
@oraculo: paginas[14] › anos (2022 +5,2; 2026 −1,9)
@gerado: pbi/scripts/desenho_t15.py
*/
DIVIDE (
    CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Candidato ano'[Ano] = 2022, 'Candidato ano'[Partido] = "PT" )
        - CALCULATE ( MAX ( 'Candidato ano'[Votos] ), 'Candidato ano'[Ano] = 2022, 'Candidato ano'[Partido] <> "PT" ),
    CALCULATE ( MAX ( 'Candidato ano'[ValidosAno] ), 'Candidato ano'[Ano] = 2022 )
)
