/*
@pasta: T15 Minha cidade\Contas
@formato: #,0
@descricao: Válidos na eleição escolhida (2026 sem clique), no município.
@gerado: pbi/scripts/desenho_t15.py
*/
IF ( [Eleição · pós] = 1, VAR _a = [T15 · ano escolhido]
RETURN
    CALCULATE ( SUM ( 'Município segundo turno'[Validos] ), 'Ano'[Ano] = _a ), VAR _a = [T15 · ano escolhido]
RETURN
    CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Ano'[Ano] = _a ) )
