/*
@pasta: T15 Minha cidade\Contas
@formato: #,0
@descricao: Votos do adversário principal na eleição escolhida menos os do adversário na anterior, no município.
@oraculo: mockup/data/eleicoes.json › paginas[15] › cidade_guia (Contagem) › votos › variacao_pl_txt = +6.957
@gerado: pbi/scripts/desenho_t15.py
*/
VAR _ant = [T15 · votos do adversário no ano anterior]
RETURN
    IF ( NOT ISBLANK ( _ant ), [T15 · votos do adversário no ano escolhido] - _ant )
