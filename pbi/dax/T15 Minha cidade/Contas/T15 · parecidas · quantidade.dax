/*
@pasta: T15 Minha cidade\Contas
@formato: #,0
@descricao: Cidades com o mesmo porte e o mesmo quinto de renda da escolhida (Brasil).
@oraculo: mockup/data/eleicoes.json › paginas[15] › cidade_guia (Contagem) › entre_parecidas › municipios = 78
@gerado: pbi/scripts/desenho_t15.py
*/
VAR _p = SELECTEDVALUE ( 'Município'[Porte] )
VAR _q = SELECTEDVALUE ( 'Município'[Quinto de renda] )
RETURN
    IF (
        NOT ISBLANK ( _p ) && NOT ISBLANK ( _q ),
        CALCULATE (
            COUNTROWS ( 'Município' ),
            REMOVEFILTERS ( 'Município' ),
            REMOVEFILTERS ( 'UF' ),
            'Município'[Porte] = _p,
            'Município'[Quinto de renda] = _q
        )
    )
