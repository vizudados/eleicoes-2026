/*
@pasta: T15 Minha cidade\Contas
@formato: 0.0%
@descricao: Variação da margem do PT da eleição anterior para a escolhida (sem clique, 2022 → 2026), somando os votos do contexto; vazia em 2006.
@oraculo: mockup/data/eleicoes.json › paginas[15] › cidade_guia (Contagem) › variacao_txt = −5,4 p.p.
@gerado: pbi/scripts/desenho_t15.py
*/
VAR _ant = [T15 · margem no ano anterior]
RETURN
    IF ( NOT ISBLANK ( _ant ), [T15 · margem no ano escolhido] - _ant )
