/*
@pasta: T15 Minha cidade\Desenho
@formato: texto
@descricao: Texto alternativo do filtro de município (o VizuFilter, com o gatilho dele; sem pílula desde 24/10/2026).
@gerado: pbi/scripts/desenho_t15.py
*/
-- 1 · Leituras
VAR _cid = [T15 · nome e UF da cidade]
-- 2 · Textos
RETURN
    IF ( ISBLANK ( _cid ), "Filtro de município: nenhuma cidade escolhida", "Filtro de município: " & _cid )
