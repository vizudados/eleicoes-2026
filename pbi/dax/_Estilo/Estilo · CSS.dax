*/
"@font-face{font-family:'Sora Eleicoes';font-style:normal;font-weight:300 800;font-display:block;src:url(data:font/woff2;base64,"
    & ""
    & ""
    & ""
    & ""
    & ""
    & ") format('woff2')}@font-face{font-family:'Caveat Eleicoes';font-style:normal;font-weight:400 700;font-display:block;src:url(data:font/woff2;base64,"
    & ""
    & ""
    & ""
    & ""
    & ""
    & ") format('woff2')}@font-face{font-family:'Sora Setas';font-style:normal;font-weight:300 550;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}@font-face{font-family:'Sora Setas';font-style:normal;font-weight:551 800;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}:root{--papel:#F1EBDF;--creme:#E5DBC8;--areia:#CBBDA2;--tinta:#1C1915;--grafite:#48423A;--cinza:#6B6357;--vermelho:#B8322A;--vermelho-escuro:#8E2620;--rosa:#D9877B;--azul:#2B5797;--azul-escuro:#1D3C6E;--azul-claro:#8FA8CF;--marrom:#7A5A43;--branco:#FBF8F2;--fonte:'Sora Eleicoes','Sora Setas','Segoe UI',sans-serif;--mao:'Caveat Eleicoes','Sora Setas','Segoe Print',cursive}html,body{margin:0;padding:0;background:transparent;overflow:hidden}body,#htmlViewer,#htmlContent{font-family:var(--fonte);color:var(--tinta);-webkit-font-smoothing:antialiased;font-feature-settings:'kern' 1,'lnum' 1;text-rendering:geometricPrecision}.tela{position:fixed;inset:0;will-change:transform}*{box-sizing:border-box}svg{overflow:visible}.tnum{font-variant-numeric:tabular-nums lining-nums}.sob{font-size:15px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--grafite)}.tit{font-size:30px;font-weight:600;letter-spacing:-.012em;line-height:1.18}.man{font-size:24px;font-weight:600;letter-spacing:-.01em;line-height:1.25}.txt{font-size:17px;font-weight:400;line-height:1.45;color:var(--grafite)}.rot{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--cinza)}.nota{font-size:13px;font-weight:400;color:var(--cinza);line-height:1.4}.num{font-weight:700;letter-spacing:-.025em;line-height:1;font-variant-numeric:tabular-nums lining-nums}.mao{font-family:var(--mao);font-size:26px;font-weight:600;line-height:1.05}.lula{color:var(--vermelho)}.flavio{color:var(--azul)}.lula-esc{color:var(--vermelho-escuro)}.flavio-esc{color:var(--azul-escuro)}.escuro{color:var(--creme)}.escuro .sob,.escuro .rot,.escuro .nota{color:var(--areia)}.escuro .txt{color:var(--creme)}@keyfr"
    & "ames uSobe{from{opacity:0;transform:translateY(14px)}}@keyframes uEntra{from{opacity:0}}@keyframes uCresceX{from{transform:scaleX(0)}}@keyframes uCresceY{from{transform:scaleY(0)}}@keyframes eTraco{from{stroke-dashoffset:1}}@keyframes eCor{from{fill:var(--creme);fill-opacity:.35}}@keyframes eCorEsc{from{fill:var(--tinta);fill-opacity:.2}}@keyframes eEscala{from{opacity:0;transform:scale(.4)}}.sobe{animation:uSobe .7s cubic-bezier(.2,.7,.2,1) both}.entra{animation:uEntra .8s ease-out both}.barra-x{transform-origin:left center;animation:uCresceX 1s cubic-bezier(.2,.7,.2,1) .3s both}.barra-x-dir{transform-origin:right center;animation:uCresceX 1s cubic-bezier(.2,.7,.2,1) .3s both}.barra-y{transform-origin:center bottom;animation:uCresceY 1s cubic-bezier(.2,.7,.2,1) .3s both}.traco{stroke-dasharray:1;stroke-dashoffset:0;animation:eTraco 1.8s cubic-bezier(.45,.05,.3,1) both}.traco-rapido{stroke-dasharray:1;stroke-dashoffset:0;animation:eTraco .9s cubic-bezier(.45,.05,.3,1) both}.cor{animation:eCor 1.4s ease-out 1.2s both}.cor-esc{animation:eCorEsc 1.4s ease-out 1.2s both}.esmaece{animation:uEntra 1.2s ease-out .9s both}.brota{transform-box:fill-box;transform-origin:center;animation:eEscala .6s cubic-bezier(.2,.9,.3,1.3) both}.d1{animation-delay:80ms!important}.d2{animation-delay:160ms!important}.d3{animation-delay:240ms!important}.d4{animation-delay:320ms!important}.d5{animation-delay:400ms!important}.d6{animation-delay:480ms!important}.d7{animation-delay:560ms!important}.d8{animation-delay:640ms!important}.d9{animation-delay:720ms!important}.d10{animation-delay:800ms!important}.d11{animation-delay:880ms!important}.d12{animation-delay:960ms!important}.d13{animation-delay:1040ms!important}.d14{animation-delay:1120ms!important}.d15{animation-delay:1200ms!important}.d16{animation-delay:1280ms!important}.realce>*{transition:opacity .18s ease}.realce:has(>:hover)>:not(:hover){opacity:.42}@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}"
