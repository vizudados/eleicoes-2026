/*
@pasta: T12 Estados\Contas
@formato: #,0
@descricao: Votos de Jair Bolsonaro (PL, 22) em 2022 no recorte de UF.
@gerado: pbi/scripts/desenho_t12.py
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'UF segundo turno'[VotosAdversario] ), 'UF segundo turno'[Ano] = 2022 ), CALCULATE (
    SUM ( 'Candidato UF'[Votos] ),
    'Candidato UF'[Ano] = 2022,
    'Candidato UF'[Número] = 22
) )
