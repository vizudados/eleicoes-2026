/*
@pasta: T12 Estados\Contas
@formato: 0
@descricao: UFs (sem o exterior) em que a margem de Lula caiu de 2022 para 2026.
@oraculo: mockup/data/eleicoes.json › paginas[12] › 26
@gerado: pbi/scripts/desenho_t12.py
*/
CALCULATE (
    COUNTROWS ( FILTER ( VALUES ( 'UF'[UF] ), [T12 · variação] < 0 ) ),
    REMOVEFILTERS ( 'UF' ),
    'UF'[Tipo] = "UF"
) + 0
