/*
@pasta: T20 Escola\Contas
@formato: texto
@descricao: Código IBGE da cidade da tela: a cidade das escolas marcadas no filtro (uma cidade por vez, pelo exclusiveRoots do VizuFilter; marcar a cidade marca todas as escolas dela); sem escolha, o Rio de Janeiro (3304557), onde a tela abre.
@oraculo: 3304557 sem filtro
*/
VAR _codigos = VALUES ( 'T20 Filtro'[CodIBGE] )
RETURN
    IF (
        ISFILTERED ( 'T20 Filtro' ) && COUNTROWS ( _codigos ) = 1,
        MAXX ( _codigos, 'T20 Filtro'[CodIBGE] ),
        "3304557"
    )
