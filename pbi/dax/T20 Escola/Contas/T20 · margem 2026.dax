/*
@pasta: T20 Escola\Contas
@formato: 0.0%
@descricao: Margem do PT no local em 2026: (votos do PT − votos do adversário) ÷ válidos; em 2022 e 2018, os votos do mesmo zona + número. Vazio quando o local não existia.
@oraculo: mockup/data/eleicoes.json › Escola › maiores_quedas[].serie
*/
IF ( [Eleição · pós] = 1,
DIVIDE ( [T20 · VotosPT 2026] - [T20 · VotosAdv 2026], [T20 · Validos 2026] ),
DIVIDE (
    SUM ( 'T20 Local'[VotosPT2026] ) - SUM ( 'T20 Local'[VotosAdv2026] ),
    SUM ( 'T20 Local'[Validos2026] )
)
)
