/*
@pasta: T20 Escola\Contas
@formato: 0
@descricao: Posição do local entre os da lista das maiores quedas (1 = maior queda).
@oraculo: mockup/data/eleicoes.json › Escola › maiores_quedas (ordem)
*/
IF (
    HASONEVALUE ( 'T20 Local'[Local] ),
    RANKX ( ALLSELECTED ( 'T20 Local'[Local] ), [T20 · queda da margem], , DESC, SKIP )
)
