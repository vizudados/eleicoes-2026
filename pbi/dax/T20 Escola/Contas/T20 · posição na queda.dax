/*
@pasta: T20 Escola\Contas
@formato: 0
@descricao: Posição do local entre os da lista das maiores quedas (1 = maior queda). O Power BI põe a coluna de ordenação ('T20 Local'[Id]) no grão do visual: o RANKX percorre as duas colunas, senão cada linha só vê a si mesma e todas saem 1 (L-armadilha da coluna de ordenação, como na tela 13).
@oraculo: mockup/data/eleicoes.json › Escola › maiores_quedas (ordem)
*/
IF (
    HASONEVALUE ( 'T20 Local'[Local] ),
    RANKX ( ALLSELECTED ( 'T20 Local'[Local], 'T20 Local'[Id] ), [T20 · queda da margem], , DESC, SKIP )
)
