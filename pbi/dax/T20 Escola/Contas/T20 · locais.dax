/*
@pasta: T20 Escola\Contas
@formato: #,0
@descricao: Locais de votação da cidade da tela em 2026 (112 em Contagem).
@oraculo: mockup/data/eleicoes.json › Escola › locais_2026 (112)
*/
IF ( [Eleição · pós] = 1,
VAR _cod = [T20 · cidade (código)]
RETURN CALCULATE ( COUNTROWS ( FILTER ( 'T20 Zona turno', TRUE () ) ),
    'T20 Zona turno'[Ano] = 2026, 'T20 Zona turno'[Turno] = 2, 'T20 Zona turno'[CodIBGE] = _cod ) + 0,
VAR _cod = [T20 · cidade (código)]
RETURN
    COALESCE (
        CALCULATE ( COUNTROWS ( 'T20 Local' ), REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[CodIBGE] = _cod ),
        0
    )
)
