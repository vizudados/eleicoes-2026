/*
@pasta: T20 Escola\Contas
@formato: 0.0%
@descricao: Quanto a margem do PT no local mudou de 2022 para 2026 (pontos); vazio sem 2022.
@oraculo: mockup/data/eleicoes.json › Escola › maiores_quedas[].variacao_txt
*/
VAR _m22 = [T20 · margem 2022]
VAR _m26 = [T20 · margem 2026]
RETURN
    IF ( NOT ISBLANK ( _m22 ) && NOT ISBLANK ( _m26 ), _m26 - _m22 )
