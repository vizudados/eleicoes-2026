/*
@pasta: T20 Escola\Contas
@formato: #,0
@descricao: Locais de votação de Contagem em 2022, como o TSE os listou naquele ano (zona, número e nome; a Local Contagem traz o 1350 da zona 91 em dobro, por isso a contagem é de distintos).
@oraculo: 111 (dados/saida/locais_contagem.csv, 2022)
*/
COALESCE (
    COUNTROWS (
        SUMMARIZE (
            FILTER ( 'Local Contagem', 'Local Contagem'[Ano] = 2022 ),
            'Local Contagem'[Zona], 'Local Contagem'[Local], 'Local Contagem'[Nome do local]
        )
    ),
    0
)
