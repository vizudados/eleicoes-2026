/*
@pasta: T20 Escola\Contas
@formato: texto
@descricao: Nome do local da ficha (Id escolhido).
@oraculo: mockup/data/eleicoes.json › Escola › exemplo_tooltip (Escola Estadual Nova Contagem-I sem escolha)
*/
VAR _id = [T20 · id escolhido]
RETURN
    CALCULATE ( SELECTEDVALUE ( 'T20 Local'[Nome] ), REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
