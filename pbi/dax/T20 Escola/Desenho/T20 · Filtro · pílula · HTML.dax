/*
@pasta: T20 Escola\Desenho
@formato: texto
@descricao: O botão fechado do filtro da tela (a pílula, na caixa do filtro da casca): a cidade em uso ('Contagem (MG)' sem escolha); com uma escola marcada, ' · escola'; com várias da mesma cidade (não todas), ' · N escolas'; com o funil (ponto vermelho quando o filtro está em uso) e a seta. O clique abre o VizuFilter alto por cima (marcador T20_FILTRO_ABRE_01). Recebe só o filtro (o clique no mapa e na lista não mexe nela).
*/
-- 1 · Leituras
VAR _uso = [T20 · filtro em uso]
VAR _escola = [T20 · escola do filtro]
VAR _marcadas = [T20 · escolas no filtro]
VAR _locais = [T20 · locais]
VAR _id = _escola
VAR _nomeEscolaL = IF ( NOT ISBLANK ( _escola ), CALCULATE ( [T20 · nome do local], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id ) )
-- 2 · Textos
VAR _cidade0 = [T20 · cidade]
VAR _cidade1 = SUBSTITUTE ( SUBSTITUTE ( _cidade0, "&", "&amp;" ), "<", "&lt;" )
VAR _cidade = SUBSTITUTE ( SUBSTITUTE ( _cidade1, ">", "&gt;" ), "'", "&#39;" )
VAR _nomeEscola0 = _nomeEscolaL
VAR _nomeEscola1 = SUBSTITUTE ( SUBSTITUTE ( _nomeEscola0, "&", "&amp;" ), "<", "&lt;" )
VAR _nomeEscola = SUBSTITUTE ( SUBSTITUTE ( _nomeEscola1, ">", "&gt;" ), "'", "&#39;" )
VAR _txt =
    _cidade
        & SWITCH (
            TRUE (),
            NOT ISBLANK ( _escola ), " · " & _nomeEscola,
            _marcadas > 1 && _marcadas < _locais, " · " & FORMAT ( _marcadas, "#,0" ) & " escolas",
            ""
        )
-- 4 · Marcação
RETURN
    "<div class='tela pl" & IF ( _uso = 1, " ativo", "" ) & "'><span class='fu'><svg width='16' height='16' "
        & "viewBox='0 0 16 16'><path d='M2 3h12l-4.6 5.4V13l-2.8-1.4V8.4z' fill='none' stroke='currentColor' "
        & "stroke-width='1.4' stroke-linejoin='round'/></svg><i></i></span><b>" & _txt & "</b>"
        & "<svg class='sv' width='12' height='12' viewBox='0 0 12 12'><path d='M3 4.5l3 3 3-3' fill='none' "
        & "stroke='currentColor' stroke-width='1.4' stroke-linecap='round'/></svg></div>"
