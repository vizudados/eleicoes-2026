/*
@pasta: T20 Escola\Desenho
@formato: texto
@descricao: A camada atrás dos pontos: o contorno da cidade escolhida (rabisco que se desenha, o creme esmaece), o mapinha da cidade inteira quando o mapa é um recorte e o anel à mão em volta do local da ficha (recebe a escolha do filtro, do mapa e da lista); o nome vai ao lado só quando a escola veio de um clique (com clique, os outros pontos esmaecem e o nome aparece; sem clique, o nome vai na camada da frente, em T20 · Mapa · HTML).
*/
-- 1 · Leituras
VAR _contorno = [T20 · cidade · contorno]
VAR _recorte = [T20 · cidade · recorte]
VAR _mapinha = [T20 · cidade · mapinha]
VAR _moldura = SUBSTITUTE ( [T20 · cidade · moldura do mapinha], " ", "|" )
VAR _canto = [T20 · cidade · canto do mapinha]
VAR _id = [T20 · id escolhido]
VAR _px = CALCULATE ( [T20 · posição x], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
VAR _py = CALCULATE ( [T20 · posição y], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
VAR _fora = CALCULATE ( [T20 · fora do mapa], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id )
VAR _clique = NOT ISBLANK ( [T20 · escola clicada] )
-- 2 · Textos
VAR _nome0 = [T20 · local escolhido]
VAR _nome1 = SUBSTITUTE ( SUBSTITUTE ( _nome0, "&", "&amp;" ), "<", "&lt;" )
VAR _nome = SUBSTITUTE ( SUBSTITUTE ( _nome1, ">", "&gt;" ), "'", "&#39;" )
VAR _motivo = IF ( _fora = "fora do recorte", ": fora do recorte do mapa", ": sem endereço no mapa" )
-- 3 · Geometria
VAR _x = _px / 100 * 692 -- geometria
VAR _y = _py / 100 * 860 -- geometria
VAR _direita = _x > 692 * 0.62 -- geometria
VAR _xr = IF ( _direita, _x - 22, _x + 22 ) -- geometria
VAR _mx = IF ( _canto = "so" || _canto = "no", 10, 550 ) -- geometria
VAR _my = IF ( _canto = "no" || _canto = "ne", 10, 682 ) -- geometria
-- 4 · Marcação
VAR _mapa =
    "<svg class='mapa" & IF ( _recorte = 1, " rec", "" ) & "' width='692' height='860' viewBox='0 0 100 100' "
        & "preserveAspectRatio='none'>"
        & "<path class='fundo' d='" & _contorno & "'/>"
        & "<path class='borda traco' pathLength='1' filter='url(#rb20)' d='" & _contorno & "'/>"
        & IF ( _recorte = 1, "<rect class='quadro' x='0' y='0' width='100' height='100'/>" )
    & "</svg>"
VAR _mini =
    IF (
        _recorte = 1,
        "<div class='mini entra d8' style='left:" & _mx & "px;top:" & _my & "px'>"
            & "<svg width='132' height='132' viewBox='0 0 100 100'><path class='mf' d='" & _mapinha & "'/>"
            & "<rect class='mr' x='" & PATHITEM ( _moldura, 1 ) & "' y='" & PATHITEM ( _moldura, 2 ) & "' width='"
            & PATHITEM ( _moldura, 3 ) & "' height='" & PATHITEM ( _moldura, 4 ) & "'/></svg>"
            & "<span>a cidade inteira</span>"
        & "</div>"
    )
VAR _anel =
    IF (
        ISBLANK ( _px ),
        "<div class='sem'>" & _nome & _motivo & "</div>",
        "<div class='anel' style='left:" & FORMAT ( _x - 26, "0.0##", "en-US" ) & "px;top:"
            & FORMAT ( _y - 24, "0.0##", "en-US" ) & "px'>"
            & "<svg width='52' height='48' viewBox='0 0 52 48'><path class='traco' pathLength='1' filter='url(#rbe)' "
            & "d='M8,28 C2,10 30,-2 44,10 C54,20 46,42 26,44 C8,46 2,30 12,16 C18,8 30,6 38,9'/></svg></div>"
            & IF (
                _clique,
                "<div class='nome sobe d4" & IF ( _direita, " dir", "" ) & "' style='left:"
                    & FORMAT ( _xr, "0.0##", "en-US" ) & "px;top:" & FORMAT ( _y - 12, "0.0##", "en-US" ) & "px'>"
                    & _nome & "</div>"
            )
    )
RETURN
    "<div class='tela t20e'>" & _mapa & _mini & _anel & "</div>"
