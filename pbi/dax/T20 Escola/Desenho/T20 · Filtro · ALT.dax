/*
@pasta: T20 Escola\Desenho
@formato: texto
@descricao: Texto alternativo do filtro da tela (o VizuFilter em árvore, com o gatilho dele; sem pílula desde 24/10/2026): a cidade e a escola em uso.
*/
-- 1 · Leituras
VAR _escola = [T20 · escola do filtro]
VAR _marcadas = [T20 · escolas no filtro]
VAR _locais = [T20 · locais]
VAR _id = _escola
RETURN
    "Filtro de cidade e zona: " & [T20 · cidade]
        & SWITCH (
            TRUE (),
            NOT ISBLANK ( _escola ), " · " & CALCULATE ( [T20 · nome do local], REMOVEFILTERS ( 'T20 Local' ), 'T20 Local'[Id] = _id ),
            _marcadas > 1 && _marcadas < _locais, " · " & FORMAT ( _marcadas, "#,0" ) & " zonas marcadas",
            " (nenhuma zona escolhida)"
        )
