/*
@pasta: T09 Redes\Contas
@formato: dd/MM
@descricao: Último dia da janela de seguidores ganhos da Bites (16/08 a 03/10, campanha do 1º turno).
*/
CALCULATE ( MAX ( Monitoramento[Fim] ), REMOVEFILTERS ( Monitoramento ), Monitoramento[Métrica] = "seguidores ganhos - total 4 redes", Monitoramento[Início] = DATE ( 2026, 8, 16 ) )
