/*
@pasta: T09 Redes\Contas
@formato: #,0
@descricao: Reais gastos em anúncios pela página de Flávio na Meta (Facebook e Instagram), 2026-07-22 a 2026-10-19 (90 dias), segundo o Relatório da Biblioteca de Anúncios. Não se soma aos pagamentos declarados ao TSE (outra base).
@oraculo: R$ 8,04 mi
*/
CALCULATE (
    SUM ( 'Anúncios'[Valor] ),
    REMOVEFILTERS ( 'Anúncios' ),
    'Anúncios'[Anunciante] = "Flávio Bolsonaro (página 'Flavio Bolsonaro', rótulo da campanha)",
    'Anúncios'[Plataforma] = "Meta (Facebook/Instagram)",
    'Anúncios'[Período] = "2026-07-22 a 2026-10-19 (90 dias)"
)
