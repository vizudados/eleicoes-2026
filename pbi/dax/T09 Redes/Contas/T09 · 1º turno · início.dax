/*
@pasta: T09 Redes\Contas
@formato: dd/MM
@descricao: Primeiro dia da janela de interações da Bites na campanha do 1º turno, 16/08 a 04/10.
*/
CALCULATE ( MIN ( Monitoramento[Início] ), REMOVEFILTERS ( Monitoramento ), Monitoramento[Métrica] = "interações nos perfis oficiais (X, Instagram, Facebook, TikTok, YouTube)", Monitoramento[Início] = DATE ( 2026, 8, 16 ) )
