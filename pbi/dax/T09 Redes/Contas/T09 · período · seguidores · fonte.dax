/*
@pasta: T09 Redes\Contas
@formato: texto
@descricao: Quem mediu a janela de seguidores ganhos do período (a primeira palavra do estudo: Bites, Quaest…). Só entra a janela que cabe inteira dentro do período escolhido (o dia do debate conta como depois); entre as que cabem, a mais longa (no empate, a mais recente). Vazio sem período ou sem janela que caiba.
@oraculo: Antes da Band Bites; Depois da Band Quaest
*/
VAR _ini = [Período · início]
VAR _fim = [Período · fim]
VAR _jan =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                SUMMARIZE ( Monitoramento, Monitoramento[Estudo], Monitoramento[Métrica], Monitoramento[Início], Monitoramento[Fim] ),
                REMOVEFILTERS ( Monitoramento ),
                CONTAINSSTRING ( Monitoramento[Métrica], "seguidores ganhos" ),
                NOT CONTAINSSTRING ( Monitoramento[Métrica], " - " ),
                Monitoramento[Unidade] = "seguidores",
                Monitoramento[Início] >= _ini,
                Monitoramento[Fim] <= _fim
            ),
            "@dois",
                CALCULATE (
                    DISTINCTCOUNT ( Monitoramento[Candidato] ),
                    REMOVEFILTERS ( Monitoramento[Candidato] ),
                    Monitoramento[Candidato] IN { "Lula", "Flávio Bolsonaro" },
                    NOT ISBLANK ( Monitoramento[Valor] )
                ),
            "@dur", DATEDIFF ( Monitoramento[Início], Monitoramento[Fim], DAY )
        ),
        [@dois] = 2
    )
VAR _top = TOPN ( 1, _jan, [@dur], DESC, Monitoramento[Início], DESC )
RETURN
    IF ( NOT ISBLANK ( _ini ), MAXX ( _top, LEFT ( Monitoramento[Estudo], FIND ( " ", Monitoramento[Estudo] & " " ) - 1 ) ) )
