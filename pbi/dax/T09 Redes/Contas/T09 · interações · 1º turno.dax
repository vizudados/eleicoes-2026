/*
@pasta: T09 Redes\Contas
@formato: #,0
@descricao: Interações nos perfis oficiais (X, Instagram, Facebook, TikTok, YouTube) na campanha do 1º turno, 16/08 a 04/10, segundo a Bites; no contexto do candidato (Monitoramento[Candidato]).
*/
CALCULATE (
    SUM ( Monitoramento[Valor] ),
    Monitoramento[Métrica] = "interações nos perfis oficiais (X, Instagram, Facebook, TikTok, YouTube)",
    Monitoramento[Início] = DATE ( 2026, 8, 16 )
)
