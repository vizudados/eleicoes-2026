/*
@pasta: T09 Redes\Contas
@formato: #,0
@descricao: Seguidores do candidato (Monitoramento[Candidato]) na rede (Seguidores[Plataforma]) na contagem mais recente: Social Blade em 22 e 23/10; X pela Datrix em 19/10.
@oraculo: Instagram 18,57 × 15,37 mi; TikTok 6,2 × 2,5; YouTube 2,43 × 1,57; Facebook 7,28 × 4,81; X 10,79 × 3,8
*/
VAR _cand = SELECTEDVALUE ( Monitoramento[Candidato] )
VAR _d = [T09 · seguidores hoje · data]
RETURN
    CALCULATE (
        MAX ( Seguidores[Seguidores] ),
        Seguidores[Candidato] = _cand,
        Seguidores[Data] = _d
    )
