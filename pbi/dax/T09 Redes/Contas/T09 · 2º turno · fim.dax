/*
@pasta: T09 Redes\Contas
@formato: dd/MM
@descricao: Último dia da janela de interações da Bites na 2º turno, 05 a 17/10.
*/
CALCULATE ( MAX ( Monitoramento[Fim] ), REMOVEFILTERS ( Monitoramento ), Monitoramento[Métrica] = "interações nos perfis oficiais (X, Instagram, Facebook, TikTok, YouTube)", Monitoramento[Início] = DATE ( 2026, 10, 5 ) )
