/*
@pasta: T09 Redes\Contas
@formato: #,0
@descricao: Seguidores ganhos de 16/08 a 03/10 numa rede (a de Seguidores[Plataforma] no contexto), pelo candidato de Monitoramento[Candidato] (Bites).
*/
VAR _rede = SELECTEDVALUE ( Seguidores[Plataforma] )
RETURN
    IF (
        NOT ISBLANK ( _rede ),
        CALCULATE (
            SUM ( Monitoramento[Valor] ),
            Monitoramento[Métrica] = "seguidores ganhos - " & _rede,
            Monitoramento[Início] = DATE ( 2026, 8, 16 )
        )
    )
