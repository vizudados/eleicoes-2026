/*
@pasta: T09 Redes\Contas
@formato: 0
@descricao: Menções negativas sobre o total de Flávio nas redes nas 24 h depois do debate (FGV/EAESP, dados Brandwatch), em %.
*/
CALCULATE (
    MAX ( Monitoramento[Valor] ),
    REMOVEFILTERS ( Monitoramento ),
    Monitoramento[Métrica] = "menções negativas (sobre o total)",
    Monitoramento[Candidato] = "Flávio Bolsonaro",
    Monitoramento[Início] = DATE ( 2026, 10, 18 )
)
