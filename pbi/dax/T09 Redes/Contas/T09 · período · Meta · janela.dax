/*
@pasta: T09 Redes\Contas
@formato: texto
@descricao: O texto da janela da Biblioteca de Anúncios que cabe no período (como está na base: '2026-10-19 (1 dia)'). Só entra a janela que cabe inteira dentro do período escolhido (o dia do debate conta como depois); entre as que cabem, a mais longa (no empate, a mais recente). Vazio sem período ou sem janela que caiba.
*/
VAR _ini = [Período · início]
VAR _fim = [Período · fim]
VAR _jan =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                VALUES ( 'Anúncios'[Período] ),
                REMOVEFILTERS ( 'Anúncios' ),
                'Anúncios'[Plataforma] = "Meta (Facebook/Instagram)"
            ),
            "@i",
                VAR _t = 'Anúncios'[Período]
                RETURN
                    IF (
                        MID ( _t, 5, 1 ) = "-" && MID ( _t, 8, 1 ) = "-",
                        DATE ( VALUE ( LEFT ( _t, 4 ) ), VALUE ( MID ( _t, 6, 2 ) ), VALUE ( MID ( _t, 9, 2 ) ) )
                    ),
            "@f",
                VAR _t = 'Anúncios'[Período]
                RETURN
                    SWITCH (
                        TRUE (),
                        MID ( _t, 12, 2 ) = "a " && MID ( _t, 18, 1 ) = "-",
                            DATE ( VALUE ( MID ( _t, 14, 4 ) ), VALUE ( MID ( _t, 19, 2 ) ), VALUE ( MID ( _t, 22, 2 ) ) ),
                        MID ( _t, 5, 1 ) = "-" && MID ( _t, 8, 1 ) = "-",
                            DATE ( VALUE ( LEFT ( _t, 4 ) ), VALUE ( MID ( _t, 6, 2 ) ), VALUE ( MID ( _t, 9, 2 ) ) )
                    )
        ),
        NOT ISBLANK ( [@i] ) && [@i] >= _ini && [@f] <= _fim
    )
VAR _top = TOPN ( 1, _jan, [@f] - [@i], DESC, [@i], DESC )
RETURN
    IF ( NOT ISBLANK ( _ini ), MAXX ( _top, 'Anúncios'[Período] ) )
