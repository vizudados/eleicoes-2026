/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Uma entrada por candidato: ganho e gasto com alvos de hover independentes; preserva filtro cruzado e ausência distinta de zero.
*/
-- 1 · Leituras
VAR _c = [T09 · lado · candidato]
VAR _base = [T09 · lado · nome completo]
VAR _foco = [T09 · foco]
VAR _s = CALCULATE ( [T09 · lado · ganho], Monitoramento[Candidato] = _base )
VAR _max = [T09 · lado · ganho maior]
VAR _meta = CALCULATE ( [T09 · lado · Meta], Monitoramento[Candidato] = _base )
-- 2 · Textos
VAR _cls = IF ( _c = "Lula", "l", "f" )
VAR _txt = IF ( _c = "Lula", "lula-esc", "flavio-esc" )
VAR _apaga = IF ( NOT ISBLANK ( _foco ) && _foco <> _base, " apaga", "" )
VAR _ganho = IF ( _s >= 1000000, "+" & FORMAT ( _s / 1000000, "0.00" ) & " mi", "+" & FORMAT ( _s / 1000, "0" ) & " mil" )
-- 3 · Geometria
VAR _y = IF ( _c = "Lula", 130, 220 ) -- geometria
VAR _ym = IF ( _c = "Lula", 382, 440 ) -- geometria
VAR _w = DIVIDE ( _s, _max ) * 290 -- geometria
-- 4 · Marcação
RETURN
    IF ( NOT ISBLANK ( _c ) && ( NOT ISBLANK ( _s ) || NOT ISBLANK ( _meta ) ),
        "<div class='tela t09r" & _apaga & "'>"
        & IF ( NOT ISBLANK ( _s ),
            "<div class='alvo' style='left:0;top:" & _y - 8 & "px;width:522px;height:88px'></div>"
            & "<div class='nome " & _txt & " sobe d4' style='left:0;top:" & _y & "px'>" & _c & "</div>"
            & "<div class='barra " & _cls & " barra-x' style='left:0;top:" & _y + 36 & "px;width:" & FORMAT ( _w, "0.0", "en-US" ) & "px'></div>"
            & "<div class='num grande " & _txt & " entra d8' style='left:" & FORMAT ( _w + 16, "0.0", "en-US" )
            & "px;top:" & _y + 22 & "px'>" & _ganho & "</div>" )
        & IF ( NOT ISBLANK ( _meta ),
            "<div class='alvo' style='left:0;top:" & _ym - 6 & "px;width:522px;height:44px'></div>"
            & "<div class='nome " & _txt & " sobe d10' style='left:0;top:" & _ym + 4 & "px'>" & _c & "</div>"
            & "<div class='num " & _txt & " entra d11' style='left:150px;top:" & _ym & "px'>R$ " & FORMAT ( _meta / 1000000, "0.00" ) & " mi</div>" )
        & "</div>" )
