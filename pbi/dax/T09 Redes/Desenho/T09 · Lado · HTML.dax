/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Dois apoios na mesma coluna: seguidores ganhos e reais em anúncios, cada um com janela e fornecedor; ausência avaliada separadamente por bloco.
*/
-- 1 · Leituras
VAR _per = [Período · escolhido]
VAR _i = [T09 · período · seguidores · início]
VAR _f = [T09 · período · seguidores · fim]
VAR _fonte = [T09 · período · seguidores · fonte]
VAR _metrica = [T09 · período · seguidores · métrica]
VAR _mi = [T09 · período · Meta · início]
VAR _mf = [T09 · período · Meta · fim]
-- 2 · Textos
VAR _tem = ISBLANK ( _per ) || NOT ISBLANK ( _i )
VAR _temMeta = ISBLANK ( _per ) || NOT ISBLANK ( _mi )
VAR _jan = IF ( ISBLANK ( _per ), "24/10 · só Instagram · Quaest",
    IF ( _tem, FORMAT ( _i, "dd/MM" ) & IF ( _i <> _f, " a " & FORMAT ( _f, "dd/MM" ) ) & " · " & _fonte
        & IF ( CONTAINSSTRING ( _metrica, "Instagram" ), " · só Instagram", " · redes não detalhadas" ),
        "Nenhuma janela de ganho dos dois cabe inteira nesses dias." ) )
VAR _janMeta = IF ( ISBLANK ( _per ), "18 a 24/10 · páginas oficiais · Biblioteca da Meta",
    IF ( _temMeta, FORMAT ( _mi, "dd/MM" ) & IF ( _mi <> _mf, " a " & FORMAT ( _mf, "dd/MM" ) ) & " · Biblioteca da Meta",
        "A semana 18–24/10 atravessa o período; não foi repartida." ) )
-- 4 · Marcação
RETURN
    "<div class='tela t09l'><div class='bloco' style='top:0'>"
        & "<div class='sob sobe'>Seguidores ganhos</div><div class='man sobe d2'>"
        & IF ( ISBLANK ( _per ), "O Instagram na véspera da votação", [Período · nome] ) & "</div>"
        & "<div class='nota sobe d3'>" & _jan & "</div></div>"
        & IF ( NOT _tem, "<div class='vazio entra d6'><span class='rot'>sem dado no período</span></div>" )
        & "<hr class='entra d8'/><div class='bloco' style='top:322px'>"
        & "<div class='sob sobe d8'>Anúncios veiculados · reais</div><div class='txt sobe d9'>" & _janMeta & "</div></div>"
        & IF ( NOT _temMeta, "<div class='sem-meta nota entra d10'>Sem janela completa publicada para este período.</div>" )
        & "<div class='ress entra d14'>Ganhos e totais de seguidores são medidas diferentes. Biblioteca da Meta e pagamentos ao TSE não se somam; detalhes no dossiê de cada nome.</div>"
    & "</div>"
