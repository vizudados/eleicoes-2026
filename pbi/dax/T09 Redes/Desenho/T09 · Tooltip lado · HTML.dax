/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Dossiê por candidato: estoques e ganhos históricos de seguidores, em réguas separadas; Biblioteca da Meta em 90 dias e 18–24/10 com quantidade de anúncios; TSE como outra base. Com período, a semana dá lugar somente à janela que cabe inteira.
*/
-- 1 · Leituras
VAR _c = [T09 · lado · candidato]
VAR _cBase = [T09 · lado · nome completo]
VAR _redes =
    DATATABLE (
        "Ordem", INTEGER, "Rede", STRING,
        { { 1, "Instagram" }, { 2, "Facebook" }, { 3, "TikTok" }, { 4, "YouTube" }, { 5, "X" } }
    )
VAR _lista =
    ADDCOLUMNS (
        _redes,
        "@g",
            VAR _r = [Rede]
            RETURN
                CALCULATE ( [T09 · seguidores ganhos · rede], Seguidores[Plataforma] = _r, Monitoramento[Candidato] = _cBase ),
        "@h",
            VAR _r = [Rede]
            RETURN
                CALCULATE ( [T09 · seguidores hoje · rede], Seguidores[Plataforma] = _r, Monitoramento[Candidato] = _cBase )
    )
VAR _bites2 = CALCULATE ( [T09 · seguidores ganhos · 2º turno Bites], Monitoramento[Candidato] = _cBase )
VAR _datrix2 = CALCULATE ( [T09 · seguidores ganhos · 2º turno Datrix], Monitoramento[Candidato] = _cBase )
VAR _a90 = CALCULATE ( [T09 · Meta · 90 dias], Monitoramento[Candidato] = _cBase )
VAR _a7 = CALCULATE ( [T09 · reta final · Meta], Monitoramento[Candidato] = _cBase )
VAR _qtd = CALCULATE ( [T09 · reta final · anúncios], Monitoramento[Candidato] = _cBase )
VAR _tse = CALCULATE ( [T09 · TSE · pagamentos à Meta], Monitoramento[Candidato] = _cBase )
VAR _per = [Período · escolhido]
VAR _aP = CALCULATE ( [T09 · período · Meta], Monitoramento[Candidato] = _cBase )
VAR _aI = [T09 · período · Meta · início]
VAR _aF = [T09 · período · Meta · fim]
-- 2 · Textos
VAR _clsTxt = IF ( _c = "Lula", "lula-esc", "flavio-esc" )
VAR _linhas =
    CONCATENATEX (
        _lista,
        "<div class='r'>" & [Rede] & "</div><div class='v'>"
            & IF ( ISBLANK ( [@g] ), "—", "+" & FORMAT ( [@g] / 1000000, "0.00" ) & " mi" ) & "</div><div class='v " & _clsTxt & "'>"
            & IF ( ISBLANK ( [@h] ), "—", FORMAT ( [@h] / 1000000, "0.00" ) & " mi" ) & "</div>",
        "",
        [Ordem], ASC
    )
VAR _txt2 =
    "Janelas diferentes do 2º turno: a Bites dá +" & FORMAT ( _bites2 / 1000000, "0.0" ) & " mi de 05 a 17/10; a Datrix, +"
        & FORMAT ( _datrix2 / 1000000, "0.0" ) & " mi de 03 a 19/10, com o X e sem o TikTok."
VAR _txtA90 = "R$ " & FORMAT ( _a90 / 1000000, "0.00" ) & " mi"
VAR _txtA7 = "R$ " & FORMAT ( _a7, "#,0" )
VAR _txtTse = "R$ " & FORMAT ( _tse / 1000000, "0.00" ) & " mi"
VAR _txtAP = "R$ " & FORMAT ( _aP / 1000000, "0.00" ) & " mi"
VAR _janA =
    IF ( _aI = _aF, FORMAT ( _aI, "dd/MM" ), FORMAT ( _aI, "dd" ) & " a " & FORMAT ( _aF, "dd/MM" ) )
        & ", " & ( DATEDIFF ( _aI, _aF, DAY ) + 1 ) & IF ( _aI = _aF, " dia", " dias" )
VAR _linhaA2 =
    SWITCH (
        TRUE (),
        ISBLANK ( _per ),
            "<div class='ad sobe d4'><b class='" & _clsTxt & "'>" & _txtA7 & "</b><span>em 18 a 24/10 · <em class='num' style='font-size:20px;font-style:normal'>" & FORMAT ( _qtd, "#,0" ) & "</em> anúncios</span></div>",
        NOT ISBLANK ( _aP ),
            "<div class='ad sobe d4'><b class='" & _clsTxt & "'>" & _txtAP & "</b><span>" & [Período · nome] & " ("
                & _janA & ")</span></div>",
        "<div class='ad sobe d4'><b class='vazio'>sem dado no período</b><span>" & [Período · nome]
            & ": não há janela completa da Biblioteca nesses dias; 18–24/10 atravessa o período</span></div>"
    )
-- 4 · Marcação
RETURN
    IF (
        NOT ISBLANK ( _c ),
        "<div class='tt9l'>"
            & "<div class='col'>"
                & "<div class='sob sobe'>" & _c & " · seguidores rede a rede</div>"
        & "<div class='tab sobe d2'><div></div><div class='h'>ganhou de<br>16/08 a 03/10</div><div class='h'>tinha<br>na consulta</div>"
                & _linhas & "</div>"
        & "<div class='nota sobe d3'>Ganho: Bites. Total na consulta: Social Blade (22 e 23/10); X: Datrix (19/10).</div>"
                & "<div class='txt sobe d4'>" & _txt2 & "</div>"
                & "<div class='nota entra d8'>Ganho diário de Instagram em 24/10: Quaest, outra régua; não somar à Bites nem à Datrix.</div>"
            & "</div>"
            & "<div class='col'>"
                & "<div class='sob sobe d2'>Anúncios na Meta</div>"
                & "<div class='ad sobe d3'><b class='" & _clsTxt & "'>" & _txtA90 & "</b><span>em 90 dias (22/07 a 19/10)</span></div>"
                & _linhaA2
                & "<div class='nota sobe d4'>Página do candidato · Biblioteca de Anúncios</div>"
                & "<div class='outra sobe d5'><div class='rot'>Outra base · não se soma</div>"
                & "Pagamentos à Meta declarados ao TSE até cerca de 20/10: <b>" & _txtTse & "</b>. Medem o que a campanha pagou, "
                & "não o que a página veiculou.</div>"
            & "</div>"
        & "</div>"
    )
