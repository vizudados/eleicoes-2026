/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Texto para leitor de tela dos balões (um par por candidato; com período, a janela da direita é a do período).
*/
VAR _per = [Período · escolhido]
VAR _pL = [T09 · período · interações · Lula]
VAR _pF = [T09 · período · interações · Flávio]
RETURN
    IF (
        ISBLANK ( _per ),
        "Campanha do 1º turno: Lula " & FORMAT ( [T09 · interações · 1º turno · Lula] / 1000000, "0.0" ) & " mi e Flávio "
            & FORMAT ( [T09 · interações · 1º turno · Flávio] / 1000000, "0.0" ) & " mi de interações. 2º turno: Lula "
            & FORMAT ( [T09 · interações · 2º turno · Lula] / 1000000, "0.0" ) & " mi e Flávio "
            & FORMAT ( [T09 · interações · 2º turno · Flávio] / 1000000, "0.0" ) & " mi.",
        "Campanha do 1º turno: Lula " & FORMAT ( [T09 · interações · 1º turno · Lula] / 1000000, "0.0" ) & " mi e Flávio "
            & FORMAT ( [T09 · interações · 1º turno · Flávio] / 1000000, "0.0" ) & " mi de interações. " & [Período · rótulo] & ": "
            & IF (
                ISBLANK ( _pL ) || ISBLANK ( _pF ),
                IF ( _per = 4, "ainda sem números.", "sem dado no período." ),
                "Lula " & FORMAT ( _pL / 1000000, "0.0" ) & " mi e Flávio " & FORMAT ( _pF / 1000000, "0.0" ) & " mi."
            )
    )
