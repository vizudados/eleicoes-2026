/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Valores dos quatro balões vindos das contas, com régua e janela.
*/
VAR _per = [Período · escolhido]
VAR _a = CALCULATE ( [T09 · conversa · esquerda], Monitoramento[Candidato] = "Lula" )
VAR _b = CALCULATE ( [T09 · conversa · esquerda], Monitoramento[Candidato] = "Flávio Bolsonaro" )
VAR _c = [T09 · herói · Lula]
VAR _d = [T09 · herói · Flávio]
RETURN
    IF ( ISBLANK ( _per ), "05–17/10: ", "Referência 16/08–04/10: " )
        & "Lula " & FORMAT ( _a / 1000000, "0.0" ) & " mi; Flávio " & FORMAT ( _b / 1000000, "0.0" ) & " mi. "
        & IF ( ISBLANK ( _c ) || ISBLANK ( _d ), "Sem janela Bites inteira no período.",
            IF ( ISBLANK ( _per ), "19–24/10 parcial: ", "Janela do período: " ) & "Lula " & FORMAT ( _c / 1000000, "0.0" )
            & " mi; Flávio " & FORMAT ( _d / 1000000, "0.0" ) & " mi." )
