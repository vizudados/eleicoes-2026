/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Fundo das duas janelas Bites: 05–17 e 19–24 parcial sem filtro; referência da campanha com filtro. Ressalvas de janela, dia 18 ausente e ausência pós-eleição discretas.
*/
-- 1 · Leituras
VAR _per = [Período · escolhido]
VAR _pNome = [Período · nome]
VAR _i = [T09 · período · interações · início]
VAR _f = [T09 · período · interações · fim]
VAR _m = [T09 · período · interações · métrica]
VAR _a = [T09 · 2º turno · início]
VAR _b = [T09 · 2º turno · fim]
VAR _c = [T09 · reta final · início]
VAR _d = [T09 · reta final · fim]
VAR _refI = [T09 · 1º turno · início]
VAR _refF = [T09 · 1º turno · fim]
-- 2 · Textos
VAR _sem = NOT ISBLANK ( _per ) && ISBLANK ( _i )
VAR _jan1 = IF ( ISBLANK ( _per ), "2º turno · " & FORMAT ( _a, "dd" ) & " a " & FORMAT ( _b, "dd/MM" ),
    "Referência · 1º turno · " & FORMAT ( _refI, "dd/MM" ) & " a " & FORMAT ( _refF, "dd/MM" ) )
VAR _jan2 = IF ( ISBLANK ( _per ), "Reta final · " & FORMAT ( _c, "dd" ) & " a " & FORMAT ( _d, "dd/MM" ) & " · parcial",
    _pNome & IF ( NOT _sem, " · " & IF ( CONTAINSSTRING ( _m, "24h" ), "24 h · " & FORMAT ( _i, "dd" ) & " a " & FORMAT ( _f, "dd/MM" ), FORMAT ( _i, "dd/MM" ) & " a " & FORMAT ( _f, "dd/MM" ) ) ) )
-- 4 · Marcação
RETURN
    "<div class='tela t09c'>"
        & "<div class='sob sobe'>Interações nos perfis oficiais · cinco redes · Bites</div>"
        & "<div class='man sobe d2'>" & IF ( ISBLANK ( _per ), "Duas janelas publicadas, sem somar os totais",
            "A janela publicada dentro do período, com referência do 1º turno" ) & "</div>"
        & "<div class='jan sob sobe d3' style='left:0'>" & _jan1 & "</div>"
        & "<div class='jan sob sobe d4' style='left:560px'>" & _jan2 & "</div>"
        & "<svg width='1040' height='530' viewBox='0 0 1040 530'>"
            & "<path d='M10 410 H500' pathLength='1' class='chao traco' filter='url(#rbu)'/>"
            & "<path d='M560 410 H1030' pathLength='1' class='chao traco' filter='url(#rbu)' style='animation-delay:.3s'/>"
            & "<line x1='530' x2='530' y1='104' y2='480' class='div'/>"
        & "</svg>"
        & IF ( _sem, "<div class='vazio entra d6'><span class='rot'>sem janela completa</span>"
            & "<span class='nota'>A Bites mediu 19–24/10, com o último dia parcial. Essa janela atravessa os períodos; não há divisão diária publicada.</span></div>" )
        & "<div class='nota entra d12'>Área do balão = total da janela; durações diferentes. "
            & IF ( ISBLANK ( _per ), "O dia 18/10 fica fora; 24/10 é parcial.", "A referência fica à esquerda; o recorte escolhido, à direita." ) & "</div>"
        & "<div class='pos nota entra d12'>Após a eleição (25/10), nenhuma medição publicada até 26/10.</div>"
    & "</div>"
