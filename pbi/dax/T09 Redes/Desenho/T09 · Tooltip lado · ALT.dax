/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Texto para leitor de tela do dossiê de seguidores e anúncios (grão Monitoramento[Candidato]).
*/
IF (
    NOT ISBLANK ( [T09 · candidato] ),
    [T09 · candidato] & ": seguidores rede a rede; anúncios da página na Meta, R$ " & FORMAT ( [T09 · Meta · 90 dias] / 1000000, "0.00" )
        & " mi em 90 dias; e, em outra base, pagamentos à Meta declarados ao TSE, R$ " & FORMAT ( [T09 · TSE · pagamentos à Meta] / 1000000, "0.00" ) & " mi."
)
