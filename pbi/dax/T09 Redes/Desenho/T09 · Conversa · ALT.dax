/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Texto para leitor de tela do fundo do protagonista (as duas janelas; com período, a da direita é a do período).
*/
VAR _per = [Período · escolhido]
VAR _pD = [T09 · período · interações · dias]
VAR _p24 = CONTAINSSTRING ( [T09 · período · interações · métrica], "24h" )
RETURN
    IF (
        ISBLANK ( _per ),
        "Interações nos perfis oficiais em duas janelas da Bites: a campanha do 1º turno (" & [T09 · 1º turno · dias] & " dias) e o 2º turno ("
            & [T09 · 2º turno · dias] & " dias). O tamanho de cada balão é a média de interações por dia.",
        "Interações nos perfis oficiais em duas janelas da Bites: a campanha do 1º turno (" & [T09 · 1º turno · dias]
            & " dias) e " & [Período · rótulo]
            & IF (
                ISBLANK ( _pD ),
                IF ( _per = 4, ", ainda sem números.", ", sem dado no período." ),
                " (" & IF ( _p24, "24 h após o debate", _pD & " dias" ) & "). O tamanho de cada balão é a média por dia."
            )
    )
