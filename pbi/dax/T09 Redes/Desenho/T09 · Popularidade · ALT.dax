/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Texto para leitor de tela do gráfico do índice de popularidade digital; com período, o último dia dele com o índice dos dois, ou 'sem dado no período'.
*/
VAR _per = [Período · escolhido]
VAR _pDia = [T09 · período · IPD · dia]
RETURN
    IF (
        ISBLANK ( _per ),
        "Índice de popularidade digital da Quaest, de 0 a 100: em " & FORMAT ( [T09 · IPD · primeiro dia], "dd/MM" ) & ", Flávio "
            & FORMAT ( [T09 · IPD · Flávio · início], "0.0" ) & " e Lula " & FORMAT ( [T09 · IPD · Lula · início], "0.0" ) & "; em "
            & FORMAT ( [T09 · IPD · último dia], "dd/MM" ) & ", Lula " & FORMAT ( [T09 · IPD · Lula · fim], "0.0" ) & " e Flávio "
            & FORMAT ( [T09 · IPD · Flávio · fim], "0.0" ) & ". Mede popularidade nas redes, não voto.",
        "Índice de popularidade digital da Quaest, " & [Período · rótulo] & ": "
            & IF (
                ISBLANK ( _pDia ),
                IF ( _per = 4, "o índice não consta do levantamento.", "sem dado no período." ),
                "em " & FORMAT ( _pDia, "dd/MM" ) & ", Lula " & FORMAT ( [T09 · período · IPD · Lula], "0.0" )
                    & " e Flávio " & FORMAT ( [T09 · período · IPD · Flávio], "0.0" ) & ". Mede popularidade, não voto."
            )
    )
