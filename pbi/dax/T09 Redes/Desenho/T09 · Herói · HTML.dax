/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Herói da última janela Bites; sem janela completa no período, responde pelo índice Quaest disponível. Números vindos de contas e contador automático.
*/
-- 1 · Leituras
VAR _per = [Período · escolhido]
VAR _l = [T09 · herói · Lula]
VAR _f = [T09 · herói · Flávio]
VAR _vezes = [T09 · herói · vezes]
VAR _dif = [T09 · herói · diferença IPD]
VAR _man = [T09 · herói · manchete]
VAR _i = IF ( ISBLANK ( _per ), [T09 · reta final · início], [T09 · período · interações · início] )
VAR _fim = IF ( ISBLANK ( _per ), [T09 · reta final · fim], [T09 · período · interações · fim] )
VAR _ipDia = [T09 · período · IPD · dia]
VAR _p24 = CONTAINSSTRING ( [T09 · período · interações · métrica], "24h" )
-- 2 · Textos
VAR _temI = NOT ISBLANK ( _l ) && NOT ISBLANK ( _f )
VAR _quem = IF ( _l >= _f, "Lula", "Flávio" )
VAR _outro = IF ( _l >= _f, "Flávio", "Lula" )
VAR _sob = IF ( _temI, "Interações · Bites · " & FORMAT ( _i, "dd/MM" ) & " a " & FORMAT ( _fim, "dd/MM" )
    & IF ( ISBLANK ( _per ), " · 24/10 parcial", IF ( _p24, " · janela de 24 h", "" ) ),
    "Popularidade digital · Quaest · " & FORMAT ( _ipDia, "dd/MM" ) )
VAR _lado = IF ( _temI, _quem & " em relação a " & _outro & ", na mesma janela",
    IF ( NOT ISBLANK ( _dif ), "de distância no índice de 0 a 100", "sem janela completa publicada" ) )
VAR _txt = IF ( _temI,
    IF ( ISBLANK ( _per ), "Última janela publicada; não é o total do turno. ", "Só a janela inteira dentro do período. " )
        & "Interação é uma reação à publicação: curtida, comentário ou compartilhamento.",
    "A janela Bites de 19–24/10 atravessa os períodos e não foi repartida. O índice mede popularidade digital, não voto." )
-- 4 · Marcação
RETURN
    "<div class='tela t09a'><div class='sob sobe'>" & _sob & "</div>"
        & "<div class='linha'><div class='hero sobe d1'>"
        & IF ( _temI, "<span class='num'>" & FORMAT ( _vezes, "0.0" ) & "</span><span class='u'>vezes</span>",
            IF ( NOT ISBLANK ( _dif ), "<span class='num'>" & FORMAT ( _dif, "0.0" ) & "</span><span class='u'>pontos</span>",
                "<span class='vazio'>sem dado</span>" ) )
        & "</div><div class='lado sobe d3'>" & _lado & "</div></div>"
        & "<div class='man sobe d4'>" & _man & "</div><div class='txt sobe d5'>" & _txt & "</div>"
    & "</div>"
