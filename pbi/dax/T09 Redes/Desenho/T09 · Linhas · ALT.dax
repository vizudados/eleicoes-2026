/*
@pasta: T09 Redes\Desenho
@formato: texto
@descricao: Valores acessíveis por candidato, com ausência explícita.
*/
VAR _c = [T09 · lado · candidato]
VAR _base = [T09 · lado · nome completo]
VAR _g = CALCULATE ( [T09 · lado · ganho], Monitoramento[Candidato] = _base )
VAR _m = CALCULATE ( [T09 · lado · Meta], Monitoramento[Candidato] = _base )
RETURN
    IF ( NOT ISBLANK ( _c ), _c & ": "
        & IF ( ISBLANK ( _g ), "sem ganho publicado no período", "+" & FORMAT ( _g, "#,0" ) & " seguidores na janela indicada" )
        & "; " & IF ( ISBLANK ( _m ), "sem janela completa da Meta.", "R$ " & FORMAT ( _m, "#,0" ) & " na Biblioteca da Meta, na janela indicada." ) )
