/*
@pasta: T17 2º turno\Contas
@formato: 0
@descricao: Pesquisas de 2º turno (votos totais) com o campo só em parte dentro da janela do período escolhido (não cabem inteiras) e que não atravessam o debate: ficam fora do período. Vazio sem período.
@oraculo: Antes da Band 1 (AtlasIntel 03 a 08/10); Depois da Band 4; Antes da Globo 4; Depois da Globo 0
*/
VAR _de = [T17 · período · campo de]
VAR _ate = [T17 · período · campo até]
VAR _deb = [Período · debate · data]
RETURN
    IF (
        NOT ISBLANK ( _de ),
        CALCULATE (
            COUNTROWS ( Pesquisa ),
            REMOVEFILTERS ( Pesquisa ),
            Pesquisa[Cenário] = "2º turno",
            Pesquisa[Tipo] = "totais",
            NOT ISBLANK ( Pesquisa[Lula] ),
            NOT ISBLANK ( Pesquisa[Flavio] ),
            Pesquisa[Campo início] <= _ate,
            Pesquisa[Campo fim] >= _de,
            FILTER (
                ALL ( Pesquisa[Campo início], Pesquisa[Campo fim] ),
                NOT ( Pesquisa[Campo início] >= _de && Pesquisa[Campo fim] <= _ate )
                    && NOT ( Pesquisa[Campo início] <= _deb && Pesquisa[Campo fim] >= _deb )
            )
        ) + 0
    )
