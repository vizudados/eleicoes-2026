/*
@pasta: T17 2º turno\Contas
@formato: +0.0;-0.0;0.0
@descricao: Flávio − Lula, em pontos, da pesquisa anterior do mesmo instituto (T17 · série · Id anterior): a ponta de onde sai o traço da série; vazio na primeira dele.
*/
VAR _ant = [T17 · série · Id anterior]
RETURN
    IF (
        NOT ISBLANK ( _ant ),
        CALCULATE ( [T17 · pesquisa · diferença], REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _ant )
    )
