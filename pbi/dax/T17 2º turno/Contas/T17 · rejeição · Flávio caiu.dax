/*
@pasta: T17 2º turno\Contas
@formato: 0
@descricao: Entre os institutos comparáveis, em quantos a rejeição de Flávio caiu da última medição antes do 1º turno para a última depois.
@oraculo: 6 (PoderData, Quaest, Nexus, MDA, Palver, Ideia)
*/
CALCULATE (
    VAR _inst =
        ADDCOLUMNS (
            VALUES ( 'Rejeição'[Instituto] ),
            "@ok", [T17 · rejeição · comparável],
            "@al", [T17 · rejeição · antes · Lula],
            "@af", [T17 · rejeição · antes · Flávio],
            "@dl", [T17 · rejeição · depois · Lula],
            "@df", [T17 · rejeição · depois · Flávio]
        )
    VAR _comp = FILTER ( _inst, [@ok] = "Sim" )
    RETURN
        COUNTROWS ( FILTER ( _comp, [@df] < [@af] ) ),
    REMOVEFILTERS ( 'Rejeição' )
) + 0
