/*
@pasta: T17 2º turno\Contas
@formato: 0
@descricao: Quantas pesquisas de 2º turno feitas depois do 1º turno (votos totais).
@oraculo: segundo_turno.depois.pesquisas = 39
*/
CALCULATE (
    COUNTROWS ( Pesquisa ),
    REMOVEFILTERS ( Pesquisa ),
    Pesquisa[Cenário] = "2º turno",
    Pesquisa[Tipo] = "totais",
    NOT ISBLANK ( Pesquisa[Lula] ),
    NOT ISBLANK ( Pesquisa[Flavio] ),
    Pesquisa[Momento] = "apos_1turno"
) + 0
