/*
@pasta: T17 2º turno\Contas
@formato: 0.0
@descricao: Rejeição (%) de Lula no instituto e no dia de divulgação do contexto (a série do instituto no dossiê). Regra das linhas: eleitorado total; sem a rejeição exclusiva do Datafolha (fica 'não votará de jeito nenhum'); na Ideia, a escala 'poderia votar' (a mesma antes e depois), sem a linha de resposta múltipla.
*/
CALCULATE (
    AVERAGE ( 'Rejeição'[Rejeicao] ),
    'Rejeição'[Segmento] = "total",
    'Rejeição'[Candidato] = "Lula",
    NOT CONTAINSSTRING ( 'Rejeição'[Observação], "rejeicao_exclusiva" ),
    NOT CONTAINSSTRING ( 'Rejeição'[Observação], "mesma pergunta de resposta múltipla" )
)
