/*
@pasta: T17 2º turno\Contas
@formato: 0
@descricao: Quantos institutos mediram a rejeição de Lula e Flávio antes e depois do 1º turno com pergunta comparável.
@oraculo: FONTES.md: PoderData, Quaest, Nexus, MDA, Palver, Futura, Gerp, Datafolha, Ideia, Indexa = 10
*/
CALCULATE (
    VAR _inst =
        ADDCOLUMNS (
            VALUES ( 'Rejeição'[Instituto] ),
            "@ok", [T17 · rejeição · comparável],
            "@al", [T17 · rejeição · antes · Lula],
            "@af", [T17 · rejeição · antes · Flávio],
            "@dl", [T17 · rejeição · depois · Lula],
            "@df", [T17 · rejeição · depois · Flávio]
        )
    VAR _comp = FILTER ( _inst, [@ok] = "Sim" )
    RETURN
        COUNTROWS ( _comp ),
    REMOVEFILTERS ( 'Rejeição' )
) + 0
