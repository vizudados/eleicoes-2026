/*
@pasta: T17 2º turno\Contas
@formato: +0.0;-0.0;0.0
@descricao: Média de Flávio − Lula (pontos entre os dois candidatos, normalizados para 100) nas pesquisas do período escolhido (positivo = Flávio à frente).
*/
VAR _de = [T17 · período · campo de]
VAR _ate = [T17 · período · campo até]
RETURN
    IF (
        NOT ISBLANK ( _de ),
        CALCULATE (
            AVERAGEX ( Pesquisa, DIVIDE ( Pesquisa[Flavio] - Pesquisa[Lula], Pesquisa[Flavio] + Pesquisa[Lula] ) * 100 ),
            REMOVEFILTERS ( Pesquisa ),
            Pesquisa[Cenário] = "2º turno",
            Pesquisa[Tipo] = "totais",
            NOT ISBLANK ( Pesquisa[Lula] ),
            NOT ISBLANK ( Pesquisa[Flavio] ),
            Pesquisa[Campo início] >= _de,
            Pesquisa[Campo fim] <= _ate
        )
    )
