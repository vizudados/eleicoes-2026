/*
@pasta: T17 2º turno\Contas
@formato: 0
@descricao: 1 quando o período escolhido começa depois da última divulgação do levantamento (22/10) e não tem pesquisa: os números não constam do levantamento (Depois da Globo); 0 nos outros; vazio sem período.
@oraculo: Depois da Globo 1; os outros 0
*/
VAR _de = [T17 · período · campo de]
VAR _ult = [T17 · média móvel · último dia]
RETURN
    IF (
        NOT ISBLANK ( _de ),
        IF ( _de > _ult && [T17 · período · pesquisas] = 0, 1, 0 )
    )
