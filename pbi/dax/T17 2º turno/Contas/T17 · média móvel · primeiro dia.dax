/*
@pasta: T17 2º turno\Contas
@formato: dd/MM
@descricao: Primeiro dia de divulgação em que a média móvel existe (3 pesquisas na janela).
@oraculo: media_movel[0].data = 05/08
*/
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( Pesquisa[Divulgação] ),
            REMOVEFILTERS ( Pesquisa ),
            Pesquisa[Cenário] = "2º turno",
            Pesquisa[Tipo] = "totais",
            NOT ISBLANK ( Pesquisa[Lula] ),
            NOT ISBLANK ( Pesquisa[Flavio] )
        ),
        "@mm", [T17 · média móvel]
    )
RETURN
    MINX ( FILTER ( _dias, NOT ISBLANK ( [@mm] ) ), Pesquisa[Divulgação] )
