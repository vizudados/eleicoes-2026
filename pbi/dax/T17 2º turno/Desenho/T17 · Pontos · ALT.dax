/*
@pasta: T17 2º turno\Desenho
@formato: texto
@descricao: Texto para leitor de tela dos pontos das pesquisas do 2º turno; com um período escolhido, quantas estão em destaque (ou que nenhuma, ou que ainda não chegaram).
*/
VAR _nP = [T17 · período · pesquisas]
RETURN
    IF (
        ISBLANK ( [Período · escolhido] ),
        "Um ponto por pesquisa do 2º turno (" & [T17 · pesquisas]
            & "): acima da linha, Flávio à frente; abaixo, Lula. Vazado: simulação antes do 1º turno. Passe o mouse para ver o instituto; clique para acender a série dele.",
        "Um ponto por pesquisa do 2º turno (" & [T17 · pesquisas] & "). " & [Período · nome] & ": "
            & SWITCH (
                TRUE (),
                [T17 · período · ainda sem dado] = 1, "as pesquisas ainda não chegaram",
                _nP = 0, "nenhuma com o campo inteiro no período",
                _nP & " em destaque, com o campo inteiro no período; as outras esmaecem"
            )
            & ". Acima da linha, Flávio à frente; abaixo, Lula."
    )
