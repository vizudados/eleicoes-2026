/*
@pasta: T17 2º turno\Desenho
@formato: texto
@descricao: Um ponto por pesquisa de 2º turno (grão Pesquisa[Id]) na escala do fundo (T17 · Curva · HTML): x no dia de divulgação, y na diferença Flávio − Lula. Azul = Flávio à frente, vermelho = Lula, cinza = empate; vazado = simulação feita antes do 1º turno. Alvo do dossiê ttT17Pesquisa; vazio fora do conjunto.
*/
-- 1 · Leituras
VAR _mom = [T17 · pesquisa · momento]
VAR _dif = [T17 · pesquisa · diferença]
VAR _dia = [T17 · pesquisa · divulgação]
VAR _ord = [T17 · pesquisa · ordem no dia]
VAR _n = [T17 · pesquisa · no mesmo dia]
-- 2 · Textos
VAR _cls =
    SWITCH ( TRUE (), _dif > 0, "f", _dif < 0, "l", "e" ) & IF ( _mom = "antes_1turno", " sim", "" )
-- 3 · Geometria (x: 01/08 a 27/10 em x 70–1440; y: −10 a +10 em y 360–20; o svg do fundo começa em y 72; ponto de 12 px)
VAR _dias = DATEDIFF ( DATE ( 2026, 8, 1 ), _dia, DAY )
VAR _x = 70 + _dias / 87 * 1370 + ( _ord - ( _n - 1 ) / 2 ) * 7 - 6 -- geometria
VAR _y = 72 + 190 - MAX ( MIN ( _dif, 10 ), -10 ) / 10 * 170 - 6 -- geometria
VAR _atraso = 500 + _dias * 22 + _ord * 25 -- geometria
-- 4 · Marcação
RETURN
    IF (
        NOT ISBLANK ( _mom ),
        "<div class='tela t17p'><i class='pt " & _cls & "' style='left:" & FORMAT ( _x, "0.0", "en-US" ) & "px;top:"
            & FORMAT ( _y, "0.0", "en-US" ) & "px;animation-delay:" & _atraso & "ms'></i></div>"
    )
