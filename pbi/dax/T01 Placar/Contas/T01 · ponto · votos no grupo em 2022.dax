/*
@pasta: T01 Placar\Contas
@formato: #,0
@descricao: Votos do partido do ponto (PT ou PL) em 2022, somados nos municípios do contexto (sem o exterior): a região ou o porte da linha do dossiê.
*/
IF ( [Eleição · pós] = 1, VAR _a = [T01 · ponto · ano]
VAR _n = [T01 · ponto · número]
RETURN
    SWITCH (
        _n,
        13, CALCULATE ( SUM ( 'Município segundo turno'[VotosPT] ), 'Município segundo turno'[Ano] = 2022 ),
        22, CALCULATE ( SUM ( 'Município segundo turno'[VotosAdversario] ), 'Município segundo turno'[Ano] = 2022 )
    ), VAR _a = [T01 · ponto · ano]
VAR _n = [T01 · ponto · número]
RETURN
    SWITCH (
        _n,
        13, CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2022 ),
        22, CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2022 )
    ) )
