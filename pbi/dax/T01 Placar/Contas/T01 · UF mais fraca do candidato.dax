/*
@pasta: T01 Placar\Contas
@formato: texto
@descricao: UF onde o candidato do item teve a menor parcela dos válidos: entre as 27 (sem escolha ou com um estado só) ou entre as UFs do recorte (região ou vários estados).
@oraculo: Pré: Flávio: Piauí 24,1%
*/
VAR _noRecorte = [T01 · dossiê no recorte]
VAR _sel = CALCULATETABLE ( VALUES ( 'UF'[UF] ), 'UF'[Tipo] = "UF" )
VAR _todas =
    CALCULATETABLE (
        ADDCOLUMNS ( SUMMARIZE ( 'UF', 'UF'[UF], 'UF'[Nome] ), "@p", [T01 · % do candidato na UF] ),
        REMOVEFILTERS ( 'UF' ),
        'UF'[Tipo] = "UF"
    )
VAR _ufs = FILTER ( _todas, _noRecorte = 0 || 'UF'[UF] IN _sel )
RETURN
    MAXX ( TOPN ( 1, _ufs, [@p], ASC, 'UF'[Nome], ASC ), 'UF'[Nome] )
