/*
@pasta: T01 Placar\Contas
@formato: #,0
@descricao: Votos válidos do turno escolhido de 2026 no recorte (com o exterior no Brasil).
@oraculo: Pré: paginas[1].validos = 119.300.788
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'UF segundo turno'[Validos] ), 'UF segundo turno'[Ano] = 2026 ), CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026 ) )
