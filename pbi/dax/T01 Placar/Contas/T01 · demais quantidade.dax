/*
@pasta: T01 Placar\Contas
@formato: 0
@descricao: Quantos candidatos ficaram do 5º lugar em diante, no recorte.
@oraculo: Pré: paginas[1].demais.qtd = 8
*/
VAR _lista =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE ( VALUES ( 'Candidato UF'[Candidato] ), 'Candidato UF'[Ano] = 2026 ),
            "@v", [T01 · votos do candidato],
            "@p", [T01 · posição do candidato]
        ),
        [@p] >= 5 && [@v] > 0
    )
RETURN
    COUNTROWS ( _lista )
