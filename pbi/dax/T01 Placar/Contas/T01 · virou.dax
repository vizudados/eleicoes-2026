/*
@pasta: T01 Placar\Contas
@formato: 0
@descricao: 1 quando o mais votado entre PT e PL mudou de 2022 para 2026 no recorte (as linhas se cruzam).
*/
VAR _d22 = [T01 · PT 2022 votos] - [T01 · PL 2022 votos]
VAR _d26 = [T01 · Lula votos] - [T01 · Flávio votos]
RETURN
    IF ( SIGN ( _d22 ) <> SIGN ( _d26 ) && _d22 <> 0 && _d26 <> 0, 1, 0 )
