/*
@pasta: T01 Placar\Contas
@formato: 0
@descricao: 1 quando o recorte tem mais de uma UF (uma região inteira ou vários estados): o dossiê do candidato compara as UFs de dentro dele; 0 no Brasil e com um estado só (aí o dossiê compara as 27).
*/
IF ( [Recorte · com escolha] = 1 && [Recorte · UFs] > 1, 1, 0 )
