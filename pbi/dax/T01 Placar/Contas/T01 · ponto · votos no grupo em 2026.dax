/*
@pasta: T01 Placar\Contas
@formato: #,0
@descricao: Votos do partido do ponto (PT ou PL) em 2026, somados nos municípios do contexto (sem o exterior): a região ou o porte da linha do dossiê.
*/
VAR _a = [T01 · ponto · ano]
VAR _n = [T01 · ponto · número]
RETURN
    SWITCH (
        _n,
        13, CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2026 ),
        22, CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2026 )
    )
