/*
@pasta: T01 Placar\Contas
@formato: 0.0%
@descricao: Parcela do partido do ponto nos válidos de 2026 da região ou do porte da linha (0–1).
@oraculo: Pré: Lula 2026 › Nordeste 63,8% (paginas[3].regioes)
*/
IF ( [Eleição · pós] = 1, DIVIDE ( [T01 · ponto · votos no grupo em 2026], CALCULATE ( SUM ( 'Município segundo turno'[Validos] ), 'Município segundo turno'[Ano] = 2026 ) ), DIVIDE ( [T01 · ponto · votos no grupo em 2026], CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2026 ) ) )
