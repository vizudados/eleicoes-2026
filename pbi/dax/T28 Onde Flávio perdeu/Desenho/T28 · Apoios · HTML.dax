/*
@pasta: T28 Onde Flávio perdeu\Desenho
@formato: texto
@descricao: Regiões e portes na T27; estados e viradas na T28, com os mesmos saldos em votos.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
VAR _g0 = TOPN ( 2, ADDCOLUMNS ( VALUES ( 'UF'[Nome] ), "@v", [T28 · mudança de vantagem] ), [@v], DESC, 'UF'[Nome], ASC )
VAR _t0 = CONCATENATEX ( _g0,
    IF ( NOT ISBLANK ( [@v] ), "<div><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'UF'[Nome], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
    & "</span><b>" & (IF ( [@v] > 0, "+", IF ( [@v] < 0, "−", "" ) ) & (SWITCH ( TRUE (), ABS ( [@v] ) >= 1e6, FORMAT ( ABS ( [@v] ) / 1e6, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( ABS ( [@v] ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( [@v] ), "#,0" ) ))) & "</b></div>" ), "", [@v], DESC )
VAR _g1 = TOPN ( 2, ADDCOLUMNS ( VALUES ( 'Município'[Rótulo] ), "@v", [T28 · perda positiva para Jair] ), [@v], DESC, 'Município'[Rótulo], ASC )
VAR _t1 = CONCATENATEX ( _g1,
    IF ( NOT ISBLANK ( [@v] ), "<div><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'Município'[Rótulo], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
    & "</span><b>" & ("−" & (SWITCH ( TRUE (), ABS ( [@v] ) >= 1e6, FORMAT ( ABS ( [@v] ) / 1e6, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( ABS ( [@v] ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( [@v] ), "#,0" ) ))) & "</b></div>" ), "", [@v], DESC )
VAR _viradas = TOPN ( 2, ADDCOLUMNS ( VALUES ( 'UF'[Nome] ), "@v", [T28 · estado virou · mudança] ), [@v], DESC, 'UF'[Nome], ASC )
VAR _ufVirada = CONCATENATEX ( _viradas, IF ( NOT ISBLANK ( [@v] ), 'UF'[Nome] & " " ), "" )
RETURN "<div class='tela st-apoios'><div><div class='rot'>Estados · mudança em votos</div>" & _t0
     & "<div class='nota'>Virada para Lula: " & IF ( _ufVirada = "", "nenhum estado", _ufVirada ) & "</div>" & "</div><div><div class='rot'>Abaixo de Jair · perda em votos</div>" & IF ( _t1 = "", "<div>Nenhum no recorte</div>", _t1 ) & "</div></div>"
