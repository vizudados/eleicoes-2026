/*
@pasta: T28 Onde Flávio perdeu\Desenho
@formato: texto
@descricao: Leitura acessível do protagonista.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
IF ( [T28 · ponte · municipal] = 1 && [T28 · ponte · quantidade maiores] = 1,
    "A diferença andou " & FORMAT ( ABS ( [T28 · ponte · total] ), "#,0" ) & " votos para "
    & IF ( [T28 · ponte · total] >= 0, "Lula", "Flávio" ) & ". Ponte de três barras: primeiro turno, contribuição municipal e segundo turno.",
    "Ponte da diferença entre os turnos. As maiores contribuições somaram " & FORMAT ( [T28 · ponte · parcela três], "0.0%" )
    & ". Brasil inclui exterior; uma UF escolhida mostra seus municípios. Minas foi o único estado a trocar de vencedor." )
