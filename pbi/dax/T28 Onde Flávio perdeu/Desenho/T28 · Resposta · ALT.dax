/*
@pasta: T28 Onde Flávio perdeu\Desenho
@formato: texto
@descricao: Resposta acessível do recorte; valores em milhões.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
"A vantagem de Flávio " & IF ( [T28 · mudança de vantagem] >= 0, "diminuiu ", "aumentou " ) & (SWITCH ( TRUE (), ABS ( [T28 · mudança de vantagem] ) >= 1e6, FORMAT ( ABS ( [T28 · mudança de vantagem] ) / 1e6, "0.00" ) & " mi", ABS ( [T28 · mudança de vantagem] ) >= 1000, FORMAT ( ABS ( [T28 · mudança de vantagem] ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( [T28 · mudança de vantagem] ), "#,0" ) )) & IF ( ABS ( [T28 · mudança de vantagem] ) >= 1e6, " de votos", IF ( ABS ( [T28 · mudança de vantagem] ) = 1, " voto", " votos" ) ) & ". " & "Lula " & IF ( [T28 · ganho Lula] >= 0, "ganhou ", "perdeu " ) & ((SWITCH ( TRUE (), ABS ( [T28 · ganho Lula] ) >= 1e6, FORMAT ( ABS ( [T28 · ganho Lula] ) / 1e6, "0.00" ) & " mi", ABS ( [T28 · ganho Lula] ) >= 1000, FORMAT ( ABS ( [T28 · ganho Lula] ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( [T28 · ganho Lula] ), "#,0" ) )) & IF ( ABS ( [T28 · ganho Lula] ) >= 1e6, " de votos", IF ( ABS ( [T28 · ganho Lula] ) = 1, " voto", " votos" ) )) & "; Flávio " & IF ( [T28 · ganho Flávio] >= 0, "ganhou ", "perdeu " ) & ((SWITCH ( TRUE (), ABS ( [T28 · ganho Flávio] ) >= 1e6, FORMAT ( ABS ( [T28 · ganho Flávio] ) / 1e6, "0.00" ) & " mi", ABS ( [T28 · ganho Flávio] ) >= 1000, FORMAT ( ABS ( [T28 · ganho Flávio] ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( [T28 · ganho Flávio] ), "#,0" ) )) & IF ( ABS ( [T28 · ganho Flávio] ) >= 1e6, " de votos", IF ( ABS ( [T28 · ganho Flávio] ) = 1, " voto", " votos" ) )) & ". Perder vantagem não significa perder votos em termos absolutos."
