/*
@pasta: T28 Onde Flávio perdeu\Desenho
@formato: texto
@descricao: Fluxo em traço, mesmos volumes observados para os dois candidatos; não afirma transferência individual.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
-- 1 · Leituras e 3 · Geometria: espessura proporcional ao ganho absoluto
-- 4 · Marcação
VAR _html = "<div class='tela st-fluxo'><div class='rot antes'>1º TURNO</div><div class='rot depois'>2º TURNO</div>"
    & "<div class='candidato lula-esc' style='top:20px'>Lula</div>"
    & "<div class='origem num' style='top:40px'>" & FORMAT ( [T28 · Lula 1º], "#,0" ) & "</div>"
    & "<div class='destino num lula' style='top:40px'>" & FORMAT ( [T28 · Lula 2º], "#,0" ) & "</div>"
    & "<svg class='ponte' style='top:52px' width='300' height='45'>"
    & "<path d='M5 24 C70 8, 170 40, 286 20' pathLength='1' class='traco' fill='none' stroke='var(--vermelho)' stroke-width='"
    -- geometria
    & FORMAT ( 3 + 11 * DIVIDE ( ABS ( [T28 · ganho Lula] ), [T28 · fluxo · escala], 0 ), "0.0", "en-US" )
    & "' stroke-linecap='round' filter='url(#rb)'/></svg>"
    & "<div class='saldo num lula-esc' style='top:94px'>" & FORMAT ( [T28 · ganho Lula], "+#,0;-#,0;0" ) & IF ( ABS ( [T28 · ganho Lula] ) = 1, " voto", " votos" ) & "</div>"
    & "<div class='candidato flavio-esc' style='top:120px'>Flávio</div>"
    & "<div class='origem num' style='top:140px'>" & FORMAT ( [T28 · Flávio 1º], "#,0" ) & "</div>"
    & "<div class='destino num flavio' style='top:140px'>" & FORMAT ( [T28 · Flávio 2º], "#,0" ) & "</div>"
    & "<svg class='ponte' style='top:152px' width='300' height='45'>"
    & "<path d='M5 24 C70 8, 170 40, 286 20' pathLength='1' class='traco' fill='none' stroke='var(--azul)' stroke-width='"
    -- geometria
    & FORMAT ( 3 + 11 * DIVIDE ( ABS ( [T28 · ganho Flávio] ), [T28 · fluxo · escala], 0 ), "0.0", "en-US" )
    & "' stroke-linecap='round' filter='url(#rb)'/></svg>"
    & "<div class='saldo num flavio-esc' style='top:194px'>" & FORMAT ( [T28 · ganho Flávio], "+#,0;-#,0;0" ) & IF ( ABS ( [T28 · ganho Flávio] ) = 1, " voto", " votos" ) & "</div>"
    & "<div class='participacao'>Saldo de comparecimento: <b>" & FORMAT ( [T28 · saldo comparecimento], "+#,0;-#,0;0" )
    & "</b> · abstenções: <b>" & FORMAT ( [T28 · saldo abstenções], "+#,0;-#,0;0" ) & "</b></div>"
    & "<div class='resumo-viradas'><div class='rot'>ONDE O VENCEDOR MUDOU · MUNICÍPIOS · VITÓRIA ESTRITA</div>"
    & "<div class='viradas'><div><b class='num lula-esc'>" & FORMAT ( [T28 · virou para Lula · municípios], "#,0" )
    & "</b><span>Flávio → Lula</span></div><div><b class='num flavio-esc'>" & FORMAT ( [T28 · virou para Flávio · municípios], "#,0" )
    & "</b><span>Lula → Flávio</span></div><div><b class='num'>" & FORMAT ( [T28 · abaixo de Jair · municípios], "#,0" )
    & "</b><span>Flávio abaixo de Jair em 2022</span></div></div>"
    & "<div class='nota'>Empates não contam como virada. A comparação com Jair usa apenas municípios com base nos dois anos.</div></div>"
    & "</div>"
RETURN _html
