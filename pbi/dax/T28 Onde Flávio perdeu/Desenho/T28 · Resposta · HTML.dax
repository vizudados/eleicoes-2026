/*
@pasta: T28 Onde Flávio perdeu\Desenho
@formato: texto
@descricao: Manchete da ponte, com universo explícito e soma das três maiores contribuições.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
VAR _local = [T28 · ponte · municipal]
VAR _nomes = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [T28 · ponte · nomes três], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
VAR _p = [T28 · ponte · parcela três]
VAR _uma = _local = 1 && [T28 · ponte · quantidade maiores] = 1
VAR _movimento = [T28 · ponte · total]
VAR _fim = [T28 · ponte · fim]
VAR _chamadaLocal = IF ( [T28 · ponte · quantidade maiores] = 2, "As duas maiores contribuições somaram ", "As três maiores contribuições somaram " )
RETURN "<div class='tela perda-head'><div class='sob'>DO 1º PARA O 2º TURNO · "
    & IF ( [Recorte · com escolha] = 0, "BRASIL · COM EXTERIOR", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Recorte · nome], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · SEM EXTERIOR" )
    & "</div><div class='man'>" & IF ( _uma,
        IF ( SELECTEDVALUE ( 'UF'[UF] ) = "DF", "No DF, ", "Neste recorte, " ) & "a diferença andou <span class='num'>"
        & FORMAT ( ABS ( _movimento ), "#,0" ) & "</span> votos para " & IF ( _movimento >= 0, "Lula", "Flávio" ),
        IF ( _local = 1, _chamadaLocal, _nomes & " somaram " ) & "<span class='num'>" & FORMAT ( _p, "0.0%" )
        & "</span> " & IF ( [Recorte · com escolha] = 0, "da virada", "da mudança" ) ) & "</div><div class='txt'>"
    & IF ( _uma, IF ( _fim = 0, "O 2º turno terminou empatado neste recorte.",
        IF ( _fim < 0, "Flávio", "Lula" ) & " terminou o 2º turno à frente por " & FORMAT ( ABS ( _fim ), "#,0" ) & " votos." ),
        FORMAT ( [T28 · ponte · três maiores], "#,0" ) & " de " & FORMAT ( _movimento, "#,0" ) & " votos. "
        & IF ( _local = 1, "A ponte mostra os municípios " & [Recorte · de] & ".", "No país, Minas foi o único estado que trocou Flávio por Lula." ) )
    & "</div></div>"
