/*
@pasta: T28 Onde Flávio perdeu\Contas
@formato: #,0
@descricao: Votos de Lula no segundo turno de 2022, mesma regra de ausência usada para Jair.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
VAR _n = CALCULATE ( COUNTROWS ( 'Município segundo turno' ),
    REMOVEFILTERS ( 'Ano' ), 'Município segundo turno'[Ano] = 2022 )
RETURN IF ( _n > 0, CALCULATE ( SUM ( 'Município segundo turno'[VotosPT] ),
    REMOVEFILTERS ( 'Ano' ), 'Município segundo turno'[Ano] = 2022 ) )
