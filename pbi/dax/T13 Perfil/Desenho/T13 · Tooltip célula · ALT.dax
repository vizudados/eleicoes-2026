/*
@pasta: T13 Perfil\Desenho
@formato: texto
@descricao: Texto alternativo do dossiê da célula.
@gerado: pbi/scripts/desenho_t13.py
*/
-- 1 · Leituras
VAR _cp = [T13 · porte da célula]
VAR _cq = [T13 · quinto da célula]
VAR _n = [T13 · cidades]
VAR _vir = [T13 · cidades que viraram]
VAR _m22 = [T13 · margem 2022]
VAR _m26 = [T13 · margem 2026]
-- 2 · Textos
RETURN
    "Cidades " & _cp & " e " & _cq & ": " & FORMAT ( _n, "#,0" ) & IF ( _n = 1, " cidade", " cidades" )
        & "; a margem de Lula foi de " & FORMAT ( _m22 * 100, "+0.0;−0.0;0.0" ) & " para " & FORMAT ( _m26 * 100, "+0.0;−0.0;0.0" ) & " pontos; "
        & FORMAT ( _vir, "#,0" ) & IF ( _vir = 1, " trocou", " trocaram" ) & " Lula por Flávio."
