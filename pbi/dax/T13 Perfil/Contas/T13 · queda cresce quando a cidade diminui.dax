/*
@pasta: T13 Perfil\Contas
@formato: 0
@descricao: 1 se, de porte em porte (do maior ao menor), a queda da margem só aumenta; 0 se não.
@oraculo: mockup/data/eleicoes.json › paginas[13] › linhas −12,9 · −10,0 · −8,0 · −5,4 · −2,9
@gerado: pbi/scripts/desenho_t13.py
*/
VAR _r =
    ADDCOLUMNS (
        FILTER (
            SUMMARIZE ( 'Município', 'Município'[PorteOrdem], 'Município'[Porte] ),
            NOT ISBLANK ( 'Município'[PorteOrdem] )
        ),
        "@v", [T13 · variação]
    )
VAR _fora =
    FILTER (
        _r,
        VAR _o = 'Município'[PorteOrdem]
        VAR _v = [@v]
        VAR _maiorAcima = MINX ( FILTER ( _r, 'Município'[PorteOrdem] > _o ), [@v] )
        RETURN
            NOT ISBLANK ( _maiorAcima ) && _v > _maiorAcima
    )
RETURN
    IF ( COUNTROWS ( _r ) >= 3 && ISEMPTY ( _fora ), 1, 0 )
