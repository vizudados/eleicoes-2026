/*
@pasta: T13 Perfil\Contas
@formato: 0.0%
@descricao: A menor queda entre os cinco quintos de renda (o valor mais alto).
@oraculo: mockup/data/eleicoes.json › paginas[13] › colunas › mais ricas −6,3
@gerado: pbi/scripts/desenho_t13.py
*/
VAR _q =
    ADDCOLUMNS (
        FILTER ( SUMMARIZE ( 'Município', 'Município'[QuintoOrdem] ), NOT ISBLANK ( 'Município'[QuintoOrdem] ) ),
        "@v", [T13 · variação]
    )
RETURN
    MAXX ( _q, [@v] )
