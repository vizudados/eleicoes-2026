/*
@pasta: T13 Perfil\Contas
@formato: #,0
@descricao: Cidades do contexto com Lula à frente em 2022 e em 2026. Conta cidade a cidade.
@gerado: pbi/scripts/desenho_t13.py
*/
SUMX (
    VALUES ( 'Município'[CodIBGE] ),
    VAR _d22 = [T13 · saldo 2022]
    VAR _d26 = [T13 · saldo 2026]
    RETURN
        IF ( _d22 > 0 && _d26 > 0, 1 )
) + 0
