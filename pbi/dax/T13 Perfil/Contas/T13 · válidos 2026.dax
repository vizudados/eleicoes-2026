/*
@pasta: T13 Perfil\Contas
@formato: #,0
@descricao: Votos válidos em 2026, somados nas cidades do contexto.
@gerado: pbi/scripts/desenho_t13.py
*/
IF ( [Eleição · pós] = 1, CALCULATE (
    SUM ( 'Município segundo turno'[Validos] ),
    'Município segundo turno'[Ano] = 2026
), CALCULATE (
    SUM ( 'Município ano'[Validos] ),
    'Município ano'[Ano] = 2026
) )
