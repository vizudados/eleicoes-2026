/*
@pasta: T05 Flávio\Desenho
@formato: texto
@descricao: Resumo do recorte: o % de Flávio, os votos, em quantos municípios ficou à frente, o que mudou desde 2022 e três fatos (mais forte, mais fraco, cidade grande). A faixa do meio fica livre para a origem (outro visual).
*/
-- 1 · Leituras
VAR _comUF = [T05 · com UF]
VAR _recorte = [T05 · recorte]
VAR _votos = [T05 · votos]
VAR _pct = [T05 · %]
VAR _pos = [T05 · posição]
VAR _v22 = [T05 · votos 2022]
VAR _p22 = [T05 · % 2022]
VAR _c22 = [T05 · candidato 2022]
VAR _dv = [T05 · variação de votos]
VAR _dpp = [T05 · variação em p.p.]
VAR _nFrente = [T05 · municípios à frente]
VAR _nMun = [T05 · municípios]
VAR _eleit = [T05 · eleitores nos municípios à frente]
VAR _forte = [T05 · lugar mais forte]
VAR _forteP = [T05 · lugar mais forte %]
VAR _fraco = [T05 · lugar mais fraco]
VAR _fracoP = [T05 · lugar mais fraco %]
VAR _grande = [T05 · cidade grande mais forte]
VAR _grandeP = [T05 · cidade grande mais forte %]
VAR _grandePop = [T05 · cidade grande mais forte população]
-- 2 · Textos
VAR _txtRec = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
VAR _txtPct = IF ( [Eleição · pós] = 1, FORMAT ( _pct, "0.00%" ), FORMAT ( _pct, "0.0%" ) )
VAR _txtVotos = SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) )
VAR _txtNFrente = FORMAT ( _nFrente, "#,0" )
VAR _txtNMun = FORMAT ( _nMun, "#,0" )
VAR _txtEleit = IF ( _eleit >= 0.995 && _nFrente < _nMun, FORMAT ( _eleit, "0.0%" ), FORMAT ( _eleit, "0%" ) )
VAR _txtMun = IF ( _nMun = 1, " município", " municípios" )
VAR _manchete =
    SWITCH (
        TRUE (),
        _nMun = 1 && _nFrente = 1, "Flávio ficou à frente no único município do recorte",
        _nMun = 1, "Flávio ficou atrás no único município do recorte",
        _nFrente = 0, "Flávio não ficou à frente em nenhum dos " & _txtNMun & _txtMun,
        "Flávio ficou à frente em " & _txtNFrente & " dos " & _txtNMun & _txtMun & ", onde votam " & _txtEleit & " dos eleitores"
    )
VAR _txtDV = IF ( _dv < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dv ) ) >= 1000000, FORMAT ( ABS ( _dv ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dv ) ) >= 1000, FORMAT ( ABS ( _dv ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dv ), "#,0" ) )
VAR _txtDPP = FORMAT ( _dpp, "+0.0;−0.0;0.0" )
VAR _pontos = IF ( ABS ( _dpp ) < 2, " ponto", " pontos" )
VAR _compara =
    "Em 2022, " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " teve " & SWITCH ( TRUE (), ABS ( _v22 ) >= 1000000, FORMAT ( _v22 / 1000000, "0.00" ) & " mi", ABS ( _v22 ) >= 1000, FORMAT ( _v22 / 1000, "0.0" ) & " mil", FORMAT ( _v22, "#,0" ) ) & " (" & FORMAT ( _p22, "0.0%" ) & "). Agora: <b class='flavio-esc'>"
        & _txtDV & IF ( ABS ( _dv ) >= 1000, " de votos", IF ( ABS ( _dv ) = 1, " voto", " votos" ) )
        & "</b> e <b class='flavio-esc'>" & _txtDPP & _pontos & "</b>."
VAR _rotForte = IF ( _comUF = 1, "Município mais forte", "UF mais forte" )
VAR _rotFraco = IF ( _comUF = 1, "Município mais fraco", "UF mais fraca" )
VAR _fatoGrande =
    IF (
        NOT ISBLANK ( _grande ),
        "<div class='fato sobe d12'><span class='ic g'></span><div><div class='rot'>" & "Entre as cidades de 100 mil+" & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _grande, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " <small>" & FORMAT ( _grandePop, "#,0" ) & " habitantes</small>" & "</div></div><div class='vp flavio'>" & FORMAT ( _grandeP, "0.0%" ) & "</div></div>"
    )
-- 4 · Marcação
VAR _html =
    "<div class='tela rv'>"
        & "<div class='sob sobe'>Flávio Bolsonaro · PL · 22 · " & _txtRec & "</div>"
        & "<div class='topo'><div class='big flavio sobe d1" & IF ( [Eleição · pós] = 1, " pos", "" ) & "'>" & _txtPct & "</div>"
        & "<div class='lado sobe d2'><div class='vv flavio'>" & _txtVotos & "</div>"
        & "<div class='txt'>de votos · " & _pos & "º lugar</div></div></div>"
        & "<div class='man mc sobe d3'>" & _manchete & "</div>"
        & "<div class='txt cp sobe d4'>" & _compara & "</div>"
        & "<div class='fatos'>"
        & "<div class='fato sobe d10'><span class='ic f'></span><div><div class='rot'>" & _rotForte & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _forte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp flavio'>" & FORMAT ( _forteP, "0.0%" ) & "</div></div>"
        & IF ( _fraco <> _forte, "<div class='fato sobe d11'><span class='ic r'></span><div><div class='rot'>" & _rotFraco & "</div><div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fraco, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp'>" & FORMAT ( _fracoP, "0.0%" ) & "</div></div>" )
        & _fatoGrande & "</div>"
    & "</div>"
RETURN
    _html
