/*
@pasta: T05 Flávio\Desenho
@formato: texto
@descricao: Com um município marcado (uma entrada só): o lugar dele entre as cidades da UF — a fatia dos votos de Flávio no estado que saiu dele e as posições em votos e em % dos válidos. Sem clique.
*/
-- 1 · Leituras
VAR _mun = [T05 · município]
VAR _est = [T05 · estado do município]
VAR _parte = [T05 · parte do município no estado]
VAR _posV = [T05 · posição em votos no estado]
VAR _posP = [T05 · posição em % no estado]
VAR _n = [T05 · municípios no estado do município]
-- 2 · Textos
VAR _nm = IF ( RIGHT ( _mun, 1 ) = ")", LEFT ( _mun, LEN ( _mun ) - 5 ), _mun )
VAR _txtNm = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
VAR _txtEst = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _est, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
VAR _rotulo =
    IF (
        _n = 1,
        _txtNm & " · " & _txtEst & " · o único município",
        "No estado · " & _txtEst & " · " & FORMAT ( _n, "#,0" ) & " cidades"
    )
VAR _txtParte = FORMAT ( _parte, "0.0%" ) & " dos votos de Flávio no estado saíram daqui"
VAR _linhaV =
    IF (
        _posV = 1,
        "a cidade que mais deu votos a Flávio no estado",
        "cidade que mais deu votos a Flávio no estado"
    )
VAR _linhaP =
    IF (
        _posP = 1,
        "onde Flávio teve o maior % dos válidos no estado",
        "no % dos válidos de Flávio, da mais forte à mais fraca"
    )
-- 3 · Geometria (barra de 620 px)
VAR _w = MAX ( _parte * 620, 4 ) -- geometria
VAR _dentro = _w >= 360 -- geometria
VAR _xr = FORMAT ( _w + 12, "0.0##", "en-US" ) -- geometria
-- 4 · Marcação
VAR _rk =
    IF (
        _n > 1,
        "<div class='rk sobe d8' style='top:96px'><span class='n flavio'>" & _posV & "ª</span><span class='t'>"
            & _linhaV & "</span></div>"
            & "<div class='rk sobe d10' style='top:160px'><span class='n'>" & _posP & "ª</span><span class='t'>"
            & _linhaP & "</span></div>"
    )
RETURN
    IF (
        NOT ISBLANK ( _mun ),
        "<div class='tela og'><div class='oc'>"
            & "<div class='rot ro sobe'>" & _rotulo & "</div>"
            & "<div class='trilho entra d3'></div>"
            & "<div class='fa o1 barra-x d5' style='left:0;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>"
            & IF ( _dentro, _txtParte ) & "</span></div>"
            & IF ( NOT _dentro, "<span class='lfa entra d8' style='left:" & _xr & "px'>" & _txtParte & "</span>" )
            & _rk
            & "<div class='dica entra d14'>clique no vazio do mapa para voltar</div>"
        & "</div></div>"
    )
