/*
@pasta: T05 Flávio\Contas
@formato: 0%
@descricao: Parcela dos votos do candidato que veio da origem principal (0–1).
@oraculo: paginas[5].regioes[0].parte_dos_votos_txt
*/
VAR _reg =
    ADDCOLUMNS ( VALUES ( 'UF'[Região] ), "@v", [T05 · votos (municípios)], "@p", [T05 · % (municípios)] )
VAR _mun =
    ADDCOLUMNS (
        FILTER ( VALUES ( 'Município'[Rótulo] ), [T05 · com UF] = 1 ),
        "@v", [T05 · votos (municípios)],
        "@p", [T05 · % (municípios)]
    )
VAR _topReg = TOPN ( 1, _reg, [@v], DESC, 'UF'[Região], ASC )
VAR _topMun = TOPN ( 1, _mun, [@v], DESC, 'Município'[Rótulo], ASC )
VAR _uf = [T05 · com UF] = 1
RETURN
    DIVIDE ( IF ( _uf, MAXX ( _topMun, [@v] ), MAXX ( _topReg, [@v] ) ), [T05 · votos (municípios)] )
