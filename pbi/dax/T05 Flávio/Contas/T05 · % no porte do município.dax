/*
@pasta: T05 Flávio\Contas
@formato: 0.0%
@descricao: Parcela de Flávio nos válidos de 2026 somados em todas as cidades do Brasil com o mesmo porte do município marcado.
*/
VAR _p = [T05 · porte do município]
RETURN
    IF (
        NOT ISBLANK ( _p ),
        CALCULATE ( [T05 · % (municípios)], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[Porte] = _p )
    )
