/*
@pasta: T05 Flávio\Contas
@formato: #,0
@descricao: Votos de Flávio em 2026 somados nos municípios do contexto (sem o exterior).
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'Município segundo turno'[VotosAdversario] ), 'Município segundo turno'[Ano] = 2026 ), CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2026 ) )
