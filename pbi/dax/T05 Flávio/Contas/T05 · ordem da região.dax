/*
@pasta: T05 Flávio\Contas
@formato: 0
@descricao: Colocação da região da linha pelos votos de Flávio (1 = a que mais deu votos), entre as regiões do recorte.
@oraculo: paginas[5].regioes[] (ordem)
*/
VAR _v = [T05 · votos (municípios)]
VAR _maiores =
    CALCULATETABLE (
        FILTER ( VALUES ( 'UF'[Região] ), [T05 · votos (municípios)] > _v ),
        REMOVEFILTERS ( 'UF'[Região], 'UF'[RegiaoOrdem] )
    )
RETURN
    IF ( _v > 0, 1 + COUNTROWS ( _maiores ) )
