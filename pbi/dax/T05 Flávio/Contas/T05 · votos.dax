/*
@pasta: T05 Flávio\Contas
@formato: #,0
@descricao: Votos de Flávio (número 22) no 1º turno de 2026, no recorte (com o exterior no Brasil).
@oraculo: paginas[5].votos
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'UF segundo turno'[VotosAdversario] ), 'UF segundo turno'[Ano] = 2026 ), CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 22 ) )
