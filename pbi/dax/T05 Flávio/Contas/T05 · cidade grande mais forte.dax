/*
@pasta: T05 Flávio\Contas
@formato: texto
@descricao: Entre as cidades de 100 mil habitantes ou mais do recorte, a de maior % do candidato (vazio se o recorte não tem cidade desse porte).
@oraculo: paginas[5].cidades_grandes_mais_fortes[0]
*/
VAR _gr =
    ADDCOLUMNS (
        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
        "@p", [T05 · % (municípios)],
        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
    )
VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
RETURN
    MAXX ( _top, 'Município'[Rótulo] )
