/*
@pasta: T05 Flávio\Contas
@formato: #,0
@descricao: Votos de Lula em 2026 somados nos municípios (sem o exterior).
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'Município segundo turno'[VotosPT] ), 'Município segundo turno'[Ano] = 2026 ), CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2026 ) )
