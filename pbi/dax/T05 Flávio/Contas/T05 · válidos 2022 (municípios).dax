/*
@pasta: T05 Flávio\Contas
@formato: #,0
@descricao: Votos válidos de 2022 somados nos municípios (sem o exterior).
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'Município segundo turno'[Validos] ), 'Município segundo turno'[Ano] = 2022 ), CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2022 ) )
