/*
@pasta: T05 Flávio\Contas
@formato: #,0
@descricao: Votos do PL em 2022 somados nos municípios (sem o exterior).
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'Município segundo turno'[VotosAdversario] ), 'Município segundo turno'[Ano] = 2022 ), CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2022 ) )
