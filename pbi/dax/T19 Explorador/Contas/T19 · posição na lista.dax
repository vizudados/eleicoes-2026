/*
@pasta: T19 Explorador\Contas
@formato: 0
@descricao: Posição do município na lista: 1 = mais votos válidos em 2026 entre os municípios que a lista mostra (o filtro de 14 do visual).
@oraculo: mockup/data/eleicoes.json › Explorador › padrao.linhas (ordem)
*/
IF (
    HASONEVALUE ( 'Município'[Rótulo] ),
    RANKX ( ALLSELECTED ( 'Município'[Rótulo] ), [T19 · válidos 2026], , DESC, SKIP )
)
