/*
@pasta: T19 Explorador\Contas
@formato: 0
@descricao: Conta no turno escolhido: Pré = primeiro turno; Pós = segundo turno. Preserva o grão e os filtros.
*/
IF ( [Eleição · pós] = 1, COALESCE (
    COUNTROWS (
        FILTER (
            VALUES ( 'Ano'[Ano] ),
            CALCULATE (
                SUM ( 'Município segundo turno'[VotosPT] ) - SUM ( 'Município segundo turno'[VotosAdversario] )
            ) > 0
        )
    ),
    0
), COALESCE (
    COUNTROWS (
        FILTER (
            VALUES ( 'Ano'[Ano] ),
            CALCULATE (
                SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] )
            ) > 0
        )
    ),
    0
) )
