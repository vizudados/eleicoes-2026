/*
@pasta: T19 Explorador\Contas
@formato: #,0
@descricao: Municípios do recorte (filtro da tela e seleção na dispersão) em que Flávio ficou à frente em 2026 (margem < 0).
@oraculo: 2.906 (Virada › flavio_venceu_2026)
*/
COALESCE (
    COUNTROWS (
        FILTER (
            VALUES ( 'Município'[CodIBGE] ),
            [T19 · no recorte] = 1 && [T19 · margem 2026] < 0
        )
    ),
    0
)
