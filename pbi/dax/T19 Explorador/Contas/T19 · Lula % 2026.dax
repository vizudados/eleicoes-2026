/*
@pasta: T19 Explorador\Contas
@formato: 0.0%
@descricao: Conta no turno escolhido: Pré = primeiro turno; Pós = segundo turno. Preserva o grão e os filtros.
*/
IF ( [Eleição · pós] = 1, DIVIDE (
    CALCULATE ( SUM ( 'Município segundo turno'[VotosPT] ), 'Município segundo turno'[Ano] = 2026 ),
    [T19 · válidos 2026]
), DIVIDE (
    CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2026 ),
    [T19 · válidos 2026]
) )
