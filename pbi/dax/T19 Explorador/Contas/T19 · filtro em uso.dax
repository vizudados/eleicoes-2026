/*
@pasta: T19 Explorador\Contas
@formato: texto
@descricao: O filtro do recorte em poucas palavras, para a pílula: um pedaço por grupo com escolha, na ordem da árvore ('Nordeste · até 10 mil hab.'; 'MG · Virou para Flávio'); o lugar vem resumido de cima para baixo ([T19 · filtro · lugar]: regiões inteiras, estados inteiros, cidades soltas); com vários itens nos outros grupos, a contagem ('2 faixas de renda'). Vazio sem filtro.
*/
-- 1 · Escolhas por grupo (RaizOrdem: 1 o lugar, 2 Tamanho da cidade, 3 Renda, 4 Virou?)
VAR _f = ISFILTERED ( 'T19 Filtro'[Caminho] )
VAR _t2 =
    CALCULATETABLE (
        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Valor], 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
        'T19 Filtro'[RaizOrdem] = 2
    )
VAR _t3 =
    CALCULATETABLE (
        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Valor], 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
        'T19 Filtro'[RaizOrdem] = 3
    )
VAR _t4 =
    CALCULATETABLE (
        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Valor], 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
        'T19 Filtro'[RaizOrdem] = 4
    )
VAR _n2 = IF ( _f, COUNTROWS ( _t2 ), 0 )
VAR _n3 = IF ( _f, COUNTROWS ( _t3 ), 0 )
VAR _n4 = IF ( _f, COUNTROWS ( _t4 ), 0 )
-- 2 · Um pedaço por grupo: o valor quando é um só; a contagem quando são vários
VAR _p1 = [T19 · filtro · lugar]
VAR _p2 =
    SWITCH (
        TRUE (),
        _n2 = 1, CONCATENATEX ( _t2, 'T19 Filtro'[Valor], ", " ) & " hab.",
        _n2 > 1, _n2 & " tamanhos de cidade"
    )
VAR _p3 =
    SWITCH (
        TRUE (),
        _n3 = 1, "renda: " & CONCATENATEX ( _t3, 'T19 Filtro'[Curto], ", " ),
        _n3 > 1, _n3 & " faixas de renda"
    )
VAR _p4 =
    SWITCH (
        TRUE (),
        _n4 = 1, CONCATENATEX ( _t4, 'T19 Filtro'[Valor], ", " ),
        _n4 > 1, _n4 & " situações"
    )
VAR _partes = { ( 1, _p1 ), ( 2, _p2 ), ( 3, _p3 ), ( 4, _p4 ) }
RETURN
    CONCATENATEX ( FILTER ( _partes, NOT ISBLANK ( [Value2] ) ), [Value2], " · ", [Value1], ASC )
