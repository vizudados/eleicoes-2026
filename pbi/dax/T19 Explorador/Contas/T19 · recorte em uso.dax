/*
@pasta: T19 Explorador\Contas
@formato: texto
@descricao: O recorte em palavras, para a faixa do resumo e os textos alternativos: um pedaço por grupo do filtro com escolha, na ordem da árvore ('Sudeste · 10 a 50 mil hab. · seleção na dispersão'; 'MG, SP · renda: mais pobres'); o lugar vem resumido de cima para baixo ([T19 · filtro · lugar]), os outros grupos com a contagem quando são vários itens; 'Todo o Brasil' sem filtro.
@oraculo: mockup/data/eleicoes.json › Explorador › padrao.recorte_txt
*/
-- 1 · Escolhas por grupo (RaizOrdem: 1 o lugar, 2 Tamanho da cidade, 3 Renda, 4 Virou?)
VAR _f = ISFILTERED ( 'T19 Filtro'[Caminho] )
VAR _t2 =
    CALCULATETABLE (
        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
        'T19 Filtro'[RaizOrdem] = 2
    )
VAR _t3 =
    CALCULATETABLE (
        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
        'T19 Filtro'[RaizOrdem] = 3
    )
VAR _t4 =
    CALCULATETABLE (
        SUMMARIZE ( 'T19 Filtro', 'T19 Filtro'[Curto], 'T19 Filtro'[Ordem] ),
        'T19 Filtro'[RaizOrdem] = 4
    )
VAR _n2 = IF ( _f, COUNTROWS ( _t2 ), 0 )
VAR _n3 = IF ( _f, COUNTROWS ( _t3 ), 0 )
VAR _n4 = IF ( _f, COUNTROWS ( _t4 ), 0 )
-- 2 · Um pedaço por grupo: os itens (poucos) ou a contagem (muitos)
VAR _lugar = [T19 · filtro · lugar]
VAR _porte =
    IF (
        _n2 > 0,
        IF (
            _n2 <= 2,
            CONCATENATEX ( _t2, 'T19 Filtro'[Curto], ", ", 'T19 Filtro'[Ordem], ASC ) & " hab.",
            _n2 & " tamanhos de cidade"
        )
    )
VAR _quinto =
    IF (
        _n3 > 0,
        IF (
            _n3 <= 2,
            "renda: " & CONCATENATEX ( _t3, 'T19 Filtro'[Curto], ", ", 'T19 Filtro'[Ordem], ASC ),
            _n3 & " faixas de renda"
        )
    )
VAR _lado =
    IF (
        _n4 > 0,
        IF (
            _n4 <= 2,
            CONCATENATEX ( _t4, 'T19 Filtro'[Curto], ", ", 'T19 Filtro'[Ordem], ASC ),
            _n4 & " situações"
        )
    )
-- 3 · A seleção por retângulo na dispersão (filtro cruzado no código do município)
VAR _laco =
    IF ( ISFILTERED ( 'Município'[CodIBGE] ), "seleção na dispersão" )
VAR _partes =
    {
        ( 1, _lugar ), ( 2, _porte ), ( 3, _quinto ), ( 4, _lado ), ( 5, _laco )
    }
VAR _texto =
    CONCATENATEX ( FILTER ( _partes, NOT ISBLANK ( [Value2] ) ), [Value2], " · ", [Value1], ASC )
RETURN
    IF ( _texto = "", "Todo o Brasil", _texto )
