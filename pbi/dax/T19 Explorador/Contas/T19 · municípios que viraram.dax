/*
@pasta: T19 Explorador\Contas
@formato: #,0
@descricao: Municípios do recorte que mudaram de lado entre 2022 e 2026 no turno escolhido. Pré: Lula para Flávio. Pós: os dois sentidos, com a mesma regra de sinais e sem empates ou cidade nova.
@oraculo: Pré 711; Pós 309 (278 para Flávio e 31 para Lula), dados/pbi/municipio_2turno.csv.
*/
COALESCE (
    COUNTROWS (
        FILTER (
            VALUES ( 'Município'[CodIBGE] ),
            [T19 · no recorte] = 1 && [T19 · virou] = 1
        )
    ),
    0
)
