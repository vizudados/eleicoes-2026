/*
@pasta: T19 Explorador\Contas
@formato: #,0
@descricao: Municípios do recorte (filtro da tela e seleção na dispersão) que trocaram Lula (2022) por Flávio (2026).
@oraculo: 711 (Virada › viraram)
*/
COALESCE (
    COUNTROWS (
        FILTER (
            VALUES ( 'Município'[CodIBGE] ),
            [T19 · no recorte] = 1 && [T19 · virou] = 1
        )
    ),
    0
)
