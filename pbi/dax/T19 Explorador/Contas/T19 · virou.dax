/*
@pasta: T19 Explorador\Contas
@formato: 0
@descricao: Conta no turno escolhido: Pré = primeiro turno; Pós = segundo turno. Preserva o grão e os filtros.
*/
IF ( [Eleição · pós] = 1, VAR _m22 = [T19 · margem 2022]
VAR _m26 = [T19 · margem 2026]
RETURN INT ( NOT ISBLANK ( _m22 ) && NOT ISBLANK ( _m26 ) && _m22 * _m26 < 0 ), VAR _m22 = [T19 · margem 2022]
VAR _m26 = [T19 · margem 2026]
RETURN
    IF ( _m22 > 0 && _m26 < 0, 1, 0 ) )
