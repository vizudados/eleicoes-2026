/*
@pasta: T19 Explorador\Contas
@formato: 0.0%
@descricao: Conta no turno escolhido: Pré = primeiro turno; Pós = segundo turno. Preserva o grão e os filtros.
*/
IF ( [Eleição · pós] = 1, VAR _pt =
    CALCULATE ( SUM ( 'Município segundo turno'[VotosPT] ), 'Município segundo turno'[Ano] = 2018 )
VAR _adv =
    CALCULATE ( SUM ( 'Município segundo turno'[VotosAdversario] ), 'Município segundo turno'[Ano] = 2018 )
VAR _val =
    CALCULATE ( SUM ( 'Município segundo turno'[Validos] ), 'Município segundo turno'[Ano] = 2018 )
RETURN
    DIVIDE ( _pt - _adv, _val ), VAR _pt =
    CALCULATE ( SUM ( 'Município ano'[VotosPT] ), 'Município ano'[Ano] = 2018 )
VAR _adv =
    CALCULATE ( SUM ( 'Município ano'[VotosAdversario] ), 'Município ano'[Ano] = 2018 )
VAR _val =
    CALCULATE ( SUM ( 'Município ano'[Validos] ), 'Município ano'[Ano] = 2018 )
RETURN
    DIVIDE ( _pt - _adv, _val ) )
