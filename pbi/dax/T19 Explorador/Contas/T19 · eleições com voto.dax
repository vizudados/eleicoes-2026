/*
@pasta: T19 Explorador\Contas
@formato: 0
@descricao: Conta no turno escolhido: Pré = primeiro turno; Pós = segundo turno. Preserva o grão e os filtros.
*/
IF ( [Eleição · pós] = 1, COALESCE (
    COUNTROWS (
        FILTER ( VALUES ( 'Ano'[Ano] ), CALCULATE ( SUM ( 'Município segundo turno'[Validos] ) ) > 0 )
    ),
    0
), COALESCE (
    COUNTROWS (
        FILTER ( VALUES ( 'Ano'[Ano] ), CALCULATE ( SUM ( 'Município ano'[Validos] ) ) > 0 )
    ),
    0
) )
