/*
@pasta: T16 Os outros\Desenho
@formato: texto
@descricao: Uma linha (os quatro mais votados depois de Lula e Flávio) ou etiqueta (os menores) por pessoa (grão Apoio[Quem]): o partido e a posição mais recente no 2º turno, com a data e a condição. Clique num grupo do diagrama: a linha do candidato daquele grupo fica em destaque (fx) e as outras esmaecem (fora). Alvo do dossiê ttT16Apoio; vazio para quem não está na lista.
*/
-- 1 · Leituras
VAR _q = SELECTEDVALUE ( Apoio[Quem] )
VAR _pos = [T16 · apoio · posição]
VAR _cond = [T16 · apoio · condicionado]
VAR _dia = [T16 · apoio · data]
VAR _foco = [T16 · foco · grupo clicado]
-- 2 · Textos
VAR _item =
    SWITCH (
        _q,
        "Augusto Cury", "1|Avante",
        "Renan Santos", "2|Missão",
        "Ronaldo Caiado", "3|PSD",
        "Romeu Zema", "4|Novo",
        "Hertz Dias", "5|PSTU",
        "Edmilson Costa", "6|PCB",
        "Samara Martins", "7|UP",
        "Clariana Barão", "8|DC",
        "Wilson Grassi", "9|Democrata",
        "Rui Costa Pimenta", "10|PCO"
    )
VAR _ordem = IF ( NOT ISBLANK ( _item ), VALUE ( LEFT ( _item, SEARCH ( "|", _item ) - 1 ) ) )
VAR _partido = IF ( NOT ISBLANK ( _item ), MID ( _item, SEARCH ( "|", _item ) + 1, 40 ) )
VAR _meuGrupo = SWITCH ( _q, "Augusto Cury", "Cury", "Renan Santos", "Renan", "Ronaldo Caiado", "Caiado" )
VAR _clsFoco = IF ( ISBLANK ( _foco ) || _foco = "nao_votou", "", IF ( _meuGrupo = _foco, " fx", " fora" ) )
VAR _cls = SWITCH ( _pos, "Flávio", "f", "Lula", "l", "n" )
VAR _txtPos = SWITCH ( _pos, "liberou", "liberou o eleitor", _pos )
VAR _escQ = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _q, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
VAR _txtNota =
    IF ( ISBLANK ( _dia ), "", "em " & FORMAT ( _dia, "dd/MM" ) )
        & IF ( _cond = "Sim", IF ( ISBLANK ( _dia ), "", " · " ) & "com condições", "" )
-- 3 · Geometria (linhas de 58 px a partir de y 32; etiquetas em duas fileiras de três a partir de y 300)
VAR _top = 32 + ( _ordem - 1 ) * 58 -- geometria
VAR _col = MOD ( _ordem - 5, 3 ) -- geometria
VAR _fil = INT ( ( _ordem - 5 ) / 3 ) -- geometria
-- 4 · Marcação
RETURN
    IF (
        NOT ISBLANK ( _item ) && NOT ISBLANK ( _pos ),
        "<div class='tela t16i" & _clsFoco & "'>"
            & IF (
                _ordem <= 4,
                "<div class='ln sobe' style='top:" & _top & "px;animation-delay:" & ( 200 + _ordem * 120 ) & "ms'>"
                    & "<div class='q'><b>" & _escQ & "</b><span>" & _partido & "</span></div>"
                    & "<span class='seta'>→</span><span class='bd " & _cls & "'>" & _txtPos & "</span>"
                    & "<small>" & _txtNota & "</small></div>",
                "<div class='ch entra' style='left:" & ( _col * 176 ) & "px;top:" & ( 300 + _fil * 38 ) & "px;animation-delay:"
                    & ( 700 + _ordem * 80 ) & "ms'>" & _partido & "<span class='bd " & _cls & "'>" & _txtPos
                    & IF ( _cond = "Sim", "*", "" ) & "</span></div>"
            )
        & "</div>"
    )
