/*
@pasta: T16 Os outros\Contas
@formato: 0
@descricao: Governadores eleitos ou reeleitos no 1º turno com posição 'Flávio' no 2º turno (levantamento do O Povo, 16/10).
@oraculo: 12
*/
COUNTROWS (
    FILTER (
        ALL ( Apoio ),
        ( CONTAINSSTRING ( Apoio[Cargo], "governador eleito" ) || CONTAINSSTRING ( Apoio[Cargo], "governador reeleito" )
            || CONTAINSSTRING ( Apoio[Cargo], "governadora eleita" ) || CONTAINSSTRING ( Apoio[Cargo], "governadora reeleita" ) )
            && Apoio[Posição] = "Flávio"
    )
) + 0
