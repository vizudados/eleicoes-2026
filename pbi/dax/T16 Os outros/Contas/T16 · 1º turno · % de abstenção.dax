DIVIDE (
    [T16 · 1º turno · abstenções],
    CALCULATE ( SUM ( 'Comparecimento ano'[Aptos] ), REMOVEFILTERS ( 'Comparecimento ano' ), 'Comparecimento ano'[Ano] = 2026 )
)
