/*
@pasta: T06 Ausência\Contas
@formato: 0.0%
@descricao: Abstenção da faixa 25 a 34 no 1º turno de 2026, no Brasil (0–1): faltosos ÷ aptos da faixa.
@oraculo: paginas[6].idade[25 a 34].pct2026
*/
CALCULATE (
    DIVIDE ( SUM ( 'Abstenção perfil'[Abstencao] ), SUM ( 'Abstenção perfil'[Aptos] ) ),
    'Abstenção perfil'[Ano] = 2026,
    'Abstenção perfil'[Dimensão] = "faixa_etaria",
    'Abstenção perfil'[Categoria] IN { "25 a 29 anos", "30 a 34 anos" }
)
