/*
@pasta: T06 Ausência\Contas
@formato: 0.0%
@descricao: Abstenção da faixa 70 ou mais no 1º turno de 2014, no Brasil (0–1): faltosos ÷ aptos da faixa.
@oraculo: paginas[6].idade[70 ou mais].pct2014
*/
CALCULATE (
    DIVIDE ( SUM ( 'Abstenção perfil'[Abstencao] ), SUM ( 'Abstenção perfil'[Aptos] ) ),
    'Abstenção perfil'[Ano] = 2014,
    'Abstenção perfil'[Dimensão] = "faixa_etaria",
    'Abstenção perfil'[Categoria] IN { "70 a 74 anos", "75 a 79 anos", "80 a 84 anos", "85 a 89 anos", "90 a 94 anos", "95 a 99 anos", "100 anos ou mais" }
)
