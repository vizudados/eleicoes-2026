/*
@pasta: T06 Ausência\Contas
@formato: #,0
@descricao: Votos do principal adversário no ano da linha, somados nos municípios do recorte.
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'Município segundo turno'[VotosAdversario] ), 'Município segundo turno'[Ano] = MAX ( 'Ano'[Ano] ) ), SUM ( 'Município ano'[VotosAdversario] ) )
