/*
@pasta: T06 Ausência\Contas
@formato: #,0
@descricao: Eleitores aptos no ano do contexto: Brasil oficial ('Comparecimento ano') sem filtro; soma dos municípios com o filtro de UF.
*/
IF (
    [Eleição · pós] = 1,
    IF ( [T06 · com UF] = 1,
        CALCULATE ( SUM ( 'Município segundo turno'[Aptos] ), 'Município segundo turno'[Ano] = MAX ( 'Ano'[Ano] ) ),
        CALCULATE ( SUM ( 'Comparecimento turno'[Aptos] ), 'Comparecimento turno'[Turno] = 2,
            'Comparecimento turno'[Abrangência] = "com_exterior", 'Comparecimento turno'[Ano] = MAX ( 'Ano'[Ano] ) ) ),
    IF ( [T06 · com UF] = 1, SUM ( 'Município ano'[Aptos] ), SUM ( 'Comparecimento ano'[Aptos] ) )
)
