/*
@pasta: T06 Ausência\Contas
@formato: 0.0%
@descricao: Abstenção da faixa 16 e 17 anos no 1º turno de 2014, no Brasil (0–1): faltosos ÷ aptos da faixa.
@oraculo: paginas[6].idade[16 e 17 anos].pct2014
*/
CALCULATE (
    DIVIDE ( SUM ( 'Abstenção perfil'[Abstencao] ), SUM ( 'Abstenção perfil'[Aptos] ) ),
    'Abstenção perfil'[Ano] = 2014,
    'Abstenção perfil'[Dimensão] = "faixa_etaria",
    'Abstenção perfil'[Categoria] IN { "16 anos", "17 anos" }
)
