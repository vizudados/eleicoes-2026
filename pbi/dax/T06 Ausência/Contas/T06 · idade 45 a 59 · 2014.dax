/*
@pasta: T06 Ausência\Contas
@formato: 0.0%
@descricao: Abstenção da faixa 45 a 59 no 1º turno de 2014, no Brasil (0–1): faltosos ÷ aptos da faixa.
@oraculo: paginas[6].idade[45 a 59].pct2014
*/
CALCULATE (
    DIVIDE ( SUM ( 'Abstenção perfil'[Abstencao] ), SUM ( 'Abstenção perfil'[Aptos] ) ),
    'Abstenção perfil'[Ano] = 2014,
    'Abstenção perfil'[Dimensão] = "faixa_etaria",
    'Abstenção perfil'[Categoria] IN { "45 a 49 anos", "50 a 54 anos", "55 a 59 anos" }
)
