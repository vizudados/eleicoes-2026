/*
@pasta: T06 Ausência\Desenho
@formato: texto
@descricao: Quem falta mais: a abstenção por faixa de idade em 2014 e 2026 (Brasil), um haltere por faixa. Só lê contas; posições são geometria.
*/
-- 1 · Leituras
VAR _comUF = [T06 · com UF]
VAR _a0 = [T06 · idade 16 e 17 anos · 2014]
VAR _b0 = [T06 · idade 16 e 17 anos · 2026]
VAR _a1 = [T06 · idade 18 a 24 · 2014]
VAR _b1 = [T06 · idade 18 a 24 · 2026]
VAR _a2 = [T06 · idade 25 a 34 · 2014]
VAR _b2 = [T06 · idade 25 a 34 · 2026]
VAR _a3 = [T06 · idade 35 a 44 · 2014]
VAR _b3 = [T06 · idade 35 a 44 · 2026]
VAR _a4 = [T06 · idade 45 a 59 · 2014]
VAR _b4 = [T06 · idade 45 a 59 · 2026]
VAR _a5 = [T06 · idade 60 a 69 · 2014]
VAR _b5 = [T06 · idade 60 a 69 · 2026]
VAR _a6 = [T06 · idade 70 ou mais · 2014]
VAR _b6 = [T06 · idade 70 ou mais · 2026]
-- 2 · Textos
VAR _manchete =
    "Dos 18 aos 24 anos, foi de " & FORMAT ( _a1, "0.0%" ) & " para " & FORMAT ( _b1, "0.0%" ) & "; acima dos 70, caiu de " & FORMAT ( _a6, "0.0%" )
        & " para " & FORMAT ( _b6, "0.0%" )
VAR _rot = "Quem falta mais · por idade, 2014 → 2026" & IF ( _comUF = 1, " · Brasil (o TSE não publica por UF)", "" )
-- 3 · Geometria (0% a 70% em x 140–630)
VAR _l0 =
    VAR _xa = 140 + _a0 * 700 -- geometria
    VAR _xb = 140 + _b0 * 700 -- geometria
    VAR _d = ( _b0 - _a0 ) * 100
    RETURN
        "<div class='fx" & IF ( 0 = 1, " dest", "" ) & " sobe d" & ( 0 + 4 ) & "' style='top:" & 68 & "px'>"
            & "<span class='nm'>16 e 17 anos</span>"
            & "<i class='lig' style='left:" & FORMAT ( MIN ( _xa, _xb ), "0.0##", "en-US" ) & "px;width:" & FORMAT ( ABS ( _xb - _xa ), "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p14' style='left:" & FORMAT ( _xa - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p26' style='left:" & FORMAT ( _xb - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<span class='vl'>" & FORMAT ( _b0, "0.0%" ) & "</span>"
            & "<span class='dd'>" & FORMAT ( _d, "+0.0;−0.0;0.0" ) & "</span></div>"
VAR _l1 =
    VAR _xa = 140 + _a1 * 700 -- geometria
    VAR _xb = 140 + _b1 * 700 -- geometria
    VAR _d = ( _b1 - _a1 ) * 100
    RETURN
        "<div class='fx" & IF ( 1 = 1, " dest", "" ) & " sobe d" & ( 1 + 4 ) & "' style='top:" & 94 & "px'>"
            & "<span class='nm'>18 a 24</span>"
            & "<i class='lig' style='left:" & FORMAT ( MIN ( _xa, _xb ), "0.0##", "en-US" ) & "px;width:" & FORMAT ( ABS ( _xb - _xa ), "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p14' style='left:" & FORMAT ( _xa - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p26' style='left:" & FORMAT ( _xb - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<span class='vl'>" & FORMAT ( _b1, "0.0%" ) & "</span>"
            & "<span class='dd'>" & FORMAT ( _d, "+0.0;−0.0;0.0" ) & "</span></div>"
VAR _l2 =
    VAR _xa = 140 + _a2 * 700 -- geometria
    VAR _xb = 140 + _b2 * 700 -- geometria
    VAR _d = ( _b2 - _a2 ) * 100
    RETURN
        "<div class='fx" & IF ( 2 = 1, " dest", "" ) & " sobe d" & ( 2 + 4 ) & "' style='top:" & 120 & "px'>"
            & "<span class='nm'>25 a 34</span>"
            & "<i class='lig' style='left:" & FORMAT ( MIN ( _xa, _xb ), "0.0##", "en-US" ) & "px;width:" & FORMAT ( ABS ( _xb - _xa ), "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p14' style='left:" & FORMAT ( _xa - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p26' style='left:" & FORMAT ( _xb - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<span class='vl'>" & FORMAT ( _b2, "0.0%" ) & "</span>"
            & "<span class='dd'>" & FORMAT ( _d, "+0.0;−0.0;0.0" ) & "</span></div>"
VAR _l3 =
    VAR _xa = 140 + _a3 * 700 -- geometria
    VAR _xb = 140 + _b3 * 700 -- geometria
    VAR _d = ( _b3 - _a3 ) * 100
    RETURN
        "<div class='fx" & IF ( 3 = 1, " dest", "" ) & " sobe d" & ( 3 + 4 ) & "' style='top:" & 146 & "px'>"
            & "<span class='nm'>35 a 44</span>"
            & "<i class='lig' style='left:" & FORMAT ( MIN ( _xa, _xb ), "0.0##", "en-US" ) & "px;width:" & FORMAT ( ABS ( _xb - _xa ), "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p14' style='left:" & FORMAT ( _xa - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p26' style='left:" & FORMAT ( _xb - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<span class='vl'>" & FORMAT ( _b3, "0.0%" ) & "</span>"
            & "<span class='dd'>" & FORMAT ( _d, "+0.0;−0.0;0.0" ) & "</span></div>"
VAR _l4 =
    VAR _xa = 140 + _a4 * 700 -- geometria
    VAR _xb = 140 + _b4 * 700 -- geometria
    VAR _d = ( _b4 - _a4 ) * 100
    RETURN
        "<div class='fx" & IF ( 4 = 1, " dest", "" ) & " sobe d" & ( 4 + 4 ) & "' style='top:" & 172 & "px'>"
            & "<span class='nm'>45 a 59</span>"
            & "<i class='lig' style='left:" & FORMAT ( MIN ( _xa, _xb ), "0.0##", "en-US" ) & "px;width:" & FORMAT ( ABS ( _xb - _xa ), "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p14' style='left:" & FORMAT ( _xa - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p26' style='left:" & FORMAT ( _xb - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<span class='vl'>" & FORMAT ( _b4, "0.0%" ) & "</span>"
            & "<span class='dd'>" & FORMAT ( _d, "+0.0;−0.0;0.0" ) & "</span></div>"
VAR _l5 =
    VAR _xa = 140 + _a5 * 700 -- geometria
    VAR _xb = 140 + _b5 * 700 -- geometria
    VAR _d = ( _b5 - _a5 ) * 100
    RETURN
        "<div class='fx" & IF ( 5 = 1, " dest", "" ) & " sobe d" & ( 5 + 4 ) & "' style='top:" & 198 & "px'>"
            & "<span class='nm'>60 a 69</span>"
            & "<i class='lig' style='left:" & FORMAT ( MIN ( _xa, _xb ), "0.0##", "en-US" ) & "px;width:" & FORMAT ( ABS ( _xb - _xa ), "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p14' style='left:" & FORMAT ( _xa - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p26' style='left:" & FORMAT ( _xb - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<span class='vl'>" & FORMAT ( _b5, "0.0%" ) & "</span>"
            & "<span class='dd'>" & FORMAT ( _d, "+0.0;−0.0;0.0" ) & "</span></div>"
VAR _l6 =
    VAR _xa = 140 + _a6 * 700 -- geometria
    VAR _xb = 140 + _b6 * 700 -- geometria
    VAR _d = ( _b6 - _a6 ) * 100
    RETURN
        "<div class='fx" & IF ( 6 = 1, " dest", "" ) & " sobe d" & ( 6 + 4 ) & "' style='top:" & 224 & "px'>"
            & "<span class='nm'>70 ou mais</span>"
            & "<i class='lig' style='left:" & FORMAT ( MIN ( _xa, _xb ), "0.0##", "en-US" ) & "px;width:" & FORMAT ( ABS ( _xb - _xa ), "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p14' style='left:" & FORMAT ( _xa - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='p26' style='left:" & FORMAT ( _xb - 6, "0.0##", "en-US" ) & "px'></i>"
            & "<span class='vl'>" & FORMAT ( _b6, "0.0%" ) & "</span>"
            & "<span class='dd'>" & FORMAT ( _d, "+0.0;−0.0;0.0" ) & "</span></div>"
-- 4 · Marcação
VAR _html =
    "<div class='tela ida'>"
        & "<div class='rot sobe'>" & _rot & "</div>"
        & "<div class='man sobe d1'>" & _manchete & "</div>"
        & "<div class='leg entra d3'><i class='p14'></i>2014 <i class='p26'></i>2026 · % dos aptos da faixa que não foram votar · variação em pontos</div>"
        & _l0 & _l1 & _l2 & _l3 & _l4 & _l5 & _l6
    & "</div>"
RETURN
    _html
