/*
@pasta: T06 Ausência\Desenho
@formato: texto
@descricao: Texto para leitor de tela do bloco por idade.
*/
LEFT (
    "Abstenção por idade no Brasil: dos 18 aos 24 anos, " & FORMAT ( [T06 · idade 18 a 24 · 2014], "0.0%" ) & " em 2014 e "
        & FORMAT ( [T06 · idade 18 a 24 · 2026], "0.0%" ) & " em 2026; acima dos 70, " & FORMAT ( [T06 · idade 70 ou mais · 2014], "0.0%" )
        & " e " & FORMAT ( [T06 · idade 70 ou mais · 2026], "0.0%" ) & ".",
    250
)
