/*
@pasta: T06 Ausência\Desenho
@formato: texto
@descricao: Uma coluna por 1º turno (granularidade Ano[Ano]): quem não escolheu ninguém empilhado em quem faltou (grafite), quem anulou (marrom) e quem votou em branco (areia); o total em cima e, na parte de quem faltou, a parcela que ela é do total. O alvo transparente abre o dossiê do ano. Só lê contas; a escala é geometria.
*/
-- 1 · Leituras
VAR _ano = [T06 · ano]
VAR _abst = [T06 · abstenções (ano)]
VAR _nul = [T06 · nulos (ano)]
VAR _bra = [T06 · brancos (ano)]
VAR _tot = [T06 · não escolheram (ano)]
VAR _parte = [T06 · faltaram entre quem não escolheu (ano)]
VAR _teto = [T06 · maior não escolheram da série]
-- 2 · Textos
VAR _txtTot = SWITCH ( TRUE (), ABS ( _tot ) >= 1000000, FORMAT ( _tot / 1000000, "0.0" ) & " mi", ABS ( _tot ) >= 1000, FORMAT ( _tot / 1000, "0.0" ) & " mil", FORMAT ( _tot, "#,0" ) )
-- 3 · Geometria (6 colunas em 130 px cada; de 0 ao teto em 560 px sobre a base a 44 px do pé)
VAR _i = ( _ano - 2006 ) / 4 -- geometria
VAR _x = _i * 130 -- geometria
VAR _k = DIVIDE ( 560, _teto ) -- geometria
VAR _ha = _abst * _k -- geometria
VAR _hn = _nul * _k -- geometria
VAR _hb = _bra * _k -- geometria
VAR _rotParte = IF ( _ha >= 30, "<span class='pt'>" & FORMAT ( _parte, "0%" ) & "</span>" )
-- 4 · Marcação
RETURN
    IF (
        NOT ISBLANK ( _tot ),
        "<div class='tela cp'><div class='col' style='left:" & FORMAT ( _x, "0.0##", "en-US" ) & "px'>"
            & "<div class='tot sobe d" & ( _i + 6 ) & "' style='bottom:" & FORMAT ( _ha + _hn + _hb + 52, "0.0##", "en-US" ) & "px'>"
            & _txtTot & "</div>"
            & "<div class='pilha barra-y d" & ( _i + 2 ) & "' style='height:" & FORMAT ( _ha + _hn + _hb, "0.0##", "en-US" ) & "px'>"
            & "<i class='b' style='height:" & FORMAT ( _hb, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='n' style='height:" & FORMAT ( _hn, "0.0##", "en-US" ) & "px'></i>"
            & "<i class='f' style='height:" & FORMAT ( _ha, "0.0##", "en-US" ) & "px'>" & _rotParte & "</i></div>"
            & "<div class='ano'>" & _ano & "</div><div class='alvo'></div></div></div>"
    )
