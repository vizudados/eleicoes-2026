/*
@pasta: T26 Debate na Globo\Desenho
@formato: texto
@descricao: Um cartão por métrica da noite (grão 'T26 Debate Globo'[Cartão]): quando chega, o título, o que mede, o número (contador) ou o lugar dele tracejado com 'aguardando', a fonte (ou a esperada) e a régua do debate da Band na mesma medida; nas pesquisas, o antes. Alvo do dossiê ttT26Cartao.
*/
-- 1 · Leituras (contas de T26 Debate na Globo\Contas)
VAR _c = SELECTEDVALUE ( 'T26 Debate Globo'[Cartão] )
VAR _est = [T26 · cartão · estado]
VAR _pos = [T26 · cartão · posição]
VAR _rot = [T26 · linha · rótulo]
VAR _med = [T26 · linha · medida]
VAR _sit = [T26 · debate · situação]
VAR _bLula = [T26 · buscas · Lula]
VAR _bFlavio = [T26 · buscas · Flávio]
VAR _audP = [T26 · audiência · prévia]
VAR _audC = [T26 · audiência · consolidado]
VAR _str = [T26 · streaming · pico]
VAR _rLula = [T26 · redes · Lula]
VAR _rFlavio = [T26 · redes · Flávio]
VAR _pN = [T26 · pesquisas · depois · n]
VAR _pL = [T26 · pesquisas · depois · Lula]
VAR _pF = [T26 · pesquisas · depois · Flávio]
VAR _pIni = [T26 · pesquisas · depois · primeiro campo]
VAR _pFim = [T26 · pesquisas · depois · último campo]
VAR _pInst = [T26 · pesquisas · depois · institutos]
VAR _aN = [T26 · pesquisas · antes · n]
VAR _aL = [T26 · pesquisas · antes · Lula]
VAR _aF = [T26 · pesquisas · antes · Flávio]
VAR _aIni = [T26 · pesquisas · antes · primeiro campo]
VAR _aFim = [T26 · pesquisas · antes · último campo]
VAR _xN = [T26 · pesquisas · atravessam · n]
VAR _bandC = [T26 · Band · audiência]
VAR _bandP = [T26 · Band · audiência prévia]
VAR _bandS = [T26 · Band · pico streaming]
VAR _bandBL = [T26 · Band · buscas · Lula]
VAR _bandBF = [T26 · Band · buscas · Flávio]
VAR _bandRL = [T26 · Band · redes · Lula]
VAR _bandRF = [T26 · Band · redes · Flávio]
VAR _band = [T26 · Band · data]
-- a linha que fala por este cartão: o que falta chegar (a prévia antes do consolidado) ou o que chegou por último
VAR _chaveTxt =
    SWITCH (
        _c,
        "audiencia", IF ( _est IN { "previa", "consolidado" }, "audiencia_consolidado", "audiencia_previa" ),
        "buscas", IF ( ISBLANK ( _bLula ) && NOT ISBLANK ( _bFlavio ), "buscas_flavio", "buscas_lula" ),
        "redes", IF ( ISBLANK ( _rLula ) && NOT ISBLANK ( _rFlavio ), "redes_flavio", "redes_lula" ),
        "streaming", "streaming_pico",
        "pesquisas", "pesquisas_depois"
    )
VAR _esp = CALCULATE ( [T26 · linha · esperado], 'T26 Debate Globo'[Chave] = _chaveTxt )
VAR _chaveFonte = IF ( _c = "audiencia", IF ( _est = "consolidado", "audiencia_consolidado", "audiencia_previa" ), _chaveTxt )
VAR _fonte = CALCULATE ( [T26 · linha · fonte], 'T26 Debate Globo'[Chave] = _chaveFonte )
VAR _atu = CALCULATE ( [T26 · linha · atualizado], 'T26 Debate Globo'[Chave] = _chaveFonte )
VAR _un = CALCULATE ( [T26 · linha · unidade], 'T26 Debate Globo'[Chave] = _chaveFonte )
-- 2 · Textos
VAR _chegou = _est IN { "publicado", "previa", "consolidado" }
VAR _parado = _est IN { "cancelado", "adiado" }
VAR _quando =
    SWITCH (
        TRUE (),
        _parado, "<div class='rot'>" & IF ( _est = "cancelado", "DEBATE CANCELADO", "DEBATE ADIADO" ) & "</div>",
        _est = "consolidado", "<div class='rot'>CHEGOU · CONSOLIDADO</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _atu, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
        _est = "previa", "<div class='rot'>FALTA O CONSOLIDADO</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _esp, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
        _est = "publicado" && _c = "pesquisas",
            "<div class='rot'>" & IF ( _pN = 1, "CHEGOU", "CHEGARAM" ) & "</div><div class='qt'>" & FORMAT ( _pN, "0" )
                & IF ( _pN = 1, " pesquisa, campo até ", " pesquisas, campo até " ) & FORMAT ( _pFim, "dd/MM" ) & "</div>",
        _est = "publicado", "<div class='rot'>CHEGOU</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _atu, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
        -- pesquisas: saíram, mas nenhuma com o campo inteiro depois do debate (24/10/2026, véspera da eleição)
        _est = "nao_divulgado" && _c = "pesquisas",
            "<div class='rot'>NENHUMA DEPOIS</div><div class='qt'>campo no dia do debate</div>",
        _est = "nao_divulgado", "<div class='rot'>NÃO DIVULGADO</div><div class='qt'>esperado: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _esp, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>",
        "<div class='rot'>" & IF ( _est = "parcial", "FALTA UM DOS DOIS", "ESPERADO" ) & "</div><div class='qt'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _esp, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
    )
VAR _humBandS = SWITCH ( TRUE (), ABS ( _bandS ) >= 10000000, FORMAT ( _bandS / 1000000, "0.0" ) & " mi", ABS ( _bandS ) >= 1000000, FORMAT ( _bandS / 1000000, "0.00" ) & " mi", ABS ( _bandS ) >= 1000, FORMAT ( _bandS / 1000, "#,0" ) & " mil", FORMAT ( _bandS, "#,0" ) )
VAR _humBandRL = SWITCH ( TRUE (), ABS ( _bandRL ) >= 10000000, FORMAT ( _bandRL / 1000000, "0.0" ), ABS ( _bandRL ) >= 1000000, FORMAT ( _bandRL / 1000000, "0.0" ), ABS ( _bandRL ) >= 1000, FORMAT ( _bandRL / 1000, "#,0" ), FORMAT ( _bandRL, "#,0" ) ) & SWITCH ( TRUE (), ABS ( _bandRL ) >= 1000000, " mi", ABS ( _bandRL ) >= 1000, " mil", "" )
VAR _humBandRF = SWITCH ( TRUE (), ABS ( _bandRF ) >= 10000000, FORMAT ( _bandRF / 1000000, "0.0" ), ABS ( _bandRF ) >= 1000000, FORMAT ( _bandRF / 1000000, "0.0" ), ABS ( _bandRF ) >= 1000, FORMAT ( _bandRF / 1000, "#,0" ), FORMAT ( _bandRF, "#,0" ) ) & SWITCH ( TRUE (), ABS ( _bandRF ) >= 1000000, " mi", ABS ( _bandRF ) >= 1000, " mil", "" )
VAR _vazioUm =
    SWITCH (
        TRUE (),
        _parado, "<div class='vz pa'><svg class='mold' width='268' height='100' viewBox='0 0 268 100'><path d='M4 5 C 80 2, 188 4, 264 5 C 266 40, 263 70, 264 96 C 174 99, 80 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>sem número</div></div>",
        _est = "nao_divulgado", "<div class='vz nd'><div class='ndt'>não divulgado</div></div>",
        "<div class='vz ag'><svg class='mold' width='268' height='100' viewBox='0 0 268 100'><path d='M4 5 C 80 2, 188 4, 264 5 C 266 40, 263 70, 264 96 C 174 99, 80 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>aguardando</div></div>"
    )
-- o par (Lula e Flávio, o mesmo tratamento): o número de cada um, ou o lugar dele tracejado
VAR _parLula =
    SWITCH (
        _c,
        "buscas", IF ( ISBLANK ( _bLula ), BLANK (), FORMAT ( _bLula, "0" ) ),
        "redes", IF ( ISBLANK ( _rLula ), BLANK (), SWITCH ( TRUE (), ABS ( _rLula ) >= 10000000, FORMAT ( _rLula / 1000000, "0.0" ), ABS ( _rLula ) >= 1000000, FORMAT ( _rLula / 1000000, "0.0" ), ABS ( _rLula ) >= 1000, FORMAT ( _rLula / 1000, "#,0" ), FORMAT ( _rLula, "#,0" ) ) ),
        "pesquisas", IF ( _pN > 0, FORMAT ( _pL, "0.0" ), BLANK () )
    )
VAR _parFlavio =
    SWITCH (
        _c,
        "buscas", IF ( ISBLANK ( _bFlavio ), BLANK (), FORMAT ( _bFlavio, "0" ) ),
        "redes", IF ( ISBLANK ( _rFlavio ), BLANK (), SWITCH ( TRUE (), ABS ( _rFlavio ) >= 10000000, FORMAT ( _rFlavio / 1000000, "0.0" ), ABS ( _rFlavio ) >= 1000000, FORMAT ( _rFlavio / 1000000, "0.0" ), ABS ( _rFlavio ) >= 1000, FORMAT ( _rFlavio / 1000, "#,0" ), FORMAT ( _rFlavio, "#,0" ) ) ),
        "pesquisas", IF ( _pN > 0, FORMAT ( _pF, "0.0" ), BLANK () )
    )
-- a unidade fica fora do número (menor), para o par caber na metade do cartão
VAR _sufLula = SWITCH ( _c, "redes", SWITCH ( TRUE (), ABS ( _rLula ) >= 1000000, " mi", ABS ( _rLula ) >= 1000, " mil", "" ), "pesquisas", "%", "" )
VAR _sufFlavio = SWITCH ( _c, "redes", SWITCH ( TRUE (), ABS ( _rFlavio ) >= 1000000, " mi", ABS ( _rFlavio ) >= 1000, " mil", "" ), "pesquisas", "%", "" )
VAR _vazioMeio =
    SWITCH (
        TRUE (),
        _parado, "<svg class='mold' width='128' height='100' viewBox='0 0 128 100'><path d='M4 5 C 38 2, 90 4, 124 5 C 126 40, 123 70, 124 96 C 83 99, 38 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>sem número</div>",
        _est = "nao_divulgado", "<div class='ndt'>" & IF ( _c = "pesquisas", "nenhuma", "não saiu" ) & "</div>",
        "<svg class='mold' width='128' height='100' viewBox='0 0 128 100'><path d='M4 5 C 38 2, 90 4, 124 5 C 126 40, 123 70, 124 96 C 83 99, 38 97, 5 95 C 3 60, 6 30, 4 5 Z' filter='url(#rbu)'/></svg><div class='mao'>aguardando</div>"
    )
VAR _par =
    "<div class='vz par'>"
        & "<div class='lado" & IF ( ISBLANK ( _parLula ), " vazio", "" ) & "'><div class='rot lula-esc'>LULA</div>"
            & IF ( ISBLANK ( _parLula ), _vazioMeio, "<div class='nl'><span class='num lula'>" & _parLula & "</span><small>" & _sufLula & "</small></div>" ) & "</div>"
        & "<div class='lado" & IF ( ISBLANK ( _parFlavio ), " vazio", "" ) & "'><div class='rot flavio-esc'>FLÁVIO</div>"
            & IF ( ISBLANK ( _parFlavio ), _vazioMeio, "<div class='nl'><span class='num flavio'>" & _parFlavio & "</span><small>" & _sufFlavio & "</small></div>" ) & "</div>"
    & "</div>"
VAR _um =
    SWITCH (
        _c,
        "audiencia",
            IF (
                _est IN { "previa", "consolidado" },
                "<div class='vz um'><span class='num'>" & FORMAT ( IF ( _est = "consolidado", _audC, _audP ), "0.0" ) & "</span><span class='un'>"
                    & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _un, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span><span class='tag'>" & IF ( _est = "consolidado", "CONSOLIDADO", "PRÉVIA" ) & "</span></div>",
                _vazioUm
            ),
        "streaming",
            IF (
                _est = "publicado",
                "<div class='vz um'><span class='num'>" & SWITCH ( TRUE (), ABS ( _str ) >= 10000000, FORMAT ( _str / 1000000, "0.0" ), ABS ( _str ) >= 1000000, FORMAT ( _str / 1000000, "0.00" ), ABS ( _str ) >= 1000, FORMAT ( _str / 1000, "#,0" ), FORMAT ( _str, "#,0" ) ) & "</span><span class='un'>" & TRIM ( SWITCH ( TRUE (), ABS ( _str ) >= 1000000, " mi", ABS ( _str ) >= 1000, " mil", "" ) )
                    & IF ( _str >= 1000, " de ", "" ) & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _un, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span></div>",
                _vazioUm
            )
    )
VAR _valor = IF ( _c IN { "audiencia", "streaming" }, _um, _par )
VAR _fonteTxt =
    SWITCH (
        TRUE (),
        _c = "pesquisas" && _pN > 0,
            "Fonte: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _pInst, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " · campo de " & FORMAT ( _pIni, "dd/MM" ) & " a " & FORMAT ( _pFim, "dd/MM" ) & ", registro no TSE",
        _chegou || _est = "parcial", "Fonte: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fonte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ),
        "" -- sem número, a fonte esperada fica só no dossiê do cartão (tela mais limpa, 23/10/2026)
    )
-- a régua da Band (a mesma medida) ou, nas pesquisas, o antes
VAR _refAud = IF ( _est = "previa", _bandP, _bandC )
VAR _vAud = IF ( _est = "consolidado", _audC, IF ( _est = "previa", _audP, BLANK () ) )
VAR _escS = MAX ( _bandS, IF ( _est = "publicado", _str, 0 ) ) -- geometria
VAR _barras =
    SWITCH (
        _c,
        "audiencia",
            VAR _esc = MAX ( _refAud, COALESCE ( _vAud, 0 ) ) -- geometria
            RETURN
                "<div class='br'><span class='bn'>Globo</span>"
                    & IF ( ISBLANK ( _vAud ), "<i class='g oca'></i>", "<i class='g barra-x' style='width:" & FORMAT ( _vAud / _esc * 140, "0.0##", "en-US" ) & "px'></i>" ) & "</div>"
                    & "<div class='br'><span class='bn'>Band</span><i class='b barra-x' style='width:" & FORMAT ( _refAud / _esc * 140, "0.0##", "en-US" ) & "px'></i><b class='num'>"
                    & IF ( _refAud = INT ( _refAud ), FORMAT ( _refAud, "0" ), FORMAT ( _refAud, "0.0" ) ) & "</b></div>",
        "streaming",
            "<div class='br'><span class='bn'>Globo</span>"
                & IF ( _est = "publicado", "<i class='g barra-x' style='width:" & FORMAT ( _str / _escS * 140, "0.0##", "en-US" ) & "px'></i>", "<i class='g oca'></i>" ) & "</div>"
                & "<div class='br'><span class='bn'>Band</span><i class='b barra-x' style='width:" & FORMAT ( _bandS / _escS * 140, "0.0##", "en-US" ) & "px'></i><b class='num'>"
                & _humBandS & "</b></div>"
    )
VAR _naBand = "<div class='rot'>NA BAND, " & FORMAT ( _band, "dd/MM" ) & " <span class='rq'>· "
VAR _ref =
    SWITCH (
        _c,
        "buscas",
            _naBand & "pico da noite</span></div><div class='rv'><span class='lula-esc'>Lula <b class='num'>"
                & FORMAT ( _bandBL, "0" ) & "</b></span><span class='flavio-esc'>Flávio <b class='num'>" & FORMAT ( _bandBF, "0" ) & "</b></span></div>",
        "redes",
            _naBand & "Bites, 24 horas</span></div><div class='rv'><span class='lula-esc'>Lula <b class='num'>"
                & _humBandRL & "</b></span><span class='flavio-esc'>Flávio <b class='num'>" & _humBandRF & "</b></span></div>",
        "pesquisas",
            IF (
                _aN = 0,
                "<div class='rot'>ANTES <span class='rq'>· nenhuma pesquisa entre os debates</span></div>",
                "<div class='rot'>ANTES <span class='rq'>· " & FORMAT ( _aN, "0" ) & IF ( _aN = 1, " pesquisa, de ", " pesquisas, de " ) & FORMAT ( _aIni, "dd" ) & " a "
                    & FORMAT ( _aFim, "dd/MM" ) & "</span></div><div class='rv'><span class='lula-esc'>Lula <b class='num'>" & FORMAT ( _aL, "0.0" )
                    & "%</b></span><span class='flavio-esc'>Flávio <b class='num'>" & FORMAT ( _aF, "0.0" ) & "%</b></span></div>"
            ),
        "audiencia", _naBand & IF ( _est = "previa", "prévia", "consolidado" ) & "</span></div>" & _barras,
        "streaming", _naBand & "YouTube da Band</span></div>" & _barras
    )
VAR _notaP =
    IF (
        _c = "pesquisas" && NOT _chegou && NOT _parado,
        -- com o cartão em "nenhuma" (as de sábado já saíram), a nota diz o fato; antes, o que se esperava
        "<div class='np'>"
            & IF (
                _est = "nao_divulgado",
                "Nenhuma pesquisa nacional teve o campo inteiro depois do debate.",
                "Provavelmente só as últimas de sábado, véspera da eleição, e talvez nenhuma."
            )
            & IF ( _xN > 0, " " & FORMAT ( _xN, "0" ) & IF ( _xN = 1, " atravessa", " atravessam" ) & " o dia do debate e fica" & IF ( _xN = 1, "", "m" ) & " fora.", "" ) & "</div>",
        ""
    )
-- 3 · Geometria (cartões de 300 px com 30 de vão, pendurados na fita em y 72; o topo do cartão em y 88, no CSS)
VAR _x = ( _pos - 1 ) * 330 -- geometria
VAR _atraso = 400 + _pos * 140 -- geometria
-- 4 · Marcação
RETURN
    IF (
        NOT ISBLANK ( _est ),
        "<div class='tela t26c'>"
            & "<div class='cx " & _est & "' style='left:" & _x & "px;animation-delay:" & _atraso & "ms'>"
                & "<i class='tk'></i><i class='ic ic-" & _c & "'></i>"
                & "<div class='qd'>" & _quando & "</div>"
                & "<div class='ti'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rot, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
                & "<div class='me'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _med, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div>"
                & _valor & _notaP
                & IF ( _fonteTxt = "", "", "<div class='fo'>" & _fonteTxt & "</div>" )
                & "<div class='ref'>" & _ref & "</div>"
            & "</div>"
        & "</div>"
    )
