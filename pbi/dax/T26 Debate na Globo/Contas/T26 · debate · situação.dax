/*
@pasta: T26 Debate na Globo\Contas
@formato: texto
@descricao: Situação do debate na linha 'debate' do arquivo: marcado, no_ar, realizado, adiado ou cancelado (outro texto ou vazio conta como marcado).
@oraculo: marcado (23/10/2026, 19h45)
*/
VAR _s = LOWER ( TRIM ( CALCULATE ( MAX ( 'T26 Debate Globo'[Situação] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "debate" ) ) )
RETURN
    SWITCH (
        TRUE (),
        _s IN { "no_ar", "no ar", "ao vivo", "ao_vivo" }, "no_ar",
        _s IN { "realizado", "adiado", "cancelado" }, _s,
        "marcado"
    )
