/*
@pasta: T26 Debate na Globo\Contas
@formato: dd/MM/yyyy HH:mm
@descricao: Hora prevista para o fim (o Jornal da Globo, 23h30; a Globo não informou o fim).
@oraculo: 23/10/2026 23:30
*/
CALCULATE ( MAX ( 'T26 Debate Globo'[Previsto] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Chave] = "fim" )
