/*
@pasta: T26 Debate na Globo\Contas
@formato: 0
@descricao: Quantos blocos com tempo marcado o arquivo traz (grupo regra, com valor).
@oraculo: 4
*/
CALCULATE ( COUNTROWS ( 'T26 Debate Globo' ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "regra", NOT ISBLANK ( 'T26 Debate Globo'[Valor] ) ) + 0
