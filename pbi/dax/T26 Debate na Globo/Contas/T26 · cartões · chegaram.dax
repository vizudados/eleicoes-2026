/*
@pasta: T26 Debate na Globo\Contas
@formato: 0
@descricao: Quantos cartões já têm o número (publicado, prévia ou consolidado).
@oraculo: 0
*/
COUNTROWS (
    FILTER (
        CALCULATETABLE ( VALUES ( 'T26 Debate Globo'[Cartão] ), REMOVEFILTERS ( 'T26 Debate Globo' ), 'T26 Debate Globo'[Grupo] = "metrica" ),
        CALCULATE ( [T26 · cartão · estado] ) IN { "publicado", "previa", "consolidado" }
    )
) + 0
