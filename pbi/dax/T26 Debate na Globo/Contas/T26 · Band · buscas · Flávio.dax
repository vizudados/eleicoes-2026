/*
@pasta: T26 Debate na Globo\Contas
@formato: 0
@descricao: Pico de Flávio na noite do debate da Band (18/10, das 20h à meia-noite) no Google Trends, consulta H3 (tópicos, hora a hora, 17 a 24/10): a mesma consulta que dá o pico da noite da Globo, para a régua comparar dentro dela.
@oraculo: 51 (22h)
*/
VAR _d = [T26 · Band · data]
RETURN
    CALCULATE (
        MAX ( 'Trends tempo'[Índice] ),
        REMOVEFILTERS ( 'Trends tempo' ),
        'Trends tempo'[Série] = "Flávio Bolsonaro [tópico | H3]",
        'Trends tempo'[Momento] >= _d + TIME ( 20, 0, 0 ),
        'Trends tempo'[Momento] < _d + 1
    )
