/*
@pasta: T26 Debate na Globo\Contas
@formato: 0
@descricao: Pesquisas do 2º turno (votos totais, registradas no TSE) com o campo inteiro entre os dois debates (começa depois da Band, termina antes do dia da Globo).
@oraculo: 5
*/
VAR _band = [T26 · Band · data]
VAR _globo = [T26 · debate · dia]
RETURN
    CALCULATE (
        COUNTROWS ( Pesquisa ),
        REMOVEFILTERS ( Pesquisa ),
        Pesquisa[Cenário] = "2º turno",
        Pesquisa[Tipo] = "totais",
        NOT ISBLANK ( Pesquisa[Lula] ),
        NOT ISBLANK ( Pesquisa[Flavio] ),
        Pesquisa[Campo início] > _band,
        Pesquisa[Campo fim] < _globo
    ) + 0
