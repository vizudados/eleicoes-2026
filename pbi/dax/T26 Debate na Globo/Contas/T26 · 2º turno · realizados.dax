/*
@pasta: T26 Debate na Globo\Contas
@formato: 0
@descricao: Quantos debates do 2º turno aconteceram antes deste (tabela Debate, data anterior ao dia do debate da Globo; a própria Globo, linha da tabela desde 24/10/2026, fica fora).
@oraculo: 1 (Band, 18/10)
*/
VAR _globo = [T26 · debate · dia]
RETURN
    CALCULATE (
        COUNTROWS ( Debate ),
        REMOVEFILTERS ( Debate ),
        Debate[Turno] = 2,
        LEFT ( Debate[Observação], 9 ) = "REALIZADO",
        Debate[Data] < _globo || ISBLANK ( _globo )
    ) + 0
