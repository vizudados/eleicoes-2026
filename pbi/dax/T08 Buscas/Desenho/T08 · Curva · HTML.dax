/*
@pasta: T08 Buscas\Desenho
@formato: texto
@descricao: Fundo da curva diária das buscas (consulta T2, os candidatos como tópico, 01/08 a 22/10): título, grade, datas, as duas linhas que se desenham, o pico no dia do 1º turno e o dia em que Flávio passou Lula depois do debate, com notas à mão. As faixas de cada dia (mouse e dossiê) são outro visual (T08 · Dias · HTML), na mesma caixa e escala.
*/
-- 1 · Leituras
VAR _todos =
    ADDCOLUMNS (
        VALUES ( 'Trends tempo'[DataTexto] ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
VAR _dias = FILTER ( _todos, NOT ISBLANK ( [@l] ) ) /* lista */
VAR _pD = [T08 · pico · data]
VAR _pL = [T08 · pico · Lula]
VAR _pF = [T08 · pico · Flávio]
VAR _vD = [T08 · virada · data]
VAR _vL = [T08 · virada · Lula]
VAR _vF = [T08 · virada · Flávio]
VAR _deb = [T08 · debate · data]
VAR _antes = [T08 · Flávio à frente antes do debate · último dia]
-- 2 · Textos
VAR _txtMan =
    "O pico foi no dia do 1º turno; " & IF ( DATEDIFF ( _deb, _vD, DAY ) = 1, "um dia depois do debate", "depois do debate" )
        & ", Flávio passou Lula pela primeira vez desde " & FORMAT ( _antes, "dd/MM" ) & "."
-- 3 · Geometria (x: 01/08 a 22/10 em 40–1090; y: índice 0 a 100 em 345–30; o svg começa em y 80)
VAR _ini = DATE ( 2026, 8, 1 )
VAR _f = "0.0"
VAR _pts =
    ADDCOLUMNS (
        _dias,
        "@x", 40 + DATEDIFF ( _ini, [@d], DAY ) / 82 * 1050, -- geometria
        "@yl", 345 - [@l] * 3.15, -- geometria
        "@yf", 345 - [@f] * 3.15 -- geometria
    )
VAR _linhaL = "M" & CONCATENATEX ( _pts, FORMAT ( [@x], _f, "en-US" ) & " " & FORMAT ( [@yl], _f, "en-US" ), " L", [@d], ASC )
VAR _linhaF = "M" & CONCATENATEX ( _pts, FORMAT ( [@x], _f, "en-US" ) & " " & FORMAT ( [@yf], _f, "en-US" ), " L", [@d], ASC )
VAR _xP = 40 + DATEDIFF ( _ini, _pD, DAY ) / 82 * 1050 -- geometria
VAR _xV = 40 + DATEDIFF ( _ini, _vD, DAY ) / 82 * 1050 -- geometria
VAR _xDeb = 40 + DATEDIFF ( _ini, _deb, DAY ) / 82 * 1050 -- geometria
VAR _yPL = 345 - _pL * 3.15 -- geometria
VAR _yPF = 345 - _pF * 3.15 -- geometria
VAR _yVL = 345 - _vL * 3.15 -- geometria
VAR _yVF = 345 - _vF * 3.15 -- geometria
VAR _grade =
    CONCATENATEX (
        { 0, 50, 100 },
        "<line x1='40' x2='1090' y1='" & FORMAT ( 345 - [Value] * 3.15, _f, "en-US" ) & "' y2='"
            & FORMAT ( 345 - [Value] * 3.15, _f, "en-US" ) & "' class='g'/><text x='30' y='"
            & FORMAT ( 350 - [Value] * 3.15, _f, "en-US" ) & "' class='ex' text-anchor='end'>" & [Value] & "</text>",
        ""
    )
VAR _datas =
    CONCATENATEX (
        { DATE ( 2026, 8, 1 ), DATE ( 2026, 9, 1 ), DATE ( 2026, 9, 15 ), DATE ( 2026, 10, 22 ) },
        "<text x='" & FORMAT ( 40 + DATEDIFF ( _ini, [Value], DAY ) / 82 * 1050, _f, "en-US" )
            & "' y='372' class='ex' text-anchor='middle'>" & FORMAT ( [Value], "dd/MM" ) & "</text>",
        ""
    )
VAR _xCamp = 40 + DATEDIFF ( _ini, DATE ( 2026, 8, 16 ), DAY ) / 82 * 1050 -- geometria
-- 4 · Marcação
VAR _svg =
    "<svg width='1130' height='400' viewBox='0 0 1130 400'>"
        & _grade & _datas
        & "<text x='" & FORMAT ( _xCamp, _f, "en-US" ) & "' y='372' class='ex' text-anchor='middle'>16/08 · campanha</text>"
        & "<line x1='" & FORMAT ( _xP, _f, "en-US" ) & "' x2='" & FORMAT ( _xP, _f, "en-US" ) & "' y1='22' y2='350' class='ev'/>"
        & "<text x='" & FORMAT ( _xP, _f, "en-US" ) & "' y='372' class='ex b' text-anchor='middle'>1º turno · "
            & FORMAT ( _pD, "dd/MM" ) & "</text>"
        & "<line x1='" & FORMAT ( _xDeb, _f, "en-US" ) & "' x2='" & FORMAT ( _xDeb, _f, "en-US" ) & "' y1='150' y2='350' class='ev'/>"
        & "<text x='" & FORMAT ( _xDeb - 4, _f, "en-US" ) & "' y='388' class='ex b' text-anchor='middle'>debate</text>"
        & "<path d='" & _linhaF & "' pathLength='1' class='lf traco' filter='url(#rbu)' style='animation-delay:.4s'/>"
        & "<path d='" & _linhaL & "' pathLength='1' class='ll traco' filter='url(#rbu)' style='animation-delay:.6s'/>"
        & "<circle cx='" & FORMAT ( _xP, _f, "en-US" ) & "' cy='" & FORMAT ( _yPL, _f, "en-US" ) & "' r='7' class='pl brota d16'/>"
        & "<circle cx='" & FORMAT ( _xP, _f, "en-US" ) & "' cy='" & FORMAT ( _yPF, _f, "en-US" ) & "' r='7' class='pf brota d16'/>"
        & "<circle cx='" & FORMAT ( _xV, _f, "en-US" ) & "' cy='" & FORMAT ( _yVL, _f, "en-US" ) & "' r='6' class='pl brota d16'/>"
        & "<circle cx='" & FORMAT ( _xV, _f, "en-US" ) & "' cy='" & FORMAT ( _yVF, _f, "en-US" ) & "' r='6' class='pf brota d16'/>"
    & "</svg>"
VAR _rotulos =
    "<div class='rotulo e lula-esc entra d16' style='right:" & FORMAT ( 1130 - _xP + 14, _f, "en-US" ) & "px;top:"
        & FORMAT ( 80 + _yPL - 14, _f, "en-US" ) & "px'>Lula " & _pL & "</div>"
        & "<div class='rotulo e flavio-esc entra d16' style='right:" & FORMAT ( 1130 - _xP + 14, _f, "en-US" ) & "px;top:"
        & FORMAT ( 80 + _yPF - 14, _f, "en-US" ) & "px'>Flávio " & _pF & "</div>"
        & "<div class='mao entra d16' style='left:" & FORMAT ( _xP - 330, _f, "en-US" ) & "px;top:"
        & FORMAT ( 80 + _yPL - 18, _f, "en-US" ) & "px;transform:rotate(-3deg)'>o dia da eleição</div>"
VAR _virada =
    "<div class='mao entra d16' style='left:" & FORMAT ( _xP + 40, _f, "en-US" ) & "px;top:150px;transform:rotate(-2deg)'>Flávio passa Lula</div>"
        & "<div class='rotulo entra d16' style='left:" & FORMAT ( _xP + 40, _f, "en-US" ) & "px;top:188px'><span class='flavio-esc'>Flávio "
        & _vF & "</span> <span class='lula-esc'>Lula " & _vL & "</span></div>"
        & "<div class='seta e entra d16' style='left:" & FORMAT ( _xV - 64, _f, "en-US" ) & "px;top:"
        & FORMAT ( 80 + _yVF - 54, _f, "en-US" ) & "px;width:56px;height:50px;transform:scaleX(-1)'></div>"
RETURN
    "<div class='tela t08c'>"
        & "<div class='cab'><div class='sob sobe'>Quanto cada um foi buscado, dia a dia · índice de 0 a 100, os candidatos como tópico</div>"
        & "<div class='man sobe d2'>" & _txtMan & "</div></div>"
        & _svg & _rotulos & _virada
        & "<div class='leg entra d12'><b><i style='background:var(--vermelho)'></i>Lula</b>"
        & "<b><i style='background:var(--azul)'></i>Flávio</b>"
        & "100 = o dia de mais buscas na consulta, não o número de buscas · 22/10 ainda em curso na coleta · passe o mouse num dia</div>"
    & "</div>"
