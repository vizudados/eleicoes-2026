/*
@pasta: T08 Buscas\Desenho
@formato: texto
@descricao: Texto para leitor de tela do dossiê de um dia (do Brasil ou do estado clicado nos cartões).
*/
IF (
    NOT ISBLANK ( [T08 · dia · Lula] ),
    FORMAT ( [T08 · dia · data], "dd/MM" )
        & IF ( NOT ISBLANK ( [T08 · escolha · UF] ), ", " & [T08 · UF · nome] )
        & ": índice de Lula " & [T08 · dia · Lula] & " e de Flávio " & [T08 · dia · Flávio]
        & IF ( NOT ISBLANK ( [T08 · escolha · UF] ), ", de 0 a 100 dentro do estado" ) & "."
)
