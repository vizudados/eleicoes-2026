/*
@pasta: T08 Buscas\Desenho
@formato: texto
@descricao: Texto para leitor de tela dos quadrados do mapa (um por UF).
*/
IF (
    ISBLANK ( [Período · escolhido] ),
    "Mapa de quadrados com as " & [T08 · UFs] & " unidades da federação: a barra divide as buscas entre Lula e Flávio; o fundo mais escuro marca mais interesse. Passe o mouse num estado.",
    IF (
        [T08 · UFs] = 0,
        "Mapa de quadrados das unidades da federação, " & [Período · nome] & ": ainda sem dado de buscas. Passe o mouse num estado.",
        "Mapa de quadrados com as " & [T08 · UFs] & " unidades da federação, " & [Período · nome] & ": a barra divide as buscas entre Lula e Flávio no período. Passe o mouse num estado."
    )
)
