/*
@pasta: T08 Buscas\Desenho
@formato: texto
@descricao: Uma faixa por dia da série T2 (grão 'Trends tempo'[DataTexto]) sobre a curva de T08 · Curva · HTML, na mesma escala: no mouse aparecem a linha do dia e os dois pontos; cada faixa abre o dossiê ttT08Dia. Vazio nas linhas por hora e nas outras séries.
*/
-- 1 · Leituras
VAR _d = [T08 · dia · data]
VAR _l = [T08 · dia · Lula]
VAR _fl = [T08 · dia · Flávio]
-- 3 · Geometria (x: 01/08 a 22/10 em 40–1090; y: índice em 345–30 no svg que começa em y 80; a faixa começa em y 100)
VAR _x = 40 + DATEDIFF ( DATE ( 2026, 8, 1 ), _d, DAY ) / 84 * 1050 - 6.5 -- geometria
VAR _yl = 80 + 345 - _l * 3.15 - 100 - 5.5 -- geometria
VAR _yf = 80 + 345 - _fl * 3.15 - 100 - 5.5 -- geometria
-- 4 · Marcação
RETURN
    IF (
        NOT ISBLANK ( _l ),
        "<div class='tela t08d'><div class='dia' style='left:" & FORMAT ( _x, "0.0", "en-US" ) & "px'><i class='v'></i>"
            & "<i class='m mf' style='top:" & FORMAT ( _yf, "0.0", "en-US" ) & "px'></i>"
            & "<i class='m ml' style='top:" & FORMAT ( _yl, "0.0", "en-US" ) & "px'></i></div></div>"
    )
