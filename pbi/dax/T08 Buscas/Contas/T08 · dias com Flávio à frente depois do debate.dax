/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Dias depois do debate de 18/10 em que Flávio teve índice T2 maior que Lula (19/10 e 22/10; 22/10 é dia parcial na coleta).
@oraculo: 2
*/
VAR _deb = [T08 · debate · data]
RETURN
    COUNTROWS (
        FILTER (
        ADDCOLUMNS (
            CALCULATETABLE ( VALUES ( 'Trends tempo'[Momento] ), REMOVEFILTERS ( 'Trends tempo' ), 'Trends tempo'[Série] = "Lula [tópico | T2]" ),
            "@l", CALCULATE ( MAX ( 'Trends tempo'[Índice] ), REMOVEFILTERS ( 'Trends tempo' ), 'Trends tempo'[Momento] = EARLIER ( 'Trends tempo'[Momento] ), 'Trends tempo'[Série] = "Lula [tópico | T2]" ),
            "@f", CALCULATE ( MAX ( 'Trends tempo'[Índice] ), REMOVEFILTERS ( 'Trends tempo' ), 'Trends tempo'[Momento] = EARLIER ( 'Trends tempo'[Momento] ), 'Trends tempo'[Série] = "Flávio Bolsonaro [tópico | T2]" )
        ),
        'Trends tempo'[Momento] > _deb && [@f] > [@l]
    )
    ) + 0
