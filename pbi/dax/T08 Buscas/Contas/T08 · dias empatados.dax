/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Dias da campanha (de 16/08 ao fim da curva) em que os dois tiveram o mesmo índice (no estado, 0 a 0 é busca abaixo do mínimo do Google, não empate de verdade), na série que a curva mostra (Brasil, consulta T2; com um estado clicado, a consulta U2 dele, nos mesmos dias).
@oraculo: Brasil 2 (29/08 e 07/10); Distrito Federal 4
*/
VAR _ini = [T08 · campanha · início]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
RETURN
    COUNTROWS ( FILTER ( _dias, [@d] >= _ini && [@l] = [@f] ) ) + 0
