/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Dias da campanha na curva: de 16/08 (T08 · campanha · início) ao último dia da curva (22/10). Antes de 24/10/2026 a conta começava em 01/08, o começo da consulta, e dava 83.
@oraculo: 68
*/
VAR _ini = [T08 · campanha · início]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
RETURN
    COUNTROWS ( FILTER ( _dias, [@d] >= _ini ) ) + 0
