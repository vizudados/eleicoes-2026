/*
@pasta: T08 Buscas\Contas
@formato: texto
@descricao: A sigla da UF clicada no mapa (filtro cruzado de T08_Mapa_Ufs, grão UF[UF]); vazia sem clique e dentro do próprio mapa. Vale em qualquer período (o interesse do 2º turno diz que a UF tem dado; a parte de cada um pode faltar no período sem dado).
*/
IF (
    ISFILTERED ( UF[UF] ) && NOT ISINSCOPE ( UF[UF] ) && HASONEVALUE ( UF[UF] ) && NOT ISBLANK ( [T08 · UF · interesse médio] ),
    SELECTEDVALUE ( UF[UF] )
)
