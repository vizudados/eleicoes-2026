/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Índice de Lula no dia do debate da Band, na série que a curva mostra (Brasil, T2, ou o estado clicado, U2).
@oraculo: 47 (Brasil, T2)
*/
VAR _d = [T08 · debate · dia no Google]
RETURN
    CALCULATE (
        [T08 · dia · Lula],
        REMOVEFILTERS ( 'Trends tempo' ),
        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
    )
