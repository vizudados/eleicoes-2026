/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Maior índice dos dois na curva do segundo dia depois do pico até o fim (06 a 22/10): diz se a nota da virada cabe acima das linhas.
@oraculo: 49 (Brasil, T2); DF 93
*/
VAR _p = [T08 · pico · data]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@m", MAX ( [T08 · dia · Lula], [T08 · dia · Flávio] )
    )
RETURN
    MAXX ( FILTER ( _dias, [@d] > _p + 1 ), [@m] )
