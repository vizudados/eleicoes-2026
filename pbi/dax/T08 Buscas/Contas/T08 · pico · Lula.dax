/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Índice de Lula no dia do pico da curva (Brasil, T2, ou o estado clicado, U2).
@oraculo: FONTES: 04/10 Lula 100 × Flávio 79 → 100 (Brasil, T2); RO 99
*/
VAR _d = [T08 · pico · data]
RETURN
    CALCULATE (
        [T08 · dia · Lula],
        REMOVEFILTERS ( 'Trends tempo' ),
        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
    )
