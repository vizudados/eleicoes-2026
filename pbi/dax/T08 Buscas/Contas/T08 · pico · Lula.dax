/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Índice T2 de Lula no dia do pico da série.
@oraculo: FONTES: 04/10 Lula 100 × Flávio 79 → 100
*/
VAR _d = [T08 · pico · data]
RETURN
    CALCULATE (
        MAX ( 'Trends tempo'[Índice] ),
        REMOVEFILTERS ( 'Trends tempo' ),
        'Trends tempo'[Série] = "Lula [tópico | T2]",
        'Trends tempo'[Momento] = _d
    )
