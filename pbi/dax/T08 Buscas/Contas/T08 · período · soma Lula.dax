/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Soma dos índices diários de Lula nos dias da curva dentro do período escolhido no filtro Período (o dia do debate conta como depois), na série que a curva mostra (Brasil, T2, ou o estado clicado, U2); vazio sem período (base da parte de cada um no período).
@oraculo: Antes da Band, Brasil (T2): Lula 359, Flávio 278
*/
VAR _ini = [Período · início]
VAR _fim = [Período · fim]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
RETURN
    IF ( NOT ISBLANK ( _ini ), SUMX ( FILTER ( _dias, [@d] >= _ini && [@d] <= _fim ), [@l] ) )
