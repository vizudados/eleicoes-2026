/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Maior parte (%) de Lula nas buscas entre os dois, entre as UFs, no 2º turno.
@oraculo: 58 (MA, PI, RN)
*/
MAXX ( FILTER ( ADDCOLUMNS (
        CALCULATETABLE ( VALUES ( UF[UF] ), REMOVEFILTERS ( UF ), UF[Tipo] = "UF" ),
        "@l", [T08 · UF · Lula],
        "@f", [T08 · UF · Flávio]
    ), NOT ISBLANK ( [@l] ) ), [@l] )
