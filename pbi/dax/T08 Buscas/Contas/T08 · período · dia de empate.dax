/*
@pasta: T08 Buscas\Contas
@formato: dd/MM
@descricao: Último dia de empate entre os dois, nos dias da curva dentro do período escolhido no filtro Período (o dia do debate conta como depois), na série que a curva mostra (Brasil, T2, ou o estado clicado, U2); vazio sem período (o texto usa quando é um dia só).
*/
VAR _ini = [T08 · período · início no Google]
VAR _fim = [T08 · período · fim no Google]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
RETURN
    IF ( NOT ISBLANK ( _ini ), MAXX ( FILTER ( _dias, [@d] >= _ini && [@d] <= _fim && [@l] = [@f] ), [@d] ) )
