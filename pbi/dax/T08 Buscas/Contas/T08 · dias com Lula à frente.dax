/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Dias em que Lula teve índice maior que Flávio na série T2.
@oraculo: 76
*/
COUNTROWS (
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE ( VALUES ( 'Trends tempo'[DataTexto] ), REMOVEFILTERS ( 'Trends tempo' ), 'Trends tempo'[Série] = "Lula [tópico | T2]" ),
            "@l", CALCULATE ( MAX ( 'Trends tempo'[Índice] ), REMOVEFILTERS ( 'Trends tempo' ), 'Trends tempo'[DataTexto] = EARLIER ( 'Trends tempo'[DataTexto] ), 'Trends tempo'[Série] = "Lula [tópico | T2]" ),
            "@f", CALCULATE ( MAX ( 'Trends tempo'[Índice] ), REMOVEFILTERS ( 'Trends tempo' ), 'Trends tempo'[DataTexto] = EARLIER ( 'Trends tempo'[DataTexto] ), 'Trends tempo'[Série] = "Flávio Bolsonaro [tópico | T2]" )
        ),
        [@l] > [@f]
    )
) + 0
