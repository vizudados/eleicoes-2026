/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Posição do dia entre os dias da campanha pelo índice de Lula (1 = o dia de mais buscas por ele).
*/
VAR _v = [T08 · dia · Lula]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@v",
            CALCULATE (
                MAX ( 'Trends tempo'[Índice] ),
                REMOVEFILTERS ( 'Trends tempo' ),
                'Trends tempo'[DataTexto] = EARLIER ( 'Trends tempo'[DataTexto] ),
                'Trends tempo'[Série] = "Lula [tópico | T2]"
            )
    )
RETURN
    IF ( NOT ISBLANK ( _v ), COUNTROWS ( FILTER ( _dias, [@v] > _v ) ) + 1 )
