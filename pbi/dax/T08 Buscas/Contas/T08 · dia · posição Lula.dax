/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Posição do dia entre os dias da campanha (de 16/08 ao fim da curva) pelo índice de Lula (1 = o dia de mais buscas por ele na campanha), na série que a curva mostra (Brasil, consulta T2; com um estado clicado, a consulta U2 dele, nos mesmos dias). Vazio fora da campanha (01 a 15/08): a manchete do dia só diz 'na campanha' de um dia da campanha.
*/
VAR _v = [T08 · dia · Lula]
VAR _d = [T08 · dia · data]
VAR _ini = [T08 · campanha · início]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@v", [T08 · dia · Lula]
    )
RETURN
    IF ( NOT ISBLANK ( _v ) && _d >= _ini, COUNTROWS ( FILTER ( _dias, [@d] >= _ini && [@v] > _v ) ) + 1 )
