/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: UFs em que Lula teve a maior parte das buscas entre os dois no 2º turno.
@oraculo: FONTES: 27 UFs
*/
COUNTROWS ( FILTER ( ADDCOLUMNS (
        CALCULATETABLE ( VALUES ( UF[UF] ), REMOVEFILTERS ( UF ), UF[Tipo] = "UF" ),
        "@l", [T08 · UF · Lula],
        "@f", [T08 · UF · Flávio]
    ), [@l] > [@f] ) ) + 0
