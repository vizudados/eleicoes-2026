/*
@pasta: T08 Buscas\Contas
@formato: dd/MM
@descricao: Último dia antes do debate em que quem passou o outro depois dele (T08 · virada · quem passa) já tinha estado na frente, na série que a curva mostra (o 'desde' da manchete).
@oraculo: 13/08 (Brasil, T2)
*/
VAR _deb = [T08 · debate · dia no Google]
VAR _quem = [T08 · virada · quem passa]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
RETURN
    IF (
        NOT ISBLANK ( _quem ),
        MAXX ( FILTER ( _dias, [@d] < _deb && IF ( _quem = "Flávio", [@f] > [@l], [@l] > [@f] ) ), [@d] )
    )
