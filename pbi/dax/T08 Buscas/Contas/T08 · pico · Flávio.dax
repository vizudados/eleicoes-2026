/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Índice de Flávio no dia do pico da curva (Brasil, T2, ou o estado clicado, U2).
@oraculo: FONTES: 04/10 Lula 100 × Flávio 79 → 79 (Brasil, T2); RO 100; RR 100
*/
VAR _d = [T08 · pico · data]
RETURN
    CALCULATE (
        [T08 · dia · Flávio],
        REMOVEFILTERS ( 'Trends tempo' ),
        'Trends tempo'[DataTexto] = FORMAT ( _d, "yyyy-MM-dd" )
    )
