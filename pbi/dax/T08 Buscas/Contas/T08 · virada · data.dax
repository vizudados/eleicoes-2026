/*
@pasta: T08 Buscas\Contas
@formato: dd/MM
@descricao: Primeiro dia depois do debate em que quem estava atrás no dia do debate (T08 · virada · quem passa) teve índice maior que o outro, na série que a curva mostra; vazio se não passou.
@oraculo: FONTES: 19/10 (Brasil, T2); DF e RJ 19/10; MG 22/10; RO nenhum
*/
VAR _deb = [T08 · debate · data]
VAR _quem = [T08 · virada · quem passa]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
RETURN
    IF (
        NOT ISBLANK ( _quem ),
        MINX ( FILTER ( _dias, [@d] > _deb && IF ( _quem = "Flávio", [@f] > [@l], [@l] > [@f] ) ), [@d] )
    )
