/*
@pasta: T08 Buscas\Contas
@formato: 0
@descricao: Dias da curva no período escolhido (nos dias da curva dentro do período escolhido no filtro Período (o dia do debate conta como depois), na série que a curva mostra (Brasil, T2, ou o estado clicado, U2); vazio sem período).
@oraculo: Antes da Band 13; Depois da Band 3; Antes da Globo 2; Depois da Globo 0
*/
VAR _ini = [T08 · período · início no Google]
VAR _fim = [T08 · período · fim no Google]
VAR _dias =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( 'Trends tempo'[DataTexto] ),
            REMOVEFILTERS ( 'Trends tempo' ),
            'Trends tempo'[Série] = "Lula [tópico | T2]"
        ),
        "@d", [T08 · dia · data],
        "@l", [T08 · dia · Lula],
        "@f", [T08 · dia · Flávio]
    )
RETURN
    IF ( NOT ISBLANK ( _ini ), COUNTROWS ( FILTER ( _dias, [@d] >= _ini && [@d] <= _fim ) ) + 0 )
