/*
@pasta: T00 Capa\Contas
@formato: #,0
@descricao: Municípios em que Lula estava à frente em 2022 e Flávio ficou à frente em 2026 (margem do PT passou de positiva a negativa).
*/
VAR _m =
    ADDCOLUMNS (
        CALCULATETABLE ( VALUES ( 'Município'[CodIBGE] ), REMOVEFILTERS ( 'UF' ) ),
        "@m22", CALCULATE ( SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ), 'Ano'[Ano] = 2022 ),
        "@m26", CALCULATE ( SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ), 'Ano'[Ano] = 2026 )
    )
RETURN
    COUNTROWS ( FILTER ( _m, [@m22] > 0 && [@m26] < 0 ) ) + 0
