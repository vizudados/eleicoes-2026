/*
@pasta: T03 Lula\Contas
@formato: 0.0%
@descricao: Parcela dos votos de Lula na UF (soma dos municípios) que saiu do município marcado (0–1).
*/
VAR _s = [T03 · UF do município]
RETURN
    IF (
        NOT ISBLANK ( _s ),
        DIVIDE ( [T03 · votos (municípios)], CALCULATE ( [T03 · votos (municípios)], REMOVEFILTERS ( 'Município' ), REMOVEFILTERS ( 'UF' ), 'Município'[UF] = _s ) )
    )
