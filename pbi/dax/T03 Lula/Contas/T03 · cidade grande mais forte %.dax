/*
@pasta: T03 Lula\Contas
@formato: 0.0%
@descricao: % do candidato na cidade grande mais forte (0–1).
*/
VAR _gr =
    ADDCOLUMNS (
        CALCULATETABLE ( VALUES ( 'Município'[Rótulo] ), 'Município'[População] >= 100000 ),
        "@p", [T03 · % (municípios)],
        "@pop", CALCULATE ( SUM ( 'Município'[População] ) )
    )
VAR _top = TOPN ( 1, _gr, [@p], DESC, 'Município'[Rótulo], ASC )
RETURN
    MAXX ( _top, [@p] )
