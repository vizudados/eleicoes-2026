/*
@pasta: T03 Lula\Contas
@formato: #,0
@descricao: Eleitores aptos em 2026 somados nos municípios (sem o exterior).
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'Município segundo turno'[Aptos] ), 'Município segundo turno'[Ano] = 2026 ), CALCULATE ( SUM ( 'Município ano'[Aptos] ), 'Município ano'[Ano] = 2026 ) )
