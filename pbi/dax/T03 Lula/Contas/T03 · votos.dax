/*
@pasta: T03 Lula\Contas
@formato: #,0
@descricao: Votos de Lula (número 13) no 1º turno de 2026, no recorte (com o exterior no Brasil).
@oraculo: paginas[3].votos
*/
IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'UF segundo turno'[VotosPT] ), 'UF segundo turno'[Ano] = 2026 ), CALCULATE ( SUM ( 'Candidato UF'[Votos] ), 'Candidato UF'[Ano] = 2026, 'Candidato UF'[Número] = 13 ) )
