/*
@pasta: T03 Lula\Contas
@formato: 0%
@descricao: Parcela dos votos de Lula no recorte (soma dos municípios) que veio da UF da linha (0–1): a lista de estados da origem quando o filtro escolheu vários. Tira só as colunas da UF da linha; o recorte do filtro ('UF'[Caminho]) fica.
*/
DIVIDE (
    [T03 · votos (municípios)],
    CALCULATE ( [T03 · votos (municípios)], REMOVEFILTERS ( 'UF'[UF], 'UF'[Nome], 'UF'[Ordem] ) )
)
