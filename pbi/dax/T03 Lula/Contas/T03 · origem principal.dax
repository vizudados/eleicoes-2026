/*
@pasta: T03 Lula\Contas
@formato: texto
@descricao: Região (no Brasil) ou município (numa UF) que mais deu votos ao candidato.
@oraculo: paginas[3].regioes[0].regiao
*/
VAR _reg =
    ADDCOLUMNS ( VALUES ( 'UF'[Região] ), "@v", [T03 · votos (municípios)], "@p", [T03 · % (municípios)] )
VAR _mun =
    ADDCOLUMNS (
        FILTER ( VALUES ( 'Município'[Rótulo] ), [T03 · com UF] = 1 ),
        "@v", [T03 · votos (municípios)],
        "@p", [T03 · % (municípios)]
    )
VAR _topReg = TOPN ( 1, _reg, [@v], DESC, 'UF'[Região], ASC )
VAR _topMun = TOPN ( 1, _mun, [@v], DESC, 'Município'[Rótulo], ASC )
VAR _uf = [T03 · com UF] = 1
RETURN
    IF ( _uf, MAXX ( _topMun, 'Município'[Rótulo] ), MAXX ( _topReg, 'UF'[Região] ) )
