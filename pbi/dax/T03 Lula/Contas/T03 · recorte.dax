/*
@pasta: T03 Lula\Contas
@formato: texto
@descricao: Nome do recorte: o município marcado ou o recorte de estado, lido da medida comum [Recorte · nome] (Brasil; a UF; a região, escolhida no filtro ou clicada na origem; 'MG e SP'; '3 estados').
*/
IF (
    [T03 · com município] = 1,
    SELECTEDVALUE ( 'Município'[Rótulo], "municípios marcados" ),
    [Recorte · nome]
)
