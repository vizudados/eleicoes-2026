/*
@pasta: T03 Lula\Contas
@formato: texto
@descricao: Nome do recorte: o município marcado, a UF do filtro, a região clicada ou Brasil.
*/
SWITCH (
    TRUE (),
    [T03 · com município] = 1, SELECTEDVALUE ( 'Município'[Rótulo], "municípios marcados" ),
    [T03 · com UF] = 1, SELECTEDVALUE ( 'UF'[Nome] ),
    [T03 · com região] = 1, SELECTEDVALUE ( 'UF'[Região], "UFs escolhidas" ),
    "Brasil"
)
