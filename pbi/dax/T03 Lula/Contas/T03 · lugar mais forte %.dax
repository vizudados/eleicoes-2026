/*
@pasta: T03 Lula\Contas
@formato: 0.0%
@descricao: % do candidato nos válidos do lugar mais forte (0–1).
@oraculo: paginas[3].ufs_mais_fortes[0].pct_txt
*/
VAR _ufs =
    ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'UF'[Nome] ), 'UF'[Tipo] = "UF" ), "@p", [T03 · %] )
VAR _mun =
    ADDCOLUMNS (
        FILTER ( VALUES ( 'Município'[Rótulo] ), [T03 · com UF] = 1 && [T03 · válidos (municípios)] > 0 ),
        "@p", [T03 · % (municípios)]
    )
VAR _uf = [T03 · com UF] = 1
RETURN
    IF ( _uf, MAXX ( _mun, [@p] ), MAXX ( _ufs, [@p] ) )
