/*
@pasta: T03 Lula\Desenho
@formato: texto
@descricao: Legenda do mapa de pontos (como ler a cor e o tamanho) e a dica do que o clique faz, ou do que está marcado agora.
*/
-- 1 · Leituras
VAR _comMun = [T03 · com município]
VAR _comReg = [T03 · com região]
VAR _rec = [T03 · recorte]
-- 2 · Textos
VAR _dica =
    SWITCH (
        TRUE (),
        _comMun = 1, "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rec, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</b> marcado · clique no vazio do mapa para voltar",
        _comReg = 1, "<b>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rec, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</b> marcado · clique de novo na região para voltar",
        "passe o mouse num ponto para ver a cidade; clique para levá-la ao painel"
    )
-- 4 · Marcação
RETURN
    "<div class='tela lgm entra d6'>"
        & "<span class='it'><i class='bol'></i>cada ponto é um município; o tamanho segue os votos de Lula</span>"
        & "<span class='it'><i class='esc'></i>Lula à frente: quanto mais escuro, maior a margem</span>"
        & "<span class='it'><i class='atr'></i>Flávio à frente</span>"
        & "<span class='it dica'>" & _dica & "</span>"
    & "</div>"
