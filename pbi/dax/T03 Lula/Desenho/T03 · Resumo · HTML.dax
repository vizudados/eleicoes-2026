/*
@pasta: T03 Lula\Desenho
@formato: texto
@descricao: Coluna da esquerda da tela 03: o % de Lula no recorte, os votos, em quantos municípios ficou à frente, o que mudou desde 2022, de onde vêm os votos (regiões no Brasil; cidades numa UF) e onde foi mais forte e mais fraco. Só lê contas; a barra é geometria.
*/
-- 1 · Leituras
VAR _comUF = [T03 · com UF]
VAR _recorte = [T03 · recorte]
VAR _votos = [T03 · votos]
VAR _pct = [T03 · %]
VAR _pos = [T03 · posição]
VAR _v22 = [T03 · votos 2022]
VAR _p22 = [T03 · % 2022]
VAR _c22 = [T03 · candidato 2022]
VAR _dv = [T03 · variação de votos]
VAR _dpp = [T03 · variação em p.p.]
VAR _nFrente = [T03 · municípios à frente]
VAR _nMun = [T03 · municípios]
VAR _eleit = [T03 · eleitores nos municípios à frente]
VAR _orig = [T03 · origem principal]
VAR _origParte = [T03 · origem principal parte]
VAR _origPct = [T03 · origem principal %]
VAR _forte = [T03 · lugar mais forte]
VAR _forteP = [T03 · lugar mais forte %]
VAR _fraco = [T03 · lugar mais fraco]
VAR _fracoP = [T03 · lugar mais fraco %]
VAR _grande = [T03 · cidade grande mais forte]
VAR _grandeP = [T03 · cidade grande mais forte %]
VAR _grandePop = [T03 · cidade grande mais forte população]
VAR _regsBase =
    TOPN (
        IF ( _comUF = 0, 10, 0 ),
        ADDCOLUMNS (
            VALUES ( 'UF'[Região] ),
            "@v", [T03 · votos (municípios)],
            "@p", [T03 · parte dos votos],
            "@pv", [T03 · % (municípios)]
        ),
        [@v], DESC
    )
VAR _regs =
    SELECTCOLUMNS (
        FILTER ( _regsBase, [@v] > 0 ), /* lista */
        "@nome", 'UF'[Região], "@v", [@v], "@p", [@p], "@pv", [@pv]
    )
VAR _munsBase =
    TOPN (
        IF ( _comUF = 1, 5, 0 ),
        ADDCOLUMNS (
            VALUES ( 'Município'[Rótulo] ),
            "@v", [T03 · votos (municípios)],
            "@p", [T03 · parte dos votos],
            "@pv", [T03 · % (municípios)]
        ),
        [@v], DESC
    )
VAR _muns =
    SELECTCOLUMNS ( _munsBase, "@nome", 'Município'[Rótulo], "@v", [@v], "@p", [@p], "@pv", [@pv] )
VAR _lista = UNION ( _regs, _muns )
-- 2 · Textos
VAR _txtRec = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _recorte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
VAR _txtPct = FORMAT ( _pct, "0.0%" )
VAR _txtVotos = SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) )
VAR _txtNFrente = FORMAT ( _nFrente, "#,0" )
VAR _txtNMun = FORMAT ( _nMun, "#,0" )
VAR _txtEleit = IF ( _eleit >= 0.995 && _nFrente < _nMun, FORMAT ( _eleit, "0.0%" ), FORMAT ( _eleit, "0%" ) )
VAR _txtMun = IF ( _nMun = 1, " município", " municípios" )
VAR _manchete =
    SWITCH (
        TRUE (),
        _nMun = 1 && _nFrente = 1, "Lula ficou à frente no único município do recorte",
        _nMun = 1, "Lula ficou atrás no único município do recorte",
        _nFrente = 0, "Lula não ficou à frente em nenhum dos " & _txtNMun & _txtMun,
        "Lula ficou à frente em " & _txtNFrente & " dos " & _txtNMun & _txtMun & ", onde votam " & _txtEleit & " dos eleitores"
    )
VAR _txtDV = IF ( _dv < 0, "−", "+" ) & SWITCH ( TRUE (), ABS ( ABS ( _dv ) ) >= 1000000, FORMAT ( ABS ( _dv ) / 1000000, "0.00" ) & " mi", ABS ( ABS ( _dv ) ) >= 1000, FORMAT ( ABS ( _dv ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( _dv ), "#,0" ) )
VAR _txtDPP = FORMAT ( _dpp, "+0.0;−0.0;0.0" )
VAR _pontos = IF ( ABS ( _dpp ) < 2, " ponto", " pontos" )
VAR _compara =
    "Em 2022, " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _c22, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " teve " & SWITCH ( TRUE (), ABS ( _v22 ) >= 1000000, FORMAT ( _v22 / 1000000, "0.00" ) & " mi", ABS ( _v22 ) >= 1000, FORMAT ( _v22 / 1000, "0.0" ) & " mil", FORMAT ( _v22, "#,0" ) ) & " (" & FORMAT ( _p22, "0.0%" ) & "). Agora: <b class='lula-esc'>"
        & _txtDV & IF ( ABS ( _dv ) >= 1000, " de votos", IF ( ABS ( _dv ) = 1, " voto", " votos" ) )
        & "</b> e <b class='lula-esc'>" & _txtDPP & _pontos & "</b>."
VAR _rotOrigem = IF ( _comUF = 1, "De onde vêm os votos · as cidades que mais deram votos", "De onde vêm os votos · por região" )
VAR _origNome = IF ( _comUF = 1 && RIGHT ( _orig, 1 ) = ")", LEFT ( _orig, LEN ( _orig ) - 5 ), _orig )
VAR _frase =
    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _origNome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " deu " & FORMAT ( _origParte, "0%" ) & " dos votos de Lula"
        & IF ( _comUF = 1, " no estado", "" ) & "; lá, ele teve " & FORMAT ( _origPct, "0.0%" ) & " dos válidos."
VAR _resto = IF ( _comUF = 1, "<span class='resto entra d9'>demais municípios</span>" )
VAR _rotForte = IF ( _comUF = 1, "Município mais forte", "UF mais forte" )
VAR _rotFraco = IF ( _comUF = 1, "Município mais fraco", "UF mais fraca" )
VAR _fatoGrande =
    IF (
        NOT ISBLANK ( _grande ),
        "<div class='fato sobe d10'><span class='ic g'></span><div><div class='rot'>Entre as cidades de 100 mil+</div>"
            & "<div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _grande, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & " <small>" & FORMAT ( _grandePop, "#,0" ) & " habitantes</small></div></div>"
            & "<div class='vp lula'>" & FORMAT ( _grandeP, "0.0%" ) & "</div></div>"
    )
-- 3 · Geometria (barra de 620 px; as fatias seguem a ordem dos votos)
VAR _comIni =
    ADDCOLUMNS (
        _lista,
        "@ini", VAR _vv = [@v] RETURN SUMX ( FILTER ( _lista, [@v] > _vv ), [@p] ), /* lista */
        "@ord", VAR _vv = [@v] RETURN 1 + COUNTROWS ( FILTER ( _lista, [@v] > _vv ) ) /* lista */
    )
VAR _fatias =
    CONCATENATEX (
        _comIni,
        VAR _w = [@p] * 620 -- geometria
        VAR _nm = IF ( _comUF = 1 && RIGHT ( [@nome], 1 ) = ")", LEFT ( [@nome], LEN ( [@nome] ) - 5 ), [@nome] )
        VAR _rot = IF ( _w >= 120, _nm & " " & FORMAT ( [@p], "0%" ), IF ( _w >= 44, FORMAT ( [@p], "0%" ), "" ) )
        RETURN
            "<div class='fa o" & MIN ( [@ord], 5 ) & " barra-x d" & ( [@ord] + 5 ) & "' style='left:"
                & FORMAT ( [@ini] * 620, "0.0##", "en-US" ) & "px;width:" & FORMAT ( _w, "0.0##", "en-US" ) & "px'><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rot, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</span></div>",
        "",
        [@v], DESC
    )
VAR _linhas =
    CONCATENATEX (
        _comIni,
        VAR _nm = IF ( _comUF = 1, LEFT ( [@nome], LEN ( [@nome] ) - 5 ), [@nome] )
        RETURN
        "<div class='li'><i class='sw o" & MIN ( [@ord], 5 ) & "'></i><span class='nm'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nm, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
            & "</span><span class='a'>" & FORMAT ( [@p], "0%" ) & " dos votos dele · " & SWITCH ( TRUE (), ABS ( [@v] ) >= 1000000, FORMAT ( [@v] / 1000000, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( [@v] / 1000, "0.0" ) & " mil", FORMAT ( [@v], "#,0" ) ) & "</span>"
            & "<span class='b'>" & FORMAT ( [@pv], "0.0%" ) & " dos válidos</span></div>",
        "",
        [@v], DESC
    )
-- 4 · Marcação
VAR _html =
    "<div class='tela rv'>"
        & "<div class='sob sobe'>Luiz Inácio Lula da Silva · PT · 13 · " & _txtRec & "</div>"
        & "<div class='topo'><div class='big lula sobe d1'>" & _txtPct & "</div>"
        & "<div class='lado sobe d2'><div class='vv lula'>" & _txtVotos & "</div>"
        & "<div class='txt'>de votos · " & _pos & "º lugar</div></div></div>"
        & "<div class='man mc sobe d3'>" & _manchete & "</div>"
        & "<div class='txt cp sobe d4'>" & _compara & "</div>"
        & "<div class='rot ro sobe d5'>" & _rotOrigem & "</div>"
        & "<div class='barra'>" & _resto & _fatias & "</div>"
        & "<div class='fluxo'><div class='txt fr sobe d8'>" & _frase & "</div>"
        & "<div class='ls sobe d9'>" & _linhas & "</div>"
        & "<div class='fatos'>"
        & "<div class='fato sobe d10'><span class='ic f'></span><div><div class='rot'>" & _rotForte & "</div>"
        & "<div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _forte, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp lula'>" & FORMAT ( _forteP, "0.0%" ) & "</div></div>"
        & IF ( _fraco <> _forte, "<div class='fato sobe d11'><span class='ic r'></span><div><div class='rot'>" & _rotFraco & "</div>"
        & "<div class='lg'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _fraco, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" ) & "</div></div><div class='vp'>" & FORMAT ( _fracoP, "0.0%" ) & "</div></div>" )
        & _fatoGrande & "</div></div>"
    & "</div>"
RETURN
    _html
