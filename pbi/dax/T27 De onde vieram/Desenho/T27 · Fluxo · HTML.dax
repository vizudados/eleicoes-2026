/*
@pasta: T27 De onde vieram\Desenho
@formato: texto
@descricao: Fluxo em traço, mesmos volumes observados para os dois candidatos; não afirma transferência individual.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
-- 1 · Leituras e 3 · Geometria: espessura proporcional ao ganho absoluto
-- 4 · Marcação
VAR _html = "<div class='tela st-fluxo'><div class='rot antes'>1º TURNO</div><div class='rot depois'>2º TURNO</div>"
    & "<div class='candidato lula-esc' style='top:20px'>Lula</div>"
    & "<div class='origem num' style='top:40px'>" & FORMAT ( [T27 · Lula 1º], "#,0" ) & "</div>"
    & "<div class='destino num lula' style='top:40px'>" & FORMAT ( [T27 · Lula 2º], "#,0" ) & "</div>"
    & "<svg class='ponte' style='top:52px' width='300' height='45'>"
    & "<path d='M5 24 C70 8, 170 40, 286 20' pathLength='1' class='traco' fill='none' stroke='var(--vermelho)' stroke-width='"
    -- geometria
    & FORMAT ( 3 + 11 * DIVIDE ( ABS ( [T27 · ganho Lula] ), [T27 · fluxo · escala], 0 ), "0.0", "en-US" )
    & "' stroke-linecap='round' filter='url(#rb)'/></svg>"
    & "<div class='saldo num lula-esc' style='top:94px'>" & FORMAT ( [T27 · ganho Lula], "+#,0;-#,0;0" ) & IF ( ABS ( [T27 · ganho Lula] ) = 1, " voto", " votos" ) & "</div>"
    & "<div class='candidato flavio-esc' style='top:120px'>Flávio</div>"
    & "<div class='origem num' style='top:140px'>" & FORMAT ( [T27 · Flávio 1º], "#,0" ) & "</div>"
    & "<div class='destino num flavio' style='top:140px'>" & FORMAT ( [T27 · Flávio 2º], "#,0" ) & "</div>"
    & "<svg class='ponte' style='top:152px' width='300' height='45'>"
    & "<path d='M5 24 C70 8, 170 40, 286 20' pathLength='1' class='traco' fill='none' stroke='var(--azul)' stroke-width='"
    -- geometria
    & FORMAT ( 3 + 11 * DIVIDE ( ABS ( [T27 · ganho Flávio] ), [T27 · fluxo · escala], 0 ), "0.0", "en-US" )
    & "' stroke-linecap='round' filter='url(#rb)'/></svg>"
    & "<div class='saldo num flavio-esc' style='top:194px'>" & FORMAT ( [T27 · ganho Flávio], "+#,0;-#,0;0" ) & IF ( ABS ( [T27 · ganho Flávio] ) = 1, " voto", " votos" ) & "</div>"
    & "<div class='conta-observada'><div class='rot'>A SOMA DOS GANHOS · VOTOS OBSERVADOS</div>"
    & "<div class='parcela'><span>" & ("Demais candidatos no 1º turno") & "</span><b class='num'>" & FORMAT ( [T27 · demais no 1º turno], "+#,0;-#,0;0" ) & "</b></div>"
    & "<div class='parcela'><span>" & (IF ( [T27 · saldo comparecimento] >= 0, "Comparecimento a mais", "Comparecimento a menos" )) & "</span><b class='num'>" & FORMAT ( [T27 · saldo comparecimento], "+#,0;-#,0;0" ) & "</b></div>"
    & "<div class='parcela'><span>" & (IF ( [T27 · queda de brancos e nulos] >= 0, "Brancos e nulos a menos", "Brancos e nulos a mais" )) & "</span><b class='num'>" & FORMAT ( [T27 · queda de brancos e nulos], "+#,0;-#,0;0" ) & "</b></div>"
    & "<div class='parcela total'><span>" & IF ( [T27 · ganhos da dupla] >= 0, "Ganho total da dupla", "Saldo total da dupla" )
    & "</span><b class='num'>= " & FORMAT ( [T27 · ganhos da dupla], "+#,0;-#,0;0" ) & "</b></div>"
    & "<div class='nota'>a urna não mostra quem trocou de candidato.</div></div>"
    & "</div>"
RETURN _html
