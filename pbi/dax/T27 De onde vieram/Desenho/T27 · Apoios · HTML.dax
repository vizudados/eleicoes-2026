/*
@pasta: T27 De onde vieram\Desenho
@formato: texto
@descricao: Regiões e portes na T27; estados e viradas na T28, com os mesmos saldos em votos.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
VAR _g0 = TOPN ( 2, ADDCOLUMNS ( VALUES ( 'UF'[Região] ), "@v", [T27 · ganho Lula] ), [@v], DESC, 'UF'[Região], ASC )
VAR _t0 = CONCATENATEX ( _g0,
    IF ( NOT ISBLANK ( [@v] ), "<div><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'UF'[Região], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
    & "</span><b>" & (IF ( [@v] > 0, "+", IF ( [@v] < 0, "−", "" ) ) & (SWITCH ( TRUE (), ABS ( [@v] ) >= 1e6, FORMAT ( ABS ( [@v] ) / 1e6, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( ABS ( [@v] ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( [@v] ), "#,0" ) ))) & "</b></div>" ), "", [@v], DESC )
VAR _g1 = TOPN ( 2, ADDCOLUMNS ( VALUES ( 'Município'[Porte] ), "@v", [T27 · ganho Lula] ), [@v], DESC, 'Município'[Porte], ASC )
VAR _t1 = CONCATENATEX ( _g1,
    IF ( NOT ISBLANK ( [@v] ), "<div><span>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'Município'[Porte], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
    & "</span><b>" & (IF ( [@v] > 0, "+", IF ( [@v] < 0, "−", "" ) ) & (SWITCH ( TRUE (), ABS ( [@v] ) >= 1e6, FORMAT ( ABS ( [@v] ) / 1e6, "0.00" ) & " mi", ABS ( [@v] ) >= 1000, FORMAT ( ABS ( [@v] ) / 1000, "0.0" ) & " mil", FORMAT ( ABS ( [@v] ), "#,0" ) ))) & "</b></div>" ), "", [@v], DESC )
RETURN "<div class='tela st-apoios'><div><div class='rot'>Região</div>" & _t0
     & "</div><div><div class='rot'>Porte</div>" & IF ( _t1 = "", "<div>Nenhum no recorte</div>", _t1 ) & "</div></div>"
