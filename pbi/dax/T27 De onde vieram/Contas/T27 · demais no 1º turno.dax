/*
@pasta: T27 De onde vieram\Contas
@formato: #,0
@descricao: Votos observados dos demais candidatos no primeiro turno, sem exterior.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
CALCULATE ( SUM ( 'Município ano'[VotosDemais] ),
    REMOVEFILTERS ( 'Ano' ), 'Município ano'[Ano] = 2026 )
