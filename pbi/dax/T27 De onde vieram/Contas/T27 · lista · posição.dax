/*
@pasta: T27 De onde vieram\Contas
@formato: #,0
@descricao: Posição da cidade no recorte, mesmo critério descendente da lista anterior; só oito entradas são emitidas.
@oraculo: dados/saida/2turno/comparacao_municipios.csv; dados/pbi/municipio_ano.csv; municipio_2turno.csv
@gerado: pbi/scripts/desenho_t27_t28.py
*/
-- desempate pelo código dentro do RANKX (sem um segundo FILTER por linha, que levava ~14 s; 26/10/2026)
VAR _v = [T27 · ganho Lula]
RETURN IF (
    HASONEVALUE ( 'Município'[CodIBGE] ),
    RANKX ( ALLSELECTED ( 'Município'[CodIBGE] ), [T27 · ganho Lula] - 'Município'[CodIBGE] / 100000000,
        _v - SELECTEDVALUE ( 'Município'[CodIBGE] ) / 100000000, DESC, SKIP )
)
