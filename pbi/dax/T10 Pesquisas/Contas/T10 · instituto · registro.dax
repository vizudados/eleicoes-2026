/*
@pasta: T10 Pesquisas\Contas
@formato: texto
@descricao: Registro no TSE da última pesquisa do instituto (vazio quando não publicado).
*/
VAR _id = [T10 · instituto · pesquisa]
RETURN
    IF ( NOT ISBLANK ( _id ), CALCULATE ( MAX ( Pesquisa[Registro] ), REMOVEFILTERS ( Pesquisa ), Pesquisa[Id] = _id ) )
