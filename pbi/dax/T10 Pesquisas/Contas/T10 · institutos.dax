/*
@pasta: T10 Pesquisas\Contas
@formato: 0
@descricao: Institutos com ao menos uma pesquisa de 1º turno com Lula e Flávio publicados (a última de cada um entra na régua).
@oraculo: paginas[10].antes.total = 18
*/
VAR _lista =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( Pesquisa[Instituto] ),
            REMOVEFILTERS ( Pesquisa ),
            Pesquisa[Cenário] = "1º turno",
            NOT ISBLANK ( Pesquisa[Lula] ),
            NOT ISBLANK ( Pesquisa[Flavio] )
        ),
        "@d", [T10 · instituto · diferença],
        "@b", [T10 · instituto · base]
    )
RETURN
    COUNTROWS ( FILTER ( _lista, NOT ISBLANK ( [@d] ) ) ) + 0
