/*
@pasta: T10 Pesquisas\Desenho
@formato: texto
@descricao: Onde foi o erro: a média de Lula e de Flávio nas últimas pesquisas com votos válidos contra a urna, numa régua de 40% a 50% (círculo vazio = pesquisas, cheio = urna; a seta de Flávio se desenha), o erro médio da diferença e a explicação de válidos × totais. Só lê as contas 'T10 · …'.
*/
-- 1 · Leituras
VAR _mL = [T10 · válidos · média Lula]
VAR _mF = [T10 · válidos · média Flávio]
VAR _uL = [T10 · urna · Lula]
VAR _uF = [T10 · urna · Flávio]
VAR _eL = [T10 · válidos · erro Lula]
VAR _eF = [T10 · válidos · erro Flávio]
VAR _eM = [T10 · válidos · erro médio]
VAR _nV = [T10 · institutos · com válidos]
-- 2 · Textos
VAR _txtEF = IF ( _eF >= 0, "+", "−" ) & FORMAT ( ABS ( _eF ), "0.0" )
VAR _txtEM =
    FORMAT ( ABS ( _eM ), "0.0" ) & IF ( ROUND ( ABS ( _eM ), 1 ) < 2, " ponto", " pontos" ) & " a favor de "
        & IF ( _eM < 0, "Lula", "Flávio" )
VAR _okL = ABS ( _eL ) < 0.5
VAR _okF = ABS ( _eF ) < 0.5
VAR _txtMan =
    SWITCH (
        TRUE (),
        _okL && NOT _okF, "As pesquisas acertaram o número de Lula e erraram o de Flávio",
        _okF && NOT _okL, "As pesquisas acertaram o número de Flávio e erraram o de Lula",
        _okL && _okF, "As pesquisas acertaram os dois números",
        "As pesquisas erraram os dois números"
    )
-- 3 · Geometria (régua de 40% a 50% em x 90–520; Lula em y 34, Flávio em y 132)
VAR _xmL = 90 + ( _mL - 40 ) * 43 -- geometria
VAR _xuL = 90 + ( _uL - 40 ) * 43 -- geometria
VAR _xmF = 90 + ( _mF - 40 ) * 43 -- geometria
VAR _xuF = 90 + ( _uF - 40 ) * 43 -- geometria
VAR _sentido = IF ( _xuF >= _xmF, 1, -1 ) -- geometria
VAR _f = "0.0"
VAR _xs0 = FORMAT ( _xmF + 13 * _sentido, _f, "en-US" )
VAR _xs1 = FORMAT ( _xuF - 14 * _sentido, _f, "en-US" )
VAR _xp = FORMAT ( _xuF - 22 * _sentido, _f, "en-US" )
VAR _ticks =
    CONCATENATEX (
        { 40, 45, 50 },
        "<text x='" & FORMAT ( 90 + ( [Value] - 40 ) * 43, _f, "en-US" ) & "' y='188' class='ex' text-anchor='middle'>"
            & [Value] & "%</text>",
        ""
    )
-- 4 · Marcação
VAR _svg =
    "<svg width='560' height='196' viewBox='0 0 560 196'>"
        & "<text x='0' y='40' class='nm l'>Lula</text>"
        & "<text x='0' y='138' class='nm f'>Flávio</text>"
        & "<line x1='90' x2='520' y1='34' y2='34' class='trilho'/>"
        & "<line x1='90' x2='520' y1='132' y2='132' class='trilho'/>"
        & _ticks
        & "<circle cx='" & FORMAT ( _xuL, _f, "en-US" ) & "' cy='34' r='10' style='fill:var(--vermelho)' class='brota d6'/>"
        & "<circle cx='" & FORMAT ( _xmL, _f, "en-US" ) & "' cy='34' r='16' style='fill:none;stroke:var(--vermelho);stroke-width:2.6' class='brota d4'/>"
        & "<text x='" & FORMAT ( _xmL, _f, "en-US" ) & "' y='68' class='vl' text-anchor='middle'><tspan>pesquisas e urna, </tspan><tspan font-weight='700'>"
            & FORMAT ( _mL, "0.0" ) & "%</tspan></text>"
        & "<circle cx='" & FORMAT ( _xmF, _f, "en-US" ) & "' cy='132' r='10' style='fill:var(--papel);stroke:var(--azul);stroke-width:2.6' class='brota d4'/>"
        & "<path d='M" & _xs0 & " 132 L" & _xs1 & " 132 M" & _xp & " 124 L" & _xs1 & " 132 L" & _xp & " 140' pathLength='1' class='seta traco' filter='url(#rbu10)' style='animation-delay:1.4s'/>"
        & "<circle cx='" & FORMAT ( _xuF, _f, "en-US" ) & "' cy='132' r='10' style='fill:var(--azul)' class='brota d10'/>"
        & "<text x='" & FORMAT ( _xmF, _f, "en-US" ) & "' y='164' class='vl' text-anchor='middle'>pesquisas <tspan font-weight='700'>"
            & FORMAT ( _mF, "0.0" ) & "%</tspan></text>"
        & "<text x='" & FORMAT ( _xuF, _f, "en-US" ) & "' y='164' class='vl' text-anchor='middle'>urna <tspan font-weight='700'>"
            & FORMAT ( _uF, "0.0" ) & "%</tspan></text>"
    & "</svg>"
VAR _notaF =
    "<div class='mao flavio-esc entra d12' style='left:" & FORMAT ( ( _xmF + _xuF ) / 2 - 26, _f, "en-US" ) & "px;top:186px'>"
        & _txtEF & "</div>"
VAR _notaL =
    IF (
        _okL,
        "<div class='ok entra d10' style='left:" & FORMAT ( _xuL + 26, _f, "en-US" ) & "px;top:100px'>acertaram</div>"
    )
RETURN
    "<div class='tela t10e'>"
        & "<div class='sob sobe'>Onde foi o erro · média de " & _nV & " institutos × urna</div>"
        & "<div class='man sobe d2'>" & _txtMan & "</div>"
        & _svg & _notaL & _notaF
        & "<div class='txt sobe d8' style='top:302px'>Erro médio na diferença: " & _txtEM & ".</div>"
        & "<div class='expl sobe d9' style='top:340px'>Só entram os institutos que divulgaram votos válidos: sem brancos, nulos e indecisos, como a urna conta.</div>"
    & "</div>"
