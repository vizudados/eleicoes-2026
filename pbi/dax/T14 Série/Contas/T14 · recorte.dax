/*
@pasta: T14 Série\Contas
@formato: texto
@descricao: O lugar que a tela conta: a região clicada nos painéis ou a UF do filtro (vazio = Brasil).
@gerado: pbi/scripts/desenho_t14.py
*/
VAR _reg = [T14 · região clicada]
RETURN
    IF ( NOT ISBLANK ( _reg ), _reg, IF ( ISFILTERED ( 'UF'[Nome] ), SELECTEDVALUE ( 'UF'[Nome] ) ) )
