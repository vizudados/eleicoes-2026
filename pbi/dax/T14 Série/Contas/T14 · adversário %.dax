/*
@pasta: T14 Série\Contas
@formato: 0.0%
@descricao: Votos do mais votado fora do PT sobre os válidos no ano do contexto (nacional com o exterior; com UF ou região, os municípios; a região vale por cima da UF).
@oraculo: mockup/data/eleicoes.json › paginas[14] › anos › adversario › pct (2018 46,0%; 2026 47,0%)
@gerado: pbi/scripts/desenho_t14.py
*/
IF ( [Eleição · pós] = 1, VAR _mun = ISCROSSFILTERED ( 'Município' )
VAR _reg = ISFILTERED ( 'Município'[Região] )
RETURN
    SWITCH (
        TRUE (),
        _reg, CALCULATE ( DIVIDE ( SUM ( 'Município segundo turno'[VotosAdversario] ), SUM ( 'Município segundo turno'[Validos] ) ), REMOVEFILTERS ( 'UF' ) ),
        _mun, DIVIDE ( SUM ( 'Município segundo turno'[VotosAdversario] ), SUM ( 'Município segundo turno'[Validos] ) ),
        CALCULATE (
            DIVIDE ( SUM ( 'PT histórico Brasil'[VotosAdversario] ), SUM ( 'PT histórico Brasil'[Validos] ) ),
            'PT histórico Brasil'[Turno] = 2,
            TREATAS ( VALUES ( 'Ano'[Ano] ), 'PT histórico Brasil'[Ano] )
        )
    ), VAR _mun = ISCROSSFILTERED ( 'Município' )
VAR _reg = ISFILTERED ( 'Município'[Região] )
RETURN
    SWITCH (
        TRUE (),
        _reg,
            CALCULATE (
                DIVIDE ( SUM ( 'Município ano'[VotosAdversario] ), SUM ( 'Município ano'[Validos] ) ),
                REMOVEFILTERS ( 'UF' )
            ),
        _mun, DIVIDE ( SUM ( 'Município ano'[VotosAdversario] ), SUM ( 'Município ano'[Validos] ) ),
        DIVIDE (
            CALCULATE ( MAX ( 'Candidato ano'[Votos] ), 'Candidato ano'[Partido] <> "PT" ),
            MAX ( 'Candidato ano'[ValidosAno] )
        )
    ) )
