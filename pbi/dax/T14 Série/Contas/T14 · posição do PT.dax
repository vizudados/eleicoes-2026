/*
@pasta: T14 Série\Contas
@formato: 0
@descricao: Colocação nacional do candidato do PT no 1º turno do ano do contexto.
@oraculo: 2018 e 2026 = 2
@gerado: pbi/scripts/desenho_t14.py
*/
IF ( [Eleição · pós] = 1, VAR _pt = [T14 · votos PT Brasil]
VAR _adv = [T14 · votos adversário Brasil]
RETURN IF ( NOT ISBLANK ( _pt ), IF ( _pt > _adv, 1, 2 ) ), CALCULATE ( MAX ( 'Candidato ano'[Posição] ), 'Candidato ano'[Partido] = "PT" ) )
