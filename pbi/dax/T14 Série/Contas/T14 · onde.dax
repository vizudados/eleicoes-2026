/*
@pasta: T14 Série\Contas
@formato: texto
@descricao: O lugar com a preposição, para as frases: 'no Nordeste' (região clicada) ou 'em Minas Gerais' (UF).
@gerado: pbi/scripts/desenho_t14.py
*/
VAR _reg = [T14 · região clicada]
RETURN
    IF (
        NOT ISBLANK ( _reg ),
        "no " & _reg,
        IF ( ISFILTERED ( 'UF'[Nome] ), "em " & SELECTEDVALUE ( 'UF'[Nome] ) )
    )
