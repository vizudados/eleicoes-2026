/*
@pasta: T14 Série\Contas
@formato: 0.0%
@descricao: Votos do candidato do PT sobre os válidos no ano do contexto. Sem recorte de municípios, o resultado nacional oficial (com o exterior); com UF ou região, a soma dos municípios. A região (painel clicado ou do grão) vale por cima do filtro de UF.
@oraculo: mockup/data/eleicoes.json › paginas[14] › anos › pt › pct (2006 48,6% … 2026 45,2%)
@gerado: pbi/scripts/desenho_t14.py
*/
VAR _mun = ISCROSSFILTERED ( 'Município' )
VAR _reg = ISFILTERED ( 'Município'[Região] )
RETURN
    SWITCH (
        TRUE (),
        _reg,
            CALCULATE (
                DIVIDE ( SUM ( 'Município ano'[VotosPT] ), SUM ( 'Município ano'[Validos] ) ),
                REMOVEFILTERS ( 'UF' )
            ),
        _mun, DIVIDE ( SUM ( 'Município ano'[VotosPT] ), SUM ( 'Município ano'[Validos] ) ),
        DIVIDE (
            CALCULATE ( SUM ( 'Candidato ano'[Votos] ), 'Candidato ano'[Partido] = "PT" ),
            MAX ( 'Candidato ano'[ValidosAno] )
        )
    )
