/*
@pasta: T14 Série\Contas
@formato: #,0
@descricao: Resultado nacional do segundo turno, com exterior, no ano do contexto.
@gerado: pbi/scripts/desenho_t14.py
*/
CALCULATE (
    SUM ( 'PT histórico Brasil'[VotosAdversario] ), 'PT histórico Brasil'[Turno] = 2,
    TREATAS ( VALUES ( 'Ano'[Ano] ), 'PT histórico Brasil'[Ano] )
)
