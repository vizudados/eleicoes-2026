/*
@pasta: T11 Virada\Contas
@formato: #,0
@descricao: Municípios com Lula à frente em 2022. Conta município a município no recorte.
@oraculo: mockup/data/eleicoes.json › paginas[11] › lula_venceu 2022 = 3.376
@gerado: pbi/scripts/desenho_t11.py
*/
SUMX (
    VALUES ( 'Município'[CodIBGE] ),
        VAR _d22 = [T11 · saldo 2022]
        RETURN
            IF ( _d22 > 0, 1 )
) + 0
