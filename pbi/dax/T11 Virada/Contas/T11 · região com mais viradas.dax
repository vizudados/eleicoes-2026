/*
@pasta: T11 Virada\Contas
@formato: texto
@descricao: Região com mais municípios que trocaram de lado (vazio se nenhum).
@oraculo: mockup/data/eleicoes.json › paginas[11] › viraram_por_regiao[0] = Sudeste
@gerado: pbi/scripts/desenho_t11.py
*/
VAR _r =
    ADDCOLUMNS ( VALUES ( 'Município'[Região] ), "@n", [T11 · viraram] )
VAR _top1 =
    TOPN ( 1, _r, [@n], DESC, 'Município'[Região], ASC )
VAR _top2 =
    TOPN ( 2, _r, [@n], DESC, 'Município'[Região], ASC )
RETURN
    IF ( MAXX ( _r, [@n] ) > 0, MAXX ( _top1, 'Município'[Região] ) )
