/*
@pasta: T11 Virada\Contas
@formato: #,0
@descricao: Municípios com Lula à frente em 2026. Conta município a município no recorte.
@oraculo: mockup/data/eleicoes.json › paginas[11] › lula_venceu 2026 = 2.663
@gerado: pbi/scripts/desenho_t11.py
*/
SUMX (
    VALUES ( 'Município'[CodIBGE] ),
        VAR _d26 = [T11 · saldo 2026]
        RETURN
            IF ( _d26 > 0, 1 )
) + 0
