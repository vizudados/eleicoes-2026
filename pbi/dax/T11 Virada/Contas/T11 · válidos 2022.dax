/*
@pasta: T11 Virada\Contas
@formato: #,0
@descricao: Votos válidos em 2022, somados no recorte (sem o exterior).
@gerado: pbi/scripts/desenho_t11.py
*/
IF ( [Eleição · pós] = 1, CALCULATE (
    SUM ( 'Município segundo turno'[Validos] ),
    'Município segundo turno'[Ano] = 2022
), CALCULATE (
    SUM ( 'Município ano'[Validos] ),
    'Município ano'[Ano] = 2022
) )
