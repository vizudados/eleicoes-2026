/*
@pasta: T11 Virada\Contas
@formato: #,0
@descricao: Votos de Lula (PT) menos os do adversário (PL) em 2026, somados no recorte. Positivo: Lula à frente.
@gerado: pbi/scripts/desenho_t11.py
*/
IF ( [Eleição · pós] = 1, CALCULATE (
    SUM ( 'Município segundo turno'[VotosPT] ) - SUM ( 'Município segundo turno'[VotosAdversario] ),
    'Município segundo turno'[Ano] = 2026
), CALCULATE (
    SUM ( 'Município ano'[VotosPT] ) - SUM ( 'Município ano'[VotosAdversario] ),
    'Município ano'[Ano] = 2026
) )
