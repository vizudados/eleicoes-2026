/*
@pasta: T11 Virada\Contas
@formato: #,0
@descricao: Votos de Lula (PT) em 2026, somados no recorte (sem o exterior).
@gerado: pbi/scripts/desenho_t11.py
*/
IF ( [Eleição · pós] = 1, CALCULATE (
    SUM ( 'Município segundo turno'[VotosPT] ),
    'Município segundo turno'[Ano] = 2026
), CALCULATE (
    SUM ( 'Município ano'[VotosPT] ),
    'Município ano'[Ano] = 2026
) )
