/*
@pasta: T11 Virada\Contas
@formato: #,0
@descricao: Votos do adversário do PL em 2022 (Jair Bolsonaro), somados no recorte.
@gerado: pbi/scripts/desenho_t11.py
*/
IF ( [Eleição · pós] = 1, CALCULATE (
    SUM ( 'Município segundo turno'[VotosAdversario] ),
    'Município segundo turno'[Ano] = 2022
), CALCULATE (
    SUM ( 'Município ano'[VotosAdversario] ),
    'Município ano'[Ano] = 2022
) )
