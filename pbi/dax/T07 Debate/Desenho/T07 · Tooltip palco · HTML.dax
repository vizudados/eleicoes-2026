/*
@pasta: T07 Debate\Desenho
@formato: texto
@descricao: Dossiê do palco (ttT07Palco, linha do debate da Band de 18/10, T07 · debate · o da Band): uma frase de cada um (Aos Fatos, Congresso em Foco, Agência Brasil), a nota dos grupos da Quaest e a audiência dos debates da Band em 2022 e 2026 (barras que crescem). Só lê contas 'T07 · …'.
*/
-- 1 · Leituras
VAR _band = [T07 · debate · o da Band]
VAR _dia = [T07 · debate · dia]
VAR _qF = [T07 · Quaest · nota Flávio]
VAR _qL = [T07 · Quaest · nota Lula]
VAR _b22a = [T07 · audiência · Band 2022 1º turno]
VAR _b22b = [T07 · audiência · Band 2022 2º turno]
VAR _b26a = [T07 · audiência · Band 1º turno 2026]
VAR _b26b = [T07 · audiência]
-- 2 · Textos
VAR _txtQ =
    "Nos 30 grupos de eleitores que a Quaest reuniu para assistir, a nota média foi " & _qF & " para Flávio e "
        & _qL & " para Lula. O instituto não viu virada."
-- 3 · Geometria (barras deitadas de até 240 px)
VAR _max = MAX ( MAX ( _b22a, _b22b ), MAX ( _b26a, _b26b ) ) -- geometria
VAR _lista =
    DATATABLE (
        "Ordem", INTEGER, "Rotulo", STRING,
        { { 1, "2022 · 1º turno" }, { 2, "2022 · 2º turno" }, { 3, "2026 · 1º turno, sem os dois" }, { 4, "2026 · 2º turno, os dois" } }
    )
VAR _barras =
    CONCATENATEX (
        ADDCOLUMNS ( _lista, "@v", SWITCH ( [Ordem], 1, _b22a, 2, _b22b, 3, _b26a, _b26b ) ),
        "<div class='bar" & IF ( [Ordem] = 4, " n", "" ) & " entra d" & ( 5 + [Ordem] ) & "'><span>" & [Rotulo]
            & "</span><div><i style='width:" & FORMAT ( [@v] / _max * 240, "0.0", "en-US" ) & "px;animation-delay:"
            & ( 300 + [Ordem] * 120 ) & "ms'></i><b>" & IF ( INT ( [@v] ) = [@v], FORMAT ( [@v], "0" ), FORMAT ( [@v], "0.0" ) )
            & "</b></div></div>",
        "",
        [Ordem], ASC
    )
-- 4 · Marcação
RETURN
    IF (
        _band = "Sim",
        "<div class='tt7s'>"
            & "<div class='sob sobe'>" & FORMAT ( _dia, "dd/MM" ) & " · uma frase de cada um</div>"
            & "<div class='cit l sobe d2'>“Eu desafio você. Amanhã abrimos a nossa conta bancária.”"
                & "<small>Lula, ao propor que os dois abrissem os sigilos bancários</small></div>"
            & "<div class='cit f sobe d3'>“Aqui é o Flávio, não é o Jair.”"
                & "<small>Flávio, ao falar de armas</small></div>"
            & "<div class='txt sobe d4'>" & _txtQ & "</div>"
            & "<hr class='entra d5'/>"
            & "<div class='sob sobe d5'>Audiência na Band · pontos na Grande SP</div>"
            & _barras
        & "</div>"
    )
