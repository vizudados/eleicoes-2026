/*
@pasta: T07 Debate\Desenho
@formato: texto
@descricao: Os debates marcados na campanha: '2 de 12' (contadores), o resumo do 1º e do 2º turno (no 2º, os que caíram e as emissoras dos frente a frente, Band e Globo), o eixo do primeiro ao último debate da tabela (23/08 a 23/10) com o corte do 1º turno e a legenda. As marcas de cada debate são outro visual (T07 · Marcas · HTML), na mesma caixa e na mesma escala.
*/
-- 1 · Leituras
VAR _n = [T07 · debates marcados]
VAR _um = [T07 · debates frente a frente]
VAR _sem = [T07 · 1º turno · sem os dois]
VAR _can = [T07 · 1º turno · cancelados]
VAR _des = [T07 · 2º turno · desmarcados]
VAR _emis = [T07 · 2º turno · frente a frente · emissoras]
VAR _dia0 = [T07 · debates · primeiro dia]
VAR _dia1 = [T07 · debates · último dia]
-- 2 · Textos
-- "Band e Globo" → "à Band e à Globo"
VAR _txtEmis = "à " & SUBSTITUTE ( SUBSTITUTE ( _emis, ", ", ", à " ), " e ", " e à " )
VAR _txtResumo =
    "No 1º turno, Lula e Flávio faltaram a todos: " & _sem & IF ( _sem = 1, " aconteceu", " aconteceram" )
        & " sem eles e " & _can & IF ( _can = 1, " foi cancelado", " foram cancelados" ) & ". No 2º turno, "
        & _des & IF ( _des = 1, " caiu", " caíram" ) & " e os dois foram " & _txtEmis & "."
-- 3 · Geometria (eixo: da véspera do primeiro debate ao dia seguinte ao último, em x 600–1600)
VAR _ini = _dia0 - 1
VAR _span = DATEDIFF ( _ini, _dia1 + 1, DAY ) -- geometria
VAR _xCorte = 600 + DATEDIFF ( _ini, DATE ( 2026, 10, 4 ), DAY ) / _span * 1000 -- geometria
VAR _fC = FORMAT ( _xCorte, "0.0", "en-US" )
-- 4 · Marcação
RETURN
    "<div class='tela t07d'>"
        & "<div class='esq'>"
            & "<div class='sob sobe'>Os debates da campanha</div>"
            & "<div class='linha sobe d2'><span class='num'>" & _um & "</span><span class='man'>de</span><span class='num'>" & _n
            & "</span><span class='man'>marcados " & IF ( _um = 1, "reuniu", "reuniram" ) & " os dois</span></div>"
            & "<div class='txt sobe d3'>" & _txtResumo & "</div>"
        & "</div>"
        & "<svg width='1620' height='132' viewBox='0 0 1620 132'>"
            & "<text x='600' y='13' class='ex'>1º TURNO</text>"
            & "<text x='" & FORMAT ( _xCorte + 12, "0.0", "en-US" ) & "' y='13' class='ex'>2º TURNO</text>"
            & "<path d='M600 58 H1600' pathLength='1' class='eixo traco'/>"
            & "<line x1='" & _fC & "' x2='" & _fC & "' y1='2' y2='104' class='corte'/>"
        & "</svg>"
        & "<div class='leg entra d10'><span><i class='o'></i>aconteceu sem os dois</span>"
            & "<span><svg width='13' height='13' viewBox='0 0 18 18'><path d='M3.5 3 L15 15.5 M15 3.5 L3 15' fill='none' "
            & "stroke='var(--grafite)' stroke-width='2.8' stroke-linecap='round'/></svg>cancelado ou não realizado</span>"
            & "<span><i class='ff'></i>Lula e Flávio frente a frente</span></div>"
    & "</div>"
