/*
@pasta: T07 Debate\Contas
@formato: 0
@descricao: Quantas pesquisas do instituto clicado tiveram campo no dia do debate (fora da comparação antes × depois), entre as que terminaram antes do debate seguinte (Globo, 23/10).
*/
VAR _inst = [T07 · escolha · instituto]
VAR _d = [T07 · debate · data]
VAR _g = [T07 · debate seguinte · data]
RETURN
    IF (
        NOT ISBLANK ( _inst ),
        CALCULATE (
            COUNTROWS ( Pesquisa ),
            REMOVEFILTERS ( Pesquisa ),
            Pesquisa[Cenário] = "2º turno",
            Pesquisa[Tipo] = "totais",
            Pesquisa[Momento] = "apos_1turno",
            NOT ISBLANK ( Pesquisa[Lula] ),
            NOT ISBLANK ( Pesquisa[Flavio] ),
            Pesquisa[Instituto] = _inst,
            Pesquisa[Campo fim] >= _d,
            Pesquisa[Campo início] <= _d,
            Pesquisa[Campo fim] < _g || ISBLANK ( _g )
        ) + 0
    )
