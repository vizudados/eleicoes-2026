/*
@pasta: T07 Debate\Contas
@formato: 0
@descricao: Debates do 2º turno marcados até 22/10 que não aconteceram (cancelados ou não realizados).
@oraculo: linha_do_tempo: 11/10 e 15/10 = 2
*/
CALCULATE (
    COUNTROWS ( Debate ),
    REMOVEFILTERS ( Debate ),
    Debate[Turno] = 2,
    LEFT ( UPPER ( Debate[Observação] ), 9 ) <> "REALIZADO"
) + 0
