/*
@pasta: T22 Simulador\Contas
@formato: 0
@descricao: Quantos institutos têm pesquisa depois do 1º turno com o cruzamento por candidato. Ignora a pesquisa em uso.
*/
CALCULATE (
    COUNTROWS ( FILTER ( VALUES ( 'Transferência'[Instituto] ), NOT ISBLANK ( [T22 · pesquisa · data] ) ) ),
    REMOVEFILTERS ( 'Transferência'[Instituto] )
)
