/*
@pasta: T23 Encerramento\Desenho
@formato: texto
@descricao: Resultado espelhado dos dois turnos e onze achados/atalhos distribuídos nos cinco atos.
@oraculo: TSE nacional 2026 com exterior; dados/pbi/pt_historico_brasil.csv
@gerado: pbi/scripts/desenho_t23.py
*/
VAR _html = [T23 · Resumo · HTML]
    & "<div class='bl esq sobe fx-resultado'><div class='rot'>FLÁVIO BOLSONARO · PL</div><div class='rot etapa'>2º TURNO · RESULTADO FINAL</div>"
    & "<div class='num v flavio-c'>" & FORMAT ( [T00 · 2º turno · Flávio votos] / 1e6, "0.00" )
    & " mi</div><div class='p'>" & FORMAT ( [T00 · 2º turno · Flávio %], "0.00%" ) & " dos válidos</div>"
    & "<div class='primeiro'>1º turno · <span class='num'>" & FORMAT ( [T00 · Flávio votos] / 1e6, "0.00" )
    & " mi</span> · " & FORMAT ( [T00 · Flávio %], "0.00%" ) & "</div></div>"
    & "<div class='bl dir sobe fx-resultado'><div class='rot'>LULA · PT</div><div class='rot etapa'>2º TURNO · RESULTADO FINAL</div>"
    & "<div class='num v lula-c'>" & FORMAT ( [T00 · 2º turno · Lula votos] / 1e6, "0.00" )
    & " mi</div><div class='p'>" & FORMAT ( [T00 · 2º turno · Lula %], "0.00%" ) & " dos válidos</div>"
    & "<div class='primeiro'>1º turno · <span class='num'>" & FORMAT ( [T00 · Lula votos] / 1e6, "0.00" )
    & " mi</span> · " & FORMAT ( [T00 · Lula %], "0.00%" ) & "</div><span class='selo-eleito' aria-label='Lula reeleito'>reeleito</span></div>"
    & "<div class='grupo sobe fx-achados' style='left:150px;top:680px;width:440px'>I · ANTES DA URNA</div>"
    & "<div class='linha sobe fx-achados' style='left:150px;top:710px;width:440px;height:54px'>"
    & "<b>03</b><span>" & (FORMAT ( [T10 · institutos · Lula à frente], "0" ) & " de " & FORMAT ( [T10 · institutos], "0" )
            & " institutos davam Lula à frente; a urna deu Flávio.") & "</span></div>"
    & "<div class='grupo sobe fx-achados' style='left:150px;top:784px;width:440px'>II · O 1º TURNO</div>"
    & "<div class='linha sobe fx-achados' style='left:150px;top:814px;width:440px;height:54px'>"
    & "<b>04</b><span>" & ("Flávio terminou o 1º turno com " & FORMAT ( CALCULATE ( [T06 · diferença Flávio Lula], 'Momento eleição'[Momento] = "Pré Eleições 2026" ) / 1e6, "0.00" ) & " mi de votos de vantagem.") & "</span></div>"
    & "<div class='linha sobe fx-achados' style='left:150px;top:868px;width:440px;height:54px'>"
    & "<b>07</b><span>" & ("A ausência foi " & FORMAT ( CALCULATE ( [T06 · vezes a diferença em 2026], 'Momento eleição'[Momento] = "Pré Eleições 2026" ), "0" ) & " vezes a diferença entre os dois no 1º turno.") & "</span></div>"
    & "<div class='grupo sobe fx-achados' style='left:650px;top:680px;width:440px'>III · O MAPA</div>"
    & "<div class='linha sobe fx-achados' style='left:650px;top:710px;width:440px;height:54px'>"
    & "<b>09</b><span>" & (FORMAT ( CALCULATE ( [T11 · viraram], 'Momento eleição'[Momento] = "Pós Eleições 2026" ), "#,0" )
            & " municípios trocaram Lula por Flávio do 2º turno de 2022 para o de 2026.") & "</span></div>"
    & "<div class='linha sobe fx-achados' style='left:650px;top:764px;width:440px;height:54px'>"
    & "<b>11</b><span>" & ("Nas cidades pequenas e de renda mais alta, Lula perdeu mais terreno no 1º turno.") & "</span></div>"
    & "<div class='grupo sobe fx-achados' style='left:650px;top:836px;width:440px'>IV · EXPLORE VOCÊ MESMO</div>"
    & "<div class='linha sobe fx-achados' style='left:650px;top:866px;width:440px;height:54px'>"
    & "<b>15</b><span>" & (FORMAT ( [T00 · municípios no mapa], "#,0" ) & " municípios para explorar o voto.") & "</span></div>"
    & "<div class='grupo sobe fx-achados' style='left:1180px;top:680px;width:590px'>V · O 2º TURNO · CLIQUE NO ACHADO</div>"
    & "<div class='linha sobe fx-achados' style='left:1180px;top:710px;width:590px;height:54px'>"
    & "<b>20</b><span>" & ("Flávio liderava " & FORMAT ( [T17 · depois · Flávio à frente], "0" ) & " de "
            & FORMAT ( [T17 · depois · pesquisas], "0" ) & " pesquisas; a urna deu Lula.") & "</span></div>"
    & "<div class='linha sobe fx-achados' style='left:1180px;top:764px;width:590px;height:54px'>"
    & "<b>25</b><span>" & ("Lula foi reeleito por " & FORMAT ( [Apuração · diferença], "#,0" )
            & " votos; voltou à frente às " & SUBSTITUTE ( FORMAT ( [T18 · noite · Lula retomou a frente], "HH:mm" ), ":", "h" ) & ".") & "</span></div>"
    & "<div class='linha sobe fx-achados' style='left:1180px;top:818px;width:590px;height:54px'>"
    & "<b>26</b><span>" & ("Entre os turnos, Lula ganhou " & FORMAT ( [T23 · Lula ganhou entre turnos] / 1e6, "0.00" )
            & " mi de votos; Flávio, " & FORMAT ( [T23 · Flávio ganhou entre turnos] / 1e6, "0.00" ) & " mi.") & "</span></div>"
    & "<div class='linha sobe fx-achados' style='left:1180px;top:872px;width:590px;height:54px'>"
    & "<b>27</b><span>" & (FORMAT ( [T23 · municípios Flávio para Lula], "#,0" ) & " municípios trocaram Flávio por Lula; Minas foi o único estado a virar.") & "</span></div>"
    & "<div class='linha sobe fx-achados' style='left:1180px;top:926px;width:590px;height:54px'>"
    & "<b>28</b><span>" & ("Lula chegou ao recorde de " & FORMAT ( [T29 · recorde] / 1e6, "0.00" ) & " mi de votos, "
            & FORMAT ( [T29 · acima do recorde anterior] / 1e6, "0.00" ) & " mi acima de 2022.") & "</span></div>"
RETURN _html
