/*
@pasta: T23 Encerramento\Desenho
@formato: texto
@descricao: Achados finais do encerramento, sem filtro.
*/
VAR _nCidades = [T23 · municípios Flávio para Lula]
VAR _nUfs = [T23 · UFs que viraram]
VAR _nomes = SUBSTITUTE ( [T23 · nomes das UFs que viraram], "Minas Gerais", "Minas" )
VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nomes, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
VAR _virada = IF ( _nUfs = 1, _esc & " foi o único estado a virar",
    IF ( _nUfs = 0, "nenhum estado mudou de vencedor", FORMAT ( _nUfs, "#,0" ) & " estados mudaram de vencedor" ) )
RETURN
"<div class='fx tela'><div class='ach'><div class='grupo rot'>I · ANTES DA URNA</div><div class='linha sobe'><b>03</b><span>Até a véspera, 13 de 18 institutos davam Lula à frente; a urna deu Flávio.</span></div><div class='grupo rot'>II · O 1º TURNO</div><div class='linha sobe'><b>04</b><span>Flávio terminou 2,22 mi de votos à frente de Lula.</span></div><div class='linha sobe'><b>07</b><span>33,5 milhões não foram votar: 15 vezes a diferença entre os dois.</span></div><div class='linha sobe'><b>08</b><span>Quem tem 70 anos ou mais falta 3,9 vezes mais que quem tem 16 ou 17.</span></div><div class='grupo rot'>III · O MAPA</div><div class='linha sobe'><b>09</b><span>711 municípios trocaram Lula por Flávio; nenhum fez o caminho inverso.</span></div><div class='linha sobe'><b>11</b><span>Nas cidades pequenas e de renda mais alta, Lula perdeu mais terreno.</span></div><div class='linha sobe'><b>12</b><span>Onde mais casas recebem Bolsa Família, Lula teve 66%; onde menos, Flávio teve 61%.</span></div><div class='linha sobe'><b>13</b><span>Pela 2ª vez em seis eleições, o PT terminou o 1º turno em segundo.</span></div></div><div class='finais'><div class='rot'>V · O 2º TURNO · CLIQUE NO ACHADO</div>"
    & "<div class='final sobe'><b>20</b><span>" & ("Flávio liderava " & [T17 · depois · Flávio à frente] & " de " & [T17 · depois · pesquisas] & " pesquisas; a urna deu Lula.") & "</span></div>"
    & "<div class='final sobe'><b>25</b><span>" & ("Lula foi eleito por " & FORMAT ( [Apuração · diferença], "#,0" ) & " votos; Lula voltou à frente às " & SUBSTITUTE ( FORMAT ( [T18 · noite · Lula retomou a frente], "HH:mm" ), ":", "h" ) & ".") & "</span></div>"
    & "<div class='final sobe'><b>26</b><span>" & ("Entre os turnos, Lula ganhou " & FORMAT ( [T23 · Lula ganhou entre turnos] / 1e6, "0.00" ) & " mi de votos; Flávio, " & FORMAT ( [T23 · Flávio ganhou entre turnos] / 1e6, "0.00" ) & " mi.") & "</span></div>"
    & "<div class='final sobe'><b>27</b><span>" & (FORMAT ( _nCidades, "#,0" ) & IF ( _nCidades = 1, " município trocou", " municípios trocaram" )
        & " Flávio por Lula entre os turnos; " & _virada & ".") & "</span></div>"
    & "</div></div>"
