/*
@pasta: T18 Apuração\Contas
@formato: 0
@descricao: Quantas UFs do escopo têm Lula à frente (o exterior não conta como UF).
*/
COUNTROWS (
    FILTER (
        CALCULATETABLE ( VALUES ( 'UF'[UF] ), KEEPFILTERS ( 'UF'[Tipo] = "UF" ) ),
        [Apuração · Lula votos] > [Apuração · Flávio votos]
    )
) + 0
