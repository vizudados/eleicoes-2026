/*
@pasta: T18 Apuração\Contas
@formato: 0
@descricao: Quantas atualizações do TSE a noite tinha até o momento em contexto (ele incluso): a 1ª, a 2ª…
*/
VAR _m = [T18 · momento escolhido]
RETURN
    IF (
        NOT ISBLANK ( _m ),
        CALCULATE ( COUNTROWS ( 'Apuração histórico' ), REMOVEFILTERS ( 'Apuração histórico' ), 'Apuração histórico'[AtualizadoTSE] <= _m )
    )
