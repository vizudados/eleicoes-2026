/*
@pasta: T18 Apuração\Desenho
@formato: texto
@descricao: Dossiê final da UF: votos, abstenção e comparação com o primeiro turno.
*/
VAR _nome = SELECTEDVALUE ( 'UF'[Nome] )
VAR _esc = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), """", "&quot;" ), "'", "&#39;" )
RETURN "<div class='tela tt18'><div class='fita'></div><div class='rot'>" & UPPER ( _esc )
    & " · RESULTADO FINAL</div><div class='linha'><span class='lula num'>"
    & FORMAT ( [Apuração · Lula votos], "#,0" ) & "</span><span class='rot'>LULA</span></div>"
    & "<div class='linha'><span class='flavio num'>" & FORMAT ( [Apuração · Flávio votos], "#,0" )
    & "</span><span class='rot'>FLÁVIO</span></div><div class='txt'>No 1º turno: Lula "
    & FORMAT ( [T12 · Lula % 2026], "0.0%" ) & " × Flávio " & FORMAT ( [T12 · PL % 2026], "0.0%" )
    & ".</div><div class='nota'>Abstenção no 2º turno: " & FORMAT ( [Apuração · abstenção %], "0.00%" )
    & ". Diferença: " & FORMAT ( [Apuração · diferença], "#,0" ) & " votos.</div></div>"
