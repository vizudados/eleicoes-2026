/*
@pasta: T18 Apuração\Desenho
@formato: texto
@descricao: Resultado final e manchete da noite; o clique na curva consulta uma parcial histórica.
*/
-- 1 · Leituras
VAR _escopo = [Apuração · escopo]
VAR _l = [Apuração · Lula votos]
VAR _f = [Apuração · Flávio votos]
VAR _lp = [Apuração · Lula %]
VAR _fp = [Apuração · Flávio %]
VAR _dif = [Apuração · diferença]
VAR _lider = [Apuração · líder]
VAR _m = [T18 · momento escolhido]
VAR _fora = [T18 · recorte vazio]
VAR _em = [Recorte · em]
VAR _tse = [Apuração · atualizado no TSE]
VAR _a = [T18 · noite · Flávio passou à frente]
VAR _b = [T18 · noite · Lula retomou a frente]
-- 2 · Textos
VAR _frase = IF ( _escopo = "Brasil",
    "Lula foi eleito por " & FORMAT ( _dif, "#,0" ) & " votos. Flávio liderou das "
        & SUBSTITUTE ( FORMAT ( _a, "HH:mm" ), ":", "h" ) & " às " & SUBSTITUTE ( FORMAT ( _b, "HH:mm" ), ":", "h" ) & ".",
    "Lula foi eleito no Brasil; " & _em & ", " & _lider & " terminou à frente por "
        & FORMAT ( _dif, "#,0" ) & IF ( _dif = 1, " voto.", " votos." ) )
VAR _bl = "<div class='cand sobe d2'><div class='rot lula-esc'>LULA · PT · 13</div>"
    & "<div class='num pct lula'>" & FORMAT ( _lp, "0.00%" ) & "</div><div class='txt votos'>"
    & FORMAT ( _l, "#,0" ) & " votos</div></div>"
VAR _bf = "<div class='cand sobe d3'><div class='rot flavio-esc'>FLÁVIO BOLSONARO · PL · 22</div>"
    & "<div class='num pct flavio'>" & FORMAT ( _fp, "0.00%" ) & "</div><div class='txt votos'>"
    & FORMAT ( _f, "#,0" ) & " votos</div></div>"
VAR _html = "<div class='tela t18p'><div class='rot topo entra'>RESULTADO FINAL · 2º TURNO · "
    & UPPER ( _escopo ) & "</div><div class='par'>" & _bl & _bf
    & "<div class='selo entra d6'>LULA ELEITO</div></div><div class='man frase sobe d4'>" & _frase
    & "</div><div class='secoes sobe d5'><div class='rot'>SEÇÕES TOTALIZADAS</div><div class='trilho'>"
    & "<div class='enche barra-x' style='width:100%'></div><span class='num'>"
    & FORMAT ( [Apuração · seções %], "0%" ) & "</span></div><div class='nota'>Abstenção "
    & FORMAT ( [Apuração · abstenção %], "0.00%" ) & " · brancos " & FORMAT ( [Apuração · brancos], "#,0" )
    & " · nulos " & FORMAT ( [Apuração · nulos], "#,0" ) & "</div></div></div>"
-- 4 · Marcação
RETURN SWITCH ( TRUE (), NOT ISBLANK ( _m ), [T18 · Placar momento · HTML],
    _fora = 1, "<div class='tela t18p'><div class='man frase'>O estado clicado fica fora do filtro do alto. Clique nele de novo para voltar.</div></div>",
    _html )
