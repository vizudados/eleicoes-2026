/*
@pasta: T18 Apuração\Desenho
@formato: texto
@descricao: Texto alternativo da curva da noite.
*/
VAR _n = [Histórico · atualizações]
RETURN
    IF (
        _n = 0,
        "O histórico da noite não consta do levantamento carregado.",
        "Curva da noite no Brasil: Flávio passou à frente às " & SUBSTITUTE ( FORMAT ( [T18 · noite · Flávio passou à frente], "HH:mm" ), ":", "h" )
            & "; Lula retomou às " & SUBSTITUTE ( FORMAT ( [T18 · noite · Lula retomou a frente], "HH:mm" ), ":", "h" )
            & ". Escala ampliada de 40% a 60%; primeiras parciais fora dessa faixa."
    )
