/*
@pasta: T18 Apuração\Desenho
@formato: texto
@descricao: Texto alternativo da curva da noite.
*/
VAR _n = [Histórico · atualizações]
RETURN
    IF (
        _n = 0,
        "A curva da noite começa às 17h de 25/10, com a primeira atualização do TSE.",
        "A curva da noite no Brasil: " & _n & IF ( _n = 1, " atualização", " atualizações" ) & " do TSE guardadas."
    )
