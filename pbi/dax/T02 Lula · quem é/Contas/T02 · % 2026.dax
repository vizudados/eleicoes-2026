/*
@pasta: T02 Lula · quem é\Contas
@formato: 0.00%
@descricao: Parcela nos válidos do turno escolhido, incluindo exterior.
*/
DIVIDE ( [T02 · votos 2026], IF ( [Eleição · pós] = 1, CALCULATE ( SUM ( 'UF segundo turno'[Validos] ), REMOVEFILTERS ( 'UF' ), 'UF segundo turno'[Ano] = 2026 ), CALCULATE ( SUM ( 'Candidato UF'[Votos] ), REMOVEFILTERS ( 'UF' ), 'Candidato UF'[Ano] = 2026 ) ) )
