/*
@pasta: T02 Lula · quem é\Contas
@formato: 0
@descricao: Ano do segundo marco mais antigo de Lula (onde a régua retoma quando o primeiro marco fica longe dos outros e a régua ganha um corte).
@oraculo: Lula 1980 · Flávio 2016
*/
VAR _p = [T02 · Trajetória · primeiro ano] RETURN CALCULATE ( MIN ( 'Trajetória'[Ano] ), REMOVEFILTERS ( 'Trajetória' ), 'Trajetória'[Candidato] = "Lula", 'Trajetória'[Ano] > _p )
