/*
@pasta: T02 Lula · quem é\Contas
@formato: dd/mm/yyyy
@descricao: Data do marco da linha; vazio quando a fonte só dá o ano.
*/
VAR _d = SELECTEDVALUE ( 'Trajetória'[Data] )
RETURN
    IF ( LEN ( _d ) = 10, DATE ( VALUE ( LEFT ( _d, 4 ) ), VALUE ( MID ( _d, 6, 2 ) ), VALUE ( RIGHT ( _d, 2 ) ) ) )
