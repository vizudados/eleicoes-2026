/*
@pasta: T04 Flávio · quem é\Desenho
@formato: texto
@descricao: Texto para leitor de tela da ficha.
*/
LEFT (
    "Flávio Bolsonaro, na vida pública desde " & [T04 · Trajetória · primeiro ano] & ". No " & [Eleição · turno] & "º turno de 2026, "
        & SWITCH ( TRUE (), ABS ( [T04 · votos 2026] ) >= 1000000, FORMAT ( [T04 · votos 2026] / 1000000, "0.00" ) & " mi", ABS ( [T04 · votos 2026] ) >= 1000, FORMAT ( [T04 · votos 2026] / 1000, "0.0" ) & " mil", FORMAT ( [T04 · votos 2026], "#,0" ) ) & " de votos (" & IF ( [Eleição · pós] = 1, FORMAT ( [T04 · % 2026], "0.00%" ), FORMAT ( [T04 · % 2026], "0.0%" ) ) & "), "
        & IF ( [Eleição · pós] = 1 && [T04 · posição 2026] = 1, "eleito", [T04 · posição 2026] & "º lugar" ) & ".",
    250
)
