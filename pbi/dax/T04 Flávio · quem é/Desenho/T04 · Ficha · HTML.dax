/*
@pasta: T04 Flávio · quem é\Desenho
@formato: texto
@descricao: Ficha de Flávio (alto à esquerda da tela): desde quando está na vida pública, o 1º turno de 2026 e quantos marcos a linha do tempo tem. Só lê contas.
*/
-- 1 · Leituras
VAR _desde = [T04 · Trajetória · primeiro ano]
VAR _anos = [T04 · anos de vida pública]
VAR _votos = [T04 · votos 2026]
VAR _pct = [T04 · % 2026]
VAR _pos = [T04 · posição 2026]
VAR _marcos = [T04 · Trajetória · marcos]
VAR _fotos = [T04 · Trajetória · marcos com foto]
-- 2 · Textos
VAR _txtVotos = SWITCH ( TRUE (), ABS ( _votos ) >= 1000000, FORMAT ( _votos / 1000000, "0.00" ) & " mi", ABS ( _votos ) >= 1000, FORMAT ( _votos / 1000, "0.0" ) & " mil", FORMAT ( _votos, "#,0" ) )
VAR _txtPct = FORMAT ( _pct, "0.0%" )
VAR _txtFotos =
    SWITCH ( _fotos, 0, "nenhum com foto da época", 1, "1 com foto da época", _fotos & " com foto da época" )
-- 4 · Marcação
VAR _html =
    "<div class='tela fc'>"
        & "<div class='lin sobe d3'><div class='rot'>Na vida pública desde</div>"
        & "<div class='val'><span class='nc'>" & _desde & "</span><small>há <span>" & _anos & "</span> anos</small></div></div>"
        & "<div class='lin sobe d4'><div class='rot'>No 1º turno de 2026</div>"
        & "<div class='val'><span class='flavio'>" & _txtVotos & "</span><small>de votos · " & _txtPct
        & " · " & _pos & "º lugar</small></div></div>"
        & "<div class='lin sobe d5'><div class='rot'>Na linha do tempo abaixo</div>"
        & "<div class='val'><span>" & _marcos & "</span><small>marcos, " & _txtFotos & "</small></div></div>"
    & "</div>"
RETURN
    _html
