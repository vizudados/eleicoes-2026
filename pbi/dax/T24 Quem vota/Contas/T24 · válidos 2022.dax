/*
@pasta: T24 Quem vota\Contas
@formato: #,0
@descricao: Votos válidos no 1º turno de 2022 nos municípios do degrau.
@gerado: pbi/scripts/desenho_t24.py
*/
VAR _l = [T24 · lente]
VAR _d = [T24 · degrau]
VAR _m =
    CALCULATETABLE (
        VALUES ( 'Social município'[CodIBGE] ),
        'Social município'[Lente] = _l,
        'Social município'[Degrau] = _d
    )
RETURN
    CALCULATE (
        SUM ( 'Município ano'[Validos] ),
        'Município ano'[Ano] = 2022,
        TREATAS ( _m, 'Município'[CodIBGE] )
    )
