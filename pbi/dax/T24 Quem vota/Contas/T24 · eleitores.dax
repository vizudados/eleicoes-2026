/*
@pasta: T24 Quem vota\Contas
@formato: #,0
@descricao: Eleitores aptos de 2026 nos municípios do degrau (cada degrau tem cerca de um quinto).
@gerado: pbi/scripts/desenho_t24.py
*/
VAR _l = [T24 · lente]
VAR _d = [T24 · degrau]
VAR _m =
    CALCULATETABLE (
        VALUES ( 'Social município'[CodIBGE] ),
        'Social município'[Lente] = _l,
        'Social município'[Degrau] = _d
    )
RETURN
    CALCULATE (
        SUM ( 'Município ano'[Aptos] ),
        'Município ano'[Ano] = 2026,
        TREATAS ( _m, 'Município'[CodIBGE] )
    )
