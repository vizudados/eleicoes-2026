{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "T19 · dispersão: renda (log) × mudança da margem de Lula 2022 → 2026, um ponto por município; arrastar desenha um retângulo que filtra a página (pbiCrossFilterApply); clique num ponto filtra só ele; clique no vazio limpa. Eixos, textos e legenda no HTML atrás (mesma geometria).",
  "width": {
    "signal": "pbiContainerWidth"
  },
  "height": {
    "signal": "pbiContainerHeight"
  },
  "padding": 0,
  "autosize": {
    "type": "none",
    "contains": "padding"
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    }
  },
  "signals": [
    {
      "name": "pos",
      "update": "length(data('dataset')) > 0 && data('dataset')[0].pos == 1"
    },
    {
      "name": "estatico",
      "init": "!(windowSize()[0] > 0)"
    },
    {
      "name": "fim",
      "value": 1900
    },
    {
      "name": "t0",
      "init": "now()"
    },
    {
      "name": "t",
      "init": "estatico ? fim : 0",
      "on": [
        {
          "events": "timer{16}",
          "update": "estatico ? fim : min(now() - t0, fim)"
        }
      ]
    },
    {
      "name": "entrada",
      "update": "clamp(t / 1500, 0, 1)"
    },
    {
      "name": "p0",
      "value": [
        0,
        0
      ],
      "on": [
        {
          "events": "mousedown",
          "update": "xy()"
        }
      ]
    },
    {
      "name": "p1",
      "value": [
        0,
        0
      ],
      "on": [
        {
          "events": "mousedown",
          "update": "xy()"
        },
        {
          "events": "[mousedown, window:mouseup] > window:mousemove",
          "update": "xy()"
        }
      ]
    },
    {
      "name": "arrastando",
      "value": false,
      "on": [
        {
          "events": "mousedown",
          "update": "true"
        },
        {
          "events": "window:mouseup",
          "update": "false"
        }
      ]
    },
    {
      "name": "grande_o_bastante",
      "update": "abs(p1[0] - p0[0]) > 6 && abs(p1[1] - p0[1]) > 6"
    },
    {
      "name": "ret",
      "value": null,
      "on": [
        {
          "events": "[mousedown, window:mouseup] > window:mousemove",
          "update": "grande_o_bastante ? {x0: min(p0[0], p1[0]), x1: max(p0[0], p1[0]), y0: min(p0[1], p1[1]), y1: max(p0[1], p1[1])} : null"
        },
        {
          "events": "mousedown",
          "update": "null"
        }
      ]
    },
    {
      "name": "lr0",
      "update": "ret ? invert('x', ret.x0) : 0"
    },
    {
      "name": "lr1",
      "update": "ret ? invert('x', ret.x1) : 0"
    },
    {
      "name": "lv0",
      "update": "ret ? invert('y', ret.y1) : 0"
    },
    {
      "name": "lv1",
      "update": "ret ? invert('y', ret.y0) : 0"
    },
    {
      "name": "arrastou",
      "value": false,
      "on": [
        {
          "events": "window:mouseup",
          "update": "ret != null"
        }
      ]
    },
    {
      "name": "estado",
      "value": "neutro",
      "on": [
        {
          "events": "window:mouseup",
          "update": "ret == null ? estado : (length(data('laco')) > 2500 ? 'grande' : (length(data('laco')) == 0 ? 'vazio' : [pbiCrossFilterApply(event, 'datum.renda >= ' + lr0 + ' && datum.renda <= ' + lr1 + ' && datum.var >= ' + lv0 + ' && datum.var <= ' + lv1, {limit: 2500}), 'laco'][1]))"
        },
        {
          "events": "@pontos:click",
          "filter": [
            "!event.ctrlKey"
          ],
          "update": "arrastou ? estado : [pbiCrossFilterApply(event), 'ponto'][1]"
        },
        {
          "events": "click",
          "update": "arrastou || (event.item && event.item.mark && event.item.mark.name == 'pontos') ? estado : [pbiCrossFilterClear(), 'neutro'][1]"
        }
      ]
    },
    {
      "name": "ret_fixo",
      "value": null,
      "on": [
        {
          "events": "window:mouseup",
          "update": "ret != null ? ret : ret_fixo"
        },
        {
          "events": "click",
          "update": "arrastou ? ret_fixo : null"
        }
      ]
    },
    {
      "name": "sobre",
      "value": null,
      "on": [
        {
          "events": "@pontos:mouseover",
          "update": "datum"
        },
        {
          "events": "@pontos:mouseout",
          "update": "null"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "dataset"
    },
    {
      "name": "pts",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.renda) && datum.renda > 0 && isValid(datum['var'])"
        },
        {
          "type": "collect",
          "sort": {
            "field": "val",
            "order": "descending"
          }
        }
      ]
    },
    {
      "name": "laco",
      "source": "pts",
      "transform": [
        {
          "type": "filter",
          "expr": "ret != null && datum.renda >= lr0 && datum.renda <= lr1 && datum['var'] >= lv0 && datum['var'] <= lv1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "log",
      "domain": [
        250.0,
        5000.0
      ],
      "range": [
        {
          "signal": "84*width/880"
        },
        {
          "signal": "856*width/880"
        }
      ],
      "clamp": true
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "signal": "pos ? [-0.4, 0.2] : [-0.48, 0.16]"
      },
      "range": [
        {
          "signal": "758*height/860"
        },
        {
          "signal": "112*height/860"
        }
      ],
      "clamp": true,
      "zero": false,
      "nice": false
    },
    {
      "name": "tamanho",
      "type": "sqrt",
      "domain": [
        0,
        6600000
      ],
      "range": [
        0,
        520
      ],
      "clamp": true
    },
    {
      "name": "cor",
      "type": "linear",
      "domain": [
        -0.6,
        -0.3,
        -0.12,
        0.0,
        0.12,
        0.3,
        0.6
      ],
      "range": [
        "#1D3C6E",
        "#2B5797",
        "#8FA8CF",
        "#CBBDA2",
        "#D9877B",
        "#B8322A",
        "#8E2620"
      ],
      "clamp": true,
      "interpolate": "rgb"
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "fundo_clique",
      "interactive": true,
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "fill": {
            "value": "transparent"
          }
        },
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "height"
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "pontos",
      "from": {
        "data": "pts"
      },
      "encode": {
        "enter": {
          "shape": {
            "value": "circle"
          },
          "stroke": {
            "value": "#F1EBDF"
          }
        },
        "update": {
          "x": {
            "scale": "x",
            "field": "renda"
          },
          "y": {
            "scale": "y",
            "field": "var"
          },
          "size": {
            "signal": "max(7, scale('tamanho', datum.val))"
          },
          "fill": {
            "scale": "cor",
            "field": "m26"
          },
          "strokeWidth": [
            {
              "test": "datum.__selected__ == 'on' || (sobre && sobre.cod == datum.cod)",
              "value": 1.4
            },
            {
              "value": 0.5
            }
          ],
          "stroke": [
            {
              "test": "datum.__selected__ == 'on' || (sobre && sobre.cod == datum.cod)",
              "value": "#1C1915"
            },
            {
              "value": "#F1EBDF"
            }
          ],
          "opacity": {
            "signal": "(datum.__selected__ == 'off' || datum['val__highlightStatus'] == 'off' ? 0.13 : 0.86) * clamp(entrada * 1.7 - (scale('x', datum.renda) / width) * 0.7, 0, 1)"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "retangulo",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "(ret || ret_fixo || {x0: 0}).x0"
          },
          "x2": {
            "signal": "(ret || ret_fixo || {x1: 0}).x1"
          },
          "y": {
            "signal": "(ret || ret_fixo || {y0: 0}).y0"
          },
          "y2": {
            "signal": "(ret || ret_fixo || {y1: 0}).y1"
          },
          "fill": {
            "value": "#1C1915"
          },
          "fillOpacity": {
            "value": 0.05
          },
          "stroke": {
            "value": "#1C1915"
          },
          "strokeWidth": {
            "value": 1.4
          },
          "strokeDash": {
            "value": [
              5,
              4
            ]
          },
          "opacity": {
            "signal": "ret || ret_fixo ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "aviso",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "470.0*width/880"
          },
          "y": {
            "signal": "130*height/860"
          },
          "align": {
            "value": "center"
          },
          "text": {
            "signal": "estado == 'grande' ? 'Seleção grande demais (mais de 2.500 cidades): use o filtro no canto de cima' : estado == 'vazio' ? 'Nenhum município nesse retângulo' : ''"
          },
          "fill": {
            "value": "#8E2620"
          },
          "font": {
            "value": "Sora Eleicoes, Segoe UI, sans-serif"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": 600
          }
        }
      }
    }
  ]
}
